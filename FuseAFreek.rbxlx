      <Item class="Script" referent="42">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point. Order matters: remotes and the map exist before players load.
-- Each service starts on its own, so if one breaks the rest of the game still loads and
-- the Output window says exactly which one failed and why.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Server = script.Parent

-- Shown on players' screens if the game doesn't finish loading (see client Main), so
-- problems are visible without digging through Output.
local problems = {}
local function setStatus(text: string)
	local lines = table.clone(problems)
	table.insert(lines, text)
	ReplicatedStorage:SetAttribute("ServerStartup", table.concat(lines, "\n"))
end

local SERVICES = {
	"Environment",
	"PlotService",
	"DiscoveryService",
	"EconomyService",
	"ActionService",
	"TradeService",
	"StealService",
	"WeaponService",
	"RebirthService",
	"PassService",
	"CannonService",
	"LuckService",
	"EventService",
	"AdminService",
	"SeasonalService", -- after the map and yards exist
	"DataService",
}

for _, name in SERVICES do
	-- Startup shouldn't wait on anything; if a service hangs, say which one.
	local done = false
	setStatus("Starting " .. name .. "...")
	task.delay(5, function()
		if not done then
			warn("[Fuse a Freek] " .. name .. " is stuck starting up (still waiting after 5 seconds)")
		end
	end)
	local ok, err = xpcall(function()
		require(Server[name]).init()
	end, debug.traceback)
	done = true
	if not ok then
		warn("[Fuse a Freek] " .. name .. " failed to start:\n" .. tostring(err))
		table.insert(problems, name .. " failed: " .. tostring(err))
	end
end
setStatus("Server started")
print("[Fuse a Freek] Server started")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">PassService</string>
          <string name="Source"><![CDATA[-- Checks which game passes each player owns and marks them with "Pass_<key>" attributes.
-- Purchases made in-game take effect right away.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)

local PassService = {}

-- Keeps the save's passSlots in step with the Extra Yard Slot passes the player owns, and
-- moves any Freek off a pad the player no longer has (e.g. after a refund).
local function syncSlots(player: Player)
	local data = DataService.get(player)
	if not data then
		return
	end
	data.passSlots = GamePasses.passSlots(player)
	local total = FreekUtil.totalSlots(data)
	for _, freek in data.freeks do
		if freek.slot and freek.slot > total then
			freek.slot = nil
		end
	end
	DataService.changed(player)
end

local function grant(player: Player, key: string)
	player:SetAttribute("Pass_" .. key, true)
	-- Refresh income, yard and UI so the perk shows immediately.
	syncSlots(player)
end

local function checkOwnership(player: Player)
	-- Ownership is re-checked every join, so start from zero pass slots until confirmed.
	player:SetAttribute("PassesChecked", false)
	for _, key in GamePasses.order do
		local pass = GamePasses.list[key]
		if RunService:IsStudio() and GamePasses.STUDIO_GRANT_ALL then
			grant(player, key)
		elseif pass.id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.id)
			if ok and owns then
				grant(player, key)
			elseif not ok then
				warn("Couldn't check pass", key, "for", player.Name, owns)
			end
		end
	end
	player:SetAttribute("PassesChecked", true)
	syncSlots(player)
end

function PassService.init()
	Players.PlayerAdded:Connect(checkOwnership)
	for _, player in Players:GetPlayers() do
		task.spawn(checkOwnership, player)
	end

	DataService.onLoaded(function(player)
		if player:GetAttribute("PassesChecked") then
			syncSlots(player)
		end
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for _, key in GamePasses.order do
			local pass = GamePasses.list[key]
			if pass.id == passId then
				grant(player, key)
				Remotes.get("Notify"):FireClient(player, "Thanks! " .. pass.name .. " is now active.", "discovery")
			end
		end
	end)
end

return PassService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[-- Builds the map and gives every player a barn (see Barn.luau) with Freek pads and Fusion
-- Dens inside. Other players can walk in to look (or steal, see StealService) only while
-- the barn doors are open. The owner locks them from the padlock inside for
-- GATE_LOCK_SECONDS at a time (longer with the Longer Lock pass) and can always walk
-- through their own doors.
-- The Freeks inside are rebuilt whenever the owner's data changes.

local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local GateTiers = require(ReplicatedStorage.Shared.GateTiers)
local BarnUpgrades = require(script.Parent.BarnUpgrades)
local FreekModel = require(ReplicatedStorage.Shared.FreekModel)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Barn = require(script.Parent.Barn)
local DataService = require(script.Parent.DataService)
local FreekTag = require(script.Parent.FreekTag)

local PLOT_SIZE = Barn.SIZE
local ROW_SPACING = 70 -- between barn centres along the town square
local ROW_DISTANCE = 64 -- from the middle of the town square to each barn's centre
local PAD_COLUMNS = 5
local GATE_WIDTH = Barn.DOOR_WIDTH

local PlotService = {}

local plots = {}
local plotOf = {} -- [Player] = plot

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		p[key] = value
	end
	return p
end

local function billboard(parent: Instance, size: UDim2, offset: Vector3, maxDistance: number): (BillboardGui, TextLabel)
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffset = offset
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(20, 22, 48)
	stroke.Thickness = 3
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	gui.Parent = parent
	return gui, label
end

local function buildMap()
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = Workspace

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(140, 0.5, 0) -- past the east end of the conveyor
	spawn.Color = Color3.fromRGB(255, 220, 120)
	spawn.Material = Enum.Material.Marble
	spawn.TopSurface = Enum.SurfaceType.Smooth
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy() -- drop the default spawn logo
	end
	spawn.Parent = map

	local post = part({
		Name = "TitleSign",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(0, 60, 0), -- high over the square, out of the way
		Transparency = 1,
		CanCollide = false,
		Parent = map,
	})
	local _, title = billboard(post, UDim2.fromScale(40, 8), Vector3.zero, 400)
	title.Text = "FUSE A FREEK"
	title.Font = Enum.Font.LuckiestGuy
	title.TextColor3 = Color3.fromRGB(255, 230, 90)
	title:FindFirstChildOfClass("UIStroke").Thickness = 5
end

-- Each yard gets its own accent colour for pedestal rims and its sign trim.
local ACCENTS = {
	Color3.fromRGB(255, 110, 170),
	Color3.fromRGB(90, 200, 255),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(150, 110, 255),
	Color3.fromRGB(90, 220, 130),
	Color3.fromRGB(255, 140, 70),
	Color3.fromRGB(80, 230, 220),
	Color3.fromRGB(255, 90, 90),
}

-- The name plaque reads e.g. "MIKE'S" over "BARN".
local function setSign(plot, name: string, subtitle: string)
	plot.signName = string.upper(name)
	plot.signSub = subtitle
	if plot.signLabels.name then
		plot.signLabels.name.Text = plot.signName
		plot.signLabels.sub.Text = plot.signSub
	end
end

local OUTLINE = Color3.fromRGB(20, 22, 48)

local function outlinedText(
	parent: Instance,
	font: Enum.Font,
	color: Color3,
	position: UDim2,
	size: UDim2,
	stroke: number
)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = position
	label.Size = size
	label.TextScaled = true
	label.Font = font
	label.TextColor3 = color
	label.Parent = parent
	local outline = Instance.new("UIStroke")
	outline.Color = OUTLINE
	outline.Thickness = stroke
	outline.LineJoinMode = Enum.LineJoinMode.Round
	outline.Parent = label
	return label
end

-- The owner's name plaque, bolted to the wall to the right of the doors (as you face the
-- barn). Its rim and bolts are in the rebirth tier's metal.
local PLAQUE_SIZE = Vector2.new(10, 5)
local function buildPlaque(arch: Instance, plot, tier, material: Enum.Material): CFrame
	local cframe = plot.origin * CFrame.new(-(GATE_WIDTH / 2 + 14), 9, -plot.half - 0.75)
	local w, h = PLAQUE_SIZE.X, PLAQUE_SIZE.Y
	part({
		Name = "PlaqueOutline",
		Size = Vector3.new(w + 1.1, h + 1.1, 0.3),
		CFrame = cframe * CFrame.new(0, 0, 0.12),
		Color = OUTLINE,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = arch,
	})
	part({
		Name = "PlaqueRim",
		Size = Vector3.new(w + 0.7, h + 0.7, 0.4),
		CFrame = cframe,
		Color = tier.color,
		Material = material,
		CanCollide = false,
		Parent = arch,
	})
	local board = part({
		Name = "Plaque",
		Size = Vector3.new(w, h, 0.5),
		CFrame = cframe * CFrame.new(0, 0, -0.05),
		Color = Color3.fromRGB(150, 95, 55),
		Material = Enum.Material.WoodPlanks,
		CanCollide = false,
		Parent = arch,
	})
	for _, corner in { Vector2.new(-1, -1), Vector2.new(-1, 1), Vector2.new(1, -1), Vector2.new(1, 1) } do
		part({
			Name = "PlaqueBolt",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.45,
			CFrame = cframe * CFrame.new(corner.X * (w / 2 - 0.4), corner.Y * (h / 2 - 0.4), -0.32),
			Color = tier.color,
			Material = material,
			CanCollide = false,
			Parent = arch,
		})
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 0.2
	gui.Parent = board
	plot.signLabels = {
		name = outlinedText(
			gui,
			Enum.Font.LuckiestGuy,
			Color3.fromRGB(255, 225, 90),
			UDim2.fromScale(0.07, 0.1),
			UDim2.fromScale(0.86, 0.52),
			4
		),
		sub = outlinedText(
			gui,
			Enum.Font.FredokaOne,
			Color3.new(1, 1, 1),
			UDim2.fromScale(0.15, 0.62),
			UDim2.fromScale(0.7, 0.28),
			3
		),
	}
	plot.signLabels.name.Text = plot.signName
	plot.signLabels.sub.Text = plot.signSub
	return cframe
end

-- Optional extra decoration for every barn's door frame (set by SeasonalService during events).
-- Called as decorator(archFolder, info) with info = { origin, half, innerX, beamBottom, front }.
local archDecorator = nil

-- (Re)builds the frame around a barn's doors for a tier from GateTiers: posts, a header
-- beam, the owner's name sign on the gable, and for higher tiers finials, a crest over the
-- sign and glowing gems.
local function buildArch(plot, tierIndex: number)
	local tier = GateTiers.list[tierIndex]
	if plot.archFolder then
		plot.archFolder:Destroy()
	end
	local arch = Instance.new("Model")
	arch.Name = "GateArch"
	arch.Parent = plot.freeks.Parent
	plot.archFolder = arch
	plot.archTier = tierIndex

	local origin = plot.origin
	-- Posts stand in front of the doors (which slide behind them).
	local half = plot.half + 1.6 + tier.postWidth / 2
	local w = tier.postWidth
	local postX = GATE_WIDTH / 2 + w / 2
	local material = Enum.Material[tier.material]
	local postHeight = Barn.DOOR_HEIGHT + 1.5
	local top = 1 + postHeight -- top of the posts
	for _, side in { -1, 1 } do
		part({
			Name = "GatePost",
			Size = Vector3.new(w, postHeight, w),
			CFrame = origin * CFrame.new(side * postX, 1 + postHeight / 2, -half),
			Color = tier.color,
			Material = material,
			Parent = arch,
		})
		-- A wider base and cap on each post.
		part({
			Name = "PostBase",
			Size = Vector3.new(w + 0.8, 1, w + 0.8),
			CFrame = origin * CFrame.new(side * postX, 1.5, -half),
			Color = tier.color,
			Material = material,
			Parent = arch,
		})
		part({
			Name = "PostCap",
			Size = Vector3.new(w + 0.6, 0.6, w + 0.6),
			CFrame = origin * CFrame.new(side * postX, top + 0.3, -half),
			Color = plot.accent,
			Parent = arch,
		})
		if tier.finials then
			part({
				Name = "Finial",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * (w * 0.9),
				CFrame = origin * CFrame.new(side * postX, top + 0.6 + w * 0.4, -half),
				Color = tier.color,
				Material = material,
				Parent = arch,
			})
		end
		if tier.gems then
			local gem = part({
				Name = "Gem",
				Size = Vector3.new(1.1, 1.1, 0.4),
				CFrame = origin
					* CFrame.new(side * postX, 1 + postHeight * 0.6, -half - w / 2 - 0.1)
					* CFrame.Angles(0, 0, math.rad(45)),
				Color = plot.accent,
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = arch,
			})
			local sparkle = Instance.new("Sparkles")
			sparkle.SparkleColor = Color3.fromRGB(255, 235, 150)
			sparkle.Parent = gem
		end
	end
	local beamY = top - 0.6
	part({
		Name = "ArchBeam",
		Size = Vector3.new(postX * 2 + w, 1.2, w * 0.85),
		CFrame = origin * CFrame.new(0, beamY, -half),
		Color = tier.color,
		Material = material,
		Parent = arch,
	})
	local plaque = buildPlaque(arch, plot, tier, material)
	if tier.crest then
		-- A half-ring of segments arching over the plaque.
		local radius = PLAQUE_SIZE.X / 2 + 0.9
		local segments = 9
		local base = plaque * CFrame.new(0, PLAQUE_SIZE.Y / 2 - 0.4, 0)
		for i = 0, segments - 1 do
			local a0 = math.pi * i / segments
			local a1 = math.pi * (i + 1) / segments
			local p0 = base * CFrame.new(math.cos(a0) * radius, math.sin(a0) * radius * 0.4, 0)
			local p1 = base * CFrame.new(math.cos(a1) * radius, math.sin(a1) * radius * 0.4, 0)
			local length = (p1.Position - p0.Position).Magnitude
			part({
				Name = "Crest",
				Size = Vector3.new(0.5, 0.5, length + 0.25),
				CFrame = CFrame.lookAt(p0.Position, p1.Position) * CFrame.new(0, 0, -length / 2),
				Color = tier.color,
				Material = material,
				CanCollide = false,
				Parent = arch,
			})
		end
		local jewel = part({
			Name = "CrestJewel",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (if tier.gems then 1.3 else 0.9),
			CFrame = base * CFrame.new(0, radius * 0.4, -0.1),
			Color = if tier.gems then plot.accent else tier.color,
			Material = if tier.gems then Enum.Material.Neon else material,
			CanCollide = false,
			Parent = arch,
		})
		if tier.gems then
			local sparkle = Instance.new("Sparkles")
			sparkle.SparkleColor = Color3.fromRGB(255, 235, 150)
			sparkle.Parent = jewel
		end
	end

	-- The top tier's metal shimmers through the rainbow (the client cycles the colour).
	if tier.rainbow then
		for _, p in arch:GetDescendants() do
			if p:IsA("BasePart") and p.Color == tier.color then
				CollectionService:AddTag(p, FreekModel.RAINBOW_TAG)
			end
		end
	end

	-- The LOCKED/OPEN timer floats over the doors.
	plot.gateGuiPart.CFrame = origin * CFrame.new(0, Barn.DOOR_HEIGHT + 3.6, -plot.half - 1)

	if archDecorator then
		archDecorator(arch, {
			origin = origin,
			half = half,
			innerX = GATE_WIDTH / 2,
			beamBottom = beamY - 0.6,
			front = -half - w / 2 - 0.1,
		})
	end
end

-- Rebuilds every arch, e.g. when a seasonal theme starts or ends.
function PlotService.setArchDecorator(decorator)
	archDecorator = decorator
	for _, plot in plots do
		if plot.archTier > 0 then
			buildArch(plot, plot.archTier)
		end
	end
end

local function buildPlot(index: number)
	-- Yards 1-4 sit north of the conveyor, 5-8 south, in rows along it.
	local perSide = Config.PLOT_COUNT // 2
	local rowSide = if index <= perSide then -1 else 1
	local rowX = ((index - 1) % perSide - (perSide - 1) / 2) * ROW_SPACING
	local center = Vector3.new(rowX, 0, rowSide * ROW_DISTANCE)
	-- Local -Z (the plot's front, with the gate) faces the conveyor.
	local origin = CFrame.lookAt(center, Vector3.new(rowX, 0, 0))
	local accent = ACCENTS[(index - 1) % #ACCENTS + 1]
	local half = PLOT_SIZE / 2 - 0.5

	local folder = Instance.new("Model")
	folder.Name = "Plot" .. index
	folder.Parent = Workspace:WaitForChild("Plots")
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = folder

	-- The barn itself: floor, walls, roof and sliding doors.
	local barn = Barn.build(folder, decor, origin, index)
	folder:SetAttribute("Origin", origin)
	folder:SetAttribute("Size", PLOT_SIZE)

	-- Round stone pedestals with a glowing rim. Freeks stand on top (pad.ground).
	local pads = {}
	for i = 1, Config.MAX_SLOTS + Config.PASS_SLOTS do
		local column = (i - 1) % PAD_COLUMNS
		local row = (i - 1) // PAD_COLUMNS
		local spot = origin * CFrame.new((column - (PAD_COLUMNS - 1) / 2) * 12.2, 1, 4 + row * 10)
		local rim = part({
			Name = "PadRim" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 9.4, 9.4),
			CFrame = spot * CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.pi / 2),
			Material = Enum.Material.Neon,
			Color = accent,
			Parent = folder,
		})
		local base = part({
			Name = "Pad" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, 8.6, 8.6),
			CFrame = spot * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.pi / 2),
			Material = Enum.Material.Marble,
			Parent = folder,
		})
		local lockGui, lockLabel = billboard(base, UDim2.fromScale(4, 2), Vector3.new(0, 1.5, 0), 60)
		lockLabel.Text = "🔒"
		lockLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
		pads[i] = { ground = spot * CFrame.new(0, 0.6, 0), base = base, rim = rim, lock = lockGui }
	end

	-- Two hay-floored Fusion Dens with low plank walls; the second needs the Extra Fusion
	-- Den pass.
	local pens = {}
	for i, x in { -12, 12 } do
		local penSpot = origin * CFrame.new(x, 1, -14)
		local floor = part({
			Name = "FusionDen" .. i,
			Size = Vector3.new(19, 0.4, 9.5),
			CFrame = penSpot * CFrame.new(0, 0.2, 0),
			Color = Color3.fromRGB(230, 200, 120),
			Material = Enum.Material.Sand,
			Parent = folder,
		})
		local corner = function(dx, dz)
			return (penSpot * CFrame.new(dx, 0, dz)).Position
		end
		for _, wall in
			{
				{ corner(0, 4.9), Vector3.new(19.4, 3, 0.5) },
				{ corner(-9.7, 0), Vector3.new(0.5, 3, 9.8) },
				{ corner(9.7, 0), Vector3.new(0.5, 3, 9.8) },
			}
		do
			part({
				Name = "DenWall",
				Size = wall[2],
				CFrame = CFrame.new(wall[1] + Vector3.new(0, 1.5, 0)) * origin.Rotation,
				Color = Color3.fromRGB(150, 100, 65),
				Material = Enum.Material.WoodPlanks,
				Parent = decor,
			})
		end
		part({
			Name = "Hay",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(4, 4, 4),
			CFrame = penSpot * CFrame.new(x / math.abs(x) * 7, -0.9, 3),
			Color = Color3.fromRGB(235, 200, 100),
			Material = Enum.Material.Sand,
			CanCollide = false,
			Parent = decor,
		})
		local _, label = billboard(floor, UDim2.fromScale(13, 2.3), Vector3.new(0, 9, 0), 80)
		pens[i] = { part = floor, label = label }
	end

	local gateGuiPart = part({
		Name = "GateSign",
		Size = Vector3.new(1, 1, 1),
		CFrame = origin * CFrame.new(0, 30, -half),
		Transparency = 1,
		CanCollide = false,
		Parent = folder,
	})
	local _, gateLabel = billboard(gateGuiPart, UDim2.fromScale(12, 2.5), Vector3.zero, 120)

	-- The padlock post just inside the gate: the only place the owner can lock it from.
	local lockSpot = origin * CFrame.new(GATE_WIDTH / 2 + 1.5, 1, -half + 4)
	local metal = Color3.fromRGB(55, 55, 65)
	part({
		Name = "LockPost",
		Size = Vector3.new(0.8, 3.4, 0.8),
		CFrame = lockSpot * CFrame.new(0, 1.7, 0),
		Color = metal,
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	local lockBody = part({
		Name = "Padlock",
		Size = Vector3.new(1.6, 1.3, 0.6),
		CFrame = lockSpot * CFrame.new(0, 4.05, 0),
		Color = Color3.fromRGB(235, 185, 60),
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	for _, x in { -0.5, 0.5 } do
		part({
			Name = "Shackle",
			Size = Vector3.new(0.22, 0.8, 0.22),
			CFrame = lockSpot * CFrame.new(x, 5.1, 0),
			Color = Color3.fromRGB(200, 200, 210),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end
	part({
		Name = "Shackle",
		Size = Vector3.new(1.22, 0.22, 0.22),
		CFrame = lockSpot * CFrame.new(0, 5.5, 0),
		Color = Color3.fromRGB(200, 200, 210),
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	local lockLight = part({
		Name = "LockLight",
		Size = Vector3.new(0.5, 0.5, 0.7),
		CFrame = lockSpot * CFrame.new(0, 3.95, 0),
		Color = Color3.fromRGB(255, 70, 70),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
	local lockPrompt = Instance.new("ProximityPrompt")
	lockPrompt.Name = "LockPrompt"
	lockPrompt.ActionText = "Lock Gate"
	lockPrompt.ObjectText = "Gate"
	lockPrompt.HoldDuration = 0.4
	lockPrompt.MaxActivationDistance = 8
	lockPrompt.RequiresLineOfSight = false
	lockPrompt:SetAttribute("PlotIndex", index)
	lockPrompt.Parent = lockBody

	local freekFolder = Instance.new("Folder")
	freekFolder.Name = "Freeks"
	freekFolder.Parent = folder

	local plot = {
		index = index,
		origin = origin,
		accent = accent,
		spawn = origin * CFrame.new(0, 4, -(PLOT_SIZE / 2 - 5)) * CFrame.Angles(0, math.pi, 0),
		pads = pads,
		pens = pens,
		signLabels = {},
		signName = "EMPTY",
		signSub = "Barn",
		archTier = 0,
		archFolder = nil,
		gateGuiPart = gateGuiPart,
		half = half,
		freeks = freekFolder,
		barn = barn,
		gateLabel = gateLabel,
		lockLight = lockLight,
		lockPrompt = lockPrompt,
		lockedUntil = math.huge,
		owner = nil,
	}
	plots[index] = plot
	return plot
end

-- steal = { uid, ownerUserId } for Freeks on pads, so other players get a Steal prompt.
local function placeFreek(plot, freek, ground: CFrame, steal)
	local model, height = FreekModel.build(freek.species, freek.mutations)
	model:PivotTo(ground)
	-- Where it rests: clients bob it around this spot (never around wherever it is now).
	model:SetAttribute("Ground", ground)
	model.Parent = plot.freeks

	local anchor = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not anchor then
		return
	end
	-- The tag hangs off the body, so measure the offset from the body's center, not the feet.
	FreekTag.add(anchor, freek, height - (anchor.Position.Y - ground.Position.Y) + 1.4, 70)

	if steal then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "StealPrompt"
		prompt.ActionText = "Steal"
		prompt.ObjectText = FreekUtil.displayName(freek)
		prompt.HoldDuration = Config.STEAL_HOLD_SECONDS
		prompt.MaxActivationDistance = 9
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("Uid", steal.uid)
		prompt:SetAttribute("OwnerUserId", steal.ownerUserId)
		prompt.Parent = anchor
	end
end

-- Unlocked pedestals are white marble with a glowing rim in the yard's colour.
local function setPadLook(plot, pad, unlocked: boolean)
	pad.base.Color = if unlocked then Color3.fromRGB(235, 232, 225) else Color3.fromRGB(85, 85, 92)
	pad.base.Material = if unlocked then Enum.Material.Marble else Enum.Material.Slate
	pad.rim.Color = if unlocked then plot.accent else Color3.fromRGB(55, 55, 60)
	pad.rim.Material = if unlocked then Enum.Material.Neon else Enum.Material.SmoothPlastic
end

local function updatePenLabels(plot, data)
	local owner = plot.owner
	for i, pen in plot.pens do
		local breeding = data and FreekUtil.pen(data, i)
		local usable = owner ~= nil and i <= GamePasses.penCount(owner)
		pen.part.Color = if usable then Color3.fromRGB(230, 200, 120) else Color3.fromRGB(95, 95, 100)
		pen.part.Material = if usable then Enum.Material.Sand else Enum.Material.Concrete
		if not owner then
			pen.label.Text = ""
		elseif breeding then
			local left = breeding.endsAt - os.time()
			pen.label.Text = if left > 0 then "Fusing... " .. Format.time(left) else "Fusion complete!"
		elseif usable then
			pen.label.Text = "Fusion Den"
		else
			pen.label.Text = "Extra Den · Store"
		end
	end
end

function PlotService.render(player: Player)
	local plot = plotOf[player]
	local data = DataService.get(player)
	if not plot or not data then
		return
	end

	plot.freeks:ClearAllChildren()
	local tier = GateTiers.forRebirths(data.rebirths)
	if plot.archTier ~= tier then
		buildArch(plot, tier)
	end
	setSign(plot, player.DisplayName .. "'s", if (data.rebirths or 0) > 0 then "Barn  ⭐" .. data.rebirths else "Barn")
	BarnUpgrades.apply(plot, data.rebirths or 0, data)

	for i, pad in plot.pads do
		local unlocked = i <= FreekUtil.totalSlots(data)
		setPadLook(plot, pad, unlocked)
		pad.lock.Enabled = not unlocked
	end

	for uid, freek in data.freeks do
		local pad = freek.slot and plot.pads[freek.slot]
		if pad then
			placeFreek(plot, freek, pad.ground, {
				uid = uid,
				ownerUserId = player.UserId,
			})
		end
	end

	for i, pen in plot.pens do
		local breeding = FreekUtil.pen(data, i)
		if breeding then
			local penTop = pen.part.CFrame * CFrame.new(0, 0.2, 0)
			local a = data.freeks[breeding.a]
			local b = data.freeks[breeding.b]
			if a then
				placeFreek(plot, a, penTop * CFrame.new(-5, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0))
			end
			if b then
				placeFreek(plot, b, penTop * CFrame.new(5, 0, 0) * CFrame.Angles(0, math.pi / 2, 0))
			end
		end
	end
	updatePenLabels(plot, data)
end

local function setGateLock(plot, lockedUntil: number)
	plot.lockedUntil = lockedUntil
	if plot.owner then
		plot.owner:SetAttribute("GateLockedUntil", lockedUntil)
	end
end

local function updateGate(plot)
	local left = plot.lockedUntil - Workspace:GetServerTimeNow()
	local locked = left > 0
	Barn.setLocked(plot.barn, locked)
	plot.lockLight.Color = if locked then Color3.fromRGB(80, 255, 110) else Color3.fromRGB(255, 70, 70)
	plot.lockPrompt.ActionText = if locked then "Locked " .. Format.time(left) else "Lock Gate"
	if not plot.owner then
		plot.gateLabel.Text = ""
	elseif locked then
		plot.gateLabel.Text = "LOCKED " .. Format.time(left)
		plot.gateLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
	else
		plot.gateLabel.Text = "GATE OPEN"
		plot.gateLabel.TextColor3 = Color3.fromRGB(120, 255, 120)
	end
end

-- Lets the owner's character pass through their own locked barn doors.
local function setCollisionGroup(character: Model, group: string)
	local function apply(descendant)
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = group
		end
	end
	for _, descendant in character:GetDescendants() do
		apply(descendant)
	end
	character.DescendantAdded:Connect(apply)
end

local function clearPlot(plot)
	setGateLock(plot, math.huge) -- empty yards stay shut
	plot.owner = nil
	plot.freeks:ClearAllChildren()
	setSign(plot, "Empty", "Barn")
	BarnUpgrades.apply(plot, 0, nil)
	if plot.archTier ~= 1 then
		buildArch(plot, 1)
	end
	updatePenLabels(plot, nil)
	for _, pad in plot.pads do
		setPadLook(plot, pad, false)
		pad.lock.Enabled = false
	end
	updateGate(plot)
end

local function sendHome(player: Player)
	local plot = plotOf[player]
	local character = player.Character
	if plot and character then
		character:PivotTo(plot.spawn)
	end
end

local function onPlayerAdded(player: Player)
	for _, plot in plots do
		if not plot.owner then
			plot.owner = player
			plotOf[player] = plot
			player:SetAttribute("Plot", plot.index)
			-- New arrivals get one free lock so they aren't robbed while loading in.
			setGateLock(plot, Workspace:GetServerTimeNow() + GamePasses.gateLockSeconds(player))
			player.CharacterAdded:Connect(function(character)
				setCollisionGroup(character, "Owner" .. plot.index)
				task.wait(0.1)
				sendHome(player)
			end)
			if player.Character then
				setCollisionGroup(player.Character, "Owner" .. plot.index)
			end
			sendHome(player)
			PlotService.render(player)
			return
		end
	end
	Remotes.get("Notify"):FireClient(player, "This server is full of barns! Try another server.", "error")
end

-- Every yard's origin (gate faces -Z), for scenery that decorates all yards.
-- Dresses a barn as if its owner had `rebirths` rebirths (for previews and tests).
function PlotService.previewLook(index: number, rebirths: number, data)
	local plot = plots[index]
	if plot then
		buildArch(plot, GateTiers.forRebirths(rebirths))
		setSign(plot, "Mike's", if rebirths > 0 then "Barn  ⭐" .. rebirths else "Barn")
		BarnUpgrades.apply(plot, rebirths, data)
	end
end

function PlotService.origins(): { CFrame }
	local list = {}
	for _, plot in plots do
		table.insert(list, plot.origin)
	end
	return list
end

function PlotService.getPlot(player: Player)
	return plotOf[player]
end

-- True if a world position is inside a plot's fence.
function PlotService.isInside(plot, position: Vector3): boolean
	local localPos = plot.origin:PointToObjectSpace(position)
	local limit = PLOT_SIZE / 2 - 1
	return math.abs(localPos.X) < limit and math.abs(localPos.Z) < limit
end

function PlotService.isGateLocked(plot): boolean
	return Workspace:GetServerTimeNow() < plot.lockedUntil
end

-- Returns an error message, or nil if the gate was locked.
function PlotService.lockGate(player: Player): string?
	local plot = plotOf[player]
	if not plot then
		return "You don't have a barn."
	end
	if PlotService.isGateLocked(plot) then
		return "Your gate is already locked."
	end
	setGateLock(plot, Workspace:GetServerTimeNow() + GamePasses.gateLockSeconds(player))
	updateGate(plot)
	return nil
end

function PlotService.init()
	for i = 1, Config.PLOT_COUNT do
		PhysicsService:RegisterCollisionGroup("Gate" .. i)
		PhysicsService:RegisterCollisionGroup("Owner" .. i)
		PhysicsService:CollisionGroupSetCollidable("Gate" .. i, "Owner" .. i, false)
	end
	buildMap()
	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = Workspace
	for i = 1, Config.PLOT_COUNT do
		clearPlot(buildPlot(i))
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local plot = plotOf[player]
		if plot then
			clearPlot(plot)
		end
		plotOf[player] = nil
	end)

	DataService.onChanged(function(player)
		PlotService.render(player)
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, plot in plots do
				updateGate(plot)
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			for player, plot in plotOf do
				local data = DataService.get(player)
				if data and (data.breeding or data.breeding2) then
					updatePenLabels(plot, data)
				end
			end
		end
	end)
end

return PlotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">RebirthService</string>
          <string name="Source"><![CDATA[-- Rebirth: pay Config.rebirthCost to start over with a permanent income bonus.
--
-- Resets: money (back to START_MONEY), Freeks, yard slots, the breeding pen.
-- Keeps: the Discovery Book, Limited (seasonal) Freeks (moved to the backpack, then back into
-- the yard), and weapons, which unlock at rebirth milestones (see Weapons.luau).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Weapons = require(ReplicatedStorage.Shared.Weapons)

local ActionService = require(script.Parent.ActionService)
local Carried = require(script.Parent.Carried)
local DataService = require(script.Parent.DataService)
local StealService = require(script.Parent.StealService)
local TradeService = require(script.Parent.TradeService)
local WeaponService = require(script.Parent.WeaponService)

local RebirthService = {}

local notifyRemote = Remotes.get("Notify")

local function notify(player: Player, message: string, kind: string?)
	notifyRemote:FireClient(player, message, kind)
end

local function rebirth(player: Player, data)
	local cost = Config.rebirthCost(data.rebirths)
	if data.money < cost then
		return notify(player, "You need " .. Format.money(cost) .. " to rebirth!", "error")
	end
	if TradeService.isTrading(player) then
		return notify(player, "Finish your trade before rebirthing!", "error")
	end
	if StealService.isCarrying(player) or Carried.any(player) then
		return notify(player, "You can't rebirth in the middle of a steal!", "error")
	end

	-- Limited Freeks survive; everything else is cleared.
	local kept = {}
	for uid, freek in data.freeks do
		local species = FreekUtil.species(freek)
		if species and species.season then
			kept[uid] = { species = freek.species, mutations = freek.mutations, income = freek.income }
		end
	end
	data.freeks = kept
	data.breeding = nil
	data.breeding2 = nil
	data.money = Config.TEST_MONEY or Config.START_MONEY
	data.slots = Config.START_SLOTS
	data.rebirths += 1
	for _, freek in data.freeks do
		freek.slot = FreekUtil.freeSlot(data)
	end

	WeaponService.giveWeapons(player)
	task.spawn(DataService.save, player)

	local unlocked = {}
	for _, weaponId in Weapons.order do
		if Weapons.list[weaponId].rebirth == data.rebirths then
			table.insert(unlocked, Weapons.list[weaponId].name)
		end
	end
	local message = string.format(
		"Rebirth %d! Your Freeks now earn x%s forever.",
		data.rebirths,
		tostring(Config.incomeMultiplier(data.rebirths))
	)
	if #unlocked > 0 then
		message ..= " Unlocked: " .. table.concat(unlocked, ", ") .. "!"
	end
	notify(player, message, "discovery")
	for _, other in Players:GetPlayers() do
		if other ~= player then
			notify(other, player.DisplayName .. " just reached Rebirth " .. data.rebirths .. "!", "discovery")
		end
	end
end

function RebirthService.init()
	ActionService.register("Rebirth", rebirth)
end

return RebirthService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Recipes</string>
          <string name="Source"><![CDATA[-- Decides what two Freeks fuse into. Server-only so players can't read the Secret recipes
-- out of the game.
--
-- Normally the result is the hybrid of the two (shared/Hybrids, via Breeding.babySpecies),
-- so every pair already has its own result. The only hand-made results are the Ultra
-- pairs in SECRETS: those make a Secret instead, the only way to get one.

local Shared = game:GetService("ReplicatedStorage").Shared
local Breeding = require(Shared.Breeding)
local Freeks = require(Shared.Freeks)
local Seasons = require(Shared.Seasons)

-- ["UltraA|UltraB"] = "SecretFreek" (names in either order).
local SECRETS = {}

local Recipes = {}

local function pairKey(a: string, b: string): string
	return if a < b then a .. "|" .. b else b .. "|" .. a
end

-- Accept keys written in either order.
local sorted = {}
for key, value in SECRETS do
	local a, b = string.match(key, "^(.-)|(.*)$")
	sorted[pairKey(a, b)] = value
end
SECRETS = sorted

-- Returns the fused Freek's species, mutations (a list, or nil) and income (before
-- mutations) for two parent records.
function Recipes.roll(parentA, parentB, rng: Random): (string, { string }?, number)
	local mutations = Breeding.rollMutations(parentA, parentB, rng)
	local income = Breeding.babyIncome(parentA, parentB)

	local _, bothUltra = Breeding.babyRarity(parentA, parentB)
	local secret = bothUltra and SECRETS[pairKey(parentA.species, parentB.species)]
	if secret and Freeks.byId[secret] and Seasons.available(Freeks.byId[secret]) then
		return secret, mutations, math.max(income, Freeks.byId[secret].income)
	end

	return Breeding.babySpecies(parentA, parentB), mutations, income
end

return Recipes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">SeasonalService</string>
          <string name="Source"><![CDATA[-- Seasonal themes: while an event is running, the map dresses up for it (recoloured
-- trees, props, lighting) and goes back to normal when the event ends. Checked every two
-- minutes, so themes switch on and off without restarting servers.
--
-- To add a theme for another event, add an entry to THEMES keyed by its Seasons id.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Drops = require(ReplicatedStorage.Shared.Drops)
local Seasons = require(ReplicatedStorage.Shared.Seasons)

local Decor = require(script.Parent.Decor)
local HalloweenDecor = require(script.Parent.HalloweenDecor)
local PlotService = require(script.Parent.PlotService)

local SeasonalService = {}

local current = nil -- id of the theme on show, or nil
local folder = nil -- props added by the current theme
local defaults = {} -- lighting/terrain values to restore

-- Pick a colour from a palette based on a part's position, so it's stable but varied.
local function pick(palette, part: BasePart)
	local p = part.Position
	local index = math.floor(math.abs(p.X * 7 + p.Y * 13 + p.Z * 3)) % #palette + 1
	return palette[index]
end

local function facingSquare(position: Vector3): CFrame
	return CFrame.lookAt(position, Vector3.new(position.X, position.Y, 0))
end

local THEMES = {}

THEMES.Halloween = {
	leaves = Decor.FALL_LEAVES,
	grass = Color3.fromRGB(150, 165, 75),
	lawn = Color3.fromRGB(150, 170, 80),
	bulb = Color3.fromRGB(255, 140, 40),
	-- Spooky twilight: sun on the horizon, purple haze, extra glow on lights and pumpkins.
	lighting = {
		Lighting = {
			ClockTime = 18.1,
			Brightness = 1.8,
			Ambient = Color3.fromRGB(80, 60, 100),
			OutdoorAmbient = Color3.fromRGB(135, 110, 160),
		},
		Atmosphere = {
			Density = 0.36,
			Color = Color3.fromRGB(190, 130, 190),
			Decay = Color3.fromRGB(70, 35, 90),
			Haze = 2.2,
			Glare = 0.4,
		},
		ColorCorrectionEffect = {
			TintColor = Color3.fromRGB(255, 228, 240),
			Saturation = 0.25,
			Contrast = 0.12,
		},
		BloomEffect = { Intensity = 0.9 },
	},
	-- Cobwebs in the top corners of every gate arch and string lights along its beam.
	-- Runs whenever an arch is (re)built, so it fits every gate tier.
	arch = function(arch: Instance, info)
		local origin, x, y, z = info.origin, info.innerX, info.beamBottom, info.front
		HalloweenDecor.cobweb(arch, origin * CFrame.new(-x, y, z), 3)
		HalloweenDecor.cobweb(arch, origin * CFrame.new(x, y, z) * CFrame.Angles(0, math.pi, 0), 3)
		HalloweenDecor.stringLights(
			arch,
			(origin * CFrame.new(-x, y - 0.1, z - 0.1)).Position,
			(origin * CFrame.new(x, y - 0.1, z - 0.1)).Position,
			10,
			0.8
		)
	end,
	build = function(props: Folder)
		-- Every barn: jack-o'-lanterns flanking the doors, one inside by the dens, and a
		-- pile of leaves under each tree out back.
		for i, origin in PlotService.origins() do
			for _, side in { -1, 1 } do
				Decor.pumpkin(props, origin * CFrame.new(side * 16, 0.3, -34.5), 1) -- outside the doors
				Decor.pumpkin(props, origin * CFrame.new(side * 26, 1, -22), 0.8) -- inside
				Decor.leafPile(props, origin * CFrame.new(side * 24, 0, 39.5), i * 10 + side)
			end
		end
		-- Pumpkins along both walkways, facing the town square.
		for x = -122.5, 122.5, 35 do
			for _, z in { -28, 28 } do
				Decor.pumpkin(props, facingSquare(Vector3.new(x, 0.3, z)), 0.9)
			end
		end
		-- Hay bales topped with pumpkins by the Freek House and the spawn.
		local house = Drops.HOUSE_POSITION
		for _, spot in
			{
				house + Vector3.new(3, 0, -14),
				house + Vector3.new(3, 0, 14),
				house + Vector3.new(14, 0, -10),
				house + Vector3.new(14, 0, 10),
				Vector3.new(150, 0, -7),
				Vector3.new(150, 0, 7),
			}
		do
			local ground = facingSquare(spot)
			Decor.hayBale(props, ground)
			Decor.pumpkin(props, ground * CFrame.new(0, 2.4, 0), 0.8)
		end
		-- Jack-o'-lanterns flanking the Monster Egg stand.
		for _, z in { -21, 21 } do
			Decor.pumpkin(props, CFrame.new(128, 0, z) * CFrame.Angles(0, math.pi / 2, 0), 1.4)
		end
		-- Leaf piles scattered along the tree line.
		for x = -190, 190, 38 do
			for _, z in { -142, 142 } do
				Decor.leafPile(props, CFrame.new(x, 0, z), x + z)
			end
		end

		-- String lights between the street lamps along both walkways, and low fog over the
		-- town square.
		for _, x in { -140, -70, 0, 70 } do
			for _, z in { -28.5, 28.5 } do
				HalloweenDecor.stringLights(props, Vector3.new(x, 7.6, z), Vector3.new(x + 70, 7.6, z), 24, 3)
			end
		end
		for x = Drops.AREA.minX, Drops.AREA.maxX, 40 do
			for _, z in { -14, 14 } do
				HalloweenDecor.fog(props, Vector3.new(x, 0.5, z))
			end
		end

		-- A witch hat on the Freek House.
		HalloweenDecor.witchHat(props, CFrame.new(house + Vector3.new(0, 22.5, 0)), 1.3, Color3.fromRGB(70, 30, 110))

		-- A graveyard past the spawn, with dead trees, fog and a bubbling cauldron.
		for row = 0, 1 do
			for col = 0, 4 do
				local ground = CFrame.new(172 + row * 9, 0, -16 + col * 8) * CFrame.Angles(0, -math.pi / 2, 0)
				HalloweenDecor.tombstone(props, ground, row * 10 + col)
			end
		end
		HalloweenDecor.deadTree(props, CFrame.new(190, 0, -22), 1.2, 1)
		HalloweenDecor.deadTree(props, CFrame.new(188, 0, 21), 1, 2)
		HalloweenDecor.deadTree(props, CFrame.new(-150, 0, -24), 1.1, 3)
		HalloweenDecor.deadTree(props, CFrame.new(-150, 0, 26), 1.2, 4)
		for _, spot in { Vector3.new(176, 0.5, -10), Vector3.new(180, 0.5, 8), Vector3.new(170, 0.5, 18) } do
			HalloweenDecor.fog(props, spot)
		end
		HalloweenDecor.cauldron(props, CFrame.new(160, 0, 0))

		-- Ghosts drifting around; bats circling the Freek Houses, the graveyard and the title.
		local houses = Drops.HOUSE_POSITION
		HalloweenDecor.ghost(props, houses, 22, 16, 0.25, 0)
		HalloweenDecor.ghost(props, houses, 26, 20, -0.2, 2)
		HalloweenDecor.ghost(props, Vector3.new(178, 0, 0), 14, 9, 0.3, 1)
		HalloweenDecor.ghost(props, Vector3.new(178, 0, 0), 18, 12, -0.22, 4)
		for i, x in { -70, 0, 70 } do
			HalloweenDecor.ghost(props, Vector3.new(x, 0, 0), 16, 14, if i % 2 == 0 then 0.18 else -0.18, i)
		end
		for i = 1, 6 do
			HalloweenDecor.bat(props, houses, 12 + i * 2, 20 + i % 3 * 2, 0.6 + i * 0.05, i)
		end
		for i = 1, 4 do
			HalloweenDecor.bat(props, Vector3.new(178, 0, 0), 10 + i * 2, 14 + i, -0.7, i * 1.5)
		end
		for i = 1, 4 do
			HalloweenDecor.bat(props, Vector3.zero, 22 + i * 3, 26 + i, 0.5, i * 1.6)
		end
	end,
}

local function recolour(tag: string, palette)
	for _, part in CollectionService:GetTagged(tag) do
		if palette == nil then
			part.Color = part:GetAttribute("BaseColor") or part.Color
		elseif typeof(palette) == "Color3" then
			part.Color = palette
		else
			part.Color = pick(palette, part)
		end
	end
end

local function setLamps(color: Color3?)
	for _, bulb in CollectionService:GetTagged(Decor.TAGS.bulb) do
		bulb.Color = color or bulb:GetAttribute("BaseColor") or bulb.Color
		local light = bulb:FindFirstChildOfClass("PointLight")
		if light then
			light.Color = color or bulb.Color
		end
	end
end

local function captureDefaults()
	defaults = { grass = Workspace.Terrain:GetMaterialColor(Enum.Material.Grass) }
end

-- Applies a theme's lighting ({ ClassName = { Property = value } }, where "Lighting" is the
-- Lighting service itself) and remembers the old values so clearTheme can put them back.
local saved = {}
local function applyLighting(settings)
	for className, props in settings or {} do
		local target = if className == "Lighting" then Lighting else Lighting:FindFirstChildOfClass(className)
		if target then
			saved[target] = saved[target] or {}
			for key, value in props do
				if saved[target][key] == nil then
					saved[target][key] = target[key]
				end
				target[key] = value
			end
		end
	end
end

local function restoreLighting()
	for target, props in saved do
		for key, value in props do
			target[key] = value
		end
	end
	table.clear(saved)
end

local function clearTheme()
	if folder then
		folder:Destroy()
		folder = nil
	end
	recolour(Decor.TAGS.leaves, nil)
	recolour(Decor.TAGS.lawn, nil)
	setLamps(nil)
	restoreLighting()
	PlotService.setArchDecorator(nil)
	Workspace.Terrain:SetMaterialColor(Enum.Material.Grass, defaults.grass)
	current = nil
end

local function applyTheme(id: string)
	local theme = THEMES[id]
	folder = Instance.new("Folder")
	folder.Name = "Seasonal_" .. id
	folder.Parent = Workspace
	theme.build(folder)
	recolour(Decor.TAGS.leaves, theme.leaves)
	recolour(Decor.TAGS.lawn, theme.lawn)
	setLamps(theme.bulb)
	applyLighting(theme.lighting)
	if theme.arch then
		PlotService.setArchDecorator(theme.arch)
	end
	Workspace.Terrain:SetMaterialColor(Enum.Material.Grass, theme.grass)
	current = id
end

local function update()
	local wanted = nil
	for _, id in Seasons.active() do
		if THEMES[id] then
			wanted = id
			break
		end
	end
	if wanted == current then
		return
	end
	if current then
		clearTheme()
	end
	if wanted then
		applyTheme(wanted)
	end
end

function SeasonalService.init()
	captureDefaults()
	update()
	task.spawn(function()
		while true do
			task.wait(120)
			update()
		end
	end)
end

return SeasonalService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">StealService</string>
          <string name="Source"><![CDATA[-- Stealing Freeks from other players' yards.
--
-- While a yard's gate is open, anyone else can walk in and hold the Steal prompt on a Freek
-- standing on a pad. The Freek floats over the thief's head and they walk slower: barely
-- for a Common, a lot for a Secret (see carrySpeed in Rarities).
--
-- While it's being carried:
--   * anyone can hit the carrier with a weapon (WeaponService) and it goes home;
--   * the owner can Snatch it back and it goes home;
--   * any other player can Snatch it and carry it to their own yard instead;
--   * if the carrier dies or leaves, it goes home.
-- Whoever gets it inside their own fence keeps it.
--
-- The Freek stays in the owner's save until the moment it's delivered, so a crash mid-steal
-- can never lose or duplicate it.
--
-- Freeks bought off the belt use the same carrying (see carryHome): they ride on the buyer's
-- head until the buyer walks into their own yard, then take the first free pad. They're
-- already in the buyer's save, can't be snatched, and don't slow the buyer down.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local FreekModel = require(ReplicatedStorage.Shared.FreekModel)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Carried = require(script.Parent.Carried)
local DataService = require(script.Parent.DataService)
local DiscoveryService = require(script.Parent.DiscoveryService)
local PlotService = require(script.Parent.PlotService)

local StealService = {}

local notifyRemote = Remotes.get("Notify")
-- [carrier Player] = { owner, uid, slot, name, species, mutations, model, normalSpeed }
local carries = {}

local function notify(player: Player, message: string, kind: string?)
	if player.Parent then
		notifyRemote:FireClient(player, message, kind)
	end
end

local function rootPart(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- How far the arms swing forward to hold a Freek (R15 characters).
local HOLD_ANGLE = math.rad(60)

-- Puts the Freek in the carrier's arms, slows them down, and adds a Snatch prompt for
-- everyone else. Returns false if the carrier has no character to carry it.
local function pickUp(carrier: Player, carry): boolean
	local character = carrier.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return false
	end
	local model = FreekModel.build(carry.species, carry.mutations)
	pcall(function()
		model:ScaleTo(0.6)
	end)
	-- Held out in front at the hands, facing the same way as the carrier.
	model:PivotTo(root.CFrame * CFrame.new(0, 0.4, -1.8))
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = descendant
			weld.Parent = descendant
		end
	end

	-- Arms out to hold it. Changing the shoulder joints' C0 (not Transform) keeps the pose
	-- under the walk animation, and putDown puts them back.
	carry.shoulders = {}
	for _, name in { "RightUpperArm.RightShoulder", "LeftUpperArm.LeftShoulder" } do
		local armName, jointName = string.match(name, "^(.-)%.(.*)$")
		local arm = character:FindFirstChild(armName)
		local joint = arm and arm:FindFirstChild(jointName)
		if joint and joint:IsA("Motor6D") then
			table.insert(carry.shoulders, { joint = joint, c0 = joint.C0 })
			joint.C0 = joint.C0 * CFrame.Angles(HOLD_ANGLE, 0, 0)
		end
	end

	if not carry.bought then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "SnatchPrompt"
		prompt.ActionText = "Snatch"
		prompt.ObjectText = carry.name
		prompt.HoldDuration = Config.SNATCH_HOLD_SECONDS
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("CarrierUserId", carrier.UserId)
		prompt.Parent = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	end

	model.Name = "CarriedFreek"
	model.Parent = character

	carry.model = model
	carry.normalSpeed = humanoid.WalkSpeed
	if not carry.bought then
		-- Rarer Freeks are heavier: the thief slows down more.
		local rarity = FreekUtil.species(carry).rarity
		humanoid.WalkSpeed = math.min(carry.normalSpeed, Rarities.info[rarity].carrySpeed)
	end

	carries[carrier] = carry
	Carried.set(carry.owner, carry.uid, carrier)
	return true
end

-- Takes the Freek off the carrier and gives them their speed back.
local function putDown(carrier: Player, carry)
	carries[carrier] = nil
	if carry.model then
		carry.model:Destroy()
		carry.model = nil
	end
	for _, shoulder in carry.shoulders or {} do
		if shoulder.joint.Parent then
			shoulder.joint.C0 = shoulder.c0
		end
	end
	carry.shoulders = nil
	local character = carrier.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and carry.normalSpeed then
		humanoid.WalkSpeed = carry.normalSpeed
	end
end

-- The Freek goes back to its owner's yard (or backpack, if its pad was filled meanwhile).
local function sendBack(carrier: Player, carry, ownerMessage: string?, carrierMessage: string?)
	if carry.bought then
		-- The buyer is the owner: one message is enough.
		ownerMessage, carrierMessage = "You dropped " .. carry.name .. ", so it went straight to your barn.", nil
	end
	putDown(carrier, carry)
	Carried.set(carry.owner, carry.uid, nil)
	local ownerData = DataService.get(carry.owner)
	local freek = ownerData and ownerData.freeks[carry.uid]
	if freek and not freek.slot then
		local taken = false
		for _, other in ownerData.freeks do
			if other.slot == carry.slot then
				taken = true
			end
		end
		freek.slot = if taken
				or not carry.slot
				or carry.slot > FreekUtil.totalSlots(ownerData)
			then FreekUtil.freeSlot(ownerData)
			else carry.slot
		DataService.changed(carry.owner)
	end
	if ownerMessage then
		notify(carry.owner, ownerMessage, "success")
	end
	if carrierMessage then
		notify(carrier, carrierMessage, "error")
	end
end

local function deliver(carrier: Player, carry)
	if carry.bought then
		-- Already the buyer's: just find it a pad (or the backpack, if the yard filled up).
		putDown(carrier, carry)
		Carried.set(carrier, carry.uid, nil)
		local data = DataService.get(carrier)
		local freek = data and data.freeks[carry.uid]
		if freek and not freek.slot then
			freek.slot = FreekUtil.freeSlot(data)
			DataService.changed(carrier)
			if freek.slot then
				notify(carrier, carry.name .. " is home in your barn!", "success")
			else
				notify(carrier, "Your barn is full, so " .. carry.name .. " went in your backpack.", "error")
			end
		end
		return
	end
	local ownerData = DataService.get(carry.owner)
	local carrierData = DataService.get(carrier)
	local freek = ownerData and ownerData.freeks[carry.uid]
	if not freek or not carrierData then
		return sendBack(carrier, carry)
	end
	if FreekUtil.count(carrierData) >= GamePasses.maxFreeks(carrier) then
		return sendBack(carrier, carry, nil, "You have too many Freeks! It ran back home.")
	end

	putDown(carrier, carry)
	Carried.set(carry.owner, carry.uid, nil)
	ownerData.freeks[carry.uid] = nil
	carrierData.freeks[carry.uid] = {
		species = freek.species,
		mutations = freek.mutations,
		income = freek.income,
		slot = FreekUtil.freeSlot(carrierData),
	}
	carrierData.discovered[freek.species] = true
	task.spawn(DiscoveryService.claim, carrier, freek.species)

	for _, player in { carry.owner, carrier } do
		DataService.changed(player)
		task.spawn(DataService.save, player)
	end
	notify(carry.owner, carrier.DisplayName .. " stole your " .. carry.name .. "! Lock your gate!", "error")
	notify(carrier, "You stole " .. carry.name .. "!", "success")
end

-- Checks a player could carry a Freek home right now. Returns an error message or nil.
local function cannotCarry(player: Player): string?
	if carries[player] then
		return "You can only carry one Freek at a time!"
	end
	local data = DataService.get(player)
	if not data or not PlotService.getPlot(player) or not rootPart(player) then
		return ""
	end
	if FreekUtil.count(data) >= GamePasses.maxFreeks(player) then
		return "You have too many Freeks to steal another!"
	end
	return nil
end

local function steal(prompt: ProximityPrompt, thief: Player)
	local uid = prompt:GetAttribute("Uid")
	local owner = Players:GetPlayerByUserId(prompt:GetAttribute("OwnerUserId") or 0)
	if not owner or owner == thief or typeof(uid) ~= "string" then
		return
	end
	local problem = cannotCarry(thief)
	if problem then
		return if problem ~= "" then notify(thief, problem, "error") else nil
	end

	local ownerData = DataService.get(owner)
	local ownerPlot = PlotService.getPlot(owner)
	local freek = ownerData and ownerData.freeks[uid]
	if not freek or not freek.slot or freek.breeding or Carried.is(owner, uid) or not ownerPlot then
		return
	end
	if PlotService.isGateLocked(ownerPlot) or not PlotService.isInside(ownerPlot, rootPart(thief).Position) then
		return
	end

	local carry = {
		owner = owner,
		uid = uid,
		slot = freek.slot,
		name = FreekUtil.displayName(freek),
		species = freek.species,
		mutations = freek.mutations,
	}
	if not pickUp(thief, carry) then
		return
	end
	freek.slot = nil
	DataService.changed(owner)

	notify(thief, "You grabbed " .. carry.name .. "! Get it back to your barn!", "success")
	notify(owner, thief.DisplayName .. " is stealing your " .. carry.name .. "! Bonk them!", "error")
end

local function snatch(prompt: ProximityPrompt, snatcher: Player)
	local carrier = Players:GetPlayerByUserId(prompt:GetAttribute("CarrierUserId") or 0)
	local carry = carrier and carries[carrier]
	if not carry or carrier == snatcher then
		return
	end

	-- The owner snatching it back sends it straight home.
	if snatcher == carry.owner then
		return sendBack(
			carrier,
			carry,
			"You got your " .. carry.name .. " back!",
			snatcher.DisplayName .. " snatched their Freek back!"
		)
	end

	local problem = cannotCarry(snatcher)
	if problem then
		return if problem ~= "" then notify(snatcher, problem, "error") else nil
	end
	putDown(carrier, carry)
	if not pickUp(snatcher, carry) then
		return sendBack(carrier, carry)
	end
	notify(carrier, snatcher.DisplayName .. " snatched " .. carry.name .. " from you!", "error")
	notify(snatcher, "You snatched " .. carry.name .. "! Get it back to your barn!", "success")
	notify(
		carry.owner,
		snatcher.DisplayName .. " snatched your " .. carry.name .. " from " .. carrier.DisplayName .. "!",
		"error"
	)
end

local function onPromptTriggered(prompt: ProximityPrompt, player: Player)
	if prompt.Name == "StealPrompt" then
		steal(prompt, player)
	elseif prompt.Name == "SnatchPrompt" then
		snatch(prompt, player)
	elseif prompt.Name == "LockPrompt" then
		-- Gates can only be locked from the padlock inside the owner's own yard.
		local plot = PlotService.getPlot(player)
		if not plot or plot.index ~= prompt:GetAttribute("PlotIndex") then
			return notify(player, "That's not your gate!", "error")
		end
		local problem = PlotService.lockGate(player)
		if problem then
			notify(player, problem, "error")
		else
			notify(player, "Gate locked for " .. GamePasses.gateLockSeconds(player) .. " seconds!", "success")
		end
	end
end

function StealService.isCarrying(player: Player): boolean
	return carries[player] ~= nil
end

-- Puts a Freek the player just bought (already in their save, with no slot) on their head
-- to walk home. Returns false if they have no character, so the caller can place it now.
function StealService.carryHome(player: Player, uid: string, freek): boolean
	return pickUp(player, {
		owner = player,
		uid = uid,
		name = FreekUtil.displayName(freek),
		species = freek.species,
		mutations = freek.mutations,
		bought = true,
	})
end

-- Called by WeaponService when a "drop" weapon hits someone carrying a Freek: it goes back
-- to its owner, whoever fired. Returns true if the target was carrying one.
function StealService.knockLoose(attacker: Player, target: Player, weaponName: string): boolean
	local carry = carries[target]
	if not carry then
		return false
	end
	local ownerMessage = if attacker == carry.owner
		then "Hit with your " .. weaponName .. "! You got your " .. carry.name .. " back!"
		else attacker.DisplayName
			.. " knocked your "
			.. carry.name
			.. " loose from "
			.. target.DisplayName
			.. "! It's back home."
	sendBack(
		target,
		carry,
		ownerMessage,
		attacker.DisplayName .. " hit you with a " .. weaponName .. "! You dropped " .. carry.name .. "."
	)
	if attacker ~= carry.owner then
		notify(attacker, "You knocked " .. carry.name .. " loose! It ran back to its owner.", "success")
	end
	return true
end

local function checkCarries()
	for carrier, carry in carries do
		local root = rootPart(carrier)
		if not root or not carry.model or not carry.model.Parent then
			sendBack(
				carrier,
				carry,
				"Your " .. carry.name .. " escaped and ran home!",
				"You dropped " .. carry.name .. "!"
			)
			continue
		end
		local home = PlotService.getPlot(carrier)
		if home and PlotService.isInside(home, root.Position) then
			deliver(carrier, carry)
		end
	end
end

function StealService.init()
	ProximityPromptService.PromptTriggered:Connect(onPromptTriggered)

	Players.PlayerRemoving:Connect(function(player)
		local carry = carries[player]
		if carry then
			sendBack(player, carry, "The thief left! Your " .. carry.name .. " is back home.")
		end
		for carrier, other in carries do
			if other.owner == player then
				putDown(carrier, other)
				Carried.set(other.owner, other.uid, nil)
				notify(carrier, other.name .. "'s owner left, so it vanished!", "error")
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.1)
			checkCarries()
		end
	end)
end

return StealService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">TradeService</string>
          <string name="Source"><![CDATA[-- Player-to-player Freek trades within one server.
--
-- Flow: request -> accept -> both sides add Freeks -> both press Ready -> 3 second
-- countdown -> swap. Any change to either offer clears both Ready buttons and stops the
-- countdown, so nobody can swap something out at the last second. Ownership is checked
-- again at the moment of the swap, and both players are saved right after.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local ActionService = require(script.Parent.ActionService)
local Carried = require(script.Parent.Carried)
local DataService = require(script.Parent.DataService)

local MAX_OFFER = 8
local REQUEST_SECONDS = 30
local COUNTDOWN_SECONDS = 3

local TradeService = {}

local tradeRemote = Remotes.get("Trade")
local notifyRemote = Remotes.get("Notify")

local trades = {} -- [Player] = trade (both players point at the same table)
local requests = {} -- [target Player] = { from = Player, expires = os.clock() }

local function notify(player: Player, message: string, kind: string?)
	notifyRemote:FireClient(player, message, kind)
end

local function otherSide(trade, player: Player): Player
	return if trade.a == player then trade.b else trade.a
end

local function offerView(player: Player, uids)
	local data = DataService.get(player)
	local list = {}
	for _, uid in uids do
		local freek = data and data.freeks[uid]
		if freek then
			table.insert(
				list,
				{ uid = uid, species = freek.species, mutations = freek.mutations, income = freek.income }
			)
		end
	end
	return list
end

local function push(trade)
	for _, player in { trade.a, trade.b } do
		local other = otherSide(trade, player)
		tradeRemote:FireClient(player, "State", {
			partner = other.DisplayName,
			mine = offerView(player, trade.offers[player]),
			theirs = offerView(other, trade.offers[other]),
			myReady = trade.ready[player] == true,
			theirReady = trade.ready[other] == true,
			countdownEndsAt = trade.countdownEndsAt,
		})
	end
end

local function close(trade, reason: string)
	for _, player in { trade.a, trade.b } do
		if trades[player] == trade then
			trades[player] = nil
		end
		tradeRemote:FireClient(player, "Closed", reason)
	end
	trade.closed = true
end

local function unready(trade)
	trade.ready = {}
	trade.countdownEndsAt = nil
	trade.token += 1
end

-- Checks a side's offer is still theirs and tradeable. Returns nil if fine, else why not.
local function offerProblem(player: Player, uids): string?
	local data = DataService.get(player)
	if not data then
		return player.DisplayName .. " isn't loaded"
	end
	for _, uid in uids do
		local freek = data.freeks[uid]
		if not freek then
			return player.DisplayName .. " no longer has one of their Freeks"
		elseif freek.breeding then
			return player.DisplayName .. " put an offered Freek in a Fusion Den"
		elseif Carried.is(player, uid) then
			return "one of " .. player.DisplayName .. "'s Freeks is being stolen"
		end
	end
	return nil
end

local function execute(trade)
	local a, b = trade.a, trade.b
	local offerA, offerB = trade.offers[a], trade.offers[b]
	if #offerA == 0 and #offerB == 0 then
		return close(trade, "Trade cancelled: nothing was offered.")
	end
	local problem = offerProblem(a, offerA) or offerProblem(b, offerB)
	if problem then
		return close(trade, "Trade cancelled: " .. problem .. ".")
	end

	local dataA, dataB = DataService.get(a), DataService.get(b)
	if FreekUtil.count(dataA) - #offerA + #offerB > GamePasses.maxFreeks(a) then
		return close(trade, "Trade cancelled: " .. a.DisplayName .. " has too many Freeks.")
	end
	if FreekUtil.count(dataB) - #offerB + #offerA > GamePasses.maxFreeks(b) then
		return close(trade, "Trade cancelled: " .. b.DisplayName .. " has too many Freeks.")
	end

	-- Take everything out first, then hand it over, so neither side can end up with both.
	local fromA, fromB = {}, {}
	for _, uid in offerA do
		fromA[uid] = dataA.freeks[uid]
		dataA.freeks[uid] = nil
	end
	for _, uid in offerB do
		fromB[uid] = dataB.freeks[uid]
		dataB.freeks[uid] = nil
	end
	local function receive(data, freeks)
		for uid, freek in freeks do
			freek.slot = nil
			freek.breeding = nil
			data.freeks[uid] = freek
			data.discovered[freek.species] = true
		end
	end
	receive(dataA, fromB)
	receive(dataB, fromA)

	close(trade, "Trade complete! New Freeks are in your backpack.")
	for _, player in { a, b } do
		DataService.changed(player)
		task.spawn(DataService.save, player)
	end
end

local function startTrade(a: Player, b: Player)
	local trade = {
		a = a,
		b = b,
		offers = { [a] = {}, [b] = {} },
		ready = {},
		countdownEndsAt = nil,
		token = 0,
	}
	trades[a] = trade
	trades[b] = trade
	push(trade)
end

function TradeService.isTrading(player: Player): boolean
	return trades[player] ~= nil
end

function TradeService.init()
	ActionService.register("TradeRequest", function(player: Player, _data, targetUserId: any)
		local target = typeof(targetUserId) == "number" and Players:GetPlayerByUserId(targetUserId)
		if not target or target == player or not DataService.get(target) then
			return
		end
		if trades[player] then
			return notify(player, "Finish your current trade first!", "error")
		end
		if trades[target] then
			return notify(player, target.DisplayName .. " is already trading.", "error")
		end
		local pending = requests[target]
		if pending and pending.from == player and os.clock() < pending.expires then
			return notify(player, "Request already sent!", "error")
		end
		requests[target] = { from = player, expires = os.clock() + REQUEST_SECONDS }
		tradeRemote:FireClient(target, "Request", { name = player.DisplayName, userId = player.UserId })
		notify(player, "Trade request sent to " .. target.DisplayName .. ".", "success")
	end)

	ActionService.register("TradeRespond", function(player: Player, _data, fromUserId: any, accept: any)
		local request = requests[player]
		if not request or request.from.UserId ~= fromUserId then
			return
		end
		requests[player] = nil
		local from = request.from
		if os.clock() > request.expires or not from.Parent then
			return notify(player, "That trade request expired.", "error")
		end
		if accept ~= true then
			return notify(from, player.DisplayName .. " declined your trade.", "error")
		end
		if trades[player] or trades[from] then
			return notify(player, "One of you is already trading.", "error")
		end
		startTrade(from, player)
	end)

	ActionService.register("TradeOffer", function(player: Player, data, uid: any, add: any)
		local trade = trades[player]
		if not trade or typeof(uid) ~= "string" then
			return
		end
		local offer = trade.offers[player]
		local index = table.find(offer, uid)
		if add == true then
			local freek = data.freeks[uid]
			if index or not freek or freek.breeding or Carried.is(player, uid) then
				return
			end
			if #offer >= MAX_OFFER then
				return notify(player, "You can offer up to " .. MAX_OFFER .. " Freeks.", "error")
			end
			table.insert(offer, uid)
		elseif index then
			table.remove(offer, index)
		else
			return
		end
		unready(trade)
		push(trade)
	end)

	ActionService.register("TradeReady", function(player: Player, _data, ready: any)
		local trade = trades[player]
		if not trade then
			return
		end
		if ready == true then
			trade.ready[player] = true
		else
			unready(trade)
		end

		if trade.ready[trade.a] and trade.ready[trade.b] and not trade.countdownEndsAt then
			trade.countdownEndsAt = Workspace:GetServerTimeNow() + COUNTDOWN_SECONDS
			local token = trade.token
			task.delay(COUNTDOWN_SECONDS, function()
				if not trade.closed and trade.token == token then
					execute(trade)
				end
			end)
		end
		push(trade)
	end)

	ActionService.register("TradeCancel", function(player: Player)
		local trade = trades[player]
		if trade then
			close(trade, player.DisplayName .. " cancelled the trade.")
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local trade = trades[player]
		if trade then
			close(trade, player.DisplayName .. " left the game.")
		end
		requests[player] = nil
		for target, request in requests do
			if request.from == player then
				requests[target] = nil
			end
		end
	end)
end

return TradeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">WeaponService</string>
          <string name="Source"><![CDATA[-- Weapons: giving them out, buying them, and what happens when they hit.
--
-- The client sends "UseWeapon" with where the player is aiming; the server checks the
-- weapon is owned and equipped, applies the cooldown, and does the hit (melee) or flies a
-- ball (projectile). Weapons hit anyone except a player inside their own yard; what a hit
-- does is described in Weapons.luau.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local WeaponModel = require(ReplicatedStorage.Shared.WeaponModel)
local Weapons = require(ReplicatedStorage.Shared.Weapons)

local ActionService = require(script.Parent.ActionService)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local StealService = require(script.Parent.StealService)

local WeaponService = {}

local notifyRemote = Remotes.get("Notify")
local lastUse = {} -- [Player] = { [weaponId] = os.clock() }
local glued = {} -- [Player] = true while stuck
local disabledUntil = {} -- [Player] = os.clock() until which they can't be stunned/glued again
local knockbackRemote = Remotes.get("Knockback")

local function notify(player: Player, message: string, kind: string?)
	if player.Parent then
		notifyRemote:FireClient(player, message, kind)
	end
end

local function owns(player: Player, weaponId: string): boolean
	local weapon = Weapons.list[weaponId]
	if weaponId == Weapons.STARTER then
		return true
	end
	local data = DataService.get(player)
	return weapon ~= nil and data ~= nil and data.rebirths >= (weapon.rebirth or math.huge)
end

-- Makes sure the player's backpack has every weapon they've unlocked.
function WeaponService.giveWeapons(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	local have = {}
	for _, container in { backpack, player.Character } do
		if container then
			for _, child in container:GetChildren() do
				local id = child:IsA("Tool") and child:GetAttribute("WeaponId")
				if id then
					have[id] = true
				end
			end
		end
	end
	for _, weaponId in Weapons.order do
		if owns(player, weaponId) and not have[weaponId] then
			WeaponModel.build(weaponId).Parent = backpack
		end
	end
end

local function playSound(parent: Instance, soundId: string)
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = 0.6
	sound.Parent = parent
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
end

-- Finds the player a hit part belongs to (including parts of a Freek they're carrying).
local function playerFromPart(part: Instance): Player?
	local node = part.Parent
	while node and node ~= Workspace do
		local player = Players:GetPlayerFromCharacter(node)
		if player then
			return player
		end
		node = node.Parent
	end
	return nil
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Sticks a player to the nearest wall (or where they stand, if none is close).
local function glue(attacker: Player, target: Player, seconds: number)
	local root = rootOf(target)
	if not root or glued[target] or os.clock() < (disabledUntil[target] or 0) then
		return
	end
	glued[target] = true
	disabledUntil[target] = os.clock() + seconds + Weapons.IMMUNE_SECONDS

	local exclude = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(exclude, player.Character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = exclude

	local best = nil
	for i = 0, 7 do
		local angle = i / 8 * math.pi * 2
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle)) * 30
		local result = Workspace:Raycast(root.Position, direction, params)
		if result and (not best or result.Distance < best.Distance) then
			best = result
		end
	end

	local blob = Instance.new("Part")
	blob.Name = "Glue"
	blob.Anchored = true
	blob.CanCollide = false
	blob.CanQuery = false
	blob.Material = Enum.Material.Glass
	blob.Transparency = 0.25
	blob.Color = Weapons.list.GlueGun.ball.color
	blob.Size = Vector3.new(4, 6, 1)

	if best then
		local spot = best.Position + best.Normal * 1.6
		spot = Vector3.new(spot.X, root.Position.Y, spot.Z)
		root.Parent:PivotTo(CFrame.lookAt(spot, spot + best.Normal))
		blob.CFrame = CFrame.lookAt(best.Position + best.Normal * 0.5, best.Position + best.Normal * 2)
	else
		blob.CFrame = root.CFrame * CFrame.new(0, 0, 1)
	end
	blob.Parent = Workspace
	root.Anchored = true

	notify(target, attacker.DisplayName .. " glued you to the wall!", "error")
	notify(attacker, "You glued " .. target.DisplayName .. "!", "success")

	task.delay(seconds, function()
		blob:Destroy()
		glued[target] = nil
		if root.Parent then
			root.Anchored = false
		end
	end)
end

-- Knocks a player over, pushed away from the attacker. The target's own client applies the
-- push, since it controls its character's physics.
local function knockBack(attacker: Player, target: Player, weapon)
	local root, attackerRoot = rootOf(target), rootOf(attacker)
	if not root or os.clock() < (disabledUntil[target] or 0) then
		return
	end
	disabledUntil[target] = os.clock() + weapon.stunSeconds + Weapons.IMMUNE_SECONDS
	local away = if attackerRoot then root.Position - attackerRoot.Position else root.CFrame.LookVector
	away = Vector3.new(away.X, 0, away.Z)
	away = if away.Magnitude > 0.01 then away.Unit else Vector3.new(0, 0, 1)
	knockbackRemote:FireClient(target, away, weapon.knockback, weapon.stunSeconds)
end

local function applyHit(attacker: Player, target: Player, weapon)
	local root = rootOf(target)
	if target == attacker or not root then
		return
	end
	-- Your own yard is a safe zone.
	local home = PlotService.getPlot(target)
	if home and PlotService.isInside(home, root.Position) then
		return
	end
	if weapon.effect == "drop" then
		if not StealService.knockLoose(attacker, target, weapon.name) then
			knockBack(attacker, target, weapon)
		end
	elseif weapon.effect == "glue" then
		glue(attacker, target, weapon.glueSeconds)
	end
end

local function melee(player: Player, weapon, tool: Tool)
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash" -- plays the default character's sword-slash animation
	anim.Parent = tool
	playSound(tool.Handle, "rbxasset://sounds/swordslash.wav")

	local root = rootOf(player)
	if not root then
		return
	end
	for _, other in Players:GetPlayers() do
		local otherRoot = other ~= player and rootOf(other)
		if otherRoot then
			local offset = otherRoot.Position - root.Position
			if offset.Magnitude <= weapon.range and offset.Unit:Dot(root.CFrame.LookVector) > 0.3 then
				applyHit(player, other, weapon)
			end
		end
	end
end

local function shoot(player: Player, weapon, tool: Tool, aim: Vector3?)
	local root = rootOf(player)
	if not root then
		return
	end
	local origin = tool.Handle.Position
	local direction = if aim and (aim - origin).Magnitude > 1 then (aim - origin).Unit else root.CFrame.LookVector

	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.one * weapon.ball.size
	ball.Color = weapon.ball.color
	ball.Material = Enum.Material.Neon
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.CFrame = CFrame.new(origin)
	ball.Parent = Workspace
	playSound(tool.Handle, "rbxasset://sounds/swordlunge.wav")

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, ball }

	local position = origin
	local traveled = 0
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		local step = math.min(weapon.speed * dt, weapon.range - traveled)
		local result = Workspace:Spherecast(position, weapon.ball.size / 2, direction * step, params)
		if result then
			connection:Disconnect()
			ball:Destroy()
			local target = playerFromPart(result.Instance)
			if target then
				applyHit(player, target, weapon)
			end
			return
		end
		position += direction * step
		traveled += step
		ball.CFrame = CFrame.new(position)
		if traveled >= weapon.range then
			connection:Disconnect()
			ball:Destroy()
		end
	end)
end

local function useWeapon(player: Player, _data, weaponId: any, aim: any)
	local weapon = typeof(weaponId) == "string" and Weapons.list[weaponId]
	if not weapon or not owns(player, weaponId) or glued[player] then
		return
	end
	-- Must actually be holding it.
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if not tool or tool:GetAttribute("WeaponId") ~= weaponId or not tool:FindFirstChild("Handle") then
		return
	end
	local now = os.clock()
	lastUse[player] = lastUse[player] or {}
	if lastUse[player][weaponId] and now - lastUse[player][weaponId] < weapon.cooldown then
		return
	end
	lastUse[player][weaponId] = now

	if weapon.kind == "melee" then
		melee(player, weapon, tool)
	else
		shoot(player, weapon, tool, if typeof(aim) == "Vector3" then aim else nil)
	end
end

function WeaponService.init()
	ActionService.register("UseWeapon", useWeapon, true)

	local function onPlayerAdded(player: Player)
		player.CharacterAdded:Connect(function()
			player:WaitForChild("Backpack")
			task.wait() -- let Roblox finish refilling the backpack first
			WeaponService.giveWeapons(player)
		end)
		if player.Character then
			WeaponService.giveWeapons(player)
		end
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	DataService.onLoaded(function(player)
		WeaponService.giveWeapons(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastUse[player] = nil
		glued[player] = nil
		disabledUntil[player] = nil
	end)
end

return WeaponService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="51">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="52">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="53">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">AdminPanel</string>
            <string name="Source"><![CDATA[-- The admin panel (only for admins: the server sets IsAdmin and checks every command).
-- Start or end events in this server or all of them, fire any Freek from a cannon,
-- announce something to everyone, see the coming timetable, and get test coins.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Events = require(ReplicatedStorage.Shared.Events)
local Freeks = require(ReplicatedStorage.Shared.Freeks)
local Luck = require(ReplicatedStorage.Shared.Luck)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.UI)

local AdminPanel = {}

local player = Players.LocalPlayer
local colors = UI.colors

-- Every event the panel can start, in the order its buttons appear.
local EVENT_BUTTONS = {
	{ id = "MonsterStorm", def = Events.BIG.MonsterStorm },
	{ id = "BloodMoon", def = Events.WEATHER.BloodMoon },
	{ id = "GoldRush", def = Events.WEATHER.GoldRush },
	{ id = "RainbowRain", def = Events.WEATHER.RainbowRain },
	{ id = "Rainbow", def = Luck.EVENTS.Rainbow },
	{ id = "LuckySkies", def = Luck.EVENTS.LuckySkies },
	{ id = "RapidFire", def = Luck.EVENTS.RapidFire },
	{ id = "CrateLuck", def = Luck.EVENTS.CrateLuck },
}
local DURATIONS = { 5, 15, 30, 60 }

local function heading(text: string, parent: Instance, order: number)
	return UI.label(text, {
		Size = UDim2.new(1, 0, 0, 24),
		FontFace = UI.fonts.heavy,
		TextColor3 = colors.gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function row(parent: Instance, order: number, height: number)
	return UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

function AdminPanel.start(screen: ScreenGui)
	local remote = Remotes.get("Admin")
	local window
	local status

	local function run(command: string, args)
		status.Text = "..."
		status.TextColor3 = colors.text
		task.spawn(function()
			local ok, result, message = pcall(function()
				return remote:InvokeServer(command, args)
			end)
			if not ok then
				status.Text = "Couldn't reach the server"
				status.TextColor3 = colors.red
				return
			end
			status.Text = tostring(message or (if result then "Done" else "Failed"))
			status.TextColor3 = if result then colors.money else Color3.fromRGB(255, 140, 140)
		end)
	end

	-- The window, in the game's style: blue panel, gold title ribbon, round red X.
	window = UI.glass({
		Name = "AdminPanel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(600, 520),
		Visible = false,
		ZIndex = 20,
		Parent = screen,
	}, { UI.corner(22) })
	local fit = UI.new("UIScale", { Parent = window })
	local function refit()
		local camera = Workspace.CurrentCamera
		if camera then
			fit.Scale = math.clamp(math.min(camera.ViewportSize.X / 640, camera.ViewportSize.Y / 600), 0.5, 1)
		end
	end
	refit()
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refit)
	local ribbon = UI.glass({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 2),
		Size = UDim2.fromOffset(280, 48),
		BackgroundColor3 = Color3.fromRGB(255, 190, 40),
		ZIndex = 21,
		Parent = window,
	}, { UI.corner(24) })
	UI.label("ADMIN PANEL", {
		Size = UDim2.new(1, -20, 1, -8),
		Position = UDim2.fromOffset(10, 4),
		FontFace = UI.fonts.heavy,
		ZIndex = 22,
		Parent = ribbon,
	})
	local close = UI.button("X", colors.red, function()
		window.Visible = false
	end, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(44, 44),
		ZIndex = 22,
		Parent = window,
	})
	close:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)

	local body = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(16, 34),
		Size = UDim2.new(1, -32, 1, -78),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ZIndex = 21,
		Parent = window,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		UI.new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 6) }),
	})
	status = UI.label("Pick an event, or fire a Freek!", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.new(1, -32, 0, 26),
		ZIndex = 22,
		Parent = window,
	})

	-- Everywhere or just this server, used by events and announcements.
	local everywhere = true

	-- Events --------------------------------------------------------------------
	heading("⚡ START AN EVENT", body, 1)
	local chosenEvent = EVENT_BUTTONS[1].id
	local eventButtons = {}
	local grid = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 82),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = body,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.new(0.25, -6, 0, 38),
			CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local function paintEvents()
		for id, button in eventButtons do
			local entry
			for _, e in EVENT_BUTTONS do
				if e.id == id then
					entry = e
				end
			end
			local picked = id == chosenEvent
			button.BackgroundColor3 = if picked then entry.def.color else colors.card
			button:FindFirstChildOfClass("UIStroke").Color = if picked then Color3.new(1, 1, 1) else UI.OUTLINE
		end
	end
	for i, entry in EVENT_BUTTONS do
		eventButtons[entry.id] = UI.button(entry.def.icon .. " " .. entry.def.name, colors.card, function()
			chosenEvent = entry.id
			paintEvents()
		end, { LayoutOrder = i, ZIndex = 22, Parent = grid })
	end
	paintEvents()

	local minutes = 15
	local timeRow = row(body, 3, 36)
	UI.label("Length:", {
		Size = UDim2.fromOffset(70, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 22,
		Parent = timeRow,
	})
	local timeButtons = {}
	local function paintTimes()
		for value, button in timeButtons do
			button.BackgroundColor3 = if value == minutes then colors.orange else colors.card
		end
	end
	for i, value in DURATIONS do
		timeButtons[value] = UI.button(value .. " min", colors.card, function()
			minutes = value
			paintTimes()
		end, { Size = UDim2.fromOffset(78, 32), LayoutOrder = i, ZIndex = 22, Parent = timeRow })
	end
	paintTimes()
	local whereButton
	whereButton = UI.button("ALL SERVERS", colors.purple, function()
		everywhere = not everywhere
		whereButton.Text = if everywhere then "ALL SERVERS" else "THIS SERVER"
		whereButton.BackgroundColor3 = if everywhere then colors.purple else colors.blue
	end, { Size = UDim2.fromOffset(150, 32), LayoutOrder = 10, ZIndex = 22, Parent = timeRow })

	local goRow = row(body, 4, 44)
	UI.button("▶ START", colors.green, function()
		run("event", { id = chosenEvent, minutes = minutes, everywhere = everywhere })
	end, { Size = UDim2.new(0.5, -3, 0, 40), LayoutOrder = 1, ZIndex = 22, Parent = goRow })
	UI.button("■ END EVENTS", colors.red, function()
		run("stop", { everywhere = everywhere })
	end, { Size = UDim2.new(0.5, -3, 0, 40), LayoutOrder = 2, ZIndex = 22, Parent = goRow })

	-- Cannon --------------------------------------------------------------------
	heading("💥 FIRE A FREEK FROM A CANNON (THIS SERVER)", body, 5)
	local speciesIds = {}
	for _, species in Freeks.list do
		table.insert(speciesIds, species.id)
	end
	local mutationIds = { "" }
	for _, mutation in Mutations.list do
		table.insert(mutationIds, mutation.id)
	end
	local speciesIndex, mutationIndex = 1, 1
	local cannonRow = row(body, 6, 44)
	local function cycler(values, getIndex, setIndex, describe, order, width)
		local label
		local function show()
			label.Text = describe(values[getIndex()])
		end
		UI.button("<", colors.blue, function()
			setIndex((getIndex() - 2) % #values + 1)
			show()
		end, { Size = UDim2.fromOffset(34, 36), LayoutOrder = order, ZIndex = 22, Parent = cannonRow })
		label = UI.label("", {
			Size = UDim2.fromOffset(width, 36),
			BackgroundTransparency = 0,
			BackgroundColor3 = colors.card,
			LayoutOrder = order + 1,
			ZIndex = 22,
			Parent = cannonRow,
		})
		UI.corner(10).Parent = label
		UI.stroke(nil, 2.5).Parent = label
		UI.button(">", colors.blue, function()
			setIndex(getIndex() % #values + 1)
			show()
		end, { Size = UDim2.fromOffset(34, 36), LayoutOrder = order + 2, ZIndex = 22, Parent = cannonRow })
		show()
	end
	cycler(speciesIds, function()
		return speciesIndex
	end, function(v)
		speciesIndex = v
	end, function(id)
		local species = Freeks.byId[id]
		return species and species.name or id
	end, 1, 130)
	cycler(mutationIds, function()
		return mutationIndex
	end, function(v)
		mutationIndex = v
	end, function(id)
		return if id == "" then "No mutation" else id
	end, 4, 110)
	UI.button("FIRE!", colors.orange, function()
		local mutation = mutationIds[mutationIndex]
		run("spawn", { species = speciesIds[speciesIndex], mutation = if mutation == "" then nil else mutation })
	end, { Size = UDim2.fromOffset(84, 40), LayoutOrder = 10, ZIndex = 22, Parent = cannonRow })

	-- Announce ------------------------------------------------------------------
	heading("📣 ANNOUNCE (USES THE SERVER BUTTON ABOVE)", body, 7)
	local announceRow = row(body, 8, 44)
	local box = UI.new("TextBox", {
		Size = UDim2.new(1, -110, 0, 38),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		FontFace = UI.fonts.bold,
		PlaceholderText = "Monster Storm in 5 minutes!",
		PlaceholderColor3 = Color3.fromRGB(140, 150, 180),
		Text = "",
		TextColor3 = UI.OUTLINE,
		TextSize = 18,
		ClearTextOnFocus = false,
		LayoutOrder = 1,
		ZIndex = 22,
		Parent = announceRow,
	}, { UI.corner(10), UI.stroke(nil, 2.5), UI.new("UIPadding", { PaddingLeft = UDim.new(0, 10) }) })
	UI.button("SEND", colors.green, function()
		run("announce", { text = box.Text, everywhere = everywhere })
		box.Text = ""
	end, { Size = UDim2.fromOffset(100, 40), LayoutOrder = 2, ZIndex = 22, Parent = announceRow })

	-- Timetable and test coins --------------------------------------------------
	heading("🗓️ COMING UP (YOUR LOCAL TIME)", body, 9)
	local schedule = UI.label("", {
		Size = UDim2.new(1, 0, 0, 66),
		TextScaled = false,
		TextSize = 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 10,
		ZIndex = 22,
		Parent = body,
	})
	local function refreshSchedule()
		local lines = {}
		local t = os.time()
		for i, slot in Events.upcoming(t) do
			if i > 3 then
				break
			end
			local def = Events.BIG[slot.id]
			local when = os.date("%a %I:%M %p", slot.starts)
			table.insert(
				lines,
				def.icon .. " " .. def.name .. " · " .. when .. if slot.starts <= t then "  (LIVE)" else ""
			)
		end
		local weather = Events.nextWeather(t)
		if weather then
			local def = Events.WEATHER[weather.id]
			table.insert(lines, def.icon .. " " .. def.name .. " · " .. os.date("%I:%M %p", weather.starts))
		end
		schedule.Text = table.concat(lines, "\n")
	end

	local coinRow = row(body, 11, 44)
	for i, amount in { 1e6, 1e9 } do
		UI.button("+" .. (if amount >= 1e9 then "1B" else "1M") .. " COINS", colors.gold, function()
			run("money", { amount = amount })
		end, { Size = UDim2.fromOffset(150, 38), LayoutOrder = i, ZIndex = 22, Parent = coinRow })
	end

	-- The ADMIN button that opens it, only shown to admins.
	local toggle = UI.button("🛠️ ADMIN", colors.red, function()
		window.Visible = not window.Visible
		if window.Visible then
			refreshSchedule()
		end
	end, {
		Name = "AdminButton",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(120, 38),
		Visible = false,
		ZIndex = 10,
		Parent = screen,
	})
	local function update()
		toggle.Visible = player:GetAttribute("IsAdmin") == true
		if not toggle.Visible then
			window.Visible = false
		end
	end
	player:GetAttributeChangedSignal("IsAdmin"):Connect(update)
	update()
	return window
end

return AdminPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Ambient</string>
            <string name="Source"><![CDATA[-- Flies event creatures (ghosts and bats placed by the server's seasonal themes) along their
-- circles, locally on each client so they move smoothly. Only nearby creatures animate.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Ambient = {}

local GHOST_TAG = "SpookyGhost"
local BAT_TAG = "SpookyBat"
local RANGE = 260

-- Position on the creature's circle at time t, facing the way it's flying.
local function pathCFrame(model: Model, t: number, bob: number): CFrame?
	local center = model:GetAttribute("Center")
	if typeof(center) ~= "Vector3" then
		return nil
	end
	local radius = model:GetAttribute("Radius") or 10
	local height = model:GetAttribute("Height") or 10
	local speed = model:GetAttribute("Speed") or 0.3
	local angle = t * speed + (model:GetAttribute("Phase") or 0)
	local position = center + Vector3.new(math.cos(angle) * radius, height + bob, math.sin(angle) * radius)
	-- Direction of travel is the tangent of the circle.
	local ahead = Vector3.new(-math.sin(angle), 0, math.cos(angle)) * math.sign(speed)
	return CFrame.lookAt(position, position + ahead)
end

function Ambient.start()
	RunService.RenderStepped:Connect(function()
		local camera = Workspace.CurrentCamera
		local eye = if camera then camera.CFrame.Position else Vector3.zero
		local t = os.clock()

		for _, ghost in CollectionService:GetTagged(GHOST_TAG) do
			local phase = ghost:GetAttribute("Phase") or 0
			local where = pathCFrame(ghost, t, math.sin(t * 1.4 + phase) * 1.5)
			if where and (where.Position - eye).Magnitude < RANGE then
				-- Gentle side-to-side wobble while drifting.
				ghost:PivotTo(where * CFrame.Angles(0, 0, math.sin(t * 2 + phase) * math.rad(8)))
			end
		end

		for _, bat in CollectionService:GetTagged(BAT_TAG) do
			local phase = bat:GetAttribute("Phase") or 0
			local where = pathCFrame(bat, t, math.sin(t * 3 + phase) * 0.8)
			local body = bat.PrimaryPart
			if where and body and (where.Position - eye).Magnitude < RANGE then
				bat:PivotTo(where)
				local flap = math.sin(t * 18 + phase) * math.rad(40)
				local left, right = bat:FindFirstChild("WingL"), bat:FindFirstChild("WingR")
				if left and right then
					left.CFrame = body.CFrame
						* CFrame.new(-0.45, 0, 0)
						* CFrame.Angles(0, 0, -flap)
						* CFrame.new(-1.1, 0, 0)
					right.CFrame = body.CFrame
						* CFrame.new(0.45, 0, 0)
						* CFrame.Angles(0, 0, flap)
						* CFrame.new(1.1, 0, 0)
				end
			end
		end
	end)
end

return Ambient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">BarnFX</string>
            <string name="Source"><![CDATA[-- Moving bits of the rebirth barn upgrades (BarnUpgrades.luau on the server), animated
-- locally so they're smooth: weathervanes and spotlights sway, the gem halo spins, and
-- barns with fireworks set one off every so often. Only nearby barns animate.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local BarnFX = {}

local SPINNER_TAG = "BarnSpinner"
local FIREWORKS_TAG = "BarnFireworks"
local RANGE = 400
local FIREWORK_COLORS = {
	Color3.fromRGB(255, 80, 120),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(80, 220, 255),
	Color3.fromRGB(170, 100, 255),
	Color3.fromRGB(120, 255, 110),
	Color3.fromRGB(255, 140, 50),
}

local function spark(parent: Instance, position: Vector3, size: number, color: Color3): BasePart
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.one * size
	p.CFrame = CFrame.new(position)
	p.Color = color
	p.Material = Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

-- One firework: a rocket climbs from the roof, then bursts into a ball of sparks.
local function launch(folder: Instance, from: Vector3)
	local random = Random.new()
	local color = FIREWORK_COLORS[random:NextInteger(1, #FIREWORK_COLORS)]
	local second = FIREWORK_COLORS[random:NextInteger(1, #FIREWORK_COLORS)]
	local burstAt = from + Vector3.new(random:NextNumber(-8, 8), random:NextNumber(26, 38), random:NextNumber(-8, 8))
	local rocket = spark(folder, from, 0.8, Color3.fromRGB(255, 240, 200))
	local began = os.clock()
	while os.clock() - began < 0.9 do
		local a = (os.clock() - began) / 0.9
		local position = from:Lerp(burstAt, 1 - (1 - a) * (1 - a))
		rocket.CFrame = CFrame.new(position)
		task.wait()
	end
	rocket:Destroy()
	local flash = Instance.new("PointLight")
	local core = spark(folder, burstAt, 2.5, color)
	flash.Color = color
	flash.Range = 40
	flash.Brightness = 4
	flash.Parent = core
	local sparks = {}
	for k = 1, 36 do
		local direction = random:NextUnitVector()
		local p = spark(folder, burstAt, 0.7, if k % 3 == 0 then second else color)
		table.insert(sparks, { part = p, velocity = direction * random:NextNumber(14, 20) })
	end
	began = os.clock()
	local last = began
	while os.clock() - began < 1.6 do
		local now = os.clock()
		local dt = now - last
		last = now
		local a = (now - began) / 1.6
		for _, s in sparks do
			s.velocity = s.velocity * (1 - dt * 1.5) - Vector3.new(0, 9 * dt, 0)
			s.part.CFrame = s.part.CFrame + s.velocity * dt
			s.part.Transparency = a * a
		end
		core.Transparency = math.min(a * 4, 1)
		flash.Brightness = 4 * (1 - a)
		task.wait()
	end
	for _, s in sparks do
		s.part:Destroy()
	end
	core:Destroy()
end

function BarnFX.start()
	local folder = Instance.new("Folder")
	folder.Name = "BarnFX"
	folder.Parent = Workspace

	RunService.RenderStepped:Connect(function()
		local camera = Workspace.CurrentCamera
		local eye = if camera then camera.CFrame.Position else Vector3.zero
		local t = os.clock()
		for i, model in CollectionService:GetTagged(SPINNER_TAG) do
			local rest = model:GetAttribute("Rest")
			if model:IsA("Model") and model.PrimaryPart and typeof(rest) == "CFrame" then
				if (rest.Position - eye).Magnitude < RANGE then
					local speed = model:GetAttribute("Speed") or 0.5
					local angle = if model:GetAttribute("Mode") == "sway"
						then math.sin(t * speed + i) * (model:GetAttribute("Amount") or 0.5)
						else t * speed
					model:PivotTo(rest * CFrame.Angles(0, angle, 0))
				end
			end
		end
	end)

	-- Fireworks: each barn with a launcher fires every 40-80 seconds.
	local nextShot = {}
	task.spawn(function()
		while true do
			task.wait(1)
			local camera = Workspace.CurrentCamera
			local eye = if camera then camera.CFrame.Position else Vector3.zero
			local now = os.clock()
			for _, launcher in CollectionService:GetTagged(FIREWORKS_TAG) do
				if launcher:IsA("BasePart") then
					if not nextShot[launcher] then
						nextShot[launcher] = now + math.random(5, 30)
					elseif now >= nextShot[launcher] then
						nextShot[launcher] = now + math.random(40, 80)
						if (launcher.Position - eye).Magnitude < RANGE then
							for k = 1, math.random(2, 3) do
								task.delay(k * 0.35, launch, folder, launcher.Position)
							end
						end
					end
				end
			end
			for launcher in nextShot do
				if not launcher.Parent then
					nextShot[launcher] = nil
				end
			end
		end
	end)
end

return BarnFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">EventFX</string>
            <string name="Source"><![CDATA[-- What big events and weather look like (see Events.luau), on each player's own screen:
-- a colour tint over everything, falling rain or sparkles around the camera, and lightning
-- flashes during a Monster Storm.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Events = require(ReplicatedStorage.Shared.Events)

local EventFX = {}

local LOOKS = {
	MonsterStorm = {
		tint = Color3.fromRGB(205, 185, 255),
		brightness = -0.06,
		rain = Color3.fromRGB(170, 200, 255),
		lightning = true,
	},
	BloodMoon = { tint = Color3.fromRGB(255, 165, 170), brightness = -0.04, rain = Color3.fromRGB(255, 80, 90) },
	GoldRush = { tint = Color3.fromRGB(255, 238, 180), brightness = 0.03, rain = Color3.fromRGB(255, 215, 80) },
	RainbowRain = { tint = Color3.fromRGB(255, 225, 255), brightness = 0.02, rain = "rainbow" },
}

function EventFX.start()
	local tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "EventTint"
	tint.Parent = Lighting

	-- A big invisible sheet over the camera that rain (or sparkles) falls from.
	local sky = Instance.new("Part")
	sky.Name = "EventSky"
	sky.Anchored = true
	sky.CanCollide = false
	sky.CanQuery = false
	sky.CanTouch = false
	sky.Transparency = 1
	sky.Size = Vector3.new(120, 1, 120)
	local rain = Instance.new("ParticleEmitter")
	rain.Rate = 0
	rain.Lifetime = NumberRange.new(1.6, 2.2)
	rain.Speed = NumberRange.new(30, 40)
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.Size = NumberSequence.new(0.35)
	rain.LightEmission = 0.6
	rain.Parent = sky
	sky.Parent = Workspace

	local nextFlash = 0
	task.spawn(function()
		while true do
			local big, _, bigId = Events.current()
			local weather, _, weatherId = Events.weather()
			-- A big event's look wins over the weather's.
			local look = (big and LOOKS[bigId]) or (weather and LOOKS[weatherId])
			local camera = Workspace.CurrentCamera
			if camera then
				sky.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 40, 0))
			end
			local target = if look then look.tint else Color3.new(1, 1, 1)
			local brightness = if look then look.brightness else 0
			if look and look.rain == "rainbow" then
				target = Color3.fromHSV((os.clock() * 0.1) % 1, 0.12, 1)
			end
			tint.TintColor = tint.TintColor:Lerp(target, 0.05)
			if look and look.lightning and os.clock() >= nextFlash then
				nextFlash = os.clock() + 3 + math.random() * 5
				tint.Brightness = 0.45 -- the flash, which fades below
			end
			tint.Brightness += (brightness - tint.Brightness) * 0.12
			if look then
				rain.Rate = if look.lightning then 300 else 120
				if look.rain == "rainbow" then
					rain.Color = ColorSequence.new(Color3.fromHSV((os.clock() * 0.3) % 1, 0.6, 1))
				else
					rain.Color = ColorSequence.new(look.rain)
				end
			else
				rain.Rate = 0
			end
			task.wait(1 / 30)
		end
	end)
end

return EventFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- The always-on-screen parts of the UI: money, event chip, menu tabs, leaderboard,
-- gate button and pop-up notifications. Windows (Shop, Freeks, ...) live in Main.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Events = require(ReplicatedStorage.Shared.Events)
local Format = require(ReplicatedStorage.Shared.Format)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Luck = require(ReplicatedStorage.Shared.Luck)
local Seasons = require(ReplicatedStorage.Shared.Seasons)
local UI = require(script.Parent.UI)

local colors = UI.colors
local player = Players.LocalPlayer

local Hud = {}

local function text(value: string, size: number, props)
	local label = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = UI.fonts.bold,
		Text = value,
		TextSize = size,
		TextColor3 = colors.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, { UI.textStroke(if size >= 22 then 2.5 else 1.8) })
	for key, v in props or {} do
		label[key] = v
	end
	return label
end

-- Scales a frame down on short screens (phones) so it never runs off the edge.
local function fitHeight(frame: GuiObject, designHeight: number, reserved: number)
	local scale = UI.new("UIScale", { Parent = frame })
	local function update()
		local camera = Workspace.CurrentCamera
		local available = camera.ViewportSize.Y - reserved
		scale.Scale = math.clamp(available / designHeight, 0.55, 1)
	end
	update()
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
end

local function hoverGrow(button: GuiButton)
	local scale = UI.new("UIScale", { Parent = button })
	local info = TweenInfo.new(0.12, Enum.EasingStyle.Quad)
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, info, { Scale = 1.06 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, info, { Scale = 1 }):Play()
	end)
end

--------------------------------------------------------------------------------
-- Money
--------------------------------------------------------------------------------

function Hud.money(screen: ScreenGui)
	local pill = UI.glass({
		Name = "Money",
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(250, 62),
		BackgroundColor3 = Color3.fromRGB(40, 165, 75),
		Parent = screen,
	}, { UI.corner(20) })

	UI.new("Frame", {
		Name = "Coin",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = colors.gold,
		Parent = pill,
	}, {
		UI.corner(20),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 226, 120), Color3.fromRGB(235, 150, 30)),
			Rotation = 90,
		}),
		UI.stroke(nil, 3),
		text("$", 24, {
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			FontFace = UI.fonts.heavy,
			TextColor3 = Color3.fromRGB(120, 70, 10),
		}),
	})

	local amount = text("$0", 30, {
		Position = UDim2.fromOffset(60, 4),
		Size = UDim2.new(1, -116, 0, 32),
		FontFace = UI.fonts.heavy,
		TextColor3 = colors.money,
		Parent = pill,
	})
	local income = text("+$0/s", 15, {
		Position = UDim2.fromOffset(60, 35),
		Size = UDim2.new(1, -116, 0, 18),
		TextColor3 = Color3.fromRGB(255, 240, 150),
		Parent = pill,
	})
	local boost = UI.new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(46, 22),
		BackgroundColor3 = colors.gold,
		BackgroundTransparency = 0.75,
		FontFace = UI.fonts.heavy,
		TextSize = 14,
		TextColor3 = colors.gold,
		Visible = false,
		Parent = pill,
	}, { UI.corner(11) })

	-- The number glides to its new value instead of jumping.
	local shown = player:GetAttribute("Money") or 0
	RunService.RenderStepped:Connect(function(dt)
		local target = player:GetAttribute("Money") or 0
		shown += (target - shown) * math.min(1, dt * 8)
		if math.abs(target - shown) < 1 then
			shown = target
		end
		amount.Text = Format.money(shown)
	end)
	local function updateIncome()
		income.Text = "+" .. Format.money(player:GetAttribute("Income") or 0) .. "/s"
	end
	player:GetAttributeChangedSignal("Income"):Connect(updateIncome)
	updateIncome()

	return function(rebirths: number)
		boost.Visible = rebirths > 0
		boost.Text = "x" .. tostring(Config.incomeMultiplier(rebirths))
	end
end

--------------------------------------------------------------------------------
-- Event chip
--------------------------------------------------------------------------------

function Hud.eventChip(screen: ScreenGui)
	local chip = UI.glass({
		Name = "Event",
		Position = UDim2.fromOffset(12, 80),
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		Visible = false,
		Parent = screen,
	}, {
		UI.corner(14),
		UI.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 12) }),
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 7),
		}),
	})
	local dot = UI.new("Frame", { Size = UDim2.fromOffset(9, 9), Parent = chip }, { UI.corner(5) })
	local label = text("", 14, { Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, Parent = chip })

	local function update()
		local active = Seasons.active()
		local season = active[1] and Seasons.list[active[1]]
		chip.Visible = season ~= nil
		if season then
			dot.BackgroundColor3 = season.color
			label.Text = season.name .. " Event · Live"
			label.TextColor3 = season.color:Lerp(Color3.new(1, 1, 1), 0.35)
		end
	end
	update()
	task.spawn(function()
		while true do
			task.wait(60)
			update()
		end
	end)
end

-- Shows the Lucky Hour event that's running (see Luck.luau) with a countdown.
function Hud.luckChip(screen: ScreenGui)
	local chip = UI.glass({
		Name = "LuckyEvent",
		Position = UDim2.fromOffset(12, 114),
		Size = UDim2.fromOffset(0, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		Visible = false,
		Parent = screen,
	}, {
		UI.corner(15),
		UI.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 12) }),
	})
	local stroke = UI.stroke(Color3.new(1, 1, 1), 2)
	stroke.Parent = chip
	local label = text("", 15, {
		Size = UDim2.fromOffset(0, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		FontFace = UI.fonts.heavy,
		Parent = chip,
	})
	task.spawn(function()
		while true do
			local event, ends = Luck.current()
			chip.Visible = event ~= nil
			if event then
				local left = ends - Workspace:GetServerTimeNow()
				label.Text = event.icon .. "  " .. event.name .. " · " .. Format.time(left)
				label.TextColor3 = event.color:Lerp(Color3.new(1, 1, 1), 0.3)
				-- Pulse the outline so it catches the eye.
				stroke.Color = event.color
				stroke.Transparency = (math.sin(os.clock() * 4) + 1) * 0.3
			end
			task.wait(0.1)
		end
	end)
end

--------------------------------------------------------------------------------
-- Big events and weather (see Events.luau)
--------------------------------------------------------------------------------

-- "2d 4h", "3h 12m", "12:05": how long until something, short.
local function countdown(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local d, h, m, s = seconds // 86400, (seconds % 86400) // 3600, (seconds % 3600) // 60, seconds % 60
	if d > 0 then
		return string.format("%dd %dh", d, h)
	elseif h > 0 then
		return string.format("%dh %dm", h, m)
	end
	return string.format("%d:%02d", m, s)
end

-- A banner at the top of the screen: the big event when it's live (big, glowing, with time
-- left) or a countdown to the next one, and under it the weather or when it's next due.
function Hud.eventBanner(screen: ScreenGui)
	local holder = UI.new("Frame", {
		Name = "EventBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		UI.new("UIListLayout", {
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 5),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local function pill(order: number, height: number)
		local frame = UI.glass({
			Size = UDim2.fromOffset(0, height),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = order,
			Parent = holder,
		}, {
			UI.corner(height / 2),
			UI.new("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) }),
			UI.new("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
			}),
		})
		local label = text("", height * 0.55, {
			Size = UDim2.fromOffset(0, height),
			AutomaticSize = Enum.AutomaticSize.X,
			FontFace = UI.fonts.heavy,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = frame,
		})
		return frame, label, frame:FindFirstChildOfClass("UIStroke")
	end
	local eventPill, eventLabel, eventStroke = pill(1, 40)
	local weatherPill, weatherLabel = pill(2, 28)
	local eventScale = UI.new("UIScale", { Parent = eventPill })

	task.spawn(function()
		while true do
			local t = Workspace:GetServerTimeNow()
			local big, ends = Events.current()
			if big then
				-- Live: the event's colour, pulsing, with time left.
				local pulse = (math.sin(os.clock() * 5) + 1) / 2
				eventPill.BackgroundColor3 = big.color:Lerp(Color3.fromRGB(60, 20, 110), 0.35 + pulse * 0.2)
				eventLabel.Text = big.icon .. "  " .. string.upper(big.name) .. " LIVE · " .. countdown(ends - t)
				eventLabel.TextColor3 = Color3.new(1, 1, 1)
				if eventStroke then
					eventStroke.Color = big.color:Lerp(Color3.new(1, 1, 1), pulse * 0.6)
				end
				eventScale.Scale = 1 + pulse * 0.04
			else
				local id = ReplicatedStorage:GetAttribute("NextEvent")
				local at = ReplicatedStorage:GetAttribute("NextEventAt") or 0
				local nextEvent = id and Events.BIG[id]
				eventPill.Visible = nextEvent ~= nil
				if nextEvent then
					eventPill.BackgroundColor3 = colors.panel
					eventLabel.Text = nextEvent.icon .. "  " .. nextEvent.name .. " in " .. countdown(at - t)
					eventLabel.TextColor3 = nextEvent.color:Lerp(Color3.new(1, 1, 1), 0.55)
					if eventStroke then
						eventStroke.Color = UI.OUTLINE
					end
					eventScale.Scale = 0.85
				end
			end
			if big then
				eventPill.Visible = true
			end

			local weather, weatherEnds = Events.weather()
			if weather then
				weatherPill.BackgroundColor3 = weather.color:Lerp(Color3.new(0, 0, 0), 0.25)
				weatherLabel.Text = weather.icon .. "  " .. weather.name .. " · " .. countdown(weatherEnds - t)
				weatherLabel.TextColor3 = Color3.new(1, 1, 1)
				weatherPill.Visible = true
			else
				local id = ReplicatedStorage:GetAttribute("NextWeather")
				local at = ReplicatedStorage:GetAttribute("NextWeatherAt") or 0
				local nextWeather = id and Events.WEATHER[id]
				weatherPill.Visible = nextWeather ~= nil
				if nextWeather then
					weatherPill.BackgroundColor3 = colors.panel
					weatherLabel.Text = nextWeather.icon .. "  " .. nextWeather.name .. " in " .. countdown(at - t)
					weatherLabel.TextColor3 = nextWeather.color:Lerp(Color3.new(1, 1, 1), 0.5)
				end
			end
			task.wait(0.1)
		end
	end)
end

-- The Starter Pack offer button with its countdown (only during a player's first hours,
-- until they buy it). Tapping it opens the Store.
function Hud.starterOffer(screen: ScreenGui, onOpen: () -> ())
	local button = UI.button("", colors.green, onOpen, {
		Name = "StarterOffer",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, -70),
		Size = UDim2.fromOffset(170, 74),
		Visible = false,
		ZIndex = 10,
		Parent = screen,
	})
	button:FindFirstChildOfClass("UIPadding"):Destroy()
	local gradient = button:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Color = ColorSequence.new(Color3.fromRGB(80, 230, 120), Color3.fromRGB(30, 170, 150))
	end
	text("🎁 STARTER PACK", 18, {
		Position = UDim2.fromOffset(0, 8),
		Size = UDim2.new(1, 0, 0, 24),
		FontFace = UI.fonts.heavy,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 11,
		Parent = button,
	})
	local timer = text("", 22, {
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 28),
		FontFace = UI.fonts.heavy,
		TextColor3 = colors.gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 11,
		Parent = button,
	})
	UI.tag(button, "LIMITED", colors.red).Size = UDim2.fromOffset(84, 24)
	local scale = UI.new("UIScale", { Parent = button })
	task.spawn(function()
		while true do
			local ends = player:GetAttribute("StarterEnds")
			local left = if ends then ends - Workspace:GetServerTimeNow() else 0
			button.Visible = left > 0 and not player:GetAttribute("CratesRestricted")
			if button.Visible then
				local h, m, sec = left // 3600, (left % 3600) // 60, math.floor(left % 60)
				timer.Text = string.format("⏰ %d:%02d:%02d", h, m, sec)
				scale.Scale = 1 + (math.sin(os.clock() * 4) + 1) * 0.02
			end
			task.wait(0.1)
		end
	end)
end

--------------------------------------------------------------------------------
-- Menu tabs
--------------------------------------------------------------------------------

-- entries = { { name, icon, color } }. Returns setActive(name or nil).
function Hud.menu(screen: ScreenGui, entries, onSelect: (string) -> ())
	local TILE = 64
	local GAP = 8
	local height = #entries * TILE + (#entries - 1) * GAP + 16
	-- Starts below the money pill and event chip, and shrinks to fit above the hotbar.
	local rail = UI.new("Frame", {
		Name = "Menu",
		Position = UDim2.fromOffset(12, 118),
		Size = UDim2.fromOffset(TILE + 16, height),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		UI.new("UIPadding", {
			PaddingTop = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
		UI.new("UIListLayout", { Padding = UDim.new(0, GAP), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	fitHeight(rail, height, 118 + 24)

	local tiles = {}
	for i, entry in entries do
		local name, icon, color = entry[1], entry[2], entry[3]
		local tile = UI.new("TextButton", {
			Name = name,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = color,
			Size = UDim2.fromOffset(TILE, TILE),
			LayoutOrder = i,
			Parent = rail,
		}, {
			UI.corner(18),
			UI.gradient(),
			text(icon, 30, {
				Position = UDim2.fromOffset(0, 3),
				Size = UDim2.new(1, 0, 0, 36),
				TextXAlignment = Enum.TextXAlignment.Center,
			}),
			text(name, 14, {
				Position = UDim2.new(0, 0, 1, -21),
				Size = UDim2.new(1, 0, 0, 17),
				TextXAlignment = Enum.TextXAlignment.Center,
				FontFace = UI.fonts.heavy,
			}),
		})
		-- Thick dark outline; turns white on the open tab.
		local ring = UI.stroke(nil, 3.5)
		ring.Parent = tile
		tiles[name] = ring
		hoverGrow(tile)
		tile.Activated:Connect(function()
			onSelect(name)
		end)
	end

	return function(active: string?)
		for name, ring in tiles do
			ring.Color = if name == active then Color3.new(1, 1, 1) else UI.OUTLINE
			ring.Thickness = if name == active then 4.5 else 3.5
		end
	end
end

--------------------------------------------------------------------------------
-- Leaderboard (replaces Roblox's default player list)
--------------------------------------------------------------------------------

function Hud.leaderboard(screen: ScreenGui)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
	end)

	local ROW = 40
	local board = UI.glass({
		Name = "Leaderboard",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(250, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = screen,
	}, {
		UI.corner(16),
		UI.new("UIPadding", {
			PaddingTop = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
		UI.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local header = UI.new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = 0,
		Parent = board,
	}, {
		text("🏆  Leaderboard", 15, {
			Position = UDim2.fromOffset(4, 0),
			Size = UDim2.new(1, -40, 1, 0),
			FontFace = UI.fonts.heavy,
		}),
	})
	local count = text("", 13, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -4, 0, 0),
		Size = UDim2.fromOffset(40, 26),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = colors.muted,
		Parent = header,
	})

	local list = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = board,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	header.Activated:Connect(function()
		list.Visible = not list.Visible
	end)

	local rows = {} -- [Player] = { frame, rank, name, money, badge }
	local thumbnails = {}

	local function makeRow(other: Player)
		local isMe = other == player
		local frame = UI.new("Frame", {
			BackgroundColor3 = if isMe then colors.blue else Color3.new(1, 1, 1),
			BackgroundTransparency = if isMe then 0.72 else 0.95,
			Size = UDim2.new(1, 0, 0, ROW),
			Parent = list,
		}, { UI.corner(10) })
		local rank = text("1", 13, {
			Position = UDim2.fromOffset(6, 0),
			Size = UDim2.fromOffset(16, ROW),
			TextColor3 = colors.muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = frame,
		})
		local avatar = UI.new("ImageLabel", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 26, 0.5, 0),
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = colors.card,
			Parent = frame,
		}, { UI.corner(14) })
		task.spawn(function()
			if not thumbnails[other.UserId] then
				local ok, image = pcall(function()
					return Players:GetUserThumbnailAsync(
						other.UserId,
						Enum.ThumbnailType.HeadShot,
						Enum.ThumbnailSize.Size48x48
					)
				end)
				thumbnails[other.UserId] = if ok then image else ""
			end
			avatar.Image = thumbnails[other.UserId]
		end)
		local name = text(other.DisplayName, 14, {
			Position = UDim2.fromOffset(62, 0),
			Size = UDim2.new(1, -150, 1, 0),
			Parent = frame,
		})
		local vip = UI.new("TextLabel", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 46, 0, 9),
			Size = UDim2.fromOffset(14, 14),
			BackgroundTransparency = 1,
			Text = "👑",
			TextSize = 12,
			Visible = false,
			ZIndex = 2,
			Parent = frame,
		})
		local badge = UI.new("TextLabel", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -66, 0.5, 0),
			Size = UDim2.fromOffset(28, 18),
			BackgroundColor3 = colors.gold,
			BackgroundTransparency = 0.75,
			FontFace = UI.fonts.heavy,
			TextSize = 11,
			TextColor3 = colors.gold,
			Visible = false,
			Parent = frame,
		}, { UI.corner(9) })
		local money = text("$0", 14, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -8, 0, 0),
			Size = UDim2.fromOffset(56, ROW),
			TextXAlignment = Enum.TextXAlignment.Right,
			FontFace = UI.fonts.heavy,
			TextColor3 = colors.money,
			Parent = frame,
		})
		rows[other] = { frame = frame, rank = rank, name = name, money = money, badge = badge, vip = vip }
	end

	local function stat(other: Player, key: string): number
		local stats = other:FindFirstChild("leaderstats")
		local value = stats and stats:FindFirstChild(key)
		return if value then value.Value else 0
	end

	local function refresh()
		local everyone = Players:GetPlayers()
		for _, other in everyone do
			if not rows[other] then
				makeRow(other)
			end
		end
		for other, row in rows do
			if not other.Parent then
				row.frame:Destroy()
				rows[other] = nil
			end
		end
		table.sort(everyone, function(a, b)
			return stat(a, "Money") > stat(b, "Money")
		end)
		for i, other in everyone do
			local row = rows[other]
			row.frame.LayoutOrder = i
			row.rank.Text = tostring(i)
			row.money.Text = Format.money(stat(other, "Money"))
			local rebirths = stat(other, "Rebirths")
			row.badge.Visible = rebirths > 0
			row.badge.Text = "R" .. rebirths
			local isVip = GamePasses.has(other, "VIP")
			row.vip.Visible = isVip
			row.name.TextColor3 = if isVip then colors.gold else colors.text
		end
		count.Text = #everyone .. "/" .. Config.PLOT_COUNT
	end

	refresh()
	Players.PlayerAdded:Connect(refresh)
	Players.PlayerRemoving:Connect(function()
		task.defer(refresh)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			refresh()
		end
	end)
end

--------------------------------------------------------------------------------
-- VIP chat tag
--------------------------------------------------------------------------------

function Hud.vipChatTag()
	local TextChatService = game:GetService("TextChatService")
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local sender = source and Players:GetPlayerByUserId(source.UserId)
		if sender and GamePasses.has(sender, "VIP") then
			properties.PrefixText = '<font color="#FFC83C">[VIP]</font> ' .. message.PrefixText
		end
		return properties
	end
end

--------------------------------------------------------------------------------
-- Gate status (locking happens at the padlock inside your yard)
--------------------------------------------------------------------------------

function Hud.gateStatus(screen: ScreenGui)
	local button = UI.new("Frame", {
		Name = "Gate",
		AnchorPoint = Vector2.new(0.5, 1),
		-- Sits above Roblox's tool hotbar, which takes the bottom-centre of the screen.
		Position = UDim2.new(0.5, 0, 1, -96),
		Size = UDim2.fromOffset(300, 52),
		BackgroundColor3 = colors.panel,
		BackgroundTransparency = UI.GLASS_TRANSPARENCY,
		Parent = screen,
	}, { UI.corner(26) })
	local ring = UI.stroke(colors.green, 2, 0.1)
	ring.Parent = button
	local label = text("", 18, {
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = UI.fonts.heavy,
		Parent = button,
	})
	task.spawn(function()
		while true do
			local left = (player:GetAttribute("GateLockedUntil") or 0) - Workspace:GetServerTimeNow()
			if left > 0 and left < 1e9 then
				label.Text = "🔒  Locked · " .. Format.time(left)
				label.TextColor3 = colors.money
				ring.Color = colors.green
				button.BackgroundColor3 = colors.panel
			else
				-- Pulses red while open so the owner notices.
				local pulse = (math.sin(os.clock() * 6) + 1) / 2
				label.Text = "🔓  Barn open · Lock it at your door!"
				label.TextColor3 = colors.text
				ring.Color = colors.red
				button.BackgroundColor3 = colors.red:Lerp(Color3.fromRGB(120, 25, 35), pulse)
			end
			task.wait(0.05)
		end
	end)
end

--------------------------------------------------------------------------------
-- Notifications
--------------------------------------------------------------------------------

local TOAST_COLORS = {
	error = colors.red,
	success = colors.green,
	money = Color3.fromRGB(40, 165, 75),
	discovery = Color3.fromRGB(255, 160, 30),
}

-- Returns toast(message, kind?).
function Hud.toasts(screen: ScreenGui)
	local holder = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 92), -- under the event banner
		Size = UDim2.new(0.5, 0, 0, 220),
		Parent = screen,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	return function(message: string, kind: string?)
		local accent = TOAST_COLORS[kind or ""] or colors.blue
		local big = kind == "discovery"
		local frame = UI.glass({
			Size = UDim2.fromOffset(0, if big then 48 else 38),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = accent,
			Parent = holder,
		}, {
			UI.corner(20),
			UI.new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 16) }),
			UI.new("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 10),
			}),
		})
		local label = text(message, if big then 22 else 17, {
			Size = UDim2.fromOffset(0, 28),
			AutomaticSize = Enum.AutomaticSize.X,
			FontFace = if big then UI.fonts.heavy else UI.fonts.bold,
			TextColor3 = colors.text,
			Parent = frame,
		})
		label.TextTruncate = Enum.TextTruncate.None

		task.delay(if big then 7 else 3.5, function()
			local info = TweenInfo.new(0.35)
			TweenService:Create(frame, info, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, info, { TextTransparency = 1 }):Play()
			task.wait(0.35)
			frame:Destroy()
		end)
	end
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">ItemPictures</string>
            <string name="Source"><![CDATA[-- 3D pictures for shop items (barn slots, weapons, game passes), built from parts like
-- everything else in the game and shown in ViewportFrames on the item cards.
-- ItemPictures.view(key, height) returns a ViewportFrame; keys are "BarnSlot", a weapon
-- id from Weapons.luau, or a game pass key from GamePasses.luau.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FreekModel = require(ReplicatedStorage.Shared.FreekModel)
local WeaponModel = require(ReplicatedStorage.Shared.WeaponModel)
local Weapons = require(ReplicatedStorage.Shared.Weapons)

local ItemPictures = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local GOLD = rgb(255, 200, 55)

local function part(model: Model, props)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "ClassName" then
			p[key] = value
		end
	end
	p.Parent = model
	return p
end

-- A ball, or a squashed ball (a sphere mesh) when the size isn't the same every way.
local function ball(model, position: Vector3, size: Vector3 | number, color: Color3, material: Enum.Material?)
	local vector = if typeof(size) == "number" then Vector3.one * size else size
	local round = vector.X == vector.Y and vector.Y == vector.Z
	local p = part(model, {
		Shape = if round then Enum.PartType.Ball else Enum.PartType.Block,
		Size = vector,
		CFrame = CFrame.new(position),
		Color = color,
		Material = material,
	})
	if not round then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	return p
end

local function cylinder(model, cframe: CFrame, height: number, diameter: number, color: Color3, material)
	return part(model, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = cframe * CFrame.Angles(0, 0, math.pi / 2), -- upright
		Color = color,
		Material = material,
	})
end

-- A thick arc of blocks (handles, shackles).
local function arc(model, center: CFrame, radius: number, from: number, to: number, thickness: number, color: Color3)
	local last
	for i = 0, 10 do
		local a = from + (to - from) * i / 10
		local point = (center * CFrame.new(math.cos(a) * radius, math.sin(a) * radius, 0)).Position
		if last then
			part(model, {
				Size = Vector3.new(thickness, thickness, (point - last).Magnitude + thickness * 0.6),
				CFrame = CFrame.lookAt((point + last) / 2, point),
				Color = color,
				Material = Enum.Material.Metal,
			})
		end
		last = point
	end
end

-- A big green "+" sign.
local function plus(model, position: Vector3, size: number)
	local green = rgb(80, 220, 100)
	part(model, { Size = Vector3.new(size, size * 0.32, size * 0.32), CFrame = CFrame.new(position), Color = green })
	part(model, { Size = Vector3.new(size * 0.32, size, size * 0.32), CFrame = CFrame.new(position), Color = green })
end

-- A glowing pad like the ones in the barn, with a Freek standing on it.
local function padWithFreek(model, species: string)
	cylinder(model, CFrame.new(0, 0.3, 0), 0.6, 5, rgb(70, 70, 85))
	cylinder(model, CFrame.new(0, 0.62, 0), 0.06, 4.4, rgb(90, 230, 255), Enum.Material.Neon)
	local freek, height = FreekModel.build(species)
	freek:PivotTo(CFrame.new(0, 0.65, 0))
	for _, p in freek:GetDescendants() do
		if p:IsA("BasePart") then
			p.Parent = model
		end
	end
	freek:Destroy()
	return height
end

local BUILDERS = {}

-- An extra barn slot: a pad with a Freek on it and a big plus.
function BUILDERS.BarnSlot(model)
	local height = padWithFreek(model, "Oinkle")
	plus(model, Vector3.new(-2.6, height + 0.8, 0), 1.8)
end
BUILDERS.ExtraSlot1 = BUILDERS.BarnSlot
BUILDERS.ExtraSlot2 = BUILDERS.BarnSlot
BUILDERS.ExtraSlot3 = BUILDERS.BarnSlot

-- 2x Coins: a pile of gold coins and a green cash stack.
function BUILDERS.DoubleCoins(model)
	for i = 0, 2 do
		part(model, {
			Size = Vector3.new(3.4, 0.6, 1.8),
			CFrame = CFrame.new(0.4, 0.3 + i * 0.62, 0.6) * CFrame.Angles(0, math.rad(i * 7), 0),
			Color = rgb(90, 200, 90),
		})
		part(model, {
			Size = Vector3.new(0.6, 0.66, 1.86),
			CFrame = CFrame.new(0.4, 0.3 + i * 0.62, 0.6) * CFrame.Angles(0, math.rad(i * 7), 0),
			Color = rgb(255, 240, 200),
		})
	end
	for i, spot in
		{
			Vector3.new(-1.4, 0.2, -0.6),
			Vector3.new(-1.4, 0.55, -0.6),
			Vector3.new(-1.4, 0.9, -0.6),
			Vector3.new(-0.3, 0.2, -1.2),
		}
	do
		cylinder(model, CFrame.new(spot) * CFrame.Angles(0, i, 0), 0.32, 1.7, GOLD, Enum.Material.Foil)
	end
	-- One big coin standing up in front.
	part(model, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 2.4, 2.4),
		CFrame = CFrame.new(-0.6, 1.6, -1.6) * CFrame.Angles(0, math.rad(80), 0),
		Color = GOLD,
		Material = Enum.Material.Foil,
	})
end

-- Fast Fusing: a pink potion with a lightning bolt.
function BUILDERS.FastBreeding(model)
	ball(model, Vector3.new(0, 1.8, 0), 3.4, rgb(200, 235, 255), Enum.Material.Glass).Transparency = 0.6
	ball(model, Vector3.new(0, 1.55, 0), Vector3.new(2.9, 2.4, 2.9), rgb(255, 60, 170), Enum.Material.Neon)
	cylinder(model, CFrame.new(0, 3.8, 0), 1.4, 1.1, rgb(200, 235, 255), Enum.Material.Glass).Transparency = 0.4
	cylinder(model, CFrame.new(0, 4.6, 0), 0.7, 1.3, rgb(150, 95, 50))
	-- A zig-zag bolt beside it.
	local yellow = rgb(255, 220, 40)
	for _, bit in { { 2.3, 3.6, -30 }, { 2.0, 2.4, 35 }, { 2.4, 1.2, -30 } } do
		part(model, {
			Size = Vector3.new(0.7, 1.6, 0.5),
			CFrame = CFrame.new(bit[1], bit[2], -0.6) * CFrame.Angles(0, 0, math.rad(bit[3])),
			Color = yellow,
			Material = Enum.Material.Neon,
		})
	end
end

-- Longer Gate Lock: a big gold padlock.
function BUILDERS.LongerLock(model)
	part(model, {
		Size = Vector3.new(3.2, 2.6, 1.2),
		CFrame = CFrame.new(0, 1.3, 0),
		Color = GOLD,
		Material = Enum.Material.Foil,
	})
	arc(model, CFrame.new(0, 2.6, 0), 1.1, 0, math.pi, 0.45, rgb(170, 170, 180))
	ball(model, Vector3.new(0, 1.5, -0.6), 0.6, rgb(60, 45, 30))
	part(model, { Size = Vector3.new(0.3, 0.8, 0.2), CFrame = CFrame.new(0, 1.05, -0.62), Color = rgb(60, 45, 30) })
end

-- VIP: a gold crown with gems.
function BUILDERS.VIP(model)
	cylinder(model, CFrame.new(0, 0.8, 0), 1.6, 3.6, GOLD, Enum.Material.Foil)
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		local spot = Vector3.new(math.sin(a) * 1.5, 2.2, -math.cos(a) * 1.5)
		part(model, {
			Size = Vector3.new(0.9, 1.6, 0.9),
			CFrame = CFrame.new(spot) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, math.rad(45)),
			Color = GOLD,
			Material = Enum.Material.Foil,
		})
		ball(model, spot + Vector3.new(0, 1.1, 0), 0.55, GOLD, Enum.Material.Foil)
	end
	for k, color in { rgb(255, 50, 80), rgb(80, 160, 255), rgb(90, 220, 110) } do
		local a = (k - 2) * 0.7
		ball(model, Vector3.new(math.sin(a) * 1.8, 0.8, -math.cos(a) * 1.8), 0.7, color, Enum.Material.Neon)
	end
end

-- Extra Fusion Den: two hay bales and a pink heart.
function BUILDERS.ExtraPen(model)
	for _, x in { -1.4, 1.4 } do
		part(model, {
			Size = Vector3.new(2.4, 1.5, 1.6),
			CFrame = CFrame.new(x, 0.75, 0),
			Color = rgb(225, 190, 95),
			Material = Enum.Material.Sand,
		})
		part(model, { Size = Vector3.new(0.2, 1.55, 1.65), CFrame = CFrame.new(x, 0.75, 0), Color = rgb(140, 100, 55) })
	end
	local pink = rgb(255, 90, 170)
	ball(model, Vector3.new(-0.45, 3, 0), 1.2, pink, Enum.Material.Neon)
	ball(model, Vector3.new(0.45, 3, 0), 1.2, pink, Enum.Material.Neon)
	part(model, {
		Size = Vector3.new(1.25, 1.25, 1),
		CFrame = CFrame.new(0, 2.5, 0) * CFrame.Angles(0, 0, math.rad(45)),
		Color = pink,
		Material = Enum.Material.Neon,
	})
end

-- A weapon, laid on its side so the whole thing shows.
local function weaponModel(model, weaponId: string)
	local tool = WeaponModel.build(weaponId)
	local melee = Weapons.list[weaponId].kind == "melee"
	for _, p in tool:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
			-- Melee weapons extend along +Z, guns point along -Z: turn them to lie across.
			p.CFrame = CFrame.Angles(
				0,
				if melee then math.rad(90) else math.rad(-90),
				if melee then math.rad(35) else 0
			) * p.CFrame
			p.Parent = model
		end
	end
	tool:Destroy()
end

-- The box round everything you can see (counting stretched sphere meshes).
local function visibleBounds(model: Model): (Vector3, Vector3)
	local lo, hi
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p.Transparency < 1 then
			local size = p.Size
			local mesh = p:FindFirstChildOfClass("SpecialMesh")
			if mesh then
				size *= mesh.Scale
			end
			for _, x in { -0.5, 0.5 } do
				for _, y in { -0.5, 0.5 } do
					for _, z in { -0.5, 0.5 } do
						local point = p.CFrame:PointToWorldSpace(size * Vector3.new(x, y, z))
						lo = if lo then lo:Min(point) else point
						hi = if hi then hi:Max(point) else point
					end
				end
			end
		end
	end
	return lo or Vector3.zero, hi or Vector3.zero
end

function ItemPictures.has(key: string): boolean
	return BUILDERS[key] ~= nil or Weapons.list[key] ~= nil
end

-- A ViewportFrame showing the item, framed to fit, seen a little from above and the side.
function ItemPictures.view(key: string, height: number?): ViewportFrame
	local frame = Instance.new("ViewportFrame")
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.new(1, 0, 0, height or 90)
	frame.Ambient = Color3.fromRGB(190, 190, 190)
	frame.LightColor = Color3.fromRGB(255, 250, 240)
	frame.LightDirection = Vector3.new(-1, -1.4, 1)

	local model = Instance.new("Model")
	if Weapons.list[key] then
		weaponModel(model, key)
	elseif BUILDERS[key] then
		BUILDERS[key](model)
	end
	model.Parent = frame

	local lo, hi = visibleBounds(model)
	local center = (lo + hi) / 2
	local extent = hi - lo
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	-- The picture strip is about twice as wide as it is tall, so wide items can use the
	-- width (the field of view is vertical).
	local aspect = 2
	local wide = math.max(extent.X, extent.Z) * 0.85
	local fit = math.max(extent.Y, wide / aspect) / 2 * 1.08
	local distance = fit / math.tan(math.rad(15)) + extent.Z / 2
	local direction = Vector3.new(0.45, 0.4, -1).Unit
	camera.CFrame = CFrame.lookAt(center + direction * distance, center)
	camera.Parent = frame
	frame.CurrentCamera = camera
	return frame
end

return ItemPictures
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">LuckyWheel</string>
            <string name="Source"><![CDATA[-- The Lucky Wheel, drawn like the prize wheels in the big simulators: bright pie slices
-- (each with a big icon, its prize and its chance) inside a chunky gold rim ringed with
-- blinking bulbs, a red pointer at the top, and a hub in the middle that can be the SPIN
-- button. LuckyWheel.build returns the wheel and spinTo(slice, onDone), which spins it
-- round a few times and stops with that slice under the pointer.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Luck = require(ReplicatedStorage.Shared.Luck)
local UI = require(script.Parent.UI)

local LuckyWheel = {}

-- Slice colours go round the wheel in a rainbow, so neighbours always differ.
local SLICE_COLORS = {
	Color3.fromRGB(255, 90, 160),
	Color3.fromRGB(70, 160, 255),
	Color3.fromRGB(255, 205, 50),
	Color3.fromRGB(80, 210, 110),
	Color3.fromRGB(165, 100, 250),
	Color3.fromRGB(255, 140, 50),
	Color3.fromRGB(40, 205, 200),
	Color3.fromRGB(245, 75, 85),
}
local ICONS = {
	Coins = "💰",
	["Big Coins"] = "💵",
	["Golden Freek"] = "⭐",
	["Monster Egg"] = "🥚",
	["Huge Coins"] = "🤑",
	["Rainbow Freek"] = "🌈",
	["Mega Egg"] = "🔮",
	JACKPOT = "👑",
}

-- Short names that fit on a slice.
local SHORT = {
	Coins = "COINS",
	["Big Coins"] = "BIG $",
	["Golden Freek"] = "GOLDEN",
	["Monster Egg"] = "EGG",
	["Huge Coins"] = "HUGE $",
	["Rainbow Freek"] = "RAINBOW",
	["Mega Egg"] = "MEGA EGG",
	JACKPOT = "JACKPOT",
}

local function circle(props, children)
	local frame = UI.new("Frame", props, children)
	UI.corner(999).Parent = frame
	return frame
end

-- size: the wheel's width in pixels. opts.hubText: text on the hub (e.g. "SPIN!"),
-- opts.onHub: makes the hub a button. opts.zIndex: base ZIndex.
function LuckyWheel.build(parent: Instance, size: number, opts)
	opts = opts or {}
	local z = opts.zIndex or 1
	local count = #Luck.WHEEL
	local sliceAngle = 360 / count

	local frame = UI.new("Frame", {
		Name = "LuckyWheel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	})

	-- The gold rim with its outline.
	circle({
		Name = "Rim",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 200, 60),
		ZIndex = z,
		Parent = frame,
	}, {
		UI.stroke(nil, 4),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 240, 160), Color3.fromRGB(230, 140, 20)),
			Rotation = 90,
		}),
	})

	-- Bulbs round the rim.
	local bulbs = {}
	local bulbCount = 16
	for k = 1, bulbCount do
		local a = math.rad((k - 1) / bulbCount * 360)
		local bulb = circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(a) * size * 0.465, 0.5, -math.cos(a) * size * 0.465),
			Size = UDim2.fromOffset(size * 0.04, size * 0.04),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = z + 1,
			Parent = frame,
		}, { UI.stroke(nil, 1.5) })
		table.insert(bulbs, bulb)
	end

	-- The spinning part: the slices and their labels.
	local radius = size * 0.42
	local spinner = UI.new("Frame", {
		Name = "Spinner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(radius * 2, radius * 2),
		BackgroundTransparency = 1,
		ZIndex = z + 1,
		Parent = frame,
	})
	circle({
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UI.OUTLINE,
		ZIndex = z + 1,
		Parent = spinner,
	})
	-- Each slice is filled with thin wedges fanned out from the middle.
	local wedges = 10
	local step = sliceAngle / wedges
	local wedgeWidth = radius * math.rad(step) * 1.25
	for i, slice in Luck.WHEEL do
		local color = SLICE_COLORS[(i - 1) % #SLICE_COLORS + 1]
		for k = 0, wedges - 1 do
			UI.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(wedgeWidth, radius - 3),
				Rotation = (i - 1) * sliceAngle + (k + 0.5) * step,
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				ZIndex = z + 2,
				Parent = spinner,
			}, {
				-- Lighter toward the rim.
				UI.new("UIGradient", {
					Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 210)),
					Rotation = 90,
				}),
			})
		end
		-- A dark line between slices.
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(3, radius),
			Rotation = (i - 1) * sliceAngle,
			BackgroundColor3 = UI.OUTLINE,
			BorderSizePixel = 0,
			ZIndex = z + 3,
			Parent = spinner,
		})
		-- The slice's label: big icon, prize, chance; turned to read outward.
		local arm = UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(radius * 0.5, radius * 2),
			Rotation = (i - 0.5) * sliceAngle,
			BackgroundTransparency = 1,
			ZIndex = z + 4,
			Parent = spinner,
		})
		UI.label(ICONS[slice.label] or "🎁", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, radius * 0.08),
			Size = UDim2.fromOffset(radius * 0.36, radius * 0.3),
			ZIndex = z + 5,
			Parent = arm,
		})
		UI.label(SHORT[slice.label] or string.upper(slice.label), {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, radius * 0.38),
			Size = UDim2.fromOffset(radius * 0.5, radius * 0.13),
			FontFace = UI.fonts.heavy,
			ZIndex = z + 5,
			Parent = arm,
		})
		UI.label(string.format("%.0f%%", Luck.wheelPercent(i)), {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, radius * 0.52),
			Size = UDim2.fromOffset(radius * 0.4, radius * 0.11),
			TextColor3 = Color3.fromRGB(255, 250, 200),
			ZIndex = z + 5,
			Parent = arm,
		})
	end

	-- The hub in the middle (the SPIN button in the Luck window).
	local hub = UI.new(if opts.onHub then "TextButton" else "TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size * 0.26, size * 0.26),
		BackgroundColor3 = Color3.new(1, 1, 1),
		FontFace = UI.fonts.heavy,
		Text = opts.hubText or "🎡",
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = z + 6,
		Parent = frame,
	}, {
		UI.corner(999),
		UI.stroke(nil, 4),
		UI.textStroke(2.5),
		UI.new("UIGradient", {
			Color = ColorSequence.new(UI.colors.fusion, UI.colors.fusion2),
			Rotation = 45,
		}),
		UI.new("UIPadding", {
			PaddingLeft = UDim.new(0.14, 0),
			PaddingRight = UDim.new(0.14, 0),
			PaddingTop = UDim.new(0.22, 0),
			PaddingBottom = UDim.new(0.22, 0),
		}),
	})
	if opts.onHub then
		(hub :: TextButton).AutoButtonColor = false
		(hub :: TextButton).Activated:Connect(opts.onHub)
	end

	-- The pointer at the top: a red tip with a gold cap.
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, size * 0.06),
		Size = UDim2.fromOffset(size * 0.09, size * 0.09),
		Rotation = 45,
		BackgroundColor3 = UI.colors.red,
		ZIndex = z + 7,
		Parent = frame,
	}, { UI.corner(4), UI.stroke(nil, 3) })
	circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, size * 0.015),
		Size = UDim2.fromOffset(size * 0.07, size * 0.07),
		BackgroundColor3 = Color3.fromRGB(255, 205, 60),
		ZIndex = z + 8,
		Parent = frame,
	}, { UI.stroke(nil, 3) })

	-- Bulbs blink in turn (faster while spinning).
	local spinning = false
	task.spawn(function()
		local tick = 0
		while frame.Parent do
			tick += 1
			for k, bulb in bulbs do
				local on = (k + tick) % 2 == 0
				bulb.BackgroundColor3 = if on then Color3.fromRGB(255, 250, 200) else Color3.fromRGB(255, 120, 60)
			end
			task.wait(if spinning then 0.08 else 0.45)
		end
	end)

	local wheel = { frame = frame, hub = hub }
	-- Spins round several times and stops with `slice` under the pointer.
	function wheel.spinTo(slice: number, onDone: (() -> ())?)
		spinning = true
		local target = -((slice - 0.5) * sliceAngle) - 360 * 6 + (math.random() - 0.5) * sliceAngle * 0.6
		local tween = TweenService:Create(
			spinner,
			TweenInfo.new(4.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{ Rotation = target }
		)
		tween:Play()
		tween.Completed:Connect(function()
			spinning = false
			if onDone then
				onDone()
			end
		end)
	end
	return wheel
end

return LuckyWheel
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="61">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- The player's screen: money display, menu buttons, and the Shop / Freeks / Breed / Book
-- windows. The server is the source of truth; this only shows state and sends requests.

local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

print("[Fuse a Freek] Client starting")

-- If the game hasn't loaded after a few seconds, show what the server is stuck on.
local clientReady = false
task.delay(8, function()
	if clientReady then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "LoadingProblem"
	gui.DisplayOrder = 100
	gui.ResetOnSpawn = false
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.8, 0, 0.6, 0)
	label.Position = UDim2.fromScale(0.1, 0.2)
	label.BackgroundColor3 = Color3.fromRGB(40, 0, 0)
	label.BackgroundTransparency = 0.15
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextWrapped = true
	label.TextSize = 16
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Font = Enum.Font.Code
	label.Parent = gui
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	while not clientReady do
		label.Text = "The game didn't finish loading. Send this to the developer:\n\nServer: "
			.. tostring(ReplicatedStorage:GetAttribute("ServerStartup") or "no status (server script never ran)")
		task.wait(1)
	end
	gui:Destroy()
end)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Drops = require(Shared.Drops)
local Breeding = require(Shared.Breeding)
local Config = require(Shared.Config)
local GateTiers = require(Shared.GateTiers)
local Format = require(Shared.Format)
local FreekAnimator = require(ReplicatedStorage.Shared.FreekAnimator)
local FreekModel = require(Shared.FreekModel)
local FreekUtil = require(Shared.FreekUtil)
local Freeks = require(Shared.Freeks)
local GamePasses = require(Shared.GamePasses)
local Luck = require(Shared.Luck)
local Mutations = require(Shared.Mutations)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)
local Seasons = require(Shared.Seasons)
local Weapons = require(Shared.Weapons)
local Ambient = require(script.Parent.Ambient)
local BarnFX = require(script.Parent.BarnFX)
local AdminPanel = require(script.Parent.AdminPanel)
local ItemPictures = require(script.Parent.ItemPictures)
local LuckyWheel = require(script.Parent.LuckyWheel)
local EventFX = require(script.Parent.EventFX)
local Hud = require(script.Parent.Hud)
local PackReveal = require(script.Parent.PackReveal)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local colors = UI.colors

local actionRemote = Remotes.get("Action")
local function send(action: string, ...)
	actionRemote:FireServer(action, ...)
end

local state = nil
local discoveries = {}

--------------------------------------------------------------------------------
-- Screen layout
--------------------------------------------------------------------------------

local screen = UI.new("ScreenGui", {
	Name = "FuseAFreekUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

local setRebirthBoost = Hud.money(screen)
Hud.eventChip(screen)
Hud.luckChip(screen)
Hud.eventBanner(screen)
AdminPanel.start(screen)
EventFX.start()
Hud.leaderboard(screen)
Hud.vipChatTag()
local toast = Hud.toasts(screen)

-- Windows: a light body under a header bar in the window's own colour, with a slanted
-- title tab in the game's purple-to-pink sticking out over the top-left corner and a red
-- square X (the clean simulator style of Pet Simulator and PLS DONATE).
local window = UI.new("Frame", {
	Name = "Window",
	Visible = false,
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.53, 0.53),
	Size = UDim2.fromScale(0.66, 0.74),
	BackgroundColor3 = colors.sheet,
	ZIndex = 5, -- above the leaderboard and other HUD pieces
	Parent = screen,
}, {
	UI.corner(22),
	UI.stroke(nil, 4),
	UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(220, 215, 235)),
		Rotation = 90,
	}),
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(860, 600) }),
})
local header = UI.new("Frame", {
	Name = "Header",
	Size = UDim2.new(1, 0, 0, 58),
	BackgroundColor3 = colors.green,
	ZIndex = 5,
	Parent = window,
}, {
	UI.corner(20),
	UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 200)),
		Rotation = 90,
	}),
})
-- Square off the header's bottom corners, with a dark line under it.
local headerFill = UI.new("Frame", {
	Position = UDim2.new(0, 0, 1, -20),
	Size = UDim2.new(1, 0, 0, 20),
	BackgroundColor3 = colors.green,
	BorderSizePixel = 0,
	ZIndex = 5,
	Parent = header,
}, {
	UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(215, 215, 222), Color3.fromRGB(190, 190, 200)),
		Rotation = 90,
	}),
})
UI.new("Frame", {
	Position = UDim2.new(0, 0, 1, 0),
	Size = UDim2.new(1, 0, 0, 4),
	BackgroundColor3 = UI.OUTLINE,
	BorderSizePixel = 0,
	ZIndex = 5,
	Parent = header,
})
local titleRibbon = UI.new("Frame", {
	Name = "TitleTab",
	Position = UDim2.fromOffset(18, -22),
	Size = UDim2.fromOffset(0, 58),
	AutomaticSize = Enum.AutomaticSize.X,
	Rotation = -4,
	BackgroundColor3 = Color3.new(1, 1, 1),
	ZIndex = 6,
	Parent = window,
}, {
	UI.corner(14),
	UI.stroke(nil, 4),
	UI.new("UIGradient", {
		Color = ColorSequence.new(colors.fusion, colors.fusion2),
		Rotation = 0,
	}),
	UI.new("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 22) }),
	UI.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	}),
})
local windowTitle = UI.new("TextLabel", {
	Size = UDim2.fromOffset(0, 46),
	AutomaticSize = Enum.AutomaticSize.X,
	BackgroundTransparency = 1,
	FontFace = UI.fonts.heavy,
	TextSize = 36,
	TextColor3 = Color3.new(1, 1, 1),
	ZIndex = 7,
	Parent = titleRibbon,
}, { UI.textStroke(3) })
local function paintHeader(color: Color3)
	header.BackgroundColor3 = color
	headerFill.BackgroundColor3 = color
end
local body = UI.new("ScrollingFrame", {
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Position = UDim2.fromOffset(14, 70),
	Size = UDim2.new(1, -28, 1, -82),
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollBarThickness = 8,
	Parent = window,
}, {
	UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	UI.new("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 8),
	}),
})

--------------------------------------------------------------------------------
-- Windows
--------------------------------------------------------------------------------

local currentWindow = nil
local renderers = {}
local breedSelection = {}
local penCountdowns = {} -- { { label, button, endsAt } } for the Fuse window
local trade = nil -- the server's view of my current trade, or nil
local tradeStatusLabel = nil

local function clearBody()
	for _, child in body:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	table.clear(penCountdowns)
	tradeStatusLabel = nil
end

local function render()
	if not currentWindow or not state then
		return
	end
	clearBody()
	renderers[currentWindow]()
end

local setActiveTab = function(_name: string?) end
local TAB_ICONS = {}
local TAB_COLORS = {}

local function open(name: string)
	if currentWindow == name then
		currentWindow = nil
		window.Visible = false
		setActiveTab(nil)
		return
	end
	currentWindow = name
	setActiveTab(name)
	windowTitle.Text = (TAB_ICONS[name] or "") .. " " .. string.upper(name)
	paintHeader(TAB_COLORS[name] or colors.blue)
	window.Visible = true
	body.CanvasPosition = Vector2.zero
	render()
end

UI.button("X", colors.red, function()
	open(currentWindow)
end, {
	AnchorPoint = Vector2.new(1, 0.5),
	Size = UDim2.fromOffset(50, 50),
	Position = UDim2.new(1, 12, 0, 6),
	ZIndex = 7,
	Parent = window,
})

-- A line of text over the cards: short ones are bold section titles, long ones are hints.
local function heading(text: string, order: number)
	local title = #text <= 24
	return UI.label(text, {
		Size = UDim2.new(1, 0, 0, if title then 32 else 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = if title then UI.fonts.heavy else UI.fonts.bold,
		TextColor3 = if title then Color3.new(1, 1, 1) else colors.muted,
		LayoutOrder = order,
		Parent = body,
	})
end

local function rarityColor(speciesId: string): Color3
	return Rarities.info[Freeks.byId[speciesId].rarity].color
end

local function nameColor(freek): Color3
	local top = Mutations.top(freek.mutations)
	if top then
		return Mutations.byId[top].color
	end
	return rarityColor(freek.species)
end

-- My Freeks, best earners first.
local function sortedFreeks()
	local list = {}
	for uid, freek in state.freeks do
		table.insert(list, { uid = uid, freek = freek })
	end
	table.sort(list, function(x, y)
		local ix, iy = FreekUtil.income(x.freek), FreekUtil.income(y.freek)
		if ix ~= iy then
			return ix > iy
		end
		return x.uid < y.uid
	end)
	return list
end

-- Button that needs a second tap within 3 seconds.
local function confirmButton(text: string, color: Color3, onConfirm: () -> ())
	local armed = false
	local button
	button = UI.button(text, color, function()
		if armed then
			onConfirm()
			return
		end
		armed = true
		button.Text = "Tap again!"
		task.delay(3, function()
			if button.Parent then
				armed = false
				button.Text = text
			end
		end)
	end)
	return button
end

function renderers.Shop()
	heading("New Freeks fly out of the cannons! Grab one while it wanders and carry it home.", 1)
	heading("Barn", 3)
	local yard = UI.grid(220, 220)
	yard.LayoutOrder = 4
	yard.Parent = body
	local bought = state.boughtSlots or state.slots
	local maxed = bought >= Config.MAX_SLOTS
	local price = Config.slotPrice(bought)
	UI.card({
		picture = "BarnSlot",
		lines = {
			{ "Barn Slots", colors.text, 26 },
			{
				bought .. " / " .. Config.MAX_SLOTS .. " bought" .. (if (state.passSlots or 0) > 0
					then "  ·  +" .. state.passSlots .. " from passes"
					else ""),
				colors.muted,
			},
		},
		buttons = {
			if maxed
				then UI.button("Maxed out!", colors.gray, function() end)
				else UI.pricePill("BUY " .. Format.money(price), function()
					send("BuySlot")
				end, { Size = UDim2.new(1, 0, 0, 36) }),
		},
	}).Parent =
		yard

	heading("Weapons", 5)
	local weapons = UI.grid(220, 250)
	weapons.LayoutOrder = 6
	weapons.Parent = body
	for i, weaponId in Weapons.order do
		local weapon = Weapons.list[weaponId]
		local owned = weaponId == Weapons.STARTER or (state.rebirths or 0) >= (weapon.rebirth or math.huge)
		local card = UI.card({
			picture = weaponId,
			lines = {
				{ weapon.name, weapon.color:Lerp(Color3.new(1, 1, 1), 0.3), 24 },
				{ weapon.description, colors.muted, 44 },
			},
			buttons = {
				UI.button(
					if owned then "Unlocked" else "Unlocks at Rebirth " .. weapon.rebirth,
					if owned then colors.green else colors.gray,
					function()
						if not owned then
							open("Rebirth")
						end
					end
				),
			},
		})
		card.LayoutOrder = i
		card.Parent = weapons
	end
end

function renderers.Freeks()
	local list = sortedFreeks()
	local placed = 0
	for _, item in list do
		if item.freek.slot then
			placed += 1
		end
	end
	heading(
		string.format(
			"%d Freeks (max %d)  ·  %d / %d in barn",
			#list,
			GamePasses.maxFreeks(player),
			placed,
			state.slots
		),
		1
	)
	if #list == 0 then
		heading("No Freeks yet! Buy one in the Shop.", 2)
		return
	end

	local grid = UI.grid(150, 270)
	grid.LayoutOrder = 3
	grid.Parent = body
	for i, item in list do
		local uid, freek = item.uid, item.freek
		local status, statusColor
		if freek.breeding then
			status, statusColor = "Fusing", colors.pink
		elseif freek.slot then
			status, statusColor = "In barn", colors.money
		else
			status, statusColor = "In backpack (not earning)", colors.muted
		end

		local buttons = {}
		if not freek.breeding then
			if freek.slot then
				table.insert(
					buttons,
					UI.button("Take out", colors.orange, function()
						send("Unplace", uid)
					end)
				)
			else
				table.insert(
					buttons,
					UI.button("Put in barn", colors.green, function()
						send("Place", uid)
					end)
				)
			end
			table.insert(
				buttons,
				confirmButton("Sell " .. Format.money(FreekUtil.sellValue(freek)), colors.red, function()
					send("Sell", uid)
				end)
			)
		end

		local card = UI.card({
			species = freek.species,
			mutations = freek.mutations,
			lines = {
				{ FreekUtil.displayName(freek), nameColor(freek), 20 },
				{ FreekUtil.rarityText(freek.species), rarityColor(freek.species), 16 },
				{ Format.money(FreekUtil.income(freek)) .. "/s", colors.money },
				{ status, statusColor, 14 },
			},
			buttons = buttons,
		})
		card.LayoutOrder = i
		card.Parent = grid
	end
end

function renderers.Fuse()
	-- Pens: what's cooking in each, and a locked card for the Extra Breeding Pen.
	local pens = GamePasses.penCount(player)
	local freePen = false
	local penGrid = UI.grid(300, 250)
	penGrid.LayoutOrder = 0
	penGrid.Parent = body
	for index = 1, #FreekUtil.PEN_KEYS do
		local breeding = FreekUtil.pen(state, index)
		local card
		if breeding then
			local a, b = state.freeks[breeding.a], state.freeks[breeding.b]
			local pair = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 100) }, {
				UI.new("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
				}),
			})
			for _, freek in { a, b } do
				if freek then
					local view = UI.viewport(freek.species, freek.mutations)
					view.Size = UDim2.new(0.5, 0, 1, 0)
					view.Parent = pair
				end
			end
			local countdown = UI.label("", { Size = UDim2.new(1, 0, 0, 22) })
			local claim = UI.button("Collect!", colors.pink, function()
				send("ClaimBreed", index)
			end, { Size = UDim2.new(1, 0, 0, 38) })
			card = UI.card({
				lines = { { "Den " .. index, colors.pink, 22 } },
				buttons = { pair, countdown, claim },
			})
			table.insert(penCountdowns, { label = countdown, button = claim, endsAt = breeding.endsAt })
		elseif index <= pens then
			freePen = true
			card = UI.card({
				lines = {
					{ "Den " .. index, colors.pink, 22 },
					{ "Empty. Pick two Freeks below!", colors.muted, 18 },
				},
			})
		else
			card = UI.card({
				lines = {
					{ "🐣", colors.text, 40 },
					{ "Extra Fusion Den", colors.pink, 22 },
					{ "Fuse two pairs at once.", colors.muted, 18 },
				},
				buttons = {
					UI.button("Get it in the Store", colors.gray, function()
						open("Store")
					end, { Size = UDim2.new(1, 0, 0, 36) }),
				},
			})
		end
		card.LayoutOrder = index
		card.Parent = penGrid
	end
	if not freePen then
		heading(if pens > 1 then "Both Fusion Dens are busy!" else "Your Fusion Den is busy!", 1)
		return
	end

	-- Drop selections that are no longer valid.
	for i = #breedSelection, 1, -1 do
		local freek = state.freeks[breedSelection[i]]
		if not freek or freek.breeding then
			table.remove(breedSelection, i)
		end
	end

	heading("Both Freeks fuse into one hybrid that earns more than both. Some Ultra pairs make a Secret!", 1)

	local selected = {}
	for _, uid in breedSelection do
		selected[uid] = true
	end

	local ready = #breedSelection == 2
	local label = "Pick 2 Freeks (" .. #breedSelection .. "/2)"
	if ready then
		local a, b = state.freeks[breedSelection[1]], state.freeks[breedSelection[2]]
		label = "Fuse "
			.. FreekUtil.displayName(a)
			.. " + "
			.. FreekUtil.displayName(b)
			.. " ("
			.. Format.time(FreekUtil.breedTime(a, b))
			.. ")"

		-- What this pair will make: its name once you've made it before, otherwise ???.
		-- Which Ultra pairs make a Secret stays a surprise.
		local rarity, bothUltra = Breeding.babyRarity(a, b)
		local resultId = Breeding.babySpecies(a, b)
		local result = Freeks.byId[resultId]
		local resultName = if state.discovered[resultId] and result then result.name else "???"
		local parts = {
			"Makes: " .. resultName .. " (" .. rarity .. (if bothUltra then ", or a Secret?!" else "") .. ")",
			Format.money(Breeding.babyIncome(a, b)) .. "/s",
		}
		local odds = Breeding.mutationOdds(a, b)
		for _, option in odds do
			table.insert(parts, math.round(option.chance * 100) .. "% " .. option.id)
		end
		if #odds == 0 then
			table.insert(parts, "no mutations")
		end
		local prediction = heading(table.concat(parts, "  •  "), 2)
		prediction.TextColor3 = Rarities.info[rarity].color
	end
	UI.button(label, if ready then colors.pink else colors.gray, function()
		if #breedSelection == 2 then
			send("StartBreed", breedSelection[1], breedSelection[2])
			table.clear(breedSelection)
		end
	end, { Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 3, Parent = body })

	local grid = UI.grid(140, 190)
	grid.LayoutOrder = 4
	grid.Parent = body
	for i, item in sortedFreeks() do
		local uid, freek = item.uid, item.freek
		local isSelected = selected[uid]
		local card = UI.card({
			species = freek.species,
			mutations = freek.mutations,
			background = if isSelected then Color3.fromRGB(90, 40, 80) else nil,
			border = if isSelected then colors.pink else nil,
			lines = {
				{ FreekUtil.displayName(freek), nameColor(freek), 20 },
				{ FreekUtil.rarityText(freek.species), rarityColor(freek.species), 16 },
				{ if isSelected then "Selected!" else "Tap to pick", colors.muted, 14 },
			},
			onClick = function()
				local index = table.find(breedSelection, uid)
				if index then
					table.remove(breedSelection, index)
				elseif #breedSelection < 2 then
					table.insert(breedSelection, uid)
				else
					breedSelection[2] = uid
				end
				render()
			end,
		})
		card.LayoutOrder = i
		card.Parent = grid
	end
end

function renderers.Book()
	local total, found = 0, 0
	for _, species in Freeks.list do
		total += 1
		if state.discovered[species.id] then
			found += 1
		end
	end
	heading(string.format("You've found %d / %d Freeks", found, total), 1)

	local grid = UI.grid(150, 220)
	grid.LayoutOrder = 2
	grid.Parent = body
	for _, species in Freeks.list do
		local discovery = discoveries[species.id]
		-- Monsters are always shown, so players can see what the crates hold.
		local known = species.price ~= nil or discovery ~= nil or species.exclusive == true
		local credit
		if species.price then
			credit = "Starter Freek"
		elseif species.exclusive and not discovery then
			credit = "Only from Monster Eggs (🍀 Luck tab)"
		elseif discovery then
			credit = "First found by\n" .. discovery.name
		elseif not Seasons.available(species) then
			credit = "Limited: only during the " .. Seasons.list[species.season].name .. " Event"
		else
			credit = "Nobody has found this yet!"
		end
		local card = UI.card({
			species = species.id,
			silhouette = not known,
			border = if state.discovered[species.id] then colors.green else nil,
			lines = {
				{ if known then species.name else "???", if known then colors.text else colors.muted, 22 },
				{ FreekUtil.rarityText(species.id), Rarities.info[species.rarity].color, 16 },
				{ credit, if discovery then colors.orange else colors.muted, 34 },
				{ if state.discovered[species.id] then "You have found this" else "", colors.green, 14 },
			},
		})
		card.LayoutOrder = species.order
		card.Parent = grid
	end

	-- Hybrids this player has made, with whoever made each one first.
	local hybrids = {}
	for id in state.discovered do
		local species = Freeks.byId[id]
		if species and species.hybrid then
			table.insert(hybrids, species)
		end
	end
	table.sort(hybrids, function(a, b)
		return a.name < b.name
	end)
	heading(string.format("Hybrids you've made: %d (every pair makes its own!)", #hybrids), 3)
	local hybridGrid = UI.grid(150, 220)
	hybridGrid.LayoutOrder = 4
	hybridGrid.Parent = body
	for i, species in hybrids do
		local discovery = discoveries[species.id]
		local card = UI.card({
			species = species.id,
			border = colors.green,
			lines = {
				{ species.name, colors.text, 22 },
				{ species.rarity .. " hybrid", Rarities.info[species.rarity].color, 16 },
				{
					if discovery then "First made by\n" .. discovery.name else "",
					colors.orange,
					34,
				},
			},
		})
		card.LayoutOrder = i
		card.Parent = hybridGrid
	end
end

local function tradeStatus(): string
	if not trade then
		return ""
	end
	if trade.countdownEndsAt then
		local left = math.max(0, math.ceil(trade.countdownEndsAt - Workspace:GetServerTimeNow()))
		return "Trading in " .. left .. "..."
	elseif trade.myReady then
		return "Waiting for " .. trade.partner .. " to press Ready..."
	elseif trade.theirReady then
		return trade.partner .. " is ready! Press Ready to accept."
	end
	return "Add Freeks, then both press Ready."
end

local function tradeCard(item, footer: string, onClick)
	return UI.card({
		species = item.species,
		mutations = item.mutations,
		lines = {
			{ FreekUtil.displayName(item), nameColor(item), 18 },
			{ Format.money(FreekUtil.income(item)) .. "/s", colors.money, 14 },
			{ footer, colors.muted, 14 },
		},
		onClick = onClick,
	})
end

function renderers.Trade()
	if not trade then
		heading("Trade Freeks with other players in this server.", 1)
		local grid = UI.grid(200, 100)
		grid.LayoutOrder = 2
		grid.Parent = body
		local anyone = false
		for _, other in Players:GetPlayers() do
			if other ~= player then
				anyone = true
				UI.card({
					lines = { { other.DisplayName, colors.text, 24 } },
					buttons = {
						UI.button("Send trade request", colors.blue, function()
							send("TradeRequest", other.UserId)
						end, { Size = UDim2.new(1, 0, 0, 36) }),
					},
				}).Parent =
					grid
			end
		end
		if not anyone then
			heading("Nobody else is here yet!", 3)
		end
		return
	end

	heading("Trading with " .. trade.partner, 1)

	local offered = {}
	for _, item in trade.mine do
		offered[item.uid] = true
	end

	local columns = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = body,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local function column(title: string, color: Color3, ready: boolean, order: number)
		local frame = UI.new("Frame", {
			BackgroundColor3 = Color3.fromRGB(30, 26, 46),
			Size = UDim2.new(0.5, -5, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
			Parent = columns,
		}, {
			UI.corner(12),
			if ready then UI.stroke(colors.green, 2.5) else UI.stroke(),
			UI.new("UIPadding", {
				PaddingTop = UDim.new(0, 6),
				PaddingBottom = UDim.new(0, 8),
				PaddingLeft = UDim.new(0, 6),
				PaddingRight = UDim.new(0, 6),
			}),
			UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		UI.label(title .. (if ready then "  READY" else ""), {
			TextColor3 = color,
			Size = UDim2.new(1, 0, 0, 24),
			LayoutOrder = 1,
			Parent = frame,
		})
		local grid = UI.grid(120, 165)
		grid.LayoutOrder = 2
		grid.Parent = frame
		return grid
	end

	local giveGrid = column("You give", colors.orange, trade.myReady, 1)
	for i, item in trade.mine do
		local card = tradeCard(item, "Tap to remove", function()
			send("TradeOffer", item.uid, false)
		end)
		card.LayoutOrder = i
		card.Parent = giveGrid
	end
	local getGrid = column("You get", colors.money, trade.theirReady, 2)
	for i, item in trade.theirs do
		local card = tradeCard(item, "", nil)
		card.LayoutOrder = i
		card.Parent = getGrid
	end

	tradeStatusLabel = UI.label(tradeStatus(), { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 3, Parent = body })

	local buttons = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 46),
		LayoutOrder = 4,
		Parent = body,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	UI.button(
		if trade.myReady then "Not ready" else "Ready",
		if trade.myReady then colors.gray else colors.green,
		function()
			if trade then
				send("TradeReady", not trade.myReady)
			end
		end,
		{ Size = UDim2.new(0.5, -5, 1, 0), LayoutOrder = 1, Parent = buttons }
	)
	UI.button("Cancel trade", colors.red, function()
		send("TradeCancel")
	end, { Size = UDim2.new(0.5, -5, 1, 0), LayoutOrder = 2, Parent = buttons })

	heading("Tap your Freeks to offer them", 5)
	local mine = UI.grid(120, 165)
	mine.LayoutOrder = 6
	mine.Parent = body
	for i, item in sortedFreeks() do
		if not offered[item.uid] and not item.freek.breeding then
			local card = tradeCard(item.freek, "Tap to offer", function()
				send("TradeOffer", item.uid, true)
			end)
			card.LayoutOrder = i
			card.Parent = mine
		end
	end
end

-- Incoming trade request popup.
local requestPopup = UI.new("Frame", {
	Visible = false,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 90),
	Size = UDim2.fromOffset(320, 110),
	BackgroundColor3 = colors.panel,
	ZIndex = 10,
	Parent = screen,
}, {
	UI.corner(18),
	UI.stroke(colors.blue, 2),
})
local requestLabel = UI.label("", {
	Size = UDim2.new(1, -20, 0, 40),
	Position = UDim2.fromOffset(10, 8),
	ZIndex = 10,
	Parent = requestPopup,
})
local pendingRequest = nil
local function answerRequest(accept: boolean)
	if pendingRequest then
		send("TradeRespond", pendingRequest.userId, accept)
	end
	pendingRequest = nil
	requestPopup.Visible = false
end
UI.button("Accept", colors.green, function()
	answerRequest(true)
end, {
	Size = UDim2.new(0.5, -15, 0, 42),
	Position = UDim2.new(0, 10, 1, -52),
	ZIndex = 10,
	Parent = requestPopup,
})
UI.button("Decline", colors.red, function()
	answerRequest(false)
end, {
	Size = UDim2.new(0.5, -15, 0, 42),
	Position = UDim2.new(0.5, 5, 1, -52),
	ZIndex = 10,
	Parent = requestPopup,
})

function renderers.Rebirth()
	local rebirths = state.rebirths or 0
	local cost = Config.rebirthCost(rebirths)
	local nextMult = Config.incomeMultiplier(rebirths + 1)
	heading(
		string.format("Rebirth %d  ·  Your Freeks earn x%s", rebirths, tostring(Config.incomeMultiplier(rebirths))),
		1
	)

	local unlocks = {}
	for _, weaponId in Weapons.order do
		if Weapons.list[weaponId].rebirth == rebirths + 1 then
			table.insert(unlocks, Weapons.list[weaponId].name)
		end
	end

	local gateNow = GateTiers.list[GateTiers.forRebirths(rebirths)]
	local gateNext = GateTiers.list[GateTiers.forRebirths(rebirths + 1)]
	local gateLine = if gateNext ~= gateNow
		then "Gate upgrade: " .. gateNow.name .. " → " .. gateNext.name
		else "Your gate: " .. gateNow.name .. " (max)"

	local grid = UI.grid(440, 290)
	grid.LayoutOrder = 2
	grid.Parent = body
	local ready = state.money >= cost
	UI.card({
		lines = {
			{ "Rebirth " .. (rebirths + 1), Color3.fromRGB(255, 210, 80), 30 },
			{ "Your Freeks earn x" .. tostring(nextMult) .. " forever", colors.money, 22 },
			{ if #unlocks > 0 then "Unlocks: " .. table.concat(unlocks, ", ") else "", colors.orange, 20 },
			{ gateLine, colors.gold, 18 },
			{ "Resets: coins, Freeks, barn slots", colors.red:Lerp(Color3.new(1, 1, 1), 0.3), 18 },
			{ "Keeps: Discovery Book, Limited Freeks, weapons", colors.muted, 18 },
			{
				Format.money(state.money) .. " / " .. Format.money(cost),
				if ready then colors.money else colors.text,
				22,
			},
		},
		buttons = {
			if ready
				then confirmButton("Rebirth for " .. Format.money(cost), Color3.fromRGB(230, 180, 40), function()
					send("Rebirth")
				end)
				else UI.button("Need " .. Format.money(cost), colors.gray, function() end),
		},
	}).Parent =
		grid

	heading("Weapon unlocks", 3)
	local milestones = UI.grid(200, 80)
	milestones.LayoutOrder = 4
	milestones.Parent = body
	for i, weaponId in Weapons.order do
		local weapon = Weapons.list[weaponId]
		local at = weapon.rebirth or 0
		local card = UI.card({
			lines = {
				{ weapon.name, weapon.color:Lerp(Color3.new(1, 1, 1), 0.3), 22 },
				{
					if at == 0 then "Free" elseif rebirths >= at then "Unlocked" else "Rebirth " .. at,
					if rebirths >= at then colors.money else colors.muted,
					18,
				},
			},
		})
		card.LayoutOrder = i
		card.Parent = milestones
	end
end

-- What each pass gives, shown as a badge on its card.
local PASS_BADGES = {
	DoubleCoins = "x2",
	FastBreeding = "2x FAST",
	LongerLock = "+2 MIN",
	ExtraPen = "+1",
	ExtraSlot1 = "+1",
	ExtraSlot2 = "+1",
	ExtraSlot3 = "+1",
}

-- The price pill (or Owned / Coming soon) for a game pass.
local function passButton(key: string, size: UDim2)
	local pass = GamePasses.list[key]
	local owned = GamePasses.has(player, key)
	local function buy()
		if not owned and pass.id ~= 0 then
			MarketplaceService:PromptGamePassPurchase(player, pass.id)
		end
	end
	if owned then
		return UI.button("OWNED ✓", colors.green, buy, { Size = size })
	elseif pass.id == 0 then
		return UI.button("Coming soon", colors.gray, buy, { Size = size })
	end
	return UI.pricePill("R$ " .. pass.price, buy, { Size = size })
end

-- A wide glossy banner card (Starter Pack, egg bundles, VIP): returns the frame.
local function banner(order: number, colorA: Color3, colorB: Color3, height: number)
	local frame = UI.new("Frame", {
		Size = UDim2.new(1, -8, 0, height),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = order,
		Parent = body,
	}, {
		UI.corner(18),
		UI.stroke(nil, 4),
		UI.new("UIGradient", { Color = ColorSequence.new(colorA, colorB), Rotation = 15 }),
	})
	UI.new("Frame", {
		Position = UDim2.fromOffset(6, 5),
		Size = UDim2.new(1, -12, 0.4, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.8,
		Parent = frame,
	}, { UI.corner(14) })
	return frame
end

-- A row of egg pictures inside a banner.
local function eggRow(parent: Instance, crateId: string, count: number, x: number, size: number)
	for k = 1, count do
		local view = UI.eggViewport(crateId, size)
		view.Position = UDim2.fromOffset(x + (k - 1) * size * 0.62, 18)
		view.Size = UDim2.fromOffset(size, size)
		view.ZIndex = 3
		view.Parent = parent
	end
end

local function bannerText(parent: Instance, title: string, lines: string, x: number, color: Color3)
	local titleLabel = UI.label(title, {
		Position = UDim2.fromOffset(x, 12),
		Size = UDim2.new(1, -x - 230, 0, 44),
		FontFace = UI.fonts.heavy,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
	titleLabel.UIStroke.Thickness = 3
	return UI.label(lines, {
		Position = UDim2.fromOffset(x + 2, 58),
		Size = UDim2.new(1, -x - 232, 0, 70),
		TextScaled = false,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = parent,
	})
end

local function bannerButton(parent: Instance, button: GuiButton)
	button.AnchorPoint = Vector2.new(1, 0.5)
	button.Position = UDim2.new(1, -20, 0.5, 6)
	button.Size = UDim2.fromOffset(190, 54)
	button.Parent = parent
	return button
end

-- The Starter Pack banner, with its countdown (only while the offer is open).
local function starterBanner(order: number)
	local ends = player:GetAttribute("StarterEnds")
	if not ends or ends <= Workspace:GetServerTimeNow() or player:GetAttribute("CratesRestricted") then
		return
	end
	local starter = Luck.STARTER
	local frame = banner(order, Color3.fromRGB(70, 225, 120), Color3.fromRGB(30, 160, 200), 150)
	local eggs = 0
	for crateId, count in starter.crates do
		eggRow(frame, crateId, count, 10 + eggs * 70, 110)
		eggs += count
	end
	local x = 10 + eggs * 70 + 60
	local eggWord = {}
	for crateId, count in starter.crates do
		table.insert(eggWord, count .. " " .. Luck.crateById[crateId].name .. if count > 1 then "s" else "")
	end
	local info = bannerText(
		frame,
		"STARTER PACK",
		"💰 " .. Format.money(starter.coins) .. " coins\n🥚 " .. table.concat(eggWord, " + ") .. "\n⏰ ",
		x,
		colors.gold
	)
	local pill = UI.pricePill(if starter.passId ~= 0 then "R$ " .. starter.robux else "Coming soon", function()
		send("BuyStarter")
	end)
	bannerButton(frame, pill)
	UI.tag(frame, "LIMITED", colors.red).Position = UDim2.new(1, -16, 0, 8)
	-- Count down live while the window is open.
	local base = info.Text
	task.spawn(function()
		while info.Parent do
			local left = math.max(0, ends - Workspace:GetServerTimeNow())
			info.Text = base
				.. string.format("Only %d:%02d:%02d left!", left // 3600, (left % 3600) // 60, math.floor(left % 60))
			task.wait(1)
		end
	end)
end

-- An egg bundle banner.
local function bundleBanner(order: number, bundle)
	local crate = Luck.crateById[bundle.crate]
	local frame = banner(order, crate.color, Color3.fromRGB(255, 100, 60), 150)
	eggRow(frame, crate.id, 4, 10, 110)
	local restricted = player:GetAttribute("CratesRestricted")
	bannerText(
		frame,
		string.upper(bundle.name),
		"Save "
			.. Luck.bundleSaving(bundle)
			.. "% on "
			.. crate.name
			.. "s!\nThey wait in the Luck tab to hatch whenever you like.",
		350,
		Color3.new(1, 1, 1)
	)
	local button
	if restricted then
		button = UI.button("Not available in your region", colors.gray, function() end)
	elseif bundle.productId ~= 0 then
		button = UI.pricePill("R$ " .. bundle.robux, function()
			send("BuyBundle", bundle.id)
		end)
	else
		button = UI.button("Coming soon", colors.gray, function() end)
	end
	bannerButton(frame, button)
	UI.tag(frame, "-" .. Luck.bundleSaving(bundle) .. "%", colors.red).Position = UDim2.new(1, -16, 0, 8)
end

function renderers.Store()
	starterBanner(0)
	-- VIP, big and rainbow across the top (like the VIP banners in PLS DONATE).
	local vipBanner = UI.new("Frame", {
		Size = UDim2.new(1, -8, 0, 150),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = 1,
		Parent = body,
	}, {
		UI.corner(18),
		UI.stroke(nil, 4),
		UI.new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 120)),
				ColorSequenceKeypoint.new(0.3, Color3.fromRGB(255, 170, 40)),
				ColorSequenceKeypoint.new(0.6, Color3.fromRGB(190, 90, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 160, 255)),
			}),
			Rotation = 15,
		}),
	})
	UI.new("Frame", {
		Position = UDim2.fromOffset(6, 5),
		Size = UDim2.new(1, -12, 0.4, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.8,
		Parent = vipBanner,
	}, { UI.corner(14) })
	local crown = ItemPictures.view("VIP", 140)
	crown.Position = UDim2.fromOffset(10, 5)
	crown.Size = UDim2.fromOffset(150, 140)
	crown.Parent = vipBanner
	UI.label("VIP", {
		Position = UDim2.fromOffset(170, 14),
		Size = UDim2.new(1, -400, 0, 48),
		FontFace = UI.fonts.heavy,
		TextColor3 = colors.gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = vipBanner,
	}).UIStroke.Thickness =
		3
	UI.label(
		"👑 Gold VIP badge on the leaderboard and in chat\n💰 +10% coins forever\n🎡 Spin the Lucky Wheel more often",
		{
			Position = UDim2.fromOffset(172, 64),
			Size = UDim2.new(1, -400, 0, 72),
			TextScaled = false,
			TextSize = 17,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = vipBanner,
		}
	)
	local vipButton = passButton("VIP", UDim2.fromOffset(200, 52))
	vipButton.AnchorPoint = Vector2.new(1, 0.5)
	vipButton.Position = UDim2.new(1, -20, 0.5, 8)
	vipButton.Parent = vipBanner
	UI.tag(vipBanner, if GamePasses.has(player, "VIP") then "YOURS!" else "BEST!", colors.red).Position =
		UDim2.new(1, -16, 0, 8)

	-- The other passes as bright cards.
	local grid = UI.grid(220, 270)
	grid.LayoutOrder = 2
	grid.Parent = body
	local i = 0
	for _, key in GamePasses.order do
		if key ~= "VIP" then
			i += 1
			local pass = GamePasses.list[key]
			local owned = GamePasses.has(player, key)
			local card = UI.card({
				accent = pass.color,
				border = if owned then colors.money else nil,
				picture = key,
				lines = {
					{ pass.name, nil, 24 },
					{ pass.description, colors.text, 40 },
				},
				buttons = { passButton(key, UDim2.new(1, 0, 0, 40)) },
				tag = PASS_BADGES[key] and { PASS_BADGES[key], UI.OUTLINE },
			})
			card.LayoutOrder = i
			card.Parent = grid
		end
	end

	-- Egg bundles.
	for k, bundle in Luck.BUNDLES do
		bundleBanner(10 + k, bundle)
	end
end

-- Refresh the Store as soon as a purchase goes through.
player.AttributeChanged:Connect(function(name)
	if string.sub(name, 1, 5) == "Pass_" and currentWindow == "Store" then
		render()
	end
end)

--------------------------------------------------------------------------------
-- Luck: the reveal overlay (crates and the wheel) and the Luck window
--------------------------------------------------------------------------------

local revealing = false

-- A full-screen dimmed overlay with a box in the middle; returns overlay, box, close().
local function overlay()
	local shade = UI.new("TextButton", {
		Name = "Reveal",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		ZIndex = 50,
		Parent = screen,
	})
	local box = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(360, 420),
		BackgroundTransparency = 1,
		ZIndex = 51,
		Parent = shade,
	})
	return shade, box
end

-- The prize card: the Freek, its name and rarity, and a button to close.
local function prizeCard(box: Frame, title: string, freek, color: Color3, subtitle: string, close: () -> ())
	local card = UI.glass({
		Size = UDim2.fromScale(1, 1),
		ZIndex = 52,
		Parent = box,
	}, {
		UI.corner(18),
		UI.stroke(color, 3),
		UI.new("UIPadding", {
			PaddingTop = UDim.new(0, 14),
			PaddingBottom = UDim.new(0, 14),
			PaddingLeft = UDim.new(0, 14),
			PaddingRight = UDim.new(0, 14),
		}),
		UI.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
		}),
	})
	local lines = { { title, colors.gold, 26 } }
	local order = 0
	local function add(child)
		order += 1
		child.LayoutOrder = order
		child.ZIndex = 53
		child.Parent = card
	end
	for _, line in lines do
		add(UI.label(line[1], { TextColor3 = line[2], Size = UDim2.new(1, 0, 0, line[3]) }))
	end
	if freek then
		local view = UI.viewport(freek.species, freek.mutations)
		view.Size = UDim2.new(1, 0, 0, 200)
		add(view)
		add(UI.label(FreekUtil.displayName(freek), { TextColor3 = color, Size = UDim2.new(1, 0, 0, 30) }))
	end
	add(UI.label(subtitle, { TextColor3 = colors.muted, Size = UDim2.new(1, 0, 0, 40), TextWrapped = true }))
	add(UI.button("Awesome!", colors.green, close, { Size = UDim2.new(1, 0, 0, 44) }))
	-- Pop in.
	local scale = UI.new("UIScale", { Scale = 0.3, Parent = card })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()
end

local function freekPrize(box: Frame, freek, rarity: string, isNew: boolean, close)
	local color = Rarities.info[rarity].color
	local subtitle = rarity .. (if isNew then "  ·  NEW FREEK!" else "") .. "\nIt's in your barn."
	prizeCard(box, if isNew then "NEW FREEK!" else "You got...", freek, color, subtitle, close)
end

-- The Lucky Wheel spins and lands on the prize the server rolled.
local function revealWheel(result, done)
	local shade, box = overlay()
	local function close()
		shade:Destroy()
		done()
	end
	box.Size = UDim2.fromOffset(420, 460)
	local wheel = LuckyWheel.build(box, 400, { hubText = "🎡", zIndex = 52 })
	wheel.spinTo(result.slice, function()
		task.wait(0.7)
		wheel.frame:Destroy()
		box.Size = UDim2.fromOffset(360, 420)
		local slice = Luck.WHEEL[result.slice]
		if result.freek then
			freekPrize(box, result.freek, result.rarity, result.isNew, close)
		elseif result.crate then
			prizeCard(
				box,
				if slice.crate == "LegendaryMonster" then "JACKPOT!" else "You won!",
				nil,
				slice.color,
				"A " .. Luck.crateById[result.crate].name .. "!\nHatch it from the 🍀 Luck tab.",
				close
			)
		else
			prizeCard(box, "You won!", nil, colors.money, "+" .. Format.money(result.coins or 0) .. " coins!", close)
		end
	end)
end

-- Reveals queue up so two never overlap.
local revealQueue = {}
local function nextReveal()
	if revealing or #revealQueue == 0 then
		return
	end
	revealing = true
	local result = table.remove(revealQueue, 1)
	local function done()
		revealing = false
		nextReveal()
	end
	if result.kind == "wheel" then
		revealWheel(result, done)
		return
	end
	-- Eggs open with the full card-pack reveal.
	if currentWindow then
		open(currentWindow)
	end
	PackReveal.play(result, done)
end
Remotes.get("LuckResult").OnClientEvent:Connect(function(result)
	table.insert(revealQueue, result)
	nextReveal()
end)

local function spinCooldown(): number
	return if GamePasses.has(player, "VIP") then Luck.VIP_SPIN_COOLDOWN else Luck.SPIN_COOLDOWN
end

function renderers.Luck()
	-- The Lucky Wheel: a big purple-to-pink card with the wheel and a SPIN button.
	local left = (state.lastSpin or 0) + spinCooldown() - Workspace:GetServerTimeNow()
	local ready = left <= 0
	local function spin()
		if ready then
			send("SpinWheel")
		end
	end
	local wheelCard = UI.new("Frame", {
		Size = UDim2.new(1, -8, 0, 300),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = 1,
		Parent = body,
	}, {
		UI.corner(18),
		UI.stroke(nil, 4),
		UI.new("UIGradient", {
			Color = ColorSequence.new(colors.fusion, colors.fusion2),
			Rotation = 20,
		}),
	})
	UI.new("Frame", {
		Position = UDim2.fromOffset(6, 5),
		Size = UDim2.new(1, -12, 0.35, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.82,
		Parent = wheelCard,
	}, { UI.corner(14) })
	local wheelHolder = UI.new("Frame", {
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.fromOffset(280, 280),
		BackgroundTransparency = 1,
		Parent = wheelCard,
	})
	LuckyWheel.build(wheelHolder, 280, { hubText = if ready then "SPIN!" else "⏳", onHub = spin })
	UI.label("LUCKY WHEEL", {
		Position = UDim2.fromOffset(310, 22),
		Size = UDim2.new(1, -330, 0, 52),
		FontFace = UI.fonts.heavy,
		TextColor3 = colors.gold,
		Parent = wheelCard,
	}).UIStroke.Thickness =
		3
	UI.label(if ready then "Your free spin is ready!" else "Free spin every day!", {
		Position = UDim2.fromOffset(310, 80),
		Size = UDim2.new(1, -330, 0, 30),
		Parent = wheelCard,
	})
	UI.label("Win coins, Golden and Rainbow Freeks, Monster Eggs and the JACKPOT!", {
		Position = UDim2.fromOffset(310, 114),
		Size = UDim2.new(1, -330, 0, 48),
		TextScaled = false,
		TextSize = 17,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(255, 235, 255),
		Parent = wheelCard,
	})
	local spinButton = UI.button(
		if ready then "SPIN!" else "Next spin in " .. Format.time(left),
		if ready then colors.green else colors.gray,
		spin,
		{
			Position = UDim2.fromOffset(330, 190),
			Size = UDim2.new(1, -370, 0, 64),
			Parent = wheelCard,
		}
	)
	if ready then
		UI.tag(spinButton, "FREE", colors.red)
	end

	-- Monster Eggs (Robux): the only place to get the Monster line. Every chance is shown.
	UI.label("🥚 MONSTER EGGS · Freeks you can't get anywhere else", {
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = UI.fonts.heavy,
		LayoutOrder = 2,
		Parent = body,
	})
	local restricted = player:GetAttribute("CratesRestricted")
	local grid = UI.grid(250, 480)
	grid.LayoutOrder = 3
	grid.Parent = body
	for i, crate in Luck.CRATES do
		local odds = Luck.oddsList(crate)
		local lines = { { crate.name, nil, 24 } }
		for _, entry in odds do
			local species = Freeks.byId[entry.species]
			local percent = if entry.percent < 1
				then string.format("%.1f", entry.percent)
				else string.format("%.0f", entry.percent)
			table.insert(lines, {
				string.format("%s · %s  %s%%", species.name, species.rarity, percent),
				Rarities.info[species.rarity].color:Lerp(Color3.new(1, 1, 1), 0.35),
				17,
			})
		end
		local buy = function()
			if not restricted then
				send("BuyCrate", crate.id)
			end
		end
		local button
		if restricted then
			button = UI.button("Not available in your region", colors.gray, buy, { Size = UDim2.new(1, 0, 0, 40) })
		elseif crate.productId ~= 0 or (RunService:IsStudio() and Luck.STUDIO_FREE_CRATES) then
			button = UI.pricePill(
				"R$ " .. crate.robux .. (if crate.productId == 0 then " (free in Studio)" else ""),
				buy,
				{ Size = UDim2.new(1, 0, 0, 40) }
			)
		else
			button = UI.button("Coming soon", colors.gray, buy, { Size = UDim2.new(1, 0, 0, 40) })
		end
		local buttons = { button }
		local owned = state.crates and state.crates[crate.id] or 0
		if owned > 0 then
			table.insert(
				buttons,
				UI.button("HATCH YOURS (" .. owned .. ")", colors.green, function()
					send("OpenCrate", crate.id)
				end, { Size = UDim2.new(1, 0, 0, 38) })
			)
		end
		local card = UI.card({
			egg = crate.id,
			accent = crate.color,
			lines = lines,
			buttons = buttons,
			tag = if i == #Luck.CRATES then { "BEST", colors.red } else nil,
		})
		card.LayoutOrder = i
		card.Parent = grid
	end
	for k, bundle in Luck.BUNDLES do
		bundleBanner(10 + k, bundle)
	end
end

local MENU = {
	{ "Shop", "🛒", colors.green },
	{ "Luck", "🍀", Color3.fromRGB(90, 220, 120) },
	{ "Freeks", "🐷", colors.blue },
	{ "Fuse", "🧪", colors.pink },
	{ "Book", "📖", colors.orange },
	{ "Trade", "🤝", colors.purple },
	{ "Rebirth", "⭐", Color3.fromRGB(230, 170, 30) },
	{ "Store", "💎", Color3.fromRGB(40, 180, 160) },
}
for _, entry in MENU do
	TAB_ICONS[entry[1]] = entry[2]
	TAB_COLORS[entry[1]] = entry[3]
end
setActiveTab = Hud.menu(screen, MENU, open)
Hud.starterOffer(screen, function()
	if currentWindow ~= "Store" then
		open("Store")
	end
end)

--------------------------------------------------------------------------------
-- Live updates
--------------------------------------------------------------------------------

player:GetAttributeChangedSignal("Money"):Connect(function()
	if state then
		state.money = player:GetAttribute("Money") or state.money
	end
end)

Remotes.get("Notify").OnClientEvent:Connect(toast)

Remotes.get("State").OnClientEvent:Connect(function(newState)
	state = newState
	setRebirthBoost(state.rebirths or 0)
	render()
end)

Remotes.get("DiscoveryUpdate").OnClientEvent:Connect(function(speciesId, discovery)
	discoveries[speciesId] = discovery
	if currentWindow == "Book" then
		render()
	end
end)

Remotes.get("Trade").OnClientEvent:Connect(function(kind, payload)
	if kind == "Request" then
		pendingRequest = payload
		requestLabel.Text = payload.name .. " wants to trade!"
		requestPopup.Visible = true
		task.delay(30, function()
			if pendingRequest == payload then
				pendingRequest = nil
				requestPopup.Visible = false
			end
		end)
	elseif kind == "State" then
		local isNew = trade == nil
		trade = payload
		if isNew and currentWindow ~= "Trade" then
			open("Trade")
		elseif currentWindow == "Trade" then
			render()
		end
	elseif kind == "Closed" then
		trade = nil
		toast(payload, if string.find(payload, "complete") then "success" else "error")
		if currentWindow == "Trade" then
			render()
		end
	end
end)

-- Refresh the player list while the Trade window is open with no trade going.
local function refreshTradeList()
	if currentWindow == "Trade" and not trade then
		render()
	end
end
Players.PlayerAdded:Connect(refreshTradeList)
Players.PlayerRemoving:Connect(function()
	task.defer(refreshTradeList)
end)

-- Trade countdown.
task.spawn(function()
	while true do
		task.wait(0.25)
		if tradeStatusLabel then
			tradeStatusLabel.Text = tradeStatus()
		end
	end
end)

Hud.gateStatus(screen)

-- Nobody needs a Steal prompt on their own Freeks, a Snatch prompt on the Freek they're
-- carrying, or the padlock on someone else's gate.
local function hideOwnPrompt(instance: Instance)
	if not instance:IsA("ProximityPrompt") then
		return
	end
	if
		(instance.Name == "StealPrompt" and instance:GetAttribute("OwnerUserId") == player.UserId)
		or (instance.Name == "SnatchPrompt" and instance:GetAttribute("CarrierUserId") == player.UserId)
	then
		instance.Enabled = false
	elseif instance.Name == "LockPrompt" then
		instance.Enabled = instance:GetAttribute("PlotIndex") == player:GetAttribute("Plot")
	end
end
for _, descendant in Workspace:GetDescendants() do
	hideOwnPrompt(descendant)
end
Workspace.DescendantAdded:Connect(hideOwnPrompt)
player:GetAttributeChangedSignal("Plot"):Connect(function()
	for _, descendant in Workspace:GetDescendants() do
		hideOwnPrompt(descendant)
	end
end)

-- Cannon Freeks only move on clients, so the server can't use Roblox's own prompt range
-- check for them; grabbing goes through an action the server checks itself.
ProximityPromptService.PromptTriggered:Connect(function(prompt)
	if prompt.Name == "GrabPrompt" then
		send("GrabDrop", prompt:GetAttribute("ItemId"))
	end
end)

-- Weapons: when an equipped weapon is used, tell the server where we're aiming.
local mouse = player:GetMouse()
local function watchTool(child: Instance)
	if child:IsA("Tool") and child:GetAttribute("WeaponId") and not child:GetAttribute("Hooked") then
		child:SetAttribute("Hooked", true)
		child.Activated:Connect(function()
			send("UseWeapon", child:GetAttribute("WeaponId"), mouse.Hit.Position)
		end)
	end
end
local function watchCharacter(character: Model)
	for _, child in character:GetChildren() do
		watchTool(child)
	end
	character.ChildAdded:Connect(watchTool)
end
player.CharacterAdded:Connect(watchCharacter)
if player.Character then
	watchCharacter(player.Character)
end

-- Getting hit: pushed away and knocked over for a moment.
Remotes.get("Knockback").OnClientEvent:Connect(function(direction: Vector3, strength: number, seconds: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		return
	end
	humanoid.PlatformStand = true
	root.AssemblyLinearVelocity = direction * strength + Vector3.new(0, strength * 0.5, 0)
	task.delay(seconds, function()
		if humanoid.Parent then
			humanoid.PlatformStand = false
		end
	end)
end)

-- Breed countdowns.
task.spawn(function()
	while true do
		task.wait(0.5)
		for _, pen in penCountdowns do
			local left = pen.endsAt - Workspace:GetServerTimeNow()
			if left > 0 then
				pen.label.Text = "Fusing... " .. Format.time(left)
				pen.button.BackgroundColor3 = colors.gray
				pen.button.Text = "Not ready yet"
			else
				pen.label.Text = "Fusion complete!"
				pen.button.BackgroundColor3 = colors.pink
				pen.button.Text = "Collect!"
			end
		end
	end
end)

-- Cannon Freeks: fly each one out of its cannon, then let it wander the town square and
-- walk into the Freek House, all worked out locally from its seed and launch time (smooth,
-- and matches where the server thinks it is).
local dropFolder = Workspace:WaitForChild("DropFreeks")
local paths = {} -- [Model] = path; cleared when the model goes
dropFolder.ChildRemoved:Connect(function(model)
	paths[model] = nil
end)

-- A puff of smoke that grows and fades (cannon shots and landings).
local function puff(position: Vector3, size: number, color: Color3)
	for i = 1, 5 do
		local ball = Instance.new("Part")
		ball.Shape = Enum.PartType.Ball
		ball.Anchored = true
		ball.CanCollide = false
		ball.CanQuery = false
		ball.CastShadow = false
		ball.Material = Enum.Material.SmoothPlastic
		ball.Color = color
		ball.Transparency = 0.2
		ball.Size = Vector3.one * size * 0.4
		ball.Position = position + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * size
		ball.Parent = Workspace
		local grow = TweenInfo.new(0.6 + i * 0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(ball, grow, { Size = Vector3.one * size * 1.4, Transparency = 1 }):Play()
		task.delay(1.2, ball.Destroy, ball)
	end
end

-- What Freeks stand on: the ground itself (terrain, the town square floor and the
-- walkways), never lamps, trees, players or other Freeks.
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
local groundList = { Workspace.Terrain }
local scenery = Workspace:WaitForChild("Scenery")
for _, part in scenery:GetDescendants() do
	if part:IsA("BasePart") and (part.Name == "TownSquare" or part.Name == "Walkway" or part.Name == "Curb") then
		table.insert(groundList, part)
	end
end
groundParams.FilterDescendantsInstances = groundList

-- Height of the ground at a spot (nil if there's nothing below).
local function groundAt(position: Vector3): number?
	local hit = Workspace:Raycast(position + Vector3.new(0, 12, 0), Vector3.new(0, -40, 0), groundParams)
	return hit and hit.Position.Y
end

RunService.RenderStepped:Connect(function()
	local now = Workspace:GetServerTimeNow()
	for _, model in dropFolder:GetChildren() do
		if not model:IsA("Model") or not model.PrimaryPart then
			continue -- not streamed in yet
		end
		local path = paths[model]
		if not path then
			local seed, cannon, launch =
				model:GetAttribute("Seed"), model:GetAttribute("Cannon"), model:GetAttribute("Launch")
			if not (seed and cannon and launch) then
				continue
			end
			path = Drops.plan(seed, cannon, launch)
			path.landed = now >= path.land
			-- The server keeps the model at the muzzle; parts that arrive late start there.
			path.rig = FreekAnimator.rig(model, seed, CFrame.new(path.muzzle))
			paths[model] = path
		end
		local cframe, doing, moving = Drops.cframeAt(path, now)
		local onFoot = doing == "wandering" or doing == "leaving"
		if onFoot then
			-- Stand on whatever the ground really is right there.
			local groundY = groundAt(cframe.Position)
			if groundY then
				cframe = cframe + Vector3.new(0, groundY - cframe.Position.Y, 0)
			end
			if not path.landed then
				path.landed = true
				puff(cframe.Position + Vector3.new(0, 1, 0), 3, Color3.fromRGB(225, 210, 180))
			end
		end
		if onFoot and path.rig then
			-- Walking with its own gait, or idling (blinking, looking around) when it stops.
			FreekAnimator.pose(path.rig, cframe, now, moving)
		elseif path.rig then
			FreekAnimator.place(path.rig, cframe)
		else
			model:PivotTo(cframe)
		end

		local prompt = model:FindFirstChild("GrabPrompt", true)
		if prompt then
			prompt.Enabled = doing == "wandering" or doing == "leaving"
		end
	end
end)

-- Cannons go boom: smoke at the muzzle when the server fires one.
local cannonsFolder = Workspace:WaitForChild("Cannons")
for index = 1, Drops.CANNON_COUNT do
	local cannon = cannonsFolder:WaitForChild("Cannon" .. index)
	cannon:GetAttributeChangedSignal("FiredAt"):Connect(function()
		local wait = (cannon:GetAttribute("FiredAt") or 0) - Workspace:GetServerTimeNow()
		task.delay(math.max(wait, 0), function()
			local muzzle = Drops.muzzle(index)
			puff(muzzle, 6, Color3.fromRGB(200, 200, 205))
			local flash = Instance.new("PointLight")
			flash.Brightness = 6
			flash.Range = 40
			flash.Color = Color3.fromRGB(255, 200, 120)
			flash.Parent = cannon.PrimaryPart
			task.delay(0.15, flash.Destroy, flash)
		end)
	end)
end

-- Yard Freeks are alive: they breathe, blink, look around, wag, twitch their ears, wave
-- and hop (see FreekAnimator). Only nearby ones are animated. They always move relative to
-- the "Ground" the server set, so they can't drift.
local plotsFolder = Workspace:WaitForChild("Plots")
local yardRigs = setmetatable({}, { __mode = "k" })
RunService.RenderStepped:Connect(function()
	local camera = Workspace.CurrentCamera
	local eye = camera and camera.CFrame.Position or Vector3.zero
	local t = os.clock()
	for _, plot in plotsFolder:GetChildren() do
		local freeks = plot:FindFirstChild("Freeks")
		if freeks then
			for _, model in freeks:GetChildren() do
				local ground = model:IsA("Model") and model.PrimaryPart and model:GetAttribute("Ground")
				if typeof(ground) == "CFrame" and (ground.Position - eye).Magnitude < 140 then
					local rig = yardRigs[model]
					if rig == nil then
						-- Rig it from where it rests, so the pose is always relative to the ground.
						model:PivotTo(ground)
						rig = FreekAnimator.rig(model, nil, ground) or false
						yardRigs[model] = rig
					end
					if rig then
						FreekAnimator.pose(rig, ground, t)
					end
				end
			end
		end
	end
end)

Ambient.start()
BarnFX.start()

-- Rainbow Freeks cycle through colors.
RunService.RenderStepped:Connect(function()
	local color = Color3.fromHSV((os.clock() * 0.25) % 1, 0.75, 1)
	for _, part in CollectionService:GetTagged(FreekModel.RAINBOW_TAG) do
		part.Color = color
	end
end)

-- The Monster Eggs on the egg stand turn slowly and bob up and down.
RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for i, egg in CollectionService:GetTagged("DisplayEgg") do
		local rest = egg:GetAttribute("Rest")
		if egg:IsA("Model") and egg.PrimaryPart and typeof(rest) == "CFrame" then
			local phase = i * 1.7
			egg:PivotTo(
				rest * CFrame.new(0, 0.35 + math.sin(t * 2 + phase) * 0.35, 0) * CFrame.Angles(0, t * 0.8 + phase, 0)
			)
		end
	end
end)

task.spawn(function()
	discoveries = Remotes.get("GetDiscoveries"):InvokeServer() or {}
	render()
end)
print("[Fuse a Freek] Client UI built, loading your data...")
state = Remotes.get("GetState"):InvokeServer()
print("[Fuse a Freek] Client ready")
clientReady = true
if state then
	setRebirthBoost(state.rebirths or 0)
end
render()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">PackReveal</string>
            <string name="Source"><![CDATA[-- Monster Egg opening, done like a card-pack reveal in the big sports games, in 3D.
-- The camera cuts to a dark arena (built on this client only, high above the map): the
-- egg drops onto a glowing pedestal under sweeping spotlights, shakes, and bursts into a
-- face-down card. Then the clues slam onto the screen one at a time (first the Freek's
-- SERIES, then its RARITY, with every light in the arena turning that colour) before the
-- card flips over in 3D and the Freek walks out in front of it with its name.
-- The rarer the Freek, the longer the suspense and the wilder the lights.
-- Tapping the screen speeds it up.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local EggModel = require(ReplicatedStorage.Shared.EggModel)
local FreekAnimator = require(ReplicatedStorage.Shared.FreekAnimator)
local FreekModel = require(ReplicatedStorage.Shared.FreekModel)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Freeks = require(ReplicatedStorage.Shared.Freeks)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local UI = require(script.Parent.UI)

local PackReveal = {}

local STAGE = CFrame.new(0, 3000, 0) -- far above the map, out of everyone's way
local CARD_SIZE = Vector3.new(6, 8.4, 0.35)
local CARD_HOME = Vector3.new(0, 7.2, 0) -- where the card floats, above the pedestal
local PEDESTAL_TOP = 1.6
local DARK = Color3.fromRGB(14, 12, 28)
local GOLD = Color3.fromRGB(255, 205, 70)

local RARITY_WORDS = {
	Common = "COMMON",
	Uncommon = "UNCOMMON",
	Rare = "RARE!",
	Legendary = "LEGENDARY!",
	Mystic = "MYSTIC!!",
	Ultra = "ULTRA!!!",
	Secret = "SECRET!!!",
}

local function easeOut(a: number): number
	return 1 - (1 - a) ^ 3
end

local function easeInOut(a: number): number
	return a * a * (3 - 2 * a)
end

local function rainbow(t: number, offset: number?): Color3
	return Color3.fromHSV((t * 0.5 + (offset or 0)) % 1, 0.75, 1)
end

local function at(x: number, y: number, z: number): CFrame
	return STAGE * CFrame.new(x, y, z)
end

local function newPart(parent: Instance, props)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "ClassName" then
			p[key] = value
		end
	end
	p.Parent = parent
	return p
end

-- Text on one face of a part.
local function faceText(
	part: BasePart,
	face: Enum.NormalId,
	text: string,
	color: Color3,
	position: UDim2,
	size: UDim2,
	heavy: boolean?
)
	local gui = part:FindFirstChild("Face" .. face.Name)
	if not gui then
		gui = Instance.new("SurfaceGui")
		gui.Name = "Face" .. face.Name
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 50
		gui.LightInfluence = 0
		gui.Parent = part
	end
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = position
	label.Size = size
	label.TextScaled = true
	label.Font = if heavy then Enum.Font.LuckiestGuy else Enum.Font.FredokaOne
	label.Text = text
	label.TextColor3 = color
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = UI.OUTLINE
	stroke.Thickness = 4
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	return label
end

-- The back of the card: a monster card that feels alive. Dark chrome with scanlines, a
-- silver-and-gold frame with curved horns out of the top corners, violet energy cracks
-- flickering out from a big glowing dragon eye that looks around and blinks, a ring of
-- runes turning round it, a chrome nameplate, and a holographic glint sweeping across.
-- Built round the card's centre (the back faces -Z). Returns animate(t), which moves the
-- living parts; call it every frame after the card is placed.
local function buildCardBack(card: Model, body: BasePart): (number) -> ()
	local half = Vector2.new(CARD_SIZE.X / 2, CARD_SIZE.Y / 2)
	local z0 = -CARD_SIZE.Z / 2
	local eye = Vector2.new(0, 0.55)
	local violet = Color3.fromRGB(175, 90, 255)
	local cyan = Color3.fromRGB(90, 235, 255)
	local chrome = Color3.fromRGB(200, 205, 220)
	local random = Random.new(7)
	local function flat(
		name: string,
		size: Vector3,
		x: number,
		y: number,
		z: number,
		color: Color3,
		material,
		angle: number?
	)
		return newPart(card, {
			Name = name,
			Size = size,
			CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, 0, angle or 0),
			Color = color,
			Material = material or Enum.Material.SmoothPlastic,
		})
	end
	local function ellipsoid(name: string, size: Vector3, x: number, y: number, z: number, color: Color3, material)
		local part = flat(name, size, x, y, z, color, material)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
		return part
	end
	local function disc(name: string, diameter: number, depth: number, z: number, color: Color3, material)
		return newPart(card, {
			Name = name,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(depth, diameter, diameter),
			CFrame = CFrame.new(eye.X, eye.Y, z) * CFrame.Angles(0, math.pi / 2, 0),
			Color = color,
			Material = material or Enum.Material.SmoothPlastic,
		})
	end

	-- Dark chrome with faint scanlines.
	body.Color = Color3.fromRGB(16, 12, 30)
	body.Material = Enum.Material.Metal
	for k = 0, 15 do
		flat(
			"Scanline",
			Vector3.new(CARD_SIZE.X - 1, 0.07, 0.02),
			0,
			-half.Y + 0.6 + k * 0.48,
			z0 - 0.01,
			Color3.fromRGB(34, 24, 62)
		)
	end

	-- Energy cracks: jagged violet lines from the eye out towards the edges.
	local cracks = {}
	for k = 0, 7 do
		local angle = k / 8 * math.pi * 2 + 0.3
		local point = eye + Vector2.new(math.cos(angle), math.sin(angle)) * 2.3
		for _ = 1, 3 do
			local turn = angle + random:NextNumber(-0.6, 0.6)
			local step = random:NextNumber(0.6, 1.1)
			local nextPoint = point + Vector2.new(math.cos(turn), math.sin(turn)) * step
			if math.abs(nextPoint.X) > half.X - 0.7 or math.abs(nextPoint.Y) > half.Y - 0.7 then
				break
			end
			local mid = (point + nextPoint) / 2
			local dir = nextPoint - point
			table.insert(
				cracks,
				flat(
					"Crack",
					Vector3.new(dir.Magnitude + 0.12, 0.15, 0.03),
					mid.X,
					mid.Y,
					z0 - 0.03,
					violet,
					Enum.Material.Neon,
					math.atan2(dir.Y, dir.X)
				)
			)
			point = nextPoint
		end
	end

	-- Frame: chrome bevel with a thin gold line inside it.
	for _, inset in { { 0.32, 0.22, chrome, Enum.Material.Foil, 0.08 }, { 0.6, 0.08, GOLD, Enum.Material.Neon, 0.06 } } do
		local d, w = inset[1], inset[2]
		for _, bar in
			{
				{ Vector3.new(CARD_SIZE.X - d * 2, w, inset[5]), Vector3.new(0, half.Y - d, 0) },
				{ Vector3.new(CARD_SIZE.X - d * 2, w, inset[5]), Vector3.new(0, -half.Y + d, 0) },
				{ Vector3.new(w, CARD_SIZE.Y - d * 2, inset[5]), Vector3.new(half.X - d, 0, 0) },
				{ Vector3.new(w, CARD_SIZE.Y - d * 2, inset[5]), Vector3.new(-half.X + d, 0, 0) },
			}
		do
			flat("Frame", bar[1], bar[2].X, bar[2].Y, z0 - 0.05, inset[3], inset[4])
		end
	end
	-- Horns curling up and out of the top corners: thick dark purple at the root, tapering
	-- to a glowing gold tip. Each is a chain of tapered cylinders with balls at the joints.
	for _, side in { -1, 1 } do
		local points = {}
		for k = 0, 8 do
			local f = k / 8
			local angle = math.rad(25 + 70 * f) -- sweeps from out-and-up to straight up
			table.insert(
				points,
				Vector2.new(
					side * (half.X - 0.55 + math.cos(angle) * 1.6 * f),
					half.Y - 0.35 + math.sin(angle) * 2.1 * f
				)
			)
		end
		for k = 1, #points - 1 do
			local f = (k - 1) / (#points - 1)
			local a0, a1 = points[k], points[k + 1]
			local width = 0.95 - 0.8 * f
			local color = Color3.fromRGB(55, 22, 90):Lerp(Color3.fromRGB(170, 100, 230), f)
			local dir = a1 - a0
			newPart(card, {
				Name = "Horn",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(dir.Magnitude + width * 0.3, width, width),
				CFrame = CFrame.new((a0.X + a1.X) / 2, (a0.Y + a1.Y) / 2, z0 + 0.05)
					* CFrame.Angles(0, 0, math.atan2(dir.Y, dir.X)),
				Color = color,
			})
			newPart(card, {
				Name = "Horn",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * width,
				CFrame = CFrame.new(a0.X, a0.Y, z0 + 0.05),
				Color = color,
			})
		end
		local tip = points[#points]
		newPart(card, {
			Name = "HornTip",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.3,
			CFrame = CFrame.new(tip.X, tip.Y, z0 + 0.05),
			Color = GOLD,
			Material = Enum.Material.Neon,
		})
	end

	-- The eye: a glowing socket, an amber eyeball, a green iris with a slit pupil, and lids.
	disc("SocketGlow", 4.3, 0.06, z0 - 0.04, violet, Enum.Material.Neon).Transparency = 0.35
	disc("SocketRing", 3.9, 0.2, z0 - 0.12, chrome, Enum.Material.Foil)
	disc("Socket", 3.5, 0.24, z0 - 0.16, Color3.fromRGB(10, 6, 20))
	local eyeball = ellipsoid(
		"Eyeball",
		Vector3.new(3.0, 2.1, 0.9),
		eye.X,
		eye.Y,
		z0 - 0.3,
		Color3.fromRGB(255, 160, 40),
		Enum.Material.Neon
	)
	local iris = ellipsoid("Iris", Vector3.new(1.55, 1.55, 0.35), eye.X, eye.Y, z0 - 0.82, Color3.fromRGB(110, 240, 90))
	local irisRing =
		ellipsoid("IrisRing", Vector3.new(1.75, 1.75, 0.3), eye.X, eye.Y, z0 - 0.8, Color3.fromRGB(30, 90, 30))
	local pupil = flat("Pupil", Vector3.new(0.3, 1.3, 0.1), eye.X, eye.Y, z0 - 1.0, Color3.fromRGB(8, 6, 14))
	local glint = newPart(card, {
		Name = "Glint",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.3,
		CFrame = CFrame.new(eye.X - 0.35, eye.Y + 0.4, z0 - 1.05),
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.Neon,
	})
	-- An angry brow over the eye.
	for _, side in { -1, 1 } do
		flat(
			"Brow",
			Vector3.new(1.7, 0.32, 0.25),
			eye.X + side * 0.85,
			eye.Y + 1.45,
			z0 - 0.35,
			Color3.fromRGB(60, 24, 100),
			nil,
			math.rad(side * -14)
		)
	end

	-- Runes circling the eye.
	local runes = {}
	for k = 1, 12 do
		table.insert(
			runes,
			newPart(card, {
				Name = "Rune",
				Size = if k % 3 == 0 then Vector3.new(0.34, 0.34, 0.05) else Vector3.new(0.12, 0.34, 0.05),
				Color = cyan,
				Material = Enum.Material.Neon,
			})
		)
	end

	-- Title and nameplate.
	local title = flat("BackTitle", Vector3.new(4.2, 0.5, 0.02), 0, half.Y - 1.05, z0 - 0.05, Color3.new(), nil)
	title.Transparency = 1
	faceText(title, Enum.NormalId.Front, "✦ FREEK CARD ✦", cyan, UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), true)
	local plate = flat("Nameplate", Vector3.new(4.6, 1, 0.16), 0, -half.Y + 1.3, z0 - 0.1, chrome, Enum.Material.Foil)
	flat("NameplateInset", Vector3.new(4.3, 0.75, 0.04), 0, -half.Y + 1.3, z0 - 0.19, Color3.fromRGB(24, 14, 44))
	local plateText = flat("NameplateText", Vector3.new(4.2, 0.7, 0.02), 0, -half.Y + 1.3, z0 - 0.22, Color3.new(), nil)
	plateText.Transparency = 1
	faceText(
		plateText,
		Enum.NormalId.Front,
		"FUSE A FREEK",
		GOLD,
		UDim2.fromScale(0.03, 0.05),
		UDim2.fromScale(0.94, 0.9),
		true
	)
	for _, side in { -1, 1 } do
		newPart(card, {
			Name = "PlateBolt",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.22,
			CFrame = CFrame.new(side * 2.1, plate.Position.Y, z0 - 0.2),
			Color = violet,
			Material = Enum.Material.Neon,
		})
	end

	-- The holographic glint.
	local shine = newPart(card, {
		Name = "Shine",
		Size = Vector3.new(0.3, CARD_SIZE.Y - 1.4, 0.02),
		CFrame = CFrame.new(0, 0, z0 - 1.2),
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.Neon,
		Transparency = 1,
		CastShadow = false,
	})

	local flicker = Random.new()
	return function(t: number)
		local base = body.CFrame
		local function put(part: BasePart, x: number, y: number, z: number, angle: number?)
			part.CFrame = base * CFrame.new(x, y, z) * CFrame.Angles(0, 0, angle or 0)
		end
		-- The eye looks around, darting now and then.
		local look = Vector2.new(math.sin(t * 0.8) * 0.45 + math.sin(t * 3.1) * 0.08, math.sin(t * 1.3) * 0.2)
		-- A blink every few seconds: the eye squints shut and opens again.
		local phase = (t % 3.4) / 0.28
		local open = 1 - (if phase < 1 then math.sin(phase * math.pi) else 0) * 0.92
		eyeball.Size = Vector3.new(3.0, 2.1 * open, 0.9)
		iris.Size = Vector3.new(1.55, 1.55 * open, 0.35)
		irisRing.Size = Vector3.new(1.75, 1.75 * open, 0.3)
		pupil.Size = Vector3.new(0.3, 1.3 * open, 0.1)
		glint.Transparency = if open < 0.5 then 1 else 0
		local lookY = look.Y * open
		put(eyeball, eye.X, eye.Y, z0 - 0.3)
		put(irisRing, eye.X + look.X, eye.Y + lookY, z0 - 0.62)
		put(iris, eye.X + look.X, eye.Y + lookY, z0 - 0.66)
		put(pupil, eye.X + look.X, eye.Y + lookY, z0 - 0.84)
		put(glint, eye.X + look.X - 0.35, eye.Y + lookY + 0.4, z0 - 0.9)
		-- The runes turn round the eye.
		for k, rune in runes do
			local angle = k / #runes * math.pi * 2 + t * 0.6
			put(rune, eye.X + math.cos(angle) * 2.3, eye.Y + math.sin(angle) * 2.3, z0 - 0.09, angle)
		end
		-- The cracks crackle.
		for _, crack in cracks do
			crack.Transparency = if flicker:NextNumber() < 0.15 then 0.6 else 0
		end
		-- The glint sweeps across every couple of seconds.
		local x = ((t * 0.9) % 2.2 - 1.1) * CARD_SIZE.X
		local inside = math.abs(x) < half.X - 1.6
		put(shine, x, 0, z0 - 1.2, math.rad(20))
		shine.Transparency = if inside then 0.78 + 0.2 * (math.abs(x) / (half.X - 1.6)) ^ 2 else 1
	end
end

-- Hides the rest of the HUD while the reveal plays; returns a function that brings it back.
local function hideHud(playerGui: Instance, keep: Instance): () -> ()
	local hidden = {}
	for _, gui in playerGui:GetChildren() do
		if gui:IsA("ScreenGui") and gui ~= keep and gui.Enabled then
			gui.Enabled = false
			table.insert(hidden, gui)
		end
	end
	return function()
		for _, gui in hidden do
			gui.Enabled = true
		end
	end
end

-- result = { crate, rarity, isNew, freek = { species, mutations } }
function PackReveal.play(result, done: () -> ())
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local species = Freeks.byId[result.freek.species]
	local rarity = result.rarity
	local tier = Rarities.rank[rarity] or 1
	local rarityColor = Rarities.info[rarity] and Rarities.info[rarity].color or Color3.new(1, 1, 1)
	local series = Freeks.SERIES[species and species.series or "Animal"] or Freeks.SERIES.Animal
	local random = Random.new()

	----------------------------------------------------------------------------
	-- The arena
	----------------------------------------------------------------------------
	local stage = Instance.new("Folder")
	stage.Name = "PackStage"
	stage.Parent = Workspace

	-- A dark room so nothing else shows: floor, walls and ceiling.
	newPart(stage, {
		Name = "Floor",
		Size = Vector3.new(110, 1, 110),
		CFrame = at(0, -0.5, 0),
		Color = Color3.fromRGB(22, 20, 40),
		Reflectance = 0.15,
	})
	for _, wall in
		{
			{ Vector3.new(110, 60, 1), Vector3.new(0, 30, 55) },
			{ Vector3.new(110, 60, 1), Vector3.new(0, 30, -55) },
			{ Vector3.new(1, 60, 110), Vector3.new(55, 30, 0) },
			{ Vector3.new(1, 60, 110), Vector3.new(-55, 30, 0) },
			{ Vector3.new(110, 1, 110), Vector3.new(0, 60, 0) },
		}
	do
		newPart(stage, { Name = "Wall", Size = wall[1], CFrame = at(wall[2].X, wall[2].Y, wall[2].Z), Color = DARK })
	end

	-- Everything that changes colour with the clues.
	local lit = {} -- { part = BasePart, offset = number }
	local function litPart(props, offset: number?)
		local p = newPart(stage, props)
		table.insert(lit, { part = p, offset = offset or 0 })
		return p
	end

	-- Rings of light on the floor.
	for r, radius in { 9, 15, 22 } do
		local count = 20 + r * 8
		for k = 1, count do
			local angle = k / count * math.pi * 2
			local p0 = Vector3.new(math.cos(angle) * radius, 0.05, math.sin(angle) * radius)
			local p1 = Vector3.new(
				math.cos(angle + math.pi * 2 / count) * radius,
				0.05,
				math.sin(angle + math.pi * 2 / count) * radius
			)
			litPart({
				Name = "FloorRing",
				Size = Vector3.new(0.45, 0.1, (p1 - p0).Magnitude * 0.7),
				CFrame = STAGE * CFrame.lookAt((p0 + p1) / 2, p1),
				Material = Enum.Material.Neon,
				Transparency = 0.15 * r,
			}, k / count)
		end
	end

	-- The pedestal.
	newPart(stage, {
		Name = "Pedestal",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(PEDESTAL_TOP, 8, 8),
		CFrame = at(0, PEDESTAL_TOP / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(40, 38, 60),
		Material = Enum.Material.Metal,
	})
	local rim = litPart({
		Name = "PedestalRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.25, 8.5, 8.5),
		CFrame = at(0, PEDESTAL_TOP - 0.1, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Material = Enum.Material.Neon,
	})
	local light = Instance.new("PointLight")
	light.Range = 34
	light.Brightness = 2
	light.Shadows = false
	light.Parent = rim

	-- Stage spotlights: lamps on a ring above the stage, each throwing a soft cone of light
	-- (a bright core inside a wide glow, fading towards the floor) that sweeps round the
	-- pedestal, with a real spotlight and a glowing pool where it lands.
	local RIG_HEIGHT, RIG_RADIUS = 30, 19
	newPart(stage, {
		Name = "LightRig",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, RIG_RADIUS * 2 + 2, RIG_RADIUS * 2 + 2),
		CFrame = at(0, RIG_HEIGHT + 1.2, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(30, 30, 40),
		Material = Enum.Material.Metal,
		Transparency = 0,
	})
	local function coneBeam(a0: Attachment, a1: Attachment, width0: number, width1: number, near: number, far: number)
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = width0
		beam.Width1 = width1
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Segments = 12
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, near),
			NumberSequenceKeypoint.new(0.7, (near + far) / 2 + 0.05),
			NumberSequenceKeypoint.new(1, far),
		})
		beam.Parent = a0.Parent
		return beam
	end
	local beams = {}
	for k = 1, 8 do
		local angle = k / 8 * math.pi * 2
		local lampAt = Vector3.new(math.cos(angle) * RIG_RADIUS, RIG_HEIGHT, math.sin(angle) * RIG_RADIUS)
		newPart(stage, {
			Name = "Lamp",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(2.2, 1.8, 1.8),
			CFrame = at(lampAt.X, lampAt.Y, lampAt.Z),
			Color = Color3.fromRGB(35, 35, 45),
			Material = Enum.Material.Metal,
		})
		local lens = litPart({
			Name = "LampLens",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 1.3,
			CFrame = at(lampAt.X, lampAt.Y - 0.9, lampAt.Z),
			Material = Enum.Material.Neon,
		}, k / 8)
		local pool = litPart({
			Name = "LightPool",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, 5, 5),
			Material = Enum.Material.Neon,
			Transparency = 0.8,
			CastShadow = false,
		}, k / 8)
		local from = Instance.new("Attachment")
		from.Parent = lens
		local to = Instance.new("Attachment")
		to.Parent = pool
		local core = coneBeam(from, to, 0.8, 3.2, 0.45, 0.85)
		local halo = coneBeam(from, to, 2.2, 9, 0.82, 0.97)
		local spot = Instance.new("SpotLight")
		spot.Angle = 30
		spot.Range = 45
		spot.Brightness = 3
		spot.Shadows = false
		spot.Face = Enum.NormalId.Front
		spot.Parent = lens
		table.insert(
			beams,
			{ lens = lens, pool = pool, spot = spot, core = core, halo = halo, top = lampAt, angle = angle }
		)
	end

	----------------------------------------------------------------------------
	-- The 2D overlay: clue words, flashes, the name and the button
	----------------------------------------------------------------------------
	local gui = UI.new("ScreenGui", {
		Name = "PackReveal",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 50,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	local showHud = hideHud(playerGui, gui)
	local overlay = UI.new("TextButton", {
		Name = "Overlay",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})
	local speed = 1
	overlay.Activated:Connect(function()
		speed = 4 -- tap to hurry it along
	end)

	local function flash(color: Color3, duration: number)
		local frame = UI.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = color,
			BackgroundTransparency = 0,
			ZIndex = 40,
			Parent = gui,
		})
		task.spawn(function()
			local began = os.clock()
			while os.clock() - began < duration do
				frame.BackgroundTransparency = (os.clock() - began) / duration
				task.wait()
			end
			frame:Destroy()
		end)
	end

	local captionLabel = UI.label("", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.09),
		Size = UDim2.fromOffset(500, 34),
		FontFace = UI.fonts.heavy,
		TextColor3 = Color3.fromRGB(230, 230, 255),
		TextTransparency = 1,
		ZIndex = 20,
		Parent = overlay,
	})
	captionLabel:FindFirstChildOfClass("UIStroke").Transparency = 1
	local clueLabel = UI.label("", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.18),
		Size = UDim2.fromOffset(900, 100),
		FontFace = UI.fonts.heavy,
		TextTransparency = 1,
		ZIndex = 20,
		Parent = overlay,
	})
	local clueStroke = clueLabel:FindFirstChildOfClass("UIStroke")
	clueStroke.Thickness = 5
	clueStroke.Transparency = 1
	local clueScale = UI.new("UIScale", { Parent = clueLabel })
	local clueGradient = UI.new("UIGradient", { Enabled = false, Parent = clueLabel })

	----------------------------------------------------------------------------
	-- Animation state, updated every frame
	----------------------------------------------------------------------------
	local camera = Workspace.CurrentCamera
	local oldCameraType = camera.CameraType
	camera.CameraType = Enum.CameraType.Scriptable
	local oldFov = camera.FieldOfView
	camera.FieldOfView = 55
	local controls: any = nil
	pcall(function()
		local module = require(player.PlayerScripts:WaitForChild("PlayerModule", 1) :: any)
		controls = module:GetControls()
		controls:Disable()
	end)

	local state = {
		color = Color3.fromRGB(200, 200, 230),
		brightness = 0.4, -- 0..1, how strongly the arena lights glow
		sweep = 0.3, -- how fast the beams sweep (radians per second)
		rainbow = false,
		shake = 0,
		camFrom = at(0, 16, -46),
		camTo = at(0, 16, -46),
		camBlend = 1,
		lookAt = at(0, 4, 0).Position,
	}
	local function moveCamera(position: Vector3, look: Vector3)
		state.camFrom = camera.CFrame
		state.camTo = CFrame.lookAt((STAGE * CFrame.new(position)).Position, (STAGE * CFrame.new(look)).Position)
		state.camBlend = 0
	end

	local clock = os.clock()
	local sweepAngle = 0
	local camTime = 0.8
	local function tick(dt: number)
		local now = os.clock()
		sweepAngle += state.sweep * dt
		for i, beam in beams do
			-- Each lamp swings its beam round the pedestal.
			local swing = beam.angle + sweepAngle + math.sin(sweepAngle * 2 + i) * 0.4
			local target = Vector3.new(math.cos(swing) * 8, 0.05, math.sin(swing) * 8)
			beam.lens.CFrame = STAGE * CFrame.lookAt(beam.top - Vector3.new(0, 0.9, 0), target)
			beam.pool.CFrame = STAGE * CFrame.new(target) * CFrame.Angles(0, 0, math.pi / 2)
			local color = if state.rainbow then rainbow(now, i / #beams) else state.color
			beam.core.Color = ColorSequence.new(color)
			beam.halo.Color = ColorSequence.new(color)
			beam.spot.Color = color
			beam.spot.Brightness = 1 + 4 * state.brightness
			beam.core.Brightness = 0.6 + 1.4 * state.brightness
			beam.halo.Brightness = beam.core.Brightness
			beam.pool.Transparency = 0.95 - 0.07 * state.brightness
		end
		for _, entry in lit do
			entry.part.Color = if state.rainbow then rainbow(now, entry.offset) else state.color
		end
		light.Color = if state.rainbow then rainbow(now) else state.color
		light.Brightness = 1 + 4 * state.brightness
		-- Camera: glide towards its target, then shake on impacts.
		state.camBlend = math.min(state.camBlend + dt / camTime, 1)
		local cf = state.camFrom:Lerp(state.camTo, easeInOut(state.camBlend))
		if state.shake > 0.01 then
			cf *= CFrame.new(random:NextNumber(-1, 1) * state.shake, random:NextNumber(-1, 1) * state.shake, 0)
			state.shake *= math.exp(-dt * 7)
		end
		camera.CFrame = cf
	end

	-- Runs fn(alpha, t) every frame for `duration` seconds (shorter when sped up).
	local function animate(duration: number, fn: ((number, number) -> ())?)
		local elapsed = 0
		while true do
			local now = os.clock()
			local dt = math.min(now - clock, 0.1)
			clock = now
			elapsed += dt * speed
			local alpha = math.min(elapsed / duration, 1)
			if fn then
				fn(alpha, elapsed)
			end
			tick(dt * speed)
			if alpha >= 1 then
				break
			end
			task.wait()
		end
	end

	-- Bits that fly out and fall: egg shell, sparks, confetti.
	local function burst(center: Vector3, count: number, colors: { Color3 }, confetti: boolean?)
		local bits = {}
		for k = 1, count do
			local direction = random:NextUnitVector() * Vector3.new(1, 0.6, 1) + Vector3.new(0, 0.6, 0)
			local bit = newPart(stage, {
				ClassName = if confetti then "Part" else "WedgePart",
				Name = "Bit",
				Size = if confetti then Vector3.new(0.4, 0.06, 0.25) else Vector3.new(0.15, 0.6, 0.6),
				CFrame = STAGE
					* CFrame.new(center + direction)
					* CFrame.Angles(random:NextNumber(0, 6), random:NextNumber(0, 6), 0),
				Color = colors[k % #colors + 1],
				Material = if confetti then Enum.Material.Neon else Enum.Material.SmoothPlastic,
			})
			table.insert(bits, { part = bit, velocity = direction.Unit * random:NextNumber(10, 22) })
		end
		task.spawn(function()
			local began, last = os.clock(), os.clock()
			while os.clock() - began < 2 do
				local now = os.clock()
				local dt = now - last
				last = now
				for _, b in bits do
					b.velocity -= Vector3.new(0, (if confetti then 14 else 35) * dt, 0)
					b.part.CFrame = (b.part.CFrame + b.velocity * dt) * CFrame.Angles(6 * dt, 4 * dt, 0)
					b.part.Transparency = ((now - began) / 2) ^ 2
				end
				task.wait()
			end
			for _, b in bits do
				b.part:Destroy()
			end
		end)
	end

	local function slam(caption: string, text: string, color: Color3)
		captionLabel.Text = caption
		clueLabel.Text = text
		clueLabel.TextColor3 = color
		captionLabel.TextTransparency = 0
		captionLabel:FindFirstChildOfClass("UIStroke").Transparency = 0
		animate(0.2, function(a)
			clueScale.Scale = 2.6 - 1.6 * easeOut(a)
			clueLabel.TextTransparency = 1 - a
			clueStroke.Transparency = 1 - a
		end)
		state.shake = 0.5 + tier * 0.06
	end

	local function hideClue()
		animate(0.15, function(a)
			clueLabel.TextTransparency = a
			clueStroke.Transparency = a
			captionLabel.TextTransparency = a
			captionLabel:FindFirstChildOfClass("UIStroke").Transparency = a
		end)
		clueGradient.Enabled = false
	end

	----------------------------------------------------------------------------
	-- 1. Into the arena: the camera swoops in and the egg drops onto the pedestal.
	----------------------------------------------------------------------------
	camera.CFrame = state.camFrom
	flash(Color3.new(0, 0, 0), 0.5)
	moveCamera(Vector3.new(0, 7, -24), Vector3.new(0, 4, 0))
	local egg = EggModel.build(result.crate)
	egg.Parent = stage
	local eggRest = at(0, PEDESTAL_TOP, 0) * CFrame.Angles(0, math.pi, 0)
	animate(0.8, function(a)
		state.brightness = 0.25 + 0.2 * a
		local drop = if a < 0.75 then 22 * (1 - (a / 0.75) ^ 2) else math.sin((a - 0.75) / 0.25 * math.pi) * 0.8
		egg:PivotTo(eggRest + Vector3.new(0, drop, 0))
	end)
	state.shake = 0.6

	----------------------------------------------------------------------------
	-- 2. The egg shakes harder and harder while the camera creeps in.
	----------------------------------------------------------------------------
	camTime = 1 + tier * 0.15
	moveCamera(Vector3.new(0, 5, -14), Vector3.new(0, 3.2, 0))
	animate(1 + tier * 0.15, function(a, t)
		local wobble = math.sin(t * (14 + a * 24)) * math.rad(4 + 18 * a * a)
		egg:PivotTo(eggRest * CFrame.Angles(0, 0, wobble) + Vector3.new(0, math.abs(math.sin(t * 9)) * 0.3 * a, 0))
		state.brightness = 0.45 + 0.4 * a
		state.sweep = 0.3 + 2.5 * a
	end)

	----------------------------------------------------------------------------
	-- 3. Burst! A face-down card spins up out of the light.
	----------------------------------------------------------------------------
	flash(Color3.new(1, 1, 1), 0.45)
	burst(Vector3.new(0, PEDESTAL_TOP + 2, 0), 18, { EggModel.COLORS[result.crate] or GOLD, Color3.new(1, 1, 1) })
	egg:Destroy()
	state.shake = 1
	state.sweep = 0.6

	local card = Instance.new("Model")
	card.Name = "Card"
	card.Parent = stage
	local body = newPart(card, {
		Name = "CardBody",
		Size = CARD_SIZE,
		CFrame = CFrame.new(),
		Color = Color3.fromRGB(34, 16, 72),
	})
	card.PrimaryPart = body
	local rimParts = {}
	for _, bar in
		{
			{ Vector3.new(CARD_SIZE.X + 0.3, 0.3, 0.5), Vector3.new(0, CARD_SIZE.Y / 2, 0) },
			{ Vector3.new(CARD_SIZE.X + 0.3, 0.3, 0.5), Vector3.new(0, -CARD_SIZE.Y / 2, 0) },
			{ Vector3.new(0.3, CARD_SIZE.Y + 0.3, 0.5), Vector3.new(CARD_SIZE.X / 2, 0, 0) },
			{ Vector3.new(0.3, CARD_SIZE.Y + 0.3, 0.5), Vector3.new(-CARD_SIZE.X / 2, 0, 0) },
		}
	do
		table.insert(
			rimParts,
			newPart(card, {
				Name = "CardRim",
				Size = bar[1],
				CFrame = CFrame.new(bar[2]),
				Color = GOLD,
				Material = Enum.Material.Neon,
			})
		)
	end
	-- The back (facing the camera to start with): see buildCardBack.
	local animateBack = buildCardBack(card, body)
	-- The front starts blank (the card spins round as it appears, so nothing on it may give
	-- the pull away); paintFront() puts the rarity colours and words on just before the flip.
	local face = newPart(card, {
		Name = "CardFace",
		Size = Vector3.new(CARD_SIZE.X - 0.3, CARD_SIZE.Y - 0.3, 0.1),
		CFrame = CFrame.new(0, 0, CARD_SIZE.Z / 2 + 0.05),
		Color = Color3.fromRGB(16, 12, 30),
		Material = Enum.Material.Metal,
	})
	local function paintFront()
		face.Color = rarityColor:Lerp(Color3.new(0, 0, 0), 0.15)
		face.Material = Enum.Material.SmoothPlastic
		faceText(
			face,
			Enum.NormalId.Back,
			series.icon .. " " .. string.upper(series.name),
			series.color:Lerp(Color3.new(1, 1, 1), 0.4),
			UDim2.fromScale(0.06, 0.05),
			UDim2.fromScale(0.88, 0.09),
			true
		)
		faceText(
			face,
			Enum.NormalId.Back,
			string.upper(rarity),
			Color3.new(1, 1, 1),
			UDim2.fromScale(0.05, 0.4),
			UDim2.fromScale(0.9, 0.2),
			true
		)
		faceText(
			face,
			Enum.NormalId.Back,
			"★ ★ ★",
			GOLD,
			UDim2.fromScale(0.2, 0.66),
			UDim2.fromScale(0.6, 0.1),
			true
		)
	end

	local cardSpin = 0 -- extra turn on top of the float
	local cardRise = 0
	local function placeCard(t: number, extra: CFrame?)
		local float = math.sin(t * 2.2) * 0.25
		card:PivotTo(
			STAGE
				* CFrame.new(CARD_HOME + Vector3.new(0, float + cardRise, 0))
				* CFrame.Angles(0, cardSpin + math.sin(t * 0.9) * 0.12, 0)
				* (extra or CFrame.new())
		)
		animateBack(t)
	end
	moveCamera(Vector3.new(0, 7.5, -20), CARD_HOME)
	camTime = 0.6
	animate(0.6, function(a, t)
		local e = easeOut(a)
		cardSpin = (1 - e) * math.pi * 4
		cardRise = -5 * (1 - e)
		placeCard(t)
	end)
	cardSpin = 0
	cardRise = 0

	local function setRim(color: Color3)
		for _, p in rimParts do
			p.Color = color
		end
	end

	----------------------------------------------------------------------------
	-- 4. Clue one: the series. The arena lights turn the series colour.
	----------------------------------------------------------------------------
	state.color = series.color
	state.brightness = 0.7
	slam("SERIES", series.icon .. " " .. string.upper(series.name), series.color)
	setRim(series.color)
	camTime = 2
	moveCamera(Vector3.new(-5, 8, -18), CARD_HOME)
	animate(1.3 + tier * 0.1, function(_, t)
		placeCard(t)
	end)
	hideClue()

	----------------------------------------------------------------------------
	-- 5. Clue two: the rarity, climbing the ladder. COMMON slams in, then UNCOMMON,
	-- RARE... one rung at a time, each lighting the next pip on the meter and turning the
	-- whole arena its colour, with the pauses getting longer and the beams faster as it
	-- climbs. Before a big final rung the arena blacks out and the card's edge pulses like a
	-- heartbeat; then the real rarity lands with everything it's got.
	----------------------------------------------------------------------------
	local rungs = math.max(tier, 1)
	local shown = math.max(math.min(#Rarities.order, math.max(tier, 6)), 1) -- Common..Ultra (Secret if pulled)
	local meter = UI.new("Frame", {
		Name = "RarityMeter",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.92),
		Size = UDim2.fromOffset(shown * 126, 40),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = overlay,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local pips = {}
	for k = 1, shown do
		local name = Rarities.order[k]
		local pip = UI.new("Frame", {
			Name = name,
			Size = UDim2.fromOffset(118, 34),
			BackgroundColor3 = Color3.fromRGB(30, 30, 52),
			BackgroundTransparency = 0.25,
			LayoutOrder = k,
			ZIndex = 20,
			Parent = meter,
		}, { UI.corner(17) })
		local stroke = UI.stroke(nil, 2.5)
		stroke.Parent = pip
		local label = UI.label(string.upper(name), {
			Size = UDim2.fromScale(1, 1),
			FontFace = UI.fonts.heavy,
			TextColor3 = Color3.fromRGB(120, 120, 150),
			ZIndex = 21,
			Parent = pip,
		})
		label.Size = UDim2.new(1, -10, 1, -8)
		label.Position = UDim2.fromOffset(5, 4)
		local scale = UI.new("UIScale", { Parent = pip })
		pips[k] = { frame = pip, stroke = stroke, label = label, scale = scale }
	end
	animate(0.25, function(a, t)
		placeCard(t)
		meter.Position = UDim2.new(0.5, 0, 0.92, 60 * (1 - easeOut(a)))
	end)

	local function lightPip(k: number, current: boolean)
		local pip = pips[k]
		if not pip then
			return
		end
		local color = Rarities.info[Rarities.order[k]].color
		pip.frame.BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.25)
		pip.frame.BackgroundTransparency = 0
		pip.label.TextColor3 = Color3.new(1, 1, 1)
		pip.stroke.Color = if current then Color3.new(1, 1, 1) else UI.OUTLINE
		pip.stroke.Thickness = if current then 3.5 else 2.5
		pip.scale.Scale = if current then 1.15 else 1
	end

	-- Camera stations for the climb: each rung pushes in a little closer.
	local function climbCamera(k: number)
		local f = (k - 1) / math.max(rungs - 1, 1)
		camTime = 0.35
		moveCamera(Vector3.new(math.sin(k * 1.7) * 3, 7.5 - f * 0.8, -19 + f * 5), CARD_HOME)
	end

	-- Fake-outs: on the way up, the card sometimes settles as if this is it and starts to
	-- turn over... then jolts back ("WAIT...!") and the climb carries on. Legendary and
	-- better always get one (Ultra and Secret two); Uncommon and Rare get one half the time.
	local fakeRungs = {}
	local fakeRandom = Random.new()
	if rungs >= 2 and (tier >= 4 or fakeRandom:NextNumber() < 0.5) then
		fakeRungs[fakeRandom:NextInteger(math.max(1, rungs - 2), rungs - 1)] = true
	end
	if tier >= 6 then
		fakeRungs[fakeRandom:NextInteger(1, math.max(1, rungs - 3))] = true
	end
	local function fakeOut(k: number)
		-- It all goes calm, like the climb is over...
		state.sweep = 0.25
		camTime = 0.9
		moveCamera(Vector3.new(0, 7.3, -14), CARD_HOME)
		animate(0.45, function(_, t)
			placeCard(t)
			pips[k].scale.Scale = 1.15
		end)
		-- ...the card starts to turn over...
		animate(0.65, function(a, t)
			cardSpin = math.pi * 0.42 * easeInOut(a)
			placeCard(t)
		end)
		-- ...then jolts back, and the climb is on again.
		flash(Color3.new(1, 1, 1), 0.3)
		state.shake = 1.3
		captionLabel.Text = ""
		clueLabel.Text = "WAIT...!"
		clueLabel.TextColor3 = Color3.new(1, 1, 1)
		animate(0.22, function(a, t)
			cardSpin = math.pi * 0.42 * (1 - easeOut(a))
			placeCard(t)
			clueScale.Scale = 2.4 - 1.4 * easeOut(a)
			clueLabel.TextTransparency = 1 - a
			clueStroke.Transparency = 1 - a
		end)
		cardSpin = 0
		state.sweep = 2.5
		animate(0.55, function(_, t)
			placeCard(t)
		end)
		animate(0.1, function(a, t)
			placeCard(t)
			clueLabel.TextTransparency = a
			clueStroke.Transparency = a
		end)
	end

	for k = 1, rungs do
		local name = Rarities.order[k]
		local color = Rarities.info[name].color
		local final = k == rungs
		if final and tier >= 3 then
			-- Blackout and heartbeat before the big one.
			hideClue()
			state.color = Color3.fromRGB(60, 50, 90)
			state.sweep = 0.2
			camTime = 1.1
			moveCamera(Vector3.new(0, 7.2, -12.5), CARD_HOME)
			animate(0.5 + tier * 0.12, function(a, t)
				placeCard(t)
				state.brightness = 0.9 * (1 - a) + 0.08
				local beat = math.max(math.sin(t * 9), 0) ^ 6
				setRim(Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(40, 30, 60), 1 - beat))
				if beat > 0.95 then
					state.shake = math.max(state.shake, 0.25)
				end
			end)
		end
		lightPip(k, true)
		if pips[k - 1] then
			lightPip(k - 1, false)
		end
		state.color = color
		setRim(color)
		if not final then
			-- A quick rung: the word punches in, the arena turns its colour, then on.
			clueLabel.Text = string.upper(name)
			clueLabel.TextColor3 = color
			captionLabel.Text = "RARITY"
			captionLabel.TextTransparency = 0
			captionLabel:FindFirstChildOfClass("UIStroke").Transparency = 0
			state.brightness = 0.55 + 0.1 * k
			state.sweep = 0.6 + k * 0.5
			climbCamera(k)
			animate(0.14, function(a, t)
				placeCard(t)
				clueScale.Scale = 1.8 - 0.8 * easeOut(a)
				clueLabel.TextTransparency = 1 - a
				clueStroke.Transparency = 1 - a
			end)
			flash(color:Lerp(Color3.new(1, 1, 1), 0.6), 0.15)
			state.shake = 0.3 + k * 0.06
			-- Each rung holds a little longer than the last: the suspense builds.
			animate(0.3 + k * 0.14, function(a, t)
				placeCard(t)
				pips[k].scale.Scale = 1.15 + math.sin(a * math.pi) * 0.08
			end)
			if fakeRungs[k] then
				fakeOut(k)
			else
				animate(0.1, function(a, t)
					placeCard(t)
					clueLabel.TextTransparency = a * 0.7
				end)
			end
		else
			-- The real rarity lands.
			state.brightness = 1
			state.sweep = 1 + tier * 0.4
			state.rainbow = tier >= 6
			if tier >= 3 then
				flash(color:Lerp(Color3.new(1, 1, 1), 0.5), 0.4)
			end
			if state.rainbow then
				local keys = {}
				for c = 0, 6 do
					table.insert(keys, ColorSequenceKeypoint.new(c / 6, Color3.fromHSV(c / 6, 0.75, 1)))
				end
				clueGradient.Color = ColorSequence.new(keys)
				clueGradient.Enabled = true
			end
			slam(
				"RARITY",
				RARITY_WORDS[rarity] or string.upper(rarity),
				if state.rainbow then Color3.new(1, 1, 1) else color
			)
			state.shake = 0.8 + tier * 0.1
			if tier >= 4 then
				local colors = {}
				for c = 1, 6 do
					table.insert(colors, Color3.fromHSV(c / 6, 0.7, 1))
				end
				burst(CARD_HOME + Vector3.new(0, 4, 0), 30 + tier * 8, colors, true)
			end
		end
	end

	local nextStrike = 0.3
	camTime = 1.5 + tier * 0.25
	moveCamera(Vector3.new(5, 6.5, -17), CARD_HOME)
	animate(1.2 + tier * 0.25, function(_, t)
		placeCard(t)
		pips[rungs].scale.Scale = 1.15 + math.sin(t * 6) * 0.06
		if state.rainbow then
			setRim(rainbow(os.clock()))
			clueGradient.Offset = Vector2.new(math.sin(t * 2) * 0.5, 0)
			for k = 1, rungs do
				pips[k].frame.BackgroundColor3 = rainbow(os.clock(), k / rungs)
			end
		end
		if tier >= 5 and t >= nextStrike then
			nextStrike += 0.55
			flash(Color3.fromRGB(220, 200, 255), 0.18)
			state.shake = 0.7
		end
	end)
	hideClue()
	meter:Destroy()

	paintFront()

	----------------------------------------------------------------------------
	-- 6. The flip: the card turns over in 3D, then the Freek walks out in front of it.
	----------------------------------------------------------------------------
	camTime = 0.5
	moveCamera(Vector3.new(0, 7.5, -16), CARD_HOME)
	animate(0.55, function(a, t)
		cardSpin = math.pi * easeInOut(a)
		placeCard(t)
	end)
	cardSpin = math.pi
	flash(Color3.new(1, 1, 1), 0.35)
	state.shake = 0.8
	burst(CARD_HOME, 24, { rarityColor, Color3.new(1, 1, 1) })
	animate(0.5, function(_, t)
		placeCard(t)
	end)

	-- The card lifts up and back; the Freek pops out onto the pedestal.
	local freek = FreekModel.build(result.freek.species, result.freek.mutations)
	for _, p in freek:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
		end
	end
	freek.Parent = stage
	local freekRest = at(0, PEDESTAL_TOP, -0.5)
	camTime = 0.9
	moveCamera(Vector3.new(0, 5.5, -15), Vector3.new(0, 6.2, 1))
	animate(0.6, function(a, t)
		local e = easeOut(a)
		cardRise = 5 * e
		card:PivotTo(
			STAGE
				* CFrame.new(CARD_HOME + Vector3.new(0, cardRise, 6 * e))
				* CFrame.Angles(0, math.pi + math.sin(t * 0.9) * 0.12, 0)
		)
		local hop = math.sin(a * math.pi) * 3
		freek:PivotTo(freekRest * CFrame.new(0, hop - 2 * (1 - e), 0) * CFrame.Angles(0, (1 - e) * math.pi * 2, 0))
	end)
	flash(rarityColor:Lerp(Color3.new(1, 1, 1), 0.6), 0.3)
	burst(Vector3.new(0, PEDESTAL_TOP + 1, -0.5), 20, { rarityColor, GOLD })
	state.shake = 0.6

	-- 7. The name slams in, with NEW! if it's new to them.
	local nameLabel = UI.label(string.upper(FreekUtil.displayName(result.freek)), {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.86),
		Size = UDim2.fromOffset(800, 70),
		FontFace = UI.fonts.heavy,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 20,
		Parent = overlay,
	})
	nameLabel:FindFirstChildOfClass("UIStroke").Thickness = 4
	local nameScale = UI.new("UIScale", { Parent = nameLabel })
	animate(0.2, function(a)
		nameScale.Scale = 2.2 - 1.2 * easeOut(a)
	end)
	UI.label(string.upper(rarity) .. "  ·  " .. string.upper(series.name), {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.86, -50),
		Size = UDim2.fromOffset(500, 28),
		FontFace = UI.fonts.heavy,
		TextColor3 = rarityColor,
		ZIndex = 20,
		Parent = overlay,
	})
	if result.isNew then
		local stamp = UI.label("NEW!", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.64, 0.36),
			Size = UDim2.fromOffset(120, 50),
			FontFace = UI.fonts.heavy,
			TextColor3 = Color3.new(1, 1, 1),
			BackgroundColor3 = UI.colors.red,
			BackgroundTransparency = 0,
			Rotation = 12,
			ZIndex = 22,
			Parent = overlay,
		})
		UI.corner(12).Parent = stamp
		UI.stroke(nil, 3).Parent = stamp
		local stampScale = UI.new("UIScale", { Parent = stamp })
		animate(0.18, function(a)
			stampScale.Scale = 2 - easeOut(a)
		end)
	end
	UI.label("It's in your barn!", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.86, 48),
		Size = UDim2.fromOffset(400, 26),
		TextColor3 = Color3.fromRGB(220, 232, 255),
		ZIndex = 20,
		Parent = overlay,
	})

	-- 8. Show it off until they tap Awesome!
	local closed = false
	UI.button("AWESOME!", UI.colors.green, function()
		closed = true
	end, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -60, 1, -50),
		Size = UDim2.fromOffset(220, 60),
		ZIndex = 25,
		Parent = overlay,
	})
	speed = 1
	camTime = 6
	moveCamera(Vector3.new(-4, 5.5, -14.5), Vector3.new(0, 6.2, 1))
	local showTime = 0
	freek:PivotTo(freekRest)
	local rig = FreekAnimator.rig(freek, 3)
	while not closed do
		animate(0.2, function(_, t)
			local time = showTime + t
			card:PivotTo(
				STAGE
					* CFrame.new(CARD_HOME + Vector3.new(0, 5 + math.sin(time * 2.2) * 0.25, 6))
					* CFrame.Angles(0, math.pi + math.sin(time * 0.9) * 0.12, 0)
			)
			-- It shows off: blinking, looking around, wagging and hopping.
			if rig then
				FreekAnimator.pose(rig, freekRest, time + 8)
			end
			if state.rainbow then
				setRim(rainbow(os.clock()))
			end
		end)
		showTime += 0.2
	end

	-- Back to the game.
	stage:Destroy()
	gui:Destroy()
	showHud()
	camera.CameraType = if oldCameraType == Enum.CameraType.Scriptable then Enum.CameraType.Custom else oldCameraType
	camera.FieldOfView = oldFov
	if controls then
		controls:Enable()
	end
	done()
end

return PackReveal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- Small helpers for building the UI in code (so there's nothing to set up in Studio).
-- Style: the clean cartoon look of the big Roblox simulators (Pet Simulator, PLS DONATE,
-- Grow a Garden) in Fuse a Freek colours: light windows with a coloured header and a
-- slanted title tab, bright glossy gradient cards with a big 3D picture, black price
-- pills, chunky shaded buttons that squish when pressed, Luckiest Guy titles, Fredoka One
-- text, and every bit of text outlined in dark navy.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FreekModel = require(ReplicatedStorage.Shared.FreekModel)
local Freeks = require(ReplicatedStorage.Shared.Freeks)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local EggModel = require(ReplicatedStorage.Shared.EggModel)
local ItemPictures = require(script.Parent.ItemPictures)

local UI = {}

UI.fonts = {
	regular = Font.fromEnum(Enum.Font.FredokaOne),
	bold = Font.fromEnum(Enum.Font.FredokaOne),
	heavy = Font.fromEnum(Enum.Font.LuckiestGuy),
}

-- The dark outline around panels, buttons and text.
UI.OUTLINE = Color3.fromRGB(20, 22, 48)

UI.colors = {
	panel = Color3.fromRGB(62, 128, 245), -- windows and HUD panels
	card = Color3.fromRGB(110, 170, 255),
	text = Color3.fromRGB(255, 255, 255),
	muted = Color3.fromRGB(220, 232, 255),
	green = Color3.fromRGB(60, 200, 110),
	blue = Color3.fromRGB(70, 140, 255),
	pink = Color3.fromRGB(255, 95, 170),
	orange = Color3.fromRGB(255, 160, 50),
	red = Color3.fromRGB(235, 70, 80),
	gray = Color3.fromRGB(95, 90, 115),
	money = Color3.fromRGB(110, 235, 140),
	gold = Color3.fromRGB(255, 200, 60),
	purple = Color3.fromRGB(160, 110, 240),
	sheet = Color3.fromRGB(236, 230, 255), -- window bodies
	ink = Color3.fromRGB(28, 26, 48), -- price pills
	fusion = Color3.fromRGB(170, 80, 255), -- the game's own purple-to-pink
	fusion2 = Color3.fromRGB(255, 80, 190),
}

-- Bright card colours, picked by name so a card keeps its colour between refreshes.
local CARD_COLORS = {
	Color3.fromRGB(255, 95, 170),
	Color3.fromRGB(70, 200, 110),
	Color3.fromRGB(70, 150, 255),
	Color3.fromRGB(255, 160, 50),
	Color3.fromRGB(165, 95, 245),
	Color3.fromRGB(40, 195, 190),
	Color3.fromRGB(240, 80, 80),
	Color3.fromRGB(250, 200, 50),
}
function UI.cardColor(name: string): Color3
	local sum = 0
	for i = 1, #name do
		sum += string.byte(name, i) * i
	end
	return CARD_COLORS[sum % #CARD_COLORS + 1]
end

UI.GLASS_TRANSPARENCY = 0

-- UI.new("Frame", { Size = ... }, { children... })
function UI.new(className: string, props, children)
	local instance = Instance.new(className)
	for key, value in props or {} do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function UI.corner(radius: number?)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

-- An outline around a frame; defaults to the thick dark cartoon outline.
function UI.stroke(color: Color3?, thickness: number?, transparency: number?)
	return UI.new("UIStroke", {
		Color = color or UI.OUTLINE,
		Thickness = thickness or 3,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

-- An outline around text (the chunky cartoon text look).
function UI.textStroke(thickness: number?)
	return UI.new("UIStroke", {
		Color = UI.OUTLINE,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

-- Shading from light at the top to darker at the bottom. It multiplies whatever colour the
-- frame is, so it works on any button or panel. (color/lighten are kept for old callers.)
function UI.gradient(_color: Color3?, lighten: number?)
	local top = 1
	local bottom = 0.78 - (lighten or 0) * 0.3
	return UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(top, top, top), Color3.new(bottom, bottom, bottom)),
		Rotation = 90,
	})
end

-- A bright cartoon panel with a thick outline (the name is from the old glass style).
function UI.glass(props, children)
	local frame = UI.new("Frame", {
		BackgroundColor3 = UI.colors.panel,
		BackgroundTransparency = UI.GLASS_TRANSPARENCY,
	}, { UI.corner(16), UI.stroke(nil, 3.5), UI.gradient() })
	for key, value in props or {} do
		if key ~= "Parent" then
			frame[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = frame
	end
	if props and props.Parent then
		frame.Parent = props.Parent
	end
	return frame
end

function UI.label(text: string, props)
	local label = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = UI.fonts.bold,
		Text = text,
		TextColor3 = UI.colors.text,
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 24),
	}, { UI.textStroke(1.6) })
	for key, value in props or {} do
		label[key] = value
	end
	return label
end

-- A chunky cartoon button: bright shaded fill, thick dark outline, outlined text, and a
-- squish when pressed.
function UI.button(text: string, color: Color3, onClick: () -> (), props)
	local scale = UI.new("UIScale")
	local button = UI.new("TextButton", {
		BackgroundColor3 = color,
		FontFace = UI.fonts.heavy,
		Text = text,
		TextColor3 = UI.colors.text,
		TextStrokeColor3 = UI.OUTLINE,
		TextStrokeTransparency = 0,
		TextScaled = true,
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, 30),
	}, {
		UI.corner(12),
		UI.gradient(),
		UI.stroke(nil, 3),
		scale,
		UI.new("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
			PaddingTop = UDim.new(0, 5),
			PaddingBottom = UDim.new(0, 5),
		}),
	})
	for key, value in props or {} do
		button[key] = value
	end
	button.MouseButton1Down:Connect(function()
		scale.Scale = 0.92
	end)
	button.MouseButton1Up:Connect(function()
		scale.Scale = 1
	end)
	button.MouseLeave:Connect(function()
		scale.Scale = 1
	end)
	button.Activated:Connect(onClick)
	return button
end

-- A little 3D picture of a Freek. silhouette = true draws it solid black ("???").
function UI.viewport(speciesId: string, mutations: { string }?, silhouette: boolean?)
	local frame = UI.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 100),
		Ambient = Color3.fromRGB(170, 170, 170),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-1, -1, -1),
		ImageColor3 = if silhouette then Color3.new(0, 0, 0) else Color3.new(1, 1, 1),
	})
	local model, height = FreekModel.build(speciesId, mutations)
	model:PivotTo(CFrame.new())
	model.Parent = frame
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	local distance = height * 2.1
	camera.CFrame =
		CFrame.lookAt(Vector3.new(distance * 0.35, height * 0.75, -distance), Vector3.new(0, height * 0.42, 0))
	camera.Parent = frame
	frame.CurrentCamera = camera
	return frame
end

-- A little 3D picture of a Monster Egg.
function UI.eggViewport(eggId: string, size: number?)
	local frame = UI.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, size or 100),
		Ambient = Color3.fromRGB(180, 170, 190),
		LightColor = Color3.fromRGB(255, 240, 220),
		LightDirection = Vector3.new(-1, -1, 1),
	})
	local model, height = EggModel.build(eggId)
	model:PivotTo(CFrame.new())
	model.Parent = frame
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	local distance = height * 1.9
	camera.CFrame =
		CFrame.lookAt(Vector3.new(distance * 0.2, height * 0.6, -distance), Vector3.new(0, height * 0.45, 0))
	camera.Parent = frame
	frame.CurrentCamera = camera
	return frame
end

-- A card for grids: picture, lines of text, and buttons.
-- opts = { species, mutations?, silhouette?, lines = { {text, color?} }, buttons = { button instances } }
-- A black price pill (like PLS DONATE): coin or Robux icon and the price in white.
function UI.pricePill(text: string, onClick: () -> (), props)
	local pill = UI.button(text, UI.colors.ink, onClick, props)
	pill.TextColor3 = Color3.new(1, 1, 1)
	local corner = pill:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = UDim.new(1, 0)
	end
	local shade = pill:FindFirstChildOfClass("UIGradient")
	if shade then
		shade:Destroy() -- flat and glossy black
	end
	return pill
end

-- A little slanted tag on a card's corner: "NEW", "BEST", "x2"...
function UI.tag(parent: GuiObject, text: string, color: Color3?)
	local tag = UI.new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 6, 0, -8),
		Size = UDim2.fromOffset(64, 26),
		Rotation = 10,
		BackgroundColor3 = color or UI.colors.red,
		FontFace = UI.fonts.heavy,
		Text = text,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = (parent.ZIndex or 1) + 5,
		Parent = parent,
	}, {
		UI.corner(8),
		UI.stroke(nil, 2.5),
		UI.textStroke(1.6),
		UI.new("UIPadding", {
			PaddingLeft = UDim.new(0, 4),
			PaddingRight = UDim.new(0, 4),
			PaddingTop = UDim.new(0, 3),
			PaddingBottom = UDim.new(0, 3),
		}),
	})
	return tag
end

-- A bright glossy card (like Pet Simulator's shop): a gradient in the card's colour with a
-- shine across the top, the title in white, a big picture on a glowing disc, then text
-- lines and buttons. opts: accent (colour), border (a highlight outline, e.g. owned),
-- picture/egg/species, lines = { { text, colour?, height? } }, buttons, tag = { text,
-- colour? }, onClick.
function UI.card(opts)
	local title = opts.lines and opts.lines[1] and opts.lines[1][1] or ""
	local accent = opts.accent
	if not accent and opts.species then
		local species = Freeks.byId[opts.species]
		local rarity = species and species.rarity
		if rarity and rarity ~= "Common" then
			accent = Rarities.info[rarity].color
		end
	end
	accent = accent or (if opts.species then Color3.fromRGB(110, 165, 255) else UI.cardColor(title))
	if opts.background then
		accent = opts.background
	end

	-- Clickable cards are buttons; buttons inside them still get their own clicks.
	local card = UI.new(if opts.onClick then "TextButton" else "Frame", {
		BackgroundColor3 = accent,
	}, {
		UI.corner(16),
		if opts.border then UI.stroke(opts.border, 4.5) else UI.stroke(nil, 3.5),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(165, 165, 175)),
			Rotation = 90,
		}),
	})
	-- The glossy shine across the top.
	UI.new("Frame", {
		Name = "Shine",
		Position = UDim2.fromOffset(5, 4),
		Size = UDim2.new(1, -10, 0.38, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.8,
		Parent = card,
	}, { UI.corner(12) })
	local content = UI.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = card,
	}, {
		UI.new("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
			PaddingTop = UDim.new(0, 6),
			PaddingBottom = UDim.new(0, 8),
		}),
		UI.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 3),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})

	if opts.onClick then
		card.Text = ""
		card.AutoButtonColor = false
	end

	local order = 0
	local function add(child)
		order += 1
		child.LayoutOrder = order
		child.Parent = content
	end

	-- The title on top, big and white.
	local lines = opts.lines or {}
	if lines[1] then
		add(UI.label(lines[1][1], {
			FontFace = UI.fonts.heavy,
			TextColor3 = Color3.new(1, 1, 1),
			Size = UDim2.new(1, 0, 0, math.max(lines[1][3] or 22, 22)),
		}))
	end

	-- The picture, on a soft glowing disc.
	local picture
	if opts.picture then
		picture = ItemPictures.view(opts.picture, opts.pictureHeight)
	elseif opts.egg then
		picture = UI.eggViewport(opts.egg)
	elseif opts.species then
		picture = UI.viewport(opts.species, opts.mutations, opts.silhouette)
	end
	if picture then
		local holder = UI.new("Frame", {
			BackgroundTransparency = 1,
			Size = picture.Size,
		})
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.52),
			Size = UDim2.fromScale(0.62, 0.95),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.72,
			Parent = holder,
		}, { UI.corner(999), UI.new("UIAspectRatioConstraint", { AspectRatio = 1 }) })
		picture.Size = UDim2.fromScale(1, 1)
		picture.Parent = holder
		add(holder)
	end

	for i = 2, #lines do
		local line = lines[i]
		add(UI.label(line[1], {
			TextColor3 = line[2] or UI.colors.text,
			Size = UDim2.new(1, 0, 0, line[3] or 18),
		}))
	end
	for _, button in opts.buttons or {} do
		add(button)
	end
	if opts.tag then
		UI.tag(card, opts.tag[1], opts.tag[2])
	end

	if opts.onClick then
		card.Activated:Connect(opts.onClick)
	end

	return card
end

-- A grid that grows to fit its cards.
function UI.grid(cellWidth: number, cellHeight: number)
	return UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(cellWidth, cellHeight),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>