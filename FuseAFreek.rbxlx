	-- The Monster line: only from Monster Crates (exclusive = true keeps them out of the
	-- cannons and everywhere else).
	{
		id = "BooBoo",
		name = "Boo-Boo",
		rarity = "Uncommon",
		exclusive = true,
		walk = "float",
		income = 25,
		look = (function()
			local list, add = newParts()
			local white = rgb(240, 245, 255)
			local body = { 0, 2.9, 0 }
			add({ name = "Body", shape = "Ball", size = 3, pos = body, color = white, transparency = 0.1 })
			-- A wavy hem floating above the ground.
			for i = 0, 7 do
				local a = i / 8 * math.pi * 2
				add({
					shape = "Ball",
					size = 1.05,
					pos = { math.cos(a) * 1.05, 1.55, math.sin(a) * 1.05 },
					color = white,
					transparency = 0.1,
				})
			end
			for _, side in { -1, 1 } do
				add({
					shape = "Ball",
					size = 0.62,
					pos = onBall(body, 1.5, side * 0.45, 0.25, -0.1),
					color = rgb(25, 25, 40),
					detail = true,
				})
				add({
					shape = "Ball",
					size = 0.2,
					pos = onBall(body, 1.5, side * 0.38, 0.38, 0.12),
					color = rgb(255, 255, 255),
					detail = true,
				})
				add({
					shape = "Ball",
					size = 0.4,
					pos = onBall(body, 1.5, side * 0.85, -0.15, -0.12),
					color = rgb(255, 170, 200),
					detail = true,
				})
				add({
					shape = "Ball",
					size = 0.75,
					pos = { side * 1.6, 2.5, -0.2 },
					color = white,
					transparency = 0.1,
					swing = {
						hinge = { side * 1.3, 2.9, -0.2 },
						phase = if side < 0 then 0 else 0.5,
						axis = "Z",
						amount = side * 0.8,
					},
				})
			end
			add({
				shape = "Ball",
				size = 0.45,
				pos = onBall(body, 1.5, 0, -0.45, -0.1),
				color = rgb(25, 25, 40),
				detail = true,
			})
			return { parts = list, effects = { { type = "Glow", part = 1, color = rgb(190, 220, 255), size = 8 } } }
		end)(),
	},
	{
		id = "Zomboy",
		name = "Zomboy",
		rarity = "Uncommon",
		exclusive = true,
		walk = "shamble",
		income = 30,
		look = human({
			skin = rgb(140, 200, 110),
			shirt = rgb(80, 120, 190),
			pants = rgb(110, 80, 60),
			shoes = rgb(60, 50, 45),
			armsForward = true,
			head = 2.15,
			extra = function(h)
				-- Messy hair, a peek of brain, stitches and a torn shirt.
				h.add({
					shape = "Ball",
					size = h.head + 0.1,
					pos = { 0, h.headY + 0.35, 0.25 },
					color = rgb(60, 45, 35),
				})
				h.add({ shape = "Ball", size = 0.6, pos = { 0.45, h.headY + 0.95, -0.3 }, color = rgb(255, 150, 170) })
				h.add({ shape = "Ball", size = 0.45, pos = { 0.75, h.headY + 0.8, -0.1 }, color = rgb(255, 150, 170) })
				for i = -1, 1 do
					h.add({
						shape = "Block",
						size = { 0.06, 0.3, 0.06 },
						pos = { -0.6 + i * 0.15, h.headY + 0.45, h.face(-0.6 + i * 0.15, 0.45, -0.02) },
						color = rgb(40, 40, 40),
						detail = true,
					})
				end
				h.add({
					shape = "Block",
					size = { 0.5, 0.05, 0.06 },
					pos = { -0.6, h.headY + 0.45, h.face(-0.6, 0.45, -0.03) },
					color = rgb(40, 40, 40),
					detail = true,
				})
				for _, x in { -0.5, 0.1, 0.6 } do
					h.add({
						shape = "Wedge",
						size = { 0.3, 0.35, 0.3 },
						pos = { x, 1.75, -h.torsoD / 2 - 0.05 },
						rot = { 180, 0, 0 },
						color = rgb(80, 120, 190),
					})
				end
			end,
		}),
	},
	{
		id = "Mumbles",
		name = "Mumbles",
		rarity = "Rare",
		exclusive = true,
		walk = "shamble",
		income = 100,
		look = human({
			skin = rgb(235, 225, 195),
			shirt = rgb(235, 225, 195),
			pants = rgb(225, 214, 182),
			shoes = rgb(210, 198, 165),
			armsForward = true,
			head = 2.15,
			extra = function(h)
				-- Bandage strips wrapped every which way, one eye peeking out.
				local strip = rgb(200, 188, 155)
				for i, y in { 1.9, 2.35, 2.8, 3.15 } do
					h.add({
						shape = "Block",
						size = { h.torsoW + 0.08, 0.14, h.torsoD + 0.08 },
						pos = { 0, y, 0 },
						rot = { 0, 0, if i % 2 == 0 then 8 else -8 },
						color = strip,
					})
				end
				for i, dy in { -0.55, 0.05, 0.6 } do
					h.add({
						shape = "Cylinder",
						size = { 0.16, h.head + 0.06, h.head + 0.06 },
						pos = { 0, h.headY + dy, 0 },
						rot = { 0, 0, 90 + (if i == 2 then 10 else -6) },
						color = strip,
					})
				end
				h.add({
					shape = "Block",
					size = { 0.75, 0.55, 0.2 },
					pos = { h.eyeX, h.headY + h.eyeY, h.face(h.eyeX, h.eyeY, 0.2) },
					rot = { 0, 0, 12 },
					color = rgb(235, 225, 195),
				})
				-- A loose end dangling down the back.
				h.add({
					shape = "Block",
					size = { 0.25, 1.2, 0.08 },
					pos = { 0.9, h.headY - 1.0, 0.4 },
					rot = { 0, 0, 15 },
					color = strip,
				})
			end,
		}),
	},
	{
		id = "CountFangula",
		name = "Count Fangula",
		rarity = "Legendary",
		exclusive = true,
		walk = "strut",
		income = 400,
		look = human({
			skin = rgb(225, 215, 240),
			shirt = rgb(30, 25, 40),
			sleeves = rgb(30, 25, 40),
			pants = rgb(30, 25, 40),
			shoes = rgb(15, 15, 20),
			head = 2.2,
			extra = function(h)
				-- Slicked black hair with a widow's peak, red eyes, fangs, and a big cape.
				h.add({
					shape = "Ball",
					size = h.head + 0.12,
					pos = { 0, h.headY + 0.32, 0.3 },
					color = rgb(20, 15, 25),
				})
				h.add({
					shape = "Block",
					size = { 0.5, 0.5, 0.3 },
					pos = { 0, h.headY + 0.8, h.face(0, 0.8, -0.2) },
					rot = { 0, 0, 45 },
					color = rgb(20, 15, 25),
				})
				for _, side in { -1, 1 } do
					local p = { side * h.eyeX, h.headY + h.eyeY, h.face(h.eyeX, h.eyeY, -0.12) }
					h.add({
						shape = "Ball",
						size = 0.38,
						pos = { p[1], p[2], p[3] - 0.12 },
						color = rgb(220, 30, 50),
						detail = true,
					})
					h.add({
						shape = "Wedge",
						size = { 0.1, 0.3, 0.12 },
						pos = { side * 0.18, h.headY - h.head * 0.2 - 0.18, h.face(0.18, h.head * 0.2 + 0.18, 0.02) },
						rot = { 180, 0, 0 },
						color = rgb(255, 255, 255),
						detail = true,
					})
				end
				local red = rgb(190, 20, 40)
				h.add({
					shape = "Block",
					size = { h.torsoW + 0.7, 3.1, 0.15 },
					pos = { 0, 1.75, h.torsoD / 2 + 0.2 },
					color = red,
				})
				h.add({
					shape = "Block",
					size = { h.torsoW + 0.9, 3.2, 0.12 },
					pos = { 0, 1.75, h.torsoD / 2 + 0.32 },
					color = rgb(20, 15, 25),
				})
				for _, side in { -1, 1 } do
					h.add({
						shape = "Block",
						size = { 0.9, 1.2, 0.12 },
						pos = { side * 0.75, h.torsoTop + 0.45, 0.35 },
						rot = { -15, side * 25, 0 },
						color = red,
					})
				end
				h.add({
					shape = "Ball",
					size = 0.3,
					pos = { 0, h.torsoTop - 0.3, -h.torsoD / 2 - 0.08 },
					color = red,
					material = "Neon",
					detail = true,
				})
			end,
		}),
	},
	{
		id = "Howlz",
		name = "Howlz",
		rarity = "Mystic",
		exclusive = true,
		walk = "prowl",
		income = 1500,
		look = human({
			skin = rgb(120, 85, 60),
			shirt = rgb(110, 60, 140),
			sleeves = rgb(120, 85, 60),
			pants = rgb(60, 60, 80),
			shoes = rgb(120, 85, 60),
			torsoWidth = 2.2,
			torsoDepth = 1.3,
			armSize = 0.6,
			head = 2.1,
			noMouth = true,
			extra = function(h)
				local fur, light = rgb(120, 85, 60), rgb(200, 170, 140)
				-- Wolf snout, nose, pointy ears, yellow eyes and a fluffy tail.
				h.add({ shape = "Ball", size = 1.1, pos = { 0, h.headY - 0.35, h.face(0, -0.35, -0.3) }, color = light })
				h.add({
					shape = "Ball",
					size = 0.4,
					pos = { 0, h.headY - 0.15, h.face(0, -0.15, 0.25) },
					color = rgb(20, 15, 15),
					detail = true,
				})
				h.add({
					shape = "Block",
					size = { 0.5, 0.08, 0.08 },
					pos = { 0, h.headY - 0.7, h.face(0, -0.7, 0.1) },
					color = rgb(60, 20, 20),
					detail = true,
				})
				for _, side in { -1, 1 } do
					pointyEar(h.add, side * 0.62, h.headY + 1.15, 0, 0.7, 0.9, fur)
					local p = { side * h.eyeX, h.headY + h.eyeY, h.face(h.eyeX, h.eyeY, -0.12) }
					h.add({
						shape = "Ball",
						size = 0.36,
						pos = { p[1], p[2], p[3] - 0.12 },
						color = rgb(255, 210, 40),
						detail = true,
					})
					-- Claws.
					for _, dx in { -0.12, 0, 0.12 } do
						h.add({
							shape = "Block",
							size = { 0.06, 0.25, 0.06 },
							pos = { side * (h.shoulderX + 0.08) + dx, 1.4, -0.2 },
							color = rgb(250, 245, 230),
							detail = true,
						})
					end
				end
				for i = 0, 3 do
					h.add({
						shape = "Ball",
						size = 0.75 - i * 0.08,
						pos = { 0, 1.9 + i * 0.3, h.torsoD / 2 + 0.4 + i * 0.25 },
						color = if i == 3 then light else fur,
					})
				end
				h.add({
					shape = "Block",
					size = { 0.8, 0.5, 0.1 },
					pos = { 0, h.torsoTop - 0.35, -h.torsoD / 2 - 0.02 },
					color = light,
				})
			end,
		}),
	},
	{
		id = "Blinky",
		name = "Blinky",
		rarity = "Ultra",
		exclusive = true,
		walk = "bounce",
		income = 6000,
		look = (function()
			local list, add = newParts()
			local purple, dark = rgb(140, 80, 220), rgb(95, 45, 170)
			local body = { 0, 2.6, 0 }
			add({ name = "Body", shape = "Ball", size = 3.6, pos = body, color = purple })
			legs(add, { { -0.75, -0.2 }, { 0.75, -0.2 } }, 1.0, 0.7, dark, dark)
			-- One huge eye.
			local eye = onBall(body, 1.8, 0, 0.35, -0.5)
			add({ shape = "Ball", size = 1.8, pos = eye, color = rgb(255, 255, 255), detail = true })
			add({
				shape = "Ball",
				size = 1.1,
				pos = { eye[1], eye[2], eye[3] - 0.42 },
				color = rgb(80, 220, 160),
				detail = true,
			})
			add({
				shape = "Ball",
				size = 0.55,
				pos = { eye[1], eye[2], eye[3] - 0.72 },
				color = rgb(15, 15, 20),
				detail = true,
			})
			add({
				shape = "Ball",
				size = 0.22,
				pos = { eye[1] + 0.25, eye[2] + 0.25, eye[3] - 0.85 },
				color = rgb(255, 255, 255),
				detail = true,
			})
			-- A toothy grin.
			add({
				shape = "Block",
				size = { 1.3, 0.3, 0.12 },
				pos = onBall(body, 1.8, 0, -0.75, -0.05),
				color = rgb(60, 20, 40),
				detail = true,
			})
			for _, x in { -0.4, 0, 0.4 } do
				add({
					shape = "Block",
					size = { 0.18, 0.2, 0.08 },
					pos = onBall(body, 1.8, x, -0.68, 0.02),
					color = rgb(255, 255, 255),
					detail = true,
				})
			end
			-- Two little horns (stacked rings) and stubby arms.
			for _, side in { -1, 1 } do
				for k = 0, 3 do
					local width = 0.5 - k * 0.11
					add({
						shape = "Cylinder",
						size = { 0.22, width, width },
						pos = { side * (0.75 + k * 0.08), 4.25 + k * 0.2, 0 },
						rot = { 0, 0, 90 - side * 20 },
						color = rgb(255, 220, 120),
					})
				end
				add({
					shape = "Ball",
					size = 0.8,
					pos = { side * 1.9, 2.4, -0.1 },
					color = purple,
					swing = { hinge = { side * 1.6, 2.6, -0.1 }, phase = if side < 0 then 0.5 else 0, amount = 0.6 },
				})
			end
			return {
				parts = list,
				effects = {
					{ type = "Sparkles", part = 1, color = rgb(200, 255, 230) },
					{ type = "Glow", part = 1, color = rgb(80, 220, 160), size = 12 },
				},
			}
		end)(),
	},
}

-- Every Freek belongs to a series (shown first when a Monster Egg hatches).
Freeks.SERIES = {
	Animal = { name = "Animal Series", icon = "🐾", color = Color3.fromRGB(90, 220, 110) },
	Human = { name = "Human Series", icon = "🧑", color = Color3.fromRGB(80, 170, 255) },
	Monster = { name = "Monster Series", icon = "🎃", color = Color3.fromRGB(255, 130, 40) },
	Hybrid = { name = "Hybrid", icon = "🧪", color = Color3.fromRGB(255, 95, 200) },
}
local HUMAN_LINE = { Chuckles = true, Nerdle = true, Flexo = true, Glamora = true }

local base = {}
for i, species in Freeks.list do
	species.order = i
	species.series = if species.exclusive then "Monster" elseif HUMAN_LINE[species.id] then "Human" else "Animal"
	base[species.id] = species
end

-- Freeks.byId[id] also answers for hybrid ids ("Nerdle+Oinkle"), built on first use.
local Hybrids = require(script.Parent.Hybrids)
local hybridCache = {}
Freeks.byId = setmetatable(table.clone(base), {
	__index = function(_, id)
		if type(id) ~= "string" or not Hybrids.isHybrid(id) then
			return nil
		end
		if hybridCache[id] == nil then
			hybridCache[id] = Hybrids.info(id, function(baseId)
				return base[baseId]
			end) or false
		end
		return hybridCache[id] or nil
	end,
})

return Freeks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">GamePasses</string>
          <string name="Source"><![CDATA[-- Game passes: one-time Robux purchases with permanent perks.
--
-- To make a pass live:
--   1. Publish the game, then go to create.roblox.com → your game → Monetization → Passes.
--   2. Create the pass (name, icon, price) and copy its ID number.
--   3. Paste the ID into `id` below. Passes with id = 0 show as "Coming soon".
-- `price` here is only what the Store shows; the real price is set on the dashboard.
--
-- The server marks owners with a player attribute "Pass_<key>", so any script (server or
-- client) can check a perk with GamePasses.has(player, key).

local Config = require(script.Parent.Config)

local GamePasses = {}

-- Set true to pretend every player owns every pass while testing in Studio.
GamePasses.STUDIO_GRANT_ALL = false

GamePasses.order = {
	"DoubleCoins",
	"FastBreeding",
	"LongerLock",
	"VIP",
	"ExtraPen",
	"ExtraSlot1",
	"ExtraSlot2",
	"ExtraSlot3",
}

GamePasses.list = {
	DoubleCoins = {
		id = 0,
		name = "2x Coins",
		icon = "💰",
		price = 499,
		description = "Double coins from your Freeks, forever.",
		color = Color3.fromRGB(255, 200, 60),
	},
	FastBreeding = {
		id = 0,
		name = "Fast Fusing",
		icon = "⚡",
		price = 999,
		description = "Fusing takes half the time.",
		color = Color3.fromRGB(90, 200, 255),
	},
	LongerLock = {
		id = 0,
		name = "Longer Gate Lock",
		icon = "🔒",
		price = 499,
		description = "Your gate stays locked for 5 minutes instead of 3.",
		color = Color3.fromRGB(235, 90, 90),
	},
	ExtraSlot1 = {
		id = 0,
		name = "Extra Barn Slot 1",
		icon = "🧱",
		price = 299,
		description = "+1 barn slot on top of the 12 you can buy with coins.",
		color = Color3.fromRGB(230, 150, 90),
		slot = true,
	},
	ExtraSlot2 = {
		id = 0,
		name = "Extra Barn Slot 2",
		icon = "🧱",
		price = 299,
		description = "+1 barn slot on top of the 12 you can buy with coins.",
		color = Color3.fromRGB(230, 150, 90),
		slot = true,
	},
	ExtraSlot3 = {
		id = 0,
		name = "Extra Barn Slot 3",
		icon = "🧱",
		price = 299,
		description = "+1 barn slot on top of the 12 you can buy with coins.",
		color = Color3.fromRGB(230, 150, 90),
		slot = true,
	},
	ExtraPen = {
		id = 0,
		name = "Extra Fusion Den",
		icon = "🐣",
		price = 399,
		description = "A second Fusion Den, so you can fuse two pairs at once.",
		color = Color3.fromRGB(255, 130, 190),
	},
	VIP = {
		id = 0,
		name = "VIP",
		icon = "👑",
		price = 299,
		description = "Gold VIP badge on the leaderboard and in chat, plus +10% coins.",
		color = Color3.fromRGB(255, 180, 40),
	},
}

function GamePasses.has(player: Player, key: string): boolean
	return player:GetAttribute("Pass_" .. key) == true
end

-- Perks --------------------------------------------------------------------------

function GamePasses.coinMultiplier(player: Player): number
	local multiplier = 1
	if GamePasses.has(player, "DoubleCoins") then
		multiplier *= 2
	end
	if GamePasses.has(player, "VIP") then
		multiplier *= 1.1
	end
	return multiplier
end

function GamePasses.breedTimeMultiplier(player: Player): number
	return if GamePasses.has(player, "FastBreeding") then 0.5 else 1
end

function GamePasses.gateLockSeconds(player: Player): number
	return if GamePasses.has(player, "LongerLock") then 300 else Config.GATE_LOCK_SECONDS
end

-- How many breeding pens the player can use.
function GamePasses.penCount(player: Player): number
	return if GamePasses.has(player, "ExtraPen") then 2 else 1
end

-- How many Extra Yard Slot passes the player owns.
function GamePasses.passSlots(player: Player): number
	local count = 0
	for _, key in GamePasses.order do
		if GamePasses.list[key].slot and GamePasses.has(player, key) then
			count += 1
		end
	end
	return count
end

-- Kept as a hook so a future pass can raise the limit.
function GamePasses.maxFreeks(_player: Player): number
	return Config.MAX_FREEKS
end

return GamePasses
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">GateTiers</string>
          <string name="Source"><![CDATA[-- The frame around each barn's doors upgrades with rebirths: Iron, then Bronze, Silver,
-- Gold, Diamond, Emerald, Ruby, Amethyst and finally Rainbow (rebirth 8). The doorway stays the same size; the frame gets chunkier and fancier.
--
-- postWidth: post thickness; finials: balls on the posts; crest: an arch over the name
-- plaque; gems: glowing gems and sparkles; rainbow: the metal cycles through the rainbow.
-- (height is no longer used.)

local GateTiers = {}

GateTiers.list = {
	{
		name = "Iron",
		color = Color3.fromRGB(38, 38, 44),
		material = "Metal",
		height = 11,
		postWidth = 1.6,
	},
	{
		name = "Bronze",
		color = Color3.fromRGB(180, 112, 58),
		material = "Foil",
		height = 12.5,
		postWidth = 2.1,
		finials = true,
	},
	{
		name = "Silver",
		color = Color3.fromRGB(205, 210, 222),
		material = "Foil",
		height = 14,
		postWidth = 2.5,
		finials = true,
		crest = true,
	},
	{
		name = "Gold",
		color = Color3.fromRGB(255, 196, 55),
		material = "Foil",
		height = 15.5,
		postWidth = 2.9,
		finials = true,
		crest = true,
		gems = true,
	},
}

-- The jewel tiers past Gold all share Gold's shape.
for _, jewel in
	{
		{ "Diamond", Color3.fromRGB(170, 235, 255), "Glass" },
		{ "Emerald", Color3.fromRGB(50, 205, 110), "Glass" },
		{ "Ruby", Color3.fromRGB(230, 40, 70), "Glass" },
		{ "Amethyst", Color3.fromRGB(165, 85, 240), "Glass" },
		{ "Rainbow", Color3.fromRGB(255, 90, 160), "Neon" },
	}
do
	table.insert(GateTiers.list, {
		name = jewel[1],
		color = jewel[2],
		material = jewel[3],
		height = 15.5,
		postWidth = 3.1,
		finials = true,
		crest = true,
		gems = true,
		rainbow = jewel[1] == "Rainbow",
	})
end

function GateTiers.forRebirths(rebirths: number): number
	return math.clamp((rebirths or 0) + 1, 1, #GateTiers.list)
end

return GateTiers
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Hybrids</string>
          <string name="Source"><![CDATA[-- Hybrids: what you get when two different Freeks fuse.
--
-- A hybrid is identified by the base species that went into it, e.g. "Nerdle+Oinkle".
-- Fusing a hybrid again adds its species to the mix ("Flexo+Nerdle+Oinkle"); when one
-- species is in there more than once it gets a count ("Nerdle*2+Oinkle"). Counts are kept
-- in lowest terms, so the same mix always has the same id however it was made, and
-- fusing two of the same species just makes that species again.
--
-- Everything else about a hybrid comes from its id, so nothing needs to be listed by hand:
--   name    the two main species' names mashed together (Chuckles + Flexo = "Chuxo")
--   rarity  the rarest species in it (fusing never raises rarity)
--   look    built by FreekModel from the two main species: left side from one, right side
--           from the other, body colours blended
-- Each hybrid Freek also stores its own income (see Breeding.babyIncome).
--
-- Freeks.byId[id] works for hybrid ids too (Freeks.luau asks this module).

local Rarities = require(script.Parent.Rarities)

local Hybrids = {}

function Hybrids.isHybrid(id: string): boolean
	return string.find(id, "+", 1, true) ~= nil
end

-- { [baseId] = count } for any species or hybrid id.
function Hybrids.counts(id: string): { [string]: number }
	local counts = {}
	for piece in string.gmatch(id, "[^+]+") do
		local base, n = string.match(piece, "^(.-)%*(%d+)$")
		base = base or piece
		counts[base] = (counts[base] or 0) + (tonumber(n) or 1)
	end
	return counts
end

local function gcd(a: number, b: number): number
	while b ~= 0 do
		a, b = b, a % b
	end
	return a
end

-- The id for a mix of species (a plain species id if there's only one).
function Hybrids.key(counts: { [string]: number }): string
	local ids = {}
	local divisor = 0
	for id, n in counts do
		table.insert(ids, id)
		divisor = gcd(divisor, n)
	end
	table.sort(ids)
	local pieces = {}
	for _, id in ids do
		local n = counts[id] // divisor
		table.insert(pieces, if n > 1 then id .. "*" .. n else id)
	end
	return table.concat(pieces, "+")
end

-- What two species (or hybrids) fuse into.
function Hybrids.combine(a: string, b: string): string
	local counts = Hybrids.counts(a)
	for id, n in Hybrids.counts(b) do
		counts[id] = (counts[id] or 0) + n
	end
	return Hybrids.key(counts)
end

-- The species in a hybrid, most-used first (ties alphabetical).
function Hybrids.ranked(id: string): { string }
	local counts = Hybrids.counts(id)
	local list = {}
	for base in counts do
		table.insert(list, base)
	end
	table.sort(list, function(a, b)
		if counts[a] ~= counts[b] then
			return counts[a] > counts[b]
		end
		return a < b
	end)
	return list
end

-- Name mashing ------------------------------------------------------------------------

local VOWELS = "aeiouyAEIOUY"

local function letters(name: string): string
	return (string.gsub(name, "[^%a]", ""))
end

-- The start of a name up to its first vowels: "Chuckles" -> "Chu", "Glamora" -> "Gla".
local function front(name: string): string
	local word = letters(name)
	local _, finish = string.find(word, "^[^" .. VOWELS .. "]*[" .. VOWELS .. "]+")
	return if finish then string.sub(word, 1, finish) else word
end

-- The rest of a name after its first vowel: "Oinkle" -> "inkle", "Flexo" -> "xo".
local function back(name: string): string
	local word = letters(name)
	local _, finish = string.find(word, "^[^" .. VOWELS .. "]*[" .. VOWELS .. "]")
	local rest = if finish then string.sub(word, finish + 1) else word
	if #rest < 2 then
		rest = string.sub(word, -3)
	end
	return string.lower(rest)
end

-- Mashes two names, trying both orders and keeping the one that sounds most like a name.
local function mash(nameA: string, nameB: string): string
	local wordA, wordB = letters(nameA), letters(nameB)
	local average = (#wordA + #wordB) / 2
	local candidates = {}
	for _, pair in { { wordA, wordB }, { wordB, wordA } } do
		local start = front(pair[1])
		local penalty = if #start < 3 then 2 else 0 -- weak start, like "Oi"
		table.insert(candidates, { start .. back(pair[2]), penalty })
		-- Fallbacks for when the parents' names look alike: plain halves, then a short mix.
		local first = string.sub(pair[1], 1, math.ceil(#pair[1] / 2))
		local second = string.lower(string.sub(pair[2], math.ceil(#pair[2] / 2) + 1))
		table.insert(candidates, { first .. second, 3 })
		table.insert(candidates, { string.sub(pair[1], 1, 2) .. string.lower(string.sub(pair[2], -3)), 6 })
	end
	local best, bestScore = nil, math.huge
	for _, entry in candidates do
		local candidate, score = entry[1], entry[2]
		score += math.abs(#candidate - average)
		if #candidate < 5 then
			score += 3 -- too short
		end
		local lower = string.lower(candidate)
		if lower == string.lower(wordA) or lower == string.lower(wordB) then
			score += 100 -- just one of the parents' names again
		end
		if score < bestScore or (score == bestScore and candidate < best) then
			best, bestScore = candidate, score
		end
	end
	return string.upper(string.sub(best, 1, 1)) .. string.sub(best, 2)
end

-- Builds the species-like info for a hybrid id. get(baseId) returns a base species.
function Hybrids.info(id: string, get)
	local ranked = Hybrids.ranked(id)
	if #ranked < 2 then
		return nil
	end
	local rank = 1
	for _, base in ranked do
		local species = get(base)
		if not species then
			return nil
		end
		rank = math.max(rank, Rarities.rank[species.rarity])
	end
	local a, b = get(ranked[1]), get(ranked[2])
	local name = mash(a.name, b.name)
	if ranked[3] then
		name ..= "-" .. front(get(ranked[3]).name)
	end
	return {
		id = id,
		name = name,
		rarity = Rarities.order[rank],
		income = a.income + b.income, -- only a guide: each hybrid Freek stores its own
		hybrid = true,
		series = "Hybrid",
		walk = a.walk,
		parts = ranked,
		look = { hybrid = { a = a.id, b = b.id } },
		order = math.huge,
	}
end

return Hybrids
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Luck</string>
          <string name="Source"><![CDATA[-- Luck: Monster Eggs, the daily Lucky Wheel and Lucky Hour events. Shared so the client
-- can show every chance on screen (players always see the odds before buying), while the
-- server does all the rolling (server/LuckService).
--
-- Monster Eggs are Developer Products bought with Robux. They're the only way to get
-- the Monster line (Freeks with exclusive = true). Roblox's rules for paid random items:
-- the odds are shown before buying, and players in countries where paid random items
-- aren't allowed can't buy them (LuckService checks PolicyService).

local Freeks = require(script.Parent.Freeks)
local Rarities = require(script.Parent.Rarities)

local Luck = {}

-- Monster Eggs (Halloween style; models in EggModel.luau). In the code they're still
-- called crates. productId: create a Developer Product for each on the Creator Dashboard
-- (Monetization -> Developer Products) at this price and paste its ID here. Until then
-- the egg shows "Coming soon", except in Studio where it hatches free for testing.
-- odds are weights per Monster; mutation multiplies each mutation's normal chance.
Luck.CRATES = {
	{
		id = "Monster",
		name = "Monster Egg",
		robux = 49,
		productId = 0,
		color = Color3.fromRGB(255, 140, 30),
		odds = { BooBoo = 45, Zomboy = 35, Mumbles = 15, CountFangula = 4.5, Howlz = 0.5 },
		mutation = 1,
	},
	{
		id = "MegaMonster",
		name = "Mega Monster Egg",
		robux = 149,
		productId = 0,
		color = Color3.fromRGB(160, 110, 240),
		odds = { BooBoo = 20, Zomboy = 25, Mumbles = 35, CountFangula = 15, Howlz = 4.5, Blinky = 0.5 },
		mutation = 2,
	},
	{
		id = "LegendaryMonster",
		name = "Legendary Monster Egg",
		robux = 399,
		productId = 0,
		color = Color3.fromRGB(255, 200, 60),
		odds = { Mumbles = 30, CountFangula = 45, Howlz = 20, Blinky = 5 },
		mutation = 3,
	},
}
-- Opens crates for free in Studio when they have no product ID yet (for testing).
Luck.STUDIO_FREE_CRATES = true

Luck.crateById = {}
Luck.crateByProduct = {}
for _, crate in Luck.CRATES do
	Luck.crateById[crate.id] = crate
	if crate.productId ~= 0 then
		Luck.crateByProduct[crate.productId] = crate
	end
end

-- The crate's odds right now (Crate Luck makes the rarest ones likelier), as weights.
function Luck.crateOdds(crate): { [string]: number }
	local event = Luck.current()
	local boost = event and event.crateLuck or 1
	local odds = {}
	for speciesId, weight in crate.odds do
		local species = Freeks.byId[speciesId]
		local rare = species and Rarities.rank[species.rarity] >= Rarities.rank.Legendary
		odds[speciesId] = if rare then weight * boost else weight
	end
	return odds
end

-- The crate's odds as a list, most likely first: { { species, percent } }.
function Luck.oddsList(crate)
	local odds = Luck.crateOdds(crate)
	local total = 0
	for _, weight in odds do
		total += weight
	end
	local list = {}
	for speciesId, weight in odds do
		table.insert(list, { species = speciesId, percent = weight / total * 100 })
	end
	table.sort(list, function(a, b)
		return a.percent > b.percent
	end)
	return list
end

-- The Lucky Wheel: one free spin a day (twice a day with VIP). Coin prizes are minutes of
-- the player's own income, so they stay worth it as the player grows.
Luck.SPIN_COOLDOWN = 24 * 60 * 60
Luck.VIP_SPIN_COOLDOWN = 12 * 60 * 60
Luck.WHEEL = {
	{ label = "Coins", minutes = 3, weight = 34, color = Color3.fromRGB(110, 235, 140) },
	{ label = "Big Coins", minutes = 10, weight = 22, color = Color3.fromRGB(60, 200, 110) },
	{ label = "Golden Freek", golden = true, weight = 14, color = Color3.fromRGB(255, 220, 90) },
	{ label = "Monster Egg", crate = "Monster", weight = 12, color = Color3.fromRGB(255, 140, 30) },
	{ label = "Huge Coins", minutes = 30, weight = 10, color = Color3.fromRGB(40, 160, 90) },
	{ label = "Rainbow Freek", rainbow = true, weight = 4, color = Color3.fromRGB(255, 120, 255) },
	{ label = "Mega Egg", crate = "MegaMonster", weight = 3, color = Color3.fromRGB(160, 110, 240) },
	{ label = "JACKPOT", crate = "LegendaryMonster", weight = 1, color = Color3.fromRGB(255, 200, 60) },
}
Luck.MIN_COIN_PRIZE = 200 -- coin prizes are never less than this

function Luck.wheelPercent(index: number): number
	local total = 0
	for _, slice in Luck.WHEEL do
		total += slice.weight
	end
	return Luck.WHEEL[index].weight / total * 100
end

-- Lucky Hour events: every so often a random one runs server-wide for DURATION seconds.
-- The current one is published as ReplicatedStorage attributes (see Luck.current).
Luck.EVENT_DURATION = 10 * 60
Luck.EVENT_GAP = { 20 * 60, 35 * 60 } -- seconds between events (random in this range)
Luck.FIRST_EVENT_AFTER = 3 * 60 -- the first one comes soon after a server starts
Luck.EVENTS = {
	Rainbow = {
		name = "Rainbow Hour",
		icon = "🌈",
		description = "Cannon Freeks are 5x as likely to be mutated!",
		color = Color3.fromRGB(255, 120, 255),
		mutationBoost = 5,
	},
	LuckySkies = {
		name = "Lucky Skies",
		icon = "🍀",
		description = "Rare and better Freeks come out of the cannons 3x as often!",
		color = Color3.fromRGB(90, 230, 120),
		rareBoost = 3,
	},
	RapidFire = {
		name = "Rapid Fire",
		icon = "💥",
		description = "The cannons fire twice as fast!",
		color = Color3.fromRGB(255, 140, 50),
		fireRate = 2,
	},
	CrateLuck = {
		name = "Egg Luck",
		icon = "📦",
		description = "Legendary and better Monsters are 2x as likely from Monster Eggs!",
		color = Color3.fromRGB(110, 200, 255),
		crateLuck = 2,
	},
}

-- The Lucky Hour event running right now (or nil), from the attributes the server sets.
function Luck.current()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local id = ReplicatedStorage:GetAttribute("LuckyEvent")
	local ends = ReplicatedStorage:GetAttribute("LuckyEventEnds") or 0
	if id and Luck.EVENTS[id] and game:GetService("Workspace"):GetServerTimeNow() < ends then
		return Luck.EVENTS[id], ends
	end
	return nil, 0
end

return Luck
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Mutations</string>
          <string name="Source"><![CDATA[-- Mutations multiply a Freek's income. They only enter the game from the cannons (chance
-- is per cannon Freek, times Drops.MUTATION_FACTOR); after that they're passed on by
-- fusing (see Breeding.luau). Rarest first.
--
-- A Freek can carry several mutations. They're saved as a list ({ "Rainbow", "Golden" }),
-- or nil for none, and their multipliers stack (Golden + Shadow = x6).

local Mutations = {}

Mutations.list = {
	{ id = "Rainbow", mult = 10, chance = 0.01, color = Color3.fromRGB(255, 120, 255) },
	{ id = "Golden", mult = 3, chance = 0.04, color = Color3.fromRGB(255, 200, 50) },
	{ id = "Shadow", mult = 2, chance = 0.07, color = Color3.fromRGB(160, 90, 255) },
}

Mutations.byId = {}
for index, mutation in Mutations.list do
	mutation.rank = index
	Mutations.byId[mutation.id] = mutation
end

-- A Freek's mutations as a list, rarest first. Accepts a list, a single id (old saves) or nil.
function Mutations.normalize(value): { string }
	local list = {}
	if type(value) == "string" then
		value = { value }
	end
	for _, id in value or {} do
		if Mutations.byId[id] and not table.find(list, id) then
			table.insert(list, id)
		end
	end
	table.sort(list, function(a, b)
		return Mutations.byId[a].rank < Mutations.byId[b].rank
	end)
	return list
end

-- The rarest mutation, which decides how the Freek looks and what colour its name is.
function Mutations.top(value): string?
	return Mutations.normalize(value)[1]
end

-- Combined income multiplier for all of a Freek's mutations.
function Mutations.mult(value): number
	local mult = 1
	for _, id in Mutations.normalize(value) do
		mult *= Mutations.byId[id].mult
	end
	return mult
end

-- The list to store on a Freek record (nil when there are none).
function Mutations.pack(value): { string }?
	local list = Mutations.normalize(value)
	return if #list > 0 then list else nil
end

return Mutations
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Rarities</string>
          <string name="Source"><![CDATA[-- Rarity tiers, lowest to highest. breedTime is in seconds. carrySpeed is how fast a thief
-- walks while carrying a Freek of this rarity (normal walking speed is 16).
-- "Seasonal" isn't a tier: it's a tag a Freek of any rarity can have (see Seasons).

local Rarities = {}

Rarities.order = { "Common", "Uncommon", "Rare", "Legendary", "Mystic", "Ultra", "Secret" }

Rarities.info = {
	Common = { color = Color3.fromRGB(200, 200, 200), breedTime = 30, carrySpeed = 15 },
	Uncommon = { color = Color3.fromRGB(90, 220, 90), breedTime = 60, carrySpeed = 14 },
	Rare = { color = Color3.fromRGB(70, 150, 255), breedTime = 120, carrySpeed = 12.5 },
	Legendary = { color = Color3.fromRGB(255, 180, 40), breedTime = 300, carrySpeed = 11 },
	Mystic = { color = Color3.fromRGB(190, 90, 255), breedTime = 600, carrySpeed = 9.5 },
	Ultra = { color = Color3.fromRGB(255, 60, 100), breedTime = 1200, carrySpeed = 8 },
	Secret = { color = Color3.fromRGB(255, 255, 255), breedTime = 2400, carrySpeed = 6.5 },
}

Rarities.rank = {}
for i, name in Rarities.order do
	Rarities.rank[name] = i
end

return Rarities
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- One place that names every remote. The server creates them; clients wait for them.
--
-- Action          client -> server   (actionName, ...args)
-- State           server -> client   (snapshot of the player's own data)
-- Notify          server -> client   (message, kind?)
-- DiscoveryUpdate server -> client   (speciesId, discovery)
-- Trade           server -> client   ("Request" | "State" | "Closed", payload)
-- Knockback       server -> client   (direction: Vector3, strength: number, seconds: number)
-- LuckResult      server -> client   ({ kind = "crate" | "wheel", ... }) what a crate/spin gave
-- GetState        client -> server   returns snapshot once data has loaded
-- GetDiscoveries  client -> server   returns { [speciesId] = discovery }

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local KINDS = {
	Action = "RemoteEvent",
	State = "RemoteEvent",
	Notify = "RemoteEvent",
	DiscoveryUpdate = "RemoteEvent",
	Trade = "RemoteEvent",
	Knockback = "RemoteEvent",
	LuckResult = "RemoteEvent",
	GetState = "RemoteFunction",
	GetDiscoveries = "RemoteFunction",
}

local Remotes = {}

function Remotes.get(name: string): any
	local className = KINDS[name]
	assert(className, "Unknown remote " .. name)

	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = ReplicatedStorage
		end
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new(className)
			remote.Name = name
			remote.Parent = folder
		end
		return remote
	end

	return ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Seasons</string>
          <string name="Source"><![CDATA[-- Limited events for Seasonal Freeks. A Freek with `season = "Halloween"` can only be bred
-- (or bought, if it has a price) while that event is running. Once owned it's kept forever
-- and still earns, trades and breeds year-round.
--
-- Each event's `window(year)` returns its first and last day (inclusive, UTC) as day
-- numbers (days since 1970-01-01). Windows may run past New Year.

local Seasons = {}

-- Days since 1970-01-01 for a calendar date (proleptic Gregorian).
local function dayNumber(year: number, month: number, day: number): number
	if month <= 2 then
		year -= 1
	end
	local era = year // 400
	local yearOfEra = year - era * 400
	local monthIndex = (month + 9) % 12
	local dayOfYear = (153 * monthIndex + 2) // 5 + day - 1
	local dayOfEra = yearOfEra * 365 + yearOfEra // 4 - yearOfEra // 100 + dayOfYear
	return era * 146097 + dayOfEra - 719468
end

local function weekday(days: number): number
	return (days + 4) % 7 -- 0 = Sunday; 1970-01-01 was a Thursday
end

local function easter(year: number): (number, number)
	local a = year % 19
	local b = year // 100
	local c = year % 100
	local d = b // 4
	local e = b % 4
	local f = (b + 8) // 25
	local g = (b - f + 1) // 3
	local h = (19 * a + b - d - g + 15) % 30
	local i = c // 4
	local k = c % 4
	local l = (32 + 2 * e + 2 * i - h - k) % 7
	local m = (a + 11 * h + 22 * l) // 451
	local month = (h + l - 7 * m + 114) // 31
	local day = (h + l - 7 * m + 114) % 31 + 1
	return month, day
end

local function fixed(fromMonth: number, fromDay: number, toMonth: number, toDay: number)
	return function(year: number)
		local first = dayNumber(year, fromMonth, fromDay)
		local toYear = if toMonth < fromMonth then year + 1 else year
		return first, dayNumber(toYear, toMonth, toDay)
	end
end

Seasons.list = {
	Halloween = {
		name = "Halloween",
		color = Color3.fromRGB(255, 130, 20),
		window = fixed(10, 1, 10, 31),
	},
	Thanksgiving = {
		name = "Thanksgiving",
		color = Color3.fromRGB(200, 120, 50),
		-- Nov 1 through the Sunday after Thanksgiving (4th Thursday of November).
		window = function(year)
			local nov1 = dayNumber(year, 11, 1)
			local firstThursday = nov1 + (4 - weekday(nov1)) % 7
			return nov1, firstThursday + 21 + 3
		end,
	},
	Christmas = {
		name = "Christmas",
		color = Color3.fromRGB(230, 50, 60),
		window = fixed(12, 1, 12, 26),
	},
	NewYears = {
		name = "New Years",
		color = Color3.fromRGB(255, 215, 90),
		window = fixed(12, 27, 1, 7),
	},
	Easter = {
		name = "Easter",
		color = Color3.fromRGB(255, 170, 220),
		-- Two weeks before Easter Sunday through Easter Monday.
		window = function(year)
			local month, day = easter(year)
			local sunday = dayNumber(year, month, day)
			return sunday - 14, sunday + 1
		end,
	},
	America = {
		name = "America",
		color = Color3.fromRGB(70, 120, 255),
		-- The week around July 4th.
		window = fixed(6, 28, 7, 7),
	},
}

function Seasons.isActive(seasonId: string?, now: number?): boolean
	local season = seasonId and Seasons.list[seasonId]
	if not season then
		return false
	end
	local today = (now or os.time()) // 86400
	local year = os.date("!*t", now or os.time()).year
	-- Check last year's window too, for events that run past New Year.
	for _, y in { year - 1, year } do
		local first, last = season.window(y)
		if today >= first and today <= last then
			return true
		end
	end
	return false
end

-- True if this species can be obtained right now (always true for non-seasonal Freeks).
function Seasons.available(species, now: number?): boolean
	return species.season == nil or Seasons.isActive(species.season, now)
end

-- The events running right now, e.g. { "Halloween" }.
function Seasons.active(now: number?): { string }
	local list = {}
	for id in Seasons.list do
		if Seasons.isActive(id, now) then
			table.insert(list, id)
		end
	end
	table.sort(list)
	return list
end

return Seasons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">WeaponModel</string>
          <string name="Source"><![CDATA[-- Builds the Tool for a weapon from its part list in Weapons.luau.
--
-- Part list format (same as Freeks), in studs, relative to the grip:
--   { shape = "Ball" | "Block" | "Cylinder" | "Wedge", size = { x, y, z } (or one number),
--     pos = { x, y, z }, rot = { x, y, z } (degrees), color = Color3,
--     material = "Neon" etc. (optional), transparency = 0-1 (optional) }
-- The first part becomes the Handle (where the hand holds it). It must not be rotated, since
-- its orientation decides how the weapon sits in the hand; hide a plain block inside the
-- visible grip if needed. Guns point toward -Z; melee weapons extend toward +Z.

local Weapons = require(script.Parent.Weapons)

local WeaponModel = {}

local SHAPES = {
	Ball = Enum.PartType.Ball,
	Block = Enum.PartType.Block,
	Cylinder = Enum.PartType.Cylinder,
}

local function vector(value): Vector3
	if type(value) == "number" then
		return Vector3.one * value
	end
	return Vector3.new(value[1], value[2], value[3])
end

function WeaponModel.build(weaponId: string): Tool
	local weapon = Weapons.list[weaponId]
	local tool = Instance.new("Tool")
	tool.Name = weapon.name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = weapon.description
	if weapon.kind == "melee" then
		-- Held like Roblox's classic sword: pointing up and forward from the hand.
		tool.GripForward = Vector3.new(-1, 0, 0)
		tool.GripRight = Vector3.new(0, 1, 0)
		tool.GripUp = Vector3.new(0, 0, 1)
		tool.GripPos = Vector3.zero
	end
	tool:SetAttribute("WeaponId", weaponId)

	local handle
	for i, spec in weapon.model do
		local part
		if spec.shape == "Wedge" then
			part = Instance.new("WedgePart")
		else
			part = Instance.new("Part")
			part.Shape = SHAPES[spec.shape or "Block"] or Enum.PartType.Block
		end
		part.Name = if i == 1 then "Handle" else "Part" .. i
		part.Size = vector(spec.size)
		local rot = spec.rot or { 0, 0, 0 }
		-- Every part is placed in the tool's own space (not relative to the handle's rotation).
		part.CFrame = CFrame.new(vector(spec.pos)) * CFrame.Angles(math.rad(rot[1]), math.rad(rot[2]), math.rad(rot[3]))
		part.Color = spec.color or Color3.new(1, 1, 1)
		part.Material = Enum.Material[spec.material or "SmoothPlastic"]
		part.Transparency = spec.transparency or 0
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.CanCollide = false
		part.CanTouch = false
		part.Massless = true
		part.Anchored = false
		if handle then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = part
			weld.Parent = part
		else
			handle = part
		end
		part.Parent = tool
	end
	return tool
end

return WeaponModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
