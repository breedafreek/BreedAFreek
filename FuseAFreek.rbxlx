			},
			{
				shape = "Cylinder",
				size = { 1.5, 0.5, 0.5 },
				pos = { 0, 1.1, 1.2 },
				rot = { 0, 90, 0 },
				color = Color3.fromRGB(255, 250, 200),
				material = "Glass",
				transparency = 0.25,
			},
			{
				shape = "Cylinder",
				size = { 0.9, 0.75, 0.75 },
				pos = { 0, 1.95, -0.4 },
				rot = { 0, 0, 90 },
				color = Color3.fromRGB(150, 255, 90),
				material = "Glass",
				transparency = 0.3,
			},
			{
				shape = "Cylinder",
				size = { 0.12, 0.8, 0.8 },
				pos = { 0, 2.42, -0.4 },
				rot = { 0, 0, 90 },
				color = Color3.fromRGB(60, 150, 50),
			},
			{
				shape = "Block",
				size = { 0.2, 0.45, 0.2 },
				pos = { 0, 0.3, -0.5 },
				color = Color3.fromRGB(255, 220, 60),
			},
		},
	},
}

return Weapons
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="25">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="26">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">ActionService</string>
          <string name="Source"><![CDATA[-- Everything a player can ask the server to do. Every argument from the client is
-- untrusted, so each handler re-checks ownership, money and limits itself.

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Carried = require(script.Parent.Carried)
local DataService = require(script.Parent.DataService)
local DiscoveryService = require(script.Parent.DiscoveryService)
local Recipes = require(script.Parent.Recipes)

local ActionService = {}

local notifyRemote = Remotes.get("Notify")
local stateRemote = Remotes.get("State")
local rng = Random.new()
local lastAction = {} -- [Player] = os.clock()

local function notify(player: Player, message: string, kind: string?)
	notifyRemote:FireClient(player, message, kind)
end

-- What the client is allowed to see of its own save.
local function snapshot(data)
	return {
		rebirths = data.rebirths,
		money = data.money,
		slots = FreekUtil.totalSlots(data),
		boughtSlots = data.slots,
		passSlots = data.passSlots or 0,
		freeks = data.freeks,
		breeding = data.breeding,
		breeding2 = data.breeding2,
		discovered = data.discovered,
		crates = data.crates,
		lastSpin = data.lastSpin,
	}
end

-- Adds a Freek, puts it in the yard if there's room, and records the discovery. income is
-- only given for fused Freeks (others earn their species' income).
local function giveFreek(player: Player, data, species: string, mutations: { string }?, income: number?)
	local uid = HttpService:GenerateGUID(false)
	data.freeks[uid] = {
		species = species,
		mutations = Mutations.pack(mutations),
		income = income,
		slot = FreekUtil.freeSlot(data),
	}
	local isNew = not data.discovered[species]
	data.discovered[species] = true
	task.spawn(DiscoveryService.claim, player, species)
	return uid, isNew
end

ActionService.giveFreek = giveFreek

local function ownedFreek(data, uid: any)
	if typeof(uid) ~= "string" then
		return nil
	end
	return data.freeks[uid]
end

local handlers = {}

function handlers.BuySlot(player: Player, data)
	if data.slots >= Config.MAX_SLOTS then
		return notify(player, "Your barn is as big as it gets!", "error")
	end
	local price = Config.slotPrice(data.slots)
	if data.money < price then
		return notify(player, "Not enough money! A new slot costs " .. Format.money(price), "error")
	end
	data.money -= price
	data.slots += 1
	notify(player, "Your barn grew! You now have " .. data.slots .. " slots.", "success")
end

function handlers.Place(player: Player, data, uid: any)
	local freek = ownedFreek(data, uid)
	if not freek or freek.breeding or freek.slot or Carried.is(player, uid) then
		return
	end
	local slot = FreekUtil.freeSlot(data)
	if not slot then
		return notify(player, "Your barn is full! Buy more slots or remove a Freek.", "error")
	end
	freek.slot = slot
end

function handlers.Unplace(_player: Player, data, uid: any)
	local freek = ownedFreek(data, uid)
	if freek then
		freek.slot = nil
	end
end

function handlers.Sell(player: Player, data, uid: any)
	local freek = ownedFreek(data, uid)
	if not freek or freek.breeding then
		return
	end
	if Carried.is(player, uid) then
		return notify(player, "That Freek is being carried right now!", "error")
	end
	local value = FreekUtil.sellValue(freek)
	data.freeks[uid] = nil
	data.money += value
	notify(player, "Sold " .. FreekUtil.displayName(freek) .. " for " .. Format.money(value), "money")
end

-- penIndex is optional: with no pen given, the first free pen is used.
function handlers.StartBreed(player: Player, data, uidA: any, uidB: any, penIndex: any)
	local pens = GamePasses.penCount(player)
	local index = nil
	if typeof(penIndex) == "number" and penIndex >= 1 and penIndex <= pens and not FreekUtil.pen(data, penIndex) then
		index = penIndex
	else
		for i = 1, pens do
			if not FreekUtil.pen(data, i) then
				index = i
				break
			end
		end
	end
	if not index then
		return notify(
			player,
			if pens > 1 then "Both your Fusion Dens are busy!" else "Your Fusion Den is already busy!",
			"error"
		)
	end
	local a, b = ownedFreek(data, uidA), ownedFreek(data, uidB)
	if not a or not b or uidA == uidB or a.breeding or b.breeding then
		return
	end
	if Carried.is(player, uidA) or Carried.is(player, uidB) then
		return notify(player, "That Freek is being carried right now!", "error")
	end
	a.slot, b.slot = nil, nil
	a.breeding, b.breeding = true, true
	local duration = math.ceil(FreekUtil.breedTime(a, b) * GamePasses.breedTimeMultiplier(player))
	data[FreekUtil.PEN_KEYS[index]] = { a = uidA, b = uidB, endsAt = os.time() + duration }
	notify(player, "Fusing started! Ready in " .. Format.time(duration) .. ".", "success")
end

-- penIndex is optional: with no pen given, the first ready pen is collected.
function handlers.ClaimBreed(player: Player, data, penIndex: any)
	local index = nil
	for i in FreekUtil.PEN_KEYS do
		local pen = FreekUtil.pen(data, i)
		if pen and os.time() >= pen.endsAt and (penIndex == nil or penIndex == i) then
			index = i
			break
		end
	end
	if not index then
		return
	end
	local key = FreekUtil.PEN_KEYS[index]
	local breeding = data[key]
	local a, b = data.freeks[breeding.a], data.freeks[breeding.b]
	data[key] = nil
	if not a or not b then
		return
	end
	-- Both parents are used up and become the fused Freek.
	local species, mutations, income = Recipes.roll(a, b, rng)
	data.freeks[breeding.a] = nil
	data.freeks[breeding.b] = nil
	local _, isNew = giveFreek(player, data, species, mutations, income)

	local name = FreekUtil.displayName({ species = species, mutations = mutations })
	if isNew then
		notify(player, "NEW FREEK! You fused a " .. name .. "!", "discovery")
	else
		notify(player, "You fused a " .. name .. "!", "success")
	end
end

local quiet = {} -- actions that don't change saved data, so skip the refresh

-- Lets other services add actions (they get the same rate limit and refresh).
-- Pass isQuiet = true for actions that never change the player's data.
function ActionService.register(name: string, handler, isQuiet: boolean?)
	handlers[name] = handler
	quiet[name] = isQuiet == true
end

function ActionService.init()
	Remotes.get("GetState").OnServerInvoke = function(player)
		local data = DataService.waitFor(player)
		return data and snapshot(data)
	end

	DataService.onChanged(function(player, data)
		stateRemote:FireClient(player, snapshot(data))
	end)

	Remotes.get("Action").OnServerEvent:Connect(function(player, action, ...)
		local handler = typeof(action) == "string" and handlers[action]
		local data = DataService.get(player)
		if not handler or not data then
			return
		end
		local now = os.clock()
		if lastAction[player] and now - lastAction[player] < 0.15 then
			return
		end
		lastAction[player] = now

		local ok, err = pcall(handler, player, data, ...)
		if not ok then
			warn("Action", action, "failed for", player.Name, err)
		end
		if not quiet[action] then
			DataService.changed(player)
		end
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
	end)
end

return ActionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">AdminService</string>
          <string name="Source"><![CDATA[-- The admin panel's server side. Only admins (Config.ADMIN_NAMES / ADMIN_USER_IDS, or
-- anyone in Studio) get the IsAdmin attribute, and every command checks again here, so a
-- hacked client can't use it.
--
-- Commands (Admin remote, returns ok, message):
--   "event"    { id, minutes, everywhere }  start an event now (big, weather or Lucky Hour)
--   "stop"     { everywhere }               end whatever is running
--   "spawn"    { species, mutation }         fire that Freek from a cannon in this server
--   "announce" { text, everywhere }          a message on everyone's screen
--   "money"    { amount }                    give yourself coins (for testing)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Events = require(ReplicatedStorage.Shared.Events)
local Freeks = require(ReplicatedStorage.Shared.Freeks)
local Luck = require(ReplicatedStorage.Shared.Luck)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local CannonService = require(script.Parent.CannonService)
local DataService = require(script.Parent.DataService)
local EventService = require(script.Parent.EventService)

local AdminService = {}

function AdminService.isAdmin(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	return table.find(Config.ADMIN_NAMES, player.Name) ~= nil or table.find(Config.ADMIN_USER_IDS, player.UserId) ~= nil
end

-- Filters announcement text the way Roblox requires for text everyone sees.
local function filter(player: Player, text: string): string?
	local ok, result = pcall(function()
		return TextService:FilterStringAsync(text, player.UserId):GetNonChatStringForBroadcastAsync()
	end)
	if ok then
		return result
	end
	return if RunService:IsStudio() then text else nil
end

local commands = {}

function commands.event(_player: Player, args)
	local id = args.id
	if not (Events.BIG[id] or Events.WEATHER[id] or Luck.EVENTS[id]) then
		return false, "Unknown event"
	end
	local minutes = math.clamp(tonumber(args.minutes) or 15, 1, 180)
	local ends = Workspace:GetServerTimeNow() + minutes * 60
	EventService.send({ type = "event", id = id, ends = ends }, args.everywhere == true)
	return true, "Started for " .. minutes .. " min" .. (if args.everywhere then " in every server" else " here")
end

function commands.stop(_player: Player, args)
	-- Keep it ended until whatever's running now would have finished.
	local ends = math.max(
		ReplicatedStorage:GetAttribute("EventEnds") or 0,
		ReplicatedStorage:GetAttribute("WeatherEnds") or 0,
		Workspace:GetServerTimeNow() + 5
	)
	EventService.send({ type = "end", ends = ends }, args.everywhere == true)
	return true, "Events ended" .. (if args.everywhere then " in every server" else " here")
end

function commands.spawn(_player: Player, args)
	local species = Freeks.byId[args.species]
	if not species or species.look.hybrid then
		return false, "Unknown Freek"
	end
	local mutation = args.mutation
	local mutations = if mutation and Mutations.byId[mutation] then { mutation } else nil
	CannonService.fireNow(species.id, mutations)
	return true, "Fired " .. (if mutation then mutation .. " " else "") .. species.name .. "!"
end

function commands.announce(player: Player, args)
	local text = type(args.text) == "string" and string.sub(args.text, 1, 120) or ""
	if text == "" then
		return false, "Type a message first"
	end
	local filtered = filter(player, text)
	if not filtered then
		return false, "Couldn't check that message, try again"
	end
	EventService.send({ type = "announce", text = filtered }, args.everywhere == true)
	return true, "Sent"
end

function commands.money(player: Player, args)
	local data = DataService.get(player)
	if not data then
		return false, "Your data isn't loaded yet"
	end
	local amount = math.clamp(tonumber(args.amount) or 0, 0, 1e12)
	data.money += amount
	DataService.changed(player)
	return true, "Added coins"
end

function AdminService.init()
	local remote = Remotes.get("Admin")
	remote.OnServerInvoke = function(player: Player, command: any, args: any)
		if not AdminService.isAdmin(player) then
			return false, "Not allowed"
		end
		local handler = type(command) == "string" and commands[command]
		if not handler then
			return false, "Unknown command"
		end
		local ok, result, message = pcall(handler, player, type(args) == "table" and args or {})
		if not ok then
			warn("[AdminService] " .. tostring(result))
			return false, "Something went wrong"
		end
		return result, message
	end
	local function mark(player: Player)
		player:SetAttribute("IsAdmin", AdminService.isAdmin(player) or nil)
	end
	Players.PlayerAdded:Connect(mark)
	for _, player in Players:GetPlayers() do
		mark(player)
	end
end

return AdminService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Barn</string>
          <string name="Source"><![CDATA[-- Each player's yard is a big red barn: plank floor, red walls with white trim, a gambrel
-- roof, and two big doors at the front that always stand slid open. When the owner locks
-- up, a red barrier fills the doorway. The Freek pads and the Fusion Dens are inside
-- (PlotService places those).
--
-- Coordinates are the plot's: origin on the ground at the plot's centre, the doors on
-- the -Z side facing the town square, the floor's top at y = 1.
--
-- The roof is solid, so the camera stays under it while you're inside; an invisible
-- ceiling on top of the walls also stops anyone getting in from above.

local Decor = require(script.Parent.Decor)

local Barn = {}

Barn.SIZE = 64
Barn.WALL_HEIGHT = 18
Barn.DOOR_WIDTH = 14
Barn.DOOR_HEIGHT = 13

local RED = Color3.fromRGB(168, 40, 36)
local WHITE = Color3.fromRGB(245, 242, 235)
local ROOF = Color3.fromRGB(72, 58, 62)
local FLOOR = Color3.fromRGB(150, 108, 72)

local part = Decor.part

local function wedge(props)
	return part(props, "WedgePart")
end

-- A sliding door: red planks with a white frame and a white X.
local function buildDoor(parent: Instance, closed: CFrame, index: number)
	local model = Instance.new("Model")
	model.Name = "BarnDoor"
	local w, h = Barn.DOOR_WIDTH / 2 + 0.2, Barn.DOOR_HEIGHT + 0.2
	local panel = part({
		Name = "DoorPanel",
		Size = Vector3.new(w, h, 0.6),
		CFrame = closed,
		Color = RED,
		Material = Enum.Material.WoodPlanks,
		CollisionGroup = "Gate" .. index,
		Parent = model,
	})
	model.PrimaryPart = panel
	local trim = {
		{ Vector3.new(w, 0.6, 0.8), Vector3.new(0, h / 2 - 0.3, 0) },
		{ Vector3.new(w, 0.6, 0.8), Vector3.new(0, -h / 2 + 0.3, 0) },
		{ Vector3.new(0.6, h, 0.8), Vector3.new(w / 2 - 0.3, 0, 0) },
		{ Vector3.new(0.6, h, 0.8), Vector3.new(-w / 2 + 0.3, 0, 0) },
	}
	for _, piece in trim do
		part({
			Name = "DoorTrim",
			Size = piece[1],
			CFrame = closed * CFrame.new(piece[2]),
			Color = WHITE,
			CanCollide = false,
			Parent = model,
		})
	end
	local length = math.sqrt((w - 1.2) ^ 2 + (h - 1.2) ^ 2)
	local angle = math.atan2(h - 1.2, w - 1.2)
	for _, sign in { -1, 1 } do
		part({
			Name = "DoorTrim",
			Size = Vector3.new(length, 0.6, 0.8),
			CFrame = closed * CFrame.Angles(0, 0, sign * angle),
			Color = WHITE,
			CanCollide = false,
			Parent = model,
		})
	end
	model.Parent = parent
	return model
end

-- The finishing touches, in the chunky cartoon style of the big farm games: board-and-batten
-- walls, a hayloft door with hay spilling out and a hoist above it, shingle rows on the
-- roof, shutters and flower boxes on the windows, a window on the front opposite the name
-- plaque, and barrels, a water trough and milk churns outside. Roof pieces go in the Roof
-- folder so they rise with the extra storey (BarnUpgrades).
local BATTEN = Color3.fromRGB(135, 28, 30)
local SHUTTER = Color3.fromRGB(60, 150, 110)
local WOOD = Color3.fromRGB(150, 100, 60)
local DARK_WOOD = Color3.fromRGB(105, 68, 40)
local HAY = Color3.fromRGB(240, 205, 95)
local FLOWERS = {
	Color3.fromRGB(255, 90, 140),
	Color3.fromRGB(255, 210, 60),
	Color3.fromRGB(150, 110, 255),
	Color3.fromRGB(255, 140, 60),
	Color3.fromRGB(90, 200, 255),
}

-- A white X-braced panel (door or shutter look) centred at cframe, facing its -Z.
local function bracedPanel(parent: Instance, cframe: CFrame, w: number, h: number, color: Color3, name: string)
	part({ Name = name, Size = Vector3.new(w, h, 0.4), CFrame = cframe, Color = color, Parent = parent })
	local t = math.min(w, h) * 0.12
	for _, piece in
		{
			{ Vector3.new(w, t, 0.5), Vector3.new(0, h / 2 - t / 2, 0) },
			{ Vector3.new(w, t, 0.5), Vector3.new(0, -h / 2 + t / 2, 0) },
			{ Vector3.new(t, h, 0.5), Vector3.new(w / 2 - t / 2, 0, 0) },
			{ Vector3.new(t, h, 0.5), Vector3.new(-w / 2 + t / 2, 0, 0) },
		}
	do
		part({
			Name = "DoorTrim",
			Size = piece[1],
			CFrame = cframe * CFrame.new(piece[2]) * CFrame.new(0, 0, -0.05),
			Color = WHITE,
			CanCollide = false,
			Parent = parent,
		})
	end
	local length = math.sqrt((w - 2 * t) ^ 2 + (h - 2 * t) ^ 2)
	local angle = math.atan2(h - 2 * t, w - 2 * t)
	for _, sign in { -1, 1 } do
		part({
			Name = "DoorTrim",
			Size = Vector3.new(length, t * 0.9, 0.5),
			CFrame = cframe * CFrame.new(0, 0, -0.05) * CFrame.Angles(0, 0, sign * angle),
			Color = WHITE,
			CanCollide = false,
			Parent = parent,
		})
	end
end

-- A flower box hanging under a window: a wooden box of soil with a row of bright blooms.
local function flowerBox(parent: Instance, cframe: CFrame, width: number, seed: number)
	part({
		Name = "FlowerBox",
		Size = Vector3.new(width, 1, 1.2),
		CFrame = cframe,
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
		CanCollide = false,
		Parent = parent,
	})
	local count = math.floor(width / 1.1)
	for k = 1, count do
		local x = (k - (count + 1) / 2) * (width / count)
		part({
			Name = "Leaf",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.9,
			CFrame = cframe * CFrame.new(x, 0.6, 0),
			Color = Color3.fromRGB(80, 170, 70),
			CanCollide = false,
			Parent = parent,
		})
		part({
			Name = "Flower",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.8,
			CFrame = cframe * CFrame.new(x, 1.15, -0.1),
			Color = FLOWERS[(k + seed) % #FLOWERS + 1],
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function barrel(parent: Instance, ground: CFrame)
	part({
		Name = "Barrel",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3.2, 2.6, 2.6),
		CFrame = ground * CFrame.new(0, 1.6, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
		Parent = parent,
	})
	for _, y in { 0.6, 2.6 } do
		part({
			Name = "BarrelHoop",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 2.75, 2.75),
			CFrame = ground * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.pi / 2),
			Color = Color3.fromRGB(70, 70, 80),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function churn(parent: Instance, ground: CFrame)
	part({
		Name = "MilkChurn",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 1.3, 1.3),
		CFrame = ground * CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(200, 205, 215),
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Name = "MilkChurn",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 0.8, 0.8),
		CFrame = ground * CFrame.new(0, 2.2, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(80, 160, 230),
		CanCollide = false,
		Parent = parent,
	})
end

local function addDetails(decor: Instance, roof: Instance, origin: CFrame, index: number)
	local half = Barn.SIZE / 2 - 0.5
	local top = 1 + Barn.WALL_HEIGHT
	local doorHalf = Barn.DOOR_WIDTH / 2
	local battenHeight = Barn.WALL_HEIGHT - 2.2
	local battenY = 1.6 + battenHeight / 2
	local function batten(cframe: CFrame)
		part({
			Name = "Batten",
			Size = Vector3.new(0.6, battenHeight, 0.3),
			CFrame = cframe,
			Color = BATTEN,
			Material = Enum.Material.WoodPlanks,
			CanCollide = false,
			Parent = decor,
		})
	end
	-- Board-and-batten: dark strips down the outside of every wall, skipping the doorway and
	-- the windows.
	for x = -half + 4, half - 4, 4 do
		if math.abs(x) > doorHalf + 2 and math.abs(x - 21) > 4.5 then
			batten(origin * CFrame.new(x, battenY, -half - 0.6))
		end
		batten(origin * CFrame.new(x, battenY, half + 0.6))
	end
	for z = -half + 4, half - 4, 4 do
		if math.abs(math.abs(z) - 12) > 4 then
			for _, side in { -1, 1 } do
				batten(origin * CFrame.new(side * (half + 0.6), battenY, z) * CFrame.Angles(0, math.pi / 2, 0))
			end
		end
	end

	-- Shutters and flower boxes on the side windows (outside).
	for _, side in { -1, 1 } do
		for k, z in { -12, 12 } do
			local face = origin * CFrame.new(side * (half + 0.75), 11, z) * CFrame.Angles(0, side * -math.pi / 2, 0)
			for _, dx in { -1, 1 } do
				bracedPanel(decor, face * CFrame.new(dx * 4.4, 0, 0), 2.6, 6.2, SHUTTER, "Shutter")
			end
			flowerBox(decor, face * CFrame.new(0, -3.7, -0.4), 6.4, index + k + side)
		end
	end

	-- The front window opposite the name plaque, with shutters and a flower box.
	local front = origin * CFrame.new(21, 9, -half - 0.6) * CFrame.Angles(0, 0, 0)
	part({
		Name = "WindowFrame",
		Size = Vector3.new(6, 6, 0.4),
		CFrame = front,
		Color = WHITE,
		CanCollide = false,
		Parent = decor,
	})
	part({
		Name = "WindowPane",
		Size = Vector3.new(5, 5, 0.45),
		CFrame = front,
		Color = Color3.fromRGB(255, 220, 140),
		Material = Enum.Material.Neon,
		Transparency = 0.25,
		CanCollide = false,
		Parent = decor,
	})
	for _, bar in { Vector3.new(0.4, 5, 0.5), Vector3.new(5, 0.4, 0.5) } do
		part({ Name = "WindowBar", Size = bar, CFrame = front, Color = WHITE, CanCollide = false, Parent = decor })
	end
	for _, dx in { -1, 1 } do
		bracedPanel(decor, front * CFrame.new(dx * 4.4, 0, -0.1), 2.6, 6.2, SHUTTER, "Shutter")
	end
	flowerBox(decor, front * CFrame.new(0, -3.7, -0.5), 6.4, index)

	-- Hayloft door high on the front gable, hay spilling out, and the hoist beam above.
	local loft = origin * CFrame.new(0, top + 4.6, -half - 0.6)
	part({
		Name = "LoftDark",
		Size = Vector3.new(7.4, 6.4, 0.3),
		CFrame = loft * CFrame.new(0, 0, 0.1),
		Color = Color3.fromRGB(45, 25, 20),
		CanCollide = false,
		Parent = roof,
	})
	for _, dx in { -1, 1 } do
		-- The two loft doors stand open, swung out to the sides.
		bracedPanel(roof, loft * CFrame.new(dx * 5.6, 0, -0.1), 3.6, 6.4, RED, "DoorPanel")
	end
	part({
		Name = "LoftSill",
		Size = Vector3.new(8.2, 0.6, 1.6),
		CFrame = loft * CFrame.new(0, -3.4, -0.6),
		Color = WHITE,
		CanCollide = false,
		Parent = roof,
	})
	for k = 1, 7 do
		part({
			Name = "Hay",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (1.2 + (k % 3) * 0.35),
			CFrame = loft * CFrame.new((k - 4) * 0.95, -2.5 + (k % 2) * 0.4, -0.6),
			Color = HAY:Lerp(Color3.fromRGB(210, 165, 60), (k % 3) / 3),
			Material = Enum.Material.Sand,
			CanCollide = false,
			Parent = roof,
		})
	end
	part({
		Name = "HoistBeam",
		Size = Vector3.new(1.2, 1.2, 5),
		CFrame = loft * CFrame.new(0, 5, -2.2),
		Color = DARK_WOOD,
		Material = Enum.Material.WoodPlanks,
		CanCollide = false,
		Parent = roof,
	})
	part({
		Name = "HoistRope",
		Size = Vector3.new(0.2, 4, 0.2),
		CFrame = loft * CFrame.new(0, 2.6, -4.2),
		Color = Color3.fromRGB(200, 170, 110),
		CanCollide = false,
		Parent = roof,
	})
	part({
		Name = "HoistHook",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.7,
		CFrame = loft * CFrame.new(0, 0.5, -4.2),
		Color = Color3.fromRGB(70, 70, 80),
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = roof,
	})
	-- A round window high on the back gable.
	local back = origin * CFrame.new(0, top + 6, half + 0.6)
	part({
		Name = "WindowFrame",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 6, 6),
		CFrame = back * CFrame.Angles(0, math.pi / 2, 0),
		Color = WHITE,
		CanCollide = false,
		Parent = roof,
	})
	part({
		Name = "WindowPane",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.45, 4.6, 4.6),
		CFrame = back * CFrame.Angles(0, math.pi / 2, 0),
		Color = Color3.fromRGB(255, 220, 140),
		Material = Enum.Material.Neon,
		Transparency = 0.25,
		CanCollide = false,
		Parent = roof,
	})

	-- Shingle rows across each roof slope.
	local profile = {
		Vector2.new(-(half + 1.5), top - 0.6),
		Vector2.new(-23, top + 10.4),
		Vector2.new(0, top + 15.4),
		Vector2.new(23, top + 10.4),
		Vector2.new(half + 1.5, top - 0.6),
	}
	for i = 1, #profile - 1 do
		local a, b = profile[i], profile[i + 1]
		local angle = math.atan2(b.Y - a.Y, b.X - a.X)
		local normal = Vector2.new(-math.sin(angle), math.cos(angle))
		local rows = if (b - a).Magnitude > 15 then 4 else 2
		for k = 1, rows do
			local p = a:Lerp(b, k / (rows + 1)) + normal * 0.55
			part({
				Name = "RoofShingle",
				Size = Vector3.new(0.9, 0.45, Barn.SIZE + 2),
				CFrame = origin * CFrame.new(p.X, p.Y, 0) * CFrame.Angles(0, 0, angle),
				Color = ROOF:Lerp(Color3.new(0, 0, 0), 0.3),
				Material = Enum.Material.Slate,
				CanCollide = false,
				Parent = roof,
			})
		end
	end

	-- Outside: barrels by the front left corner, a water trough and churns by the right.
	barrel(decor, origin * CFrame.new(-29, 0, -half - 3))
	barrel(decor, origin * CFrame.new(-26.2, 0, -half - 2.6))
	churn(decor, origin * CFrame.new(-27.7, 0, -half - 5))
	local trough = origin * CFrame.new(28.5, 0, -half - 3.2)
	part({
		Name = "Trough",
		Size = Vector3.new(6, 1.8, 2.6),
		CFrame = trough * CFrame.new(0, 1.2, 0),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
		Parent = decor,
	})
	part({
		Name = "TroughWater",
		Size = Vector3.new(5.2, 0.2, 1.9),
		CFrame = trough * CFrame.new(0, 2, 0),
		Color = Color3.fromRGB(90, 190, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		CanCollide = false,
		Parent = decor,
	})
	for _, dx in { -2.4, 2.4 } do
		part({
			Name = "TroughLeg",
			Size = Vector3.new(0.6, 0.6, 3),
			CFrame = trough * CFrame.new(dx, 0.3, 0),
			Color = DARK_WOOD,
			CanCollide = false,
			Parent = decor,
		})
	end
	churn(decor, origin * CFrame.new(24.6, 0, -half - 3))
end

-- Builds the barn. Returns { barrier, locked } for Barn.setLocked.
function Barn.build(folder: Instance, decor: Instance, origin: CFrame, index: number)
	local half = Barn.SIZE / 2 - 0.5 -- wall centre lines
	local top = 1 + Barn.WALL_HEIGHT
	local doorHalf = Barn.DOOR_WIDTH / 2
	local doorTop = 1 + Barn.DOOR_HEIGHT

	part({
		Name = "Base",
		Size = Vector3.new(Barn.SIZE, 1, Barn.SIZE),
		CFrame = origin * CFrame.new(0, 0.5, 0),
		Color = FLOOR,
		Material = Enum.Material.WoodPlanks,
		Parent = folder,
	})

	-- Walls, with the doorway in the middle of the front.
	local side = (Barn.SIZE - Barn.DOOR_WIDTH) / 2
	local walls = {
		{ Vector3.new(Barn.SIZE, Barn.WALL_HEIGHT, 1), Vector3.new(0, 1 + Barn.WALL_HEIGHT / 2, half) },
		{ Vector3.new(1, Barn.WALL_HEIGHT, Barn.SIZE), Vector3.new(-half, 1 + Barn.WALL_HEIGHT / 2, 0) },
		{ Vector3.new(1, Barn.WALL_HEIGHT, Barn.SIZE), Vector3.new(half, 1 + Barn.WALL_HEIGHT / 2, 0) },
		{
			Vector3.new(side, Barn.WALL_HEIGHT, 1),
			Vector3.new(-(doorHalf + side / 2), 1 + Barn.WALL_HEIGHT / 2, -half),
		},
		{ Vector3.new(side, Barn.WALL_HEIGHT, 1), Vector3.new(doorHalf + side / 2, 1 + Barn.WALL_HEIGHT / 2, -half) },
		{ Vector3.new(Barn.DOOR_WIDTH, top - doorTop, 1), Vector3.new(0, (top + doorTop) / 2, -half) },
	}
	for _, wall in walls do
		part({
			Name = "Wall",
			Size = wall[1],
			CFrame = origin * CFrame.new(wall[2]),
			Color = RED,
			Material = Enum.Material.WoodPlanks,
			Parent = folder,
		})
	end
	part({
		Name = "Ceiling",
		Size = Vector3.new(Barn.SIZE - 1, 1.2, Barn.SIZE - 1),
		CFrame = origin * CFrame.new(0, top + 0.6, 0),
		Transparency = 1,
		Parent = folder,
	})

	-- White corner posts, a white band along the top of the walls, and a stone footing.
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			part({
				Name = "CornerTrim",
				Size = Vector3.new(1.6, Barn.WALL_HEIGHT + 0.4, 1.6),
				CFrame = origin * CFrame.new(x * (half + 0.1), 1 + Barn.WALL_HEIGHT / 2, z * (half + 0.1)),
				Color = WHITE,
				Parent = decor,
			})
		end
	end
	for _, band in
		{
			{ Vector3.new(Barn.SIZE + 0.4, 0.8, 1.4), Vector3.new(0, top - 0.4, -half) },
			{ Vector3.new(Barn.SIZE + 0.4, 0.8, 1.4), Vector3.new(0, top - 0.4, half) },
			{ Vector3.new(1.4, 0.8, Barn.SIZE + 0.4), Vector3.new(-half, top - 0.4, 0) },
			{ Vector3.new(1.4, 0.8, Barn.SIZE + 0.4), Vector3.new(half, top - 0.4, 0) },
		}
	do
		part({ Name = "EaveTrim", Size = band[1], CFrame = origin * CFrame.new(band[2]), Color = WHITE, Parent = decor })
		part({
			Name = "Footing",
			Size = band[1] + Vector3.new(0.4, 0.6, 0.4),
			CFrame = origin * CFrame.new(band[2].X, 0.7, band[2].Z),
			Color = Color3.fromRGB(150, 145, 140),
			Material = Enum.Material.Slate,
			Parent = decor,
		})
	end

	-- Windows on both side walls (inside and out).
	for _, x in { -1, 1 } do
		for _, z in { -12, 12 } do
			for _, face in { 1, -1 } do
				local spot = origin * CFrame.new(x * (half + face * 0.55), 11, z)
				part({
					Name = "WindowFrame",
					Size = Vector3.new(0.3, 6, 6),
					CFrame = spot,
					Color = WHITE,
					CanCollide = false,
					Parent = decor,
				})
				part({
					Name = "WindowPane",
					Size = Vector3.new(0.35, 5, 5),
					CFrame = spot,
					Color = Color3.fromRGB(70, 95, 120),
					Material = Enum.Material.Glass,
					CanCollide = false,
					Parent = decor,
				})
				for _, bar in { Vector3.new(0.4, 5, 0.4), Vector3.new(0.4, 0.4, 5) } do
					part({
						Name = "WindowBar",
						Size = bar,
						CFrame = spot,
						Color = WHITE,
						CanCollide = false,
						Parent = decor,
					})
				end
			end
		end
	end

	-- Gambrel roof: four slopes along the barn, front to back, plus the gable ends.
	local roof = Instance.new("Folder")
	roof.Name = "Roof"
	roof.Parent = folder
	local profile = {
		Vector2.new(-(half + 1.5), top - 0.6),
		Vector2.new(-23, top + 10.4),
		Vector2.new(0, top + 15.4),
		Vector2.new(23, top + 10.4),
		Vector2.new(half + 1.5, top - 0.6),
	}
	for i = 1, #profile - 1 do
		local a, b = profile[i], profile[i + 1]
		local middle = (a + b) / 2
		local length = (b - a).Magnitude
		local angle = math.atan2(b.Y - a.Y, b.X - a.X)
		part({
			Name = "RoofSlope",
			Size = Vector3.new(length + 0.6, 1, Barn.SIZE + 2),
			CFrame = origin * CFrame.new(middle.X, middle.Y, 0) * CFrame.Angles(0, 0, angle),
			Color = ROOF,
			Material = Enum.Material.Slate,
			Parent = roof,
		})
		-- White trim along the roof edge at both gable ends.
		for _, z in { -(half + 1.05), half + 1.05 } do
			part({
				Name = "RoofTrim",
				Size = Vector3.new(length + 0.6, 0.7, 0.4),
				CFrame = origin * CFrame.new(middle.X, middle.Y - 0.2, z) * CFrame.Angles(0, 0, angle),
				Color = WHITE,
				Parent = roof,
			})
		end
	end
	part({
		Name = "RidgeCap",
		Size = Vector3.new(1.4, 1.2, Barn.SIZE + 2.4),
		CFrame = origin * CFrame.new(0, top + 15.9, 0),
		Color = Color3.fromRGB(50, 40, 44),
		Material = Enum.Material.Slate,
		Parent = roof,
	})
	-- Gable ends: a rectangle plus four wedges filling the gambrel shape.
	for _, z in { -half, half } do
		part({
			Name = "Gable",
			Size = Vector3.new(46, 10, 1),
			CFrame = origin * CFrame.new(0, top + 5, z),
			Color = RED,
			Material = Enum.Material.WoodPlanks,
			Parent = roof,
		})
		for _, piece in
			{
				{ Vector3.new(1, 10, half - 23 + 0.5), Vector3.new(-(23 + half + 0.5) / 2, top + 5, z), math.pi / 2 },
				{ Vector3.new(1, 10, half - 23 + 0.5), Vector3.new((23 + half + 0.5) / 2, top + 5, z), -math.pi / 2 },
				{ Vector3.new(1, 5, 23), Vector3.new(-11.5, top + 12.5, z), math.pi / 2 },
				{ Vector3.new(1, 5, 23), Vector3.new(11.5, top + 12.5, z), -math.pi / 2 },
			}
		do
			wedge({
				Name = "Gable",
				Size = piece[1],
				CFrame = origin * CFrame.new(piece[2]) * CFrame.Angles(0, piece[3], 0),
				Color = RED,
				Material = Enum.Material.WoodPlanks,
				Parent = roof,
			})
		end
	end

	-- Hanging lanterns so the inside isn't dark.
	for _, x in { -14, 14 } do
		for _, z in { -6, 16 } do
			part({
				Name = "LanternChain",
				Size = Vector3.new(0.2, 2.6, 0.2),
				CFrame = origin * CFrame.new(x, top - 1.3, z),
				Color = Color3.fromRGB(60, 60, 60),
				CanCollide = false,
				Parent = decor,
			})
			local lantern = part({
				Name = "Lantern",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 1.4,
				CFrame = origin * CFrame.new(x, top - 3, z),
				Color = Color3.fromRGB(255, 215, 140),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = decor,
			})
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(255, 210, 150)
			light.Range = 30
			light.Brightness = 1.4
			light.Shadows = false
			light.Parent = lantern
		end
	end

	-- Hay bales in the front corners inside, and outside by the doors.
	for _, x in { -26, 26 } do
		Decor.hayBale(decor, origin * CFrame.new(x, 1, -27) * CFrame.Angles(0, math.pi / 2, 0))
	end
	for _, x in { -1, 1 } do
		Decor.lamp(decor, origin * CFrame.new(x * 12, 0.3, -half - 3))
		Decor.tree(decor, origin * CFrame.new(x * 24, 0, half + 8), 0.9, index * 10 + x)
	end

	-- The rail the doors slide along, and the doors themselves.
	part({
		Name = "DoorRail",
		Size = Vector3.new(Barn.DOOR_WIDTH * 2 + 4, 0.6, 0.6),
		CFrame = origin * CFrame.new(0, doorTop + 0.9, -half - 1.1),
		Color = Color3.fromRGB(45, 45, 52),
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = decor,
	})
	-- The doors always stand slid open; locking fills the doorway with a red barrier.
	for _, x in { -1, 1 } do
		local w = doorHalf + 0.2
		local closed = origin * CFrame.new(x * w / 2, 1 + (Barn.DOOR_HEIGHT + 0.2) / 2, -half - 0.85)
		local door = buildDoor(folder, closed * CFrame.new(x * (w + 0.4), 0, 0), index)
		door.PrimaryPart.CanCollide = false
	end
	local barrier = part({
		Name = "Barrier",
		Size = Vector3.new(Barn.DOOR_WIDTH, Barn.DOOR_HEIGHT, 0.6),
		CFrame = origin * CFrame.new(0, 1 + Barn.DOOR_HEIGHT / 2, -half),
		Color = Color3.fromRGB(255, 50, 50),
		Material = Enum.Material.ForceField,
		CollisionGroup = "Gate" .. index,
		CastShadow = false,
		Parent = folder,
	})
	addDetails(decor, roof, origin, index)
	return { barrier = barrier, locked = nil }
end

-- Puts the red barrier up (solid to everyone but the owner) or takes it down.
function Barn.setLocked(barn, locked: boolean)
	if barn.locked == locked then
		return
	end
	barn.locked = locked
	barn.barrier.CanCollide = locked
	barn.barrier.Transparency = if locked then 0.15 else 1
end

return Barn
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">BarnUpgrades</string>
          <string name="Source"><![CDATA[-- The barn gets cooler with every rebirth. Each level keeps everything from the levels
-- before it:
--   1  cupola with a weathervane, picket fence with lanterns, bunting flags
--   2  hayloft balcony with a hanging hay bale, a silo, a stone statue of your best Freek
--   3  gold trim, glowing neon roof edges, a bubbling slime fountain
--   4  a whole extra storey, castle turrets with flags, a giant gold Freek on the roof
--   5  gold shingle roof, rainbow roof edges, crystal spires and a crystal cupola top
--   6  sky spotlights, a sparkle aura, gems orbiting above the cupola
--   7  red carpet with velvet ropes, a trophy wall of your rarest Freeks, fireworks
--   8  the Golden Barn: gold walls and white marble trim
-- (The door frame and name plaque upgrade separately, see GateTiers.)
--
-- Coordinates are the plot's (see Barn.luau): doors on the -Z side, floor top at y = 1.
-- The client animates the moving bits (BarnFX.luau): spinners, rainbow parts, fireworks.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Barn = require(script.Parent.Barn)
local Decor = require(script.Parent.Decor)
local FreekModel = require(ReplicatedStorage.Shared.FreekModel)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Freeks = require(ReplicatedStorage.Shared.Freeks)
local Rarities = require(ReplicatedStorage.Shared.Rarities)

local BarnUpgrades = {}

BarnUpgrades.MAX_LEVEL = 8
BarnUpgrades.STOREY = 10 -- how much taller the extra storey makes the barn
BarnUpgrades.SPINNER_TAG = "BarnSpinner"
BarnUpgrades.FIREWORKS_TAG = "BarnFireworks"

local RED = Color3.fromRGB(168, 40, 36)
local WHITE = Color3.fromRGB(245, 242, 235)
local GOLD = Color3.fromRGB(255, 196, 55)
local MARBLE = Color3.fromRGB(250, 248, 242)
local STONE = Color3.fromRGB(175, 172, 170)
local DARK = Color3.fromRGB(40, 36, 44)
local ROOF = Color3.fromRGB(72, 58, 62)
local CRYSTAL = Color3.fromRGB(150, 225, 255)
local SLIME = Color3.fromRGB(120, 255, 90)
local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"

local part = Decor.part

local function wedge(props)
	return part(props, "WedgePart")
end

local function noCollide(p: BasePart)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

--------------------------------------------------------------------------------
-- Changing the barn itself (colours and the roof height), undoably
--------------------------------------------------------------------------------

local function paint(p: BasePart, color: Color3, material: Enum.Material?)
	if p:GetAttribute("UpgradeColor") == nil then
		p:SetAttribute("UpgradeColor", p.Color)
		p:SetAttribute("UpgradeMaterial", p.Material.Name)
	end
	p.Color = color
	if material then
		p.Material = material
	end
end

local function lift(p: BasePart, height: number)
	if p:GetAttribute("UpgradeCFrame") == nil then
		p:SetAttribute("UpgradeCFrame", p.CFrame)
	end
	p.CFrame = (p:GetAttribute("UpgradeCFrame") :: CFrame) + Vector3.new(0, height, 0)
end

local function restore(container: Instance)
	for _, p in container:GetDescendants() do
		if p:IsA("BasePart") then
			local color = p:GetAttribute("UpgradeColor")
			if typeof(color) == "Color3" then
				p.Color = color
				p.Material = Enum.Material[p:GetAttribute("UpgradeMaterial") :: string]
				p:SetAttribute("UpgradeColor", nil)
				p:SetAttribute("UpgradeMaterial", nil)
			end
			local cframe = p:GetAttribute("UpgradeCFrame")
			if typeof(cframe) == "CFrame" then
				p.CFrame = cframe
				p:SetAttribute("UpgradeCFrame", nil)
			end
		end
	end
end

local function eachNamed(container: Instance, names: { [string]: boolean }, fn: (BasePart) -> ())
	for _, p in container:GetDescendants() do
		if p:IsA("BasePart") and names[p.Name] then
			fn(p)
		end
	end
end

local TRIM_NAMES =
	{ CornerTrim = true, EaveTrim = true, RoofTrim = true, WindowFrame = true, WindowBar = true, DoorTrim = true }
local WALL_NAMES = { Wall = true, Gable = true, DoorPanel = true }

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

-- Turns a model into a statue: every part one colour and material, no effects.
local function statue(model: Model, color: Color3, material: Enum.Material)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Color = color
			d.Material = material
			d.Anchored = true
			noCollide(d)
			CollectionService:RemoveTag(d, FreekModel.RAINBOW_TAG)
		elseif d:IsA("Sparkles") or d:IsA("Fire") or d:IsA("Light") or d:IsA("ParticleEmitter") then
			d:Destroy()
		end
	end
end

-- Scales a model about its pivot (works without Model:ScaleTo).
local function scaleModel(model: Model, scale: number)
	local pivot = model:GetPivot()
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local relative = pivot:ToObjectSpace(d.CFrame)
			d.Size *= scale
			d.CFrame = pivot * (relative.Rotation + relative.Position * scale)
		end
	end
end

-- A Freek model scaled to `height` studs tall, standing at `ground` facing its -Z.
local function freekFigure(species: string, height: number, ground: CFrame): Model?
	local ok, model, tall = pcall(FreekModel.build, species)
	if not ok or not model then
		return nil
	end
	model:PivotTo(CFrame.new())
	scaleModel(model, height / math.max(tall, 0.5))
	model:PivotTo(ground)
	return model
end

-- A downward-pointing pennant flag; `top` is the middle of its top edge, facing its -Z,
-- with its right along the string.
local function pennant(parent: Instance, top: CFrame, width: number, height: number, color: Color3)
	local base = top * CFrame.Angles(0, math.pi / 2, 0)
	for _, side in { 1, -1 } do
		noCollide(wedge({
			Name = "Bunting",
			Size = Vector3.new(0.12, height, width / 2),
			CFrame = base * CFrame.new(0, -height / 2, side * width / 4) * (if side == 1
				then CFrame.Angles(math.pi, 0, 0)
				else CFrame.Angles(0, math.pi, 0) * CFrame.Angles(math.pi, 0, 0)),
			Color = color,
			Parent = parent,
		}))
	end
end

-- A line of pennants from a to b, hanging on a string, facing `outward`.
local function buntingLine(parent: Instance, a: Vector3, b: Vector3, outward: Vector3, colors: { Color3 })
	local length = (b - a).Magnitude
	noCollide(part({
		Name = "BuntingString",
		Size = Vector3.new(0.12, 0.12, length),
		CFrame = CFrame.lookAt((a + b) / 2, b),
		Color = DARK,
		Parent = parent,
	}))
	local along = (b - a).Unit
	local count = math.floor(length / 2.4)
	for i = 0, count - 1 do
		local position = a + along * ((i + 0.5) * length / count)
		local top = CFrame.lookAt(position, position + outward)
		pennant(parent, top, 1.3, 1.5, colors[i % #colors + 1])
	end
end

-- A stepped cone (stacked discs), cartoon style. `ground` is the centre of its base.
local function steppedCone(parent: Instance, ground: CFrame, radius: number, height: number, color: Color3, material)
	local steps = 5
	local parts = {}
	for i = 0, steps - 1 do
		local r = radius * (1 - i / steps)
		local h = height / steps
		table.insert(
			parts,
			part({
				Name = "Cone",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(h, r * 2, r * 2),
				CFrame = ground * CFrame.new(0, h * (i + 0.5), 0) * CFrame.Angles(0, 0, math.pi / 2),
				Color = color,
				Material = material or Enum.Material.Slate,
				Parent = parent,
			})
		)
	end
	return parts
end

local function lantern(parent: Instance, ground: CFrame, height: number)
	part({
		Name = "LanternPost",
		Size = Vector3.new(0.7, height, 0.7),
		CFrame = ground * CFrame.new(0, height / 2, 0),
		Color = DARK,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	local bulb = noCollide(part({
		Name = "Lantern",
		Size = Vector3.new(1, 1.2, 1),
		CFrame = ground * CFrame.new(0, height + 0.6, 0),
		Color = Color3.fromRGB(255, 215, 140),
		Material = Enum.Material.Neon,
		Parent = parent,
	}))
	noCollide(part({
		Name = "LanternCap",
		Size = Vector3.new(1.4, 0.3, 1.4),
		CFrame = ground * CFrame.new(0, height + 1.35, 0),
		Color = DARK,
		Material = Enum.Material.Metal,
		Parent = parent,
	}))
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 210, 150)
	light.Range = 14
	light.Brightness = 1
	light.Shadows = false
	light.Parent = bulb
end

local function window(parent: Instance, spot: CFrame, trim: Color3)
	part({ Name = "WindowFrame", Size = Vector3.new(6, 6, 0.3), CFrame = spot, Color = trim, Parent = parent })
	part({
		Name = "WindowPane",
		Size = Vector3.new(5, 5, 0.35),
		CFrame = spot,
		Color = Color3.fromRGB(70, 95, 120),
		Material = Enum.Material.Glass,
		Parent = parent,
	})
	for _, bar in { Vector3.new(0.4, 5, 0.4), Vector3.new(5, 0.4, 0.4) } do
		part({ Name = "WindowBar", Size = bar, CFrame = spot, Color = trim, Parent = parent })
	end
end

local function spinner(model: Model, mode: string, speed: number, amount: number?)
	model:SetAttribute("Rest", model:GetPivot())
	model:SetAttribute("Mode", mode)
	model:SetAttribute("Speed", speed)
	model:SetAttribute("Amount", amount or 0)
	CollectionService:AddTag(model, BarnUpgrades.SPINNER_TAG)
end

local function emitter(parent: BasePart, props)
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLE_TEXTURE
	e.LightEmission = 1
	for key, value in props do
		e[key] = value
	end
	e.Parent = parent
	return e
end

-- The Freeks a player is proudest of: distinct species, rarest (then richest) first.
local function proudest(data, count: number): { string }
	local best = {}
	for _, freek in (data and data.freeks or {}) do
		local species = Freeks.byId[freek.species]
		if species then
			local score = (Rarities.rank[species.rarity] or 0) * 1e9 + FreekUtil.baseIncome(freek)
			if not best[freek.species] or best[freek.species] < score then
				best[freek.species] = score
			end
		end
	end
	local list = {}
	for species in best do
		table.insert(list, species)
	end
	table.sort(list, function(a, b)
		return best[a] > best[b]
	end)
	while #list > count do
		table.remove(list)
	end
	return list
end

--------------------------------------------------------------------------------
-- Building
--------------------------------------------------------------------------------

local function build(plot, level: number, model: Model, champions: { string })
	local origin: CFrame = plot.origin
	local half: number = plot.half
	local accent: Color3 = plot.accent
	local barnFolder: Instance = plot.freeks.Parent
	local roofFolder = barnFolder:FindFirstChild("Roof")
	local storey = if level >= 4 then BarnUpgrades.STOREY else 0
	local top0 = 1 + Barn.WALL_HEIGHT
	local top = top0 + storey -- where the roof now starts
	local ridge = top + 16.5 -- top of the ridge cap
	local trimColor = if level >= 8 then MARBLE elseif level >= 3 then GOLD else WHITE
	local trimMaterial = if level >= 8
		then Enum.Material.Marble
		elseif level >= 3 then Enum.Material.Foil
		else Enum.Material.SmoothPlastic
	local wallColor = if level >= 8 then GOLD else RED
	local roofColor = if level >= 8 then MARBLE elseif level >= 5 then GOLD else ROOF
	local roofMaterial = if level >= 8
		then Enum.Material.Marble
		elseif level >= 5 then Enum.Material.Foil
		else Enum.Material.Slate
	local function at(x: number, y: number, z: number): CFrame
		return origin * CFrame.new(x, y, z)
	end

	-- Recolour and lift the barn itself.
	if level >= 3 then
		eachNamed(barnFolder, TRIM_NAMES, function(p)
			paint(p, trimColor, trimMaterial)
		end)
	end
	if level >= 8 then
		eachNamed(barnFolder, WALL_NAMES, function(p)
			paint(p, wallColor, Enum.Material.Foil)
		end)
		eachNamed(barnFolder, { Batten = true }, function(p)
			paint(p, wallColor:Lerp(Color3.new(0, 0, 0), 0.2), Enum.Material.Foil)
		end)
	end
	if roofFolder then
		if storey > 0 then
			for _, p in roofFolder:GetDescendants() do
				if p:IsA("BasePart") then
					lift(p, storey)
				end
			end
			local ceiling = barnFolder:FindFirstChild("Ceiling")
			if ceiling and ceiling:IsA("BasePart") then
				lift(ceiling, storey)
			end
		end
		if level >= 5 then
			eachNamed(roofFolder, { RoofSlope = true }, function(p)
				paint(p, roofColor, roofMaterial)
			end)
			eachNamed(roofFolder, { RoofShingle = true }, function(p)
				paint(p, roofColor:Lerp(Color3.new(0, 0, 0), 0.2), roofMaterial)
			end)
			eachNamed(roofFolder, { RidgeCap = true }, function(p)
				paint(p, if level >= 8 then GOLD else Color3.fromRGB(230, 165, 35), Enum.Material.Foil)
			end)
		end
	end

	-- Level 1 -----------------------------------------------------------------

	-- Cupola on the ridge with a weathervane.
	local cupolaBase = ridge - 0.8
	part({
		Name = "Cupola",
		Size = Vector3.new(5, 4.5, 5),
		CFrame = at(0, cupolaBase + 2.25, 0),
		Color = if level >= 8 then GOLD else WHITE,
		Material = if level >= 8 then Enum.Material.Foil else Enum.Material.SmoothPlastic,
		Parent = model,
	})
	for _, face in { 0, 1, 2, 3 } do
		local turn = CFrame.Angles(0, face * math.pi / 2, 0)
		for k = -1, 1 do
			noCollide(part({
				Name = "Louver",
				Size = Vector3.new(3.2, 0.35, 0.3),
				CFrame = at(0, cupolaBase + 2.3 + k * 0.8, 0) * turn * CFrame.new(0, 0, -2.55),
				Color = DARK,
				Parent = model,
			}))
		end
	end
	local cupolaRoof = steppedCone(
		model,
		at(0, cupolaBase + 4.5, 0),
		3.8,
		3,
		if level >= 5 then CRYSTAL else roofColor,
		if level >= 5 then Enum.Material.Glass else roofMaterial
	)
	if level >= 5 then
		for _, p in cupolaRoof do
			p.Transparency = 0.15
		end
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = CRYSTAL
		sparkle.Parent = cupolaRoof[#cupolaRoof]
	end
	local vaneTop = cupolaBase + 7.5
	local vane = Instance.new("Model")
	vane.Name = "Weathervane"
	vane.Parent = model
	local vaneColor = if level >= 3 then GOLD else DARK
	local vaneMaterial = if level >= 3 then Enum.Material.Foil else Enum.Material.Metal
	local pole = noCollide(part({
		Name = "VanePole",
		Size = Vector3.new(0.3, 3.4, 0.3),
		CFrame = at(0, vaneTop + 1.7, 0),
		Color = vaneColor,
		Material = vaneMaterial,
		Parent = vane,
	}))
	vane.PrimaryPart = pole
	noCollide(part({
		Name = "VaneArrow",
		Size = Vector3.new(4.2, 0.2, 0.2),
		CFrame = at(0, vaneTop + 2.6, 0),
		Color = vaneColor,
		Material = vaneMaterial,
		Parent = vane,
	}))
	noCollide(wedge({
		Name = "VaneArrow",
		Size = Vector3.new(0.15, 0.8, 0.9),
		CFrame = at(2.4, vaneTop + 2.6, 0) * CFrame.Angles(0, math.pi / 2, 0) * CFrame.Angles(math.pi / 4, 0, 0),
		Color = vaneColor,
		Material = vaneMaterial,
		Parent = vane,
	}))
	-- The rooster.
	for _, bit in
		{
			{ "Ball", Vector3.one * 1.3, Vector3.new(0, vaneTop + 3.7, 0), vaneColor },
			{ "Ball", Vector3.one * 0.75, Vector3.new(0.7, vaneTop + 4.5, 0), vaneColor },
			{ "Block", Vector3.new(0.3, 0.45, 0.15), Vector3.new(0.75, vaneTop + 5, 0), Color3.fromRGB(230, 40, 40) },
			{
				"Block",
				Vector3.new(0.35, 0.15, 0.15),
				Vector3.new(1.15, vaneTop + 4.45, 0),
				Color3.fromRGB(255, 190, 40),
			},
			{ "Block", Vector3.new(0.9, 1.2, 0.15), Vector3.new(-0.75, vaneTop + 4.1, 0), vaneColor },
		}
	do
		noCollide(part({
			Name = "Rooster",
			Shape = Enum.PartType[bit[1]],
			Size = bit[2],
			CFrame = at(bit[3].X, bit[3].Y, bit[3].Z),
			Color = bit[4],
			Material = if bit[4] == vaneColor then vaneMaterial else Enum.Material.SmoothPlastic,
			Parent = vane,
		}))
	end
	spinner(vane, "sway", 0.35, math.rad(70))

	-- Picket fence round the barn, open at the front, with lanterns.
	local fence = Instance.new("Folder")
	fence.Name = "Fence"
	fence.Parent = model
	local e = half + 1.7
	local function fenceLine(ax, az, bx, bz)
		Decor.picketFence(fence, at(ax, 0, az).Position, at(bx, 0, bz).Position, 3.2, trimColor)
	end
	fenceLine(-e, -e, -e, e)
	fenceLine(-e, e, e, e)
	fenceLine(e, e, e, -e)
	fenceLine(e, -e, 17, -e)
	fenceLine(-e, -e, -17, -e)
	for _, spot in { { -e, e }, { e, e }, { 17, -e }, { -17, -e }, { e, -e }, { -e, -e } } do
		if not (level >= 4 and spot[2] < 0 and math.abs(spot[1]) == e) then
			lantern(fence, at(spot[1], 0, spot[2]), 4.2)
		end
	end

	-- Bunting along the front gable and the side eaves.
	local flagColors = { accent, WHITE, GOLD }
	local profile = {
		Vector2.new(-(half + 1.5), top - 1.2),
		Vector2.new(-23, top + 9.8),
		Vector2.new(0, top + 14.8),
		Vector2.new(23, top + 9.8),
		Vector2.new(half + 1.5, top - 1.2),
	}
	for i = 1, #profile - 1 do
		local a, b = profile[i], profile[i + 1]
		buntingLine(
			model,
			at(a.X, a.Y, -(half + 1.5)).Position,
			at(b.X, b.Y, -(half + 1.5)).Position,
			origin.LookVector,
			flagColors
		)
	end
	for _, side in { -1, 1 } do
		local x = side * (half + 1.9)
		buntingLine(
			model,
			at(x, top - 1.2, -(half + 1)).Position,
			at(x, top - 1.2, half + 1).Position,
			origin.RightVector * side,
			flagColors
		)
	end

	if level < 2 then
		return
	end

	-- Level 2 -----------------------------------------------------------------

	-- Hayloft: an open loft door in the front gable, a balcony and a hanging hay bale.
	local loftZ = -half - 0.55
	local loftY = top + 4.6
	part({
		Name = "LoftOpening",
		Size = Vector3.new(7, 7, 0.3),
		CFrame = at(0, loftY, loftZ),
		Color = Color3.fromRGB(45, 28, 22),
		Parent = model,
	})
	for _, bar in
		{
			{ Vector3.new(8, 0.7, 0.5), Vector3.new(0, loftY + 3.6, 0) },
			{ Vector3.new(0.7, 7.6, 0.5), Vector3.new(-3.85, loftY, 0) },
			{ Vector3.new(0.7, 7.6, 0.5), Vector3.new(3.85, loftY, 0) },
		}
	do
		part({
			Name = "LoftTrim",
			Size = bar[1],
			CFrame = at(bar[2].X, bar[2].Y, loftZ - 0.1),
			Color = trimColor,
			Material = trimMaterial,
			Parent = model,
		})
	end
	for _, side in { -1, 1 } do
		-- The loft doors swung open against the gable.
		local door = at(side * 6, loftY, loftZ - 0.25)
		part({
			Name = "LoftDoor",
			Size = Vector3.new(3.4, 7, 0.35),
			CFrame = door,
			Color = wallColor,
			Material = Enum.Material.WoodPlanks,
			Parent = model,
		})
		for _, bar in { Vector3.new(3.4, 0.4, 0.45), Vector3.new(0.4, 7, 0.45) } do
			noCollide(part({
				Name = "LoftDoorTrim",
				Size = bar,
				CFrame = door * CFrame.new(0, 0, -0.05),
				Color = trimColor,
				Material = trimMaterial,
				Parent = model,
			}))
		end
	end
	local balconyY = top + 0.9
	part({
		Name = "Balcony",
		Size = Vector3.new(11, 0.6, 3.4),
		CFrame = at(0, balconyY, -half - 2.2),
		Color = Color3.fromRGB(150, 105, 65),
		Material = Enum.Material.WoodPlanks,
		Parent = model,
	})
	for _, x in { -5.2, -2.6, 0, 2.6, 5.2 } do
		part({
			Name = "Railing",
			Size = Vector3.new(0.35, 2.4, 0.35),
			CFrame = at(x, balconyY + 1.5, -half - 3.7),
			Color = trimColor,
			Material = trimMaterial,
			Parent = model,
		})
	end
	part({
		Name = "Railing",
		Size = Vector3.new(11, 0.4, 0.45),
		CFrame = at(0, balconyY + 2.6, -half - 3.7),
		Color = trimColor,
		Material = trimMaterial,
		Parent = model,
	})
	local beamY = loftY + 5.2
	part({
		Name = "HayBeam",
		Size = Vector3.new(0.9, 0.9, 5),
		CFrame = at(0, beamY, -half - 2.3),
		Color = Color3.fromRGB(110, 75, 45),
		Material = Enum.Material.WoodPlanks,
		Parent = model,
	})
	noCollide(part({
		Name = "Pulley",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 1.1, 1.1),
		CFrame = at(0, beamY - 0.8, -half - 4.4),
		Color = DARK,
		Material = Enum.Material.Metal,
		Parent = model,
	}))
	noCollide(part({
		Name = "Rope",
		Size = Vector3.new(0.15, 3.6, 0.15),
		CFrame = at(0, beamY - 3, -half - 4.4),
		Color = Color3.fromRGB(190, 160, 110),
		Material = Enum.Material.Fabric,
		Parent = model,
	}))
	Decor.hayBale(model, at(0, beamY - 7.2, -half - 4.4))

	-- Silo behind the barn.
	local siloX, siloZ = 10, half + 7.5
	local siloHeight = 35 + storey
	part({
		Name = "Silo",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(siloHeight, 11, 11),
		CFrame = at(siloX, siloHeight / 2, siloZ) * CFrame.Angles(0, 0, math.pi / 2),
		Color = if level >= 8 then GOLD else Color3.fromRGB(190, 200, 210),
		Material = if level >= 8 then Enum.Material.Foil else Enum.Material.CorrodedMetal,
		Parent = model,
	})
	for y = 6, siloHeight - 2, 7 do
		noCollide(part({
			Name = "SiloBand",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, 11.4, 11.4),
			CFrame = at(siloX, y, siloZ) * CFrame.Angles(0, 0, math.pi / 2),
			Color = trimColor,
			Material = trimMaterial,
			Parent = model,
		}))
	end
	part({
		Name = "SiloDome",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 11.6,
		CFrame = at(siloX, siloHeight, siloZ),
		Color = accent,
		Parent = model,
	})
	noCollide(part({
		Name = "SiloCap",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.6,
		CFrame = at(siloX, siloHeight + 6.2, siloZ),
		Color = trimColor,
		Material = trimMaterial,
		Parent = model,
	}))

	-- A stone statue of their best Freek by the door (left of it, opposite the plaque).
	local champion = champions[1]
	if champion then
		local spot = at(21, 0, -half - 4.6)
		part({
			Name = "StatuePlinth",
			Size = Vector3.new(5.5, 2.2, 5.5),
			CFrame = spot * CFrame.new(0, 1.1, 0),
			Color = STONE,
			Material = Enum.Material.Slate,
			Parent = model,
		})
		part({
			Name = "StatuePlinth",
			Size = Vector3.new(6.2, 0.5, 6.2),
			CFrame = spot * CFrame.new(0, 2.45, 0),
			Color = trimColor,
			Material = trimMaterial,
			Parent = model,
		})
		local figure = freekFigure(champion, 7, spot * CFrame.new(0, 2.7, 0))
		if figure then
			figure.Name = "Statue"
			statue(figure, Color3.fromRGB(200, 198, 192), Enum.Material.Slate)
			figure.Parent = model
		end
	end

	if level < 3 then
		return
	end

	-- Level 3 -----------------------------------------------------------------

	-- Glowing neon roof edges and corners (rainbow from level 5).
	local neon = {}
	local function neonBar(cframe: CFrame, size: Vector3)
		table.insert(
			neon,
			noCollide(part({
				Name = "NeonTrim",
				Size = size,
				CFrame = cframe,
				Color = accent,
				Material = Enum.Material.Neon,
				CastShadow = false,
				Parent = model,
			}))
		)
	end
	local edge = {
		Vector2.new(-(half + 1.5), top - 0.8),
		Vector2.new(-23, top + 10.2),
		Vector2.new(0, top + 15.2),
		Vector2.new(23, top + 10.2),
		Vector2.new(half + 1.5, top - 0.8),
	}
	for _, z in { -(half + 1.35), half + 1.35 } do
		for i = 1, #edge - 1 do
			local a, b = edge[i], edge[i + 1]
			local middle = (a + b) / 2
			local length = (b - a).Magnitude
			neonBar(
				at(middle.X, middle.Y, z) * CFrame.Angles(0, 0, math.atan2(b.Y - a.Y, b.X - a.X)),
				Vector3.new(length + 0.3, 0.35, 0.3)
			)
		end
	end
	for _, side in { -1, 1 } do
		neonBar(at(side * (half + 1.65), top - 1.15, 0), Vector3.new(0.3, 0.35, Barn.SIZE + 2))
		for _, z in { -1, 1 } do
			neonBar(at(side * (half + 0.95), (top + 1) / 2, z * (half + 0.95)), Vector3.new(0.3, top - 1, 0.3))
		end
	end
	if level >= 5 then
		for _, p in neon do
			CollectionService:AddTag(p, FreekModel.RAINBOW_TAG)
		end
	end

	-- A bubbling slime fountain in front of the plaque.
	local fountain = at(-21, 0, -half - 6)
	part({
		Name = "FountainBasin",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.6, 7, 7),
		CFrame = fountain * CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = STONE,
		Material = Enum.Material.Slate,
		Parent = model,
	})
	local pool = noCollide(part({
		Name = "Slime",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 6, 6),
		CFrame = fountain * CFrame.new(0, 1.55, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = SLIME,
		Material = Enum.Material.Neon,
		Parent = model,
	}))
	part({
		Name = "FountainColumn",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3.2, 1.2, 1.2),
		CFrame = fountain * CFrame.new(0, 3, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = STONE,
		Material = Enum.Material.Slate,
		Parent = model,
	})
	part({
		Name = "FountainBowl",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7, 3.4, 3.4),
		CFrame = fountain * CFrame.new(0, 4.6, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = trimColor,
		Material = trimMaterial,
		Parent = model,
	})
	noCollide(part({
		Name = "Slime",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.9, 1.2, 2.9),
		CFrame = fountain * CFrame.new(0, 5, 0),
		Color = SLIME,
		Material = Enum.Material.Neon,
		Parent = model,
	}))
	for k = 0, 3 do
		local angle = k * math.pi / 2 + math.pi / 4
		noCollide(part({
			Name = "SlimeStream",
			Size = Vector3.new(0.35, 3.2, 0.35),
			CFrame = fountain * CFrame.new(math.cos(angle) * 1.8, 3.2, math.sin(angle) * 1.8),
			Color = SLIME,
			Material = Enum.Material.Neon,
			Transparency = 0.2,
			Parent = model,
		}))
	end
	emitter(pool, {
		Color = ColorSequence.new(SLIME),
		Rate = 6,
		Lifetime = NumberRange.new(0.8, 1.4),
		Speed = NumberRange.new(1.5, 3),
		Size = NumberSequence.new(0.5, 0),
		SpreadAngle = Vector2.new(25, 25),
		EmissionDirection = Enum.NormalId.Right,
	})
	local glow = Instance.new("PointLight")
	glow.Color = SLIME
	glow.Range = 12
	glow.Brightness = 1.5
	glow.Parent = pool

	if level < 4 then
		return
	end

	-- Level 4 -----------------------------------------------------------------

	-- The extra storey: walls between the old wall top and the lifted roof.
	for _, wall in
		{
			{ Vector3.new(Barn.SIZE, storey, 1), Vector3.new(0, top0 + storey / 2, half) },
			{ Vector3.new(Barn.SIZE, storey, 1), Vector3.new(0, top0 + storey / 2, -half) },
			{ Vector3.new(1, storey, Barn.SIZE), Vector3.new(-half, top0 + storey / 2, 0) },
			{ Vector3.new(1, storey, Barn.SIZE), Vector3.new(half, top0 + storey / 2, 0) },
		}
	do
		part({
			Name = "UpperWall",
			Size = wall[1],
			CFrame = at(wall[2].X, wall[2].Y, wall[2].Z),
			Color = wallColor,
			Material = if level >= 8 then Enum.Material.Foil else Enum.Material.WoodPlanks,
			Parent = model,
		})
	end
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			part({
				Name = "UpperCorner",
				Size = Vector3.new(1.6, storey + 0.4, 1.6),
				CFrame = at(x * (half + 0.1), top0 + storey / 2, z * (half + 0.1)),
				Color = trimColor,
				Material = trimMaterial,
				Parent = model,
			})
		end
	end
	for _, band in
		{
			{ Vector3.new(Barn.SIZE + 0.4, 0.8, 1.4), Vector3.new(0, top - 0.4, -half) },
			{ Vector3.new(Barn.SIZE + 0.4, 0.8, 1.4), Vector3.new(0, top - 0.4, half) },
			{ Vector3.new(1.4, 0.8, Barn.SIZE + 0.4), Vector3.new(-half, top - 0.4, 0) },
			{ Vector3.new(1.4, 0.8, Barn.SIZE + 0.4), Vector3.new(half, top - 0.4, 0) },
		}
	do
		part({
			Name = "UpperEave",
			Size = band[1],
			CFrame = at(band[2].X, band[2].Y, band[2].Z),
			Color = trimColor,
			Material = trimMaterial,
			Parent = model,
		})
	end
	local upperY = top0 + storey / 2
	for _, x in { -18, 18 } do
		window(model, at(x, upperY, -half - 0.6), trimColor)
	end
	for _, side in { -1, 1 } do
		for _, z in { -12, 12 } do
			window(model, at(side * (half + 0.6), upperY, z) * CFrame.Angles(0, math.pi / 2, 0), trimColor)
		end
	end

	-- Castle turrets on the front corners, with flags.
	for _, side in { -1, 1 } do
		local base = at(side * half, 0, -half)
		local towerHeight = top + 3
		part({
			Name = "Turret",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(towerHeight, 5.4, 5.4),
			CFrame = base * CFrame.new(0, towerHeight / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
			Color = if level >= 8 then MARBLE else Color3.fromRGB(215, 208, 200),
			Material = if level >= 8 then Enum.Material.Marble else Enum.Material.Slate,
			Parent = model,
		})
		part({
			Name = "TurretRing",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.2, 6.6, 6.6),
			CFrame = base * CFrame.new(0, towerHeight + 0.6, 0) * CFrame.Angles(0, 0, math.pi / 2),
			Color = trimColor,
			Material = trimMaterial,
			Parent = model,
		})
		for _, y in { 8, 16, top - 2 } do
			noCollide(part({
				Name = "ArrowSlit",
				Size = Vector3.new(0.6, 2.2, 0.3),
				CFrame = base * CFrame.new(0, y, -2.65),
				Color = DARK,
				Parent = model,
			}))
		end
		steppedCone(
			model,
			base * CFrame.new(0, towerHeight + 1.2, 0),
			3.5,
			6,
			if level >= 5 then roofColor else Color3.fromRGB(70, 60, 110),
			if level >= 5 then roofMaterial else Enum.Material.Slate
		)
		local flagTop = towerHeight + 1.2 + 6 + 4
		noCollide(part({
			Name = "FlagPole",
			Size = Vector3.new(0.3, 4.4, 0.3),
			CFrame = base * CFrame.new(0, flagTop - 2.2, 0),
			Color = trimColor,
			Material = trimMaterial,
			Parent = model,
		}))
		noCollide(part({
			Name = "Flag",
			Size = Vector3.new(2.6, 1.6, 0.12),
			CFrame = base * CFrame.new(side * 1.45, flagTop - 1, 0),
			Color = accent,
			Parent = model,
		}))
	end

	-- A giant gold Freek standing on the ridge.
	if champion then
		local spot = at(0, ridge, -half + 9)
		part({
			Name = "RoofPlinth",
			Size = Vector3.new(4.5, 1.2, 4.5),
			CFrame = spot * CFrame.new(0, 0.6, 0),
			Color = GOLD,
			Material = Enum.Material.Foil,
			Parent = model,
		})
		local figure = freekFigure(champion, 9, spot * CFrame.new(0, 1.2, 0))
		if figure then
			figure.Name = "GoldStatue"
			statue(figure, GOLD, Enum.Material.Foil)
			figure.Parent = model
			local shine = Instance.new("Sparkles")
			shine.SparkleColor = Color3.fromRGB(255, 235, 150)
			shine.Parent = figure.PrimaryPart or figure:FindFirstChildWhichIsA("BasePart")
		end
	end

	if level < 5 then
		return
	end

	-- Level 5 -----------------------------------------------------------------

	-- Crystal spires at both ends of the ridge.
	for _, z in { -(half + 0.5), half + 0.5 } do
		local base = at(0, ridge - 0.4, z)
		for k, crystal in
			{
				{ 0, 0, 5.5, 1.4 },
				{ -1.1, -20, 3.6, 1 },
				{ 1.1, 20, 3.8, 1 },
				{ 0.5, 10, 2.6, 0.8 },
				{ -0.6, -12, 2.4, 0.8 },
			}
		do
			local shard = noCollide(part({
				Name = "Crystal",
				Size = Vector3.new(crystal[4], crystal[3], crystal[4]),
				CFrame = base
					* CFrame.new(crystal[1], 0, (k % 2) * 0.4)
					* CFrame.Angles(0, math.rad(45), math.rad(crystal[2]))
					* CFrame.new(0, crystal[3] / 2, 0),
				Color = CRYSTAL,
				Material = Enum.Material.Glass,
				Transparency = 0.15,
				Parent = model,
			}))
			if k == 1 then
				local sparkle = Instance.new("Sparkles")
				sparkle.SparkleColor = CRYSTAL
				sparkle.Parent = shard
				local light = Instance.new("PointLight")
				light.Color = CRYSTAL
				light.Range = 12
				light.Parent = shard
			end
		end
	end

	if level < 6 then
		return
	end

	-- Level 6 -----------------------------------------------------------------

	-- Sky spotlights on the front of the roof, sweeping back and forth.
	for _, side in { -1, 1 } do
		local x = side * 24
		local y = top - 0.6 + (half + 1.5 - 24) / 10 * 11 + 0.8
		local light = Instance.new("Model")
		light.Name = "Spotlight"
		light.Parent = model
		local base = part({
			Name = "SpotBase",
			Size = Vector3.new(2.4, 1.4, 2.4),
			CFrame = at(x, y, -half + 5),
			Color = DARK,
			Material = Enum.Material.Metal,
			Parent = light,
		})
		light.PrimaryPart = base
		local aim = at(x, y + 1.4, -half + 5) * CFrame.Angles(math.rad(-25), 0, math.rad(side * -15))
		noCollide(part({
			Name = "SpotDrum",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(2.4, 2.4, 2.4),
			CFrame = aim * CFrame.Angles(0, 0, math.pi / 2),
			Color = DARK,
			Material = Enum.Material.Metal,
			Parent = light,
		}))
		noCollide(part({
			Name = "SpotLens",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 2.1, 2.1),
			CFrame = aim * CFrame.new(0, 1.25, 0) * CFrame.Angles(0, 0, math.pi / 2),
			Color = Color3.fromRGB(255, 250, 220),
			Material = Enum.Material.Neon,
			Parent = light,
		}))
		noCollide(part({
			Name = "SpotBeam",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(140, 3, 3),
			CFrame = aim * CFrame.new(0, 71.3, 0) * CFrame.Angles(0, 0, math.pi / 2),
			Color = Color3.fromRGB(255, 248, 210),
			Material = Enum.Material.Neon,
			Transparency = 0.78,
			CastShadow = false,
			Parent = light,
		}))
		spinner(light, "sway", 0.5 + side * 0.08, math.rad(50))
	end

	-- A sparkle aura and fireflies drifting round the whole barn.
	local aura = noCollide(part({
		Name = "SparkleAura",
		Size = Vector3.new(Barn.SIZE + 10, top + 8, Barn.SIZE + 10),
		CFrame = at(0, (top + 8) / 2, 0),
		Transparency = 1,
		CastShadow = false,
		Parent = model,
	}))
	emitter(aura, {
		Color = ColorSequence.new(Color3.fromRGB(255, 240, 170)),
		Shape = Enum.ParticleEmitterShape.Box,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
		Rate = 18,
		Lifetime = NumberRange.new(2.5, 4.5),
		Speed = NumberRange.new(0.4, 1.4),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.3, 0.8),
			NumberSequenceKeypoint.new(1, 0),
		}),
	})
	emitter(aura, {
		Color = ColorSequence.new(Color3.fromRGB(200, 255, 120)),
		Shape = Enum.ParticleEmitterShape.Box,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
		Rate = 10,
		Lifetime = NumberRange.new(3, 6),
		Speed = NumberRange.new(0.3, 0.9),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.5, 0.45),
			NumberSequenceKeypoint.new(1, 0),
		}),
	})

	-- Gems and a halo ring circling above the cupola.
	local orbit = Instance.new("Model")
	orbit.Name = "GemOrbit"
	orbit.Parent = model
	local orbitY = vaneTop + 9
	local hub = noCollide(part({
		Name = "OrbitHub",
		Size = Vector3.one,
		CFrame = at(0, orbitY, 0),
		Transparency = 1,
		Parent = orbit,
	}))
	orbit.PrimaryPart = hub
	local segments = 28
	local radius = 7
	for k = 0, segments - 1 do
		local a0, a1 = k / segments * math.pi * 2, (k + 1) / segments * math.pi * 2
		local p0 = at(math.cos(a0) * radius, orbitY, math.sin(a0) * radius).Position
		local p1 = at(math.cos(a1) * radius, orbitY, math.sin(a1) * radius).Position
		noCollide(part({
			Name = "Halo",
			Size = Vector3.new(0.4, 0.4, (p1 - p0).Magnitude + 0.1),
			CFrame = CFrame.lookAt((p0 + p1) / 2, p1),
			Color = GOLD,
			Material = Enum.Material.Neon,
			CastShadow = false,
			Parent = orbit,
		}))
	end
	local gemColors = {
		accent,
		Color3.fromRGB(80, 220, 255),
		Color3.fromRGB(190, 90, 255),
		GOLD,
		Color3.fromRGB(255, 80, 120),
		SLIME,
	}
	for k, color in gemColors do
		local angle = k / #gemColors * math.pi * 2
		noCollide(part({
			Name = "OrbitGem",
			Size = Vector3.new(1.3, 1.3, 1.3),
			CFrame = at(math.cos(angle) * radius, orbitY + 0.9, math.sin(angle) * radius)
				* CFrame.Angles(math.rad(45), 0, math.rad(45)),
			Color = color,
			Material = Enum.Material.Neon,
			CastShadow = false,
			Parent = orbit,
		}))
	end
	spinner(orbit, "spin", 0.5)

	if level < 7 then
		return
	end

	-- Level 7 -----------------------------------------------------------------

	-- Red carpet up to the doors, between velvet ropes on gold posts.
	local carpetLength = 16
	noCollide(part({
		Name = "RedCarpet",
		Size = Vector3.new(8, 0.12, carpetLength),
		CFrame = at(0, 0.36, -half - 1 - carpetLength / 2),
		Color = Color3.fromRGB(200, 25, 40),
		Material = Enum.Material.Fabric,
		Parent = model,
	}))
	for _, side in { -1, 1 } do
		noCollide(part({
			Name = "CarpetEdge",
			Size = Vector3.new(0.35, 0.14, carpetLength),
			CFrame = at(side * 4, 0.37, -half - 1 - carpetLength / 2),
			Color = GOLD,
			Material = Enum.Material.Foil,
			Parent = model,
		}))
		local posts = {}
		for k = 0, 3 do
			local z = -half - 3 - k * 4.5
			part({
				Name = "Stanchion",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(3, 0.4, 0.4),
				CFrame = at(side * 5.2, 1.8, z) * CFrame.Angles(0, 0, math.pi / 2),
				Color = GOLD,
				Material = Enum.Material.Foil,
				Parent = model,
			})
			noCollide(part({
				Name = "StanchionTop",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 0.7,
				CFrame = at(side * 5.2, 3.4, z),
				Color = GOLD,
				Material = Enum.Material.Foil,
				Parent = model,
			}))
			part({
				Name = "StanchionBase",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.3, 1.4, 1.4),
				CFrame = at(side * 5.2, 0.45, z) * CFrame.Angles(0, 0, math.pi / 2),
				Color = GOLD,
				Material = Enum.Material.Foil,
				Parent = model,
			})
			table.insert(posts, at(side * 5.2, 3.1, z).Position)
		end
		for k = 1, #posts - 1 do
			-- Each rope dips in the middle: two halves meeting lower down.
			local a, b = posts[k], posts[k + 1]
			local dip = (a + b) / 2 - Vector3.new(0, 0.8, 0)
			for _, pair in { { a, dip }, { dip, b } } do
				noCollide(part({
					Name = "VelvetRope",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new((pair[2] - pair[1]).Magnitude, 0.3, 0.3),
					CFrame = CFrame.lookAt((pair[1] + pair[2]) / 2, pair[2]) * CFrame.Angles(0, math.pi / 2, 0),
					Color = Color3.fromRGB(170, 20, 40),
					Material = Enum.Material.Fabric,
					Parent = model,
				}))
			end
		end
	end

	-- Trophy wall: their three rarest Freeks mounted on gold-rimmed shields on the upper
	-- storey, between its windows.
	for k, species in champions do
		local info = Freeks.byId[species]
		local color = info and Rarities.info[info.rarity] and Rarities.info[info.rarity].color or WHITE
		local spot = at((k - 2) * 7.6, upperY - 0.2, -half - 0.65)
		part({
			Name = "TrophyRim",
			Size = Vector3.new(6.4, 5.6, 0.3),
			CFrame = spot * CFrame.new(0, 0, 0.1),
			Color = GOLD,
			Material = Enum.Material.Foil,
			Parent = model,
		})
		part({
			Name = "TrophyBoard",
			Size = Vector3.new(5.6, 4.8, 0.4),
			CFrame = spot,
			Color = Color3.fromRGB(110, 70, 45),
			Material = Enum.Material.WoodPlanks,
			Parent = model,
		})
		noCollide(part({
			Name = "TrophyRibbon",
			Size = Vector3.new(5.6, 0.7, 0.45),
			CFrame = spot * CFrame.new(0, -2.05, -0.05),
			Color = color,
			Material = Enum.Material.Neon,
			Parent = model,
		}))
		part({
			Name = "TrophyShelf",
			Size = Vector3.new(4.4, 0.35, 1.8),
			CFrame = spot * CFrame.new(0, -1.4, -1),
			Color = GOLD,
			Material = Enum.Material.Foil,
			Parent = model,
		})
		local figure = freekFigure(species, 3.4, spot * CFrame.new(0, -1.22, -1))
		if figure then
			figure.Name = "Trophy"
			for _, d in figure:GetDescendants() do
				if d:IsA("BasePart") then
					d.Anchored = true
					noCollide(d)
				end
			end
			figure.Parent = model
		end
	end

	-- Fireworks launch from the roof now and then (the client sets them off).
	local launcher = noCollide(part({
		Name = "FireworkLauncher",
		Size = Vector3.one,
		CFrame = at(0, ridge + 2, 0),
		Transparency = 1,
		Parent = model,
	}))
	CollectionService:AddTag(launcher, BarnUpgrades.FIREWORKS_TAG)
end

--------------------------------------------------------------------------------

-- Shows the barn for a level (0 = plain barn). data (the owner's save) picks the Freeks
-- for the statues and trophies; nil for an empty barn.
function BarnUpgrades.apply(plot, level: number, data)
	level = math.clamp(level or 0, 0, BarnUpgrades.MAX_LEVEL)
	local champions = if level >= 2 then proudest(data, 3) else {}
	local key = level .. "|" .. table.concat(champions, ",")
	if plot.upgradeKey == key then
		return
	end
	plot.upgradeKey = key
	local barnFolder: Instance = plot.freeks.Parent
	if plot.upgradeModel then
		plot.upgradeModel:Destroy()
		plot.upgradeModel = nil
	end
	restore(barnFolder)
	if level <= 0 then
		return
	end
	local model = Instance.new("Model")
	model.Name = "BarnUpgrades"
	model.Parent = barnFolder
	plot.upgradeModel = model
	build(plot, level, model, champions)
end

return BarnUpgrades
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">CannonService</string>
          <string name="Source"><![CDATA[-- Runs the Freek cannons (see shared/Drops.luau): builds the glass bubble over the map,
-- the eight cannons hanging on it and the Freek House, fires a random Freek from each
-- cannon in turn, and lets players grab them (first come, first served) while they wander
-- around the town square.
--
-- Every species from Common to Ultra can come out (fusing never raises rarity, so cannons
-- are how players move up). Secrets never do. Limited Freeks only during their event.
--
-- Clients fly and walk the Freeks themselves (smooth, no network traffic); the server works
-- out where each one is from its seed and launch time when checking a grab.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Drops = require(ReplicatedStorage.Shared.Drops)
local Events = require(ReplicatedStorage.Shared.Events)
local Format = require(ReplicatedStorage.Shared.Format)
local FreekModel = require(ReplicatedStorage.Shared.FreekModel)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Freeks = require(ReplicatedStorage.Shared.Freeks)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Seasons = require(ReplicatedStorage.Shared.Seasons)

local ActionService = require(script.Parent.ActionService)
local Decor = require(script.Parent.Decor)
local FreekTag = require(script.Parent.FreekTag)
local PlotService = require(script.Parent.PlotService)
local StealService = require(script.Parent.StealService)

local CannonService = {}

local notifyRemote = Remotes.get("Notify")
local rng = Random.new()
local folder: Folder
local cannons = {} -- [index] = cannon Model
local items = {} -- [id] = { species, mutations, price, path, model }
local nextId = 0

local function notify(player: Player, message: string, kind: string?)
	notifyRemote:FireClient(player, message, kind)
end

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		p[key] = value
	end
	return p
end

-- The bubble: a giant soap bubble over the town. Thin glass panels shimmer through soft
-- rainbow colours (with two bright glare streaks, like light on a real bubble), held by a
-- chunky white frame of rings and ribs. A lit rim runs round its foot and a glowing crown
-- sits on top.
local function buildDome(model: Model)
	local radius = Drops.DOME_RADIUS
	local rings, around = 12, 48
	local step = (math.pi / 2) / rings
	local slice = math.pi * 2 / around
	local frame = Color3.fromRGB(250, 250, 255)
	local gold = Color3.fromRGB(255, 200, 60)
	local function glass(props)
		props.CastShadow = false
		props.CanCollide = false
		props.CanQuery = false
		props.CanTouch = false
		props.Parent = model
		return part(props)
	end
	-- Two glare streaks: bands of panels on the sunny side, brighter and whiter.
	local function glare(angle: number, ring: number): number
		local best = 0
		for _, streak in { { 2.3, 6, 0.10 }, { 2.75, 8, 0.05 } } do
			local d = math.abs((angle - streak[1] + math.pi) % (math.pi * 2) - math.pi)
			local along = math.abs(ring - streak[2]) / 3
			if d < streak[3] * 2 and along < 1 then
				best = math.max(best, (1 - d / (streak[3] * 2)) * (1 - along))
			end
		end
		return best
	end
	for ring = 0, rings - 1 do
		local low, high = ring * step, (ring + 1) * step
		local middle = (low + high) / 2
		for i = 0, around - 1 do
			-- Each panel is a flat quad between four points on the bubble.
			local a0, a1 = i * slice, (i + 1) * slice
			local angle = (i + 0.5) * slice
			local bottom = (Drops.domePoint(a0, low) + Drops.domePoint(a1, low)) / 2
			local topEdge = (Drops.domePoint(a0, high) + Drops.domePoint(a1, high)) / 2
			local width = (Drops.domePoint(a1, middle) - Drops.domePoint(a0, middle)).Magnitude
			local center = (bottom + topEdge) / 2
			local up = (topEdge - bottom).Unit
			local right = Vector3.new(-math.sin(angle), 0, math.cos(angle))
			-- Soap-bubble colours swirl round and up: cyan, violet, pink, gold, mint.
			local hue = (0.5 + 0.18 * math.sin(angle * 2 + ring * 0.45) + ring * 0.025) % 1
			local tint = Color3.fromHSV(hue, 0.32, 1)
			local shine = glare(angle, ring)
			glass({
				Name = "Bubble",
				Size = Vector3.new(width, (topEdge - bottom).Magnitude, 0.4),
				CFrame = CFrame.fromMatrix(center, right, up),
				Color = tint:Lerp(Color3.new(1, 1, 1), shine),
				Material = Enum.Material.Glass,
				Transparency = 0.88 - shine * 0.3,
			})
		end
		-- A frame ring along the bottom edge of each band.
		local thick = if ring == 0 then 1.4 else 0.6
		for i = 0, around - 1 do
			local p0 = Drops.domePoint(i * slice, low)
			local p1 = Drops.domePoint((i + 1) * slice, low)
			glass({
				Name = "BubbleFrame",
				Size = Vector3.new(thick, thick, (p1 - p0).Magnitude + thick),
				CFrame = CFrame.lookAt((p0 + p1) / 2, p1),
				Color = frame,
				Material = Enum.Material.SmoothPlastic,
				Transparency = 0.15,
			})
		end
		-- Ribs up the bubble every few panels, with gold rivets where they cross the rings.
		for i = 0, around - 1, 4 do
			local a = i * slice
			local p0 = Drops.domePoint(a, low)
			local p1 = Drops.domePoint(a, high)
			glass({
				Name = "BubbleFrame",
				Size = Vector3.new(0.9, 0.9, (p1 - p0).Magnitude + 0.9),
				CFrame = CFrame.lookAt((p0 + p1) / 2, p1),
				Color = frame,
				Material = Enum.Material.SmoothPlastic,
				Transparency = 0.15,
			})
			if ring > 0 then
				glass({
					Name = "BubbleRivet",
					Shape = Enum.PartType.Ball,
					Size = Vector3.one * 2,
					CFrame = CFrame.new(p0),
					Color = gold,
					Material = Enum.Material.Foil,
				})
			end
		end
	end

	-- The rim round the foot: a chunky white-and-gold ring with coloured bulbs.
	local bulbColors = {
		Color3.fromRGB(255, 120, 200),
		Color3.fromRGB(120, 220, 255),
		Color3.fromRGB(255, 220, 90),
		Color3.fromRGB(150, 255, 150),
	}
	local rimSegments = 64
	for i = 0, rimSegments - 1 do
		local a0, a1 = i / rimSegments * math.pi * 2, (i + 1) / rimSegments * math.pi * 2
		local p0 = Vector3.new(math.cos(a0) * radius, 1.6, math.sin(a0) * radius)
		local p1 = Vector3.new(math.cos(a1) * radius, 1.6, math.sin(a1) * radius)
		local length = (p1 - p0).Magnitude
		glass({
			Name = "BubbleRim",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(length + 1, 3.6, 3.6),
			CFrame = CFrame.lookAt((p0 + p1) / 2, p1) * CFrame.Angles(0, math.pi / 2, 0),
			Color = if i % 2 == 0 then frame else gold,
			Material = if i % 2 == 0 then Enum.Material.SmoothPlastic else Enum.Material.Foil,
			Transparency = 0,
		})
		local bulb = glass({
			Name = "RimBulb",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 1.6,
			CFrame = CFrame.new(Vector3.new(math.cos(a0) * (radius - 1.6), 3.2, math.sin(a0) * (radius - 1.6))),
			Color = bulbColors[i % #bulbColors + 1],
			Material = Enum.Material.Neon,
			Transparency = 0,
		})
		bulb:SetAttribute("BulbIndex", i)
	end

	-- The crown on top: a gold ring holding a big glowing star-orb.
	local apex = Vector3.new(0, radius * Drops.DOME_HEIGHT, 0)
	local capWidth = 2 * radius * math.cos(math.pi / 2 - step) + 0.5
	glass({
		Name = "Bubble",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, capWidth, capWidth),
		CFrame = CFrame.new(apex) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(240, 200, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.88,
	})
	glass({
		Name = "Crown",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, 22, 22),
		CFrame = CFrame.new(apex + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = gold,
		Material = Enum.Material.Foil,
		Transparency = 0,
	})
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		glass({
			Name = "Crown",
			Size = Vector3.new(2.4, 7, 2.4),
			CFrame = CFrame.new(apex + Vector3.new(math.cos(a) * 9.5, 5.5, math.sin(a) * 9.5))
				* CFrame.Angles(0, -a, 0)
				* CFrame.Angles(0, math.pi / 4, 0),
			Color = gold,
			Material = Enum.Material.Foil,
			Transparency = 0,
		})
		glass({
			Name = "CrownGem",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 2.2,
			CFrame = CFrame.new(apex + Vector3.new(math.cos(a) * 9.5, 9.5, math.sin(a) * 9.5)),
			Color = bulbColors[k % #bulbColors + 1],
			Material = Enum.Material.Neon,
			Transparency = 0,
		})
	end
	local orb = glass({
		Name = "CrownOrb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 10,
		CFrame = CFrame.new(apex + Vector3.new(0, 8, 0)),
		Color = Color3.fromRGB(255, 240, 160),
		Material = Enum.Material.Neon,
		Transparency = 0,
	})
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = Color3.fromRGB(255, 240, 180)
	sparkles.Parent = orb
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 230, 160)
	glow.Range = 60
	glow.Brightness = 2
	glow.Parent = orb
end

-- Each cannon has its own bright colour (and a number on a badge).
local CANNON_COLORS = {
	Color3.fromRGB(235, 60, 70),
	Color3.fromRGB(255, 140, 40),
	Color3.fromRGB(250, 205, 50),
	Color3.fromRGB(70, 200, 90),
	Color3.fromRGB(40, 190, 230),
	Color3.fromRGB(60, 110, 240),
	Color3.fromRGB(150, 80, 230),
	Color3.fromRGB(240, 90, 180),
}

-- A big chunky cartoon cannon: a bright barrel with gold bands and rivets, a flared muzzle
-- with a glowing rim, a round breech with a lit fuse, held in a gold yoke on a round mount
-- bolted to the bubble, and a number badge on top.
local function buildCannon(parent: Instance, index: number): Model
	local model = Instance.new("Model")
	model.Name = "Cannon" .. index
	local aim = Drops.cannonCFrame(index)
	local S = Drops.CANNON_SCALE
	-- The cannon hangs just inside the bubble; at() places a point in its own studs.
	local base = Drops.cannonBase(index)
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x * S, y * S, z * S)
	end
	local color = CANNON_COLORS[(index - 1) % #CANNON_COLORS + 1]
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	local gold = Color3.fromRGB(255, 200, 55)
	local outline = Color3.fromRGB(20, 22, 48)
	-- Cylinders run along their X axis; turn them to point down the barrel (-Z).
	local along = CFrame.Angles(0, math.pi / 2, 0)
	local function add(props)
		props.Material = props.Material or Enum.Material.SmoothPlastic
		props.Parent = model
		return part(props)
	end
	local function ring(z: number, diameter: number, length: number, ringColor: Color3, material)
		return add({
			Name = "Band",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(length, diameter, diameter) * S,
			CFrame = at(0, 0, z) * along,
			Color = ringColor,
			Material = material or Enum.Material.SmoothPlastic,
		})
	end
	-- The barrel tapers a little toward the muzzle: two lengths, the back one fatter.
	local barrel = add({
		Name = "Barrel",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(11, 7.4, 7.4) * S,
		CFrame = at(0, 0, 1.5) * along,
		Color = color,
	})
	model.PrimaryPart = barrel
	add({
		Name = "BarrelFront",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(11, 6.6, 6.6) * S,
		CFrame = at(0, 0, -8.5) * along,
		Color = color,
	})
	-- A white stripe for a toy-like look.
	ring(-5.5, 6.75, 1.2, Color3.fromRGB(255, 255, 255))
	-- Gold bands with rivets.
	for _, band in { { 6.5, 7.9 }, { -3, 7.9 }, { -13, 7.1 } } do
		ring(band[1], band[2], 1.4, gold, Enum.Material.Foil)
		for k = 0, 7 do
			local a = k / 8 * math.pi * 2
			add({
				Name = "Rivet",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 0.6 * S,
				CFrame = at(math.cos(a) * band[2] / 2, math.sin(a) * band[2] / 2, band[1]),
				Color = gold:Lerp(Color3.new(1, 1, 1), 0.3),
				Material = Enum.Material.Foil,
			})
		end
	end
	-- Flared muzzle: three rings, a dark bore and a glowing rim.
	ring(-14.6, 8.2, 1.4, dark)
	ring(-15.6, 9.4, 1, gold, Enum.Material.Foil)
	add({
		Name = "Muzzle",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 5.2, 5.2) * S,
		CFrame = at(0, 0, -16.15) * along,
		Color = Color3.fromRGB(10, 10, 16),
	})
	add({
		Name = "MuzzleGlow",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.25, 7.2, 7.2) * S,
		CFrame = at(0, 0, -16.1) * along,
		Color = color:Lerp(Color3.new(1, 1, 1), 0.45),
		Material = Enum.Material.Neon,
	})
	-- Round breech with a knob, and a fuse with a spark.
	add({
		Name = "Breech",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 8 * S,
		CFrame = at(0, 0, 7),
		Color = dark,
	})
	add({
		Name = "Knob",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 2.6 * S,
		CFrame = at(0, 0, 11.2),
		Color = gold,
		Material = Enum.Material.Foil,
	})
	add({
		Name = "Fuse",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.2, 0.45, 0.45) * S,
		CFrame = at(0, 4.6, 5.5) * CFrame.Angles(0, 0, math.pi / 2) * CFrame.Angles(0, 0, 0.3),
		Color = Color3.fromRGB(90, 70, 50),
	})
	local spark = add({
		Name = "FuseSpark",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.8 * S,
		CFrame = at(0, 5.7, 5.2),
		Color = Color3.fromRGB(255, 200, 80),
		Material = Enum.Material.Neon,
	})
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = Color3.fromRGB(255, 190, 80)
	sparkles.Parent = spark
	-- The number badge underneath (where players below can see it): a gold disc with a
	-- white face and the number.
	add({
		Name = "Badge",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 5.2, 5.2) * S,
		CFrame = at(0, -3.9, 1.5) * CFrame.Angles(0, 0, math.pi / 2),
		Color = gold,
		Material = Enum.Material.Foil,
	})
	local face = add({
		Name = "BadgeFace",
		Size = Vector3.new(4, 0.2, 4) * S,
		CFrame = at(0, -4.25, 1.5),
		Color = Color3.fromRGB(255, 255, 255),
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Bottom
	gui.CanvasSize = Vector2.new(100, 100)
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = tostring(index)
	label.Font = Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.TextColor3 = color
	label.Rotation = 180
	local stroke = Instance.new("UIStroke")
	stroke.Color = outline
	stroke.Thickness = 4
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = face

	-- The gold yoke: two arms from the breech back to the bubble, holding pins on the
	-- barrel's sides; and a big round mount plate on the bubble with a coloured middle.
	local wall = aim.Position
	for _, side in { -1, 1 } do
		local pin = at(side * 4.4, 0, 3).Position
		local foot = wall + aim.RightVector * side * 4.4 * S
		local length = (pin - foot).Magnitude
		add({
			Name = "Yoke",
			Size = Vector3.new(1.6 * S, 2.6 * S, length),
			CFrame = CFrame.lookAt(foot, pin) * CFrame.new(0, 0, -length / 2),
			Color = gold,
			Material = Enum.Material.Foil,
		})
		add({
			Name = "Pin",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.6, 3, 3) * S,
			CFrame = CFrame.new(pin) * base.Rotation,
			Color = dark,
		})
	end
	local back = at(0, 0, 11).Position
	local length = (wall - back).Magnitude
	add({
		Name = "Bracket",
		Size = Vector3.new(3 * S, 3 * S, length + 1),
		CFrame = CFrame.lookAt(back, wall) * CFrame.new(0, 0, -length / 2),
		Color = gold,
		Material = Enum.Material.Foil,
	})
	add({
		Name = "Plate",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.4, 14 * S, 14 * S),
		CFrame = CFrame.lookAt(wall, wall + Drops.domeNormal(wall)) * along,
		Color = gold,
		Material = Enum.Material.Foil,
	})
	add({
		Name = "PlateMiddle",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.6, 10 * S, 10 * S),
		CFrame = CFrame.lookAt(wall, wall + Drops.domeNormal(wall)) * along,
		Color = color,
	})
	model.Parent = parent
	return model
end

-- The Freek House at the west end, with a glowing doorway Freeks walk into.
local function buildHouse(model: Model)
	local base = CFrame.new(Drops.HOUSE_POSITION) * CFrame.Angles(0, -math.pi / 2, 0) -- front faces +X
	local wall = Color3.fromRGB(150, 80, 220)
	local roofColor = Color3.fromRGB(90, 40, 150)
	part({
		Name = "FreekHouse",
		Size = Vector3.new(20, 16, 16),
		CFrame = base * CFrame.new(0, 8, 0),
		Color = wall,
		Material = Enum.Material.SmoothPlastic,
		Parent = model,
	})
	for _, side in { -1, 1 } do
		local roof = Instance.new("WedgePart")
		roof.Anchored = true
		roof.Name = "Roof"
		roof.Size = Vector3.new(18, 6, 10.5)
		roof.CFrame = base
			* CFrame.new(side * 5.25, 19, 0)
			* CFrame.Angles(0, if side > 0 then -math.pi / 2 else math.pi / 2, 0)
		roof.Color = roofColor
		roof.Material = Enum.Material.SmoothPlastic
		roof.Parent = model
	end
	part({
		Name = "Doorway",
		Size = Vector3.new(9, 9, 0.4),
		CFrame = base * CFrame.new(0, 4.5, -8.05),
		Color = Color3.fromRGB(255, 220, 120),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	for _, x in { -4.9, 4.9 } do
		part({
			Name = "DoorFrame",
			Size = Vector3.new(0.9, 10, 0.9),
			CFrame = base * CFrame.new(x, 5, -8.2),
			Color = Color3.new(1, 1, 1),
			Parent = model,
		})
	end
	part({
		Name = "DoorFrame",
		Size = Vector3.new(10.7, 0.9, 0.9),
		CFrame = base * CFrame.new(0, 9.6, -8.2),
		Color = Color3.new(1, 1, 1),
		Parent = model,
	})
	for _, x in { -7, 7 } do
		part({
			Name = "Window",
			Size = Vector3.new(3, 3, 0.3),
			CFrame = base * CFrame.new(x, 10, -8.1),
			Color = Color3.fromRGB(255, 225, 140),
			Material = Enum.Material.Neon,
			Parent = model,
		})
	end
	part({
		Name = "Chimney",
		Size = Vector3.new(2.5, 6, 2.5),
		CFrame = base * CFrame.new(5, 22, 3),
		Color = Color3.fromRGB(140, 70, 60),
		Material = Enum.Material.Brick,
		Parent = model,
	})
	Decor.signboard(model, base * CFrame.new(0, 13.4, -8.4), Vector2.new(13, 2.4), "FREEK HOUSE", roofColor)
end

local function priceOf(species, mutations: { string }?): number
	local base = species.price or math.floor(species.income * Drops.PRICE_SECONDS)
	return math.floor(base * Mutations.mult(mutations))
end

-- Species that can come out of a cannon right now, grouped by rarity.
local function eligibleByRarity()
	local groups = {}
	for _, species in Freeks.list do
		if
			Seasons.available(species)
			and species.rarity ~= "Secret"
			and not species.exclusive
			and not species.event
		then
			groups[species.rarity] = groups[species.rarity] or {}
			table.insert(groups[species.rarity], species)
		end
	end
	return groups
end

-- Lucky Skies (see Luck.luau) and big events (Events.luau) make Rare and better more likely.
local function rollRarity(): string
	local boost = Events.boost("rareBoost")
	local function weightOf(entry)
		return if Rarities.rank[entry.rarity] >= Rarities.rank.Rare then entry.weight * boost else entry.weight
	end
	local total = 0
	for _, entry in Drops.ODDS do
		total += weightOf(entry)
	end
	local roll = rng:NextNumber() * total
	for _, entry in Drops.ODDS do
		roll -= weightOf(entry)
		if roll <= 0 then
			return entry.rarity
		end
	end
	return Drops.ODDS[1].rarity
end

-- Cannon Freeks get at most one mutation; stacking them is done by fusing.
local function rollMutations(): { string }?
	local boost = Events.boost("mutationBoost") -- Rainbow Hour, Monster Storm
	for _, mutation in Mutations.list do
		if rng:NextNumber() < mutation.chance * Drops.MUTATION_FACTOR * boost then
			return { mutation.id }
		end
	end
	return nil
end

-- Fires a random Freek (or the given one, from the admin panel) from cannon `cannon`.
local function fire(cannon: number, forcedSpecies: string?, forcedMutations: { string }?)
	local species
	local big = Events.current()
	if forcedSpecies then
		species = Freeks.byId[forcedSpecies]
	elseif big and big.eventFreek and Freeks.byId[big.eventFreek] and rng:NextNumber() < big.eventChance then
		species = Freeks.byId[big.eventFreek] -- the event-only Freek!
	else
		local groups = eligibleByRarity()
		local rarity = rollRarity()
		-- Nothing of that rarity exists yet: fall back down the tiers.
		while not groups[rarity] and Rarities.rank[rarity] > 1 do
			rarity = Rarities.order[Rarities.rank[rarity] - 1]
		end
		local pool = groups[rarity]
		if not pool then
			return
		end
		species = pool[rng:NextInteger(1, #pool)]
	end
	if not species then
		return
	end
	local mutations = if forcedSpecies then forcedMutations else rollMutations()
	local price = priceOf(species, mutations)
	-- A moment of warning so every client has the Freek before it leaves the barrel.
	local launch = Workspace:GetServerTimeNow() + 0.5
	local seed = rng:NextInteger(1, 2 ^ 30)
	local path = Drops.plan(seed, cannon, launch)

	nextId += 1
	local id = tostring(nextId)
	local model, height = FreekModel.build(species.id, mutations)
	model.Name = id
	model:SetAttribute("Seed", seed)
	model:SetAttribute("Cannon", cannon)
	model:SetAttribute("Launch", launch)
	model:PivotTo(CFrame.new(path.muzzle))

	local anchor = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	local freek = { species = species.id, mutations = mutations }
	FreekTag.add(anchor, freek, height - (anchor.Position.Y - path.muzzle.Y) + 1.6, 90, price)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GrabPrompt"
	prompt.ActionText = "Grab " .. Format.money(price)
	prompt.ObjectText = FreekUtil.displayName(freek)
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = Drops.GRAB_DISTANCE - 2
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false -- clients switch it on once it has landed
	prompt:SetAttribute("ItemId", id)
	prompt.Parent = anchor

	model.Parent = folder
	items[id] = { species = species, mutations = mutations, price = price, path = path, model = model }
	-- Clients play the boom and smoke when this changes.
	cannons[cannon]:SetAttribute("FiredAt", launch)

	if Rarities.rank[species.rarity] >= Drops.ANNOUNCE_RANK then
		for _, player in Players:GetPlayers() do
			notify(
				player,
				"A " .. species.rarity .. " " .. FreekUtil.displayName(freek) .. " just got fired!",
				"discovery"
			)
		end
	end
end

local function grab(player: Player, data, id: any)
	local item = typeof(id) == "string" and items[id]
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not item or not root then
		return
	end
	-- Checked against where the Freek is by the server's own maths (clients move the
	-- models). A little extra range covers lag.
	local where, doing = Drops.cframeAt(item.path, Workspace:GetServerTimeNow())
	if doing ~= "wandering" and doing ~= "leaving" then
		return
	end
	local flat = (root.Position - where.Position) * Vector3.new(1, 0, 1)
	if flat.Magnitude > Drops.GRAB_DISTANCE + 4 then
		return
	end
	if not PlotService.getPlot(player) then
		return
	end
	if StealService.isCarrying(player) then
		return notify(player, "Your hands are full! Take that Freek home first.", "error")
	end
	if FreekUtil.count(data) >= GamePasses.maxFreeks(player) or not FreekUtil.freeSlot(data) then
		return notify(player, "Your barn is full! Buy more slots or sell a Freek.", "error")
	end
	if data.money < item.price then
		return notify(player, "Not enough money! It costs " .. Format.money(item.price) .. ".", "error")
	end

	items[id] = nil
	item.model:Destroy()
	data.money -= item.price
	local uid = ActionService.giveFreek(player, data, item.species.id, item.mutations)
	local freek = data.freeks[uid]
	local name = FreekUtil.displayName(freek)
	-- It goes in the player's arms; walking into their barn puts it on a pad.
	local slot = freek.slot
	freek.slot = nil
	if StealService.carryHome(player, uid, freek) then
		notify(player, "You grabbed " .. name .. "! Carry it back to your barn.", "success")
	else
		freek.slot = slot
		notify(player, "You got " .. name .. "! It's in your barn.", "success")
	end
end

-- Fires a chosen Freek from a random cannon right away (the admin panel's "admin abuse").
function CannonService.fireNow(speciesId: string, mutations: { string }?)
	fire(rng:NextInteger(1, Drops.CANNON_COUNT), speciesId, mutations)
end

function CannonService.init()
	local world = Instance.new("Model")
	world.Name = "Cannons"
	world.Parent = Workspace
	buildDome(world)
	for index = 1, Drops.CANNON_COUNT do
		cannons[index] = buildCannon(world, index)
	end
	buildHouse(world)

	folder = Instance.new("Folder")
	folder.Name = "DropFreeks"
	folder.Parent = Workspace

	-- Grab prompts are handled on the client (the server never moves these models, so
	-- Roblox's own prompt range check would reject them); the client sends GrabDrop instead.
	ActionService.register("GrabDrop", grab)

	-- The cannons take turns, so one fires every FIRE_INTERVAL / CANNON_COUNT seconds and
	-- each cannon fires every FIRE_INTERVAL.
	task.spawn(function()
		local cannon = 0
		while true do
			cannon = cannon % Drops.CANNON_COUNT + 1
			fire(cannon)
			-- Rapid Fire and big events speed the cannons up.
			task.wait(Drops.FIRE_INTERVAL / Drops.CANNON_COUNT / Events.boost("fireRate"))
		end
	end)

	-- Freeks nobody grabbed go into the Freek House.
	task.spawn(function()
		while true do
			task.wait(0.5)
			local now = Workspace:GetServerTimeNow()
			for id, item in items do
				if now >= item.path.finish then
					item.model:Destroy()
					items[id] = nil
				end
			end
		end
	end)
end

return CannonService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Carried</string>
          <string name="Source"><![CDATA[-- Which Freeks are being carried off by a thief right now. Kept in memory only: if the
-- server stops mid-steal, the owner simply keeps the Freek.

local Carried = {}

local byOwner = {} -- [owner Player] = { [uid] = thief Player }

function Carried.is(owner: Player, uid: string): boolean
	local list = byOwner[owner]
	return list ~= nil and list[uid] ~= nil
end

function Carried.set(owner: Player, uid: string, thief: Player?)
	local list = byOwner[owner]
	if thief then
		if not list then
			list = {}
			byOwner[owner] = list
		end
		list[uid] = thief
	elseif list then
		list[uid] = nil
		if next(list) == nil then
			byOwner[owner] = nil
		end
	end
end

-- True if any of this owner's Freeks are being carried off right now.
function Carried.any(owner: Player): boolean
	return byOwner[owner] ~= nil
end

return Carried
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Loads and saves each player's data with a session lock, so the same player in two
-- servers at once (e.g. a fast rejoin) can't duplicate or lose Freeks.
--
-- In Studio without "Enable Studio Access to API Services", saving is skipped and a
-- fresh save is used so the game is still testable.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Freeks = require(ReplicatedStorage.Shared.Freeks)
local Mutations = require(ReplicatedStorage.Shared.Mutations)

local STORE_NAME = "FuseAFreek_Players_v1"

local DataService = {}

local profiles = {} -- [Player] = data
local noSave = {} -- [Player] = true when running without DataStores
local loadedCallbacks = {}
local changedCallbacks = {}

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local function defaultData()
	return {
		version = 1,
		money = Config.START_MONEY,
		slots = Config.START_SLOTS,
		freeks = {}, -- [uid] = { species, mutations?, slot?, breeding? }
		breeding = nil, -- { a = uid, b = uid, endsAt = unix seconds }
		discovered = {}, -- [speciesId] = true for every species this player has owned
		rebirths = 0,
		crates = {}, -- [crateId] = how many unopened Monster Crates (won on the wheel)
		receipts = {}, -- recent Robux purchase IDs, so a purchase is never granted twice
		lastSpin = 0, -- os.time() of the last Lucky Wheel spin
		lastSeen = os.time(),
		firstJoin = os.time(), -- when they first played (starts the Starter Pack countdown)
		starterBought = false,
	}
end

local function reconcile(data)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		end
	end
	if Config.TEST_MONEY and data.money < Config.TEST_MONEY then
		data.money = Config.TEST_MONEY
	end
	-- Old saves stored a single mutation.
	for _, freek in data.freeks do
		if freek.mutation then
			freek.mutations = Mutations.pack(freek.mutation)
			freek.mutation = nil
		end
	end
	-- Freeks whose species no longer exists (removed from Freeks.luau) are dropped, along
	-- with any Fusion Den using them.
	for uid, freek in data.freeks do
		if not Freeks.byId[freek.species] then
			data.freeks[uid] = nil
		end
	end
	for _, key in FreekUtil.PEN_KEYS do
		local pen = data[key]
		if pen and not (data.freeks[pen.a] and data.freeks[pen.b]) then
			for _, uid in { pen.a, pen.b } do
				local freek = data.freeks[uid]
				if freek then
					freek.breeding = nil
				end
			end
			data[key] = nil
		end
	end
	return data
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

-- Returns data, or nil + reason. reason is "locked" when another server holds the save.
local function tryLoad(player: Player)
	local locked = false
	local ok, result = pcall(function()
		return store:UpdateAsync(keyFor(player), function(old)
			locked = false
			old = old or defaultData()
			local lock = old.lock
			if lock and lock.job ~= game.JobId and os.time() - lock.time < Config.SESSION_LOCK_TIMEOUT then
				locked = true
				return nil
			end
			old.lock = { job = game.JobId, time = os.time() }
			return old
		end)
	end)
	if not ok then
		return nil, result
	end
	if locked then
		return nil, "locked"
	end
	return result, nil
end

local function load(player: Player)
	if not store then
		return nil, "DataStores unavailable"
	end
	local reason
	for attempt = 1, 6 do
		local data
		data, reason = tryLoad(player)
		if data then
			return reconcile(data)
		end
		if not player.Parent then
			return nil, "left"
		end
		if RunService:IsStudio() and reason ~= "locked" then
			return nil, reason -- don't make testers wait through retries
		end
		task.wait(if reason == "locked" then 10 else 2 * attempt)
	end
	return nil, reason
end

-- Saves the player's data. Returns true once it's safely stored (or if this is a
-- temporary Studio save that's never stored).
function DataService.save(player: Player, release: boolean?): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	if noSave[player] then
		return true
	end
	data.lastSeen = os.time()
	data.lock = if release then nil else { job = game.JobId, time = os.time() }
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function(old)
				if old and old.lock and old.lock.job ~= game.JobId then
					return nil -- another server took over; never overwrite its save
				end
				return data
			end)
		end)
		if ok then
			return true
		end
		warn("Save failed for", player.Name, err)
		task.wait(attempt)
	end
	return false
end

function DataService.get(player: Player)
	return profiles[player]
end

-- Yields until the player's data is loaded; returns nil if they leave first.
function DataService.waitFor(player: Player)
	while player.Parent and not profiles[player] do
		task.wait(0.1)
	end
	return profiles[player]
end

function DataService.all()
	return profiles
end

function DataService.onLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

function DataService.onChanged(callback)
	table.insert(changedCallbacks, callback)
end

-- Call after changing a player's data so their yard and UI refresh.
function DataService.changed(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	for _, callback in changedCallbacks do
		task.spawn(callback, player, data)
	end
end

local function onPlayerAdded(player: Player)
	local data, reason = load(player)
	if not player.Parent then
		return
	end
	if not data then
		if RunService:IsStudio() then
			warn("Using a temporary save (not saved). Reason:", reason)
			data = reconcile(defaultData())
			noSave[player] = true
		elseif reason == "locked" then
			player:Kick("Your Freeks are still saving from your last server. Please rejoin in a minute!")
			return
		else
			player:Kick("Couldn't load your Freeks right now. Please rejoin!")
			return
		end
	end
	profiles[player] = data
	for _, callback in loadedCallbacks do
		task.spawn(callback, player, data)
	end
	DataService.changed(player)
end

local function onPlayerRemoving(player: Player)
	if profiles[player] then
		DataService.save(player, true)
	end
	profiles[player] = nil
	noSave[player] = nil
end

function DataService.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Decor</string>
          <string name="Source"><![CDATA[-- Reusable scenery pieces built from parts: trees, bushes, flowers, lamp posts, picket
-- fences and signboards. Every builder takes a parent and a CFrame on the ground.

local CollectionService = game:GetService("CollectionService")

local Decor = {}

-- Tags let SeasonalService recolour scenery for events (e.g. orange leaves at Halloween).
Decor.TAGS = { leaves = "TreeLeaves", bulb = "LampBulb", lawn = "Lawn" }

-- Remembers a part's normal colour so a seasonal theme can be undone.
function Decor.tag(instance: BasePart, tag: string)
	instance:SetAttribute("BaseColor", instance.Color)
	CollectionService:AddTag(instance, tag)
end

local function part(props, className: string?): BasePart
	local p = Instance.new(className or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		p[key] = value
	end
	return p
end
Decor.part = part

local LEAF_COLORS = {
	Color3.fromRGB(70, 160, 70),
	Color3.fromRGB(90, 180, 80),
	Color3.fromRGB(60, 140, 75),
}

-- A round cartoon tree. scale 1 is about 14 studs tall.
function Decor.tree(parent: Instance, ground: CFrame, scale: number?, seed: number?)
	local s = scale or 1
	local rng = Random.new(seed or 1)
	part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(7 * s, 1.6 * s, 1.6 * s),
		CFrame = ground * CFrame.new(0, 3.5 * s, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(120, 85, 55),
		Material = Enum.Material.Wood,
		Parent = parent,
	})
	for i = 1, 3 do
		local size = (5.5 + rng:NextNumber() * 2) * s
		local offset =
			Vector3.new((rng:NextNumber() - 0.5) * 3 * s, (7.5 + i * 1.6) * s, (rng:NextNumber() - 0.5) * 3 * s)
		Decor.tag(
			part({
				Name = "Leaves",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * size,
				CFrame = ground * CFrame.new(offset),
				Color = LEAF_COLORS[rng:NextInteger(1, #LEAF_COLORS)],
				Material = Enum.Material.Grass,
				CanCollide = false,
				Parent = parent,
			}),
			Decor.TAGS.leaves
		)
	end
end

function Decor.bush(parent: Instance, ground: CFrame, scale: number?, seed: number?)
	local s = scale or 1
	local rng = Random.new(seed or 2)
	for _ = 1, 3 do
		local size = (2.2 + rng:NextNumber() * 1.2) * s
		part({
			Name = "Bush",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size,
			CFrame = ground
				* CFrame.new((rng:NextNumber() - 0.5) * 2.5 * s, size * 0.35, (rng:NextNumber() - 0.5) * 1.5 * s),
			Color = LEAF_COLORS[rng:NextInteger(1, #LEAF_COLORS)],
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local FLOWER_COLORS = {
	Color3.fromRGB(255, 110, 150),
	Color3.fromRGB(255, 220, 80),
	Color3.fromRGB(170, 120, 255),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(255, 150, 60),
}

-- A rectangular flower bed (width along X, depth along Z).
function Decor.flowerBed(parent: Instance, ground: CFrame, width: number, depth: number, seed: number?)
	local rng = Random.new(seed or 3)
	part({
		Name = "FlowerBed",
		Size = Vector3.new(width, 0.4, depth),
		CFrame = ground * CFrame.new(0, 0.2, 0),
		Color = Color3.fromRGB(110, 75, 50),
		Material = Enum.Material.Ground,
		CanCollide = false,
		Parent = parent,
	})
	local count = math.floor(width * depth / 2.5)
	for _ = 1, count do
		local x = (rng:NextNumber() - 0.5) * (width - 0.8)
		local z = (rng:NextNumber() - 0.5) * (depth - 0.8)
		part({
			Name = "Stem",
			Size = Vector3.new(0.15, 0.8, 0.15),
			CFrame = ground * CFrame.new(x, 0.8, z),
			Color = Color3.fromRGB(70, 150, 60),
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
		part({
			Name = "Flower",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.55,
			CFrame = ground * CFrame.new(x, 1.25, z),
			Color = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)],
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
	end
end

-- A lamp post with a warm light that glows at night and adds sparkle by day.
function Decor.lamp(parent: Instance, ground: CFrame, color: Color3?)
	part({
		Name = "LampPost",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(8, 0.5, 0.5),
		CFrame = ground * CFrame.new(0, 4, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(45, 45, 55),
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Name = "LampBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 1.4, 1.4),
		CFrame = ground * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(45, 45, 55),
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	local bulb = part({
		Name = "Bulb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.3,
		CFrame = ground * CFrame.new(0, 8.4, 0),
		Color = color or Color3.fromRGB(255, 225, 160),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	local light = Instance.new("PointLight")
	light.Color = color or Color3.fromRGB(255, 210, 150)
	light.Range = 18
	light.Brightness = 1.2
	light.Shadows = false
	light.Parent = bulb
	Decor.tag(bulb, Decor.TAGS.bulb)
end

-- A glowing jack-o'-lantern. scale 1 is about 3 studs wide; its face looks along -Z.
function Decor.pumpkin(parent: Instance, ground: CFrame, scale: number?)
	local s = scale or 1
	local orange = Color3.fromRGB(235, 125, 30)
	local center = ground * CFrame.new(0, 1.2 * s, 0)
	-- Three overlapping balls make the ribbed shape.
	local body
	for _, dx in { -0.55, 0, 0.55 } do
		local ball = part({
			Name = "Pumpkin",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (if dx == 0 then 2.5 else 2.2) * s,
			CFrame = center * CFrame.new(dx * s, 0, 0),
			Color = if dx == 0 then orange else orange:Lerp(Color3.new(0, 0, 0), 0.08),
			Parent = parent,
		})
		if dx == 0 then
			body = ball
		end
	end
	part({
		Name = "Stem",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7 * s, 0.35 * s, 0.35 * s),
		CFrame = center * CFrame.new(0, 1.3 * s, 0) * CFrame.Angles(0, 0, math.pi / 2 + 0.2),
		Color = Color3.fromRGB(90, 110, 40),
		CanCollide = false,
		Parent = parent,
	})
	-- Glowing face: two triangle eyes and a grin.
	local glow = Color3.fromRGB(255, 200, 70)
	for _, dx in { -0.45, 0.45 } do
		part({
			Name = "Eye",
			Size = Vector3.new(0.12, 0.45 * s, 0.5 * s),
			CFrame = center * CFrame.new(dx * s, 0.3 * s, -1.18 * s) * CFrame.Angles(0, math.pi / 2, 0),
			Color = glow,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = parent,
		}, "WedgePart")
	end
	part({
		Name = "Grin",
		Size = Vector3.new(1.1 * s, 0.25 * s, 0.12),
		CFrame = center * CFrame.new(0, -0.35 * s, -1.2 * s),
		Color = glow,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 50)
	light.Range = 10 * s
	light.Brightness = 1.5
	light.Shadows = false
	light.Parent = body
end

-- A hay bale with twine bands, lying along X.
function Decor.hayBale(parent: Instance, ground: CFrame)
	part({
		Name = "HayBale",
		Size = Vector3.new(4, 2.4, 2.6),
		CFrame = ground * CFrame.new(0, 1.2, 0),
		Color = Color3.fromRGB(225, 190, 95),
		Material = Enum.Material.Sand,
		Parent = parent,
	})
	for _, dx in { -1, 1 } do
		part({
			Name = "Twine",
			Size = Vector3.new(0.25, 2.5, 2.7),
			CFrame = ground * CFrame.new(dx, 1.2, 0),
			Color = Color3.fromRGB(140, 100, 55),
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local FALL_LEAVES = {
	Color3.fromRGB(230, 120, 40),
	Color3.fromRGB(200, 70, 40),
	Color3.fromRGB(235, 180, 50),
	Color3.fromRGB(170, 100, 50),
}
Decor.FALL_LEAVES = FALL_LEAVES

-- A low pile of fallen leaves: overlapping flat discs in autumn colours.
function Decor.leafPile(parent: Instance, ground: CFrame, seed: number?)
	local rng = Random.new(seed or 9)
	for i = 1, 6 do
		local size = 1.6 + rng:NextNumber() * 1.6
		part({
			Name = "LeafPile",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.35, size, size),
			CFrame = ground
				* CFrame.new((rng:NextNumber() - 0.5) * 3, 0.1 + i * 0.07, (rng:NextNumber() - 0.5) * 3)
				* CFrame.Angles(0, 0, math.pi / 2),
			Color = FALL_LEAVES[rng:NextInteger(1, #FALL_LEAVES)],
			Material = Enum.Material.Grass,
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
	end
end

-- A white picket fence from a to b (both on the ground). Pickets every `spacing` studs.
function Decor.picketFence(parent: Instance, a: Vector3, b: Vector3, height: number, color: Color3?)
	local white = color or Color3.fromRGB(245, 242, 235)
	local length = (b - a).Magnitude
	if length < 0.5 then
		return
	end
	local along = CFrame.lookAt(a, b) -- -Z points from a to b
	for _, y in { height * 0.35, height * 0.75 } do
		part({
			Name = "Rail",
			Size = Vector3.new(0.3, 0.35, length),
			CFrame = along * CFrame.new(0, y, -length / 2),
			Color = white,
			Material = Enum.Material.WoodPlanks,
			Parent = parent,
		})
	end
	local spacing = 1.6
	local count = math.max(1, math.floor(length / spacing))
	for i = 0, count do
		local z = -math.min(length, i * length / count)
		part({
			Name = "Picket",
			Size = Vector3.new(0.25, height, 0.7),
			CFrame = along * CFrame.new(0, height / 2, z),
			Color = white,
			Material = Enum.Material.WoodPlanks,
			Parent = parent,
		})
		-- A small block turned 45 degrees gives each picket a pointed top.
		local tip = part({
			Name = "PicketTip",
			Size = Vector3.new(0.25, 0.5, 0.5),
			CFrame = along * CFrame.new(0, height, z) * CFrame.Angles(math.rad(45), 0, 0),
			Color = white,
			Material = Enum.Material.WoodPlanks,
			Parent = parent,
		})
		tip.CanCollide = false
	end
end

-- A wooden signboard with text on both faces. Returns the front TextLabel (and back).
function Decor.signboard(parent: Instance, cframe: CFrame, size: Vector2, text: string, accent: Color3)
	local board = part({
		Name = "Signboard",
		Size = Vector3.new(size.X, size.Y, 0.5),
		CFrame = cframe,
		Color = Color3.fromRGB(140, 95, 60),
		Material = Enum.Material.WoodPlanks,
		Parent = parent,
	})
	part({
		Name = "SignTrim",
		Size = Vector3.new(size.X + 0.6, size.Y + 0.6, 0.35),
		CFrame = cframe,
		Color = accent,
		Parent = parent,
	})
	local labels = {}
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 0.3
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.Text = text
		label.TextColor3 = Color3.fromRGB(255, 250, 235)
		label.TextStrokeTransparency = 0.4
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0.04, 0)
		padding.PaddingRight = UDim.new(0.04, 0)
		padding.PaddingTop = UDim.new(0.12, 0)
		padding.PaddingBottom = UDim.new(0.12, 0)
		padding.Parent = label
		label.Parent = gui
		gui.Parent = board
		table.insert(labels, label)
	end
	return labels
end

return Decor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">DiscoveryService</string>
          <string name="Source"><![CDATA[-- The Discovery Book: the first player in the whole game to get each species has their
-- name saved forever. Claims go through UpdateAsync so two servers can't both win, and
-- MessagingService tells every other server right away.

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Freeks = require(ReplicatedStorage.Shared.Freeks)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local STORE_NAME = "FuseAFreek_Discoveries_v1"
local TOPIC = "FreekDiscovered"

local DiscoveryService = {}

local cache = {} -- [speciesId] = { name, userId, time }
local claiming = {}
local store = nil
pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local discoveryUpdate = Remotes.get("DiscoveryUpdate")
local notify = Remotes.get("Notify")

-- DataStore keys can be at most 50 characters; long hybrid ids are hashed to fit.
local function storeKey(speciesId: string): string
	if #speciesId <= 50 then
		return speciesId
	end
	local hash = 5381
	for i = 1, #speciesId do
		hash = (hash * 33 + string.byte(speciesId, i)) % 4294967296
	end
	return string.format("H%08x%d", hash, #speciesId)
end

local function announce(speciesId: string, discovery)
	local isNew = cache[speciesId] == nil
	cache[speciesId] = discovery
	discoveryUpdate:FireAllClients(speciesId, discovery)
	if isNew then
		local species = Freeks.byId[speciesId]
		notify:FireAllClients(
			string.format("%s discovered %s for the first time ever!", discovery.name, species.name),
			"discovery"
		)
	end
end

local function loadAll()
	if not store then
		return
	end
	for _, species in Freeks.list do
		if not species.price and not cache[species.id] then
			local ok, value = pcall(store.GetAsync, store, species.id)
			if ok and value then
				cache[species.id] = value
			end
		end
	end
end

-- Call whenever a player gets a species. Shop (starter) Freeks aren't claimable.
function DiscoveryService.claim(player: Player, speciesId: string)
	local species = Freeks.byId[speciesId]
	if not species or species.price or cache[speciesId] or claiming[speciesId] then
		return
	end
	claiming[speciesId] = true

	local mine = { name = player.DisplayName, userId = player.UserId, time = os.time() }
	local winner = mine
	if store then
		local ok, result = pcall(function()
			local existing = nil
			store:UpdateAsync(storeKey(speciesId), function(old)
				existing = old
				if old then
					return nil
				end
				return mine
			end)
			return existing
		end)
		if ok then
			winner = result or mine
		elseif not RunService:IsStudio() then
			warn("Discovery claim failed:", result)
			claiming[speciesId] = nil
			return
		end
	end

	announce(speciesId, winner)
	if winner == mine then
		pcall(MessagingService.PublishAsync, MessagingService, TOPIC, { species = speciesId, discovery = mine })
	end
	claiming[speciesId] = nil
end

-- True once someone, anywhere, has found this species.
function DiscoveryService.isDiscovered(speciesId: string): boolean
	return cache[speciesId] ~= nil
end

function DiscoveryService.init()
	Remotes.get("GetDiscoveries").OnServerInvoke = function()
		return cache
	end

	-- In the background: SubscribeAsync can hang for a long time in Studio, and nothing
	-- else should wait on it.
	task.spawn(pcall, function()
		MessagingService:SubscribeAsync(TOPIC, function(message)
			local data = message.Data
			if typeof(data) == "table" and Freeks.byId[data.species] then
				announce(data.species, data.discovery)
			end
		end)
	end)

	task.spawn(function()
		while true do
			loadAll()
			task.wait(300)
		end
	end)

	-- Re-check species a player already owns, in case an earlier claim failed.
	local DataService = require(script.Parent.DataService)
	DataService.onLoaded(function(player, data)
		for speciesId in data.discovered do
			DiscoveryService.claim(player, speciesId)
		end
	end)
end

return DiscoveryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[-- Pays every player once a second for the Freeks in their yard, plus offline earnings
-- when they come back. Money also shows on the leaderboard so players can show off.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)

local EconomyService = {}

-- Yard income including rebirths and game passes.
local function incomeFor(player: Player, data): number
	return FreekUtil.yardIncome(data) * GamePasses.coinMultiplier(player)
end

local function publish(player: Player, data, income: number)
	player:SetAttribute("Money", data.money)
	player:SetAttribute("Income", income)
	local stats = player:FindFirstChild("leaderstats")
	local money = stats and stats:FindFirstChild("Money")
	if money then
		money.Value = math.floor(data.money)
	end
	local rebirths = stats and stats:FindFirstChild("Rebirths")
	if rebirths then
		rebirths.Value = data.rebirths
	end
end

local function onLoaded(player: Player, data)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local money = Instance.new("NumberValue")
	money.Name = "Money"
	money.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player

	local income = incomeFor(player, data)
	local away = math.clamp(os.time() - (data.lastSeen or os.time()), 0, Config.OFFLINE_MAX_SECONDS)
	local earned = math.floor(away * income * Config.OFFLINE_RATE)
	if earned > 0 then
		data.money += earned
		Remotes.get("Notify")
			:FireClient(player, "While you were away your Freeks earned " .. Format.money(earned) .. "!", "money")
	end
	publish(player, data, income)
end

function EconomyService.init()
	DataService.onLoaded(onLoaded)
	DataService.onChanged(function(player, data)
		publish(player, data, incomeFor(player, data))
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			for player, data in DataService.all() do
				local income = incomeFor(player, data)
				data.money += income
				publish(player, data, income)
			end
		end
	end)
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">Environment</string>
          <string name="Source"><![CDATA[-- Lighting, sky, terrain and the scenery around the yards and conveyor.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Drops = require(ReplicatedStorage.Shared.Drops)

local Decor = require(script.Parent.Decor)

local Environment = {}

local function effect(className: string, props)
	local existing = Lighting:FindFirstChildOfClass(className)
	local instance = existing or Instance.new(className)
	for key, value in props do
		instance[key] = value
	end
	instance.Parent = Lighting
	return instance
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(70, 70, 90)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 135, 150)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	Lighting.GeographicLatitude = 35

	effect("Sky", { SunAngularSize = 14, MoonAngularSize = 9, StarCount = 3000 })
	effect("Atmosphere", {
		Density = 0.28,
		Offset = 0.15,
		Color = Color3.fromRGB(200, 215, 240),
		Decay = Color3.fromRGB(110, 130, 170),
		Glare = 0.25,
		Haze = 1.2,
	})
	effect("BloomEffect", { Intensity = 0.6, Size = 26, Threshold = 1.6 })
	effect("SunRaysEffect", { Intensity = 0.06, Spread = 0.7 })
	effect("ColorCorrectionEffect", {
		Brightness = 0.02,
		Contrast = 0.08,
		Saturation = 0.15,
		TintColor = Color3.fromRGB(255, 250, 242),
	})

	local clouds = Workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.6
	clouds.Color = Color3.fromRGB(255, 255, 255)
	clouds.Parent = Workspace.Terrain
end

local function setupTerrain()
	local terrain = Workspace.Terrain
	-- Grass everywhere, with the top of the terrain at y = 0.
	terrain:FillBlock(CFrame.new(0, -4, 0), Vector3.new(600, 8, 600), Enum.Material.Grass)
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(95, 175, 80))
	terrain:SetMaterialColor(Enum.Material.Pavement, Color3.fromRGB(196, 190, 180))
	-- No tall grass blades: they hide the feet of anything standing on the grass.
	pcall(function()
		terrain.Decoration = false
	end)
end

local function buildScenery()
	local folder = Instance.new("Folder")
	folder.Name = "Scenery"
	folder.Parent = Workspace

	-- The town square between the barn rows, where cannon Freeks land and wander: grass in
	-- the middle, a paved walkway in front of each row of barns, and street lamps in the
	-- gaps between the barns.
	local length = (Drops.AREA.maxX - Drops.AREA.minX) + 40
	local centerX = (Drops.AREA.maxX + Drops.AREA.minX) / 2
	-- A flat grass floor for the square, so Freeks walk on a level surface instead of
	-- terrain (whose grass blades would hide their feet).
	Decor.tag(
		Decor.part({
			Name = "TownSquare",
			Size = Vector3.new(length, Drops.GROUND_Y, 47.2),
			CFrame = CFrame.new(centerX - 10, Drops.GROUND_Y / 2, 0),
			Color = Color3.fromRGB(105, 185, 85),
			Material = Enum.Material.Grass,
			Parent = folder,
		}),
		Decor.TAGS.lawn
	)
	for _, side in { -1, 1 } do
		Decor.part({
			Name = "Walkway",
			Size = Vector3.new(length, 0.3, 8),
			CFrame = CFrame.new(centerX, 0.15, side * 28),
			Color = Color3.fromRGB(200, 194, 184),
			Material = Enum.Material.Pavement,
			Parent = folder,
		})
		Decor.part({
			Name = "Curb",
			Size = Vector3.new(length, 0.5, 0.8),
			CFrame = CFrame.new(centerX, 0.25, side * 23.8),
			Color = Color3.fromRGB(150, 145, 140),
			Material = Enum.Material.Concrete,
			Parent = folder,
		})
		for _, x in { -140, -70, 0, 70, 140 } do
			Decor.lamp(folder, CFrame.new(x, 0.3, side * 28.5))
		end
	end

	-- A ring of trees around the edge of the map.
	local seed = 10
	for x = -200, 200, 26 do
		for _, z in { -150, 150 } do
			seed += 1
			Decor.tree(folder, CFrame.new(x + (seed % 5) * 2, 0, z + (seed % 3) * 4), 1.2 + (seed % 4) * 0.15, seed)
		end
	end
	for z = -124, 124, 26 do
		for _, x in { -210, 210 } do
			seed += 1
			Decor.tree(folder, CFrame.new(x + (seed % 3) * 4, 0, z), 1.2 + (seed % 4) * 0.15, seed)
		end
	end
	-- Bushes and flowers by the spawn.
	Decor.flowerBed(folder, CFrame.new(150, 0, -12), 10, 3, 4)
	Decor.flowerBed(folder, CFrame.new(150, 0, 12), 10, 3, 5)
	Decor.bush(folder, CFrame.new(158, 0, -18), 1.3, 6)
	Decor.bush(folder, CFrame.new(158, 0, 18), 1.3, 7)
end

function Environment.init()
	setupLighting()
	setupTerrain()
	buildScenery()
end

return Environment
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[-- Runs the scheduled events (see shared/Events.luau) and the ones the admin starts.
--
-- Every second it works out what should be running and publishes it as ReplicatedStorage
-- attributes (Event/EventEnds, Weather/WeatherEnds, NextEvent/NextEventAt,
-- NextWeather/NextWeatherAt), announcing each start and end. While weather runs, Freeks
-- standing in barns can catch its mutation.
--
-- Admin events reach every server at once through MessagingService, and are also saved in
-- a DataStore so servers that start up later still join in.

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Events = require(ReplicatedStorage.Shared.Events)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Luck = require(ReplicatedStorage.Shared.Luck)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)

local EventService = {}

local TOPIC = "FuseAFreekAdmin"
local STORE_KEY = "AdminEvents"

local notifyRemote = Remotes.get("Notify")
local rng = Random.new()
local store -- the DataStore, if this server can use one

-- What the admin has started: { big = { id, ends }, weather = { id, ends } }.
local overrides = { big = nil, weather = nil }

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function announce(message: string)
	for _, player in Players:GetPlayers() do
		notifyRemote:FireClient(player, message, "discovery")
	end
end

-- Applies an admin message (from this server or another one).
local function apply(message)
	if type(message) ~= "table" then
		return
	end
	if message.type == "event" then
		local kind = if Events.BIG[message.id]
			then "big"
			elseif Events.WEATHER[message.id] then "weather"
			elseif Luck.EVENTS[message.id] then "lucky"
			else nil
		if kind == "lucky" then
			ReplicatedStorage:SetAttribute("LuckyEvent", message.id)
			ReplicatedStorage:SetAttribute("LuckyEventEnds", message.ends)
			local event = Luck.EVENTS[message.id]
			announce(event.icon .. " " .. event.name .. "! " .. event.description)
		elseif kind then
			overrides[kind] = { id = message.id, ends = message.ends }
		end
	elseif message.type == "end" then
		-- End everything the admin started, and anything scheduled running right now.
		overrides.big = { id = nil, ends = message.ends or now() + 60 }
		overrides.weather = { id = nil, ends = message.ends or now() + 60 }
		ReplicatedStorage:SetAttribute("LuckyEvent", nil)
	elseif message.type == "announce" and type(message.text) == "string" then
		announce("📣 " .. message.text)
	end
end

-- Sends an admin message to this server and, if `everywhere`, every other server too.
function EventService.send(message, everywhere: boolean)
	apply(message)
	if not everywhere then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:PublishAsync(TOPIC, message)
		end)
		if not ok then
			warn("[EventService] Couldn't reach other servers: " .. tostring(err))
		end
		if store and message.type ~= "announce" then
			pcall(function()
				store:SetAsync(STORE_KEY, message)
			end)
		end
	end)
end

-- What's running (or nil): an admin override beats the timetable while it lasts.
local function pick(kind: string, scheduled)
	local override = overrides[kind]
	if override and now() < override.ends then
		if override.id then
			return { id = override.id, ends = override.ends }
		end
		return nil -- the admin ended it
	end
	return scheduled
end

-- Weather mutations: every Freek standing on a pad has a chance to catch it.
local function weatherTick(weather)
	for _, player in Players:GetPlayers() do
		local data = DataService.get(player)
		if data then
			local changed = false
			for _, freek in data.freeks do
				local mutations = Mutations.normalize(freek.mutations)
				if freek.slot and not table.find(mutations, weather.mutation) and rng:NextNumber() < weather.chance then
					table.insert(mutations, weather.mutation)
					freek.mutations = Mutations.pack(mutations)
					changed = true
					notifyRemote:FireClient(
						player,
						weather.icon
							.. " Your "
							.. FreekUtil.displayName(freek)
							.. " caught the "
							.. weather.name
							.. "!",
						"discovery"
					)
				end
			end
			if changed then
				DataService.changed(player)
			end
		end
	end
end

function EventService.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("FuseAFreekEvents")
	end)
	store = ok and result or nil

	pcall(function()
		MessagingService:SubscribeAsync(TOPIC, function(packet)
			apply(packet.Data)
		end)
	end)

	-- Pick up an admin event another server started before this one existed.
	task.spawn(function()
		if store then
			local loaded, message = pcall(function()
				return store:GetAsync(STORE_KEY)
			end)
			if loaded and type(message) == "table" and (message.ends or 0) > now() then
				apply(message)
			end
		end
	end)

	local running = { big = nil, weather = nil }
	local nextTick = 0
	task.spawn(function()
		while true do
			local t = now()
			local unix = os.time()
			local offset = t - unix -- server time vs. the UTC clock the timetable uses
			local scheduledBig = Events.scheduledAt(unix)
			local scheduledWeather = Events.scheduledWeatherAt(unix)
			local big = pick("big", scheduledBig and { id = scheduledBig.id, ends = scheduledBig.ends + offset })
			local weather = pick(
				"weather",
				scheduledWeather and { id = scheduledWeather.id, ends = scheduledWeather.ends + offset }
			)

			for kind, state in { big = big, weather = weather } do
				local before = running[kind]
				local id = state and state.id
				local list = if kind == "big" then Events.BIG else Events.WEATHER
				if id ~= (before and before.id) then
					if before and before.id then
						announce(list[before.id].name .. " is over!")
					end
					if id then
						local event = list[id]
						announce(event.icon .. " " .. string.upper(event.name) .. "! " .. event.description)
					end
				end
				running[kind] = state
			end
			ReplicatedStorage:SetAttribute("Event", big and big.id)
			ReplicatedStorage:SetAttribute("EventEnds", big and big.ends or 0)
			ReplicatedStorage:SetAttribute("Weather", weather and weather.id)
			ReplicatedStorage:SetAttribute("WeatherEnds", weather and weather.ends or 0)

			-- What's coming next, for the countdowns.
			local upcoming = Events.upcoming(unix)
			local nextBig
			for _, slot in upcoming do
				if slot.starts > unix then
					nextBig = slot
					break
				end
			end
			ReplicatedStorage:SetAttribute("NextEvent", nextBig and nextBig.id)
			ReplicatedStorage:SetAttribute("NextEventAt", nextBig and nextBig.starts + offset or 0)
			local nextWeather = Events.nextWeather(unix)
			if nextWeather and nextWeather.starts <= unix then
				nextWeather = Events.nextWeather(nextWeather.ends + 1)
			end
			ReplicatedStorage:SetAttribute("NextWeather", nextWeather and nextWeather.id)
			ReplicatedStorage:SetAttribute("NextWeatherAt", nextWeather and nextWeather.starts + offset or 0)

			if weather and Events.WEATHER[weather.id] and t >= nextTick then
				nextTick = t + Events.WEATHER_TICK
				weatherTick(Events.WEATHER[weather.id])
			end
			task.wait(1)
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">FreekTag</string>
          <string name="Source"><![CDATA[-- The floating tag over a Freek, in the chunky cartoon style: rarity on top (in its colour),
-- the name big and bold (in its mutation's colour if it has one), the price in gold for
-- Freeks that are for sale, and the money it makes in green. Everything is outlined.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Rarities = require(ReplicatedStorage.Shared.Rarities)

local FreekTag = {}

local OUTLINE = Color3.fromRGB(20, 22, 48)

local function line(parent: Instance, text: string, color: Color3, top: number, height: number, font: Enum.Font)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0, top)
	label.Size = UDim2.fromScale(1, height)
	label.TextScaled = true
	label.Font = font
	label.Text = text
	label.TextColor3 = color
	label.Parent = parent
	local stroke = Instance.new("UIStroke")
	stroke.Color = OUTLINE
	stroke.Thickness = 2.5
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	return label
end

-- Adds the tag to anchor, `above` studs over it. price is shown when the Freek is for sale.
function FreekTag.add(anchor: BasePart, freek, above: number, maxDistance: number, price: number?): BillboardGui
	local species = FreekUtil.species(freek)
	local rarity = species and species.rarity or "Common"
	local top = Mutations.top(freek.mutations)
	local lines = if price then 4 else 3
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, lines * 21)
	gui.StudsOffsetWorldSpace = Vector3.new(0, above, 0)
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	local h = 1 / lines
	line(gui, string.upper(rarity), Rarities.info[rarity].color, 0, h * 0.85, Enum.Font.LuckiestGuy)
	line(
		gui,
		FreekUtil.displayName(freek),
		if top then Mutations.byId[top].color else Color3.new(1, 1, 1),
		h * 0.85,
		h * 1.3,
		Enum.Font.FredokaOne
	)
	if price then
		line(gui, Format.money(price), Color3.fromRGB(255, 215, 60), h * 2.15, h * 0.95, Enum.Font.LuckiestGuy)
	end
	line(
		gui,
		Format.money(FreekUtil.income(freek)) .. "/s",
		Color3.fromRGB(110, 240, 120),
		if price then h * 3.1 else h * 2.15,
		h * 0.9,
		Enum.Font.LuckiestGuy
	)
	gui.Parent = anchor
	return gui
end

return FreekTag
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">HalloweenDecor</string>
          <string name="Source"><![CDATA[-- Halloween props: ghosts, bats, cobwebs, tombstones, dead trees, a witch's cauldron,
-- witch hats, string lights and creeping fog.
--
-- Ghosts and bats are tagged; each client flies them around (see client/Ambient) using
-- the attributes set here, so they move smoothly without network traffic.

local CollectionService = game:GetService("CollectionService")

local Decor = require(script.Parent.Decor)

local part = Decor.part

local HalloweenDecor = {}

HalloweenDecor.GHOST_TAG = "SpookyGhost"
HalloweenDecor.BAT_TAG = "SpookyBat"

-- Shared flight settings read by the client: circle `center` at `radius`, `height` up.
local function flightPath(model: Model, center: Vector3, radius: number, height: number, speed: number, phase: number)
	model:SetAttribute("Center", center)
	model:SetAttribute("Radius", radius)
	model:SetAttribute("Height", height)
	model:SetAttribute("Speed", speed)
	model:SetAttribute("Phase", phase)
end

function HalloweenDecor.ghost(
	parent: Instance,
	center: Vector3,
	radius: number,
	height: number,
	speed: number,
	phase: number
)
	local model = Instance.new("Model")
	model.Name = "Ghost"
	local white = Color3.fromRGB(240, 245, 255)
	local origin = CFrame.new(center + Vector3.new(radius, height, 0))
	local head = part({
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 3.2,
		CFrame = origin,
		Color = white,
		Transparency = 0.15,
		CanCollide = false,
		CastShadow = false,
		Parent = model,
	})
	part({
		Name = "Body",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.6, 3.1, 3.1),
		CFrame = origin * CFrame.new(0, -1.3, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = white,
		Transparency = 0.15,
		CanCollide = false,
		CastShadow = false,
		Parent = model,
	})
	-- Wavy hem.
	for i = 0, 5 do
		local angle = i / 6 * math.pi * 2
		part({
			Name = "Hem",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 1.2,
			CFrame = origin * CFrame.new(math.cos(angle) * 1.2, -2.7, math.sin(angle) * 1.2),
			Color = white,
			Transparency = 0.15,
			CanCollide = false,
			CastShadow = false,
			Parent = model,
		})
	end
	for _, x in { -1.6, 1.6 } do
		part({
			Name = "Arm",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1, 1, 1),
			CFrame = origin * CFrame.new(x, -0.9, -0.3),
			Color = white,
			Transparency = 0.15,
			CanCollide = false,
			CastShadow = false,
			Parent = model,
		})
	end
	for _, x in { -0.55, 0.55 } do
		part({
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.6,
			CFrame = origin * CFrame.new(x, 0.3, -1.4),
			Color = Color3.fromRGB(20, 20, 30),
			CanCollide = false,
			Parent = model,
		})
	end
	part({
		Name = "Mouth",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.7, 0.7, 0.7),
		CFrame = origin * CFrame.new(0, -0.5, -1.4),
		Color = Color3.fromRGB(20, 20, 30),
		CanCollide = false,
		Parent = model,
	})
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(190, 220, 255)
	glow.Range = 12
	glow.Brightness = 0.8
	glow.Parent = head
	model.PrimaryPart = head
	flightPath(model, center, radius, height, speed, phase)
	model.Parent = parent
	CollectionService:AddTag(model, HalloweenDecor.GHOST_TAG)
	return model
end

function HalloweenDecor.bat(
	parent: Instance,
	center: Vector3,
	radius: number,
	height: number,
	speed: number,
	phase: number
)
	local model = Instance.new("Model")
	model.Name = "Bat"
	local black = Color3.fromRGB(28, 22, 36)
	local origin = CFrame.new(center + Vector3.new(radius, height, 0))
	local body = part({
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.1, 1.1, 1.1),
		CFrame = origin,
		Color = black,
		CanCollide = false,
		Parent = model,
	})
	part({
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.75,
		CFrame = origin * CFrame.new(0, 0.35, -0.55),
		Color = black,
		CanCollide = false,
		Parent = model,
	})
	for _, x in { -0.18, 0.18 } do
		part({
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.16,
			CFrame = origin * CFrame.new(x, 0.42, -0.88),
			Color = Color3.fromRGB(255, 60, 40),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = model,
		})
	end
	for _, side in { -1, 1 } do
		part({
			Name = if side < 0 then "WingL" else "WingR",
			Size = Vector3.new(2.2, 0.1, 1.3),
			CFrame = origin * CFrame.new(side * 1.5, 0, 0),
			Color = Color3.fromRGB(45, 30, 55),
			CanCollide = false,
			Parent = model,
		})
	end
	model.PrimaryPart = body
	flightPath(model, center, radius, height, speed, phase)
	model.Parent = parent
	CollectionService:AddTag(model, HalloweenDecor.BAT_TAG)
	return model
end

-- A cobweb in a corner. `corner` sits in the corner with -X/-Y pointing into the opening,
-- so place it rotated to suit each corner.
function HalloweenDecor.cobweb(parent: Instance, corner: CFrame, size: number)
	local white = Color3.fromRGB(235, 235, 240)
	local strand = function(a: Vector3, b: Vector3)
		local length = (b - a).Magnitude
		part({
			Name = "Web",
			Size = Vector3.new(0.07, 0.07, length),
			CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -length / 2),
			Color = white,
			Transparency = 0.3,
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
	end
	local spokes = {}
	for i = 0, 4 do
		local angle = math.rad(180 + i * 22.5)
		local tip = corner * CFrame.new(math.cos(angle) * size * -1, math.sin(angle) * size, 0)
		spokes[i] = tip.Position
		strand(corner.Position, tip.Position)
	end
	for _, ring in { 0.35, 0.65, 0.95 } do
		for i = 0, 3 do
			local a = corner.Position:Lerp(spokes[i], ring)
			local b = corner.Position:Lerp(spokes[i + 1], ring)
			strand(a, b)
		end
	end
end

function HalloweenDecor.tombstone(parent: Instance, ground: CFrame, seed: number)
	local rng = Random.new(seed)
	local stone = Color3.fromRGB(130, 130, 140):Lerp(Color3.fromRGB(95, 100, 105), rng:NextNumber())
	local lean = ground * CFrame.Angles(math.rad(rng:NextNumber(-8, 8)), 0, math.rad(rng:NextNumber(-10, 10)))
	local slab = part({
		Name = "Tombstone",
		Size = Vector3.new(3, 3.4, 0.8),
		CFrame = lean * CFrame.new(0, 1.7, 0),
		Color = stone,
		Material = Enum.Material.Slate,
		Parent = parent,
	})
	part({
		Name = "TombstoneTop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 3, 3),
		CFrame = lean * CFrame.new(0, 3.4, 0) * CFrame.Angles(0, math.pi / 2, 0),
		Color = stone,
		Material = Enum.Material.Slate,
		Parent = parent,
	})
	part({
		Name = "Dirt",
		Size = Vector3.new(2.6, 0.4, 4),
		CFrame = ground * CFrame.new(0, 0.2, -2.6),
		Color = Color3.fromRGB(85, 60, 45),
		Material = Enum.Material.Ground,
		CanCollide = false,
		Parent = parent,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 0.6)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.Fondamento
	label.Text = "R.I.P."
	label.TextColor3 = Color3.fromRGB(60, 60, 70)
	label.Parent = gui
	gui.Parent = slab
end

-- A bare, twisted tree.
function HalloweenDecor.deadTree(parent: Instance, ground: CFrame, scale: number, seed: number)
	local rng = Random.new(seed)
	local bark = Color3.fromRGB(60, 45, 40)
	local function branch(from: CFrame, length: number, thickness: number, depth: number)
		local tip = from * CFrame.new(0, length, 0)
		part({
			Name = "Branch",
			Size = Vector3.new(thickness, length, thickness),
			CFrame = from * CFrame.new(0, length / 2, 0),
			Color = bark,
			Material = Enum.Material.Wood,
			Parent = parent,
		})
		if depth > 0 then
			for _ = 1, 2 do
				local turn = CFrame.Angles(math.rad(rng:NextNumber(-55, 55)), math.rad(rng:NextNumber(0, 360)), 0)
				branch(tip * turn, length * 0.65, thickness * 0.6, depth - 1)
			end
		end
	end
	branch(ground, 7 * scale, 1.3 * scale, 3)
end

function HalloweenDecor.cauldron(parent: Instance, ground: CFrame)
	local iron = Color3.fromRGB(35, 35, 40)
	part({
		Name = "Cauldron",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 6,
		CFrame = ground * CFrame.new(0, 3, 0),
		Color = iron,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Name = "Rim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 5.4, 5.4),
		CFrame = ground * CFrame.new(0, 5.5, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = iron,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	local brew = part({
		Name = "Brew",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 4.8, 4.8),
		CFrame = ground * CFrame.new(0, 5.65, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(110, 255, 90),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	for i = 0, 2 do
		local angle = i / 3 * math.pi * 2
		part({
			Name = "Leg",
			Size = Vector3.new(0.6, 1.6, 0.6),
			CFrame = ground * CFrame.new(math.cos(angle) * 2, 0.8, math.sin(angle) * 2),
			Color = iron,
			Material = Enum.Material.Metal,
			Parent = parent,
		})
	end
	-- Firewood and flames underneath.
	for i = 0, 3 do
		part({
			Name = "Log",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(4, 0.7, 0.7),
			CFrame = ground * CFrame.new(0, 0.35, 0) * CFrame.Angles(0, i * math.pi / 4, 0),
			Color = Color3.fromRGB(100, 65, 40),
			Material = Enum.Material.Wood,
			Parent = parent,
		})
	end
	local embers = part({
		Name = "Embers",
		Size = Vector3.new(1, 1, 1),
		CFrame = ground * CFrame.new(0, 0.7, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = parent,
	})
	local fire = Instance.new("Fire")
	fire.Size = 4
	fire.Heat = 4
	fire.Parent = embers

	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(120, 255, 110)
	smoke.Opacity = 0.18
	smoke.RiseVelocity = 3
	smoke.Size = 2.5
	smoke.Parent = brew
	local bubbles = Instance.new("Sparkles")
	bubbles.SparkleColor = Color3.fromRGB(150, 255, 120)
	bubbles.Parent = brew
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(110, 255, 90)
	light.Range = 22
	light.Brightness = 2
	light.Parent = brew
end

-- A pointy witch hat; ground is the bottom of the brim.
function HalloweenDecor.witchHat(parent: Instance, ground: CFrame, scale: number, color: Color3)
	local s = scale
	part({
		Name = "Brim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.35 * s, 7 * s, 7 * s),
		CFrame = ground * CFrame.new(0, 0.18 * s, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Parent = parent,
	})
	part({
		Name = "Band",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6 * s, 4.7 * s, 4.7 * s),
		CFrame = ground * CFrame.new(0, 0.6 * s, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(255, 150, 40),
		Parent = parent,
	})
	-- Stacked, shrinking, slightly bent tiers make the cone.
	local tier = ground * CFrame.new(0, 0.9 * s, 0)
	for i, d in { 4.5, 3.6, 2.7, 1.8, 1 } do
		local h = 1.3 * s
		part({
			Name = "Cone",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(h, d * s, d * s),
			CFrame = tier * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
			Color = color,
			Parent = parent,
		})
		tier = tier * CFrame.new(0, h * 0.9, 0) * CFrame.Angles(0, 0, math.rad(if i >= 3 then 9 else 2))
	end
end

-- A strand of glowing bulbs from a to b, sagging in the middle.
function HalloweenDecor.stringLights(parent: Instance, a: Vector3, b: Vector3, count: number, sag: number)
	local colors = { Color3.fromRGB(255, 140, 30), Color3.fromRGB(170, 80, 255) }
	local previous = a
	for i = 0, count do
		local t = i / count
		local point = a:Lerp(b, t) - Vector3.new(0, math.sin(t * math.pi) * sag, 0)
		if i > 0 then
			local length = (point - previous).Magnitude
			part({
				Name = "Wire",
				Size = Vector3.new(0.06, 0.06, length),
				CFrame = CFrame.lookAt(previous, point) * CFrame.new(0, 0, -length / 2),
				Color = Color3.fromRGB(20, 20, 20),
				CanCollide = false,
				CastShadow = false,
				Parent = parent,
			})
		end
		if i > 0 and i < count then
			part({
				Name = "Bulb",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 0.45,
				CFrame = CFrame.new(point - Vector3.new(0, 0.25, 0)),
				Color = colors[i % 2 + 1],
				Material = Enum.Material.Neon,
				CanCollide = false,
				CastShadow = false,
				Parent = parent,
			})
		end
		previous = point
	end
end

-- Low, slow-drifting ground fog.
function HalloweenDecor.fog(parent: Instance, position: Vector3)
	local holder = part({
		Name = "Fog",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(position),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = parent,
	})
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(185, 175, 210)
	smoke.Opacity = 0.07
	smoke.RiseVelocity = 0.2
	smoke.Size = 12
	smoke.Parent = holder
end

return HalloweenDecor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">LuckService</string>
          <string name="Source"><![CDATA[-- Monster Crates, the daily Lucky Wheel and Lucky Hour events (rules and odds in
-- shared/Luck.luau). All rolls happen here; the client only shows the result (the
-- LuckResult remote) with a reveal animation.
--
-- Monster Crates are Developer Products. ProcessReceipt grants a crate only once per
-- purchase (receipts are remembered in the player's save) and only tells Roblox the
-- purchase went through after the save succeeds, so nobody pays without getting it.

local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local EggModel = require(ReplicatedStorage.Shared.EggModel)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Freeks = require(ReplicatedStorage.Shared.Freeks)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Luck = require(ReplicatedStorage.Shared.Luck)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Seasons = require(ReplicatedStorage.Shared.Seasons)

local ActionService = require(script.Parent.ActionService)
local DataService = require(script.Parent.DataService)

local LuckService = {}

local rng = Random.new()
local notifyRemote = Remotes.get("Notify")
local resultRemote = Remotes.get("LuckResult")
local RECEIPTS_KEPT = 50 -- how many recent purchase IDs each save remembers

-- Odds for the wheel's Golden/Rainbow Freek (by rarity, never Monsters).
local WHEEL_FREEK_ODDS = { Common = 35, Uncommon = 45, Rare = 17, Legendary = 3 }

local function notify(player: Player, message: string, kind: string?)
	notifyRemote:FireClient(player, message, kind)
end

local function announce(message: string)
	for _, player in Players:GetPlayers() do
		notify(player, message, "discovery")
	end
end

-- Picks a key from a { [key] = weight } table.
local function rollWeighted(weights: { [string]: number }): string
	local keys = {}
	local total = 0
	for key, weight in weights do
		table.insert(keys, key)
		total += weight
	end
	table.sort(keys)
	local roll = rng:NextNumber() * total
	for _, key in keys do
		roll -= weights[key]
		if roll <= 0 then
			return key
		end
	end
	return keys[#keys]
end

-- A random non-Monster species of that rarity (or the next rarity down that has any).
local function pickSpecies(rarity: string)
	local rank = Rarities.rank[rarity]
	while rank >= 1 do
		local pool = {}
		for _, species in Freeks.list do
			if
				species.rarity == Rarities.order[rank]
				and not species.exclusive
				and not species.event
				and species.rarity ~= "Secret"
				and Seasons.available(species)
			then
				table.insert(pool, species)
			end
		end
		if #pool > 0 then
			return pool[rng:NextInteger(1, #pool)]
		end
		rank -= 1
	end
	return Freeks.list[1]
end

local function rollMutations(boost: number): { string }?
	for _, mutation in Mutations.list do
		if rng:NextNumber() < mutation.chance * boost then
			return { mutation.id }
		end
	end
	return nil
end

local function hasRoom(player: Player, data): boolean
	return FreekUtil.count(data) < GamePasses.maxFreeks(player)
end

-- Gives the player a Freek and tells their client to show the reveal.
local function giveFreek(player: Player, data, species, mutations, reveal)
	local _, isNew = ActionService.giveFreek(player, data, species.id, mutations)
	local freek = { species = species.id, mutations = mutations }
	reveal.freek = freek
	reveal.isNew = isNew
	reveal.rarity = species.rarity
	resultRemote:FireClient(player, reveal)
	if Rarities.rank[species.rarity] >= Rarities.rank.Legendary then
		announce(player.DisplayName .. " got a " .. species.rarity .. " " .. FreekUtil.displayName(freek) .. "!")
	end
end

local function openCrate(player: Player, data, crate)
	local species = Freeks.byId[rollWeighted(Luck.crateOdds(crate))]
	giveFreek(player, data, species, rollMutations(crate.mutation), { kind = "crate", crate = crate.id })
end

-- Whether paid random items are allowed for this player (some countries ban them).
local function cratesAllowed(player: Player): boolean
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	if not ok then
		return RunService:IsStudio() -- can't check: only allow while testing in Studio
	end
	return not info.ArePaidRandomItemsRestricted
end

-- The player asked to buy a crate: check, then show Roblox's purchase prompt.
local function buyCrate(player: Player, data, crateId: any)
	local crate = typeof(crateId) == "string" and Luck.crateById[crateId]
	if not crate then
		return
	end
	if player:GetAttribute("CratesRestricted") then
		return notify(player, "Monster Eggs aren't available where you live.", "error")
	end
	if not hasRoom(player, data) then
		return notify(player, "You have too many Freeks! Sell or fuse some first.", "error")
	end
	if crate.productId == 0 then
		if RunService:IsStudio() and Luck.STUDIO_FREE_CRATES then
			notify(player, "Studio test: hatching a " .. crate.name .. " for free.", "success")
			return openCrate(player, data, crate)
		end
		return notify(player, "Monster Eggs are coming soon!", "error")
	end
	MarketplaceService:PromptProductPurchase(player, crate.productId)
end

-- Opens a crate the player already owns (won on the wheel, or bought while full).
local function openOwnedCrate(player: Player, data, crateId: any)
	local crate = typeof(crateId) == "string" and Luck.crateById[crateId]
	if not crate or (data.crates[crate.id] or 0) < 1 then
		return
	end
	if not hasRoom(player, data) then
		return notify(player, "You have too many Freeks! Sell or fuse some first.", "error")
	end
	data.crates[crate.id] -= 1
	openCrate(player, data, crate)
end

-- Shows the Starter Pack countdown on the player (StarterEnds; nil once bought).
local function markStarter(player: Player, data)
	local ends = (data.firstJoin or os.time()) + Luck.STARTER.hours * 3600
	local offerOpen = not data.starterBought and os.time() < ends
	-- Server time, so the client's countdown lines up with GetServerTimeNow.
	local offset = Workspace:GetServerTimeNow() - os.time()
	player:SetAttribute("StarterEnds", if offerOpen then ends + offset else nil)
end

local function buyStarter(player: Player, data)
	if player:GetAttribute("CratesRestricted") then
		return notify(player, "The Starter Pack isn't available where you live.", "error")
	end
	if data.starterBought or not player:GetAttribute("StarterEnds") then
		return notify(player, "The Starter Pack offer is over.", "error")
	end
	if Luck.STARTER.passId == 0 then
		return notify(player, "The Starter Pack is coming soon!", "error")
	end
	MarketplaceService:PromptGamePassPurchase(player, Luck.STARTER.passId)
end

local function buyBundle(player: Player, _data, bundleId: any)
	local bundle = typeof(bundleId) == "string" and Luck.bundleById[bundleId]
	if not bundle then
		return
	end
	if player:GetAttribute("CratesRestricted") then
		return notify(player, "Monster Eggs aren't available where you live.", "error")
	end
	if bundle.productId == 0 then
		return notify(player, "This bundle is coming soon!", "error")
	end
	MarketplaceService:PromptProductPurchase(player, bundle.productId)
end

-- Gives the Starter Pack's contents, once ever (the eggs wait in the Luck tab).
local function grantStarter(player: Player, data)
	if data.starterBought then
		return
	end
	local starter = Luck.STARTER
	data.money += starter.coins
	for crateId, count in starter.crates do
		data.crates[crateId] = (data.crates[crateId] or 0) + count
	end
	data.starterBought = true
	markStarter(player, data)
	notify(player, "🎁 Starter Pack unlocked! Your eggs are waiting in the 🍀 Luck tab.", "discovery")
	DataService.changed(player)
	task.spawn(DataService.save, player)
end

-- Owns the Starter Pack pass (bought here or on the website) but hasn't had it yet: give it.
local function checkStarterPass(player: Player, data)
	if data.starterBought or Luck.STARTER.passId == 0 then
		return
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Luck.STARTER.passId)
	end)
	if ok and owns then
		grantStarter(player, data)
	end
end

-- Gives what a bundle contains (eggs are saved to hatch from Luck).
local function grantPack(player: Player, data, productId: number): boolean
	local bundle = Luck.bundleByProduct[productId]
	if bundle then
		data.crates[bundle.crate] = (data.crates[bundle.crate] or 0) + bundle.count
		notify(player, "🥚 " .. bundle.name .. " added! Hatch them from the 🍀 Luck tab.", "discovery")
		return true
	end
	return false
end

local function isOurs(productId: number): boolean
	return Luck.crateByProduct[productId] ~= nil or Luck.bundleByProduct[productId] ~= nil
end

local function processReceipt(receipt)
	local crate = Luck.crateByProduct[receipt.ProductId]
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and DataService.get(player)
	if not isOurs(receipt.ProductId) or not data then
		-- Not ours, or the player isn't here: Roblox will try again later.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	data.receipts = data.receipts or {}
	if not table.find(data.receipts, receipt.PurchaseId) then
		if not crate then
			grantPack(player, data, receipt.ProductId)
		elseif hasRoom(player, data) then
			openCrate(player, data, crate)
		else
			data.crates[crate.id] = (data.crates[crate.id] or 0) + 1
			notify(
				player,
				"Your barn is full, so your " .. crate.name .. " was saved. Hatch it from the 🍀 Luck tab!",
				"success"
			)
		end
		table.insert(data.receipts, receipt.PurchaseId)
		while #data.receipts > RECEIPTS_KEPT do
			table.remove(data.receipts, 1)
		end
		DataService.changed(player)
	end
	if not DataService.save(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function spinCooldown(player: Player): number
	return if GamePasses.has(player, "VIP") then Luck.VIP_SPIN_COOLDOWN else Luck.SPIN_COOLDOWN
end

local function coinPrize(data, minutes: number): number
	return math.max(Luck.MIN_COIN_PRIZE, math.floor(FreekUtil.yardIncome(data) * 60 * minutes))
end

local function spin(player: Player, data)
	local now = os.time()
	if now - (data.lastSpin or 0) < spinCooldown(player) then
		return notify(player, "Your next free spin isn't ready yet!", "error")
	end
	data.lastSpin = now

	local weights = {}
	for i, slice in Luck.WHEEL do
		weights[tostring(i)] = slice.weight
	end
	local index = tonumber(rollWeighted(weights)) :: number
	local slice = Luck.WHEEL[index]
	local reveal = { kind = "wheel", slice = index }

	if (slice.golden or slice.rainbow) and hasRoom(player, data) then
		local species = pickSpecies(rollWeighted(WHEEL_FREEK_ODDS))
		return giveFreek(player, data, species, { if slice.rainbow then "Rainbow" else "Golden" }, reveal)
	end
	if slice.crate then
		data.crates[slice.crate] = (data.crates[slice.crate] or 0) + 1
		reveal.crate = slice.crate
		if slice.crate == "LegendaryMonster" then
			announce(player.DisplayName .. " hit the JACKPOT on the Lucky Wheel!")
		end
	else
		-- Coins (also the fallback for a Freek prize when the barn is full).
		local amount = coinPrize(data, slice.minutes or 10)
		data.money += amount
		reveal.coins = amount
	end
	resultRemote:FireClient(player, reveal)
end

-- Runs Lucky Hour events forever: a random one every so often, announced to everyone.
local function runEvents()
	task.wait(Luck.FIRST_EVENT_AFTER)
	local ids = {}
	for id in Luck.EVENTS do
		table.insert(ids, id)
	end
	table.sort(ids)
	while true do
		local id = ids[rng:NextInteger(1, #ids)]
		local event = Luck.EVENTS[id]
		ReplicatedStorage:SetAttribute("LuckyEvent", id)
		ReplicatedStorage:SetAttribute("LuckyEventEnds", Workspace:GetServerTimeNow() + Luck.EVENT_DURATION)
		announce(event.icon .. " " .. event.name .. "! " .. event.description)
		task.wait(Luck.EVENT_DURATION)
		ReplicatedStorage:SetAttribute("LuckyEvent", nil)
		announce(event.name .. " is over. Another one will come soon!")
		task.wait(rng:NextInteger(Luck.EVENT_GAP[1], Luck.EVENT_GAP[2]))
	end
end

-- Marks players who can't buy crates so their client hides the buy buttons.
local function checkPolicy(player: Player)
	player:SetAttribute("CratesRestricted", not cratesAllowed(player))
end

-- The Egg Stand by the spawn: the three Monster Eggs on glowing pedestals, each with its
-- odds floating above it (like the egg stands in pet games). Hold E to hatch one.
local STAND_X = 128
local OUTLINE = Color3.fromRGB(20, 22, 48)

local function outlinedLabel(parent: Instance, text: string, color: Color3, top: number, height: number, font)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0, top)
	label.Size = UDim2.fromScale(1, height)
	label.TextScaled = true
	label.Font = font
	label.Text = text
	label.TextColor3 = color
	label.Parent = parent
	local stroke = Instance.new("UIStroke")
	stroke.Color = OUTLINE
	stroke.Thickness = 2.5
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	return label
end

local function buildEggStand()
	local folder = Instance.new("Folder")
	folder.Name = "EggStand"
	folder.Parent = Workspace
	for i, crate in Luck.CRATES do
		local z = (i - 2) * 13
		local base = CFrame.lookAt(Vector3.new(STAND_X, 0, z), Vector3.new(STAND_X + 10, 0, z)) -- faces the spawn
		local pedestal = Instance.new("Part")
		pedestal.Name = "EggPedestal"
		pedestal.Anchored = true
		pedestal.Shape = Enum.PartType.Cylinder
		pedestal.Size = Vector3.new(1.2, 7, 7)
		pedestal.CFrame = base * CFrame.new(0, 0.6, 0) * CFrame.Angles(0, 0, math.rad(90))
		pedestal.Color = Color3.fromRGB(45, 35, 65)
		pedestal.Material = Enum.Material.Slate
		pedestal.Parent = folder
		local rim = pedestal:Clone()
		rim.Name = "EggRim"
		rim.Size = Vector3.new(0.3, 7.6, 7.6)
		rim.CFrame = base * CFrame.new(0, 0.85, 0) * CFrame.Angles(0, 0, math.rad(90))
		rim.Color = crate.color
		rim.Material = Enum.Material.Neon
		rim.Parent = folder

		local egg, height = EggModel.build(crate.id)
		local rest = base * CFrame.new(0, 1.2, 0)
		egg:PivotTo(rest)
		egg:SetAttribute("Rest", rest) -- clients spin and bob it around here
		CollectionService:AddTag(egg, "DisplayEgg")
		egg.Parent = folder

		-- The odds float above the egg.
		local odds = Luck.oddsList(crate)
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(230, 46 + #odds * 20)
		gui.StudsOffsetWorldSpace = Vector3.new(0, height + 3.2, 0)
		gui.MaxDistance = 80
		gui.LightInfluence = 0
		local total = 46 + #odds * 20
		outlinedLabel(gui, string.upper(crate.name), crate.color, 0, 26 / total, Enum.Font.LuckiestGuy)
		outlinedLabel(
			gui,
			"R$ " .. crate.robux,
			Color3.fromRGB(110, 240, 120),
			26 / total,
			20 / total,
			Enum.Font.LuckiestGuy
		)
		for k, entry in odds do
			local species = Freeks.byId[entry.species]
			local percent = if entry.percent < 1
				then string.format("%.1f", entry.percent)
				else string.format("%.0f", entry.percent)
			outlinedLabel(
				gui,
				species.name .. "  " .. percent .. "%",
				Rarities.info[species.rarity].color,
				(46 + (k - 1) * 20) / total,
				19 / total,
				Enum.Font.FredokaOne
			)
		end
		gui.Parent = egg.PrimaryPart

		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "EggPrompt"
		prompt.ActionText = "Hatch (R$ " .. crate.robux .. ")"
		prompt.ObjectText = crate.name
		prompt.HoldDuration = 0.3
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("EggId", crate.id)
		prompt.Parent = egg.PrimaryPart
	end

	-- A big sign over the stand.
	local signPart = Instance.new("Part")
	signPart.Name = "EggSign"
	signPart.Anchored = true
	signPart.Transparency = 1
	signPart.CanCollide = false
	signPart.Size = Vector3.one
	signPart.CFrame = CFrame.new(STAND_X, 17, 0)
	signPart.Parent = folder
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(26, 5)
	gui.MaxDistance = 300
	gui.LightInfluence = 0
	local label =
		outlinedLabel(gui, "🥚 MONSTER EGGS 🥚", Color3.fromRGB(255, 160, 40), 0, 1, Enum.Font.LuckiestGuy)
	label:FindFirstChildOfClass("UIStroke").Thickness = 4
	gui.Parent = signPart
end

function LuckService.init()
	buildEggStand()
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		local eggId = prompt.Name == "EggPrompt" and prompt:GetAttribute("EggId")
		local data = DataService.get(player)
		if eggId and data then
			buyCrate(player, data, eggId)
			DataService.changed(player)
		end
	end)
	ActionService.register("BuyCrate", buyCrate)
	ActionService.register("OpenCrate", openOwnedCrate)
	ActionService.register("SpinWheel", spin)
	ActionService.register("BuyStarter", buyStarter)
	ActionService.register("BuyBundle", buyBundle)
	DataService.onLoaded(function(player, data)
		markStarter(player, data)
		checkStarterPass(player, data)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local data = DataService.get(player)
		if purchased and data and passId == Luck.STARTER.passId then
			grantStarter(player, data)
		end
	end)
	-- The offer ends while they're playing: take the countdown down.
	task.spawn(function()
		while true do
			task.wait(30)
			for _, player in Players:GetPlayers() do
				local data = DataService.get(player)
				if data and player:GetAttribute("StarterEnds") then
					markStarter(player, data)
				end
			end
		end
	end)
	MarketplaceService.ProcessReceipt = processReceipt
	LuckService.processReceipt = processReceipt -- also called directly by tests
	Players.PlayerAdded:Connect(checkPolicy)
	for _, player in Players:GetPlayers() do
		task.spawn(checkPolicy, player)
	end
	task.spawn(runEvents)
end

return LuckService
]]></string>
        </Properties>
