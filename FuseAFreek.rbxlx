					color = dark,
					swing = { hinge = { side * 1.45, 2.85, 0.15 }, axis = "Z", amount = side * 1.4 },
				})
				for _, toe in { -0.22, 0, 0.22 } do
					add({
						shape = "Ball",
						size = 0.3,
						pos = { side * 0.55 + toe, 0.15, -0.75 },
						color = rgb(255, 165, 30),
					})
				end
			end
			add({
				shape = "Block",
				size = { 0.32, 0.32, 0.32 },
				pos = onBall(body, 1.6, 0, 0.3, 0.12),
				rot = { 0, 0, 45 },
				color = rgb(255, 165, 30),
				detail = true,
			})
			-- Little feather marks on the cream belly.
			for row, y in { 1.3, 1.75, 2.2 } do
				for k = -1, 1 do
					local x = k * 0.5 + (if row % 2 == 0 then 0.25 else 0)
					if math.abs(x) < 0.8 then
						add({
							shape = "Ellipsoid",
							size = { 0.32, 0.14, 0.08 },
							pos = onBall({ 0, 1.75, -0.6 }, 1.15, x, y - 1.75, -0.02),
							color = rgb(200, 165, 120),
							detail = true,
						})
					end
				end
			end
			-- A monocle and a top hat: very posh.
			local eye = onBall(body, 1.6, 0.55, 0.75, 0.55)
			add({
				shape = "Cylinder",
				size = { 0.08, 1.05, 1.05 },
				pos = eye,
				rot = { 0, 90, 0 },
				color = rgb(255, 205, 60),
				material = "Foil",
				detail = true,
			})
			add({
				shape = "Block",
				size = { 0.05, 1.1, 0.05 },
				pos = { eye[1] + 0.35, eye[2] - 0.75, eye[3] + 0.1 },
				rot = { 0, 0, 20 },
				color = rgb(255, 205, 60),
				detail = true,
			})
			add({
				shape = "Cylinder",
				size = { 0.12, 2.2, 2.2 },
				pos = { 0, 3.6, 0 },
				rot = { 0, 0, 90 },
				color = rgb(25, 25, 30),
			})
			add({
				shape = "Cylinder",
				size = { 1.3, 1.4, 1.4 },
				pos = { 0, 4.3, 0 },
				rot = { 0, 0, 90 },
				color = rgb(25, 25, 30),
			})
			add({
				shape = "Cylinder",
				size = { 0.25, 1.45, 1.45 },
				pos = { 0, 3.85, 0 },
				rot = { 0, 0, 90 },
				color = rgb(200, 30, 40),
			})
			return { parts = list }
		end)(),
	},
