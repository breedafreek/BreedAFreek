  <Item class="ServerScriptService" referent="19">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="20">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">ActionService</string>
          <string name="Source"><![CDATA[-- Everything a player can ask the server to do. Every argument from the client is
-- untrusted, so each handler re-checks ownership, money and limits itself.

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Carried = require(script.Parent.Carried)
local DataService = require(script.Parent.DataService)
local DiscoveryService = require(script.Parent.DiscoveryService)
local Recipes = require(script.Parent.Recipes)

local ActionService = {}

local notifyRemote = Remotes.get("Notify")
local stateRemote = Remotes.get("State")
local rng = Random.new()
local lastAction = {} -- [Player] = os.clock()

local function notify(player: Player, message: string, kind: string?)
	notifyRemote:FireClient(player, message, kind)
end

-- What the client is allowed to see of its own save.
local function snapshot(data)
	return {
		rebirths = data.rebirths,
		money = data.money,
		slots = FreekUtil.totalSlots(data),
		boughtSlots = data.slots,
		passSlots = data.passSlots or 0,
		freeks = data.freeks,
		breeding = data.breeding,
		breeding2 = data.breeding2,
		discovered = data.discovered,
	}
end

-- Adds a Freek, puts it in the yard if there's room, and records the discovery.
local function giveFreek(player: Player, data, species: string, mutations: { string }?)
	local uid = HttpService:GenerateGUID(false)
	data.freeks[uid] = { species = species, mutations = Mutations.pack(mutations), slot = FreekUtil.freeSlot(data) }
	local isNew = not data.discovered[species]
	data.discovered[species] = true
	task.spawn(DiscoveryService.claim, player, species)
	return uid, isNew
end

ActionService.giveFreek = giveFreek

local function ownedFreek(data, uid: any)
	if typeof(uid) ~= "string" then
		return nil
	end
	return data.freeks[uid]
end

local handlers = {}

function handlers.BuySlot(player: Player, data)
	if data.slots >= Config.MAX_SLOTS then
		return notify(player, "Your yard is as big as it gets!", "error")
	end
	local price = Config.slotPrice(data.slots)
	if data.money < price then
		return notify(player, "Not enough money! A new slot costs " .. Format.money(price), "error")
	end
	data.money -= price
	data.slots += 1
	notify(player, "Your yard grew! You now have " .. data.slots .. " slots.", "success")
end

function handlers.Place(player: Player, data, uid: any)
	local freek = ownedFreek(data, uid)
	if not freek or freek.breeding or freek.slot or Carried.is(player, uid) then
		return
	end
	local slot = FreekUtil.freeSlot(data)
	if not slot then
		return notify(player, "Your yard is full! Buy more slots or remove a Freek.", "error")
	end
	freek.slot = slot
end

function handlers.Unplace(_player: Player, data, uid: any)
	local freek = ownedFreek(data, uid)
	if freek then
		freek.slot = nil
	end
end

function handlers.Sell(player: Player, data, uid: any)
	local freek = ownedFreek(data, uid)
	if not freek or freek.breeding then
		return
	end
	if Carried.is(player, uid) then
		return notify(player, "Someone is stealing that Freek! Catch them!", "error")
	end
	local value = FreekUtil.sellValue(freek)
	data.freeks[uid] = nil
	data.money += value
	notify(player, "Sold " .. FreekUtil.displayName(freek) .. " for " .. Format.money(value), "money")
end

-- penIndex is optional: with no pen given, the first free pen is used.
function handlers.StartBreed(player: Player, data, uidA: any, uidB: any, penIndex: any)
	local pens = GamePasses.penCount(player)
	local index = nil
	if typeof(penIndex) == "number" and penIndex >= 1 and penIndex <= pens and not FreekUtil.pen(data, penIndex) then
		index = penIndex
	else
		for i = 1, pens do
			if not FreekUtil.pen(data, i) then
				index = i
				break
			end
		end
	end
	if not index then
		return notify(
			player,
			if pens > 1 then "Both your Fusion Pods are busy!" else "Your Fusion Pod is already busy!",
			"error"
		)
	end
	local a, b = ownedFreek(data, uidA), ownedFreek(data, uidB)
	if not a or not b or uidA == uidB or a.breeding or b.breeding then
		return
	end
	if Carried.is(player, uidA) or Carried.is(player, uidB) then
		return notify(player, "Someone is stealing that Freek! Catch them!", "error")
	end
	if FreekUtil.count(data) >= GamePasses.maxFreeks(player) then
		return notify(player, "No room for the new Freek! Sell one first.", "error")
	end
	a.slot, b.slot = nil, nil
	a.breeding, b.breeding = true, true
	local duration = math.ceil(FreekUtil.breedTime(a, b) * GamePasses.breedTimeMultiplier(player))
	data[FreekUtil.PEN_KEYS[index]] = { a = uidA, b = uidB, endsAt = os.time() + duration }
	notify(player, "Fusing started! Ready in " .. Format.time(duration) .. ".", "success")
end

-- penIndex is optional: with no pen given, the first ready pen is collected.
function handlers.ClaimBreed(player: Player, data, penIndex: any)
	local index = nil
	for i in FreekUtil.PEN_KEYS do
		local pen = FreekUtil.pen(data, i)
		if pen and os.time() >= pen.endsAt and (penIndex == nil or penIndex == i) then
			index = i
			break
		end
	end
	if not index then
		return
	end
	local key = FreekUtil.PEN_KEYS[index]
	local breeding = data[key]
	local a, b = data.freeks[breeding.a], data.freeks[breeding.b]
	data[key] = nil
	if not a or not b then
		return
	end
	a.breeding, b.breeding = nil, nil

	local species, mutations = Recipes.roll(a, b, rng)
	-- Parents go back into the yard first so they keep earning.
	a.slot = FreekUtil.freeSlot(data)
	b.slot = FreekUtil.freeSlot(data)
	local _, isNew = giveFreek(player, data, species, mutations)

	local name = FreekUtil.displayName({ species = species, mutations = mutations })
	if isNew then
		notify(player, "NEW FREEK! You fused a " .. name .. "!", "discovery")
	else
		notify(player, "You fused a " .. name .. "!", "success")
	end
end

local quiet = {} -- actions that don't change saved data, so skip the refresh

-- Lets other services add actions (they get the same rate limit and refresh).
-- Pass isQuiet = true for actions that never change the player's data.
function ActionService.register(name: string, handler, isQuiet: boolean?)
	handlers[name] = handler
	quiet[name] = isQuiet == true
end

function ActionService.init()
	Remotes.get("GetState").OnServerInvoke = function(player)
		local data = DataService.waitFor(player)
		return data and snapshot(data)
	end

	DataService.onChanged(function(player, data)
		stateRemote:FireClient(player, snapshot(data))
	end)

	Remotes.get("Action").OnServerEvent:Connect(function(player, action, ...)
		local handler = typeof(action) == "string" and handlers[action]
		local data = DataService.get(player)
		if not handler or not data then
			return
		end
		local now = os.clock()
		if lastAction[player] and now - lastAction[player] < 0.15 then
			return
		end
		lastAction[player] = now

		local ok, err = pcall(handler, player, data, ...)
		if not ok then
			warn("Action", action, "failed for", player.Name, err)
		end
		if not quiet[action] then
			DataService.changed(player)
		end
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
	end)
end

return ActionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Carried</string>
          <string name="Source"><![CDATA[-- Which Freeks are being carried off by a thief right now. Kept in memory only: if the
-- server stops mid-steal, the owner simply keeps the Freek.

local Carried = {}

local byOwner = {} -- [owner Player] = { [uid] = thief Player }

function Carried.is(owner: Player, uid: string): boolean
	local list = byOwner[owner]
	return list ~= nil and list[uid] ~= nil
end

function Carried.set(owner: Player, uid: string, thief: Player?)
	local list = byOwner[owner]
	if thief then
		if not list then
			list = {}
			byOwner[owner] = list
		end
		list[uid] = thief
	elseif list then
		list[uid] = nil
		if next(list) == nil then
			byOwner[owner] = nil
		end
	end
end

-- True if any of this owner's Freeks are being carried off right now.
function Carried.any(owner: Player): boolean
	return byOwner[owner] ~= nil
end

return Carried
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">ConveyorService</string>
          <string name="Source"><![CDATA[-- Runs the conveyor: two lanes down the middle of the map, each fed by its own Freek House.
-- Spawns a random Freek on each lane every few seconds (odds by rarity, see Belt.luau) and
-- sells them first come, first served.
--
-- Every species from Common to Ultra can appear (breeding never raises rarity, so the belt
-- is how players move up). Secrets never appear. Limited Freeks only during their event.
--
-- Clients animate the Freeks along the belt themselves (smooth, no network traffic); the
-- server works out where each one is from its spawn time when checking a purchase.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Belt = require(ReplicatedStorage.Shared.Belt)
local Format = require(ReplicatedStorage.Shared.Format)
local FreekModel = require(ReplicatedStorage.Shared.FreekModel)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Freeks = require(ReplicatedStorage.Shared.Freeks)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Seasons = require(ReplicatedStorage.Shared.Seasons)

local ActionService = require(script.Parent.ActionService)
local DataService = require(script.Parent.DataService)
local Decor = require(script.Parent.Decor)
local PlotService = require(script.Parent.PlotService)

local ConveyorService = {}

local notifyRemote = Remotes.get("Notify")
local rng = Random.new()
local folder: Folder
local items = {} -- [id] = { species, mutations, price, spawnTime, lane, model }
local nextId = 0

local function notify(player: Player, message: string, kind: string?)
	notifyRemote:FireClient(player, message, kind)
end

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		p[key] = value
	end
	return p
end

-- A little house with a gabled roof and a glowing doorway the lane comes out of.
local function buildHouse(model: Model, z: number, wallColor: Color3, roofColor: Color3)
	local x = Belt.START_X - 9
	part({
		Name = "FreekHouse",
		Size = Vector3.new(14, 11, 10),
		CFrame = CFrame.new(x, 5.5, z),
		Color = wallColor,
		Material = Enum.Material.SmoothPlastic,
		Parent = model,
	})
	-- Two wedges meeting at the ridge make the roof.
	for _, side in { -1, 1 } do
		local roof = Instance.new("WedgePart")
		roof.Anchored = true
		roof.Name = "Roof"
		roof.Size = Vector3.new(15, 4, 6)
		roof.CFrame = CFrame.new(x, 13, z + side * 3) * CFrame.Angles(0, if side > 0 then math.pi else 0, 0)
		roof.Color = roofColor
		roof.Material = Enum.Material.SmoothPlastic
		roof.Parent = model
	end
	part({
		Name = "Doorway",
		Size = Vector3.new(0.4, 6, 7.5),
		CFrame = CFrame.new(Belt.START_X - 1.9, 4, z),
		Color = Color3.fromRGB(255, 220, 120),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	-- Door frame around the glowing doorway, windows on the sides, and a chimney.
	for _, dz in { -4.1, 4.1 } do
		part({
			Name = "DoorFrame",
			Size = Vector3.new(0.8, 7, 0.8),
			CFrame = CFrame.new(Belt.START_X - 1.8, 4.5, z + dz),
			Color = Color3.fromRGB(255, 255, 255),
			Parent = model,
		})
	end
	part({
		Name = "DoorFrame",
		Size = Vector3.new(0.8, 0.8, 9),
		CFrame = CFrame.new(Belt.START_X - 1.8, 8.3, z),
		Color = Color3.fromRGB(255, 255, 255),
		Parent = model,
	})
	for _, wx in { -3.5, 2.5 } do
		for _, side in { -1, 1 } do
			part({
				Name = "Window",
				Size = Vector3.new(2.4, 2.4, 0.3),
				CFrame = CFrame.new(x + wx, 7, z + side * 5),
				Color = Color3.fromRGB(255, 225, 140),
				Material = Enum.Material.Neon,
				Parent = model,
			})
		end
	end
	part({
		Name = "Chimney",
		Size = Vector3.new(2, 4, 2),
		CFrame = CFrame.new(x - 3.5, 14.5, z + 2),
		Color = Color3.fromRGB(140, 70, 60),
		Material = Enum.Material.Brick,
		Parent = model,
	})
	Decor.signboard(
		model,
		CFrame.new(Belt.START_X - 1.6, 10.6, z) * CFrame.Angles(0, -math.pi / 2, 0),
		Vector2.new(8, 1.6),
		"FREEK HOUSE",
		roofColor
	)
end

local function buildBelt()
	local model = Instance.new("Model")
	model.Name = "Conveyor"
	model.Parent = Workspace

	local length = Belt.LENGTH + 6
	local centerX = Belt.START_X + Belt.LENGTH / 2
	for _, z in Belt.LANES do
		part({
			Name = "Belt",
			Size = Vector3.new(length, 1, 9),
			CFrame = CFrame.new(centerX, 0.5, z),
			Color = Color3.fromRGB(55, 55, 65),
			Material = Enum.Material.DiamondPlate,
			Parent = model,
		})
		for _, side in { -1, 1 } do
			part({
				Name = "Rail",
				Size = Vector3.new(length, 1.4, 0.8),
				CFrame = CFrame.new(centerX, 1.2, z + side * 4.9),
				Color = Color3.fromRGB(255, 200, 40),
				Material = Enum.Material.SmoothPlastic,
				Parent = model,
			})
		end
		-- Steel frame and legs under the belt, and a glowing strip along each rail.
		part({
			Name = "Frame",
			Size = Vector3.new(length, 0.6, 9.8),
			CFrame = CFrame.new(centerX, 0.1, z),
			Color = Color3.fromRGB(70, 75, 85),
			Material = Enum.Material.Metal,
			Parent = model,
		})
		for _, side in { -1, 1 } do
			part({
				Name = "RailGlow",
				Size = Vector3.new(length, 0.2, 0.25),
				CFrame = CFrame.new(centerX, 1.95, z + side * 4.9),
				Color = Color3.fromRGB(255, 240, 160),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = model,
			})
		end
		part({
			Name = "Chute",
			Size = Vector3.new(6, 3, 9.5),
			CFrame = CFrame.new(Belt.START_X + Belt.LENGTH + 5, 1.5, z),
			Color = Color3.fromRGB(30, 30, 35),
			Material = Enum.Material.Metal,
			Parent = model,
		})
	end
	buildHouse(model, Belt.LANES[1], Color3.fromRGB(150, 80, 220), Color3.fromRGB(90, 40, 150))
	buildHouse(model, Belt.LANES[2], Color3.fromRGB(80, 170, 230), Color3.fromRGB(40, 100, 160))

	folder = Instance.new("Folder")
	folder.Name = "BeltFreeks"
	folder.Parent = Workspace
end

local function priceOf(species, mutations: { string }?): number
	local base = species.price or math.floor(species.income * Belt.PRICE_SECONDS)
	return math.floor(base * Mutations.mult(mutations))
end

-- Species that can come out of the machine right now, grouped by rarity.
local function eligibleByRarity()
	local groups = {}
	for _, species in Freeks.list do
		if Seasons.available(species) then
			groups[species.rarity] = groups[species.rarity] or {}
			table.insert(groups[species.rarity], species)
		end
	end
	return groups
end

local function rollRarity(): string
	local total = 0
	for _, entry in Belt.ODDS do
		total += entry.weight
	end
	local roll = rng:NextNumber() * total
	for _, entry in Belt.ODDS do
		roll -= entry.weight
		if roll <= 0 then
			return entry.rarity
		end
	end
	return Belt.ODDS[1].rarity
end

-- Belt Freeks get at most one mutation; stacking them is done by breeding.
local function rollMutations(): { string }?
	for _, mutation in Mutations.list do
		if rng:NextNumber() < mutation.chance * Belt.MUTATION_FACTOR then
			return { mutation.id }
		end
	end
	return nil
end

local function spawnFreek(lane: number)
	local groups = eligibleByRarity()
	local rarity = rollRarity()
	-- Nothing of that rarity discovered yet: fall back down the tiers.
	while not groups[rarity] and Rarities.rank[rarity] > 1 do
		rarity = Rarities.order[Rarities.rank[rarity] - 1]
	end
	local pool = groups[rarity]
	if not pool then
		return
	end
	local species = pool[rng:NextInteger(1, #pool)]
	local mutations = rollMutations()
	local price = priceOf(species, mutations)
	local spawnTime = Workspace:GetServerTimeNow()

	nextId += 1
	local id = tostring(nextId)
	local model, height = FreekModel.build(species.id, mutations)
	model.Name = id
	model:SetAttribute("SpawnTime", spawnTime)
	model:SetAttribute("Lane", lane)
	model:PivotTo(Belt.cframeAt(lane, spawnTime, spawnTime))

	local anchor = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	local freek = { species = species.id, mutations = mutations }
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(180, 50)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height - (anchor.Position.Y - Belt.Y) + 1.2, 0)
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	local name = Instance.new("TextLabel")
	name.Size = UDim2.fromScale(1, 0.55)
	name.BackgroundTransparency = 1
	name.TextScaled = true
	name.Font = Enum.Font.FredokaOne
	name.Text = FreekUtil.displayName(freek)
	name.TextColor3 = if mutations then Mutations.byId[mutations[1]].color else Rarities.info[species.rarity].color
	name.TextStrokeTransparency = 0.2
	name.Parent = gui
	local cost = name:Clone()
	cost.Size = UDim2.fromScale(1, 0.45)
	cost.Position = UDim2.fromScale(0, 0.55)
	cost.Text = Format.money(price) .. "  ·  " .. Format.money(FreekUtil.income(freek)) .. "/s"
	cost.TextColor3 = Color3.fromRGB(140, 255, 140)
	cost.Parent = gui
	gui.Parent = anchor

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BuyPrompt"
	prompt.ActionText = "Buy " .. Format.money(price)
	prompt.ObjectText = FreekUtil.displayName(freek)
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = Belt.BUY_DISTANCE - 2
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("ItemId", id)
	prompt.Parent = anchor

	model.Parent = folder
	items[id] = {
		species = species,
		mutations = mutations,
		price = price,
		spawnTime = spawnTime,
		lane = lane,
		model = model,
	}

	if Rarities.rank[species.rarity] >= Belt.ANNOUNCE_RANK then
		for _, player in Players:GetPlayers() do
			notify(
				player,
				"A " .. species.rarity .. " " .. FreekUtil.displayName(freek) .. " is on the belt!",
				"discovery"
			)
		end
	end
end

local function buy(player: Player, id: string)
	local item = items[id]
	local data = DataService.get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not item or not data or not root then
		return
	end
	local now = Workspace:GetServerTimeNow()
	local where = Belt.cframeAt(item.lane, item.spawnTime, now).Position
	if (root.Position - where).Magnitude > Belt.BUY_DISTANCE or Belt.isGone(item.spawnTime, now) then
		return
	end
	if not PlotService.getPlot(player) then
		return
	end
	if FreekUtil.count(data) >= GamePasses.maxFreeks(player) then
		return notify(player, "You have too many Freeks! Sell some first.", "error")
	end
	if data.money < item.price then
		return notify(player, "Not enough money! It costs " .. Format.money(item.price) .. ".", "error")
	end

	items[id] = nil
	item.model:Destroy()
	data.money -= item.price
	local name = FreekUtil.displayName({ species = item.species.id, mutations = item.mutations })
	ActionService.giveFreek(player, data, item.species.id, item.mutations)
	DataService.changed(player)
	notify(player, "You bought " .. name .. "! It's heading to your yard.", "success")
end

function ConveyorService.init()
	buildBelt()

	game:GetService("ProximityPromptService").PromptTriggered:Connect(function(prompt, player)
		local id = prompt.Name == "BuyPrompt" and prompt:GetAttribute("ItemId")
		if typeof(id) == "string" then
			buy(player, id)
		end
	end)

	-- Each lane has its own house; they take turns so a Freek appears every half interval.
	for lane in Belt.LANES do
		task.delay((lane - 1) * Belt.SPAWN_INTERVAL / 2, function()
			while true do
				spawnFreek(lane)
				task.wait(Belt.SPAWN_INTERVAL)
			end
		end)
	end

	-- Freeks nobody bought fall off the end.
	task.spawn(function()
		while true do
			task.wait(0.5)
			local now = Workspace:GetServerTimeNow()
			for id, item in items do
				if Belt.isGone(item.spawnTime, now) then
					item.model:Destroy()
					items[id] = nil
				end
			end
		end
	end)
end

return ConveyorService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Loads and saves each player's data with a session lock, so the same player in two
-- servers at once (e.g. a fast rejoin) can't duplicate or lose Freeks.
--
-- In Studio without "Enable Studio Access to API Services", saving is skipped and a
-- fresh save is used so the game is still testable.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Mutations = require(ReplicatedStorage.Shared.Mutations)

local STORE_NAME = "FuseAFreek_Players_v1"

local DataService = {}

local profiles = {} -- [Player] = data
local noSave = {} -- [Player] = true when running without DataStores
local loadedCallbacks = {}
local changedCallbacks = {}

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local function defaultData()
	return {
		version = 1,
		money = Config.START_MONEY,
		slots = Config.START_SLOTS,
		freeks = {}, -- [uid] = { species, mutations?, slot?, breeding? }
		breeding = nil, -- { a = uid, b = uid, endsAt = unix seconds }
		discovered = {}, -- [speciesId] = true for every species this player has owned
		rebirths = 0,
		lastSeen = os.time(),
	}
end

local function reconcile(data)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		end
	end
	-- Old saves stored a single mutation.
	for _, freek in data.freeks do
		if freek.mutation then
			freek.mutations = Mutations.pack(freek.mutation)
			freek.mutation = nil
		end
	end
	return data
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

-- Returns data, or nil + reason. reason is "locked" when another server holds the save.
local function tryLoad(player: Player)
	local locked = false
	local ok, result = pcall(function()
		return store:UpdateAsync(keyFor(player), function(old)
			locked = false
			old = old or defaultData()
			local lock = old.lock
			if lock and lock.job ~= game.JobId and os.time() - lock.time < Config.SESSION_LOCK_TIMEOUT then
				locked = true
				return nil
			end
			old.lock = { job = game.JobId, time = os.time() }
			return old
		end)
	end)
	if not ok then
		return nil, result
	end
	if locked then
		return nil, "locked"
	end
	return result, nil
end

local function load(player: Player)
	if not store then
		return nil, "DataStores unavailable"
	end
	local reason
	for attempt = 1, 6 do
		local data
		data, reason = tryLoad(player)
		if data then
			return reconcile(data)
		end
		if not player.Parent then
			return nil, "left"
		end
		if RunService:IsStudio() and reason ~= "locked" then
			return nil, reason -- don't make testers wait through retries
		end
		task.wait(if reason == "locked" then 10 else 2 * attempt)
	end
	return nil, reason
end

function DataService.save(player: Player, release: boolean?)
	local data = profiles[player]
	if not data or noSave[player] then
		return
	end
	data.lastSeen = os.time()
	data.lock = if release then nil else { job = game.JobId, time = os.time() }
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function(old)
				if old and old.lock and old.lock.job ~= game.JobId then
					return nil -- another server took over; never overwrite its save
				end
				return data
			end)
		end)
		if ok then
			return
		end
		warn("Save failed for", player.Name, err)
		task.wait(attempt)
	end
end

function DataService.get(player: Player)
	return profiles[player]
end

-- Yields until the player's data is loaded; returns nil if they leave first.
function DataService.waitFor(player: Player)
	while player.Parent and not profiles[player] do
		task.wait(0.1)
	end
	return profiles[player]
end

function DataService.all()
	return profiles
end

function DataService.onLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

function DataService.onChanged(callback)
	table.insert(changedCallbacks, callback)
end

-- Call after changing a player's data so their yard and UI refresh.
function DataService.changed(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	for _, callback in changedCallbacks do
		task.spawn(callback, player, data)
	end
end

local function onPlayerAdded(player: Player)
	local data, reason = load(player)
	if not player.Parent then
		return
	end
	if not data then
		if RunService:IsStudio() then
			warn("Using a temporary save (not saved). Reason:", reason)
			data = defaultData()
			noSave[player] = true
		elseif reason == "locked" then
			player:Kick("Your Freeks are still saving from your last server. Please rejoin in a minute!")
			return
		else
			player:Kick("Couldn't load your Freeks right now. Please rejoin!")
			return
		end
	end
	profiles[player] = data
	for _, callback in loadedCallbacks do
		task.spawn(callback, player, data)
	end
	DataService.changed(player)
end

local function onPlayerRemoving(player: Player)
	if profiles[player] then
		DataService.save(player, true)
	end
	profiles[player] = nil
	noSave[player] = nil
end

function DataService.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Decor</string>
          <string name="Source"><![CDATA[-- Reusable scenery pieces built from parts: trees, bushes, flowers, lamp posts, picket
-- fences and signboards. Every builder takes a parent and a CFrame on the ground.

local CollectionService = game:GetService("CollectionService")

local Decor = {}

-- Tags let SeasonalService recolour scenery for events (e.g. orange leaves at Halloween).
Decor.TAGS = { leaves = "TreeLeaves", bulb = "LampBulb", lawn = "Lawn" }

-- Remembers a part's normal colour so a seasonal theme can be undone.
function Decor.tag(instance: BasePart, tag: string)
	instance:SetAttribute("BaseColor", instance.Color)
	CollectionService:AddTag(instance, tag)
end

local function part(props, className: string?): BasePart
	local p = Instance.new(className or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		p[key] = value
	end
	return p
end
Decor.part = part

local LEAF_COLORS = {
	Color3.fromRGB(70, 160, 70),
	Color3.fromRGB(90, 180, 80),
	Color3.fromRGB(60, 140, 75),
}

-- A round cartoon tree. scale 1 is about 14 studs tall.
function Decor.tree(parent: Instance, ground: CFrame, scale: number?, seed: number?)
	local s = scale or 1
	local rng = Random.new(seed or 1)
	part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(7 * s, 1.6 * s, 1.6 * s),
		CFrame = ground * CFrame.new(0, 3.5 * s, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(120, 85, 55),
		Material = Enum.Material.Wood,
		Parent = parent,
	})
	for i = 1, 3 do
		local size = (5.5 + rng:NextNumber() * 2) * s
		local offset =
			Vector3.new((rng:NextNumber() - 0.5) * 3 * s, (7.5 + i * 1.6) * s, (rng:NextNumber() - 0.5) * 3 * s)
		Decor.tag(
			part({
				Name = "Leaves",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * size,
				CFrame = ground * CFrame.new(offset),
				Color = LEAF_COLORS[rng:NextInteger(1, #LEAF_COLORS)],
				Material = Enum.Material.Grass,
				CanCollide = false,
				Parent = parent,
			}),
			Decor.TAGS.leaves
		)
	end
end

function Decor.bush(parent: Instance, ground: CFrame, scale: number?, seed: number?)
	local s = scale or 1
	local rng = Random.new(seed or 2)
	for _ = 1, 3 do
		local size = (2.2 + rng:NextNumber() * 1.2) * s
		part({
			Name = "Bush",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size,
			CFrame = ground
				* CFrame.new((rng:NextNumber() - 0.5) * 2.5 * s, size * 0.35, (rng:NextNumber() - 0.5) * 1.5 * s),
			Color = LEAF_COLORS[rng:NextInteger(1, #LEAF_COLORS)],
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local FLOWER_COLORS = {
	Color3.fromRGB(255, 110, 150),
	Color3.fromRGB(255, 220, 80),
	Color3.fromRGB(170, 120, 255),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(255, 150, 60),
}

-- A rectangular flower bed (width along X, depth along Z).
function Decor.flowerBed(parent: Instance, ground: CFrame, width: number, depth: number, seed: number?)
	local rng = Random.new(seed or 3)
	part({
		Name = "FlowerBed",
		Size = Vector3.new(width, 0.4, depth),
		CFrame = ground * CFrame.new(0, 0.2, 0),
		Color = Color3.fromRGB(110, 75, 50),
		Material = Enum.Material.Ground,
		CanCollide = false,
		Parent = parent,
	})
	local count = math.floor(width * depth / 2.5)
	for _ = 1, count do
		local x = (rng:NextNumber() - 0.5) * (width - 0.8)
		local z = (rng:NextNumber() - 0.5) * (depth - 0.8)
		part({
			Name = "Stem",
			Size = Vector3.new(0.15, 0.8, 0.15),
			CFrame = ground * CFrame.new(x, 0.8, z),
			Color = Color3.fromRGB(70, 150, 60),
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
		part({
			Name = "Flower",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.55,
			CFrame = ground * CFrame.new(x, 1.25, z),
			Color = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)],
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
	end
end

-- A lamp post with a warm light that glows at night and adds sparkle by day.
function Decor.lamp(parent: Instance, ground: CFrame, color: Color3?)
	part({
		Name = "LampPost",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(8, 0.5, 0.5),
		CFrame = ground * CFrame.new(0, 4, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(45, 45, 55),
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Name = "LampBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 1.4, 1.4),
		CFrame = ground * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(45, 45, 55),
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	local bulb = part({
		Name = "Bulb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.3,
		CFrame = ground * CFrame.new(0, 8.4, 0),
		Color = color or Color3.fromRGB(255, 225, 160),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	local light = Instance.new("PointLight")
	light.Color = color or Color3.fromRGB(255, 210, 150)
	light.Range = 18
	light.Brightness = 1.2
	light.Shadows = false
	light.Parent = bulb
	Decor.tag(bulb, Decor.TAGS.bulb)
end

-- A glowing jack-o'-lantern. scale 1 is about 3 studs wide; its face looks along -Z.
function Decor.pumpkin(parent: Instance, ground: CFrame, scale: number?)
	local s = scale or 1
	local orange = Color3.fromRGB(235, 125, 30)
	local center = ground * CFrame.new(0, 1.2 * s, 0)
	-- Three overlapping balls make the ribbed shape.
	local body
	for _, dx in { -0.55, 0, 0.55 } do
		local ball = part({
			Name = "Pumpkin",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (if dx == 0 then 2.5 else 2.2) * s,
			CFrame = center * CFrame.new(dx * s, 0, 0),
			Color = if dx == 0 then orange else orange:Lerp(Color3.new(0, 0, 0), 0.08),
			Parent = parent,
		})
		if dx == 0 then
			body = ball
		end
	end
	part({
		Name = "Stem",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7 * s, 0.35 * s, 0.35 * s),
		CFrame = center * CFrame.new(0, 1.3 * s, 0) * CFrame.Angles(0, 0, math.pi / 2 + 0.2),
		Color = Color3.fromRGB(90, 110, 40),
		CanCollide = false,
		Parent = parent,
	})
	-- Glowing face: two triangle eyes and a grin.
	local glow = Color3.fromRGB(255, 200, 70)
	for _, dx in { -0.45, 0.45 } do
		part({
			Name = "Eye",
			Size = Vector3.new(0.12, 0.45 * s, 0.5 * s),
			CFrame = center * CFrame.new(dx * s, 0.3 * s, -1.18 * s) * CFrame.Angles(0, math.pi / 2, 0),
			Color = glow,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = parent,
		}, "WedgePart")
	end
	part({
		Name = "Grin",
		Size = Vector3.new(1.1 * s, 0.25 * s, 0.12),
		CFrame = center * CFrame.new(0, -0.35 * s, -1.2 * s),
		Color = glow,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 50)
	light.Range = 10 * s
	light.Brightness = 1.5
	light.Shadows = false
	light.Parent = body
end

-- A hay bale with twine bands, lying along X.
function Decor.hayBale(parent: Instance, ground: CFrame)
	part({
		Name = "HayBale",
		Size = Vector3.new(4, 2.4, 2.6),
		CFrame = ground * CFrame.new(0, 1.2, 0),
		Color = Color3.fromRGB(225, 190, 95),
		Material = Enum.Material.Sand,
		Parent = parent,
	})
	for _, dx in { -1, 1 } do
		part({
			Name = "Twine",
			Size = Vector3.new(0.25, 2.5, 2.7),
			CFrame = ground * CFrame.new(dx, 1.2, 0),
			Color = Color3.fromRGB(140, 100, 55),
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local FALL_LEAVES = {
	Color3.fromRGB(230, 120, 40),
	Color3.fromRGB(200, 70, 40),
	Color3.fromRGB(235, 180, 50),
	Color3.fromRGB(170, 100, 50),
}
Decor.FALL_LEAVES = FALL_LEAVES

-- A low pile of fallen leaves: overlapping flat discs in autumn colours.
function Decor.leafPile(parent: Instance, ground: CFrame, seed: number?)
	local rng = Random.new(seed or 9)
	for i = 1, 6 do
		local size = 1.6 + rng:NextNumber() * 1.6
		part({
			Name = "LeafPile",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.35, size, size),
			CFrame = ground
				* CFrame.new((rng:NextNumber() - 0.5) * 3, 0.1 + i * 0.07, (rng:NextNumber() - 0.5) * 3)
				* CFrame.Angles(0, 0, math.pi / 2),
			Color = FALL_LEAVES[rng:NextInteger(1, #FALL_LEAVES)],
			Material = Enum.Material.Grass,
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
	end
end

-- A white picket fence from a to b (both on the ground). Pickets every `spacing` studs.
function Decor.picketFence(parent: Instance, a: Vector3, b: Vector3, height: number, color: Color3?)
	local white = color or Color3.fromRGB(245, 242, 235)
	local length = (b - a).Magnitude
	if length < 0.5 then
		return
	end
	local along = CFrame.lookAt(a, b) -- -Z points from a to b
	for _, y in { height * 0.35, height * 0.75 } do
		part({
			Name = "Rail",
			Size = Vector3.new(0.3, 0.35, length),
			CFrame = along * CFrame.new(0, y, -length / 2),
			Color = white,
			Material = Enum.Material.WoodPlanks,
			Parent = parent,
		})
	end
	local spacing = 1.6
	local count = math.max(1, math.floor(length / spacing))
	for i = 0, count do
		local z = -math.min(length, i * length / count)
		part({
			Name = "Picket",
			Size = Vector3.new(0.25, height, 0.7),
			CFrame = along * CFrame.new(0, height / 2, z),
			Color = white,
			Material = Enum.Material.WoodPlanks,
			Parent = parent,
		})
		-- A small block turned 45 degrees gives each picket a pointed top.
		local tip = part({
			Name = "PicketTip",
			Size = Vector3.new(0.25, 0.5, 0.5),
			CFrame = along * CFrame.new(0, height, z) * CFrame.Angles(math.rad(45), 0, 0),
			Color = white,
			Material = Enum.Material.WoodPlanks,
			Parent = parent,
		})
		tip.CanCollide = false
	end
end

-- A wooden signboard with text on both faces. Returns the front TextLabel (and back).
function Decor.signboard(parent: Instance, cframe: CFrame, size: Vector2, text: string, accent: Color3)
	local board = part({
		Name = "Signboard",
		Size = Vector3.new(size.X, size.Y, 0.5),
		CFrame = cframe,
		Color = Color3.fromRGB(140, 95, 60),
		Material = Enum.Material.WoodPlanks,
		Parent = parent,
	})
	part({
		Name = "SignTrim",
		Size = Vector3.new(size.X + 0.6, size.Y + 0.6, 0.35),
		CFrame = cframe,
		Color = accent,
		Parent = parent,
	})
	local labels = {}
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 0.3
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.Text = text
		label.TextColor3 = Color3.fromRGB(255, 250, 235)
		label.TextStrokeTransparency = 0.4
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0.04, 0)
		padding.PaddingRight = UDim.new(0.04, 0)
		padding.PaddingTop = UDim.new(0.12, 0)
		padding.PaddingBottom = UDim.new(0.12, 0)
		padding.Parent = label
		label.Parent = gui
		gui.Parent = board
		table.insert(labels, label)
	end
	return labels
end

return Decor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">DiscoveryService</string>
          <string name="Source"><![CDATA[-- The Discovery Book: the first player in the whole game to get each species has their
-- name saved forever. Claims go through UpdateAsync so two servers can't both win, and
-- MessagingService tells every other server right away.

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Freeks = require(ReplicatedStorage.Shared.Freeks)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local STORE_NAME = "FuseAFreek_Discoveries_v1"
local TOPIC = "FreekDiscovered"

local DiscoveryService = {}

local cache = {} -- [speciesId] = { name, userId, time }
local claiming = {}
local store = nil
pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local discoveryUpdate = Remotes.get("DiscoveryUpdate")
local notify = Remotes.get("Notify")

local function announce(speciesId: string, discovery)
	local isNew = cache[speciesId] == nil
	cache[speciesId] = discovery
	discoveryUpdate:FireAllClients(speciesId, discovery)
	if isNew then
		local species = Freeks.byId[speciesId]
		notify:FireAllClients(
			string.format("%s discovered %s for the first time ever!", discovery.name, species.name),
			"discovery"
		)
	end
end

local function loadAll()
	if not store then
		return
	end
	for _, species in Freeks.list do
		if not species.price and not cache[species.id] then
			local ok, value = pcall(store.GetAsync, store, species.id)
			if ok and value then
				cache[species.id] = value
			end
		end
	end
end

-- Call whenever a player gets a species. Shop (starter) Freeks aren't claimable.
function DiscoveryService.claim(player: Player, speciesId: string)
	local species = Freeks.byId[speciesId]
	if not species or species.price or cache[speciesId] or claiming[speciesId] then
		return
	end
	claiming[speciesId] = true

	local mine = { name = player.DisplayName, userId = player.UserId, time = os.time() }
	local winner = mine
	if store then
		local ok, result = pcall(function()
			local existing = nil
			store:UpdateAsync(speciesId, function(old)
				existing = old
				if old then
					return nil
				end
				return mine
			end)
			return existing
		end)
		if ok then
			winner = result or mine
		elseif not RunService:IsStudio() then
			warn("Discovery claim failed:", result)
			claiming[speciesId] = nil
			return
		end
	end

	announce(speciesId, winner)
	if winner == mine then
		pcall(MessagingService.PublishAsync, MessagingService, TOPIC, { species = speciesId, discovery = mine })
	end
	claiming[speciesId] = nil
end

-- True once someone, anywhere, has found this species.
function DiscoveryService.isDiscovered(speciesId: string): boolean
	return cache[speciesId] ~= nil
end

function DiscoveryService.init()
	Remotes.get("GetDiscoveries").OnServerInvoke = function()
		return cache
	end

	-- In the background: SubscribeAsync can hang for a long time in Studio, and nothing
	-- else should wait on it.
	task.spawn(pcall, function()
		MessagingService:SubscribeAsync(TOPIC, function(message)
			local data = message.Data
			if typeof(data) == "table" and Freeks.byId[data.species] then
				announce(data.species, data.discovery)
			end
		end)
	end)

	task.spawn(function()
		while true do
			loadAll()
			task.wait(300)
		end
	end)

	-- Re-check species a player already owns, in case an earlier claim failed.
	local DataService = require(script.Parent.DataService)
	DataService.onLoaded(function(player, data)
		for speciesId in data.discovered do
			DiscoveryService.claim(player, speciesId)
		end
	end)
end

return DiscoveryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[-- Pays every player once a second for the Freeks in their yard, plus offline earnings
-- when they come back. Money also shows on the leaderboard so players can show off.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)

local EconomyService = {}

-- Yard income including rebirths and game passes.
local function incomeFor(player: Player, data): number
	return FreekUtil.yardIncome(data) * GamePasses.coinMultiplier(player)
end

local function publish(player: Player, data, income: number)
	player:SetAttribute("Money", data.money)
	player:SetAttribute("Income", income)
	local stats = player:FindFirstChild("leaderstats")
	local money = stats and stats:FindFirstChild("Money")
	if money then
		money.Value = math.floor(data.money)
	end
	local rebirths = stats and stats:FindFirstChild("Rebirths")
	if rebirths then
		rebirths.Value = data.rebirths
	end
end

local function onLoaded(player: Player, data)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local money = Instance.new("NumberValue")
	money.Name = "Money"
	money.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player

	local income = incomeFor(player, data)
	local away = math.clamp(os.time() - (data.lastSeen or os.time()), 0, Config.OFFLINE_MAX_SECONDS)
	local earned = math.floor(away * income * Config.OFFLINE_RATE)
	if earned > 0 then
		data.money += earned
		Remotes.get("Notify")
			:FireClient(player, "While you were away your Freeks earned " .. Format.money(earned) .. "!", "money")
	end
	publish(player, data, income)
end

function EconomyService.init()
	DataService.onLoaded(onLoaded)
	DataService.onChanged(function(player, data)
		publish(player, data, incomeFor(player, data))
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			for player, data in DataService.all() do
				local income = incomeFor(player, data)
				data.money += income
				publish(player, data, income)
			end
		end
	end)
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Environment</string>
          <string name="Source"><![CDATA[-- Lighting, sky, terrain and the scenery around the yards and conveyor.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Belt = require(ReplicatedStorage.Shared.Belt)

local Decor = require(script.Parent.Decor)

local Environment = {}

local function effect(className: string, props)
	local existing = Lighting:FindFirstChildOfClass(className)
	local instance = existing or Instance.new(className)
	for key, value in props do
		instance[key] = value
	end
	instance.Parent = Lighting
	return instance
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(70, 70, 90)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 135, 150)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	Lighting.GeographicLatitude = 35

	effect("Sky", { SunAngularSize = 14, MoonAngularSize = 9, StarCount = 3000 })
	effect("Atmosphere", {
		Density = 0.28,
		Offset = 0.15,
		Color = Color3.fromRGB(200, 215, 240),
		Decay = Color3.fromRGB(110, 130, 170),
		Glare = 0.25,
		Haze = 1.2,
	})
	effect("BloomEffect", { Intensity = 0.6, Size = 26, Threshold = 1.6 })
	effect("SunRaysEffect", { Intensity = 0.06, Spread = 0.7 })
	effect("ColorCorrectionEffect", {
		Brightness = 0.02,
		Contrast = 0.08,
		Saturation = 0.15,
		TintColor = Color3.fromRGB(255, 250, 242),
	})

	local clouds = Workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.6
	clouds.Color = Color3.fromRGB(255, 255, 255)
	clouds.Parent = Workspace.Terrain
end

local function setupTerrain()
	local terrain = Workspace.Terrain
	-- Grass everywhere, with the top of the terrain at y = 0.
	terrain:FillBlock(CFrame.new(0, -4, 0), Vector3.new(600, 8, 600), Enum.Material.Grass)
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(95, 175, 80))
	terrain:SetMaterialColor(Enum.Material.Pavement, Color3.fromRGB(196, 190, 180))
end

local function buildScenery()
	local folder = Instance.new("Folder")
	folder.Name = "Scenery"
	folder.Parent = Workspace

	-- Paved walkways along both sides of the conveyor, where players stand to buy.
	local beltCenter = Belt.START_X + Belt.LENGTH / 2
	for _, side in { -1, 1 } do
		Decor.part({
			Name = "Walkway",
			Size = Vector3.new(Belt.LENGTH + 40, 0.3, 18),
			CFrame = CFrame.new(beltCenter, 0.15, side * 20),
			Color = Color3.fromRGB(200, 194, 184),
			Material = Enum.Material.Pavement,
			Parent = folder,
		})
		Decor.part({
			Name = "Curb",
			Size = Vector3.new(Belt.LENGTH + 40, 0.5, 0.8),
			CFrame = CFrame.new(beltCenter, 0.25, side * 29.4),
			Color = Color3.fromRGB(150, 145, 140),
			Material = Enum.Material.Concrete,
			Parent = folder,
		})
		-- Lamps along the walkway.
		for x = Belt.START_X + 10, Belt.START_X + Belt.LENGTH - 10, 35 do
			Decor.lamp(folder, CFrame.new(x, 0.3, side * 28))
		end
	end

	-- A ring of trees around the edge of the map.
	local seed = 10
	for x = -200, 200, 26 do
		for _, z in { -150, 150 } do
			seed += 1
			Decor.tree(folder, CFrame.new(x + (seed % 5) * 2, 0, z + (seed % 3) * 4), 1.2 + (seed % 4) * 0.15, seed)
		end
	end
	for z = -124, 124, 26 do
		for _, x in { -210, 210 } do
			seed += 1
			Decor.tree(folder, CFrame.new(x + (seed % 3) * 4, 0, z), 1.2 + (seed % 4) * 0.15, seed)
		end
	end
	-- Bushes and flowers by the spawn.
	Decor.flowerBed(folder, CFrame.new(150, 0, -12), 10, 3, 4)
	Decor.flowerBed(folder, CFrame.new(150, 0, 12), 10, 3, 5)
	Decor.bush(folder, CFrame.new(158, 0, -18), 1.3, 6)
	Decor.bush(folder, CFrame.new(158, 0, 18), 1.3, 7)
end

function Environment.init()
	setupLighting()
	setupTerrain()
	buildScenery()
end

return Environment
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">HalloweenDecor</string>
          <string name="Source"><![CDATA[-- Halloween props: ghosts, bats, cobwebs, tombstones, dead trees, a witch's cauldron,
-- witch hats, string lights and creeping fog.
--
-- Ghosts and bats are tagged; each client flies them around (see client/Ambient) using
-- the attributes set here, so they move smoothly without network traffic.

local CollectionService = game:GetService("CollectionService")

local Decor = require(script.Parent.Decor)

local part = Decor.part

local HalloweenDecor = {}

HalloweenDecor.GHOST_TAG = "SpookyGhost"
HalloweenDecor.BAT_TAG = "SpookyBat"

-- Shared flight settings read by the client: circle `center` at `radius`, `height` up.
local function flightPath(model: Model, center: Vector3, radius: number, height: number, speed: number, phase: number)
	model:SetAttribute("Center", center)
	model:SetAttribute("Radius", radius)
	model:SetAttribute("Height", height)
	model:SetAttribute("Speed", speed)
	model:SetAttribute("Phase", phase)
end

function HalloweenDecor.ghost(
	parent: Instance,
	center: Vector3,
	radius: number,
	height: number,
	speed: number,
	phase: number
)
	local model = Instance.new("Model")
	model.Name = "Ghost"
	local white = Color3.fromRGB(240, 245, 255)
	local origin = CFrame.new(center + Vector3.new(radius, height, 0))
	local head = part({
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 3.2,
		CFrame = origin,
		Color = white,
		Transparency = 0.15,
		CanCollide = false,
		CastShadow = false,
		Parent = model,
	})
	part({
		Name = "Body",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.6, 3.1, 3.1),
		CFrame = origin * CFrame.new(0, -1.3, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = white,
		Transparency = 0.15,
		CanCollide = false,
		CastShadow = false,
		Parent = model,
	})
	-- Wavy hem.
	for i = 0, 5 do
		local angle = i / 6 * math.pi * 2
		part({
			Name = "Hem",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 1.2,
			CFrame = origin * CFrame.new(math.cos(angle) * 1.2, -2.7, math.sin(angle) * 1.2),
			Color = white,
			Transparency = 0.15,
			CanCollide = false,
			CastShadow = false,
			Parent = model,
		})
	end
	for _, x in { -1.6, 1.6 } do
		part({
			Name = "Arm",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1, 1, 1),
			CFrame = origin * CFrame.new(x, -0.9, -0.3),
			Color = white,
			Transparency = 0.15,
			CanCollide = false,
			CastShadow = false,
			Parent = model,
		})
	end
	for _, x in { -0.55, 0.55 } do
		part({
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.6,
			CFrame = origin * CFrame.new(x, 0.3, -1.4),
			Color = Color3.fromRGB(20, 20, 30),
			CanCollide = false,
			Parent = model,
		})
	end
	part({
		Name = "Mouth",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.7, 0.7, 0.7),
		CFrame = origin * CFrame.new(0, -0.5, -1.4),
		Color = Color3.fromRGB(20, 20, 30),
		CanCollide = false,
		Parent = model,
	})
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(190, 220, 255)
	glow.Range = 12
	glow.Brightness = 0.8
	glow.Parent = head
	model.PrimaryPart = head
	flightPath(model, center, radius, height, speed, phase)
	model.Parent = parent
	CollectionService:AddTag(model, HalloweenDecor.GHOST_TAG)
	return model
end

function HalloweenDecor.bat(
	parent: Instance,
	center: Vector3,
	radius: number,
	height: number,
	speed: number,
	phase: number
)
	local model = Instance.new("Model")
	model.Name = "Bat"
	local black = Color3.fromRGB(28, 22, 36)
	local origin = CFrame.new(center + Vector3.new(radius, height, 0))
	local body = part({
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.1, 1.1, 1.1),
		CFrame = origin,
		Color = black,
		CanCollide = false,
		Parent = model,
	})
	part({
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.75,
		CFrame = origin * CFrame.new(0, 0.35, -0.55),
		Color = black,
		CanCollide = false,
		Parent = model,
	})
	for _, x in { -0.18, 0.18 } do
		part({
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.16,
			CFrame = origin * CFrame.new(x, 0.42, -0.88),
			Color = Color3.fromRGB(255, 60, 40),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = model,
		})
	end
	for _, side in { -1, 1 } do
		part({
			Name = if side < 0 then "WingL" else "WingR",
			Size = Vector3.new(2.2, 0.1, 1.3),
			CFrame = origin * CFrame.new(side * 1.5, 0, 0),
			Color = Color3.fromRGB(45, 30, 55),
			CanCollide = false,
			Parent = model,
		})
	end
	model.PrimaryPart = body
	flightPath(model, center, radius, height, speed, phase)
	model.Parent = parent
	CollectionService:AddTag(model, HalloweenDecor.BAT_TAG)
	return model
end

-- A cobweb in a corner. `corner` sits in the corner with -X/-Y pointing into the opening,
-- so place it rotated to suit each corner.
function HalloweenDecor.cobweb(parent: Instance, corner: CFrame, size: number)
	local white = Color3.fromRGB(235, 235, 240)
	local strand = function(a: Vector3, b: Vector3)
		local length = (b - a).Magnitude
		part({
			Name = "Web",
			Size = Vector3.new(0.07, 0.07, length),
			CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -length / 2),
			Color = white,
			Transparency = 0.3,
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
	end
	local spokes = {}
	for i = 0, 4 do
		local angle = math.rad(180 + i * 22.5)
		local tip = corner * CFrame.new(math.cos(angle) * size * -1, math.sin(angle) * size, 0)
		spokes[i] = tip.Position
		strand(corner.Position, tip.Position)
	end
	for _, ring in { 0.35, 0.65, 0.95 } do
		for i = 0, 3 do
			local a = corner.Position:Lerp(spokes[i], ring)
			local b = corner.Position:Lerp(spokes[i + 1], ring)
			strand(a, b)
		end
	end
end

function HalloweenDecor.tombstone(parent: Instance, ground: CFrame, seed: number)
	local rng = Random.new(seed)
	local stone = Color3.fromRGB(130, 130, 140):Lerp(Color3.fromRGB(95, 100, 105), rng:NextNumber())
	local lean = ground * CFrame.Angles(math.rad(rng:NextNumber(-8, 8)), 0, math.rad(rng:NextNumber(-10, 10)))
	local slab = part({
		Name = "Tombstone",
		Size = Vector3.new(3, 3.4, 0.8),
		CFrame = lean * CFrame.new(0, 1.7, 0),
		Color = stone,
		Material = Enum.Material.Slate,
		Parent = parent,
	})
	part({
		Name = "TombstoneTop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 3, 3),
		CFrame = lean * CFrame.new(0, 3.4, 0) * CFrame.Angles(0, math.pi / 2, 0),
		Color = stone,
		Material = Enum.Material.Slate,
		Parent = parent,
	})
	part({
		Name = "Dirt",
		Size = Vector3.new(2.6, 0.4, 4),
		CFrame = ground * CFrame.new(0, 0.2, -2.6),
		Color = Color3.fromRGB(85, 60, 45),
		Material = Enum.Material.Ground,
		CanCollide = false,
		Parent = parent,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 0.6)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.Fondamento
	label.Text = "R.I.P."
	label.TextColor3 = Color3.fromRGB(60, 60, 70)
	label.Parent = gui
	gui.Parent = slab
end

-- A bare, twisted tree.
function HalloweenDecor.deadTree(parent: Instance, ground: CFrame, scale: number, seed: number)
	local rng = Random.new(seed)
	local bark = Color3.fromRGB(60, 45, 40)
	local function branch(from: CFrame, length: number, thickness: number, depth: number)
		local tip = from * CFrame.new(0, length, 0)
		part({
			Name = "Branch",
			Size = Vector3.new(thickness, length, thickness),
			CFrame = from * CFrame.new(0, length / 2, 0),
			Color = bark,
			Material = Enum.Material.Wood,
			Parent = parent,
		})
		if depth > 0 then
			for _ = 1, 2 do
				local turn = CFrame.Angles(math.rad(rng:NextNumber(-55, 55)), math.rad(rng:NextNumber(0, 360)), 0)
				branch(tip * turn, length * 0.65, thickness * 0.6, depth - 1)
			end
		end
	end
	branch(ground, 7 * scale, 1.3 * scale, 3)
end

function HalloweenDecor.cauldron(parent: Instance, ground: CFrame)
	local iron = Color3.fromRGB(35, 35, 40)
	part({
		Name = "Cauldron",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 6,
		CFrame = ground * CFrame.new(0, 3, 0),
		Color = iron,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Name = "Rim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 5.4, 5.4),
		CFrame = ground * CFrame.new(0, 5.5, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = iron,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	local brew = part({
		Name = "Brew",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 4.8, 4.8),
		CFrame = ground * CFrame.new(0, 5.65, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(110, 255, 90),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	for i = 0, 2 do
		local angle = i / 3 * math.pi * 2
		part({
			Name = "Leg",
			Size = Vector3.new(0.6, 1.6, 0.6),
			CFrame = ground * CFrame.new(math.cos(angle) * 2, 0.8, math.sin(angle) * 2),
			Color = iron,
			Material = Enum.Material.Metal,
			Parent = parent,
		})
	end
	-- Firewood and flames underneath.
	for i = 0, 3 do
		part({
			Name = "Log",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(4, 0.7, 0.7),
			CFrame = ground * CFrame.new(0, 0.35, 0) * CFrame.Angles(0, i * math.pi / 4, 0),
			Color = Color3.fromRGB(100, 65, 40),
			Material = Enum.Material.Wood,
			Parent = parent,
		})
	end
	local embers = part({
		Name = "Embers",
		Size = Vector3.new(1, 1, 1),
		CFrame = ground * CFrame.new(0, 0.7, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = parent,
	})
	local fire = Instance.new("Fire")
	fire.Size = 4
	fire.Heat = 4
	fire.Parent = embers

	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(120, 255, 110)
	smoke.Opacity = 0.18
	smoke.RiseVelocity = 3
	smoke.Size = 2.5
	smoke.Parent = brew
	local bubbles = Instance.new("Sparkles")
	bubbles.SparkleColor = Color3.fromRGB(150, 255, 120)
	bubbles.Parent = brew
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(110, 255, 90)
	light.Range = 22
	light.Brightness = 2
	light.Parent = brew
end

-- A pointy witch hat; ground is the bottom of the brim.
function HalloweenDecor.witchHat(parent: Instance, ground: CFrame, scale: number, color: Color3)
	local s = scale
	part({
		Name = "Brim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.35 * s, 7 * s, 7 * s),
		CFrame = ground * CFrame.new(0, 0.18 * s, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Parent = parent,
	})
	part({
		Name = "Band",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6 * s, 4.7 * s, 4.7 * s),
		CFrame = ground * CFrame.new(0, 0.6 * s, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(255, 150, 40),
		Parent = parent,
	})
	-- Stacked, shrinking, slightly bent tiers make the cone.
	local tier = ground * CFrame.new(0, 0.9 * s, 0)
	for i, d in { 4.5, 3.6, 2.7, 1.8, 1 } do
		local h = 1.3 * s
		part({
			Name = "Cone",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(h, d * s, d * s),
			CFrame = tier * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
			Color = color,
			Parent = parent,
		})
		tier = tier * CFrame.new(0, h * 0.9, 0) * CFrame.Angles(0, 0, math.rad(if i >= 3 then 9 else 2))
	end
end

-- A strand of glowing bulbs from a to b, sagging in the middle.
function HalloweenDecor.stringLights(parent: Instance, a: Vector3, b: Vector3, count: number, sag: number)
	local colors = { Color3.fromRGB(255, 140, 30), Color3.fromRGB(170, 80, 255) }
	local previous = a
	for i = 0, count do
		local t = i / count
		local point = a:Lerp(b, t) - Vector3.new(0, math.sin(t * math.pi) * sag, 0)
		if i > 0 then
			local length = (point - previous).Magnitude
			part({
				Name = "Wire",
				Size = Vector3.new(0.06, 0.06, length),
				CFrame = CFrame.lookAt(previous, point) * CFrame.new(0, 0, -length / 2),
				Color = Color3.fromRGB(20, 20, 20),
				CanCollide = false,
				CastShadow = false,
				Parent = parent,
			})
		end
		if i > 0 and i < count then
			part({
				Name = "Bulb",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 0.45,
				CFrame = CFrame.new(point - Vector3.new(0, 0.25, 0)),
				Color = colors[i % 2 + 1],
				Material = Enum.Material.Neon,
				CanCollide = false,
				CastShadow = false,
				Parent = parent,
			})
		end
		previous = point
	end
end

-- Low, slow-drifting ground fog.
function HalloweenDecor.fog(parent: Instance, position: Vector3)
	local holder = part({
		Name = "Fog",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(position),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = parent,
	})
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(185, 175, 210)
	smoke.Opacity = 0.07
	smoke.RiseVelocity = 0.2
	smoke.Size = 12
	smoke.Parent = holder
end

return HalloweenDecor
]]></string>
        </Properties>
