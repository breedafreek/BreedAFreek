					color = Color3.fromRGB(240, 145, 170),
				},
				{
					shape = "Cylinder",
					size = { 1, 0.75, 0.75 },
					pos = { 0.8, 0.5, 0.75 },
					rot = { 0, 0, 90 },
					color = Color3.fromRGB(240, 145, 170),
				},
				-- Snout and nostrils
				{
					shape = "Cylinder",
					size = { 0.55, 1.15, 1.15 },
					pos = { 0, 1.95, -1.72 },
					rot = { 0, 90, 0 },
					color = Color3.fromRGB(255, 135, 160),
				},
				{
					shape = "Ball",
					size = 0.24,
					pos = { -0.22, 1.95, -2.0 },
					color = Color3.fromRGB(110, 40, 60),
					detail = true,
				},
				{
					shape = "Ball",
					size = 0.24,
					pos = { 0.22, 1.95, -2.0 },
					color = Color3.fromRGB(110, 40, 60),
					detail = true,
				},
				-- Eyes
				{
					shape = "Ball",
					size = 0.62,
					pos = { -0.6, 2.75, -1.42 },
					color = Color3.new(1, 1, 1),
