			},
			{ shape = "Block", size = { 0.85, 1.1, 2.4 }, pos = { 0, 1, -0.6 }, color = Color3.fromRGB(90, 200, 70) },
			{
				shape = "Cylinder",
				size = { 0.8, 0.5, 0.5 },
				pos = { 0, 1.1, -2.2 },
				rot = { 0, 90, 0 },
				color = Color3.fromRGB(170, 170, 180),
