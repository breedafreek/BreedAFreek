      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Accessories</string>
          <string name="Source"><![CDATA[-- Signature accessories: one per species (Freeks.luau `signature`), worn by the species
-- itself and mixed onto fusions, so a fused Freek shows off both parents' signatures (the
-- nerd's glasses on a pig's head, the pig's bow, ...).
--
-- Each accessory is a list of parts in the Freeks.luau part format, built for a head of
-- radius 1 centred at the origin, facing -Z. Neck accessories are built round a neck point
-- (the origin) instead, sized for a head of radius 1 above it. `slot` says where it goes,
-- so two accessories never fight over the same spot.

local Accessories = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- How far forward the front of a radius-1 head is at (x, y).
local function front(x: number, y: number): number
	return -math.sqrt(math.max(1 - x * x - y * y, 0.01))
end

local GOLD = rgb(255, 205, 60)

local list = {}

-- Nerdle: big round glasses.
list.glasses = {
	slot = "eyes",
	build = function()
		local parts: { any } = {}
		for _, side in { -1, 1 } do
			local x = side * 0.38
			local z = front(x, 0.15) - 0.14
			table.insert(parts, {
				shape = "Cylinder",
				size = { 0.08, 0.5, 0.5 },
				pos = { x, 0.15, z },
				rot = { 0, 90, 0 },
				color = rgb(30, 30, 40),
				detail = true,
			})
			table.insert(parts, {
				shape = "Cylinder",
				size = { 0.09, 0.4, 0.4 },
				pos = { x, 0.15, z },
				rot = { 0, 90, 0 },
				color = rgb(220, 240, 255),
				transparency = 0.55,
				detail = true,
			})
			table.insert(parts, {
				shape = "Block",
				size = { 0.06, 0.06, 0.8 },
				pos = { side * 0.72, 0.18, z + 0.42 },
				color = rgb(30, 30, 40),
				detail = true,
			})
		end
		table.insert(parts, {
			shape = "Block",
			size = { 0.28, 0.07, 0.07 },
			pos = { 0, 0.2, front(0, 0.2) - 0.14 },
			color = rgb(30, 30, 40),
			detail = true,
		})
		return parts
	end,
}

-- Chompers: cool black shades with a shine.
list.shades = {
	slot = "eyes",
	build = function()
		local parts: { any } = {}
		for _, side in { -1, 1 } do
			local x = side * 0.36
			local z = front(x, 0.15) - 0.16
			table.insert(parts, {
				shape = "Ellipsoid",
				size = { 0.52, 0.34, 0.1 },
				pos = { x, 0.15, z },
				color = rgb(20, 20, 28),
				detail = true,
			})
			table.insert(parts, {
				shape = "Block",
				size = { 0.08, 0.2, 0.04 },
				pos = { x - 0.1, 0.19, z - 0.05 },
				rot = { 0, 0, -30 },
				color = rgb(255, 255, 255),
				detail = true,
				shine = false,
			})
		end
		table.insert(parts, {
			shape = "Block",
			size = { 0.3, 0.07, 0.07 },
			pos = { 0, 0.2, front(0, 0.2) - 0.16 },
			color = rgb(20, 20, 28),
			detail = true,
		})
		return parts
	end,
}

-- Hootsworth: a posh top hat with a red band.
list.tophat = {
	slot = "top",
	build = function()
		return {
			{
				shape = "Cylinder",
				size = { 0.08, 1.25, 1.25 },
				pos = { 0, 0.86, 0.05 },
				rot = { 0, 0, 90 },
				color = rgb(25, 25, 32),
			},
			{
				shape = "Cylinder",
				size = { 0.85, 0.8, 0.8 },
				pos = { 0, 1.3, 0.05 },
				rot = { 0, 0, 90 },
				color = rgb(25, 25, 32),
			},
			{
				shape = "Cylinder",
				size = { 0.16, 0.82, 0.82 },
				pos = { 0, 1.0, 0.05 },
				rot = { 0, 0, 90 },
				color = rgb(220, 40, 50),
			},
		}
	end,
}

-- Glamora: a sparkling tiara.
list.tiara = {
	slot = "top",
	build = function()
		local parts: { any } = {}
		for k = -3, 3 do
			local a = math.rad(k * 16)
			local x, z = math.sin(a) * 0.6, -math.cos(a) * 0.6 + 0.12
			table.insert(parts, {
				shape = "Ball",
				size = if k == 0 then 0.24 else 0.15,
				pos = { x, 0.82 + (3 - math.abs(k)) * 0.04, z },
				color = if k == 0 then rgb(255, 120, 200) else GOLD,
				material = if k == 0 then "Neon" else "Foil",
				detail = true,
				shine = false,
			})
		end
		return parts
	end,
}

-- Oinkle: a big pink bow on one side of the head.
list.bow = {
	slot = "top",
	build = function()
		local pink, deep = rgb(255, 50, 140), rgb(200, 20, 100)
		return {
			{
				shape = "Ellipsoid",
				size = { 0.6, 0.46, 0.3 },
				pos = { 0.26, 0.98, -0.12 },
				rot = { 0, 0, 25 },
				color = pink,
				detail = true,
			},
			{
				shape = "Ellipsoid",
				size = { 0.6, 0.46, 0.3 },
				pos = { 0.82, 0.72, -0.12 },
				rot = { 0, 0, 25 },
				color = pink,
				detail = true,
			},
			{ shape = "Ball", size = 0.28, pos = { 0.54, 0.85, -0.18 }, color = deep, detail = true, shine = false },
		}
	end,
}

-- Lizzle: a little flower with a leaf.
list.flower = {
	slot = "top",
	build = function()
		local parts: { any } = {
			{
				shape = "Ball",
				size = 0.2,
				pos = { -0.45, 0.88, -0.12 },
				color = rgb(255, 210, 60),
				detail = true,
				shine = false,
			},
			{
				shape = "Ellipsoid",
				size = { 0.3, 0.08, 0.16 },
				pos = { -0.3, 0.84, 0 },
				rot = { 0, 30, -20 },
				color = rgb(90, 190, 80),
				detail = true,
			},
		}
		for k = 0, 4 do
			local a = k / 5 * math.pi * 2
			table.insert(parts, {
				shape = "Ball",
				size = 0.17,
				pos = { -0.45 + math.cos(a) * 0.15, 0.88 + math.sin(a) * 0.15, -0.1 },
				color = rgb(255, 255, 255),
				detail = true,
				shine = false,
			})
		end
		return parts
	end,
}

-- Stompy: an ivory horn on the forehead with a glowing tip.
list.horn = {
	slot = "forehead",
	build = function()
		local parts: { any } = {}
		for k = 0, 4 do
			local up = k * 0.13
			table.insert(parts, {
				shape = "Cylinder",
				size = { 0.14, 0.34 - k * 0.06, 0.34 - k * 0.06 },
				pos = { 0, 0.68 + up, -0.62 - up * 0.45 },
				rot = { 25, 0, 90 },
				color = rgb(250, 245, 225),
				detail = true,
			})
		end
		table.insert(parts, {
			shape = "Ball",
			size = 0.12,
			pos = { 0, 0.68 + 0.68, -0.62 - 0.31 },
			color = rgb(190, 120, 255),
			material = "Neon",
			detail = true,
			shine = false,
		})
		return parts
	end,
}

-- Blinky: two little golden horns.
list.horns = {
	slot = "top",
	build = function()
		local parts: { any } = {}
		for _, side in { -1, 1 } do
			for k = 0, 3 do
				table.insert(parts, {
					shape = "Cylinder",
					size = { 0.12, 0.26 - k * 0.055, 0.26 - k * 0.055 },
					pos = { side * (0.45 + k * 0.04), 0.85 + k * 0.1, 0 },
					rot = { 0, 0, 90 - side * 20 },
					color = rgb(255, 220, 120),
					detail = true,
				})
			end
		end
		return parts
	end,
}

-- Chuckles: a big red clown nose.
list.clownnose = {
	slot = "nose",
	build = function()
		return {
			{ shape = "Ball", size = 0.36, pos = { 0, -0.08, front(0, -0.08) - 0.08 }, color = rgb(235, 30, 40) },
		}
	end,
}

-- Flexo: a sporty sweatband round the forehead.
list.sweatband = {
	slot = "forehead",
	build = function()
		return {
			{
				shape = "Cylinder",
				size = { 0.2, 1.9, 1.9 },
				pos = { 0, 0.42, 0 },
				rot = { 0, 0, 90 },
				color = rgb(255, 255, 255),
			},
			{
				shape = "Cylinder",
				size = { 0.06, 1.92, 1.92 },
				pos = { 0, 0.47, 0 },
				rot = { 0, 0, 90 },
				color = rgb(230, 40, 50),
			},
			{
				shape = "Cylinder",
				size = { 0.06, 1.92, 1.92 },
				pos = { 0, 0.37, 0 },
				rot = { 0, 0, 90 },
				color = rgb(230, 40, 50),
			},
		}
	end,
}

-- Mumbles: a bandage wrapped round the forehead with a loose end.
list.bandage = {
	slot = "forehead",
	build = function()
		local cloth = rgb(240, 232, 205)
		return {
			{ shape = "Cylinder", size = { 0.24, 1.92, 1.92 }, pos = { 0, 0.4, 0 }, rot = { 0, 0, 82 }, color = cloth },
			{
				shape = "Block",
				size = { 0.2, 0.5, 0.06 },
				pos = { 0.55, 0.15, 0.78 },
				rot = { 0, 0, -20 },
				color = cloth,
			},
		}
	end,
}

-- Boo-Boo: a spooky witch hat.
list.witchhat = {
	slot = "top",
	build = function()
		local purple = rgb(110, 50, 170)
		local parts: { any } = {
			{ shape = "Cylinder", size = { 0.08, 1.4, 1.4 }, pos = { 0, 0.85, 0 }, rot = { 0, 0, 90 }, color = purple },
			{
				shape = "Cylinder",
				size = { 0.14, 0.86, 0.86 },
				pos = { 0, 0.95, 0 },
				rot = { 0, 0, 90 },
				color = rgb(255, 150, 40),
			},
		}
		for k = 0, 5 do
			table.insert(parts, {
				shape = "Cylinder",
				size = { 0.2, 0.8 - k * 0.13, 0.8 - k * 0.13 },
				pos = { k * 0.035, 1.05 + k * 0.18, k * 0.02 },
				rot = { 0, 0, 90 - k * 4 },
				color = purple,
			})
		end
		return parts
	end,
}

-- Zomboy: bolts sticking out of the sides of the head.
list.bolts = {
	slot = "sides",
	build = function()
		local parts: { any } = {}
		for _, side in { -1, 1 } do
			table.insert(parts, {
				shape = "Cylinder",
				size = { 0.4, 0.16, 0.16 },
				pos = { side * 1.0, -0.25, 0 },
				color = rgb(150, 155, 165),
				material = "Metal",
				detail = true,
			})
			table.insert(parts, {
				shape = "Cylinder",
				size = { 0.12, 0.3, 0.3 },
				pos = { side * 1.2, -0.25, 0 },
				color = rgb(120, 125, 135),
				material = "Metal",
				detail = true,
			})
		end
		return parts
	end,
}

-- Stormy: a crackling neon lightning bolt clipped on top.
list.lightning = {
	slot = "top",
	build = function()
		local bolt = rgb(255, 230, 60)
		return {
			{
				shape = "Block",
				size = { 0.18, 0.42, 0.12 },
				pos = { 0.5, 1.12, -0.1 },
				rot = { 0, 0, 28 },
				color = bolt,
				material = "Neon",
				detail = true,
			},
			{
				shape = "Block",
				size = { 0.18, 0.42, 0.12 },
				pos = { 0.42, 0.84, -0.1 },
				rot = { 0, 0, -30 },
				color = bolt,
				material = "Neon",
				detail = true,
			},
			{
				shape = "Block",
				size = { 0.18, 0.36, 0.12 },
				pos = { 0.5, 0.58, -0.1 },
				rot = { 0, 0, 28 },
				color = bolt,
				material = "Neon",
				detail = true,
			},
		}
	end,
}

-- Neck accessories (the origin is the neck, under a radius-1 head).

-- Woofles: a red collar with a gold tag.
list.collar = {
	slot = "neck",
	build = function()
		return {
			{
				shape = "Cylinder",
				size = { 0.24, 1.6, 1.6 },
				pos = { 0, 0, 0 },
				rot = { 0, 0, 90 },
				color = rgb(225, 40, 55),
			},
			{
				shape = "Cylinder",
				size = { 0.08, 0.34, 0.34 },
				pos = { 0, -0.24, -0.8 },
				rot = { 0, 90, 0 },
				color = GOLD,
				material = "Foil",
			},
		}
	end,
}

-- Whiskerz: a pink ribbon with a gold bell.
list.bell = {
	slot = "neck",
	build = function()
		return {
			{
				shape = "Cylinder",
				size = { 0.2, 1.55, 1.55 },
				pos = { 0, 0, 0 },
				rot = { 0, 0, 90 },
				color = rgb(255, 120, 170),
			},
			{ shape = "Ball", size = 0.36, pos = { 0, -0.22, -0.8 }, color = GOLD, material = "Foil" },
			{
				shape = "Block",
				size = { 0.16, 0.04, 0.04 },
				pos = { 0, -0.27, -0.97 },
				color = rgb(60, 40, 20),
				detail = true,
			},
		}
	end,
}

-- Count Fangula: a tall popped cape collar, black outside and red inside.
list.capecollar = {
	slot = "neck",
	build = function()
		local parts: { any } = {}
		for _, side in { -1, 1 } do
			table.insert(parts, {
				shape = "Wedge",
				size = { 0.08, 0.9, 0.7 },
				pos = { side * 0.55, 0.35, 0.25 },
				rot = { 0, side * 50, 0 },
				color = rgb(25, 20, 30),
			})
			table.insert(parts, {
				shape = "Wedge",
				size = { 0.06, 0.8, 0.6 },
				pos = { side * 0.5, 0.33, 0.2 },
				rot = { 0, side * 50, 0 },
				color = rgb(200, 30, 45),
			})
		end
		table.insert(parts, {
			shape = "Cylinder",
			size = { 0.2, 1.45, 1.45 },
			pos = { 0, 0, 0 },
			rot = { 0, 0, 90 },
			color = rgb(25, 20, 30),
		})
		return parts
	end,
}

-- Howlz: a black spiked collar.
list.spikedcollar = {
	slot = "neck",
	build = function()
		local parts: { any } = {
			{
				shape = "Cylinder",
				size = { 0.26, 1.6, 1.6 },
				pos = { 0, 0, 0 },
				rot = { 0, 0, 90 },
				color = rgb(30, 30, 38),
			},
		}
		for k = 0, 7 do
			local a = k / 8 * math.pi * 2
			table.insert(parts, {
				shape = "Ball",
				size = 0.18,
				pos = { math.cos(a) * 0.82, 0, math.sin(a) * 0.82 },
				color = rgb(210, 215, 225),
				material = "Metal",
			})
		end
		return parts
	end,
}

Accessories.list = list

-- Adds accessory `id` to a Freeks.luau part list, for a head of radius r centred at
-- `center` (or round a neck point, for a neck accessory).
function Accessories.put(add, id: string, center: { number }, r: number)
	local accessory = list[id]
	if not accessory then
		return
	end
	for _, spec in accessory.build() do
		local copy = table.clone(spec)
		copy.pos = { center[1] + spec.pos[1] * r, center[2] + spec.pos[2] * r, center[3] + spec.pos[3] * r }
		if type(spec.size) == "number" then
			copy.size = spec.size * r
		else
			copy.size = { spec.size[1] * r, spec.size[2] * r, spec.size[3] * r }
		end
		if accessory.slot == "neck" then
			copy.onHead = false -- stays on the body when the head turns
		end
		add(copy)
	end
end

return Accessories
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">BoxModel</string>
          <string name="Source"><![CDATA[-- Mystery Box models: a chunky gift box in the box's colour with a ribbon, a big bow and
-- glowing question marks on its sides. BoxModel.build(crateId) returns the model (standing
-- on its pivot, PrimaryPart = the box) and its height.

local Luck = require(script.Parent.Luck)

local BoxModel = {}

local function part(model: Model, props)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "ClassName" then
			p[key] = value
		end
	end
	p.Parent = model
	return p
end

-- A chunky "?" made of blocks on a face, `cf` at the face's centre looking out of it.
local function questionMark(model: Model, cf: CFrame, s: number, color: Color3)
	local bits = {
		{ -0.35, 0.55, 0.3, 0.6 },
		{ 0, 0.8, 0.9, 0.3 },
		{ 0.35, 0.5, 0.3, 0.7 },
		{ 0.15, 0.15, 0.55, 0.3 },
		{ 0, -0.1, 0.3, 0.4 },
		{ 0, -0.7, 0.34, 0.34 },
	}
	for _, b in bits do
		part(model, {
			Size = Vector3.new(b[3] * s, b[4] * s, 0.15),
			CFrame = cf * CFrame.new(b[1] * s, b[2] * s, -0.05),
			Color = color,
			Material = Enum.Material.Neon,
		})
	end
end

function BoxModel.build(crateId: string): (Model, number)
	local crate = Luck.crateById[crateId] or Luck.CRATES[1]
	local tier = table.find(Luck.CRATES, crate) or 1
	local size = 3.2 + tier * 0.4
	local model = Instance.new("Model")
	model.Name = crate.id .. "Box"
	local color = crate.color
	local ribbon = if tier == 3 then Color3.fromRGB(230, 40, 70) else Color3.fromRGB(255, 255, 255)

	local box = part(model, {
		Name = "Box",
		Size = Vector3.new(size, size * 0.85, size),
		CFrame = CFrame.new(0, size * 0.425, 0),
		Color = color,
	})
	-- The model's pivot is the bottom of the box, so it stands on whatever it's put on.
	box.PivotOffset = CFrame.new(0, -size * 0.425, 0)
	model.PrimaryPart = box
	-- The lid, a bit wider.
	part(model, {
		Name = "Lid",
		Size = Vector3.new(size * 1.08, size * 0.22, size * 1.08),
		CFrame = CFrame.new(0, size * 0.85 + size * 0.1, 0),
		Color = color:Lerp(Color3.new(1, 1, 1), 0.12),
	})
	-- Ribbons round both ways.
	for _, rotation in { 0, math.pi / 2 } do
		part(model, {
			Size = Vector3.new(size * 0.22, size * 1.07, size * 1.1),
			CFrame = CFrame.new(0, size * 0.53, 0) * CFrame.Angles(0, rotation, 0),
			Color = ribbon,
		})
	end
	-- A bow: two loops and a knot.
	local top = size * 0.96 + size * 0.1
	for _, side in { -1, 1 } do
		local loop = part(model, {
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size * 0.42,
			CFrame = CFrame.new(side * size * 0.22, top + size * 0.12, 0),
			Color = ribbon,
		})
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = Vector3.new(1.2, 0.8, 0.6)
		mesh.Parent = loop
	end
	part(model, {
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * size * 0.24,
		CFrame = CFrame.new(0, top + size * 0.1, 0),
		Color = ribbon:Lerp(Color3.new(0, 0, 0), 0.1),
	})
	-- Glowing "?" on the four sides, in the quarters beside the ribbon.
	local mark = Color3.fromRGB(255, 255, 220)
	for k = 0, 3 do
		local face = CFrame.Angles(0, k * math.pi / 2, 0) * CFrame.new(size * 0.28, size * 0.42, -size / 2)
		questionMark(model, face, size * 0.3, mark)
	end
	if tier == 3 then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(255, 230, 120)
		sparkles.Parent = box
	end
	return model, top + size * 0.35
end

return BoxModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Bricks</string>
          <string name="Source"><![CDATA[-- Small helpers for building models out of parts (blocks, balls, cylinders, cones, wedges),
-- shared by the yard item and plant models. Every function takes the model to add to, the
-- size, where it goes and its colour (and optionally a material), and returns the part.

local Bricks = {}

function Bricks.rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

function Bricks.block(model: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if p.Material == Enum.Material.Glass then
		p.Transparency = 0.3
	end
	p.Parent = model
	return p
end

function Bricks.ball(model: Instance, size: Vector3 | number, cframe: CFrame, color: Color3, material: Enum.Material?)
	local vector = if typeof(size) == "number" then Vector3.one * size else size
	local p = Bricks.block(model, vector, cframe, color, material)
	if vector.X == vector.Y and vector.Y == vector.Z then
		p.Shape = Enum.PartType.Ball
	else
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	return p
end

-- A cylinder standing up with its base on `cframe`.
function Bricks.post(model: Instance, height: number, diameter: number, cframe: CFrame, color: Color3, material)
	local p = Bricks.block(
		model,
		Vector3.new(height, diameter, diameter),
		cframe * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
		color,
		material
	)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- A cylinder lying along the cframe's X axis, centred on it.
function Bricks.rod(model: Instance, length: number, diameter: number, cframe: CFrame, color: Color3, material)
	local p = Bricks.block(model, Vector3.new(length, diameter, diameter), cframe, color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- A cone of stacked discs standing on `cframe`.
function Bricks.cone(
	model: Instance,
	height: number,
	diameter: number,
	cframe: CFrame,
	color: Color3,
	material,
	steps: number?
)
	local n = steps or 5
	for i = 0, n - 1 do
		Bricks.post(
			model,
			height / n + 0.02,
			diameter * (1 - i / n),
			cframe * CFrame.new(0, i * height / n, 0),
			color,
			material
		)
	end
end

function Bricks.wedge(model: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?)
	local p = Instance.new("WedgePart")
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Parent = model
	return p
end

Bricks.RAINBOW = {
	Color3.fromRGB(255, 70, 90),
	Color3.fromRGB(255, 150, 40),
	Color3.fromRGB(255, 225, 50),
	Color3.fromRGB(80, 220, 100),
	Color3.fromRGB(60, 170, 255),
	Color3.fromRGB(150, 90, 255),
}

return Bricks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Tuning knobs for the whole game. Change numbers here, not in the services.

local Config = {
	BUILD = "life-15", -- shown small in the corner of the screen and in Output: which build is running
	START_MONEY = 50,
	-- TESTING ONLY: every player is topped up to this many coins when they join. Set to nil
	-- before the game launches!
	TEST_MONEY = 1_000_000,
	-- Who can open the admin panel (events, part spawns, announcements). Usernames are
	-- checked as well as user ids; anyone can use it in Studio for testing.
	ADMIN_NAMES = { "FuseAFreek" }, -- the owner's Roblox username
	ADMIN_USER_IDS = { 11813437895 } :: { number }, -- the owner's account
	MAX_PARTS = 40, -- house parts you can keep in your backpack (not counting the house)
	SELL_MULTIPLIER = 30, -- a part sells for (its money per second * this)

	-- The treadmill in your yard trains Speed while you run on it. Level 1 gives
	-- TREADMILL_BASE_GAIN speed a second; each level multiplies that by TREADMILL_GAIN_GROWTH.
	TREADMILL_BASE_GAIN = 2,
	TREADMILL_GAIN_GROWTH = 1.9,
	TREADMILL_BASE_COST = 150, -- coins for level 2
	TREADMILL_COST_GROWTH = 2.8,
	TREADMILL_MAX = 20,

	OFFLINE_RATE = 0.5, -- earn 50% of normal income while offline
	OFFLINE_MAX_SECONDS = 8 * 60 * 60, -- capped at 8 hours

	AUTOSAVE_INTERVAL = 60,
	SESSION_LOCK_TIMEOUT = 150, -- seconds before another server may take over a player's save

	PLOT_COUNT = 8, -- 4 homes each side of the street; set the place's Max Players to this

	GRAB_HOLD_SECONDS = 0.5, -- how long to hold the prompt to grab an egg in a zone
}

-- Speed a second from a treadmill of this level (before pass bonuses).
function Config.treadmillGain(level: number): number
	return Config.TREADMILL_BASE_GAIN * Config.TREADMILL_GAIN_GROWTH ^ (level - 1)
end

-- Coins to upgrade a treadmill from `level` to the next level.
function Config.treadmillCost(level: number): number
	return math.floor(Config.TREADMILL_BASE_COST * Config.TREADMILL_COST_GROWTH ^ (level - 1))
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">EggModel</string>
          <string name="Source"><![CDATA[-- The eggs you steal from the zones: plain egg shapes covered in LEGO studs, coloured by
-- what's inside. The shell is the item's main colour, and its second colour picks out a
-- pattern in the studs for its kind (spots for pets, a zig-zag band of grass for plants,
-- stripes for yard items, alternating rows like bricks for house parts). Legendary and up
-- get a gold band, Mystic and up a glowing one. Secret eggs glow and flash in every colour
-- (an aura round the shell and a light, tagged SECRET_TAG; each client animates them, see
-- Main). Without an item (the zone's egg in general, e.g. in the Shop) it's the zone's
-- colours (Items.ZONES eggColor / spotColor) with spots.
--
-- EggModel.build(zoneIndex, itemId?) returns the model (standing on its pivot, the bottom
-- of the egg; PrimaryPart = the shell) and its height.

local ItemModel = require(script.Parent.ItemModel)
local Items = require(script.Parent.Items)
local Rarities = require(script.Parent.Rarities)

local EggModel = {}

EggModel.SECRET_TAG = "SecretEgg"

local W, H = 2.6, 3.4 -- the shell's width and height
local GOLD = Color3.fromRGB(255, 205, 60)

local function part(model: Model, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		p[key] = value
	end
	p.Parent = model
	return p
end

local function egg(model: Model, size: Vector3, cframe: CFrame, color: Color3, material)
	local p = part(model, { Size = size, CFrame = cframe, Color = color, Material = material })
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function brightness(c: Color3): number
	return c.R * 0.3 + c.G * 0.59 + c.B * 0.11
end

-- The item's two main colours: the colours covering the most of it, by volume.
local function palette(model: Model): (Color3, Color3)
	local totals, colors = {}, {}
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p.Transparency < 0.5 then
			local key = string.format("%d,%d,%d", p.Color.R * 20, p.Color.G * 20, p.Color.B * 20)
			local s = p.Size
			totals[key] = (totals[key] or 0) + math.min(s.X * s.Y * s.Z, 60)
			colors[key] = p.Color
		end
	end
	local order = {}
	for key in totals do
		table.insert(order, key)
	end
	table.sort(order, function(a, b)
		return totals[a] > totals[b]
	end)
	local main = order[1] and colors[order[1]] or Color3.fromRGB(240, 240, 240)
	local second = nil
	for i = 2, #order do
		local c = colors[order[i]]
		local d = math.abs(c.R - main.R) + math.abs(c.G - main.G) + math.abs(c.B - main.B)
		if d > 0.35 then
			second = c
			break
		end
	end
	if not second then
		-- One-colour items get a lighter or darker shade for their pattern.
		second = if brightness(main) > 0.6
			then main:Lerp(Color3.new(0, 0, 0), 0.35)
			else main:Lerp(Color3.new(1, 1, 1), 0.45)
	end
	return main, second
end

-- The pattern on the shell, by what kind of thing is inside.
local STUD = 0.42 -- stud diameter
local STUD_HEIGHT = 0.12 -- how far a stud stands out of the shell
local STUD_GAP = 0.66 -- distance between stud centres

-- Covers the shell in rows of studs. Each stud's colour comes from `colorAt(ring, rings,
-- angle, y)` (ring 1 is the lowest; y is -1 at the bottom to 1 at the top).
local function studs(model: Model, colorAt: (number, number, number, number) -> Color3, skipY: number?)
	local rings = 11
	for ring = 1, rings do
		local phi = math.rad(-72 + (ring - 1) * 144 / (rings - 1)) -- latitude, bottom to top
		local y = math.sin(phi)
		if skipY and math.abs(y - skipY) < 0.12 then
			continue -- leave room for the band
		end
		local r = math.cos(phi) * W / 2
		local count = math.max(3, math.floor(2 * math.pi * r / STUD_GAP))
		local twist = (ring % 2) * 0.5
		for k = 0, count - 1 do
			local a = (k + twist) / count * math.pi * 2
			local spot = Vector3.new(math.cos(a) * r, H / 2 + y * H / 2, math.sin(a) * r)
			-- The shell's surface normal there (it's an ellipsoid).
			local normal = Vector3.new(spot.X / (W / 2) ^ 2, (spot.Y - H / 2) / (H / 2) ^ 2, spot.Z / (W / 2) ^ 2).Unit
			local stud = part(model, {
				Name = "Stud",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(STUD_HEIGHT * 2, STUD, STUD),
				-- The cylinder's axis (its X) points out of the shell; half of it is inside.
				CFrame = CFrame.lookAt(spot, spot + normal) * CFrame.Angles(0, math.pi / 2, 0),
				Color = colorAt(ring, rings, a, y),
			})
			stud.CastShadow = false
		end
	end
	-- One on the very top.
	part(model, {
		Name = "Stud",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(STUD_HEIGHT * 2, STUD, STUD),
		CFrame = CFrame.new(0, H, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = colorAt(rings + 1, rings, 0, 1),
	})
end

-- How the studs are coloured for each kind of item: the pattern, in the second colour.
local function patternFor(kind: string?, main: Color3, second: Color3, rng: Random)
	local stud = main:Lerp(Color3.new(1, 1, 1), 0.1) -- plain studs, a touch lighter than the shell
	if kind == "Yard" then
		return function(ring)
			return if ring == 3 or ring == 6 then second else stud
		end
	elseif kind == "House" then
		return function(ring)
			return if ring % 2 == 0 then second else stud
		end
	elseif kind == "Plant" then
		return function(_ring, _rings, a, y)
			-- A zig-zag band of grass round the bottom.
			local edge = -0.35 + 0.22 * math.abs(math.sin(a * 3))
			return if y < edge then second else stud
		end
	end
	-- Spots: a few round patches of the second colour.
	local centres = {}
	for _ = 1, 5 do
		table.insert(centres, { a = rng:NextNumber() * math.pi * 2, y = rng:NextNumber(-0.7, 0.7) })
	end
	return function(_ring, _rings, a, y)
		for _, c in centres do
			local da = math.abs((a - c.a + math.pi) % (2 * math.pi) - math.pi)
			if da * da * 0.5 + (y - c.y) ^ 2 < 0.16 then
				return second
			end
		end
		return stud
	end
end

function EggModel.build(zoneIndex: number, itemId: string?): (Model, number)
	local zone = Items.ZONES[zoneIndex] or Items.ZONES[1]
	local info = itemId and Items.byId[itemId]
	local model = Instance.new("Model")
	model.Name = "Egg"
	model:SetAttribute("Zone", zoneIndex)
	if info then
		model:SetAttribute("Item", itemId)
	end

	local main, second = zone.eggColor, zone.spotColor
	if info then
		local sample = ItemModel.buildNormal(itemId)
		main, second = palette(sample)
		sample:Destroy()
	end
	local shell = egg(model, Vector3.new(W, H, W), CFrame.new(0, H / 2, 0), main)
	shell.Name = "Shell"
	-- The model's pivot is the bottom of the egg, so it stands on whatever it's put on.
	shell.PivotOffset = CFrame.new(0, -H / 2, 0)
	model.PrimaryPart = shell

	local rank = Rarities.rank[if info then info.rarity else "Common"] or 1
	local banded = (info and rank >= Rarities.rank.Legendary) or (not info and zoneIndex >= 5)
	local rng = Random.new(if itemId then #itemId * 131 + zoneIndex else zoneIndex * 97)
	studs(model, patternFor(info and info.kind, main, second, rng), if banded then -0.08 else nil)

	if banded then
		-- A band round the middle: gold, or glowing in the rarity's colour for Mystic and up.
		local glowing = info and rank >= Rarities.rank.Mystic
		local band = part(model, {
			Shape = Enum.PartType.Cylinder,
			CFrame = CFrame.new(0, H * 0.46, 0) * CFrame.Angles(0, 0, math.pi / 2),
			Size = Vector3.new(0.5, W * 1.08, W * 1.08),
			Color = if glowing then Rarities.info[info.rarity].color else GOLD,
			Material = if glowing then Enum.Material.Neon else Enum.Material.Foil,
		})
		band.Name = "Band"
	end

	local top = H + 0.15
	if info and info.rarity == "Secret" then
		-- A glowing aura round the shell, a light and sparkles; clients make them flash.
		local glow = egg(
			model,
			Vector3.new(W, H, W) * 1.18,
			CFrame.new(0, H / 2, 0),
			Rarities.info.Secret.color,
			Enum.Material.Neon
		)
		glow.Name = "SecretGlow"
		glow.Transparency = 0.55
		glow.CastShadow = false
		local light = Instance.new("PointLight")
		light.Name = "SecretLight"
		light.Range = 14
		light.Brightness = 3
		light.Color = Rarities.info.Secret.color
		light.Parent = shell
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(255, 255, 255)
		sparkles.Parent = glow
		model:SetAttribute("Secret", true)
		game:GetService("CollectionService"):AddTag(model, EggModel.SECRET_TAG)
	end
	return model, top
end

return EggModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Events</string>
          <string name="Source"><![CDATA[-- Scheduled events, like the "admin abuse" events of the big Roblox games.
--
--   * Big events (Guardian Nap) run on a weekly timetable, the same moment in every server:
--     the guardians get sleepy and slow, parts regrow faster and rarer parts turn up.
--   * Weather rolls in for a few minutes at half past most hours. While it lasts, parts on
--     houses can catch its mutation (Blood Moon -> Shadow, and so on), and new parts in the
--     zone piles often grow with it.
--
-- The timetable is worked out from the clock alone, so every server agrees without talking.
-- The admin panel can also start any event early, in one server or all of them (see
-- server/EventService). The server publishes what's running as ReplicatedStorage
-- attributes; Events.current() and Events.weather() read them on either side.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Luck = require(script.Parent.Luck)

local Events = {}

-- Big events.
Events.BIG = {
	GuardianNap = {
		name = "Guardian Nap",
		icon = "😴",
		description = "The guardians are sleepy! They run slower, parts regrow fast and rare parts turn up!",
		color = Color3.fromRGB(170, 110, 255),
		respawnBoost = 3, -- parts regrow this many times faster
		rareBoost = 4, -- rarer parts (the next zone's style) turn up this many times more often
		mutationBoost = 2,
		guardianSpeed = 0.75, -- guardians run at this fraction of their speed
	},
}

-- Weather: each one can give parts on houses (and new parts in the piles) its mutation.
Events.WEATHER = {
	BloodMoon = {
		name = "Blood Moon",
		icon = "🌕",
		description = "Parts can turn Shadow!",
		color = Color3.fromRGB(255, 70, 80),
		mutation = "Shadow",
		chance = 0.02, -- per part on a house, every WEATHER_TICK seconds
	},
	GoldRush = {
		name = "Gold Rush",
		icon = "✨",
		description = "Parts can turn Golden!",
		color = Color3.fromRGB(255, 205, 60),
		mutation = "Golden",
		chance = 0.012,
	},
	RainbowRain = {
		name = "Rainbow Rain",
		icon = "🌈",
		description = "Parts can turn Rainbow!",
		color = Color3.fromRGB(255, 120, 230),
		mutation = "Rainbow",
		chance = 0.004,
	},
}
Events.WEATHER_TICK = 20

-- The weekly timetable, in UTC (weekday 1 = Sunday). 19:00 UTC on Saturday is 3pm US
-- Eastern in summer time (2pm in winter).
Events.SCHEDULE = {
	{ id = "GuardianNap", weekday = 7, hour = 19, minute = 0, minutes = 30 }, -- Saturday
	{ id = "GuardianNap", weekday = 3, hour = 22, minute = 0, minutes = 30 }, -- Tuesday
}

-- Weather comes at WEATHER_MINUTE past the hour for WEATHER_MINUTES, picked from this
-- list (weights; "" = clear skies that hour).
Events.WEATHER_MINUTE = 30
Events.WEATHER_MINUTES = 10
Events.WEATHER_ODDS = {
	{ id = "BloodMoon", weight = 4 },
	{ id = "GoldRush", weight = 3 },
	{ id = "RainbowRain", weight = 1 },
	{ id = "", weight = 4 },
}

local DAY = 24 * 60 * 60

-- Every scheduled big event in the next week from time t (and any running now), soonest
-- first: { id, starts, ends }.
function Events.upcoming(t: number)
	local list = {}
	local midnight = t - t % DAY
	for day = -1, 7 do
		local dayStart = midnight + day * DAY
		local weekday = (os.date("!*t", dayStart) :: any).wday
		for _, slot in Events.SCHEDULE do
			if slot.weekday == weekday then
				local starts = dayStart + slot.hour * 3600 + slot.minute * 60
				local ends = starts + slot.minutes * 60
				if ends > t then
					table.insert(list, { id = slot.id, starts = starts, ends = ends })
				end
			end
		end
	end
	table.sort(list, function(a, b)
		return a.starts < b.starts
	end)
	return list
end

-- The scheduled big event running at time t, if any.
function Events.scheduledAt(t: number)
	local first = Events.upcoming(t)[1]
	if first and first.starts <= t then
		return first
	end
	return nil
end

-- The weather the timetable gives the hour containing t: { id, starts, ends } or nil.
function Events.weatherFor(hourIndex: number)
	local x = math.sin(hourIndex * 12.9898 + 78.233) * 43758.5453
	local roll = x - math.floor(x)
	local total = 0
	for _, entry in Events.WEATHER_ODDS do
		total += entry.weight
	end
	roll *= total
	for _, entry in Events.WEATHER_ODDS do
		roll -= entry.weight
		if roll <= 0 then
			if entry.id == "" then
				return nil
			end
			local starts = hourIndex * 3600 + Events.WEATHER_MINUTE * 60
			return { id = entry.id, starts = starts, ends = starts + Events.WEATHER_MINUTES * 60 }
		end
	end
	return nil
end

function Events.scheduledWeatherAt(t: number)
	local weather = Events.weatherFor(math.floor(t / 3600))
	if weather and weather.starts <= t and t < weather.ends then
		return weather
	end
	return nil
end

-- The next scheduled weather after t (looks a day ahead).
function Events.nextWeather(t: number)
	local hour = math.floor(t / 3600)
	for k = 0, 24 do
		local weather = Events.weatherFor(hour + k)
		if weather and weather.ends > t then
			return weather
		end
	end
	return nil
end

-- What's running now, from the attributes the server publishes.
function Events.current()
	local id = ReplicatedStorage:GetAttribute("Event")
	local ends = ReplicatedStorage:GetAttribute("EventEnds") or 0
	if id and Events.BIG[id] and Workspace:GetServerTimeNow() < ends then
		return Events.BIG[id], ends, id
	end
	return nil, 0, nil
end

function Events.weather()
	local id = ReplicatedStorage:GetAttribute("Weather")
	local ends = ReplicatedStorage:GetAttribute("WeatherEnds") or 0
	if id and Events.WEATHER[id] and Workspace:GetServerTimeNow() < ends then
		return Events.WEATHER[id], ends, id
	end
	return nil, 0, nil
end

-- A boost from everything running now (a Lucky Hour and a big event multiply together):
-- "respawnBoost", "rareBoost", "mutationBoost", "guardianSpeed" or "crateLuck".
function Events.boost(key: string): number
	local total = 1
	local lucky = Luck.current()
	if lucky and lucky[key] then
		total *= lucky[key]
	end
	local big = Events.current()
	if big and big[key] then
		total *= big[key]
	end
	return total
end

return Events
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx" }

function Format.money(n: number): string
	if n < 100 and n ~= math.floor(n) then
		-- Small fused incomes like $2.2/s.
		local text = string.format("%.1f", math.floor(n * 10) / 10):gsub("%.0$", "")
		return "$" .. text
	end
	n = math.floor(n)
	if n < 1000 then
		return "$" .. n
	end
	local i = 1
	local value = n
	while value >= 1000 and i < #SUFFIXES do
		value /= 1000
		i += 1
	end
	local text = string.format("%.1f", value):gsub("%.0$", "")
	return "$" .. text .. SUFFIXES[i]
end

-- A big number with a suffix and no "$" (Speed: 12.5K).
function Format.number(n: number): string
	return (string.gsub(Format.money(n), "^%$", ""))
end

-- A weight: "0.82 kg", "12.4 kg", "1,250 kg".
function Format.weight(kg: number): string
	if kg < 10 then
		return string.format("%.2f kg", kg)
	elseif kg < 100 then
		return string.format("%.1f kg", kg)
	end
	return Format.number(math.floor(kg + 0.5)) .. " kg"
end

function Format.time(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %dm", h, m)
	elseif m > 0 then
		return string.format("%dm %ds", m, s)
	end
	return string.format("%ds", s)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">FreekAnimator</string>
          <string name="Source"><![CDATA[-- Brings Freek models to life: idle animations for Freeks standing in barns and on the
-- reveal stage, and walk cycles for Freeks roaming the map.
--
-- Idle, a Freek breathes, blinks, looks around (turning and tilting its head), wags its
-- tail, twitches its ears, flutters its wings, waves now and then, and every so often does
-- a happy hop. Walking, it steps with its own gait (see WALKS): legs and arms swing, the
-- body bobs, rocks and squashes on each footfall, the head nods, ears bounce and the tail
-- sways. Everything is worked out from the time alone, so the same Freek at the same
-- moment always strikes the same pose, and a renderer can draw any frame.
--
-- FreekModel tags the parts that move: SwingHinge (legs, arms, tails, wings), OnHead,
-- Eye/EyeWhite, and Rig = "ear" | "arm".
--
-- Usage:
--   local rig = FreekAnimator.rig(model)          -- once per model
--   FreekAnimator.pose(rig, groundCFrame, t)       -- every frame, idle
--   FreekAnimator.pose(rig, groundCFrame, t, true) -- every frame, walking

local Workspace = game:GetService("Workspace")

local FreekAnimator = {}

-- How each kind of Freek walks: steps per second (speed, radians), how high it bobs, how
-- much it rocks side to side (roll) and turns from side to side (yaw), and how far its legs
-- swing (degrees); plus how much it leans forward, nods its head and squashes on each step.
-- Set per species with `walk` in Freeks.luau.
FreekAnimator.WALKS = {
	waddle = { speed = 9, bob = 0.25, roll = 7, yaw = 0, legs = 30, lean = 3, nod = 5, squash = 0.05 },
	trot = { speed = 12, bob = 0.35, roll = 3, yaw = 0, legs = 35, lean = 5, nod = 7, squash = 0.04 },
	prowl = { speed = 8, bob = 0.08, roll = 2, yaw = 4, legs = 28, lean = 2, nod = 3, squash = 0.02 },
	slither = { speed = 9, bob = 0, roll = 0, yaw = 10, legs = 40, lean = 0, nod = 2, squash = 0.02 },
	stomp = { speed = 6, bob = 0.35, roll = 4, yaw = 0, legs = 25, lean = 4, nod = 6, squash = 0.07 },
	flap = { speed = 9, bob = 0.5, roll = 8, yaw = 0, legs = 30, lean = 6, nod = 6, squash = 0.04 },
	bounce = { speed = 7, bob = 1, roll = 6, yaw = 0, legs = 30, lean = 0, nod = 4, squash = 0.12, hop = true },
	strut = { speed = 10, bob = 0.25, roll = 2, yaw = 5, legs = 35, lean = -2, nod = 6, squash = 0.03 },
	catwalk = { speed = 9, bob = 0.15, roll = 0, yaw = 9, legs = 30, lean = -3, nod = 3, squash = 0.02 },
	shamble = { speed = 5, bob = 0.15, roll = 9, yaw = 3, legs = 22, lean = 9, nod = 10, squash = 0.03 },
	float = { speed = 3, bob = 0.7, roll = 4, yaw = 0, legs = 30, lean = 4, nod = 3, squash = 0, float = true },
}

local TAU = math.pi * 2

local function axisRotation(axis: string, angle: number): CFrame
	if axis == "Y" then
		return CFrame.Angles(0, angle, 0)
	elseif axis == "Z" then
		return CFrame.Angles(0, 0, angle)
	end
	return CFrame.Angles(angle, 0, 0)
end

-- A repeatable pseudo-random number in [0, 1) for a whole number n and a Freek's seed.
local function hash(n: number, seed: number): number
	local x = math.sin(n * 127.1 + seed * 311.7) * 43758.5453
	return x - math.floor(x)
end

local function smooth(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

-- A short event that happens every `period` seconds (shifted by `shift`) and lasts
-- `length`: returns how far through it we are (0..1), or nil between events.
local function event(t: number, period: number, length: number, shift: number): number?
	local into = (t + shift) % period
	if into < length then
		return into / length
	end
	return nil
end

export type Rig = {
	model: Model,
	home: CFrame,
	seedArg: number?,
	dirty: boolean,
	added: RBXScriptConnection,
	childCount: number,
	nextCheck: number,
	walk: any,
	seed: number,
	parts: { BasePart },
	rest: { CFrame },
	sizes: { Vector3 },
	moves: { any },
	neck: CFrame?,
	eyes: { any },
	body: BasePart?,
	bodyIndex: number,
	hasHead: boolean,
	blinking: boolean,
	squashed: boolean,
}

-- Collects what moves on a model. Returns nil for a model with no parts.
-- `home` is where the server put the model (its pivot there); it defaults to where the model
-- is now. Parts are measured from it, so parts that arrive late (a big model can reach a
-- client a few parts at a time) are picked up at their right place, and none are left
-- behind on the ground.
function FreekAnimator.rig(model: Model, seed: number?, home: CFrame?): Rig?
	if not model.PrimaryPart then
		return nil
	end
	local pivot = home or model:GetPivot()
	local rig = {
		home = pivot,
		seedArg = seed,
		dirty = false,
		model = model,
		walk = FreekAnimator.WALKS[model:GetAttribute("Walk")] or FreekAnimator.WALKS.waddle,
		seed = 0,
		parts = {},
		rest = {},
		sizes = {},
		moves = {},
		eyes = {},
		body = model.PrimaryPart,
		bodyIndex = 1,
		hasHead = false,
		blinking = false,
		squashed = false,
	}
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		-- The head turns about the bottom of the neck, a little behind its centre.
		local radius = math.max(head.Size.X, head.Size.Y, head.Size.Z) / 2
		local center = pivot:PointToObjectSpace(head.CFrame.Position)
		rig.neck = CFrame.new(center + Vector3.new(0, -radius * 0.8, radius * 0.25))
		rig.hasHead = true
	end
	local eyeIndex = {}
	for _, part in model:GetDescendants() do
		if not part:IsA("BasePart") then
			continue
		end
		table.insert(rig.parts, part)
		local i = #rig.parts
		rig.rest[i] = pivot:ToObjectSpace(part.CFrame)
		rig.sizes[i] = part.Size
		if part == rig.body then
			rig.bodyIndex = i
		end
		local move = {}
		local hinge = part:GetAttribute("SwingHinge")
		if typeof(hinge) == "Vector3" then
			local axis = part:GetAttribute("SwingAxis") or "X"
			move.hinge = CFrame.new(hinge)
			move.phase = (part:GetAttribute("SwingPhase") or 0) * TAU
			move.axis = axis
			move.amount = part:GetAttribute("SwingAmount") or 1
			move.kind = if axis == "Y" then "tail" elseif axis == "Z" then "wing" else "leg"
		end
		local role = part:GetAttribute("Rig")
		if role == "arm" then
			move.kind = "arm"
			move.side = part:GetAttribute("RigSide") or 1
		elseif role == "ear" then
			local point = part:GetAttribute("RigPivot")
			move.ear = CFrame.new(if typeof(point) == "Vector3" then point else rig.rest[i].Position)
			move.side = part:GetAttribute("RigSide") or 1
		end
		move.onHead = rig.hasHead and part:GetAttribute("OnHead") == true
		local eye = part:GetAttribute("Eye")
		if eye then
			local group = eyeIndex[eye]
			if not group then
				group = { members = {} }
				eyeIndex[eye] = group
				table.insert(rig.eyes, group)
			end
			table.insert(group.members, i)
			if part:GetAttribute("EyeWhite") then
				group.white = i
			end
		end
		rig.moves[i] = move
	end
	for _, group in rig.eyes do
		local white = group.white or group.members[1]
		local rest, size = rig.rest[white], rig.sizes[white]
		-- Eyes close toward a line a little below their middle, like lids coming down.
		group.center = rest.Position - Vector3.new(0, size.Y * 0.12, 0)
	end
	rig.seed = seed or (model:GetAttribute("Seed") or (pivot.Position.X * 0.37 + pivot.Position.Z * 0.61))
	rig.seed = (rig.seed % 97) / 97
	rig.childCount = #model:GetChildren()
	rig.nextCheck = os.clock() + 1
	rig.added = model.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then
			rig.dirty = true
		end
	end)
	return rig :: any
end

-- Some parts arrived after the rig was made: put every part back where the server has it
-- and measure the whole model again.
local function refresh(rig)
	for i, part in rig.parts do
		if part.Parent then
			part.Size = rig.sizes[i]
			part.CFrame = rig.home * rig.rest[i]
		end
	end
	rig.added:Disconnect()
	local fresh = FreekAnimator.rig(rig.model, rig.seedArg, rig.home)
	if fresh then
		for key, value in fresh :: any do
			rig[key] = value
		end
	else
		rig.dirty = false
	end
end

-- How open the eyes are (1 open, 0 shut) at time t.
local function eyesOpen(t: number, seed: number): number
	local period = 2.6 + seed * 2.4
	local cycle = math.floor((t + seed * 10) / period)
	local into = (t + seed * 10) % period
	local open = 1
	local blink = 0.16
	if into < blink then
		open = 1 - math.sin(into / blink * math.pi)
	elseif hash(cycle, seed) < 0.3 and into > 0.24 and into < 0.24 + blink then
		-- Sometimes a quick double blink.
		open = 1 - math.sin((into - 0.24) / blink * math.pi)
	end
	return open
end

-- Where the head is looking at time t: yaw, pitch, roll (radians). It glances somewhere,
-- holds it, then glances somewhere else; now and then it tilts its head, curious.
local function headLook(t: number, seed: number): (number, number, number)
	local hold = 2.2 + seed * 1.3
	local shifted = t + seed * 7
	local index = math.floor(shifted / hold)
	local into = shifted % hold
	local function target(n: number)
		local yaw = (hash(n, seed) - 0.5) * math.rad(46)
		local pitch = (hash(n + 0.5, seed) - 0.4) * math.rad(18)
		local roll = if hash(n + 0.25, seed) < 0.3 then (hash(n + 0.75, seed) - 0.5) * math.rad(36) else 0
		if hash(n + 0.9, seed) < 0.25 then
			yaw, pitch = 0, -math.rad(4) -- looking straight at you
		end
		return yaw, pitch, roll
	end
	local y0, p0, r0 = target(index - 1)
	local y1, p1, r1 = target(index)
	local a = smooth(into / 0.45)
	return y0 + (y1 - y0) * a, p0 + (p1 - p0) * a, r0 + (r1 - r0) * a
end

local function checkArrivals(rig)
	-- Also count the parts now and then, in case an arrival was missed.
	local now = os.clock()
	if now >= rig.nextCheck then
		rig.nextCheck = now + 1
		if #rig.model:GetChildren() ~= rig.childCount then
			rig.dirty = true
		end
	end
	if rig.dirty then
		refresh(rig)
	end
end

-- Stands the model at `cframe` exactly as built (no pose), e.g. while it flies.
function FreekAnimator.place(rig: Rig, cframe: CFrame)
	checkArrivals(rig)
	local cframes = table.create(#rig.parts)
	local resize = rig.blinking or rig.squashed
	for i, part in rig.parts do
		if resize then
			part.Size = rig.sizes[i]
		end
		cframes[i] = cframe * rig.rest[i]
	end
	local ok = pcall(function()
		Workspace:BulkMoveTo(rig.parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end)
	if not ok then
		for i, part in rig.parts do
			part.CFrame = cframes[i]
		end
	end
	rig.blinking, rig.squashed = false, false
end

-- Works out the pose for time t and moves the model there, standing at `ground`.
function FreekAnimator.pose(rig: Rig, ground: CFrame, t: number, walking: boolean?)
	checkArrivals(rig)
	local walk = rig.walk
	local seed = rig.seed
	t += seed * 31

	-- The whole body: bob, rock, lean, hop, and squash (sy up, sx out to the sides).
	local root = CFrame.identity
	local sy = 0
	local stepAngle = 0
	local yaw, pitch, roll = 0, 0, 0 -- the head
	local earAngle = 0
	local tailAngle, tailSpeed = 0, 0
	local wingAngle = 0
	local armWave = 0 -- 0..1, how far the waving arm is raised
	local hopping = false

	if walking then
		stepAngle = t * walk.speed
		local step = math.sin(stepAngle)
		local footfall = math.abs(math.cos(stepAngle)) -- 1 as a foot lands
		local lift = math.abs(step) * walk.bob
		root = CFrame.new(0, lift, 0)
			* CFrame.Angles(math.rad(-walk.lean), math.rad(step * walk.yaw), math.rad(step * walk.roll))
		if walk.float then
			root = CFrame.new(0, 0.6 + math.sin(t * 2) * 0.35, 0)
				* CFrame.Angles(math.rad(-walk.lean), 0, math.rad(math.sin(t * 1.5) * walk.roll))
		end
		sy = -footfall ^ 6 * walk.squash + (if walk.hop then math.abs(step) * walk.squash * 0.6 else 0)
		pitch = math.sin(stepAngle * 2) * math.rad(walk.nod)
		yaw = math.sin(t * 0.7 + seed * 5) * math.rad(10)
		earAngle = math.sin(stepAngle * 2 + 0.6) * math.rad(10)
		tailAngle, tailSpeed = math.rad(18), walk.speed
	else
		-- Breathing: a slow swell of the chest.
		local breath = math.sin(t * 2.2)
		sy = breath * 0.022
		-- A gentle sway from foot to foot.
		root = CFrame.Angles(0, math.sin(t * 0.5) * math.rad(4), math.sin(t * 1.1) * math.rad(1.5))
		if walk.float then
			root = CFrame.new(0, 0.6 + math.sin(t * 1.6) * 0.35, 0) * root
		end

		yaw, pitch, roll = headLook(t, seed)

		-- A happy hop every so often: crouch, spring up with a little spin, land and squash.
		local hop = event(t, 9 + seed * 5, 1.1, seed * 13)
		if hop then
			hopping = true
			if hop < 0.2 then
				sy = -smooth(hop / 0.2) * 0.12
			elseif hop < 0.75 then
				local air = (hop - 0.2) / 0.55
				root = CFrame.new(0, math.sin(air * math.pi) * 1.4, 0) * root
				sy = 0.1 * math.sin(air * math.pi)
				pitch -= math.rad(10)
			else
				local land = (hop - 0.75) / 0.25
				sy = -math.sin(land * math.pi) * 0.1
			end
		end

		-- Tail: always wagging a little, sometimes really going for it.
		local excited = event(t, 6 + seed * 4, 2.2, seed * 3)
		tailAngle = math.rad(10 + (if excited then math.sin(excited * math.pi) * 22 else 0))
		tailSpeed = if excited then 11 else 3

		-- Ears: a quick double flick now and then.
		local twitch = event(t, 4.5 + seed * 3, 0.45, seed * 17)
		if twitch then
			earAngle = math.sin(twitch * TAU * 2) * math.rad(18) * (1 - twitch)
		else
			earAngle = math.sin(t * 1.3) * math.rad(2)
		end

		-- Wings and flippers: a flutter now and then (and on every hop).
		local flutter = event(t, 7 + seed * 3, 0.9, seed * 23)
		if flutter or hopping then
			wingAngle = math.abs(math.sin(t * 22)) * math.rad(30)
		else
			wingAngle = (math.sin(t * 2.2) + 1) * math.rad(2)
		end

		-- A wave hello.
		local wave = event(t, 11 + seed * 6, 2.4, seed * 41)
		if wave then
			armWave = smooth(wave / 0.2) * smooth((1 - wave) / 0.2)
		end
		if hopping then
			armWave = math.max(armWave, 0.95) -- arms up: yay!
		end
	end

	local headTurn = rig.neck and (rig.neck * CFrame.fromOrientation(pitch, yaw, roll) * rig.neck:Inverse())
	local legSwing = math.rad(walk.legs)
	local base = ground * root
	local sx = -sy * 0.5
	local waveSide = if seed < 0.5 then 1 else -1

	local cframes = table.create(#rig.parts)
	for i = 1, #rig.parts do
		local local_ = rig.rest[i]
		local move = rig.moves[i]
		if move.hinge then
			local angle = 0
			if move.kind == "tail" then
				angle = math.sin(t * tailSpeed + move.phase) * tailAngle * move.amount
				if walking then
					angle += math.sin(stepAngle + move.phase) * legSwing * move.amount
				end
			elseif move.kind == "wing" then
				if walking then
					angle = math.sin(stepAngle + move.phase) * legSwing * move.amount
				else
					angle = wingAngle * move.amount
				end
			elseif walking then
				angle = math.sin(stepAngle + move.phase) * legSwing * move.amount
			elseif move.kind == "arm" then
				angle = math.sin(t * 1.2 + move.side) * math.rad(3)
			end
			local swing = move.hinge * axisRotation(move.axis, angle) * move.hinge:Inverse()
			local_ = swing * local_
			if move.kind == "arm" and armWave > 0 and (move.side == waveSide or hopping) then
				-- Raise the arm out to the side and wave the hand back and forth.
				local raise = armWave * math.rad(150) + math.sin(t * 12) * math.rad(18) * armWave
				local shoulder = move.hinge
				local_ = shoulder * CFrame.Angles(0, 0, move.side * raise) * shoulder:Inverse() * local_
			end
		end
		if move.ear then
			local_ = move.ear * CFrame.Angles(0, 0, -move.side * earAngle) * move.ear:Inverse() * local_
		end
		if move.onHead and headTurn then
			local_ = headTurn * local_
		end
		if sy ~= 0 then
			-- Squash and stretch about the feet: everything moves with the body's swell.
			local p = local_.Position
			local_ = local_ + Vector3.new(p.X * sx, p.Y * sy, p.Z * sx * 0.5)
		end
		cframes[i] = base * local_
	end

	-- Eyes squash shut to blink.
	local open = if walking then eyesOpen(t * 1.2, seed) else eyesOpen(t, seed)
	if open < 0.999 or rig.blinking then
		rig.blinking = open < 0.999
		local k = math.max(open, 0.08)
		for _, group in rig.eyes do
			for _, i in group.members do
				local part = rig.parts[i]
				local size = rig.sizes[i]
				part.Size = Vector3.new(size.X, size.Y * k, size.Z)
				-- Move it toward the closing line, in the head's frame.
				local rest = rig.rest[i]
				local offset = rest.Position - group.center
				local shut = CFrame.new(group.center + Vector3.new(offset.X, offset.Y * k, offset.Z)) * rest.Rotation
				local swung = shut
				if rig.moves[i].onHead and headTurn then
					swung = headTurn * swung
				end
				if sy ~= 0 then
					local p = swung.Position
					swung = swung + Vector3.new(p.X * sx, p.Y * sy, p.Z * sx * 0.5)
				end
				cframes[i] = base * swung
			end
		end
	end

	-- The body swells as it breathes.
	if rig.body and sy ~= 0 then
		local size = rig.sizes[rig.bodyIndex]
		rig.body.Size = Vector3.new(size.X * (1 + sx), size.Y * (1 + sy), size.Z * (1 + sx * 0.5))
		rig.squashed = true
	elseif rig.body and rig.squashed then
		rig.body.Size = rig.sizes[rig.bodyIndex]
		rig.squashed = false
	end

	local ok = pcall(function()
		Workspace:BulkMoveTo(rig.parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end)
	if not ok then
		for i, part in rig.parts do
			part.CFrame = cframes[i]
		end
	end
end

return FreekAnimator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">FreekModel</string>
          <string name="Source"><![CDATA[-- Builds the 3D model for a Freek out of plain parts.
-- The model's pivot sits at its feet and its face points along -Z (the model's front),
-- so model:PivotTo(groundCFrame) stands it on the ground facing groundCFrame.LookVector.
--
-- A Freek's look is either:
--   * a part list (look.parts, look.effects), for designed Freeks; see buildFromParts, or
--   * the simple generator (look.shape/size/eyes/antennae), for placeholders.
-- A Model in ReplicatedStorage.FreekModels named after the species id overrides both.
--
-- Part list format, in studs, with y = 0 at the ground and the face toward -Z:
--   { shape = "Ball" | "Ellipsoid" | "Block" | "Cylinder" | "Wedge", size = { x, y, z } (or one number),
--     pos = { x, y, z }, rot = { x, y, z } (degrees, optional), color = Color3,
--     material = "Neon" etc. (optional), transparency = 0-1 (optional),
--     detail = true (optional: keeps its color when mutated, e.g. eyes),
--     shine = false (optional: no sparkle highlights on a dark detail ball),
--     swing = { hinge = {x, y, z}, phase = 0..1, axis = "X" | "Y" | "Z", amount = 1 }
--       (optional: the part swings around the hinge while the Freek walks, e.g. legs;
--       axis "Y" swings are tails and wag when idle, axis "Z" swings are wings or flippers),
--     rig = "ear" | "arm" (optional: an ear that twitches, or an arm that waves, when idle),
--     side = -1 | 1, pivot = { x, y, z } (for rig parts: which side, and where it bends),
--     onHead = false (optional: stays put when the head turns, e.g. a collar) }
-- A part named "Head" turns to look around, with everything on it; eyes (white detail
-- balls with an iris and pupil in front) blink. See FreekAnimator.
-- A species' walk = "waddle" | "trot" | ... picks how it moves (see the client).
-- The first part is the main body. Effects:
--   { type = "Sparkles" | "Fire" | "Smoke" | "Glow", part = index (default 1), color = Color3,
--     size = number (optional) }

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Accessories = require(script.Parent.Accessories)
local Freeks = require(script.Parent.Freeks)
local Mutations = require(script.Parent.Mutations)

local FreekModel = {}

FreekModel.RAINBOW_TAG = "RainbowFreek"

local function newPart(props): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		part[key] = value
	end
	return part
end

local function ball(size: number, color: Color3, position: Vector3): Part
	return newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * size,
		Color = color,
		CFrame = CFrame.new(position),
	})
end

local EYE_LAYOUTS = {
	[1] = { size = 0.42, xs = { 0 } },
	[2] = { size = 0.28, xs = { -0.2, 0.2 } },
	[3] = { size = 0.22, xs = { -0.27, 0, 0.27 } },
}

local SHAPES = {
	Ball = Enum.PartType.Ball,
	Block = Enum.PartType.Block,
	Cylinder = Enum.PartType.Cylinder,
}

local function vector(value): Vector3
	if type(value) == "number" then
		return Vector3.one * value
	end
	return Vector3.new(value[1], value[2], value[3])
end

local polish
local tagRig

local function addEffect(part: BasePart, effect)
	local kind = effect.type
	local color = effect.color or Color3.fromRGB(255, 230, 120)
	local instance
	if kind == "Sparkles" then
		instance = Instance.new("Sparkles")
		instance.SparkleColor = color
	elseif kind == "Fire" then
		instance = Instance.new("Fire")
		instance.Color = color
		instance.SecondaryColor = effect.color2 or Color3.fromRGB(255, 220, 80)
		instance.Size = effect.size or 5
		instance.Heat = effect.heat or 9
	elseif kind == "Smoke" then
		instance = Instance.new("Smoke")
		instance.Color = color
		instance.Size = effect.size or 2
		instance.Opacity = 0.3
		instance.RiseVelocity = 2
	elseif kind == "Glow" then
		instance = Instance.new("PointLight")
		instance.Color = color
		instance.Range = effect.size or 10
		instance.Brightness = 2
	else
		warn("Unknown Freek effect " .. tostring(kind))
		return
	end
	instance.Parent = part
end

-- The finishing touches every designed Freek gets, in the style of today's popular Roblox
-- pets: two sparkle highlights on every pupil and nose (small dark balls marked detail),
-- and a soft glossy sheen on round bodies and heads, like a vinyl toy.
local function luminance(c: Color3): number
	return c.R * 0.3 + c.G * 0.59 + c.B * 0.11
end

function polish(model: Model, specs, parts)
	for i, spec in specs do
		local part = parts[i]
		local shape = spec.shape or "Block"
		local size = part.Size
		if
			spec.detail
			and shape == "Ball"
			and spec.shine ~= false
			and size.X <= 0.9
			and luminance(part.Color) < 0.16
		then
			-- Catchlights sit on the front of the pupil, up and to the side, like light from above.
			local r = size.X / 2
			for k, light in { { 0.42, -0.38, 0.42 }, { 0.2, 0.32, -0.25 } } do
				local dot = newPart({
					Name = "Sparkle",
					Shape = Enum.PartType.Ball,
					Size = Vector3.one * size.X * light[1],
					Color = Color3.new(1, 1, 1),
					CFrame = part.CFrame * CFrame.new(light[2] * r, light[3] * r, -r * 0.82),
					CanQuery = false,
				})
				if k == 2 then
					dot.Transparency = 0.15
				end
				dot:SetAttribute("Rig", part:GetAttribute("Rig"))
				local swing = part:GetAttribute("SwingHinge")
				if swing then
					dot:SetAttribute("SwingHinge", swing)
					dot:SetAttribute("SwingPhase", part:GetAttribute("SwingPhase"))
					dot:SetAttribute("SwingAxis", part:GetAttribute("SwingAxis"))
					dot:SetAttribute("SwingAmount", part:GetAttribute("SwingAmount"))
				end
				dot.Parent = model
			end
		elseif
			(spec.name == "Body" or spec.name == "Head" or i == 1)
			and (shape == "Ball" or shape == "Ellipsoid")
			and spec.gloss ~= false
		then
			-- A soft sheen high on the front, like light catching a shiny toy.
			local half = if shape == "Ball" then Vector3.one * math.min(size.X, size.Y, size.Z) / 2 else size / 2
			local sheen = newPart({
				Name = "Sheen",
				Shape = Enum.PartType.Block,
				Size = Vector3.new(half.X * 0.7, half.Y * 0.38, half.Z * 0.2),
				Color = Color3.new(1, 1, 1),
				Transparency = 0.72,
				CFrame = part.CFrame
					* CFrame.new(-half.X * 0.32, half.Y * 0.6, -half.Z * 0.62)
					* CFrame.Angles(math.rad(-35), math.rad(-25), 0),
				CanQuery = false,
				CastShadow = false,
			})
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = sheen
			sheen.Parent = model
		end
	end
end

-- Marks what moves when the Freek is idle (see FreekAnimator): everything on its head gets
-- OnHead, and each eye (a white detail ball or ellipsoid with the parts in front of it)
-- gets an Eye number, with EyeWhite on the white. Round eye parts become sphere-meshed
-- blocks, which look the same but can squash shut to blink.
local function sphereBlock(part: BasePart)
	if part:IsA("Part") and part.Shape == Enum.PartType.Ball then
		part.Shape = Enum.PartType.Block
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	end
end

function tagRig(model: Model, specs, parts)
	local body = parts[1]
	local head = model:FindFirstChild("Head")
	local headCenter, headRadius
	if head and head:IsA("BasePart") then
		headCenter = head.CFrame.Position
		headRadius = math.max(head.Size.X, head.Size.Y, head.Size.Z) / 2
		for _, part in model:GetChildren() do
			if part:IsA("BasePart") and part ~= body and not part:GetAttribute("SwingHinge") then
				local offset = part.CFrame.Position - headCenter
				if
					offset.Magnitude <= headRadius * 1.55
					and offset.Y >= -headRadius * 0.92
					and offset.Z <= headRadius
					and part:GetAttribute("Rig") ~= "arm"
					and part:GetAttribute("NotOnHead") ~= true
				then
					part:SetAttribute("OnHead", true)
				end
			end
		end
	end

	-- A Freek with no separate head wears its face on its body: mark the face (the front
	-- details and anything small on the front of the upper body) so a hybrid can swap it.
	if not headCenter then
		local center = body.CFrame.Position
		local half = body.Size / 2
		for i, spec in specs do
			local part = parts[i]
			local offset = part.CFrame.Position - center
			if
				i > 1
				and not spec.swing
				and offset.Z < -half.Z * 0.4
				and offset.Y > -half.Y * 0.6
				and math.max(part.Size.X, part.Size.Y) < math.max(half.X, half.Y) * 1.3
			then
				part:SetAttribute("Face", true)
			end
		end
		for _, part in model:GetChildren() do
			if part.Name == "Sparkle" then
				local offset = part.CFrame.Position - center
				if offset.Z < -half.Z * 0.4 then
					part:SetAttribute("Face", true)
				end
			end
		end
	end

	-- Eyes: big white detail balls on the head (or on the upper body of a head-less Freek).
	local all = model:GetChildren()
	local eyes = 0
	for i, spec in specs do
		local part = parts[i]
		local shape = spec.shape or "Block"
		local size = part.Size
		local color = part.Color
		local whiteish = math.min(color.R, color.G, color.B) > 0.9
		local placed = if headCenter
			then part:GetAttribute("OnHead") == true
			else part.CFrame.Position.Y > body.CFrame.Position.Y
		if
			spec.detail
			and whiteish
			and (shape == "Ball" or shape == "Ellipsoid")
			and math.min(size.X, size.Y) >= 0.25
			and math.max(size.X, size.Y) <= 2.4
			and (spec.transparency or 0) < 0.5
			and placed
			and not part:GetAttribute("Eye")
		then
			eyes += 1
			local center = part.CFrame.Position
			local half = size / 2
			part:SetAttribute("Eye", eyes)
			part:SetAttribute("EyeWhite", true)
			sphereBlock(part)
			for _, other in all do
				if other:IsA("BasePart") and other ~= part and other ~= body and other ~= head then
					local offset = other.CFrame.Position - center
					local big = math.max(other.Size.X, other.Size.Y)
					if
						math.abs(offset.X) <= half.X
						and math.abs(offset.Y) <= half.Y
						and offset.Z <= 0.05
						and offset.Z >= -half.Z - 0.5
						and big <= math.max(size.X, size.Y) * 1.02
						and not other:GetAttribute("Eye")
					then
						other:SetAttribute("Eye", eyes)
						sphereBlock(other)
					end
				end
			end
		end
	end
end

local function buildFromParts(species, mutationId: string?): (Model, number)
	local look = species.look
	local model = Instance.new("Model")
	model.Name = species.name

	local parts = {}
	local top = 0
	for i, spec in look.parts do
		local shape = spec.shape or "Block"
		local size = vector(spec.size)
		local rot = spec.rot or { 0, 0, 0 }
		local cframe = CFrame.new(vector(spec.pos))
			* CFrame.Angles(math.rad(rot[1]), math.rad(rot[2]), math.rad(rot[3]))
		local part
		if shape == "Wedge" then
			part = Instance.new("WedgePart")
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.Material = Enum.Material.SmoothPlastic
		elseif shape == "Ellipsoid" then
			-- A smooth stretched ball: a block drawn as a sphere filling its size.
			part = newPart({ Shape = Enum.PartType.Block })
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		else
			part = newPart({ Shape = SHAPES[shape] or Enum.PartType.Block })
		end
		part.Name = spec.name or (if i == 1 then "Body" else "Part" .. i)
		part.Size = size
		part.CFrame = cframe
		part.Color = spec.color or Color3.new(1, 1, 1)
		if spec.material then
			part.Material = Enum.Material[spec.material]
		end
		part.Transparency = spec.transparency or 0
		if spec.swing then
			part:SetAttribute("SwingHinge", vector(spec.swing.hinge))
			part:SetAttribute("SwingPhase", spec.swing.phase or 0)
			part:SetAttribute("SwingAxis", spec.swing.axis or "X")
			part:SetAttribute("SwingAmount", spec.swing.amount or 1)
		end
		if spec.onHead == false then
			part:SetAttribute("NotOnHead", true)
		end
		if spec.detail then
			part:SetAttribute("Detail", true)
		end
		if spec.rig then
			part:SetAttribute("Rig", spec.rig)
			part:SetAttribute("RigSide", spec.side or (if spec.pos[1] < 0 then -1 else 1))
			if spec.pivot then
				part:SetAttribute("RigPivot", vector(spec.pivot))
			end
		end

		if not spec.detail then
			if mutationId == "Golden" then
				part.Color = Color3.fromRGB(255, 196, 40):Lerp(part.Color, 0.15)
				part.Material = Enum.Material.Foil
			elseif mutationId == "Shadow" then
				part.Color = Color3.fromRGB(35, 25, 50):Lerp(part.Color, 0.1)
			elseif mutationId == "Rainbow" then
				part.Material = Enum.Material.Neon
				CollectionService:AddTag(part, FreekModel.RAINBOW_TAG)
			end
		end

		part.Parent = model
		parts[i] = part
		top = math.max(top, spec.pos[2] + size.Y / 2)
	end

	local body = parts[1]
	body.PivotOffset = body.CFrame:Inverse()
	model.PrimaryPart = body
	polish(model, look.parts, parts)
	tagRig(model, look.parts, parts)

	for _, effect in look.effects or {} do
		addEffect(parts[effect.part or 1], effect)
	end
	if mutationId == "Golden" or mutationId == "Rainbow" then
		addEffect(body, {
			type = "Sparkles",
			color = if mutationId == "Golden" then Color3.fromRGB(255, 220, 80) else Color3.new(1, 1, 1),
		})
	elseif mutationId == "Shadow" then
		addEffect(body, { type = "Smoke", color = Color3.fromRGB(60, 30, 90), size = 1.5 })
	end

	return model, top
end

-- Effects that show a mutation, for Freeks that carry more than one (the rarest sets the
-- colours, the rest add their effect on top).
local MUTATION_EFFECTS = {
	Rainbow = { type = "Sparkles", color = Color3.new(1, 1, 1) },
	Golden = { type = "Sparkles", color = Color3.fromRGB(255, 220, 80) },
	Shadow = { type = "Smoke", color = Color3.fromRGB(60, 30, 90), size = 1.5 },
}

local buildHybrid

local function buildSingle(speciesId: string, mutationId: string?): (Model, number)
	local species = Freeks.byId[speciesId] or Freeks.list[1]
	local look = species.look
	local s = look.size or 3

	if look.hybrid then
		return buildHybrid(species, mutationId)
	end

	local custom = ReplicatedStorage:FindFirstChild("FreekModels")
	custom = custom and custom:FindFirstChild(species.id)
	if custom and custom:IsA("Model") then
		local model = custom:Clone()
		local _, extents = model:GetBoundingBox()
		return model, extents.Y
	end

	if look.parts then
		return buildFromParts(species, mutationId)
	end

	local bodyColor = look.color
	local bodyMaterial = Enum.Material.SmoothPlastic
	local pupilColor = Color3.new(0, 0, 0)
	local pupilMaterial = Enum.Material.SmoothPlastic
	if mutationId == "Golden" then
		bodyColor = Color3.fromRGB(255, 196, 40)
		bodyMaterial = Enum.Material.Foil
	elseif mutationId == "Shadow" then
		bodyColor = Color3.fromRGB(35, 25, 50)
		pupilColor = Color3.fromRGB(180, 70, 255)
		pupilMaterial = Enum.Material.Neon
	elseif mutationId == "Rainbow" then
		bodyMaterial = Enum.Material.Neon
	end

	local model = Instance.new("Model")
	model.Name = species.name

	local isBall = look.shape ~= "Block"
	local bodyY = s * 0.6
	local body = newPart({
		Name = "Body",
		Shape = if isBall then Enum.PartType.Ball else Enum.PartType.Block,
		Size = Vector3.one * s,
		Color = bodyColor,
		Material = bodyMaterial,
		CFrame = CFrame.new(0, bodyY, 0),
	})
	body.PivotOffset = CFrame.new(0, -bodyY, 0)
	body.Parent = model
	model.PrimaryPart = body

	if mutationId == "Rainbow" then
		CollectionService:AddTag(body, FreekModel.RAINBOW_TAG)
	end
	if mutationId == "Golden" or mutationId == "Rainbow" then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = if mutationId == "Golden"
			then Color3.fromRGB(255, 220, 80)
			else Color3.fromRGB(255, 255, 255)
		sparkles.Parent = body
	end

	-- Where the front surface of the body is at a given offset (in multiples of s) from its center.
	local function frontZ(x: number, y: number): number
		if isBall then
			return -math.sqrt(math.max(0.25 - x * x - y * y, 0.04)) * s
		end
		return -0.5 * s
	end

	-- Feet
	for _, x in { -0.25, 0.25 } do
		local foot = ball(s * 0.3, bodyColor:Lerp(Color3.new(0, 0, 0), 0.25), Vector3.new(x * s, s * 0.15, -0.05 * s))
		foot.Material = bodyMaterial
		foot.Parent = model
	end

	-- Eyes
	local layout = EYE_LAYOUTS[math.clamp(look.eyes or 2, 1, 3)]
	local eyeY = 0.12
	for _, x in layout.xs do
		local z = frontZ(x, eyeY) + 0.04 * s
		local white = ball(s * layout.size, Color3.new(1, 1, 1), Vector3.new(x * s, bodyY + eyeY * s, z))
		white.Parent = model
		local pupil =
			ball(s * layout.size * 0.5, pupilColor, Vector3.new(x * s, bodyY + eyeY * s, z - s * layout.size * 0.36))
		pupil.Material = pupilMaterial
		pupil.Parent = model
	end

	-- Mouth
	local mouthY = -0.17
	local mouth = newPart({
		Size = Vector3.new(0.3 * s, 0.06 * s, 0.06 * s),
		Color = Color3.fromRGB(60, 20, 30),
		CFrame = CFrame.new(0, bodyY + mouthY * s, frontZ(0, mouthY) + 0.01 * s),
	})
	mouth.Parent = model

	-- Antennae
	local count = math.clamp(look.antennae or 0, 0, 3)
	for i = 1, count do
		local x = if count == 1 then 0 else (i - (count + 1) / 2) * 0.25
		local topY = bodyY + (if isBall then 0.45 else 0.5) * s
		local stalk = newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4 * s, 0.06 * s, 0.06 * s),
			Color = bodyColor:Lerp(Color3.new(0, 0, 0), 0.35),
			CFrame = CFrame.new(x * s, topY + 0.2 * s, 0) * CFrame.Angles(0, 0, math.pi / 2),
		})
		stalk.Parent = model
		local tip = ball(0.15 * s, Color3.fromRGB(255, 240, 120), Vector3.new(x * s, topY + 0.42 * s, 0))
		tip.Material = Enum.Material.Neon
		tip.Parent = model
	end

	return model, s * 1.6
end

-- A hybrid: the first parent's whole body (legs, arms, tail, anything it holds) wearing
-- the second parent's whole head (ears, eyes, hair, hats), resized to fit and set where
-- the first parent's head was, so every piece stays joined up. A round Freek with no
-- separate head (its face is on its body) gets the new head on top, and loses its old
-- face; given as the head, its whole round body becomes the head.

-- Puts accessory `id` (see Accessories.luau) on a hybrid: on its head (centre `origin`,
-- radius r) or round its neck (origin = the neck). `turn` tilts it about the origin, e.g.
-- a second pair of glasses pushed up onto the forehead.
local function wear(model: Model, id: string, origin: Vector3, r: number, onHead: boolean, turn: CFrame?)
	local accessory = Accessories.list[id]
	if not accessory then
		return
	end
	local tilt = turn or CFrame.identity
	for _, spec in accessory.build() do
		local shape = spec.shape or "Block"
		local part
		if shape == "Wedge" then
			part = Instance.new("WedgePart")
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.Material = Enum.Material.SmoothPlastic
		elseif shape == "Ellipsoid" then
			part = newPart({ Shape = Enum.PartType.Block })
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		else
			part = newPart({ Shape = SHAPES[shape] or Enum.PartType.Block })
		end
		local rot = spec.rot or { 0, 0, 0 }
		local local_ = tilt
			* CFrame.new(vector(spec.pos) * r)
			* CFrame.Angles(math.rad(rot[1]), math.rad(rot[2]), math.rad(rot[3]))
		part.Name = "Accessory"
		part.Size = vector(spec.size) * r
		part.CFrame = CFrame.new(origin) * local_
		part.Color = spec.color or Color3.new(1, 1, 1)
		if spec.material then
			part.Material = Enum.Material[spec.material]
		end
		part.Transparency = spec.transparency or 0
		if onHead then
			part:SetAttribute("OnHead", true)
		else
			part:SetAttribute("NotOnHead", true)
		end
		part.Parent = model
	end
end

-- The parts that make up a Freek's head, where it is and how big.
local function headOf(model: Model): ({ BasePart }, Vector3, number, BasePart)
	local body = model.PrimaryPart :: BasePart
	local head = model:FindFirstChild("Head")
	local list = {}
	if head and head:IsA("BasePart") then
		-- Everything tagged OnHead, plus anything else on top of the head (a big afro, a
		-- hat), but never limbs, tails or things like a collar.
		local center = head.CFrame.Position
		local radius = math.max(head.Size.X, head.Size.Y, head.Size.Z) / 2
		for _, part in model:GetChildren() do
			if part:IsA("BasePart") and part ~= body then
				local offset = part.CFrame.Position - center
				local around = offset.Magnitude <= radius * 2.1
					and offset.Y >= radius * 0.2
					and offset.Z <= radius * 1.4
					and not part:GetAttribute("SwingHinge")
					and part:GetAttribute("Rig") ~= "arm"
					and not part:GetAttribute("NotOnHead")
				if part == head or part:GetAttribute("OnHead") or around then
					table.insert(list, part)
				end
			end
		end
		return list, center, radius, head
	end
	-- No head: the round body is the head, with its face and whatever sits on top (horns,
	-- hats), but not its arms, legs, wings or tail.
	local center = body.CFrame.Position
	for _, part in model:GetChildren() do
		if
			part:IsA("BasePart")
			and (
				part == body
				or part:GetAttribute("Face")
				or (
					part.CFrame.Position.Y > center.Y
					and not part:GetAttribute("SwingHinge")
					and part:GetAttribute("Rig") == nil
				)
			)
		then
			table.insert(list, part)
		end
	end
	return list, center, math.max(body.Size.X, body.Size.Y, body.Size.Z) / 2, body
end

function buildHybrid(species, mutationId: string?): (Model, number)
	local model, height = buildSingle(species.look.hybrid.a, mutationId)
	local other = buildSingle(species.look.hybrid.b, mutationId)
	model.Name = species.name
	local body, otherBody = model.PrimaryPart, other.PrimaryPart
	if not body or not otherBody then
		other:Destroy()
		return model, height
	end

	-- Where the new head goes: in place of the first parent's head, or on top of its body.
	local target, targetRadius
	local oldHead = model:FindFirstChild("Head")
	-- The first parent keeps its ears: they go on the new head, so both parents show.
	local oldParts, oldCenter, oldRadius = headOf(model)
	local ears = {}
	for _, part in oldParts do
		if part:GetAttribute("Rig") == "ear" then
			table.insert(ears, part)
		end
	end
	local firstColor = if oldHead and oldHead:IsA("BasePart") then oldHead.Color else body.Color
	if oldHead and oldHead:IsA("BasePart") then
		target, targetRadius = oldCenter, oldRadius
		for _, part in oldParts do
			if part:GetAttribute("Rig") ~= "ear" then
				part:Destroy()
			end
		end
	else
		-- Its face and whatever sat on top (a hat) make way for the new head.
		for _, part in oldParts do
			if part ~= body and part:GetAttribute("Rig") ~= "ear" then
				part:Destroy()
			end
		end
		local size = body.Size
		targetRadius = math.max(size.X, size.Z) * 0.32
		target = body.CFrame.Position + Vector3.new(0, size.Y / 2 + targetRadius * 0.6, 0)
	end

	-- A big, chibi head (like the popular pet games), its bottom kept where it was.
	local grown = targetRadius * 1.15
	target += Vector3.new(0, grown - targetRadius, 0)
	targetRadius = grown

	-- Move the second parent's head over, resized to fit.
	local headParts, center, radius, anchor = headOf(other)
	local headColor = anchor.Color
	local scale = targetRadius / radius
	for _, part in headParts do
		local offset = (part.CFrame.Position - center) * scale
		part.Size *= scale
		part.CFrame = CFrame.new(target + offset) * part.CFrame.Rotation
		local eye = part:GetAttribute("Eye")
		if eye then
			part:SetAttribute("Eye", eye + 100) -- keep the parents' eye numbers apart
		end
		for _, name in { "SwingHinge", "RigPivot" } do
			local point = part:GetAttribute(name)
			if typeof(point) == "Vector3" then
				part:SetAttribute(name, target + (point - center) * scale)
			end
		end
		part:SetAttribute("OnHead", true)
		part.Parent = model
	end
	anchor.Name = "Head" -- so it turns and looks around like any head

	-- Swap the new head's ears for the first parent's, moved and resized to fit it.
	if #ears > 0 then
		for _, part in headParts do
			if part:GetAttribute("Rig") == "ear" then
				part:Destroy()
			end
		end
		local earScale = targetRadius / oldRadius
		for _, part in ears do
			part.Size *= earScale
			part.CFrame = CFrame.new(target + (part.CFrame.Position - oldCenter) * earScale) * part.CFrame.Rotation
			local pivot = part:GetAttribute("RigPivot")
			if typeof(pivot) == "Vector3" then
				part:SetAttribute("RigPivot", target + (pivot - oldCenter) * earScale)
			end
			part:SetAttribute("OnHead", true)
		end
	end

	-- The second parent's tail (if it has one) replaces the first parent's.
	local function tailOf(m: Model)
		local list, hinge = {}, nil
		for _, part in m:GetChildren() do
			if part:IsA("BasePart") and part:GetAttribute("SwingAxis") == "Y" and not part:GetAttribute("OnHead") then
				table.insert(list, part)
				hinge = hinge or part:GetAttribute("SwingHinge")
			end
		end
		return list, hinge
	end
	local newTail, newHinge = tailOf(other)
	if #newTail > 0 and typeof(newHinge) == "Vector3" then
		local oldTail, oldHinge = tailOf(model)
		local half = body.Size / 2
		local back = if typeof(oldHinge) == "Vector3"
			then oldHinge
			else body.CFrame.Position + Vector3.new(0, half.Y * 0.1, half.Z * 0.85)
		for _, part in oldTail do
			part:Destroy()
		end
		local tailScale = math.clamp(body.Size.Magnitude / otherBody.Size.Magnitude, 0.6, 1.4)
		for _, part in newTail do
			part.Size *= tailScale
			part.CFrame = CFrame.new(back + (part.CFrame.Position - newHinge) * tailScale) * part.CFrame.Rotation
			part:SetAttribute("SwingHinge", back)
			part.Parent = model
		end
	end

	-- Both parents' colours: the body takes a little of the head's colour, its legs and arms
	-- a touch more, and it gets patches of the head's colour, like markings.
	if not mutationId then
		body.Color = body.Color:Lerp(headColor, 0.25)
		for _, part in model:GetChildren() do
			if
				part:IsA("BasePart")
				and part:GetAttribute("SwingAxis") == "X"
				and not part:GetAttribute("Detail")
				and not part:GetAttribute("OnHead")
			then
				part.Color = part.Color:Lerp(headColor, 0.35)
			end
		end
		local half = body.Size / 2
		if body:IsA("Part") and body.Shape == Enum.PartType.Ball then
			half = Vector3.one * math.min(half.X, half.Y, half.Z)
		end
		local spot = math.min(half.X, half.Y, half.Z) * 0.75
		for _, direction in
			{
				Vector3.new(0.7, 0.35, -0.55),
				Vector3.new(-0.75, -0.2, -0.45),
				Vector3.new(0.9, -0.3, 0.3),
				Vector3.new(-0.85, 0.45, 0.25),
				Vector3.new(0.2, 0.75, 0.6),
				Vector3.new(-0.3, -0.2, 0.9),
			}
		do
			-- A point on the body's surface in that direction, and a flat spot lying on it.
			local d = direction.Unit
			local reach = 1 / math.sqrt((d.X / half.X) ^ 2 + (d.Y / half.Y) ^ 2 + (d.Z / half.Z) ^ 2)
			local point = body.CFrame.Position + d * reach
			local normal = Vector3.new(d.X / half.X ^ 2, d.Y / half.Y ^ 2, d.Z / half.Z ^ 2).Unit
			local patch = newPart({
				Name = "FusionSpot",
				Shape = Enum.PartType.Block,
				Size = Vector3.new(spot, spot * 0.8, spot * 0.3),
				CFrame = CFrame.lookAt(point, point + normal),
				Color = headColor,
				CanQuery = false,
			})
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = patch
			patch.Parent = model
		end
		-- And a patch of the first parent's colour round one eye, like a mixed-breed pup.
		local d = Vector3.new(-0.5, 0.35, -0.8).Unit
		local headR = targetRadius
		-- Thin and just under the surface, so the eye still sits on top of it.
		local point = target + d * headR * 0.94
		local eyePatch = newPart({
			Name = "FusionSpot",
			Shape = Enum.PartType.Block,
			Size = Vector3.new(headR * 0.95, headR * 0.85, headR * 0.14),
			CFrame = CFrame.lookAt(point, point + d),
			Color = firstColor,
			CanQuery = false,
		})
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = eyePatch
		eyePatch:SetAttribute("OnHead", true)
		eyePatch.Parent = model
	end

	-- Both parents' signature accessories. The body parent already wears a neck one (a
	-- collar) and the head parent a head one (glasses, a hat); the others are added: the body
	-- parent's head accessory on the new head, the head parent's neck one round the neck.
	-- Two in one spot don't fight: a second pair of glasses goes up on the forehead.
	local neck = target - Vector3.new(0, targetRadius * 1.0, 0)
	local firstSpecies = Freeks.byId[species.look.hybrid.a]
	local secondSpecies = Freeks.byId[species.look.hybrid.b]
	local sigA = firstSpecies and firstSpecies.signature
	local sigB = secondSpecies and secondSpecies.signature
	local slotA = sigA and Accessories.list[sigA] and Accessories.list[sigA].slot
	local slotB = sigB and Accessories.list[sigB] and Accessories.list[sigB].slot
	local taken = {}
	if slotA == "neck" then
		taken.neck = true
	end
	if slotB and slotB ~= "neck" then
		taken[slotB] = true
	end
	if sigA and slotA and slotA ~= "neck" then
		if not taken[slotA] then
			wear(model, sigA, target, targetRadius, true)
			taken[slotA] = true
		elseif slotA == "eyes" then
			wear(model, sigA, target, targetRadius, true, CFrame.Angles(math.rad(42), 0, 0))
		end
	end
	if sigB and slotB == "neck" and not taken.neck then
		wear(model, sigB, neck, targetRadius, false)
		taken.neck = true
	end

	-- The fusion collar where the head meets the body (unless a parent's collar is there): a
	-- chunky two-tone ring with a glowing trim and a gem in front, so the join looks made
	-- that way.
	local bodyColor = body.Color
	local shine = body
	if not taken.neck then
		local ring = targetRadius * 1.45
		for k, layer in
			{
				{ 0.18, ring, bodyColor, Enum.Material.SmoothPlastic },
				{ -0.18, ring * 0.95, headColor, Enum.Material.SmoothPlastic },
				{ 0, ring * 1.08, Color3.fromRGB(255, 120, 230), Enum.Material.Neon },
			}
		do
			local collar = newPart({
				Name = "FusionCollar",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(if k == 3 then targetRadius * 0.12 else targetRadius * 0.3, layer[2], layer[2]),
				CFrame = CFrame.new(neck + Vector3.new(0, layer[1] * targetRadius * 0.6, 0))
					* CFrame.Angles(0, 0, math.pi / 2),
				Color = layer[3],
				Material = layer[4],
				CanQuery = false,
			})
			collar:SetAttribute("NotOnHead", true)
			collar.Parent = model
		end
		local gem = newPart({
			Name = "FusionGem",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * targetRadius * 0.45,
			CFrame = CFrame.new(neck + Vector3.new(0, 0, -ring / 2)),
			Color = Color3.fromRGB(255, 120, 230),
			Material = Enum.Material.Neon,
			CanQuery = false,
		})
		gem.Parent = model
		shine = gem
	end
	if not mutationId then
		-- A fusion shimmer in the two parents' colours.
		local shimmer = Instance.new("Sparkles")
		shimmer.SparkleColor = bodyColor:Lerp(headColor, 0.5)
		shimmer.Parent = shine
	end
	other:Destroy()

	local top = 0
	local ground = model:GetPivot().Position.Y
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") then
			top = math.max(top, part.CFrame.Position.Y + part.Size.Y / 2 - ground)
		end
	end
	return model, top
end

-- Returns the model and roughly how tall it is (for placing name tags). mutations is a
-- list of mutation ids (a single id also works).
function FreekModel.build(speciesId: string, mutations): (Model, number)
	local list = Mutations.normalize(mutations)
	local model, height = buildSingle(speciesId, list[1])
	local species = Freeks.byId[speciesId]
	model:SetAttribute("Walk", species and species.walk or "waddle")
	-- Stream the whole Freek to clients at once. Otherwise a client can get the model
	-- before its body part, and then Roblox pivots it from its middle instead of its feet,
	-- leaving it half in the ground.
	pcall(function()
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end)
	local body = model.PrimaryPart
	for i = 2, #list do
		local effect = MUTATION_EFFECTS[list[i]]
		-- Rainbow and Golden already sparkle; don't stack a second set.
		local sparkling = body and body:FindFirstChildOfClass("Sparkles")
		if body and effect and not (effect.type == "Sparkles" and sparkling) then
			addEffect(body, effect)
		end
	end
	return model, height
end

return FreekModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Freeks</string>
          <string name="Source"><![CDATA[-- Every Freek species in the game.
--
-- id       unique key saved in player data; never rename one after release
-- income   money per second while in the yard
-- price    set only for starter Freeks: always allowed on the conveyor belt, at this price.
--          Other species appear on the belt once discovered, priced from their income.
-- season   optional Seasonal tag (a key in Seasons.luau): only obtainable during that season
-- walk     how it moves around the town square: waddle, trot, prowl, slither, flap, stomp,
--          bounce, strut, catwalk, shamble or float (see the client)
-- exclusive only from Monster Crates (never from cannons, the wheel or anywhere else)
-- event       only from the cannons while that event runs (see Events.luau)
-- look     how the model is built: either a placeholder (shape "Ball" or "Block", size in
--          studs, eyes 1-3, antennae 0-3) or a part list (see FreekModel), e.g. from human()
--
-- Fusing two different Freeks makes a hybrid (see Hybrids.luau); the only hand-made results
-- are the Ultra pairs that make Secrets, in ServerScriptService (Recipes).

local Accessories = require(script.Parent.Accessories)

local Freeks = {}

-- The Human line: Freeks shaped like little cartoon people. human() builds the shared body
-- (legs, hips, torso, arms, neck, a big head with googly eyes and a mouth) and adds each
-- one's own parts on top. The torso is the first part, so hybrids mix them like any other
-- Freek: one parent's legs and body, the other's head.
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Helpers for the Animal line: each animal is a list of parts like Oinkle's, built with
-- these so eyes, legs and pointy ears line up without hand-maths.
local function newParts()
	local list = {}
	local function add(spec)
		table.insert(list, spec)
		return #list
	end
	return list, add
end

-- A point on the front (-Z) of a ball centred at c with radius r, offset (x, y) from c.
local function onBall(c, r: number, x: number, y: number, out: number?)
	return { c[1] + x, c[2] + y, c[3] - math.sqrt(math.max(r * r - x * x - y * y, 0.01)) - (out or 0) }
end

-- Straight legs standing on the ground, centred at each (x, z). Given front-left,
-- front-right, back-left, back-right, they walk in diagonal pairs.
local DIAGONAL = { 0, 0.5, 0.5, 0 }
local function legs(add, spots, height: number, width: number, color: Color3, paw: Color3?)
	for i, spot in spots do
		local swing = { hinge = { spot[1], height, spot[2] }, phase = DIAGONAL[i] or 0 }
		add({
			shape = "Cylinder",
			size = { height, width, width },
			pos = { spot[1], height / 2, spot[2] },
			rot = { 0, 0, 90 },
			color = color,
			swing = swing,
		})
		if paw then
			add({
				shape = "Ball",
				size = width + 0.15,
				pos = { spot[1], (width + 0.15) / 2, spot[2] - 0.08 },
				color = paw,
				swing = swing,
			})
		end
	end
end

-- A pointy ear (a triangle seen from the front), made of two wedges back to back.
local function pointyEar(add, x: number, y: number, z: number, width: number, height: number, color: Color3)
	for _, side in { -1, 1 } do
		add({
			shape = "Wedge",
			size = { 0.25, height, width / 2 },
			pos = { x + side * width / 4, y, z },
			rot = { 0, side * -90, 0 },
			color = color,
			rig = "ear",
			side = if x < 0 then -1 else 1,
			pivot = { x, y - height / 2, z },
		})
	end
end

-- The face kit: big glossy eyes, blush and a curved smile, in the style of today's popular
-- Roblox pets. Every helper takes a point on a ball face: the ball's centre c, radius r, and
-- an offset (x, y) across the face. FreekModel adds sparkle highlights to the pupils.

-- One big cute eye on a ball: a tall white, a coloured iris and a black pupil (FreekModel
-- gives the pupil its sparkles).
local function oneEye(add, c, r: number, x: number, y: number, size: number, iris: Color3?)
	local p = onBall(c, r, x, y, -size * 0.18)
	add({
		shape = "Ellipsoid",
		size = { size * 0.9, size * 1.08, size * 0.55 },
		pos = p,
		color = rgb(255, 255, 255),
		detail = true,
	})
	add({
		shape = "Ellipsoid",
		size = { size * 0.66, size * 0.8, size * 0.3 },
		pos = { p[1], p[2] - size * 0.06, p[3] - size * 0.2 },
		color = iris or rgb(95, 60, 35),
		detail = true,
	})
	add({
		shape = "Ball",
		size = size * 0.38,
		pos = { p[1], p[2] - size * 0.06, p[3] - size * 0.3 },
		color = rgb(15, 12, 20),
		detail = true,
	})
end

-- A pair of big cute eyes.
local function cuteEyes(add, c, r: number, spread: number, height: number, size: number, iris: Color3?)
	for _, side in { -1, 1 } do
		oneEye(add, c, r, side * spread, height, size, iris)
	end
end

-- Little hooves at the bottom of legs made by legs() (same spots and height).
local function hooves(add, spots, height: number, width: number, color: Color3)
	for i, spot in spots do
		add({
			shape = "Cylinder",
			size = { 0.24, width, width },
			pos = { spot[1], 0.12, spot[2] },
			rot = { 0, 0, 90 },
			color = color,
			detail = true,
			swing = { hinge = { spot[1], height, spot[2] }, phase = DIAGONAL[i] or 0 },
		})
	end
end

-- Soft pink cheeks.
local function blush(add, c, r: number, spread: number, height: number, size: number, color: Color3?)
	for _, side in { -1, 1 } do
		add({
			shape = "Ellipsoid",
			size = { size, size * 0.55, size * 0.25 },
			pos = onBall(c, r, side * spread, height, -size * 0.05),
			color = color or rgb(255, 135, 165),
			transparency = 0.25,
			detail = true,
		})
	end
end

-- A curved smile: little beads along a U shape.
local function smile(add, c, r: number, height: number, width: number, color: Color3?, thickness: number?)
	local t = thickness or 0.12
	local beads = math.max(13, math.ceil(width / t * 2.2))
	for k = 0, beads - 1 do
		local f = k / (beads - 1) * 2 - 1
		local x = f * width / 2
		local y = height - (1 - f * f) * width * 0.22
		add({
			shape = "Ball",
			size = t,
			pos = onBall(c, r, x, y, -t * 0.2),
			color = color or rgb(90, 35, 45),
			detail = true,
			shine = false,
		})
	end
end

-- An open happy mouth: a dark rounded opening with a pink tongue.
local function openMouth(add, c, r: number, height: number, width: number)
	local p = onBall(c, r, 0, height, -0.02)
	add({
		shape = "Ellipsoid",
		size = { width, width * 0.6, 0.18 },
		pos = p,
		color = rgb(90, 25, 40),
		detail = true,
	})
	add({
		shape = "Ellipsoid",
		size = { width * 0.6, width * 0.28, 0.12 },
		pos = { p[1], p[2] - width * 0.14, p[3] - 0.06 },
		color = rgb(255, 120, 150),
		detail = true,
	})
end

local function human(o)
	local parts = {}
	local function add(spec)
		table.insert(parts, spec)
		return #parts
	end
	local torsoW, torsoD = o.torsoWidth or 1.9, o.torsoDepth or 1.1
	local armD = o.armSize or 0.5
	local head = o.head or 2.1
	local torsoY = 1.6 + 0.85
	local torsoTop = 1.6 + 1.7
	local headY = torsoTop + 0.15 + head * 0.45
	local r = head / 2
	-- How far forward the face is at (x, y) relative to the head's centre.
	local function face(x: number, y: number, out: number?): number
		return -math.sqrt(math.max(r * r - x * x - y * y, 0.01)) - (out or 0)
	end

	-- A rounded bean of a torso with soft shoulders, and rounded hips.
	add({
		name = "Body",
		shape = "Ellipsoid",
		size = { torsoW, 2.0, torsoD * 1.15 },
		pos = { 0, torsoY + 0.05, 0 },
		color = o.shirt,
	})
	add({ shape = "Ellipsoid", size = { torsoW * 0.96, 0.95, torsoD * 1.05 }, pos = { 0, 1.5, 0 }, color = o.pants })
	-- Legs swing in turn, and each arm swings with the opposite leg.
	for i, x in { -0.45, 0.45 } do
		local swing = { hinge = { x, 1.35, 0 }, phase = (i - 1) * 0.5 }
		add({
			shape = "Cylinder",
			size = { 1.2, 0.6, 0.6 },
			pos = { x, 0.75, 0 },
			rot = { 0, 0, 90 },
			color = o.pants,
			swing = swing,
		})
		-- Chunky rounded sneakers with a pale sole.
		local shoe = o.shoeSize or { 0.7, 0.35, 1.05 }
		add({
			shape = "Ellipsoid",
			size = { shoe[1] + 0.12, shoe[2] + 0.2, shoe[3] + 0.1 },
			pos = { x, 0.24, -0.15 },
			color = o.shoes,
			detail = true,
			swing = swing,
		})
		add({
			shape = "Ellipsoid",
			size = { shoe[1] + 0.16, 0.16, shoe[3] + 0.16 },
			pos = { x, 0.08, -0.15 },
			color = o.sole or rgb(245, 245, 240),
			detail = true,
			swing = swing,
		})
	end
	local shoulderX = torsoW / 2 + armD / 2 - 0.02
	for _, side in { -1, 1 } do
		if o.armsForward then
			-- Arms stuck straight out in front (zombies, mummies), barely swinging.
			local swing = { hinge = { side * shoulderX, 2.95, 0 }, phase = if side < 0 then 0.5 else 0, amount = 0.25 }
			add({
				shape = "Cylinder",
				size = { 1.5, armD, armD },
				pos = { side * shoulderX, 2.95, -0.7 },
				rot = { 0, 90, 0 },
				color = o.sleeves or o.skin,
				swing = swing,
			})
			add({
				shape = "Ball",
				size = armD + 0.12,
				pos = { side * shoulderX, 2.95, -1.5 },
				color = o.skin,
				swing = swing,
			})
		else
			local swing = { hinge = { side * shoulderX, 3.2, 0 }, phase = if side < 0 then 0.5 else 0, amount = 0.8 }
			add({
				shape = "Cylinder",
				size = { 1.45, armD, armD },
				pos = { side * shoulderX, 2.5, 0 },
				rot = { 0, 0, 90 + side * 6 },
				color = o.sleeves or o.skin,
				swing = swing,
				rig = "arm",
				side = side,
			})
			add({
				shape = "Ball",
				size = armD + 0.12,
				pos = { side * (shoulderX + 0.08), 1.72, 0 },
				color = o.skin,
				swing = swing,
				rig = "arm",
				side = side,
			})
		end
	end
	add({
		shape = "Cylinder",
		size = { 0.35, 0.55, 0.55 },
		pos = { 0, torsoTop + 0.1, 0 },
		rot = { 0, 0, 90 },
		color = o.skin,
	})
	add({ name = "Head", shape = "Ball", size = head, pos = { 0, headY, 0 }, color = o.skin })
	local headC = { 0, headY, 0 }
	local eyeX, eyeY = head * 0.19, head * 0.04
	-- Little ears on the sides of the head.
	for _, side in { -1, 1 } do
		add({
			shape = "Ellipsoid",
			size = { 0.28, 0.5, 0.36 },
			pos = { side * r * 0.98, headY - 0.05, 0.05 },
			color = o.skin,
		})
	end
	cuteEyes(add, headC, r, eyeX, eyeY, head * 0.3, o.eyeColor)
	if not o.noBrows then
		for _, side in { -1, 1 } do
			add({
				shape = "Ellipsoid",
				size = { head * 0.2, 0.09, 0.08 },
				pos = onBall(headC, r, side * eyeX, eyeY + head * 0.22, -0.02),
				rot = { 0, 0, side * (o.browTilt or -8) },
				color = o.brows or rgb(70, 45, 30),
				detail = true,
			})
		end
	end
	if not o.noBlush then
		blush(add, headC, r, eyeX + head * 0.1, -head * 0.1, head * 0.17)
	end
	if not o.noMouth then
		smile(add, headC, r, -head * 0.16, head * 0.24)
	end

	local effects = {}
	local before = #parts
	if o.extra then
		o.extra({
			add = add,
			face = face,
			skin = o.skin,
			headY = headY,
			head = head,
			torsoTop = torsoTop,
			torsoY = torsoY,
			torsoW = torsoW,
			torsoD = torsoD,
			shoulderX = shoulderX,
			eyeX = eyeX,
			eyeY = eyeY,
			effects = effects,
		})
	end
	-- Anything the extras put on an arm (biceps, claws, a dumbbell, a book) moves with it.
	if not o.armsForward then
		for i = before + 1, #parts do
			local spec = parts[i]
			local x, y = spec.pos[1], spec.pos[2]
			if not spec.swing and not spec.rig and y < torsoTop and math.abs(x) >= shoulderX - armD * 0.5 then
				local side = if x < 0 then -1 else 1
				spec.swing = { hinge = { side * shoulderX, 3.2, 0 }, phase = if side < 0 then 0.5 else 0, amount = 0.8 }
				spec.rig = "arm"
				spec.side = side
			end
		end
	end
	return { parts = parts, effects = effects }
end

Freeks.list = {
	-- Starter Freeks (shop)
	{
		id = "Oinkle",
		signature = "bow",
		walk = "waddle",
		name = "Oinkle",
		rarity = "Common",
		income = 1,
		price = 50,
		look = (function()
			-- A chubby piglet: round body with a pale belly, a big head with a shiny snout,
			-- floppy ears, little hooves and a curly tail.
			local list, add = newParts()
			local pink, deep, pale = rgb(255, 172, 192), rgb(240, 140, 165), rgb(255, 212, 222)
			add({ name = "Body", shape = "Ellipsoid", size = { 3.3, 2.9, 3.6 }, pos = { 0, 2.0, 0.25 }, color = pink })
			add({ shape = "Ellipsoid", size = { 2.3, 1.9, 0.9 }, pos = { 0, 1.75, -1.3 }, color = pale })
