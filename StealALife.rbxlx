	{
		id = "Howlz",
		signature = "spikedcollar",
		name = "Howlz",
		rarity = "Mystic",
		exclusive = true,
		walk = "prowl",
		income = 1500,
		look = human({
			skin = rgb(120, 85, 60),
			shirt = rgb(110, 60, 140),
			sleeves = rgb(120, 85, 60),
			pants = rgb(60, 60, 80),
