	{
		id = "Blinky",
		signature = "horns",
		name = "Blinky",
		rarity = "Ultra",
		exclusive = true,
		walk = "bounce",
		income = 6000,
		look = (function()
			local list, add = newParts()
			local purple, dark = rgb(140, 80, 220), rgb(95, 45, 170)
			local body = { 0, 2.6, 0 }
			add({ name = "Body", shape = "Ball", size = 3.6, pos = body, color = purple })
			legs(add, { { -0.75, -0.2 }, { 0.75, -0.2 } }, 1.0, 0.7, dark, dark)
			-- One huge eye.
			local eye = onBall(body, 1.8, 0, 0.35, -0.5)
			add({ shape = "Ball", size = 1.8, pos = eye, color = rgb(255, 255, 255), detail = true })
			add({
				shape = "Ball",
				size = 1.1,
				pos = { eye[1], eye[2], eye[3] - 0.42 },
				color = rgb(80, 220, 160),
				detail = true,
			})
			add({
				shape = "Ball",
				size = 0.55,
				pos = { eye[1], eye[2], eye[3] - 0.72 },
				color = rgb(15, 15, 20),
				detail = true,
			})
			add({
				shape = "Ball",
				size = 0.22,
				pos = { eye[1] + 0.25, eye[2] + 0.25, eye[3] - 0.85 },
				color = rgb(255, 255, 255),
				detail = true,
			})
			-- A wide toothy grin.
			openMouth(add, body, 1.8, -0.78, 1.25)
			for _, x in { -0.35, 0, 0.35 } do
				add({
					shape = "Wedge",
					size = { 0.1, 0.22, 0.18 },
					pos = onBall(body, 1.8, x, -0.6, 0.06),
					rot = { 180, 0, 0 },
					color = rgb(255, 255, 255),
					detail = true,
				})
			end
			blush(add, body, 1.8, 1.05, -0.35, 0.5)
			-- Two little horns (stacked rings) and stubby arms.
			for _, side in { -1, 1 } do
				for k = 0, 3 do
					local width = 0.5 - k * 0.11
					add({
						shape = "Cylinder",
						size = { 0.22, width, width },
						pos = { side * (0.75 + k * 0.08), 4.25 + k * 0.2, 0 },
						rot = { 0, 0, 90 - side * 20 },
						color = rgb(255, 220, 120),
					})
				end
				add({
					shape = "Ball",
					size = 0.8,
					pos = { side * 1.9, 2.4, -0.1 },
					color = purple,
					swing = { hinge = { side * 1.6, 2.6, -0.1 }, phase = if side < 0 then 0.5 else 0, amount = 0.6 },
					rig = "arm",
					side = side,
				})
			end
			return {
				parts = list,
				effects = {
					{ type = "Sparkles", part = 1, color = rgb(200, 255, 230) },
					{ type = "Glow", part = 1, color = rgb(80, 220, 160), size = 12 },
				},
			}
		end)(),
	},
	-- Event Freeks: only from the cannons during their event (see Events.luau).
	{
		id = "Stormy",
		signature = "lightning",
		name = "Stormy",
		rarity = "Mystic",
		event = "MonsterStorm",
		walk = "float",
		income = 2000,
		look = (function()
			-- A grumpy-cute storm cloud: puffy grey-blue cloud body, big yellow eyes under
			-- cross brows, a crackling lightning bolt underneath and raindrops falling.
			local list, add = newParts()
			local cloud, dark, light = rgb(125, 140, 180), rgb(90, 100, 140), rgb(170, 185, 220)
			local c, r = { 0, 3.1, 0 }, 1.3
			add({ name = "Body", shape = "Ellipsoid", size = { 3.2, 2.4, 2.6 }, pos = c, color = cloud })
			for _, puff in
				{
					{ -0.95, 4.0, 0.15, 1.6, light },
					{ 0.25, 4.35, 0.2, 1.9, light },
					{ 1.15, 3.95, 0.1, 1.5, light },
					{ -1.65, 3.0, 0.1, 1.5, cloud },
					{ 1.7, 3.05, 0.1, 1.45, cloud },
					{ -0.85, 2.1, 0.1, 1.35, dark },
					{ 0.8, 2.05, 0.15, 1.4, dark },
				}
			do
				add({ shape = "Ball", size = puff[4], pos = { puff[1], puff[2], puff[3] }, color = puff[5] })
			end
			cuteEyes(add, c, r, 0.5, 0.12, 0.66, rgb(255, 215, 50))
			for _, side in { -1, 1 } do
				-- Cross little brows.
				add({
					shape = "Ellipsoid",
					size = { 0.42, 0.12, 0.1 },
					pos = onBall(c, r, side * 0.5, 0.62, -0.05),
					rot = { 0, 0, side * 18 },
					color = rgb(45, 50, 80),
					detail = true,
				})
			end
			blush(add, c, r, 0.85, -0.2, 0.38)
			openMouth(add, c, r, -0.48, 0.42)
			-- Puffy little arms that flutter.
			for _, side in { -1, 1 } do
				add({
					shape = "Ball",
					size = 0.8,
					pos = { side * 2.35, 2.75, -0.1 },
					color = light,
					swing = {
						hinge = { side * 2.0, 2.95, -0.1 },
						phase = if side < 0 then 0 else 0.5,
						axis = "Z",
						amount = side * 0.8,
					},
				})
			end
			-- The lightning bolt crackling underneath.
			local bolt = rgb(255, 230, 60)
			for _, piece in
				{
					{ 0.25, 1.35, -0.3, 25 },
					{ -0.05, 0.85, -0.3, -30 },
					{ 0.2, 0.35, -0.3, 25 },
				}
			do
				add({
					shape = "Block",
					size = { 0.28, 0.75, 0.2 },
					pos = { piece[1], piece[2], piece[3] },
					rot = { 0, 0, piece[4] },
					color = bolt,
					material = "Neon",
					detail = true,
				})
			end
			-- Raindrops.
			for _, drop in { { -1.2, 1.2, 0.3 }, { -0.6, 0.6, -0.4 }, { 0.9, 1.0, 0.2 }, { 1.3, 0.45, -0.3 } } do
				add({
					shape = "Ellipsoid",
					size = { 0.18, 0.3, 0.18 },
					pos = drop,
					color = rgb(120, 200, 255),
					transparency = 0.15,
					detail = true,
				})
			end
			Accessories.put(add, "lightning", c, r)
			return {
				parts = list,
				effects = { { type = "Glow", part = 1, color = rgb(255, 230, 120), size = 12 } },
			}
		end)(),
	},
}

-- Every Freek belongs to a series (shown first when a Monster Egg hatches).
Freeks.SERIES = {
	Animal = { name = "Animal Series", icon = "🐾", color = Color3.fromRGB(90, 220, 110) },
	Human = { name = "Human Series", icon = "🧑", color = Color3.fromRGB(80, 170, 255) },
	Monster = { name = "Monster Series", icon = "🎃", color = Color3.fromRGB(255, 130, 40) },
	Hybrid = { name = "Hybrid", icon = "🧪", color = Color3.fromRGB(255, 95, 200) },
}
local HUMAN_LINE = { Chuckles = true, Nerdle = true, Flexo = true, Glamora = true }

local base = {}
for i, species in Freeks.list do
	species.order = i
	species.series = if species.exclusive or species.event
		then "Monster"
		elseif HUMAN_LINE[species.id] then "Human"
		else "Animal"
	base[species.id] = species
end

-- Freeks.byId[id] also answers for hybrid ids ("Nerdle+Oinkle"), built on first use.
local Hybrids = require(script.Parent.Hybrids)
local hybridCache = {}
Freeks.byId = setmetatable(table.clone(base), {
	__index = function(_, id)
		if type(id) ~= "string" or not Hybrids.isHybrid(id) then
			return nil
		end
		if hybridCache[id] == nil then
			hybridCache[id] = Hybrids.info(id, function(baseId)
				return base[baseId]
			end) or false
		end
		return hybridCache[id] or nil
	end,
})

return Freeks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">GamePasses</string>
          <string name="Source"><![CDATA[-- Game passes: one-time Robux purchases with permanent perks.
--
-- To make a pass live:
--   1. Publish the game, then go to create.roblox.com → your game → Monetization → Passes.
--   2. Create the pass (name, icon, price) and copy its ID number.
--   3. Paste the ID into `id` below. Passes with id = 0 show as "Coming soon".
-- `price` here is only what the Store shows; the real price is set on the dashboard.
--
-- The server marks owners with a player attribute "Pass_<key>", so any script (server or
-- client) can check a perk with GamePasses.has(player, key).

local Config = require(script.Parent.Config)

local GamePasses = {}

-- Set true to pretend every player owns every pass while testing in Studio.
GamePasses.STUDIO_GRANT_ALL = false

GamePasses.order = {
	"DoubleCoins",
	"FastBreeding",
	"LongerLock",
	"VIP",
	"ExtraPen",
	"ExtraSlot1",
	"ExtraSlot2",
	"ExtraSlot3",
}

-- The keys are the original names the passes were created under (their ids are live on
-- Roblox); name/description say what each one does now. Rename them on the dashboard to
-- match.
GamePasses.list = {
	DoubleCoins = {
		id = 2037836799,
		name = "2x Coins",
		icon = "💰",
		price = 499,
		description = "Double coins from everything you own, forever.",
		color = Color3.fromRGB(255, 200, 60),
	},
	FastBreeding = {
		id = 2037644787,
		name = "Fast Hatching",
		icon = "🐣",
		price = 999,
		description = "Eggs hatch twice as fast.",
		color = Color3.fromRGB(90, 200, 255),
	},
	LongerLock = {
		id = 2039660564,
		name = "2x Speed",
		icon = "⚡",
		price = 499,
		description = "Your treadmill trains twice as much Speed.",
		color = Color3.fromRGB(235, 90, 90),
	},
	ExtraSlot1 = {
		id = 2036624799,
		name = "Bigger Backpack 1",
		icon = "🎒",
		price = 199,
		description = "+20 backpack space.",
		color = Color3.fromRGB(230, 150, 90),
		backpack = true,
	},
	ExtraSlot2 = {
		id = 2040200325,
		name = "Bigger Backpack 2",
		icon = "🎒",
		price = 299,
		description = "+20 more backpack space.",
		color = Color3.fromRGB(230, 150, 90),
		backpack = true,
	},
	ExtraSlot3 = {
		id = 2037518787,
		name = "Bigger Backpack 3",
		icon = "🎒",
		price = 349,
		description = "+20 more backpack space.",
		color = Color3.fromRGB(230, 150, 90),
		backpack = true,
	},
	ExtraPen = {
		id = 2037308784,
		name = "Extra Nests",
		icon = "🪺",
		price = 399,
		description = "+2 nests, so you can grow 5 eggs at once.",
		color = Color3.fromRGB(255, 130, 190),
	},
	VIP = {
		id = 2040272321,
		name = "VIP",
		icon = "👑",
		price = 299,
		description = "Gold VIP badge on the leaderboard and in chat, plus +10% coins.",
		color = Color3.fromRGB(255, 180, 40),
	},
}

function GamePasses.has(player: Player, key: string): boolean
	return player:GetAttribute("Pass_" .. key) == true
end

-- Perks --------------------------------------------------------------------------

function GamePasses.coinMultiplier(player: Player): number
	local multiplier = 1
	if GamePasses.has(player, "DoubleCoins") then
		multiplier *= 2
	end
	if GamePasses.has(player, "VIP") then
		multiplier *= 1.1
	end
	return multiplier
end

function GamePasses.speedMultiplier(player: Player): number
	return if GamePasses.has(player, "LongerLock") then 2 else 1
end

-- How long eggs take compared to normal.
function GamePasses.hatchMultiplier(player: Player): number
	return if GamePasses.has(player, "FastBreeding") then 0.5 else 1
end

function GamePasses.extraNests(player: Player): boolean
	return GamePasses.has(player, "ExtraPen")
end

-- How many parts the player's backpack holds.
function GamePasses.backpackSize(player: Player): number
	local size = Config.MAX_PARTS
	for _, key in GamePasses.order do
		if GamePasses.list[key].backpack and GamePasses.has(player, key) then
			size += 20
		end
	end
	return size
end

-- How much carrying an egg slows the player (1 = not at all).
function GamePasses.carrySlowdown(_player: Player): number
	return 0.9
end

return GamePasses
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">HouseModel</string>
          <string name="Source"><![CDATA[-- Builds houses and house parts out of simple parts, in the game's chunky cartoon style.
--
-- HouseModel.house(parts) builds a whole house: parts = { [slotId] = partId } (missing slots
-- get Basic). It's built at the origin with its front facing -Z: the front wall sits on
-- z = 0 and the yard (porch, garden, mailbox, fence) is in front of it, all inside a
-- 64 x 64 plot centred on the origin. Every slot's pieces go in a Model named after the slot
-- (with a "Part" attribute), so a slot can be rebuilt on its own (HouseModel.slot).
--
-- HouseModel.item(partId) builds one part on its own at carrying size (about 5 studs), for
-- the zone piles, carrying over your head and the UI pictures.

local Lego = require(script.Parent.Lego)
local Parts = require(script.Parent.Parts)

local HouseModel = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local M = Enum.Material

-- How each style looks. Flags add each style's signature details.
local LOOKS = {
	Basic = {
		wall = rgb(238, 224, 196),
		trim = rgb(255, 255, 255),
		roof = rgb(205, 85, 70),
		door = rgb(160, 100, 60),
		glass = rgb(150, 210, 255),
		accent = rgb(90, 175, 90),
		shape = "gable",
		shutters = true,
	},
	Scrap = {
		wall = rgb(120, 160, 175),
		wallMat = M.CorrodedMetal,
		trim = rgb(120, 122, 130),
		trimMat = M.Metal,
		roof = rgb(200, 120, 70),
		roofMat = M.CorrodedMetal,
		door = rgb(195, 160, 110),
		doorMat = M.WoodPlanks,
		glass = rgb(150, 200, 180),
		accent = rgb(60, 170, 170),
		shape = "gable",
		patches = true,
	},
	Log = {
		wall = rgb(160, 100, 55),
		wallMat = M.Wood,
		trim = rgb(110, 68, 35),
		trimMat = M.Wood,
		roof = rgb(70, 125, 70),
		roofMat = M.WoodPlanks,
		door = rgb(125, 72, 40),
		doorMat = M.WoodPlanks,
		glass = rgb(255, 225, 140),
		accent = rgb(215, 60, 50),
		shape = "gable",
		logs = true,
		shutters = true,
	},
	Stone = {
		wall = rgb(165, 165, 170),
		wallMat = M.Cobblestone,
		trim = rgb(115, 115, 122),
		trimMat = M.Slate,
		roof = rgb(75, 90, 135),
		roofMat = M.Slate,
		door = rgb(120, 80, 50),
		doorMat = M.WoodPlanks,
		glass = rgb(160, 210, 255),
		accent = rgb(70, 160, 70),
		shape = "gable",
		ivy = true,
	},
	Sand = {
		wall = rgb(242, 208, 148),
		wallMat = M.Sandstone,
		trim = rgb(250, 238, 205),
		trimMat = M.Sandstone,
		roof = rgb(45, 195, 205),
		door = rgb(130, 60, 150),
		glass = rgb(110, 220, 255),
		accent = rgb(255, 200, 50),
		accentMat = M.Foil,
		shape = "dome",
		arched = true,
	},
	Ice = {
		wall = rgb(125, 205, 255),
		wallMat = M.Ice,
		trim = rgb(235, 250, 255),
		trimMat = M.Snow,
		roof = rgb(250, 252, 255),
		roofMat = M.Snow,
		door = rgb(80, 165, 230),
		glass = rgb(120, 240, 255),
		glassMat = M.Neon,
		accent = rgb(110, 225, 255),
		accentMat = M.Neon,
		shape = "gable",
		icicles = true,
	},
	Candy = {
		wall = rgb(255, 160, 205),
		trim = rgb(255, 255, 255),
		roof = rgb(120, 65, 40),
		door = rgb(110, 230, 185),
		glass = rgb(255, 240, 150),
		accent = rgb(255, 70, 110),
		shape = "gable",
		stripes = true,
		icing = true,
	},
	Lava = {
		wall = rgb(50, 38, 55),
		wallMat = M.Basalt,
		trim = rgb(255, 115, 30),
		trimMat = M.Neon,
		roof = rgb(32, 26, 38),
		roofMat = M.Basalt,
		door = rgb(90, 30, 20),
		glass = rgb(255, 150, 40),
		glassMat = M.Neon,
		accent = rgb(255, 80, 20),
		accentMat = M.Neon,
		shape = "pointy",
		cracks = true,
	},
	Royal = {
		wall = rgb(245, 240, 230),
		wallMat = M.Marble,
		trim = rgb(255, 200, 60),
		trimMat = M.Foil,
		roof = rgb(55, 85, 215),
		door = rgb(160, 30, 55),
		glass = rgb(150, 210, 255),
		accent = rgb(225, 40, 60),
		shape = "castle",
		arched = true,
	},
	Crystal = {
		wall = rgb(165, 110, 255),
		wallMat = M.Glass,
		trim = rgb(110, 240, 255),
		trimMat = M.Neon,
		roof = rgb(205, 145, 255),
		roofMat = M.Glass,
		door = rgb(90, 50, 185),
		glass = rgb(225, 195, 255),
		glassMat = M.Neon,
		accent = rgb(120, 255, 235),
		accentMat = M.Neon,
		shape = "spikes",
		arched = true,
		gems = true,
	},
	Cloud = {
		wall = rgb(250, 250, 255),
		trim = rgb(255, 215, 90),
		trimMat = M.Foil,
		roof = rgb(150, 205, 255),
		door = rgb(255, 245, 210),
		glass = rgb(200, 235, 255),
		accent = rgb(255, 255, 255),
		shape = "dome",
		arched = true,
		clouds = true,
	},
	Rainbow = {
		wall = rgb(255, 255, 255),
		trim = rgb(255, 255, 255),
		trimMat = M.Neon,
		roof = rgb(255, 90, 160),
		door = rgb(120, 90, 255),
		glass = rgb(255, 255, 200),
		glassMat = M.Neon,
		accent = rgb(255, 230, 80),
		accentMat = M.Neon,
		shape = "pointy",
		rainbow = true,
	},
}
HouseModel.LOOKS = LOOKS

local RAINBOW = {
	rgb(255, 70, 90),
	rgb(255, 150, 40),
	rgb(255, 225, 50),
	rgb(80, 220, 100),
	rgb(60, 170, 255),
	rgb(150, 90, 255),
}

-- Full-size house measurements (the item versions are smaller).
local BODY = { w = 30, d = 20, h = 13 }
local BASE = 1 -- foundation height
HouseModel.BODY = BODY

--------------------------------------------------------------------------------
-- Building blocks
--------------------------------------------------------------------------------

local function block(model: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or M.SmoothPlastic
	if p.Material == M.Glass then
		p.Transparency = 0.2
	end
	p.Parent = model
	return p
end

-- A solid block (walls and floors people bump into).
local function solid(model, size, cframe, color, material)
	local p = block(model, size, cframe, color, material)
	p.CanCollide = true
	return p
end

local function ball(model, size: Vector3 | number, cframe: CFrame, color: Color3, material: Enum.Material?)
	local vector = if typeof(size) == "number" then Vector3.one * size else size
	local p = block(model, vector, cframe, color, material)
	if vector.X == vector.Y and vector.Y == vector.Z then
		p.Shape = Enum.PartType.Ball
	else
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	return p
end

-- A cylinder standing up, its base centred on `cframe`.
local function post(model, height: number, diameter: number, cframe: CFrame, color: Color3, material)
	local p = block(
		model,
		Vector3.new(height, diameter, diameter),
		cframe * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
		color,
		material
	)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- A cylinder lying along the cframe's X axis.
local function rod(model, length: number, diameter: number, cframe: CFrame, color: Color3, material)
	local p = block(model, Vector3.new(length, diameter, diameter), cframe, color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function wedge(model, size: Vector3, cframe: CFrame, color: Color3, material)
	local p = Instance.new("WedgePart")
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or M.SmoothPlastic
	if p.Material == M.Glass then
		p.Transparency = 0.2
	end
	p.Parent = model
	return p
end

-- A cone made of stacked discs (tower tops, spires).
local function cone(model, height: number, diameter: number, cframe: CFrame, color: Color3, material, steps: number?)
	local n = steps or 6
	for i = 0, n - 1 do
		local d = diameter * (1 - i / n)
		post(model, height / n + 0.02, d, cframe * CFrame.new(0, i * height / n, 0), color, material)
	end
	ball(model, diameter * 0.18, cframe * CFrame.new(0, height, 0), color, material)
end

local function puff(model, cframe: CFrame, size: number, color: Color3?)
	local white = color or rgb(255, 255, 255)
	ball(model, size, cframe, white)
	ball(model, size * 0.75, cframe * CFrame.new(size * 0.55, -size * 0.1, 0), white)
	ball(model, size * 0.7, cframe * CFrame.new(-size * 0.55, -size * 0.12, 0), white)
end

local function rainbowColor(i: number): Color3
	return RAINBOW[(i - 1) % #RAINBOW + 1]
end

-- A style's look, with any mutation's tint applied (Golden turns the main colours gold...).
local function lookFor(styleId: string)
	return LOOKS[styleId] or LOOKS.Basic
end

--------------------------------------------------------------------------------
-- Slot builders. Each takes (model, cf, look, size): cf is where the piece stands (its
-- ground point, facing -Z), size is how big to build it.
--------------------------------------------------------------------------------

local builders = {}

-- Walls: the house body. size = { w, d, h } (the front face is at cf's z = 0).
function builders.Walls(model, cf: CFrame, look, size)
	local w, d, h = size.w, size.d, size.h
	local base = size.base or BASE
	local trimMat = look.trimMat
	solid(
		model,
		Vector3.new(w + 1, base, d + 1),
		cf * CFrame.new(0, base / 2, d / 2),
		look.trim:Lerp(rgb(0, 0, 0), 0.25),
		trimMat
	)
	local body = solid(model, Vector3.new(w, h, d), cf * CFrame.new(0, base + h / 2, d / 2), look.wall, look.wallMat)
	body.Name = "Body"
	-- Corner posts and a band along the top.
	local t = math.max(0.8, w / 25)
	for _, x in { -w / 2, w / 2 } do
		for _, z in { 0, d } do
			block(model, Vector3.new(t, h, t), cf * CFrame.new(x, base + h / 2, z), look.trim, trimMat)
		end
	end
	block(model, Vector3.new(w + t, t * 0.8, t), cf * CFrame.new(0, base + h - t * 0.4, 0), look.trim, trimMat)
	block(model, Vector3.new(w + t, t * 0.8, t), cf * CFrame.new(0, base + h - t * 0.4, d), look.trim, trimMat)
	local front = -0.08 -- just in front of the front face

	-- LEGO bricks: seams between the courses and staggered joints, on the front and sides.
	if Lego.ENABLED and not look.logs and not look.stripes and not look.rainbow and look.wallMat ~= M.Glass then
		local seam = look.wall:Lerp(rgb(0, 0, 0), 0.22)
		local course = math.max(0.6, math.min(1.2, h / 4))
		local brick = course * 3.2
		local rows = math.floor(h / course)
		local faces = {
			{ cf * CFrame.new(0, 0, -0.03), w }, -- front
			{ cf * CFrame.new(w / 2 + 0.03, 0, d / 2) * CFrame.Angles(0, -math.pi / 2, 0), d }, -- right side
			{ cf * CFrame.new(-w / 2 - 0.03, 0, d / 2) * CFrame.Angles(0, math.pi / 2, 0), d }, -- left side
		}
		for _, face in faces do
			local faceCf, width = face[1], face[2]
			for row = 1, rows - 1 do
				block(model, Vector3.new(width, 0.1, 0.06), faceCf * CFrame.new(0, base + row * course, 0), seam).Name =
					"Seam"
			end
			for row = 0, rows - 1 do
				local shift = if row % 2 == 0 then 0 else brick / 2
				local x = -width / 2 + shift + brick
				while x < width / 2 - 0.2 do
					block(
						model,
						Vector3.new(0.1, course, 0.06),
						faceCf * CFrame.new(x, base + (row + 0.5) * course, 0),
						seam
					).Name =
						"Seam"
					x += brick
				end
			end
		end
	end

	if look.logs then
		-- Logs stacked up the front with their round ends poking out at the corners.
		local rows = math.floor(h / (t * 1.2))
		for i = 0, rows - 1 do
			local y = base + (i + 0.5) * h / rows
			rod(
				model,
				w + t * 1.6,
				h / rows * 0.95,
				cf * CFrame.new(0, y, front),
				look.wall:Lerp(rgb(80, 45, 20), (i % 2) * 0.2),
				M.Wood
			)
		end
	end
	if look.stripes or look.rainbow then
		-- Candy stripes (or rainbow bands) up the walls.
		local count = math.max(3, math.floor(w / 3))
		for i = 1, count - 1, 2 do
			local x = -w / 2 + i * w / count
			local color = if look.rainbow then rainbowColor(i) else look.trim
			block(
				model,
				Vector3.new(w / count, h - t, 0.2),
				cf * CFrame.new(x, base + h / 2 - t * 0.4, front),
				color,
				if look.rainbow then M.Neon else nil
			)
		end
	end
	if look.patches then
		-- Mismatched sheets of scrap riveted on.
		local spots =
			{ { -0.3, 0.3, rgb(120, 160, 170) }, { 0.32, 0.65, rgb(200, 150, 80) }, { 0.05, 0.75, rgb(140, 140, 150) } }
		for _, s in spots do
			block(
				model,
				Vector3.new(w * 0.22, h * 0.25, 0.2),
				cf * CFrame.new(s[1] * w, base + s[2] * h, front) * CFrame.Angles(0, 0, math.rad(s[1] * 20)),
				s[3],
				M.CorrodedMetal
			)
		end
	end
	if look.ivy then
		for i = 0, 5 do
			ball(
				model,
				Vector3.new(w * 0.09, h * 0.12, 0.4),
				cf * CFrame.new(-w / 2 + t + (i % 3) * w * 0.06, base + h * (0.2 + i * 0.13), front),
				look.accent:Lerp(rgb(30, 90, 30), (i % 2) * 0.3)
			)
		end
	end
	if look.cracks then
		for i, s in { { -0.35, 0.3, 25 }, { 0.3, 0.55, -30 }, { -0.1, 0.8, 70 } } do
			block(
				model,
				Vector3.new(w * 0.14, 0.25, 0.2),
				cf * CFrame.new(s[1] * w, base + s[2] * h, front) * CFrame.Angles(0, 0, math.rad(s[3] + i)),
				look.accent,
				M.Neon
			)
		end
	end
	if look.gems then
		for i, x in { -0.4, 0.4 } do
			block(
				model,
				Vector3.new(t * 1.2, t * 2.4, 0.6),
				cf * CFrame.new(x * w, base + h * 0.5, front) * CFrame.Angles(0, 0, math.rad(45 * i)),
				look.accent,
				M.Neon
			)
		end
	end
	if look.clouds then
		for _, x in { -w / 2, w / 2 } do
			puff(model, cf * CFrame.new(x, base + 0.4, -0.3), t * 2.2)
		end
	end
	if look.icicles then
		for i = 0, math.floor(w / 2.5) do
			local x = -w / 2 + i * 2.5
			wedge(
				model,
				Vector3.new(0.4, 1 + (i % 3) * 0.6, 0.5),
				cf * CFrame.new(x, base + h - t - 0.5 - (i % 3) * 0.3, front) * CFrame.Angles(math.pi, 0, 0),
				look.accent,
				M.Ice
			)
		end
	end
end

-- Roof: sits on top of walls of size { w, d } at height y. size = { w, d, y }.
function builders.Roof(model, cf: CFrame, look, size)
	local w, d, y = size.w, size.d, size.y
	local mat = look.roofMat
	local shape = look.shape
	local center = cf * CFrame.new(0, y, d / 2)
	local over = math.max(0.6, w / 20) -- overhang

	if shape == "gable" or shape == "pointy" then
		local rise = if shape == "pointy" then d * 0.85 else d * 0.42
		local half = d / 2 + over
		-- Two wedges meeting at the ridge (along X).
		for _, side in { 1, -1 } do
			local color = look.roof:Lerp(rgb(0, 0, 0), if side == 1 then 0 else 0.12)
			if look.rainbow then
				color = rainbowColor(if side == 1 then 1 else 4)
			end
			wedge(
				model,
				Vector3.new(w + over * 2, rise, half),
				center * CFrame.Angles(0, if side == 1 then 0 else math.pi, 0) * CFrame.new(0, rise / 2, -half / 2),
				color,
				mat
			)
		end
		-- Eaves trim and a ridge cap.
		rod(model, w + over * 2.4, math.max(0.6, w / 22), center * CFrame.new(0, rise, 0), look.trim, look.trimMat)
		-- Gable-end triangles in wall colour fill the space above the walls.
		if look.icing then
			-- Icing dripping down the front edge.
			for i = 0, math.floor((w + over * 2) / 1.6) do
				local x = -w / 2 - over + i * 1.6
				ball(
					model,
					Vector3.new(1.3, 0.9 + (i % 2) * 0.8, 0.8),
					center * CFrame.new(x, 0.1, -half + 0.2),
					rgb(255, 255, 255)
				)
			end
			for i = 0, 4 do
				ball(
					model,
					0.55,
					center * CFrame.new(-w * 0.35 + i * w * 0.18, rise * 0.55, -half * 0.45),
					rainbowColor(i + 1)
				)
			end
		end
		if look.icicles or shape == "gable" and look.wallMat == M.Ice then
			for i = 0, math.floor((w + over * 2) / 1.8) do
				wedge(
					model,
					Vector3.new(0.35, 0.9 + (i % 3) * 0.5, 0.45),
					center * CFrame.new(-w / 2 - over + i * 1.8, -0.5, -half) * CFrame.Angles(math.pi, 0, 0),
					look.accent,
					M.Ice
				)
			end
		end
		if shape == "pointy" then
			-- Little spires at each end of the ridge.
			for _, x in { -w / 2, w / 2 } do
				cone(
					model,
					rise * 0.5,
					math.max(1, w / 12),
					center * CFrame.new(x, rise, 0),
					look.accent,
					look.accentMat,
					5
				)
			end
		end
	elseif shape == "dome" then
		solid(
			model,
			Vector3.new(w + over * 2, math.max(0.6, w / 30), d + over * 2),
			center * CFrame.new(0, 0.3, 0),
			look.trim,
			look.trimMat
		)
		local r = math.min(w, d) * 0.8
		post(model, r * 0.25, r, center * CFrame.new(0, 0.5, 0), look.trim, look.trimMat)
		ball(model, Vector3.new(r, r * 0.95, r), center * CFrame.new(0, 0.5 + r * 0.25, 0), look.roof, look.roofMat)
		cone(model, r * 0.45, r * 0.12, center * CFrame.new(0, 0.5 + r * 0.7, 0), look.accent, look.accentMat, 4)
		-- Two small domes on the corners.
		for _, x in { -w / 2 + w * 0.1, w / 2 - w * 0.1 } do
			ball(model, w * 0.16, center * CFrame.new(x, 0.6 + w * 0.05, -d / 2 + d * 0.15), look.roof, look.roofMat)
		end
		if look.clouds then
			for _, x in { -w * 0.35, 0, w * 0.35 } do
				puff(model, center * CFrame.new(x, 0.6, -d / 2), w * 0.09)
			end
			-- A golden halo floating over the dome.
			local halo = block(
				model,
				Vector3.new(0.3, r * 0.55, r * 0.55),
				center * CFrame.new(0, 0.5 + r * 1.3, 0) * CFrame.Angles(0, 0, math.pi / 2),
				look.trim,
				M.Neon
			)
			halo.Shape = Enum.PartType.Cylinder
			block(
				model,
				Vector3.new(0.32, r * 0.4, r * 0.4),
				center * CFrame.new(0, 0.5 + r * 1.3, 0) * CFrame.Angles(0, 0, math.pi / 2),
				look.roof
			).Shape =
				Enum.PartType.Cylinder
		end
	elseif shape == "castle" then
		local slab = math.max(0.8, w / 25)
		solid(
			model,
			Vector3.new(w + over * 2, slab, d + over * 2),
			center * CFrame.new(0, slab / 2, 0),
			look.wall,
			look.wallMat
		)
		block(
			model,
			Vector3.new(w + over * 2 + 0.2, slab * 0.5, d + over * 2 + 0.2),
			center * CFrame.new(0, slab * 0.25, 0),
			look.trim,
			look.trimMat
		)
		-- Battlements round the edge.
		local merlon = math.max(1.2, w / 12)
		local count = math.floor((w + over * 2) / (merlon * 2))
		for i = 0, count do
			local x = -w / 2 - over + i * (w + over * 2) / count
			for _, z in { -d / 2 - over, d / 2 + over } do
				block(
					model,
					Vector3.new(merlon, merlon, merlon * 0.8),
					center * CFrame.new(x, slab + merlon / 2, z),
					look.wall,
					look.wallMat
				)
			end
		end
		-- A pointed blue keep roof and flags.
		local keep = math.min(w, d) * 0.5
		post(model, keep * 0.7, keep, center * CFrame.new(0, slab, 0), look.wall, look.wallMat)
		cone(model, keep * 1.1, keep * 1.15, center * CFrame.new(0, slab + keep * 0.7, 0), look.roof, look.roofMat, 7)
		post(
			model,
			keep * 0.9,
			math.max(0.2, w / 120),
			center * CFrame.new(0, slab + keep * 1.8, 0),
			look.trim,
			look.trimMat
		)
		block(
			model,
			Vector3.new(keep * 0.5, keep * 0.28, 0.1),
			center * CFrame.new(keep * 0.25, slab + keep * 2.5, 0),
			look.accent
		)
	elseif shape == "spikes" then
		local slab = math.max(0.8, w / 25)
		solid(
			model,
			Vector3.new(w + over * 2, slab, d + over * 2),
			center * CFrame.new(0, slab / 2, 0),
			look.roof,
			look.roofMat
		)
		-- A cluster of crystal spikes, tallest in the middle.
		local spikes = {
			{ 0, 0, 1, 0 },
			{ -0.28, 0.1, 0.7, -14 },
			{ 0.3, -0.1, 0.75, 12 },
			{ -0.12, -0.25, 0.55, -8 },
			{ 0.15, 0.25, 0.6, 9 },
			{ -0.42, -0.2, 0.45, -20 },
			{ 0.42, 0.2, 0.45, 18 },
		}
		local tall = math.min(w, d) * 0.9
		for i, s in spikes do
			local height = tall * s[3]
			local thick = math.max(0.8, w / 9) * (0.6 + s[3] * 0.4)
			local spot = center
				* CFrame.new(s[1] * w, slab, s[2] * d)
				* CFrame.Angles(math.rad(s[2] * 30), 0, math.rad(s[4]))
			local color = if i % 2 == 0 then look.accent else look.roof
			block(
				model,
				Vector3.new(thick, height, thick),
				spot * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, math.rad(45), 0),
				color,
				if i % 2 == 0 then M.Neon else M.Glass
			)
			-- A point on top.
			wedge(
				model,
				Vector3.new(thick, thick, thick * 0.7),
				spot * CFrame.new(0, height + thick / 2, 0) * CFrame.Angles(0, math.rad(45), 0),
				color,
				if i % 2 == 0 then M.Neon else M.Glass
			)
		end
	end
end

-- Door: size = { w, h } (the door slab); cf is the bottom middle of the doorway.
function builders.Door(model, cf: CFrame, look, size)
	local w, h = size.w, size.h
	local frame = math.max(0.4, w / 9)
	block(
		model,
		Vector3.new(w + frame * 2, h + frame, 0.6),
		cf * CFrame.new(0, (h + frame) / 2, -0.15),
		look.trim,
		look.trimMat
	)
	local doorColor = look.door
	local slab = block(model, Vector3.new(w, h, 0.5), cf * CFrame.new(0, h / 2, -0.35), doorColor, look.doorMat)
	slab.Name = "DoorSlab"
	if look.arched then
		-- A round arch over the door.
		local arch = block(
			model,
			Vector3.new(0.62, w + frame * 2, w + frame * 2),
			cf * CFrame.new(0, h, -0.15) * CFrame.Angles(0, math.pi / 2, 0),
			look.trim,
			look.trimMat
		)
		arch.Shape = Enum.PartType.Cylinder
		local inner = block(
			model,
			Vector3.new(0.52, w, w),
			cf * CFrame.new(0, h, -0.35) * CFrame.Angles(0, math.pi / 2, 0),
			doorColor,
			look.doorMat
		)
		inner.Shape = Enum.PartType.Cylinder
	end
	-- Panels and a knob.
	for _, y in { 0.28, 0.68 } do
		block(
			model,
			Vector3.new(w * 0.62, h * 0.26, 0.12),
			cf * CFrame.new(0, h * y, -0.62),
			doorColor:Lerp(rgb(0, 0, 0), 0.18),
			look.doorMat
		)
	end
	ball(
		model,
		math.max(0.4, w / 7),
		cf * CFrame.new(w * 0.32, h * 0.47, -0.7),
		look.accent,
		if look.accentMat == M.Neon then M.Neon else M.Foil
	)
	if look.stripes or look.rainbow then
		for i = 0, 3 do
			block(
				model,
				Vector3.new(w * 0.2, h * 0.95, 0.1),
				cf * CFrame.new(-w * 0.3 + i * w * 0.2, h / 2, -0.6) * CFrame.Angles(0, 0, math.rad(25)),
				if look.rainbow then rainbowColor(i + 1) else look.trim
			)
		end
	end
	if look.gems or look.cracks then
		block(
			model,
			Vector3.new(w * 0.25, w * 0.25, 0.3),
			cf * CFrame.new(0, h * 0.85, -0.65) * CFrame.Angles(0, 0, math.rad(45)),
			look.accent,
			M.Neon
		)
	end
	if look.clouds then
		puff(model, cf * CFrame.new(0, h + frame, -0.5), w * 0.35)
	end
end

-- One window: size = { w, h }; cf is the window's centre on the wall face.
local function window(model, cf: CFrame, look, w: number, h: number)
	local frame = math.max(0.3, w / 10)
	block(model, Vector3.new(w + frame * 2, h + frame * 2, 0.5), cf * CFrame.new(0, 0, -0.1), look.trim, look.trimMat)
	local glass = block(model, Vector3.new(w, h, 0.3), cf * CFrame.new(0, 0, -0.3), look.glass, look.glassMat)
	glass.Name = "Glass"
	if look.arched then
		local arch = block(
			model,
			Vector3.new(0.5, w + frame * 2, w + frame * 2),
			cf * CFrame.new(0, h / 2, -0.1) * CFrame.Angles(0, math.pi / 2, 0),
			look.trim,
			look.trimMat
		)
		arch.Shape = Enum.PartType.Cylinder
		local top = block(
			model,
			Vector3.new(0.3, w, w),
			cf * CFrame.new(0, h / 2, -0.3) * CFrame.Angles(0, math.pi / 2, 0),
			look.glass,
			look.glassMat
		)
		top.Shape = Enum.PartType.Cylinder
	end
	-- Cross bars.
	block(model, Vector3.new(frame * 0.6, h, 0.2), cf * CFrame.new(0, 0, -0.5), look.trim, look.trimMat)
	block(model, Vector3.new(w, frame * 0.6, 0.2), cf * CFrame.new(0, 0, -0.5), look.trim, look.trimMat)
	-- A sill.
	block(
		model,
		Vector3.new(w + frame * 3, frame, 0.9),
		cf * CFrame.new(0, -h / 2 - frame, -0.35),
		look.trim,
		look.trimMat
	)
	if look.shutters then
		for _, s in { -1, 1 } do
			block(
				model,
				Vector3.new(w * 0.45, h + frame * 2, 0.25),
				cf * CFrame.new(s * (w / 2 + frame + w * 0.25), 0, -0.2),
				look.accent:Lerp(rgb(0, 0, 0), 0.1)
			)
		end
	end
	if look.icing or look.clouds then
		for i = 0, 2 do
			ball(
				model,
				w * 0.28,
				cf * CFrame.new(-w * 0.35 + i * w * 0.35, -h / 2 - frame * 1.6, -0.5),
				if look.icing then rainbowColor(i * 2 + 1) else rgb(255, 255, 255)
			)
		end
	end
	if look.ivy then
		ball(model, Vector3.new(w * 0.8, w * 0.35, 0.5), cf * CFrame.new(0, -h / 2 - frame * 1.6, -0.6), look.accent)
		for i = 0, 2 do
			ball(
				model,
				w * 0.18,
				cf * CFrame.new(-w * 0.3 + i * w * 0.3, -h / 2 - frame * 1.2, -0.85),
				rgb(255, 120, 160)
			)
		end
	end
end

-- Windows: two on the front and one on each side of a house of size { w, d, h }, or (for
-- the item version, size.single) just one.
function builders.Windows(model, cf: CFrame, look, size)
	if size.single then
		window(model, cf * CFrame.new(0, size.wh / 2 + 0.6, 0), look, size.ww, size.wh)
		return
	end
	local w, d, h = size.w, size.d, size.h
	local y = BASE + h * 0.58
	for _, x in { -w * 0.3, w * 0.3 } do
		window(model, cf * CFrame.new(x, y, 0), look, 5, 5)
	end
	for _, s in { -1, 1 } do
		window(model, cf * CFrame.new(s * w / 2, y, d / 2) * CFrame.Angles(0, s * math.pi / 2, 0), look, 5, 5)
	end
end

-- Chimney: cf is its base (inside the roof); size = { h, s } height and width.
function builders.Chimney(model, cf: CFrame, look, size)
	local h, s = size.h, size.s
	if look.shape == "dome" or look.clouds then
		-- A tall slender minaret-style chimney.
		post(model, h, s, cf, look.wall, look.wallMat)
		post(model, s * 0.2, s * 1.35, cf * CFrame.new(0, h, 0), look.trim, look.trimMat)
		ball(model, s * 1.1, cf * CFrame.new(0, h + s * 0.5, 0), look.roof, look.roofMat)
	elseif look.wallMat == M.CorrodedMetal then
		-- A crooked pipe.
		post(model, h, s * 0.8, cf, look.trim, M.Metal)
		post(model, s * 0.4, s * 1.1, cf * CFrame.new(0, h - s * 0.4, 0), look.accent, M.Metal)
		block(
			model,
			Vector3.new(s * 1.3, s * 0.2, s * 1.3),
			cf * CFrame.new(0, h + s * 0.5, 0) * CFrame.Angles(0, 0, math.rad(12)),
			look.trim,
			M.Metal
		)
	else
		local color = if look.stripes
			then look.trim
			else look.wall:Lerp(rgb(160, 60, 50), if look.wallMat then 0 else 0.7)
		solid(model, Vector3.new(s, h, s), cf * CFrame.new(0, h / 2, 0), color, look.wallMat or M.Brick)
		block(model, Vector3.new(s * 1.3, s * 0.3, s * 1.3), cf * CFrame.new(0, h, 0), look.trim, look.trimMat)
		if look.stripes or look.rainbow then
			for i = 0, 3 do
				block(
					model,
					Vector3.new(s * 1.04, s * 0.25, s * 1.04),
					cf * CFrame.new(0, h * (0.2 + i * 0.2), 0),
					if look.rainbow then rainbowColor(i + 1) else look.accent
				)
			end
		end
	end
	-- What comes out of the top.
	if look.cracks then
		ball(model, s * 0.9, cf * CFrame.new(0, h + s * 0.5, 0), look.accent, M.Neon)
	elseif look.icicles then
		ball(
			model,
			Vector3.new(s * 1.4, s * 0.5, s * 1.4),
			cf * CFrame.new(0, h + s * 0.25, 0),
			rgb(255, 255, 255),
			M.Snow
		)
	elseif look.gems then
		block(
			model,
			Vector3.new(s * 0.5, s * 1.2, s * 0.5),
			cf * CFrame.new(0, h + s * 0.6, 0) * CFrame.Angles(0, math.rad(45), 0),
			look.accent,
			M.Neon
		)
	elseif not (look.shape == "dome") then
		for i = 0, 2 do
			ball(
				model,
				s * (0.6 + i * 0.25),
				cf * CFrame.new(i * s * 0.35, h + s * (0.7 + i * 0.75), 0),
				rgb(235, 235, 240)
			)
		end
	end
end

-- Porch: steps, a floor, two posts and a canopy in front of the door. size = { w, h }
-- (h = height of the canopy).
function builders.Porch(model, cf: CFrame, look, size)
	local w, h = size.w, size.h
	local depth = w * 0.5
	local floorY = size.floor or BASE
	solid(
		model,
		Vector3.new(w, floorY, depth),
		cf * CFrame.new(0, floorY / 2, -depth / 2),
		look.trim:Lerp(rgb(0, 0, 0), 0.15),
		look.trimMat
	)
	-- Two steps.
	for i = 1, 2 do
		solid(
			model,
			Vector3.new(w * 0.55, floorY * (1 - i * 0.33), depth * 0.18),
			cf * CFrame.new(0, floorY * (1 - i * 0.33) / 2, -depth - depth * 0.18 * (i - 0.5)),
			look.trim,
			look.trimMat
		)
	end
	-- Posts.
	for _, s in { -1, 1 } do
		local spot = cf * CFrame.new(s * (w / 2 - w * 0.06), floorY, -depth + w * 0.06)
		if look.stripes then
			post(model, h - floorY, w * 0.08, spot, look.trim)
			for i = 0, 4 do
				block(
					model,
					Vector3.new(w * 0.085, (h - floorY) * 0.06, w * 0.085),
					spot * CFrame.new(0, (h - floorY) * (0.1 + i * 0.2), 0),
					look.accent
				)
			end
		elseif look.arched or look.trimMat == M.Foil then
			post(model, h - floorY, w * 0.09, spot, look.wall, look.wallMat)
			post(model, w * 0.03, w * 0.13, spot, look.trim, look.trimMat)
			post(model, w * 0.03, w * 0.13, spot * CFrame.new(0, h - floorY - w * 0.03, 0), look.trim, look.trimMat)
		elseif look.wallMat == M.Wood then
			post(model, h - floorY, w * 0.09, spot, look.trim, M.Wood)
		else
			block(
				model,
				Vector3.new(w * 0.07, h - floorY, w * 0.07),
				spot * CFrame.new(0, (h - floorY) / 2, 0),
				look.trim,
				look.trimMat
			)
		end
	end
	-- Canopy, sloping down to the front.
	local canopy = cf * CFrame.new(0, h, -depth / 2) * CFrame.Angles(math.rad(-12), 0, 0)
	block(model, Vector3.new(w + w * 0.08, w * 0.04, depth * 1.15), canopy, look.roof, look.roofMat)
	block(
		model,
		Vector3.new(w + w * 0.1, w * 0.05, w * 0.05),
		canopy * CFrame.new(0, 0, -depth * 0.58),
		look.trim,
		look.trimMat
	)
	if look.clouds or look.icing then
		for i = 0, 3 do
			ball(
				model,
				w * 0.16,
				canopy * CFrame.new(-w * 0.4 + i * w * 0.27, w * 0.05, -depth * 0.5),
				if look.icing then rgb(255, 255, 255) else rgb(255, 255, 255)
			)
		end
	end
	if look.cracks or look.gems or look.rainbow then
		-- Glowing lanterns on the posts.
		for _, s in { -1, 1 } do
			ball(
				model,
				w * 0.1,
				cf * CFrame.new(s * (w / 2 - w * 0.06), h - w * 0.12, -depth + w * 0.06),
				look.accent,
				M.Neon
			)
		end
	end
end

-- Tower: a round tower standing beside the house. size = { r, h } radius and height.
function builders.Tower(model, cf: CFrame, look, size)
	local d, h = size.r * 2, size.h
	post(model, h, d, cf, look.wall, look.wallMat)
	post(model, d * 0.06, d * 1.08, cf, look.trim:Lerp(rgb(0, 0, 0), 0.2), look.trimMat)
	-- Bands of trim and a couple of windows.
	for _, y in { 0.45, 0.98 } do
		post(model, d * 0.05, d * 1.06, cf * CFrame.new(0, h * y, 0), look.trim, look.trimMat)
	end
	for _, y in { 0.3, 0.7 } do
		block(
			model,
			Vector3.new(d * 0.22, d * 0.32, d * 0.1),
			cf * CFrame.new(0, h * y, -d / 2),
			look.trim,
			look.trimMat
		)
		block(
			model,
			Vector3.new(d * 0.15, d * 0.25, d * 0.1),
			cf * CFrame.new(0, h * y, -d / 2 - 0.05),
			look.glass,
			look.glassMat
		)
	end
	if look.logs then
		for i = 0, 6 do
			post(
				model,
				h / 8,
				d * 1.02,
				cf * CFrame.new(0, i * h / 7, 0),
				look.wall:Lerp(rgb(80, 45, 20), (i % 2) * 0.2),
				M.Wood
			)
		end
	end
	if look.stripes or look.rainbow then
		for i = 0, 5 do
			post(
				model,
				h / 14,
				d * 1.03,
				cf * CFrame.new(0, h * (0.08 + i * 0.15), 0),
				if look.rainbow then rainbowColor(i + 1) else look.trim,
				if look.rainbow then M.Neon else nil
			)
		end
	end
	if look.cracks then
		for i = 0, 2 do
			block(
				model,
				Vector3.new(d * 0.08, h * 0.25, d * 0.1),
				cf
					* CFrame.new(d * 0.2 * (i - 1), h * (0.25 + i * 0.22), -d / 2)
					* CFrame.Angles(0, 0, math.rad(20 * (i - 1))),
				look.accent,
				M.Neon
			)
		end
	end
	local top = cf * CFrame.new(0, h, 0)
	if look.shape == "castle" then
		post(model, d * 0.15, d * 1.2, top, look.wall, look.wallMat)
		for i = 0, 7 do
			local a = math.rad(i * 45)
			block(
				model,
				Vector3.new(d * 0.2, d * 0.2, d * 0.2),
				top * CFrame.new(math.sin(a) * d * 0.55, d * 0.25, math.cos(a) * d * 0.55),
				look.wall,
				look.wallMat
			)
		end
		cone(model, d * 0.9, d * 0.7, top * CFrame.new(0, d * 0.15, 0), look.roof, look.roofMat, 6)
		post(model, d * 0.5, d * 0.04, top * CFrame.new(0, d * 1.05, 0), look.trim, look.trimMat)
		block(model, Vector3.new(d * 0.3, d * 0.16, 0.1), top * CFrame.new(d * 0.15, d * 1.45, 0), look.accent)
	elseif look.shape == "dome" then
		post(model, d * 0.1, d * 1.15, top, look.trim, look.trimMat)
		ball(model, d * 0.95, top * CFrame.new(0, d * 0.15, 0), look.roof, look.roofMat)
		cone(model, d * 0.5, d * 0.12, top * CFrame.new(0, d * 0.55, 0), look.accent, look.accentMat, 4)
	elseif look.shape == "spikes" then
		post(model, d * 0.1, d * 1.1, top, look.roof, look.roofMat)
		for i, s in { { 0, 1 }, { -0.25, 0.6 }, { 0.25, 0.65 } } do
			local height = d * 1.2 * s[2]
			block(
				model,
				Vector3.new(d * 0.22, height, d * 0.22),
				top * CFrame.new(s[1] * d, height / 2, 0) * CFrame.Angles(0, math.rad(45), math.rad(s[1] * 40)),
				if i == 1 then look.accent else look.roof,
				if i == 1 then M.Neon else M.Glass
			)
		end
	else
		-- A pointed cone roof that overhangs.
		local color = if look.rainbow then rainbowColor(5) else look.roof
		cone(model, d * (if look.shape == "pointy" then 1.4 else 0.9), d * 1.3, top, color, look.roofMat, 7)
		if look.icing then
			for i = 0, 7 do
				local a = math.rad(i * 45)
				ball(
					model,
					d * 0.18,
					top * CFrame.new(math.sin(a) * d * 0.6, 0, math.cos(a) * d * 0.6),
					rgb(255, 255, 255)
				)
			end
		end
		if look.icicles then
			for i = 0, 7 do
				local a = math.rad(i * 45)
				wedge(
					model,
					Vector3.new(d * 0.05, d * 0.2, d * 0.07),
					top
						* CFrame.new(math.sin(a) * d * 0.62, -d * 0.1, math.cos(a) * d * 0.62)
						* CFrame.Angles(math.pi, a, 0),
					look.accent,
					M.Ice
				)
			end
		end
	end
	if look.clouds then
		puff(model, cf * CFrame.new(0, d * 0.1, -d * 0.5), d * 0.4)
	end
end

-- Garden: a flower bed with plants in the style's theme. size = { w, d }.
function builders.Garden(model, cf: CFrame, look, size)
	local w, d = size.w, size.d
	local edge = math.max(0.3, w / 25)
	-- Border and soil.
	block(
		model,
		Vector3.new(w, edge * 1.5, d),
		cf * CFrame.new(0, edge * 0.75, 0),
		look.trim:Lerp(rgb(0, 0, 0), 0.1),
		look.trimMat
	)
	block(
		model,
		Vector3.new(w - edge * 2, edge * 1.6, d - edge * 2),
		cf * CFrame.new(0, edge * 0.8, 0),
		rgb(110, 75, 50),
		M.Ground
	)
	local top = edge * 1.6
	local function spot(fx, fz)
		return cf * CFrame.new(fx * (w / 2 - edge * 3), top, fz * (d / 2 - edge * 3))
	end
	local spots = { { -0.8, 0.5 }, { -0.3, -0.5 }, { 0.2, 0.4 }, { 0.7, -0.3 }, { -0.75, -0.6 }, { 0.75, 0.6 } }
	local u = math.min(w, d) / 7 -- unit size of things in the bed

	if look.icing or look.stripes then
		-- Lollipops and gumdrops.
		for i, s in spots do
			if i <= 3 then
				post(model, u * 3, u * 0.25, spot(s[1], s[2]), rgb(255, 255, 255))
				local pop = block(
					model,
					Vector3.new(u * 0.4, u * 1.8, u * 1.8),
					spot(s[1], s[2]) * CFrame.new(0, u * 3.6, 0) * CFrame.Angles(0, math.pi / 2, 0),
					rainbowColor(i * 2)
				)
				pop.Shape = Enum.PartType.Cylinder
				pop.Size = Vector3.new(u * 0.4, u * 1.8, u * 1.8)
			else
				ball(
					model,
					Vector3.new(u * 1.4, u * 1.1, u * 1.4),
					spot(s[1], s[2]) * CFrame.new(0, u * 0.4, 0),
					rainbowColor(i),
					M.Glass
				)
			end
		end
	elseif look.wallMat == M.Sandstone then
		-- Cacti.
		for i, s in spots do
			if i <= 3 then
				local cactus = spot(s[1], s[2])
				local green = rgb(70, 170, 80)
				post(model, u * 3.2, u * 0.9, cactus, green)
				ball(model, u * 0.9, cactus * CFrame.new(0, u * 3.2, 0), green)
				post(model, u * 1.2, u * 0.55, cactus * CFrame.new(u * 0.7, u * 1.2, 0), green)
				ball(model, u * 0.5, cactus * CFrame.new(0, u * 3.7, 0), rgb(255, 110, 160))
			else
				ball(model, Vector3.new(u * 1.2, u * 0.7, u * 1.2), spot(s[1], s[2]), rgb(220, 190, 140), M.Sandstone)
			end
		end
	elseif look.cracks then
		-- Lava rocks with glowing cracks.
		for _, s in spots do
			ball(
				model,
				Vector3.new(u * 1.5, u * 1.1, u * 1.3),
				spot(s[1], s[2]) * CFrame.new(0, u * 0.4, 0),
				rgb(45, 35, 45),
				M.Basalt
			)
			ball(model, u * 0.55, spot(s[1], s[2]) * CFrame.new(0, u * 0.95, 0), look.accent, M.Neon)
		end
	elseif look.icicles then
		-- Ice crystals and a snowman.
		for i, s in spots do
			if i <= 4 then
				block(
					model,
					Vector3.new(u * 0.7, u * 2.4, u * 0.7),
					spot(s[1], s[2]) * CFrame.new(0, u * 1.1, 0) * CFrame.Angles(0, math.rad(45), math.rad(s[1] * 18)),
					look.accent,
					M.Ice
				)
			end
		end
		local snow = spot(0.6, 0.2)
		ball(model, u * 1.8, snow * CFrame.new(0, u * 0.8, 0), rgb(255, 255, 255), M.Snow)
		ball(model, u * 1.3, snow * CFrame.new(0, u * 2.1, 0), rgb(255, 255, 255), M.Snow)
		ball(model, u * 0.25, snow * CFrame.new(0, u * 2.2, -u * 0.62), rgb(255, 140, 40))
	elseif look.gems then
		for i, s in spots do
			local h = u * (1.6 + (i % 3) * 0.7)
			block(
				model,
				Vector3.new(u * 0.7, h, u * 0.7),
				spot(s[1], s[2]) * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, math.rad(45), math.rad(s[1] * 15)),
				if i % 2 == 0 then look.accent else look.wall,
				if i % 2 == 0 then M.Neon else M.Glass
			)
		end
	elseif look.clouds then
		for i, s in spots do
			if i <= 3 then
				puff(model, spot(s[1], s[2]) * CFrame.new(0, u * 0.6, 0), u * 1.2)
			else
				post(model, u * 1.4, u * 0.15, spot(s[1], s[2]), rgb(90, 190, 90))
				ball(model, u * 0.9, spot(s[1], s[2]) * CFrame.new(0, u * 1.5, 0), look.trim, M.Foil)
			end
		end
	elseif look.shape == "castle" then
		-- Topiary balls and a little fountain.
		for i, s in spots do
			if i <= 4 then
				post(model, u * 1, u * 0.3, spot(s[1], s[2]), rgb(120, 80, 50))
				ball(model, u * 1.6, spot(s[1], s[2]) * CFrame.new(0, u * 1.6, 0), rgb(60, 160, 70))
			end
		end
		local fountain = spot(0.3, 0.1)
		post(model, u * 0.6, u * 2.4, fountain, look.wall, look.wallMat)
		post(model, u * 0.2, u * 2, fountain * CFrame.new(0, u * 0.55, 0), rgb(90, 190, 255))
		post(model, u * 1.6, u * 0.4, fountain, look.trim, look.trimMat)
		ball(model, u * 0.8, fountain * CFrame.new(0, u * 1.9, 0), rgb(120, 210, 255), M.Glass)
	elseif look.wallMat == M.CorrodedMetal then
		-- Flowers growing out of old tyres.
		for i, s in spots do
			if i <= 3 then
				local tyre = block(
					model,
					Vector3.new(u * 0.7, u * 1.8, u * 1.8),
					spot(s[1], s[2]) * CFrame.new(0, u * 0.35, 0) * CFrame.Angles(0, 0, math.pi / 2),
					rgb(40, 40, 45)
				)
				tyre.Shape = Enum.PartType.Cylinder
				ball(model, u * 0.7, spot(s[1], s[2]) * CFrame.new(0, u * 1, 0), rainbowColor(i * 2))
			end
		end
	elseif look.logs then
		-- A pine tree and mushrooms.
		local tree = spot(-0.5, 0.2)
		post(model, u * 1.6, u * 0.6, tree, rgb(110, 70, 40), M.Wood)
		cone(model, u * 4.2, u * 3.2, tree * CFrame.new(0, u * 1.2, 0), rgb(50, 130, 70), nil, 5)
		for i, s in { { 0.4, -0.3 }, { 0.75, 0.4 }, { 0.1, 0.5 } } do
			post(model, u * 0.6, u * 0.3, spot(s[1], s[2]), rgb(250, 240, 220))
			ball(
				model,
				Vector3.new(u * 1, u * 0.55, u * 1),
				spot(s[1], s[2]) * CFrame.new(0, u * 0.65, 0),
				if i == 2 then rgb(255, 200, 60) else rgb(225, 50, 50)
			)
		end
	elseif look.ivy then
		-- A rock garden with a bush.
		for i, s in spots do
			ball(
				model,
				Vector3.new(u * 1.3, u * 0.9, u * 1.1),
				spot(s[1], s[2]) * CFrame.new(0, u * 0.3, 0),
				rgb(150, 150, 155):Lerp(rgb(110, 110, 115), (i % 2) * 0.5),
				M.Slate
			)
		end
		ball(model, Vector3.new(u * 2.4, u * 1.8, u * 2), spot(0, 0) * CFrame.new(0, u * 0.8, 0), look.accent)
		ball(model, u * 0.5, spot(0, 0) * CFrame.new(u * 0.5, u * 1.6, -u * 0.6), rgb(255, 120, 170))
	else
		-- Plain flowers on stems.
		for i, s in spots do
			post(model, u * 1.4, u * 0.18, spot(s[1], s[2]), rgb(70, 160, 70))
			ball(model, u * 0.9, spot(s[1], s[2]) * CFrame.new(0, u * 1.5, 0), rainbowColor(i))
			ball(model, u * 0.35, spot(s[1], s[2]) * CFrame.new(0, u * 1.5, -u * 0.35), rgb(255, 230, 80))
		end
		ball(model, Vector3.new(u * 2, u * 1.4, u * 1.6), spot(0.1, 0) * CFrame.new(0, u * 0.6, 0), look.accent)
	end
	if look.rainbow then
		-- A little rainbow arc over the bed.
		for i = 1, 6 do
			local r = u * (3.6 - i * 0.35)
			for k = 0, 8 do
				local a = math.rad(k * 22.5)
				ball(
					model,
					u * 0.4,
					cf * CFrame.new(math.cos(a) * r, top + math.sin(a) * r, d * 0.25),
					rainbowColor(i),
					M.Neon
				)
			end
		end
	end
end

-- Mailbox: a post and box. size = { h } (post height).
function builders.Mailbox(model, cf: CFrame, look, size)
	local h = size.h
	local s = h / 4
	if look.clouds then
		puff(model, cf * CFrame.new(0, s * 0.6, 0), s * 1.4)
	end
	post(model, h, s * 0.45, cf, look.trim, look.trimMat)
	local box = cf * CFrame.new(0, h + s * 0.5, 0)
	local color = if look.rainbow then rainbowColor(5) else look.accent
	local mat = if look.accentMat == M.Neon and not look.cracks then nil else look.accentMat
	if look.cracks then
		color, mat = look.wall, look.wallMat
	end
	block(model, Vector3.new(s * 1.3, s, s * 2.2), box, color, mat)
	local top = block(
		model,
		Vector3.new(s * 2.2, s * 1.3, s * 1.3),
		box * CFrame.new(0, s * 0.5, 0) * CFrame.Angles(0, math.pi / 2, 0),
		color,
		mat
	)
	top.Shape = Enum.PartType.Cylinder
	-- Little red flag.
	block(model, Vector3.new(0.15, s * 0.9, 0.15), box * CFrame.new(s * 0.72, s * 0.4, s * 0.3), rgb(230, 50, 60))
	block(model, Vector3.new(0.12, s * 0.4, s * 0.6), box * CFrame.new(s * 0.72, s * 0.75, s * 0.55), rgb(230, 50, 60))
	-- A letter poking out.
	block(
		model,
		Vector3.new(s * 0.9, s * 0.08, s * 0.6),
		box * CFrame.new(0, 0, -s * 1.15) * CFrame.Angles(math.rad(-25), 0, 0),
		rgb(255, 255, 255)
	)
	if look.cracks or look.gems then
		ball(model, s * 0.5, box * CFrame.new(0, s * 1.3, 0), look.accent, M.Neon)
	elseif look.icing then
		ball(model, Vector3.new(s * 1.5, s * 0.4, s * 2.4), box * CFrame.new(0, s * 1.1, 0), rgb(255, 255, 255))
		ball(model, s * 0.45, box * CFrame.new(0, s * 1.4, 0), rgb(230, 30, 50))
	elseif look.icicles then
		ball(
			model,
			Vector3.new(s * 1.6, s * 0.45, s * 2.5),
			box * CFrame.new(0, s * 1.1, 0),
			rgb(255, 255, 255),
			M.Snow
		)
	elseif look.shape == "castle" then
		cone(model, s * 0.8, s * 0.7, box * CFrame.new(0, s * 1.1, 0), look.trim, look.trimMat, 4)
	end
end

-- Fence: runs along cf's X axis from x = 0 to x = length. size = { length, h }.
function builders.Fence(model, cf: CFrame, look, size)
	local length, h = size.length, size.h
	local gap = h * 0.75
	local count = math.max(1, math.floor(length / gap))
	local color, mat = look.trim, look.trimMat
	if look.wallMat == M.Cobblestone or look.wallMat == M.Sandstone or look.wallMat == M.Ice then
		-- A low wall with caps.
		solid(
			model,
			Vector3.new(length, h * 0.7, h * 0.35),
			cf * CFrame.new(length / 2, h * 0.35, 0),
			look.wall,
			look.wallMat
		)
		block(
			model,
			Vector3.new(length + 0.2, h * 0.12, h * 0.45),
			cf * CFrame.new(length / 2, h * 0.72, 0),
			look.trim,
			look.trimMat
		)
		for i = 0, count do
			block(
				model,
				Vector3.new(h * 0.42, h * 0.95, h * 0.42),
				cf * CFrame.new(i * length / count, h * 0.47, 0),
				look.trim,
				look.trimMat
			)
			if look.icicles then
				ball(
					model,
					Vector3.new(h * 0.5, h * 0.2, h * 0.5),
					cf * CFrame.new(i * length / count, h * 0.98, 0),
					rgb(255, 255, 255),
					M.Snow
				)
			end
		end
		return
	end
	if look.wallMat == M.CorrodedMetal then
		-- Mismatched sheets of tin.
		for i = 0, count - 1 do
			block(
				model,
				Vector3.new(length / count * 1.05, h * (0.8 + (i % 3) * 0.1), 0.2),
				cf
					* CFrame.new((i + 0.5) * length / count, h * 0.42, 0)
					* CFrame.Angles(0, 0, math.rad((i % 3 - 1) * 3)),
				if i % 2 == 0 then look.wall else look.trim,
				M.CorrodedMetal
			)
		end
		return
	end
	if look.wallMat == M.Wood then
		color, mat = look.wall, M.Wood
	end
	local railColor = if look.rainbow then rgb(255, 255, 255) else color
	-- Rails.
	for _, y in { 0.35, 0.72 } do
		block(model, Vector3.new(length, h * 0.1, h * 0.08), cf * CFrame.new(length / 2, h * y, 0), railColor, mat)
	end
	for i = 0, count do
		local x = i * length / count
		local spot = cf * CFrame.new(x, 0, 0)
		local postColor = if look.rainbow then rainbowColor(i + 1) else color
		if look.stripes then
			post(model, h, h * 0.16, spot, look.trim)
			for k = 0, 2 do
				block(
					model,
					Vector3.new(h * 0.17, h * 0.08, h * 0.17),
					spot * CFrame.new(0, h * (0.2 + k * 0.3), 0),
					look.accent
				)
			end
			-- Candy cane hook.
			block(model, Vector3.new(h * 0.3, h * 0.14, h * 0.14), spot * CFrame.new(h * 0.12, h, 0), look.accent)
		elseif look.cracks then
			wedge(
				model,
				Vector3.new(h * 0.18, h * 1.2, h * 0.18),
				spot * CFrame.new(0, h * 0.6, 0),
				look.wall,
				look.wallMat
			)
			ball(model, h * 0.14, spot * CFrame.new(0, h * 0.3, -h * 0.08), look.accent, M.Neon)
		elseif look.gems then
			block(
				model,
				Vector3.new(h * 0.18, h * 1.1, h * 0.18),
				spot * CFrame.new(0, h * 0.55, 0) * CFrame.Angles(0, math.rad(45), 0),
				if i % 2 == 0 then look.accent else look.wall,
				if i % 2 == 0 then M.Neon else M.Glass
			)
		elseif look.clouds then
			post(model, h * 0.9, h * 0.1, spot, look.trim, look.trimMat)
			ball(model, h * 0.35, spot * CFrame.new(0, h * 0.95, 0), rgb(255, 255, 255))
		elseif look.shape == "castle" then
			post(model, h * 1.1, h * 0.08, spot, rgb(40, 40, 50), M.Metal)
			wedge(
				model,
				Vector3.new(h * 0.12, h * 0.2, h * 0.12),
				spot * CFrame.new(0, h * 1.2, 0),
				look.trim,
				look.trimMat
			)
		else
			-- Pickets with pointed tops.
			block(model, Vector3.new(h * 0.18, h * 0.85, h * 0.1), spot * CFrame.new(0, h * 0.42, 0), postColor, mat)
			wedge(
				model,
				Vector3.new(h * 0.1, h * 0.15, h * 0.09),
				spot * CFrame.new(0, h * 0.92, 0.0) * CFrame.Angles(0, math.pi / 2, 0),
				postColor,
				mat
			)
		end
	end
end

--------------------------------------------------------------------------------
-- Where each slot goes on a full house (plot space: origin at the plot's centre, front -Z).
--------------------------------------------------------------------------------

local HOUSE_Z = 6 -- the front wall's z
local FENCE_Z = -46.5
local GATE_HALF = 8

local PLACEMENTS = {
	Walls = function(model, look)
		builders.Walls(model, CFrame.new(0, 0, HOUSE_Z), look, { w = BODY.w, d = BODY.d, h = BODY.h })
	end,
	Roof = function(model, look)
		builders.Roof(model, CFrame.new(0, 0, HOUSE_Z), look, { w = BODY.w, d = BODY.d, y = BASE + BODY.h })
	end,
	Door = function(model, look)
		builders.Door(model, CFrame.new(0, BASE, HOUSE_Z), look, { w = 5, h = 8 })
	end,
	Windows = function(model, look)
		builders.Windows(model, CFrame.new(0, 0, HOUSE_Z), look, { w = BODY.w, d = BODY.d, h = BODY.h })
	end,
	Chimney = function(model, look)
		builders.Chimney(
			model,
			CFrame.new(BODY.w * 0.3, BASE + BODY.h, HOUSE_Z + BODY.d * 0.72),
			look,
			{ h = 11, s = 3 }
		)
	end,
	Porch = function(model, look)
		builders.Porch(model, CFrame.new(0, 0, HOUSE_Z), look, { w = 11, h = 10.5 })
	end,
	Tower = function(model, look)
		builders.Tower(model, CFrame.new(-BODY.w / 2 - 4.5, 0, HOUSE_Z + BODY.d * 0.45), look, { r = 5.5, h = 24 })
	end,
	Garden = function(model, look)
		builders.Garden(model, CFrame.new(-31, 0, -12), look, { w = 16, d = 9 })
	end,
	Mailbox = function(model, look)
		builders.Mailbox(model, CFrame.new(GATE_HALF + 3, 0, FENCE_Z + 3), look, { h = 4 })
	end,
	Fence = function(model, look)
		local h = 3.2
		local edge = 47
		builders.Fence(model, CFrame.new(-edge, 0, FENCE_Z), look, { length = edge - GATE_HALF, h = h })
		builders.Fence(model, CFrame.new(GATE_HALF, 0, FENCE_Z), look, { length = edge - GATE_HALF, h = h })
		-- Down both sides and along the back.
		builders.Fence(
			model,
			CFrame.new(-edge, 0, FENCE_Z) * CFrame.Angles(0, -math.pi / 2, 0),
			look,
			{ length = edge * 2 - 0.5, h = h }
		)
		builders.Fence(
			model,
			CFrame.new(edge, 0, -FENCE_Z) * CFrame.Angles(0, math.pi / 2, 0),
			look,
			{ length = edge * 2 - 0.5, h = h }
		)
		builders.Fence(model, CFrame.new(-edge, 0, -FENCE_Z), look, { length = edge * 2, h = h })
	end,
}
HouseModel.FENCE_Z = FENCE_Z
HouseModel.GATE_HALF = GATE_HALF
HouseModel.HOUSE_Z = HOUSE_Z

-- Where to put each slot's "steal" prompt on a full house (plot space).
HouseModel.ANCHORS = {
	Walls = Vector3.new(BODY.w * 0.3, 4, HOUSE_Z - 0.5),
	Roof = Vector3.new(0, BASE + BODY.h + 3, HOUSE_Z + 2),
	Door = Vector3.new(0, 4, HOUSE_Z - 1),
	Windows = Vector3.new(-BODY.w * 0.3, BASE + BODY.h * 0.58, HOUSE_Z - 1),
	Chimney = Vector3.new(BODY.w * 0.3, BASE + BODY.h + 6, HOUSE_Z + BODY.d * 0.6),
	Porch = Vector3.new(4, 2, HOUSE_Z - 4),
	Tower = Vector3.new(-BODY.w / 2 - 4.5, 4, HOUSE_Z + BODY.d * 0.45 - 6),
	Garden = Vector3.new(-31, 1.5, -12),
	Mailbox = Vector3.new(GATE_HALF + 3, 3, FENCE_Z + 3),
	Fence = Vector3.new(-26, 2, FENCE_Z + 1),
}

--------------------------------------------------------------------------------
-- Public
--------------------------------------------------------------------------------

-- One slot of a full house, as its own Model.
function HouseModel.slot(slotId: string, partId: string?): Model
	local id = partId or Parts.basic(slotId)
	local part = Parts.byId[id]
	local look = lookFor(part and part.style or "Basic")
	local model = Instance.new("Model")
	model.Name = slotId
	model:SetAttribute("Part", id)
	PLACEMENTS[slotId](model, look)
	return model
end

-- A whole house: parts = { [slotId] = partId }.
function HouseModel.house(parts): Model
	local model = Instance.new("Model")
	model.Name = "House"
	for _, slot in Parts.SLOTS do
		HouseModel.slot(slot.id, parts and parts[slot.id]).Parent = model
	end
	return model
end

-- One part on its own, about 5 studs across, standing on the origin and facing -Z.
local ITEMS = {
	Walls = function(model, look)
		builders.Walls(model, CFrame.new(0, 0, -1), look, { w = 5.5, d = 2.2, h = 4.4, base = 0.4 })
		-- A window so it reads as a piece of wall, not a box.
		window(model, CFrame.new(0, 2.7, -1.05), look, 1.7, 1.7)
	end,
	Roof = function(model, look)
		builders.Roof(model, CFrame.new(0, 0, -2), look, { w = 5.5, d = 4, y = 0 })
	end,
	Door = function(model, look)
		builders.Door(model, CFrame.new(0, 0, 0), look, { w = 3, h = 4.8 })
	end,
	Windows = function(model, look)
		builders.Windows(model, CFrame.new(0, 0, 0), look, { single = true, ww = 3.4, wh = 3.4 })
	end,
	Chimney = function(model, look)
		builders.Chimney(model, CFrame.new(0, 0, 0), look, { h = 4, s = 1.8 })
	end,
	Porch = function(model, look)
		builders.Porch(model, CFrame.new(0, 0, 1.4), look, { w = 5.5, h = 5, floor = 0.5 })
	end,
	Tower = function(model, look)
		builders.Tower(model, CFrame.new(0, 0, 0), look, { r = 1.5, h = 5 })
	end,
	Garden = function(model, look)
		builders.Garden(model, CFrame.new(0, 0, 0), look, { w = 5.5, d = 3.6 })
	end,
	Mailbox = function(model, look)
		builders.Mailbox(model, CFrame.new(0, 0, 0), look, { h = 3.2 })
	end,
	Fence = function(model, look)
		builders.Fence(model, CFrame.new(-2.7, 0, 0), look, { length = 5.4, h = 3 })
	end,
}

function HouseModel.item(partId: string): Model
	local part = Parts.byId[partId]
	local model = Instance.new("Model")
	model.Name = partId
	model:SetAttribute("Part", partId)
	if part then
		ITEMS[part.slot](model, lookFor(part.style))
	end
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
		end
	end
	-- Stand it on its base. Roblox puts a new model's pivot in the middle of its parts, which
	-- would sink it halfway into whatever it's put on.
	model.WorldPivot = CFrame.identity
	return model
end

return HouseModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Hybrids</string>
          <string name="Source"><![CDATA[-- Hybrids: what you get when two different Freeks fuse.
--
-- A hybrid is identified by the base species that went into it, e.g. "Nerdle+Oinkle".
-- Fusing a hybrid again adds its species to the mix ("Flexo+Nerdle+Oinkle"); when one
-- species is in there more than once it gets a count ("Nerdle*2+Oinkle"). Counts are kept
-- in lowest terms, so the same mix always has the same id however it was made, and
-- fusing two of the same species just makes that species again.
--
-- Everything else about a hybrid comes from its id, so nothing needs to be listed by hand:
--   name    the two main species' names mashed together (Chuckles + Flexo = "Chuxo")
--   rarity  the rarest species in it (fusing never raises rarity)
--   look    built by FreekModel from the two main species: the first one's body (legs,
--           arms) wearing the second one's big head with the first one's ears, the
--           second one's tail, markings in both colours and a glowing fusion collar
-- Each hybrid Freek also stores its own income (see Breeding.babyIncome).
--
-- Freeks.byId[id] works for hybrid ids too (Freeks.luau asks this module).

local Rarities = require(script.Parent.Rarities)

local Hybrids = {}

function Hybrids.isHybrid(id: string): boolean
	return string.find(id, "+", 1, true) ~= nil
end

-- { [baseId] = count } for any species or hybrid id.
function Hybrids.counts(id: string): { [string]: number }
	local counts = {}
	for piece in string.gmatch(id, "[^+]+") do
		local base, n = string.match(piece, "^(.-)%*(%d+)$")
		base = base or piece
		counts[base] = (counts[base] or 0) + (tonumber(n) or 1)
	end
	return counts
end

local function gcd(a: number, b: number): number
	while b ~= 0 do
		a, b = b, a % b
	end
	return a
end

-- The id for a mix of species (a plain species id if there's only one).
function Hybrids.key(counts: { [string]: number }): string
	local ids = {}
	local divisor = 0
	for id, n in counts do
		table.insert(ids, id)
		divisor = gcd(divisor, n)
	end
	table.sort(ids)
	local pieces = {}
	for _, id in ids do
		local n = counts[id] // divisor
		table.insert(pieces, if n > 1 then id .. "*" .. n else id)
	end
	return table.concat(pieces, "+")
end

-- What two species (or hybrids) fuse into.
function Hybrids.combine(a: string, b: string): string
	local counts = Hybrids.counts(a)
	for id, n in Hybrids.counts(b) do
		counts[id] = (counts[id] or 0) + n
	end
	return Hybrids.key(counts)
end

-- The species in a hybrid, most-used first (ties alphabetical).
function Hybrids.ranked(id: string): { string }
	local counts = Hybrids.counts(id)
	local list = {}
	for base in counts do
		table.insert(list, base)
	end
	table.sort(list, function(a, b)
		if counts[a] ~= counts[b] then
			return counts[a] > counts[b]
		end
		return a < b
	end)
	return list
end

-- Name mashing ------------------------------------------------------------------------

local VOWELS = "aeiouyAEIOUY"

local function letters(name: string): string
	return (string.gsub(name, "[^%a]", ""))
end

-- The start of a name up to its first vowels: "Chuckles" -> "Chu", "Glamora" -> "Gla".
local function front(name: string): string
	local word = letters(name)
	local _, finish = string.find(word, "^[^" .. VOWELS .. "]*[" .. VOWELS .. "]+")
	return if finish then string.sub(word, 1, finish) else word
end

-- The rest of a name after its first vowel: "Oinkle" -> "inkle", "Flexo" -> "xo".
local function back(name: string): string
	local word = letters(name)
	local _, finish = string.find(word, "^[^" .. VOWELS .. "]*[" .. VOWELS .. "]")
	local rest = if finish then string.sub(word, finish + 1) else word
	if #rest < 2 then
		rest = string.sub(word, -3)
	end
	return string.lower(rest)
end

-- Mashes two names, trying both orders and keeping the one that sounds most like a name.
local function mash(nameA: string, nameB: string): string
	local wordA, wordB = letters(nameA), letters(nameB)
	local average = (#wordA + #wordB) / 2
	local candidates = {}
	for _, pair in { { wordA, wordB }, { wordB, wordA } } do
		local start = front(pair[1])
		local penalty = if #start < 3 then 2 else 0 -- weak start, like "Oi"
		table.insert(candidates, { start .. back(pair[2]), penalty })
		-- Fallbacks for when the parents' names look alike: plain halves, then a short mix.
		local first = string.sub(pair[1], 1, math.ceil(#pair[1] / 2))
		local second = string.lower(string.sub(pair[2], math.ceil(#pair[2] / 2) + 1))
		table.insert(candidates, { first .. second, 3 })
		table.insert(candidates, { string.sub(pair[1], 1, 2) .. string.lower(string.sub(pair[2], -3)), 6 })
	end
	local best, bestScore = nil, math.huge
	for _, entry in candidates do
		local candidate, score = entry[1], entry[2]
		score += math.abs(#candidate - average)
		if #candidate < 5 then
			score += 3 -- too short
		end
		local lower = string.lower(candidate)
		if lower == string.lower(wordA) or lower == string.lower(wordB) then
			score += 100 -- just one of the parents' names again
		end
		if score < bestScore or (score == bestScore and candidate < best) then
			best, bestScore = candidate, score
		end
	end
	return string.upper(string.sub(best, 1, 1)) .. string.sub(best, 2)
end

-- Builds the species-like info for a hybrid id. get(baseId) returns a base species.
function Hybrids.info(id: string, get)
	local ranked = Hybrids.ranked(id)
	if #ranked < 2 then
		return nil
	end
	local rank = 1
	for _, base in ranked do
		local species = get(base)
		if not species then
			return nil
		end
		rank = math.max(rank, Rarities.rank[species.rarity])
	end
	local a, b = get(ranked[1]), get(ranked[2])
	local name = mash(a.name, b.name)
	if ranked[3] then
		name ..= "-" .. front(get(ranked[3]).name)
	end
	return {
		id = id,
		name = name,
		rarity = Rarities.order[rank],
		income = a.income + b.income, -- only a guide: each hybrid Freek stores its own
		hybrid = true,
		series = "Hybrid",
		walk = a.walk,
		parts = ranked,
		look = { hybrid = { a = a.id, b = b.id } },
		order = math.huge,
	}
end

return Hybrids
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">ItemModel</string>
          <string name="Source"><![CDATA[-- One model for any item (see Items.luau), standing on its pivot: a house part as a small
-- item (HouseModel.item), a pet (FreekModel), a yard item (YardModel) or a plant
-- (PlantModel). Mutated items sparkle in their mutation's colour.

local FreekModel = require(script.Parent.FreekModel)
local HouseModel = require(script.Parent.HouseModel)
local Items = require(script.Parent.Items)
local Mutations = require(script.Parent.Mutations)
local PlantModel = require(script.Parent.PlantModel)
local YardModel = require(script.Parent.YardModel)

local ItemModel = {}

-- A sparkle on mutated models, in the mutation's colour.
function ItemModel.addMutationEffect(model: Model, mutations)
	local top = Mutations.top(mutations)
	local base = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if top and base and not base:FindFirstChildOfClass("Sparkles") then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Mutations.byId[top].color
		sparkles.Parent = base
	end
end

-- record = { id, mutations, weight?, baseWeight? }. Heavier items are drawn bigger
-- (Items.weightScale); house parts stay their normal size (they have to fit their slot).
function ItemModel.build(record): Model
	local model = ItemModel.buildNormal(record.id, record.mutations)
	local item = Items.byId[record.id]
	if item and item.kind ~= "House" then
		Items.scaleModel(model, Items.weightScale(Items.weightFactor(record)))
	end
	return model
end

function ItemModel.buildNormal(itemId: string, mutations): Model
	local item = Items.byId[itemId]
	local model
	if not item then
		model = Instance.new("Model")
	elseif item.kind == "House" then
		model = HouseModel.item(itemId)
	elseif item.kind == "Pet" then
		-- Pets show their mutations with FreekModel's own effects.
		model = FreekModel.build(item.species, mutations)
		model:SetAttribute("Item", itemId)
		return model
	elseif item.kind == "Yard" then
		model = YardModel.build(itemId)
	else
		model = PlantModel.build(itemId)
	end
	ItemModel.addMutationEffect(model, mutations)
	return model
end

return ItemModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[-- Everything you can own in Steal a Life, in four kinds:
--
--   House  house parts (Parts.luau): snap onto your house's slots
--   Pet    Freeks that roam your yard
--   Yard   yard items (pool, trampoline, hot tub...) on the spots in your yard
--   Plant  plants in your garden beds
--
-- Every item comes out of an egg stolen from a zone (see EGGS / ZONES): each zone grows
-- eggs of one kind, and deeper zones have better odds. An egg's rarity is rolled when it
-- goes into a nest at home, it grows for a while (rarer = longer) and hatches into a random
-- item of its kind and rarity.
--
-- Item ids: house parts "<Style>_<Slot>" ("Candy_Roof"), others "<Kind>_<Name>"
-- ("Pet_Oinkle", "Yard_HotTub", "Plant_Sunflower"). Never rename an id once players own it.

local Parts = require(script.Parent.Parts)
local Rarities = require(script.Parent.Rarities)

local Items = {}

Items.KINDS = {
	House = { name = "House", icon = "🏠", color = Color3.fromRGB(70, 140, 255), egg = "Hardware" },
	Pet = { name = "Pets", icon = "🐾", color = Color3.fromRGB(255, 120, 180), egg = "Wilds" },
	Yard = { name = "Yard", icon = "🛝", color = Color3.fromRGB(255, 160, 50), egg = "Yard Sale" },
	Plant = { name = "Garden", icon = "🌷", color = Color3.fromRGB(80, 200, 90), egg = "Garden" },
}
Items.KIND_ORDER = { "House", "Pet", "Yard", "Plant" }

-- What an item of each rarity earns a second (pets, yard items and plants; house parts use
-- their style's income times the slot's weight). Kept in line with house parts.
Items.INCOME = {
	Common = 4,
	Uncommon = 30,
	Rare = 180,
	Legendary = 1000,
	Mystic = 5000,
	Ultra = 13000,
	Secret = 45000,
}

-- Pets: Freeks (species in Freeks.luau). Their rarity here is what decides how often they
-- hatch and what they earn.
Items.PETS = {
	{ species = "Oinkle", rarity = "Common" },
	{ species = "Woofles", rarity = "Common" },
	{ species = "Chuckles", rarity = "Common" },
	{ species = "Whiskerz", rarity = "Uncommon" },
	{ species = "Lizzle", rarity = "Uncommon" },
	{ species = "Nerdle", rarity = "Uncommon" },
	{ species = "BooBoo", rarity = "Rare" },
	{ species = "Zomboy", rarity = "Rare" },
	{ species = "Hootsworth", rarity = "Rare" },
	{ species = "Flexo", rarity = "Legendary" },
	{ species = "Mumbles", rarity = "Legendary" },
	{ species = "Glamora", rarity = "Legendary" },
	{ species = "Chompers", rarity = "Mystic" },
	{ species = "CountFangula", rarity = "Mystic" },
	{ species = "Stompy", rarity = "Ultra" },
	{ species = "Howlz", rarity = "Ultra" },
	{ species = "Blinky", rarity = "Secret" },
	{ species = "Stormy", rarity = "Secret" },
}

-- Yard items (models in YardModel.luau).
Items.YARD = {
	{ id = "Gnome", name = "Garden Gnome", rarity = "Common" },
	{ id = "Lemonade", name = "Lemonade Stand", rarity = "Common" },
	{ id = "Grill", name = "BBQ Grill", rarity = "Uncommon" },
	{ id = "Swing", name = "Swing Set", rarity = "Uncommon" },
	{ id = "Trampoline", name = "Trampoline", rarity = "Rare" },
	{ id = "KiddiePool", name = "Kiddie Pool", rarity = "Rare" },
	{ id = "HotTub", name = "Hot Tub", rarity = "Legendary" },
	{ id = "Fountain", name = "Fountain", rarity = "Legendary" },
	{ id = "Treehouse", name = "Treehouse", rarity = "Mystic" },
	{ id = "SportsCar", name = "Sports Car", rarity = "Mystic" },
	{ id = "Pool", name = "Swimming Pool", rarity = "Ultra" },
	{ id = "Rocket", name = "Rocket Ship", rarity = "Secret" },
}

-- Plants (models in PlantModel.luau).
Items.PLANTS = {
	{ id = "Daisy", name = "Daisy", rarity = "Common" },
	{ id = "Tulip", name = "Tulip", rarity = "Common" },
	{ id = "Sunflower", name = "Sunflower", rarity = "Uncommon" },
	{ id = "RoseBush", name = "Rose Bush", rarity = "Uncommon" },
	{ id = "Cactus", name = "Cactus", rarity = "Rare" },
	{ id = "AppleTree", name = "Apple Tree", rarity = "Rare" },
	{ id = "Pumpkin", name = "Giant Pumpkin", rarity = "Legendary" },
	{ id = "Blossom", name = "Cherry Blossom", rarity = "Legendary" },
	{ id = "CrystalFlower", name = "Crystal Flower", rarity = "Mystic" },
	{ id = "GlowShroom", name = "Glow Mushroom", rarity = "Mystic" },
	{ id = "MoneyTree", name = "Money Tree", rarity = "Ultra" },
	{ id = "RainbowTree", name = "Rainbow Tree", rarity = "Secret" },
}

-- How many of each kind can be out at once (more items wait in the backpack).
Items.PET_SLOTS = 8
Items.YARD_SPOTS = 6
Items.GARDEN_BEDS = 6

-- Every item, by id.
Items.byId = {}
Items.list = {}
local function add(item)
	item.order = #Items.list + 1
	Items.byId[item.id] = item
	table.insert(Items.list, item)
end
for _, part in Parts.list do
	add({
		id = part.id,
		kind = "House",
		name = part.name,
		rarity = part.rarity,
		income = part.income,
		slot = part.slot,
		style = part.style,
		basic = part.style == "Basic",
	})
end
for i, pet in Items.PETS do
	-- A little more for each species further down its rarity, so they're not all equal.
	add({
		id = "Pet_" .. pet.species,
		kind = "Pet",
		name = pet.species,
		species = pet.species,
		rarity = pet.rarity,
		income = math.floor(Items.INCOME[pet.rarity] * (1 + (i % 3) * 0.1)),
	})
end
for i, yard in Items.YARD do
	add({
		id = "Yard_" .. yard.id,
		kind = "Yard",
		name = yard.name,
		model = yard.id,
		rarity = yard.rarity,
		income = math.floor(Items.INCOME[yard.rarity] * (1 + (i % 2) * 0.15)),
	})
end
for i, plant in Items.PLANTS do
	add({
		id = "Plant_" .. plant.id,
		kind = "Plant",
		name = plant.name,
		model = plant.id,
		rarity = plant.rarity,
		income = math.floor(Items.INCOME[plant.rarity] * (1 + (i % 2) * 0.12)),
	})
end
-- Pets now have names as their display name: use the species' friendly name.
do
	local ok, Freeks = pcall(require, script.Parent.Freeks)
	if ok then
		for _, pet in Items.PETS do
			local species = Freeks.byId[pet.species]
			if species then
				Items.byId["Pet_" .. pet.species].name = species.name
			end
		end
	end
end

function Items.color(id: string): Color3
	local item = Items.byId[id]
	return Rarities.info[item and item.rarity or "Common"].color
end

-- Every item of a kind and rarity that can hatch (Basic house parts never do).
function Items.pool(kind: string, rarity: string): { string }
	local list = {}
	for _, item in Items.list do
		if item.kind == kind and item.rarity == rarity and not item.basic then
			table.insert(list, item.id)
		end
	end
	return list
end

--------------------------------------------------------------------------------
-- Zones and their eggs
--------------------------------------------------------------------------------

-- The zones, in order out from town, each growing eggs of one kind. speed = the Speed you
-- need to outrun its guardian (a giant Freek). odds = chance of each rarity when one of its
-- eggs goes in a nest (weights).
Items.ZONES = {
	{
		name = "Backyard Garden",
		kind = "Plant",
		speed = 0,
		guardian = "Oinkle",
		title = "Gardener Oinkle",
		eggColor = Color3.fromRGB(120, 210, 90),
		spotColor = Color3.fromRGB(255, 220, 90),
		odds = { Common = 70, Uncommon = 25, Rare = 5 },
	},
	{
		name = "Junkyard",
		kind = "House",
		speed = 300,
		guardian = "Woofles",
		title = "Junk Dog",
		eggColor = Color3.fromRGB(190, 140, 90),
		spotColor = Color3.fromRGB(120, 125, 135),
		odds = { Common = 60, Uncommon = 30, Rare = 9, Legendary = 1 },
	},
	{
		name = "Pine Woods",
		kind = "Pet",
		speed = 2_000,
		guardian = "Hootsworth",
		title = "Old Owl Hootsworth",
		eggColor = Color3.fromRGB(90, 170, 110),
		spotColor = Color3.fromRGB(150, 100, 60),
		odds = { Common = 50, Uncommon = 35, Rare = 13, Legendary = 2 },
	},
	{
		name = "Toy Town",
		kind = "Yard",
		speed = 10_000,
		guardian = "Chuckles",
		title = "Toy Clown Chuckles",
		eggColor = Color3.fromRGB(255, 200, 60),
		spotColor = Color3.fromRGB(80, 150, 255),
		odds = { Common = 40, Uncommon = 38, Rare = 18, Legendary = 4 },
	},
	{
		name = "Sunny Desert",
		kind = "Plant",
		speed = 40_000,
		guardian = "Mumbles",
		title = "Mummy Mumbles",
		eggColor = Color3.fromRGB(240, 200, 120),
		spotColor = Color3.fromRGB(60, 190, 200),
		odds = { Uncommon = 40, Rare = 35, Legendary = 20, Mystic = 5 },
	},
	{
		name = "Candy Land",
		kind = "House",
		speed = 150_000,
		guardian = "Glamora",
		title = "Candy Queen Glamora",
		eggColor = Color3.fromRGB(255, 150, 200),
		spotColor = Color3.fromRGB(255, 255, 255),
		odds = { Uncommon = 30, Rare = 38, Legendary = 25, Mystic = 7 },
	},
	{
		name = "Frosty Peaks",
		kind = "Pet",
		speed = 600_000,
		guardian = "BooBoo",
		title = "Frosty BooBoo",
		eggColor = Color3.fromRGB(170, 220, 255),
		spotColor = Color3.fromRGB(255, 255, 255),
		odds = { Rare = 40, Legendary = 38, Mystic = 18, Ultra = 4 },
	},
	{
		name = "Royal Kingdom",
		kind = "Yard",
		speed = 2_500_000,
		guardian = "CountFangula",
		title = "Count Fangula",
		eggColor = Color3.fromRGB(150, 60, 220),
		spotColor = Color3.fromRGB(255, 200, 60),
		odds = { Rare = 30, Legendary = 40, Mystic = 23, Ultra = 7 },
	},
	{
		name = "Crystal Caves",
		kind = "House",
		speed = 10_000_000,
		guardian = "Blinky",
		title = "Crystal Blinky",
		eggColor = Color3.fromRGB(170, 120, 255),
		spotColor = Color3.fromRGB(120, 250, 240),
		odds = { Legendary = 40, Mystic = 38, Ultra = 20, Secret = 2 },
	},
	{
		name = "Sky Islands",
		kind = "Pet",
		speed = 50_000_000,
		guardian = "Stormy",
		title = "Storm Lord Stormy",
		eggColor = Color3.fromRGB(240, 248, 255),
		spotColor = Color3.fromRGB(255, 210, 80),
		odds = { Legendary = 30, Mystic = 40, Ultra = 26, Secret = 4 },
	},
}

-- Weights, like Steal an Egg: every egg has a random weight in kg, and grows a random amount
-- (in random spurts) while it sits in a nest. What hatches keeps the egg's final weight.
-- There's no top limit: weights come from a long-tailed roll, so each step heavier is
-- rarer than the last. Counting nest growth, a hatched item ranges from about a third of
-- normal up: 3x normal is about 1 in 14, 10x about 1 in 190, 30x about 1 in 2,000, 100x
-- about 1 in 35,000, and so on with no end.
--
-- On item records: weight (kg) and baseWeight (the normal weight of the egg it came from).
-- weight / baseWeight is the item's "factor": it multiplies income and sets how big it's
-- drawn (Items.weightScale). Records without a weight count as factor 1.
local WEIGHT_SCALE = 0.66 -- sets where the typical egg lands (about 1x normal)
local WEIGHT_TAIL = 2.2 -- how fast heavier eggs get rarer (bigger = rarer)
local GROWTH_MIN = 0.5 -- the growth roll's scale (half of eggs grow +13% or more, 1 in 10 +58%)
local GROWTH_TAIL = 3 -- how fast bigger growth gets rarer (1 in 100 nearly triples)

-- The normal weight of a zone's eggs (kg): deeper zones lay heavier eggs.
function Items.eggBaseWeight(zoneIndex: number): number
	return 1 + (zoneIndex - 1) * 0.75
end

-- A random weight factor (1 = normal). `boost` (>= 1, from lucky events) makes heavy ones
-- likelier.
function Items.rollWeightFactor(rng: Random, boost: number?): number
	local tail = WEIGHT_TAIL / (boost or 1) ^ 0.25
	-- A spread round normal (0.5x to 1.5x), times a long tail with no top.
	return WEIGHT_SCALE * (0.5 + rng:NextNumber()) * (1 - rng:NextNumber()) ^ (-1 / tail)
end

-- A random amount an egg grows by in its nest (1 = not at all, 2 = doubles).
function Items.rollGrowth(rng: Random): number
	return 1 + GROWTH_MIN * ((1 - rng:NextNumber()) ^ (-1 / GROWTH_TAIL) - 1)
end

-- How far through its growth an egg is (0 to 1) at fraction t of its hatch time: random
-- spurts and pauses, the same every time for the same seed (so the server and the clients
-- agree).
function Items.growthCurve(seed: number, t: number): number
	t = math.clamp(t, 0, 1)
	local rng = Random.new(seed)
	local steps, total = {}, 0
	for k = 1, 6 do
		steps[k] = rng:NextNumber() ^ 2 + 0.02
		total += steps[k]
	end
	local done = 0
	local position = t * 6
	for k = 1, 6 do
		local share = steps[k] / total
		if position >= k then
			done += share
		else
			local a = math.clamp(position - (k - 1), 0, 1)
			done += share * a * a * (3 - 2 * a) -- smoothstep: a spurt within the step
			break
		end
	end
	return math.min(done, 1)
end

-- An egg's weight (kg) at time `now` (os.time() on the server, Items.now() on clients). Eggs
-- on pedestals or carried don't grow; eggs in nests have startAt / endsAt / growth / seed.
function Items.eggWeightAt(egg, now: number?): number
	local weight = egg.weight or Items.eggBaseWeight(egg.egg or egg.zone or 1)
	if not egg.growth or not egg.startAt or not egg.endsAt or not now then
		return weight
	end
	local t = (now - egg.startAt) / math.max(egg.endsAt - egg.startAt, 1)
	return weight * egg.growth ^ Items.growthCurve(egg.seed or 1, t)
end

-- An item's (or egg's) weight factor: weight / normal weight (1 if it has none).
function Items.weightFactor(record): number
	local weight, base = record and record.weight, record and record.baseWeight
	if type(weight) ~= "number" or type(base) ~= "number" or base <= 0 then
		return 1
	end
	return weight / base
end

-- The colour heavy things are named in: white, then blue, gold, and hot pink for monsters.
function Items.weightColor(factor: number): Color3
	if factor >= 10 then
		return Color3.fromRGB(255, 80, 170)
	elseif factor >= 3 then
		return Color3.fromRGB(255, 205, 60)
	elseif factor >= 1.5 then
		return Color3.fromRGB(130, 225, 255)
	end
	return Color3.new(1, 1, 1)
end

-- How big something of this weight factor is drawn (a heavy thing is bigger, but not as
-- many times bigger as it is heavier).
function Items.weightScale(factor: number): number
	return math.max(factor, 0.05) ^ 0.45
end

-- How long an egg of each rarity grows in a nest (seconds).
Items.HATCH_SECONDS = {
	Common = 20,
	Uncommon = 45,
	Rare = 90,
	Legendary = 180,
	Mystic = 360,
	Ultra = 600,
	Secret = 900,
}
Items.NESTS = 3 -- nests every yard has (the Extra Nests pass adds 2)

-- The odds of a zone's eggs as a list, most likely first: { { rarity, percent } }.
function Items.oddsList(zoneIndex: number)
	local odds = Items.ZONES[zoneIndex].odds
	local total = 0
	for _, weight in odds do
		total += weight
	end
	local list = {}
	for rarity, weight in odds do
		table.insert(list, { rarity = rarity, percent = weight / total * 100 })
	end
	table.sort(list, function(a, b)
		return Rarities.rank[a.rarity] < Rarities.rank[b.rarity]
	end)
	return list
end

-- A random item of a kind and rarity (falling back to the next rarity down if there are
-- none of that rarity).
function Items.rollItem(kind: string, rarity: string, rng: Random): string
	for rank = Rarities.rank[rarity] or 1, 1, -1 do
		local pool = Items.pool(kind, Rarities.order[rank])
		if #pool > 0 then
			return pool[rng:NextInteger(1, #pool)]
		end
	end
	return Items.pool(kind, "Common")[1]
end

-- An egg's name from what's inside it: "Woofles Egg", "Swimming Pool Egg" (or the zone's
-- egg name, "Garden Egg", if it doesn't say).
function Items.itemEggName(zoneIndex: number, itemId: string?): string
	local item = itemId and Items.byId[itemId]
	return if item then item.name .. " Egg" else Items.eggName(zoneIndex)
end

-- Rolls an egg's rarity from a zone's odds. `boost` (>= 1) makes everything above Common
-- that many times likelier.
function Items.rollRarity(zoneIndex: number, rng: Random, boost: number?): string
	local odds = Items.ZONES[zoneIndex].odds
	local weights, total = {}, 0
	for _, rarity in Rarities.order do
		local weight = odds[rarity]
		if weight then
			weight *= if rarity == "Common" then 1 else (boost or 1)
			table.insert(weights, { rarity, weight })
			total += weight
		end
	end
	local roll = rng:NextNumber() * total
	for _, entry in weights do
		roll -= entry[2]
		if roll <= 0 then
			return entry[1]
		end
	end
	return weights[#weights][1]
end

-- Scales a model round its pivot (parts, their positions and sphere meshes).
function Items.scaleModel(model: Model, factor: number)
	if math.abs(factor - 1) < 0.001 then
		return
	end
	local pivot = model:GetPivot()
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			local rel = pivot:ToObjectSpace(p.CFrame)
			p.Size *= factor
			p.CFrame = pivot * (rel.Rotation + rel.Position * factor)
		elseif p:IsA("Attachment") then
			p.Position *= factor
		end
	end
	if model.PrimaryPart then
		local offset = model.PrimaryPart.PivotOffset
		model.PrimaryPart.PivotOffset = offset.Rotation + offset.Position * factor
	end
end

-- An egg's display name, e.g. "Garden Egg".
function Items.eggName(zoneIndex: number): string
	local zone = Items.ZONES[zoneIndex]
	return Items.KINDS[zone.kind].egg .. " Egg"
end

-- The time eggs count in (os.time() on the server), on the server or a client: clients
-- add the offset the server publishes to their synced clock.
function Items.now(): number
	local RunService = game:GetService("RunService")
	if RunService:IsServer() then
		return os.time()
	end
	local offset = game:GetService("ReplicatedStorage"):GetAttribute("OsTimeOffset") or 0
	return game:GetService("Workspace"):GetServerTimeNow() + offset
end

-- Speed -> walking speed, and guardian speeds (the Speed rules live in Parts).
Items.walkSpeed = Parts.walkSpeed
function Items.guardianSpeed(zoneIndex: number): number
	return Parts.walkSpeed(Items.ZONES[zoneIndex].speed) * 0.85
end

-- The highest zone a Speed is enough for.
function Items.zoneFor(speed: number): number
	local best = 1
	for index, zone in Items.ZONES do
		if speed >= zone.speed then
			best = index
		end
	end
	return best
end

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Lego</string>
          <string name="Source"><![CDATA[-- The LEGO look: everything is shiny plastic with studs on every face (inlets underneath),
-- like the classic Roblox bricks. Glowing (Neon), see-through (Glass), gold (Foil) and the
-- gate's force field keep their look, like the special pieces in a real set. Flat things
-- you walk or drive on (roads, sidewalks, paths, the treadmill belt) stay smooth, like
-- LEGO tiles.
--
-- The server applies it to everything in the Workspace as it's built (Lego.watch), and the
-- client to models it builds itself (guardians, pictures). Set ENABLED = false to go back to
-- the smooth cartoon look.

local Lego = {}

Lego.ENABLED = true
Lego.SIDE_STUDS = true -- studs on every face of a brick, not just the top
local MIN_STUD_FACE = 2 -- a face needs to be at least this many studs each way to get studs

-- Materials that stay as they are.
local KEEP = {
	[Enum.Material.Neon] = true,
	[Enum.Material.Glass] = true,
	[Enum.Material.Foil] = true,
	[Enum.Material.ForceField] = true,
}

-- Ice becomes clear "trans" plastic.
local TRANSLUCENT = {
	[Enum.Material.Ice] = 0.25,
}

-- Parts with these names stay smooth on top (tiles).
local SMOOTH = {
	Road = true,
	RoadLine = true,
	Sidewalk = true,
	Curb = true,
	PathStone = true,
	Belt = true,
	Screen = true,
	NameBoard = true, -- signs with writing on them
	TroughWater = true,
	Seam = true,
}

local function isAvatar(part: BasePart): boolean
	-- Players' own bodies are left alone (but what they carry isn't).
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if model.Name == "CarriedPart" then
			return false
		end
		if model:FindFirstChildOfClass("Humanoid") then
			return true
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return false
end

function Lego.part(part: BasePart)
	if not Lego.ENABLED or part.Transparency >= 1 or part:IsA("Terrain") then
		return
	end
	if KEEP[part.Material] then
		return
	end
	local clear = TRANSLUCENT[part.Material]
	part.Material = Enum.Material.Plastic
	if clear then
		part.Transparency = math.max(part.Transparency, clear)
	end
	local isBlock = part:IsA("Part") and part.Shape == Enum.PartType.Block or part:IsA("SpawnLocation")
	if isBlock and not SMOOTH[part.Name] and not part:FindFirstChildOfClass("SpecialMesh") then
		-- Studs only on faces big enough to hold whole rows of them: on small trims, caps and
		-- panes they'd be cut off at the edges, so those stay smooth like the round pieces.
		local size = part.Size
		local function face(a: number, b: number, kind: Enum.SurfaceType): Enum.SurfaceType
			return if a >= MIN_STUD_FACE and b >= MIN_STUD_FACE then kind else Enum.SurfaceType.Smooth
		end
		part.TopSurface = face(size.X, size.Z, Enum.SurfaceType.Studs)
		part.BottomSurface = face(size.X, size.Z, Enum.SurfaceType.Inlet)
		if Lego.SIDE_STUDS then
			-- The classic Roblox look: the stud texture on the sides as well.
			part.FrontSurface = face(size.X, size.Y, Enum.SurfaceType.Studs)
			part.BackSurface = face(size.X, size.Y, Enum.SurfaceType.Studs)
			part.LeftSurface = face(size.Z, size.Y, Enum.SurfaceType.Studs)
			part.RightSurface = face(size.Z, size.Y, Enum.SurfaceType.Studs)
		end
	end
end

-- Applies the look to everything under `root`.
function Lego.apply(root: Instance)
	if not Lego.ENABLED then
		return
	end
	if root:IsA("BasePart") then
		Lego.part(root)
	end
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("BasePart") and not isAvatar(descendant) then
			Lego.part(descendant)
		end
	end
end

-- Applies the look to everything under `root` now and to anything added later.
function Lego.watch(root: Instance)
	if not Lego.ENABLED then
		return
	end
	Lego.apply(root)
	root.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then
			-- Next frame: let whoever built it finish setting its material first.
			task.defer(function()
				if descendant.Parent and not isAvatar(descendant) then
					Lego.part(descendant)
				end
			end)
		end
	end)
end

return Lego
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">LifeUtil</string>
          <string name="Source"><![CDATA[-- Helpers for a player's save, shared by the server and the UI.
--
-- data.parts = { [uid] = { id = itemId, mutations? } }: every item the player owns (house
-- parts, pets, yard items, plants; see Items.luau). Items are "out" in one place each:
--   data.house  = { [slotId] = uid }     house parts on the house (a slot with none shows Basic)
--   data.pen    = { [uid] = true }       pets roaming the yard (up to Items.PET_SLOTS)
--   data.yard   = { ["1".."6"] = uid }   yard items on the yard spots
--   data.garden = { ["1".."6"] = uid }   plants in the garden beds
-- Everything else is in the backpack.
-- data.nests = { ["1".."5"] = { zone, rarity, endsAt, mutations? } }: eggs growing at home.

local Config = require(script.Parent.Config)
local Format = require(script.Parent.Format)
local Items = require(script.Parent.Items)
local Mutations = require(script.Parent.Mutations)
local Parts = require(script.Parent.Parts)

local LifeUtil = {}

-- The part id on a house slot (Basic if nothing is).
function LifeUtil.installed(data, slotId: string): string
	local uid = data.house and data.house[slotId]
	local owned = uid and data.parts[uid]
	return if owned then owned.id else Parts.basic(slotId)
end

-- The part on a house slot (nil for Basic) and its uid.
function LifeUtil.installedRecord(data, slotId: string)
	local uid = data.house and data.house[slotId]
	local owned = uid and data.parts[uid]
	return owned, if owned then uid else nil
end

-- { [slotId] = partId } for HouseModel.house.
function LifeUtil.layout(data): { [string]: string }
	local layout = {}
	for _, slot in Parts.SLOTS do
		layout[slot.id] = LifeUtil.installed(data, slot.id)
	end
	return layout
end

-- What one item earns a second (before game passes).
function LifeUtil.itemIncome(record): number
	local item = record and Items.byId[record.id]
	if not item then
		return 0
	end
	return item.income * Mutations.mult(record.mutations) * Items.weightFactor(record)
end
LifeUtil.partIncome = LifeUtil.itemIncome

-- uid -> where it is ("house:Roof", "pen", "yard:3", "garden:2") for everything that's out.
function LifeUtil.placed(data): { [string]: string }
	local where = {}
	for slotId, uid in data.house or {} do
		where[uid] = "house:" .. slotId
	end
	for uid in data.pen or {} do
		where[uid] = "pen"
	end
	for spot, uid in data.yard or {} do
		where[uid] = "yard:" .. spot
	end
	for bed, uid in data.garden or {} do
		where[uid] = "garden:" .. bed
	end
	return where
end

-- Everything out earning (passes are added by the server).
function LifeUtil.totalIncome(data): number
	local total = 0
	for _, slot in Parts.SLOTS do
		local record = LifeUtil.installedRecord(data, slot.id)
		total += LifeUtil.itemIncome(record or { id = Parts.basic(slot.id) })
	end
	for uid, where in LifeUtil.placed(data) do
		if string.sub(where, 1, 6) ~= "house:" then
			total += LifeUtil.itemIncome(data.parts[uid])
		end
	end
	return total
end
LifeUtil.houseIncome = LifeUtil.totalIncome

-- The uids in the backpack (owned, not out), best first.
function LifeUtil.backpack(data): { string }
	local placed = LifeUtil.placed(data)
	local list = {}
	for uid in data.parts do
		if not placed[uid] then
			table.insert(list, uid)
		end
	end
	table.sort(list, function(a, b)
		local ia, ib = LifeUtil.itemIncome(data.parts[a]), LifeUtil.itemIncome(data.parts[b])
		if ia ~= ib then
			return ia > ib
		end
		return a < b
	end)
	return list
end

function LifeUtil.backpackCount(data): number
	return #LifeUtil.backpack(data)
end

function LifeUtil.sellPrice(record): number
	return math.floor(LifeUtil.itemIncome(record) * Config.SELL_MULTIPLIER)
end

-- "Golden Candy Roof" (weights are shown separately: LifeUtil.weightText)
function LifeUtil.displayName(record): string
	local item = Items.byId[record.id]
	local name = if item then item.name else record.id
	local top = Mutations.top(record.mutations)
	return if top then top .. " " .. name else name
end

-- "⚖ 4.21 kg" (or "" for something with no weight).
function LifeUtil.weightText(record): string
	if not record or type(record.weight) ~= "number" then
		return ""
	end
	return "⚖ " .. Format.weight(record.weight)
end

-- The pets out in the yard, as a list of uids.
function LifeUtil.pets(data): { string }
	local list = {}
	for uid in data.pen or {} do
		if data.parts[uid] then
			table.insert(list, uid)
		end
	end
	table.sort(list)
	return list
end

-- For yard spots and garden beds: the first free spot, or the spot with the worst item
-- (and that item's income).
local function bestSpot(data, where, count: number)
	local worstSpot, worstIncome = nil, math.huge
	for n = 1, count do
		local key = tostring(n)
		local uid = where[key]
		if not uid or not data.parts[uid] then
			return key, -1
		end
		local income = LifeUtil.itemIncome(data.parts[uid])
		if income < worstIncome then
			worstSpot, worstIncome = key, income
		end
	end
	return worstSpot, worstIncome
end

-- Puts an item the player owns (uid) out where it fits if it's an upgrade: onto its house
-- slot, into the yard as a pet, onto a yard spot or into a garden bed. Whatever it replaces
-- goes back to the backpack. Returns where it went ("house", "pen", "yard", "garden") or
-- "backpack" if it wasn't better than anything out.
function LifeUtil.placeIfBetter(data, uid: string): string
	local record = data.parts[uid]
	local item = record and Items.byId[record.id]
	if not item then
		return "backpack"
	end
	local income = LifeUtil.itemIncome(record)
	data.pen = data.pen or {}
	data.yard = data.yard or {}
	data.garden = data.garden or {}
	if item.kind == "House" then
		local current = LifeUtil.installedRecord(data, item.slot)
		if income > LifeUtil.itemIncome(current or { id = Parts.basic(item.slot) }) then
			data.house[item.slot] = uid
			return "house"
		end
	elseif item.kind == "Pet" then
		local pets = LifeUtil.pets(data)
		if #pets < Items.PET_SLOTS then
			data.pen[uid] = true
			return "pen"
		end
		local worst, worstIncome = nil, math.huge
		for _, other in pets do
			local otherIncome = LifeUtil.itemIncome(data.parts[other])
			if otherIncome < worstIncome then
				worst, worstIncome = other, otherIncome
			end
		end
		if worst and income > worstIncome then
			data.pen[worst] = nil
			data.pen[uid] = true
			return "pen"
		end
	elseif item.kind == "Yard" or item.kind == "Plant" then
		local where = if item.kind == "Yard" then data.yard else data.garden
		local count = if item.kind == "Yard" then Items.YARD_SPOTS else Items.GARDEN_BEDS
		local spot, worstIncome = bestSpot(data, where, count)
		if spot and income > worstIncome then
			where[spot] = uid
			return if item.kind == "Yard" then "yard" else "garden"
		end
	end
	return "backpack"
end

-- Whether putting this backpack item out would earn more (without changing the save).
function LifeUtil.isUpgrade(data, uid: string): boolean
	local copy = {
		parts = data.parts,
		house = table.clone(data.house or {}),
		pen = table.clone(data.pen or {}),
		yard = table.clone(data.yard or {}),
		garden = table.clone(data.garden or {}),
	}
	return LifeUtil.placeIfBetter(copy, uid) ~= "backpack"
end

-- Takes an item off wherever it's out (it goes to the backpack).
function LifeUtil.takeOff(data, uid: string)
	for slotId, other in data.house or {} do
		if other == uid then
			data.house[slotId] = nil
		end
	end
	if data.pen then
		data.pen[uid] = nil
	end
	for _, where in { data.yard or {}, data.garden or {} } do
		for spot, other in where do
			if other == uid then
				where[spot] = nil
			end
		end
	end
end

-- The nest numbers the player can use (Extra Nests adds two).
function LifeUtil.nestCount(extraNests: boolean): number
	return Items.NESTS + (if extraNests then 2 else 0)
end

return LifeUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Luck</string>
          <string name="Source"><![CDATA[-- Luck: Mystery Boxes, the daily Lucky Wheel and Lucky Hour events. Shared so the client
-- can show every chance on screen (players always see the odds before buying), while the
-- server does all the rolling (server/LuckService).
--
-- Mystery Boxes are Developer Products bought with Robux: each one opens into a random item
-- (a rarity rolled from the box's odds, then any house part, pet, yard item or plant of that
-- rarity, each equally likely). Roblox's rules for paid
-- random items: the odds are shown before buying, and players in countries where paid
-- random items aren't allowed can't buy them (LuckService checks PolicyService).

local Rarities = require(script.Parent.Rarities)

local Luck = {}

-- Mystery Boxes. In the code they're still called crates (and the product ids are the ones
-- first made for the old Monster Eggs: rename those products on the dashboard).
-- productId: the Developer Product's ID. odds are weights per rarity; mutation
-- multiplies each mutation's normal chance.
Luck.CRATES = {
	{
		id = "Monster",
		name = "Mystery Box",
		robux = 49,
		productId = 3718866310,
		color = Color3.fromRGB(255, 140, 30),
		odds = { Uncommon = 45, Rare = 35, Legendary = 15, Mystic = 4.5, Ultra = 0.5 },
		mutation = 1,
	},
	{
		id = "MegaMonster",
		name = "Mega Mystery Box",
		robux = 149,
		productId = 3718866430,
		color = Color3.fromRGB(160, 110, 240),
		odds = { Rare = 30, Legendary = 40, Mystic = 22, Ultra = 7.5, Secret = 0.5 },
		mutation = 2,
	},
	{
		id = "LegendaryMonster",
		name = "Legendary Mystery Box",
		robux = 399,
		productId = 3718866530,
		color = Color3.fromRGB(255, 200, 60),
		odds = { Legendary = 40, Mystic = 35, Ultra = 20, Secret = 5 },
		mutation = 3,
	},
}
-- Opens boxes for free in Studio when they have no product ID yet (for testing).
Luck.STUDIO_FREE_CRATES = true

-- The Starter Pack: a one-time offer for a player's first STARTER.hours after they first
-- join. It's a game pass (passId); its contents are given once, the first time the server
-- sees the player owns it. The boxes are saved to open from the Luck tab.
Luck.STARTER = {
	name = "Starter Pack",
	robux = 499,
	passId = 2040722277,
	hours = 12,
	coins = 50000,
	crates = { LegendaryMonster = 3 },
}

-- Box bundles (Developer Products): several boxes at once, cheaper than one by one.
Luck.BUNDLES = {
	{
		id = "LegendaryTen",
		name = "10x Legendary Mystery Boxes",
		robux = 2800,
		productId = 3718869744,
		crate = "LegendaryMonster",
		count = 10,
	},
}

Luck.crateById = {}
Luck.crateByProduct = {}
for _, crate in Luck.CRATES do
	Luck.crateById[crate.id] = crate
	if crate.productId ~= 0 then
		Luck.crateByProduct[crate.productId] = crate
	end
end
Luck.bundleById = {}
Luck.bundleByProduct = {}
for _, bundle in Luck.BUNDLES do
	Luck.bundleById[bundle.id] = bundle
	if bundle.productId ~= 0 then
		Luck.bundleByProduct[bundle.productId] = bundle
	end
end

-- How much cheaper a bundle is than buying its boxes one by one (percent).
function Luck.bundleSaving(bundle): number
	local single = Luck.crateById[bundle.crate].robux * bundle.count
	return math.floor((1 - bundle.robux / single) * 100 + 0.5)
end

-- The crate's odds right now (Crate Luck makes the rarest ones likelier), as weights.
function Luck.crateOdds(crate): { [string]: number }
	local event = Luck.current()
	local boost = event and event.crateLuck or 1
	local odds = {}
	for rarity, weight in crate.odds do
		local rare = Rarities.rank[rarity] >= Rarities.rank.Mystic
		odds[rarity] = if rare then weight * boost else weight
	end
	return odds
end

-- The crate's odds as a list, most likely first: { { rarity, percent } }.
function Luck.oddsList(crate)
	local odds = Luck.crateOdds(crate)
	local total = 0
	for _, weight in odds do
		total += weight
	end
	local list = {}
	for rarity, weight in odds do
		table.insert(list, { rarity = rarity, percent = weight / total * 100 })
	end
	table.sort(list, function(a, b)
		return a.percent > b.percent
	end)
	return list
end

-- The Lucky Wheel: one free spin a day (twice a day with VIP). Coin prizes are minutes of
-- the player's own income, so they stay worth it as the player grows.
Luck.SPIN_COOLDOWN = 24 * 60 * 60
Luck.VIP_SPIN_COOLDOWN = 12 * 60 * 60
Luck.WHEEL = {
	{ label = "Coins", minutes = 3, weight = 34, color = Color3.fromRGB(110, 235, 140) },
	{ label = "Big Coins", minutes = 10, weight = 22, color = Color3.fromRGB(60, 200, 110) },
	{ label = "Golden Egg", golden = true, weight = 14, color = Color3.fromRGB(255, 220, 90) },
	{ label = "Mystery Box", crate = "Monster", weight = 12, color = Color3.fromRGB(255, 140, 30) },
	{ label = "Huge Coins", minutes = 30, weight = 10, color = Color3.fromRGB(40, 160, 90) },
	{ label = "Rainbow Egg", rainbow = true, weight = 4, color = Color3.fromRGB(255, 120, 255) },
	{ label = "Mega Box", crate = "MegaMonster", weight = 3, color = Color3.fromRGB(160, 110, 240) },
	{ label = "JACKPOT", crate = "LegendaryMonster", weight = 1, color = Color3.fromRGB(255, 200, 60) },
}
Luck.MIN_COIN_PRIZE = 200 -- coin prizes are never less than this

function Luck.wheelPercent(index: number): number
	local total = 0
	for _, slice in Luck.WHEEL do
		total += slice.weight
	end
	return Luck.WHEEL[index].weight / total * 100
end

-- Lucky Hour events: every so often a random one runs server-wide for DURATION seconds.
-- The current one is published as ReplicatedStorage attributes (see Luck.current).
Luck.EVENT_DURATION = 10 * 60
Luck.EVENT_GAP = { 20 * 60, 35 * 60 } -- seconds between events (random in this range)
Luck.FIRST_EVENT_AFTER = 3 * 60 -- the first one comes soon after a server starts
Luck.EVENTS = {
	Rainbow = {
		name = "Rainbow Hour",
		icon = "🌈",
		description = "Eggs in the zones are 5x as likely to be mutated!",
		color = Color3.fromRGB(255, 120, 255),
		mutationBoost = 5,
	},
	LuckySkies = {
		name = "Lucky Zones",
		icon = "🍀",
		description = "Rarer eggs turn up in the zones 3x as often!",
		color = Color3.fromRGB(90, 230, 120),
		rareBoost = 3,
	},
	RapidFire = {
		name = "Fast Regrow",
		icon = "💥",
		description = "Eggs regrow in the zones twice as fast!",
		color = Color3.fromRGB(255, 140, 50),
		respawnBoost = 2,
	},
	CrateLuck = {
		name = "Box Luck",
		icon = "📦",
		description = "Mystic and better items are 2x as likely from Mystery Boxes!",
		color = Color3.fromRGB(110, 200, 255),
		crateLuck = 2,
	},
}

-- The Lucky Hour event running right now (or nil), from the attributes the server sets.
function Luck.current()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local id = ReplicatedStorage:GetAttribute("LuckyEvent")
	local ends = ReplicatedStorage:GetAttribute("LuckyEventEnds") or 0
	if id and Luck.EVENTS[id] and game:GetService("Workspace"):GetServerTimeNow() < ends then
		return Luck.EVENTS[id], ends
	end
	return nil, 0
end

return Luck
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Mutations</string>
          <string name="Source"><![CDATA[-- Mutations multiply a house part's income. Parts grow with them in the zone piles (chance
-- per part, see ZoneService), weather events add them to parts on houses, and the Lucky
-- Wheel gives Golden and Rainbow parts.
-- Rarest first.
--
-- A part can carry several mutations. They're saved as a list ({ "Rainbow", "Golden" }),
-- or nil for none, and their multipliers stack (Golden + Shadow = x6).

local Mutations = {}

Mutations.list = {
	{ id = "Rainbow", mult = 10, chance = 0.01, color = Color3.fromRGB(255, 120, 255) },
	{ id = "Golden", mult = 3, chance = 0.04, color = Color3.fromRGB(255, 200, 50) },
	{ id = "Shadow", mult = 2, chance = 0.07, color = Color3.fromRGB(160, 90, 255) },
}

Mutations.byId = {}
for index, mutation in Mutations.list do
	mutation.rank = index
	Mutations.byId[mutation.id] = mutation
end

-- A part's mutations as a list, rarest first. Accepts a list, a single id (old saves) or nil.
function Mutations.normalize(value): { string }
	local list = {}
	if type(value) == "string" then
		value = { value }
	end
	for _, id in value or {} do
		if Mutations.byId[id] and not table.find(list, id) then
			table.insert(list, id)
		end
	end
	table.sort(list, function(a, b)
		return Mutations.byId[a].rank < Mutations.byId[b].rank
	end)
	return list
end

-- The rarest mutation, which decides how the part sparkles and what colour its name is.
function Mutations.top(value): string?
	return Mutations.normalize(value)[1]
end

-- Combined income multiplier for all of a part's mutations.
function Mutations.mult(value): number
	local mult = 1
	for _, id in Mutations.normalize(value) do
		mult *= Mutations.byId[id].mult
	end
	return mult
end

-- The list to store on a Freek record (nil when there are none).
function Mutations.pack(value): { string }?
	local list = Mutations.normalize(value)
	return if #list > 0 then list else nil
end

return Mutations
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Parts</string>
          <string name="Source"><![CDATA[-- House parts: one of the four kinds of item (see Items.luau), hatched from Hardware Eggs
-- and snapped onto the house.
--
-- A house has a fixed set of SLOTS (door, windows, roof...). Every part is one slot built in
-- one STYLE (Scrap, Log Cabin, Stone...). A style has a rarity, and the part's income is the
-- style's base income times the slot's weight. Part ids are "<Style>_<Slot>", e.g.
-- "Candy_Roof" (saves store them, so never rename a style or slot).
--
-- Everyone starts with the "Basic" style in every slot. Basic parts never hatch and can't be
-- sold; an empty slot shows Basic.

local Rarities = require(script.Parent.Rarities)

local Parts = {}

-- The snap slots on every house, in the order the UI lists them. weight scales income
-- (big pieces earn more).
Parts.SLOTS = {
	{ id = "Walls", name = "Walls", icon = "🧱", weight = 1.6 },
	{ id = "Roof", name = "Roof", icon = "🏠", weight = 1.4 },
	{ id = "Door", name = "Door", icon = "🚪", weight = 1 },
	{ id = "Windows", name = "Windows", icon = "🪟", weight = 1 },
	{ id = "Tower", name = "Tower", icon = "🏰", weight = 1.5 },
	{ id = "Chimney", name = "Chimney", icon = "🔥", weight = 0.7 },
	{ id = "Porch", name = "Porch", icon = "🪜", weight = 0.9 },
	{ id = "Fence", name = "Fence", icon = "🚧", weight = 0.8 },
	{ id = "Garden", name = "Garden", icon = "🌷", weight = 0.8 },
	{ id = "Mailbox", name = "Mailbox", icon = "📫", weight = 0.6 },
}
Parts.slotById = {}
for index, slot in Parts.SLOTS do
	slot.order = index
	Parts.slotById[slot.id] = slot
end

-- Styles, worst to best (Basic is given to everyone). income is per second for a weight-1
-- slot.
Parts.STYLES = {
	{ id = "Basic", name = "Basic", rarity = "Common", income = 1 },
	{ id = "Scrap", name = "Scrap", rarity = "Common", income = 3, zone = 1 },
	{ id = "Log", name = "Log Cabin", rarity = "Common", income = 8, zone = 2 },
	{ id = "Stone", name = "Stone", rarity = "Uncommon", income = 20, zone = 3 },
	{ id = "Sand", name = "Sandstone", rarity = "Uncommon", income = 50, zone = 4 },
	{ id = "Ice", name = "Ice", rarity = "Rare", income = 125, zone = 5 },
	{ id = "Candy", name = "Candy", rarity = "Rare", income = 300, zone = 6 },
	{ id = "Lava", name = "Lava", rarity = "Legendary", income = 750, zone = 7 },
	{ id = "Royal", name = "Royal", rarity = "Legendary", income = 1900, zone = 8 },
	{ id = "Crystal", name = "Crystal", rarity = "Mystic", income = 4800, zone = 9 },
	{ id = "Cloud", name = "Cloud", rarity = "Ultra", income = 12000, zone = 10 },
	{ id = "Rainbow", name = "Rainbow", rarity = "Secret", income = 40000, zone = 10, secret = true },
}
Parts.styleById = {}
for index, style in Parts.STYLES do
	style.tier = index
	Parts.styleById[style.id] = style
end

-- Every part, by id.
Parts.byId = {}
Parts.list = {}
for _, style in Parts.STYLES do
	for _, slot in Parts.SLOTS do
		local part = {
			id = style.id .. "_" .. slot.id,
			style = style.id,
			slot = slot.id,
			name = style.name .. " " .. slot.name,
			rarity = style.rarity,
			income = math.max(1, math.floor(style.income * slot.weight + 0.5)),
			tier = style.tier,
		}
		Parts.byId[part.id] = part
		table.insert(Parts.list, part)
	end
end

function Parts.basic(slotId: string): string
	return "Basic_" .. slotId
end

function Parts.isBasic(partId: string): boolean
	local part = Parts.byId[partId]
	return part ~= nil and part.style == "Basic"
end

function Parts.color(partId: string): Color3
	local part = Parts.byId[partId]
	return Rarities.info[part and part.rarity or "Common"].color
end

-- Speed -> walking speed. Grows quickly at first and slowly later, so every zone feels faster
-- but nobody becomes uncontrollable: 0 speed walks at 16, 50M speed at about 53.
function Parts.walkSpeed(speed: number): number
	return 16 + 6 * math.log10(1 + math.max(speed, 0) / 30)
end

return Parts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">PlantModel</string>
          <string name="Source"><![CDATA[-- Plants, built from bricks. PlantModel.build(itemId) returns a model standing on its pivot
-- (the middle of a garden bed, about 7 x 7 studs).

local Bricks = require(script.Parent.Bricks)
local Items = require(script.Parent.Items)

local PlantModel = {}

local rgb, block, ball, post = Bricks.rgb, Bricks.block, Bricks.ball, Bricks.post
local M = Enum.Material
local STEM = rgb(70, 165, 70)
local LEAF = rgb(60, 180, 75)
local TRUNK = rgb(125, 85, 50)

-- A flower head: `petals` blocks round a centre ball, facing -Z.
local function flower(m, cf: CFrame, size: number, petal: Color3, middle: Color3, petals: number?)
	local n = petals or 8
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2
		ball(
			m,
			Vector3.new(size * 0.55, size * 0.3, size * 0.15),
			cf * CFrame.Angles(0, 0, a) * CFrame.new(size * 0.45, 0, 0),
			petal
		)
	end
	ball(m, Vector3.new(size * 0.45, size * 0.45, size * 0.25), cf * CFrame.new(0, 0, -0.05), middle)
end

local function leaves(m, cf: CFrame, size: number)
	for _, side in { -1, 1 } do
		ball(
			m,
			Vector3.new(size, size * 0.3, size * 0.55),
			cf * CFrame.new(side * size * 0.45, 0, 0) * CFrame.Angles(0, 0, math.rad(side * 25)),
			LEAF
		)
	end
end

-- A tree of stacked leaf bricks (like the town trees).
local function brickTree(m, height: number, width: number, colors: { Color3 }, trunk: Color3?)
	block(m, Vector3.new(width * 0.2, height * 0.45, width * 0.2), CFrame.new(0, height * 0.225, 0), trunk or TRUNK)
	local y = height * 0.38
	local layers = #colors
	for i, color in colors do
		local w = width * (1 - (i - 1) / (layers + 1))
		local h = height * 0.62 / layers
		block(
			m,
			Vector3.new(w, h, w),
			CFrame.new(0, y + h / 2, 0) * CFrame.Angles(0, if i % 2 == 0 then math.rad(45) else 0, 0),
			color
		)
		y += h
	end
	return y
end

local builders = {}

function builders.Daisy(m)
	for i, x in { -1.6, 0, 1.6 } do
		local h = 2.4 + (i % 2) * 0.8
		post(m, h, 0.25, CFrame.new(x, 0, (i % 2) * 0.8), STEM)
		flower(m, CFrame.new(x, h, (i % 2) * 0.8), 1.4, rgb(255, 255, 255), rgb(255, 210, 40))
		leaves(m, CFrame.new(x, h * 0.4, (i % 2) * 0.8), 0.9)
	end
end

function builders.Tulip(m)
	for i, x in { -1.8, 0, 1.8 } do
		local h = 3 + (i % 2) * 0.7
		local color = ({ rgb(255, 70, 110), rgb(255, 200, 40), rgb(190, 90, 255) })[i]
		post(m, h, 0.3, CFrame.new(x, 0, 0), STEM)
		ball(m, Vector3.new(1.2, 1.5, 1.2), CFrame.new(x, h + 0.6, 0), color)
		for k = 0, 2 do
			local a = k / 3 * math.pi * 2
			ball(m, Vector3.new(0.5, 1, 0.5), CFrame.new(x + math.cos(a) * 0.4, h + 1.2, math.sin(a) * 0.4), color)
		end
		leaves(m, CFrame.new(x, 0.9, 0), 1.1)
	end
end

function builders.Sunflower(m)
	post(m, 7, 0.5, CFrame.new(0, 0, 0), STEM)
	leaves(m, CFrame.new(0, 2.5, 0), 1.6)
	leaves(m, CFrame.new(0, 4.5, 0) * CFrame.Angles(0, math.pi / 2, 0), 1.4)
	local head = CFrame.new(0, 7.4, -0.3) * CFrame.Angles(math.rad(-15), 0, 0)
	flower(m, head, 3.6, rgb(255, 210, 30), rgb(120, 70, 30), 12)
	-- A face, for fun.
	for _, x in { -0.35, 0.35 } do
		ball(m, 0.3, head * CFrame.new(x, 0.25, -0.5), rgb(30, 25, 20))
	end
end

function builders.RoseBush(m)
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		ball(m, 2.6, CFrame.new(math.cos(a) * 1.4, 1.4 + (k % 2) * 0.5, math.sin(a) * 1.4), LEAF)
	end
	ball(m, 2.8, CFrame.new(0, 2.6, 0), rgb(50, 160, 65))
	for k = 0, 8 do
		local a = k / 9 * math.pi * 2
		ball(m, 0.8, CFrame.new(math.cos(a) * 1.9, 2 + (k % 3) * 0.6, math.sin(a) * 1.9), rgb(230, 30, 60))
	end
	ball(m, 0.9, CFrame.new(0, 4, 0), rgb(255, 60, 90))
end

function builders.Cactus(m)
	local green = rgb(60, 175, 80)
	block(m, Vector3.new(1.8, 7, 1.8), CFrame.new(0, 3.5, 0), green)
	for _, side in { -1, 1 } do
		block(m, Vector3.new(1.6, 1.2, 1.2), CFrame.new(side * 1.5, 3 + (side + 1) * 0.6, 0), green)
		block(m, Vector3.new(1.2, 2.6, 1.2), CFrame.new(side * 2, 4.4 + (side + 1) * 0.6, 0), green)
	end
	ball(m, 1.1, CFrame.new(0, 7.3, 0), rgb(255, 110, 170))
	-- A sandy pot.
	block(m, Vector3.new(3.4, 1, 3.4), CFrame.new(0, 0.5, 0), rgb(220, 120, 70))
end

function builders.AppleTree(m)
	local top = brickTree(m, 10, 6, { rgb(60, 170, 70), rgb(75, 185, 75), rgb(90, 200, 85) })
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		ball(m, 0.8, CFrame.new(math.cos(a) * 2.6, 6 + (k % 3) * 0.9, math.sin(a) * 2.6), rgb(230, 40, 40))
	end
	ball(m, 0.7, CFrame.new(0, top + 0.3, 0), rgb(230, 40, 40))
end

function builders.Pumpkin(m)
	local orange = rgb(255, 140, 30)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		ball(
			m,
			Vector3.new(2.6, 3.6, 2.6),
			CFrame.new(math.cos(a) * 1.4, 1.8, math.sin(a) * 1.4),
			orange:Lerp(rgb(230, 100, 20), (k % 2) * 0.4)
		)
	end
	ball(m, Vector3.new(3.6, 3.8, 3.6), CFrame.new(0, 1.9, 0), orange)
	post(m, 1.2, 0.6, CFrame.new(0, 3.6, 0), rgb(90, 140, 50))
	leaves(m, CFrame.new(0, 0.4, 2.4), 2)
end

function builders.Blossom(m)
	local pinks = { rgb(255, 160, 200), rgb(255, 185, 215), rgb(255, 210, 230) }
	local top = brickTree(m, 10, 6.5, pinks, rgb(100, 60, 50))
	for k = 0, 9 do
		local a = k * 2.3
		ball(m, 0.5, CFrame.new(math.cos(a) * 3, 3 + (k % 4) * 1.3, math.sin(a) * 3), rgb(255, 230, 240))
	end
	ball(m, 0.8, CFrame.new(0, top + 0.3, 0), rgb(255, 120, 180))
end

function builders.CrystalFlower(m)
	post(m, 4.6, 0.4, CFrame.new(0, 0, 0), rgb(90, 200, 190))
	leaves(m, CFrame.new(0, 1.6, 0), 1.2)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		block(
			m,
			Vector3.new(0.7, 2.6, 0.7),
			CFrame.new(0, 5.2, 0)
				* CFrame.Angles(math.rad(35) * math.cos(a), 0, math.rad(35) * math.sin(a))
				* CFrame.new(0, 1, 0),
			if k % 2 == 0 then rgb(130, 240, 255) else rgb(200, 140, 255),
			M.Neon
		)
	end
	ball(m, 1, CFrame.new(0, 5.2, 0), rgb(255, 255, 255), M.Neon)
end

function builders.GlowShroom(m)
	post(m, 3.6, 1.4, CFrame.new(0, 0, 0), rgb(245, 235, 215))
	ball(m, Vector3.new(5.6, 2.8, 5.6), CFrame.new(0, 4, 0), rgb(150, 60, 220))
	for k = 0, 6 do
		local a = k / 7 * math.pi * 2
		ball(m, 0.8, CFrame.new(math.cos(a) * 1.8, 4.6 + (k % 2) * 0.3, math.sin(a) * 1.8), rgb(120, 255, 200), M.Neon)
	end
	ball(m, 0.9, CFrame.new(0, 5.4, 0), rgb(120, 255, 200), M.Neon)
	-- Two little ones.
	for _, x in { -2.3, 2.2 } do
		post(m, 1.2, 0.5, CFrame.new(x, 0, -1.4), rgb(245, 235, 215))
		ball(m, Vector3.new(1.6, 0.9, 1.6), CFrame.new(x, 1.4, -1.4), rgb(150, 60, 220))
	end
end

function builders.MoneyTree(m)
	local greens = { rgb(70, 180, 80), rgb(90, 200, 90), rgb(110, 215, 100) }
	brickTree(m, 11, 6.5, greens)
	-- Bills and gold coins growing on it.
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		block(
			m,
			Vector3.new(1.2, 0.6, 0.1),
			CFrame.new(math.cos(a) * 3.1, 6 + (k % 3) * 1.1, math.sin(a) * 3.1) * CFrame.Angles(0, -a, math.rad(15)),
			rgb(120, 220, 110)
		)
	end
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2 + 0.3
		local coin = Bricks.rod(
			m,
			0.2,
			0.9,
			CFrame.new(math.cos(a) * 2.4, 8.5 + (k % 2), math.sin(a) * 2.4) * CFrame.Angles(0, -a, 0),
			rgb(255, 205, 60),
			M.Foil
		)
		coin.Name = "Coin"
	end
	-- A pile of gold at the bottom.
	for k = 0, 3 do
		Bricks.rod(
			m,
			0.25,
			1.1,
			CFrame.new(-1.6 + k * 0.4, 0.15 + k * 0.25, -2) * CFrame.Angles(0, 0, math.pi / 2),
			rgb(255, 205, 60),
			M.Foil
		)
	end
end

function builders.RainbowTree(m)
	block(m, Vector3.new(1.4, 5, 1.4), CFrame.new(0, 2.5, 0), rgb(255, 255, 255))
	local y = 4.4
	for i, color in Bricks.RAINBOW do
		local w = 7.2 - i * 0.9
		block(
			m,
			Vector3.new(w, 1.1, w),
			CFrame.new(0, y + 0.55, 0) * CFrame.Angles(0, math.rad(i * 15), 0),
			color,
			if i % 2 == 0 then M.Neon else nil
		)
		y += 1.1
	end
	ball(m, 1.2, CFrame.new(0, y + 0.5, 0), rgb(255, 255, 220), M.Neon)
end

function PlantModel.build(itemId: string): Model
	local item = Items.byId[itemId]
	local model = Instance.new("Model")
	model.Name = itemId
	model:SetAttribute("Item", itemId)
	local builder = item and builders[item.model]
	if builder then
		builder(model)
	end
	-- Stand it on its base. Roblox puts a new model's pivot in the middle of its parts, which
	-- would sink it halfway into whatever it's put on.
	model.WorldPivot = CFrame.identity
	return model
end

return PlantModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Rarities</string>
          <string name="Source"><![CDATA[-- Rarity tiers, lowest to highest. breedTime is in seconds. carrySpeed is how fast a thief
-- (breedTime and carrySpeed are left over from the Freek days and unused.)

local Rarities = {}

Rarities.order = { "Common", "Uncommon", "Rare", "Legendary", "Mystic", "Ultra", "Secret" }

Rarities.info = {
	Common = { color = Color3.fromRGB(200, 200, 200), breedTime = 30, carrySpeed = 15 },
	Uncommon = { color = Color3.fromRGB(90, 220, 90), breedTime = 60, carrySpeed = 14 },
	Rare = { color = Color3.fromRGB(70, 150, 255), breedTime = 120, carrySpeed = 12.5 },
	Legendary = { color = Color3.fromRGB(255, 180, 40), breedTime = 300, carrySpeed = 11 },
	Mystic = { color = Color3.fromRGB(190, 90, 255), breedTime = 600, carrySpeed = 9.5 },
	Ultra = { color = Color3.fromRGB(255, 60, 100), breedTime = 1200, carrySpeed = 8 },
	Secret = { color = Color3.fromRGB(255, 255, 255), breedTime = 2400, carrySpeed = 6.5 },
}

Rarities.rank = {}
for i, name in Rarities.order do
	Rarities.rank[name] = i
end

return Rarities
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- One place that names every remote. The server creates them; clients wait for them.
--
-- Action          client -> server   (actionName, ...args)
-- State           server -> client   (snapshot of the player's own data)
-- Notify          server -> client   (message, kind?)
-- DiscoveryUpdate server -> client   (speciesId, discovery)
-- Trade           server -> client   ("Request" | "State" | "Closed", payload)
-- Knockback       server -> client   (direction: Vector3, strength: number, seconds: number)
-- LuckResult      server -> client   ({ kind = "crate" | "wheel", ... }) what a crate/spin gave
-- GetState        client -> server   returns snapshot once data has loaded
-- GetDiscoveries  client -> server   returns { [speciesId] = discovery }
-- Admin           client -> server   (command, args) admin panel; returns (ok, message)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local KINDS = {
	Action = "RemoteEvent",
	State = "RemoteEvent",
	Notify = "RemoteEvent",
	DiscoveryUpdate = "RemoteEvent",
	Trade = "RemoteEvent",
	Knockback = "RemoteEvent",
	LuckResult = "RemoteEvent",
	GetState = "RemoteFunction",
	GetDiscoveries = "RemoteFunction",
	Admin = "RemoteFunction",
}

local Remotes = {}

function Remotes.get(name: string): any
	local className = KINDS[name]
	assert(className, "Unknown remote " .. name)

	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = ReplicatedStorage
		end
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new(className)
			remote.Name = name
			remote.Parent = folder
		end
		return remote
	end

	return ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Seasons</string>
          <string name="Source"><![CDATA[-- Limited events for Seasonal Freeks. A Freek with `season = "Halloween"` can only be bred
-- (or bought, if it has a price) while that event is running. Once owned it's kept forever
-- and still earns, trades and breeds year-round.
--
-- Each event's `window(year)` returns its first and last day (inclusive, UTC) as day
-- numbers (days since 1970-01-01). Windows may run past New Year.

local Seasons = {}

-- Days since 1970-01-01 for a calendar date (proleptic Gregorian).
local function dayNumber(year: number, month: number, day: number): number
	if month <= 2 then
		year -= 1
	end
	local era = year // 400
	local yearOfEra = year - era * 400
	local monthIndex = (month + 9) % 12
	local dayOfYear = (153 * monthIndex + 2) // 5 + day - 1
	local dayOfEra = yearOfEra * 365 + yearOfEra // 4 - yearOfEra // 100 + dayOfYear
	return era * 146097 + dayOfEra - 719468
end

local function weekday(days: number): number
	return (days + 4) % 7 -- 0 = Sunday; 1970-01-01 was a Thursday
end

local function easter(year: number): (number, number)
	local a = year % 19
	local b = year // 100
	local c = year % 100
	local d = b // 4
	local e = b % 4
	local f = (b + 8) // 25
	local g = (b - f + 1) // 3
	local h = (19 * a + b - d - g + 15) % 30
	local i = c // 4
	local k = c % 4
	local l = (32 + 2 * e + 2 * i - h - k) % 7
	local m = (a + 11 * h + 22 * l) // 451
	local month = (h + l - 7 * m + 114) // 31
	local day = (h + l - 7 * m + 114) % 31 + 1
	return month, day
end

local function fixed(fromMonth: number, fromDay: number, toMonth: number, toDay: number)
	return function(year: number)
		local first = dayNumber(year, fromMonth, fromDay)
		local toYear = if toMonth < fromMonth then year + 1 else year
		return first, dayNumber(toYear, toMonth, toDay)
	end
end

Seasons.list = {
	Halloween = {
		name = "Halloween",
		color = Color3.fromRGB(255, 130, 20),
		window = fixed(10, 1, 10, 31),
	},
	Thanksgiving = {
		name = "Thanksgiving",
		color = Color3.fromRGB(200, 120, 50),
		-- Nov 1 through the Sunday after Thanksgiving (4th Thursday of November).
		window = function(year)
			local nov1 = dayNumber(year, 11, 1)
			local firstThursday = nov1 + (4 - weekday(nov1)) % 7
			return nov1, firstThursday + 21 + 3
		end,
	},
	Christmas = {
		name = "Christmas",
		color = Color3.fromRGB(230, 50, 60),
		window = fixed(12, 1, 12, 26),
	},
	NewYears = {
		name = "New Years",
		color = Color3.fromRGB(255, 215, 90),
		window = fixed(12, 27, 1, 7),
	},
	Easter = {
		name = "Easter",
		color = Color3.fromRGB(255, 170, 220),
		-- Two weeks before Easter Sunday through Easter Monday.
		window = function(year)
			local month, day = easter(year)
			local sunday = dayNumber(year, month, day)
			return sunday - 14, sunday + 1
		end,
	},
	America = {
		name = "America",
		color = Color3.fromRGB(70, 120, 255),
		-- The week around July 4th.
		window = fixed(6, 28, 7, 7),
	},
}

function Seasons.isActive(seasonId: string?, now: number?): boolean
	local season = seasonId and Seasons.list[seasonId]
	if not season then
		return false
	end
	local today = (now or os.time()) // 86400
	local year = os.date("!*t", now or os.time()).year
	-- Check last year's window too, for events that run past New Year.
	for _, y in { year - 1, year } do
		local first, last = season.window(y)
		if today >= first and today <= last then
			return true
		end
	end
	return false
end

-- True if this species can be obtained right now (always true for non-seasonal Freeks).
function Seasons.available(species, now: number?): boolean
	return species.season == nil or Seasons.isActive(species.season, now)
end

-- The events running right now, e.g. { "Halloween" }.
function Seasons.active(now: number?): { string }
	local list = {}
	for id in Seasons.list do
		if Seasons.isActive(id, now) then
			table.insert(list, id)
		end
	end
	table.sort(list)
	return list
end

return Seasons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">YardModel</string>
          <string name="Source"><![CDATA[-- Yard items, built from bricks. YardModel.build(itemId) returns a model standing on its
-- pivot (the middle of its footprint, front facing -Z) that fits a yard spot (about 11 x 11
-- studs).

local Bricks = require(script.Parent.Bricks)
local Items = require(script.Parent.Items)

local YardModel = {}

local rgb, block, ball, post, rod, cone, wedge =
	Bricks.rgb, Bricks.block, Bricks.ball, Bricks.post, Bricks.rod, Bricks.cone, Bricks.wedge
local M = Enum.Material
local WOOD = rgb(170, 115, 65)
local DARK = rgb(45, 45, 55)
local WATER = rgb(70, 190, 255)

local builders = {}

function builders.Gnome(m)
	post(m, 0.6, 3, CFrame.new(0, 0, 0), rgb(120, 200, 90)) -- grass tuft base
	cone(m, 2.4, 2.2, CFrame.new(0, 0.6, 0), rgb(60, 120, 230), nil, 4) -- body
	ball(m, 1.6, CFrame.new(0, 3.2, 0), rgb(255, 205, 170)) -- face
	ball(m, Vector3.new(1.5, 1.2, 1), CFrame.new(0, 2.7, -0.45), rgb(255, 255, 255)) -- beard
	ball(m, 0.45, CFrame.new(0, 3.25, -0.8), rgb(255, 150, 140)) -- nose
	cone(m, 2.2, 1.7, CFrame.new(0, 3.6, 0), rgb(230, 50, 60), nil, 5) -- hat
	for _, x in { -0.35, 0.35 } do
		ball(m, 0.25, CFrame.new(x, 3.5, -0.72), rgb(30, 30, 40))
	end
end

function builders.Lemonade(m)
	block(m, Vector3.new(6, 3.2, 3), CFrame.new(0, 1.6, 0), WOOD)
	block(m, Vector3.new(6.3, 0.4, 3.3), CFrame.new(0, 3.3, 0), rgb(255, 230, 90))
	for _, x in { -2.8, 2.8 } do
		block(m, Vector3.new(0.4, 4, 0.4), CFrame.new(x, 5.2, 1.2), WOOD)
	end
	-- Striped canopy.
	for i = 0, 5 do
		block(
			m,
			Vector3.new(1.1, 0.3, 3.4),
			CFrame.new(-2.75 + i * 1.1, 7.3, 0.5) * CFrame.Angles(math.rad(15), 0, 0),
			if i % 2 == 0 then rgb(255, 230, 60) else rgb(255, 255, 255)
		)
	end
	post(m, 1.4, 0.9, CFrame.new(-1.6, 3.5, -0.5), rgb(255, 235, 120), M.Glass)
	for i = 0, 2 do
		post(m, 0.7, 0.45, CFrame.new(0.2 + i * 0.7, 3.5, -0.6), rgb(255, 240, 150), M.Glass)
	end
	block(m, Vector3.new(4, 1.2, 0.2), CFrame.new(0, 1.8, -1.6), rgb(255, 255, 255))
	block(m, Vector3.new(3.4, 0.5, 0.25), CFrame.new(0, 1.8, -1.65), rgb(255, 200, 40))
end

function builders.Grill(m)
	block(m, Vector3.new(5, 2.4, 2.6), CFrame.new(0, 2.6, 0), rgb(200, 40, 50))
	block(m, Vector3.new(5.2, 0.5, 2.8), CFrame.new(0, 4, 0), DARK)
	for i = 0, 4 do
		block(m, Vector3.new(0.15, 0.2, 2.6), CFrame.new(-2 + i, 4.3, 0), rgb(150, 150, 160), M.Metal)
	end
	for i, food in { rgb(140, 70, 40), rgb(230, 120, 80), rgb(140, 70, 40) } do
		rod(m, 1.4, 0.45, CFrame.new(-1.5 + i, 4.6, 0) * CFrame.Angles(0, math.pi / 2, 0), food)
	end
	for _, x in { -2.2, 2.2 } do
		block(m, Vector3.new(0.4, 1.4, 0.4), CFrame.new(x, 0.7, -1), DARK)
		local wheel = rod(m, 0.4, 1, CFrame.new(x, 0.5, 1), DARK)
		wheel.CFrame = CFrame.new(x, 0.5, 1)
	end
	block(m, Vector3.new(1.2, 0.2, 2.6), CFrame.new(3.1, 3.6, 0), WOOD) -- side shelf
	ball(m, 0.8, CFrame.new(-0.5, 5.8, 0), rgb(220, 220, 225))
	ball(m, 1, CFrame.new(0.1, 6.6, 0), rgb(235, 235, 240))
end

function builders.Swing(m)
	local red = rgb(230, 60, 60)
	for _, x in { -4.5, 4.5 } do
		for _, z in { -1.6, 1.6 } do
			block(
				m,
				Vector3.new(0.6, 7.6, 0.6),
				CFrame.new(x, 3.6, z * 0.7) * CFrame.Angles(math.rad(z * 8), 0, 0),
				red
			)
		end
	end
	block(m, Vector3.new(9.8, 0.7, 0.7), CFrame.new(0, 7.3, 0), rgb(60, 140, 255))
	for i, x in { -2, 2 } do
		for _, rx in { -0.9, 0.9 } do
			block(m, Vector3.new(0.12, 4.6, 0.12), CFrame.new(x + rx, 4.9, 0), rgb(80, 80, 90))
		end
		block(
			m,
			Vector3.new(2.2, 0.3, 1),
			CFrame.new(x, 2.5, 0),
			if i == 1 then rgb(255, 210, 50) else rgb(80, 210, 120)
		)
	end
	-- A little slide on the side.
	wedge(m, Vector3.new(1.8, 3.4, 4.6), CFrame.new(6.6, 1.7, -1.5), rgb(255, 210, 50))
end

function builders.Trampoline(m)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		block(m, Vector3.new(0.5, 1.6, 0.5), CFrame.new(math.cos(a) * 4, 0.8, math.sin(a) * 4), DARK)
		block(m, Vector3.new(0.3, 4.5, 0.3), CFrame.new(math.cos(a) * 4.6, 3.6, math.sin(a) * 4.6), rgb(60, 140, 255))
	end
	rod(m, 0.6, 9.6, CFrame.new(0, 1.7, 0) * CFrame.Angles(0, 0, math.pi / 2), rgb(60, 140, 255))
	rod(m, 0.7, 8, CFrame.new(0, 1.75, 0) * CFrame.Angles(0, 0, math.pi / 2), DARK)
	-- A padded ring round the top of the net poles.
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		block(
			m,
			Vector3.new(2.5, 0.35, 0.35),
			CFrame.new(math.cos(a) * 4.6, 5.8, math.sin(a) * 4.6) * CFrame.Angles(0, -a + math.pi / 2, 0),
			rgb(255, 220, 60)
		)
	end
	ball(m, 1.2, CFrame.new(1, 3.8, 0.5), rgb(255, 90, 90)) -- a bouncy ball mid-air
end

function builders.KiddiePool(m)
	rod(m, 1.4, 8, CFrame.new(0, 0.7, 0) * CFrame.Angles(0, 0, math.pi / 2), rgb(80, 150, 255))
	rod(m, 1.42, 6.6, CFrame.new(0, 0.72, 0) * CFrame.Angles(0, 0, math.pi / 2), WATER, M.Glass)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		ball(
			m,
			0.7,
			CFrame.new(math.cos(a) * 3.7, 1.4, math.sin(a) * 3.7),
			if k % 2 == 0 then rgb(255, 255, 255) else rgb(255, 90, 90)
		)
	end
	-- A rubber duck.
	ball(m, Vector3.new(1.4, 1, 1.8), CFrame.new(0.8, 1.6, 0.5), rgb(255, 220, 40))
	ball(m, 0.9, CFrame.new(0.8, 2.3, -0.1), rgb(255, 220, 40))
	block(m, Vector3.new(0.5, 0.2, 0.5), CFrame.new(0.8, 2.25, -0.6), rgb(255, 140, 30))
end

function builders.HotTub(m)
	block(m, Vector3.new(8, 2.6, 8), CFrame.new(0, 1.3, 0), WOOD)
	block(m, Vector3.new(7, 0.3, 7), CFrame.new(0, 2.5, 0), rgb(80, 230, 255), M.Neon)
	for _, x in { -3.9, 3.9 } do
		block(m, Vector3.new(0.4, 0.4, 8.2), CFrame.new(x, 2.7, 0), rgb(130, 85, 45))
	end
	block(m, Vector3.new(3, 0.8, 1.6), CFrame.new(0, 0.4, -4.8), rgb(130, 85, 45)) -- step
	for k = 0, 9 do
		ball(
			m,
			0.4 + (k % 3) * 0.15,
			CFrame.new(math.sin(k * 2.4) * 2.5, 2.9, math.cos(k * 1.7) * 2.5),
			rgb(230, 250, 255)
		)
	end
end

function builders.Fountain(m)
	local stone = rgb(200, 200, 210)
	rod(m, 1.6, 9, CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, math.pi / 2), stone)
	rod(m, 1.62, 7.6, CFrame.new(0, 0.85, 0) * CFrame.Angles(0, 0, math.pi / 2), WATER, M.Glass)
	post(m, 4, 1.4, CFrame.new(0, 1, 0), stone)
	rod(m, 0.8, 4.4, CFrame.new(0, 4.6, 0) * CFrame.Angles(0, 0, math.pi / 2), stone)
	rod(m, 0.82, 3.4, CFrame.new(0, 4.65, 0) * CFrame.Angles(0, 0, math.pi / 2), WATER, M.Glass)
	post(m, 2, 0.8, CFrame.new(0, 5, 0), stone)
	ball(m, 1.4, CFrame.new(0, 7.4, 0), WATER, M.Glass)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		ball(m, 0.5, CFrame.new(math.cos(a) * 1.6, 6.2, math.sin(a) * 1.6), rgb(150, 220, 255), M.Glass)
	end
end

function builders.Treehouse(m)
	block(m, Vector3.new(2, 7, 2), CFrame.new(0, 3.5, 0), rgb(120, 80, 50))
	block(m, Vector3.new(7, 0.6, 7), CFrame.new(0, 7.2, 0), WOOD)
	block(m, Vector3.new(5, 3.6, 4.4), CFrame.new(0, 9.3, 0.4), rgb(230, 170, 90))
	block(m, Vector3.new(1.4, 2.2, 0.3), CFrame.new(0, 8.6, -1.85), rgb(110, 70, 40))
	block(m, Vector3.new(1.2, 1.2, 0.3), CFrame.new(1.6, 9.6, -1.85), rgb(150, 220, 255))
	for _, side in { 1, -1 } do
		wedge(
			m,
			Vector3.new(5.6, 2, 2.6),
			CFrame.new(0, 12.1, 0.4 + side * -1.3) * CFrame.Angles(0, if side == 1 then 0 else math.pi, 0),
			rgb(220, 60, 60)
		)
	end
	-- Leaves round the top and a ladder.
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + 0.4
		block(m, Vector3.new(3.4, 2.6, 3.4), CFrame.new(math.cos(a) * 3.6, 10.5, math.sin(a) * 3.6), rgb(70, 170, 70))
	end
	for i = 0, 5 do
		block(m, Vector3.new(1.6, 0.25, 0.25), CFrame.new(2.2, 1 + i * 1.1, -2.3), WOOD)
	end
	for _, x in { 1.5, 2.9 } do
		block(m, Vector3.new(0.25, 7, 0.25), CFrame.new(x, 3.5, -2.3), WOOD)
	end
end

function builders.SportsCar(m)
	local red = rgb(230, 30, 40)
	block(m, Vector3.new(4.6, 1.4, 9), CFrame.new(0, 1.3, 0), red)
	block(m, Vector3.new(4, 1.2, 4.2), CFrame.new(0, 2.6, 0.6), red)
	block(
		m,
		Vector3.new(3.8, 1.1, 0.2),
		CFrame.new(0, 2.6, -1.55) * CFrame.Angles(math.rad(-30), 0, 0),
		rgb(160, 220, 255),
		M.Glass
	)
	block(m, Vector3.new(4.8, 0.3, 1), CFrame.new(0, 3, 4.3), DARK) -- spoiler
	for _, x in { -1.6, 1.6 } do
		block(m, Vector3.new(0.3, 0.8, 0.3), CFrame.new(x, 2.4, 4.3), DARK)
	end
	for _, x in { -2.3, 2.3 } do
		for _, z in { -3, 3 } do
			local wheel = rod(m, 0.8, 1.8, CFrame.new(x, 0.9, z), DARK)
			wheel.CFrame = CFrame.new(x, 0.9, z)
			rod(m, 0.85, 0.9, CFrame.new(x, 0.9, z), rgb(200, 200, 210), M.Metal)
		end
	end
	for _, x in { -1.6, 1.6 } do
		block(m, Vector3.new(0.9, 0.4, 0.2), CFrame.new(x, 1.5, -4.5), rgb(255, 250, 200), M.Neon)
	end
	block(m, Vector3.new(4.7, 0.3, 0.3), CFrame.new(0, 1.9, -4.5), rgb(255, 255, 255))
end

function builders.Pool(m)
	local tile = rgb(240, 240, 245)
	block(m, Vector3.new(11, 0.6, 11), CFrame.new(0, 0.3, 0), tile)
	block(m, Vector3.new(9, 0.62, 9), CFrame.new(0, 0.32, 0), WATER, M.Glass)
	block(m, Vector3.new(8.6, 0.1, 8.6), CFrame.new(0, 0.05, 0), rgb(40, 130, 230))
	-- Diving board and ladder.
	block(m, Vector3.new(1.4, 0.3, 4), CFrame.new(-3, 1.6, -5.6), rgb(60, 140, 255))
	block(m, Vector3.new(1.4, 1.3, 0.8), CFrame.new(-3, 0.75, -7.2), tile)
	for _, x in { 3, 4 } do
		rod(m, 0.2, 2.4, CFrame.new(x, 1.4, -4.3) * CFrame.Angles(0, 0, math.pi / 2), rgb(200, 200, 210), M.Metal)
	end
	-- A floaty ring.
	rod(m, 0.6, 2.2, CFrame.new(1.5, 0.75, 1.5) * CFrame.Angles(0, 0, math.pi / 2), rgb(255, 90, 140))
	rod(m, 0.62, 1.2, CFrame.new(1.5, 0.76, 1.5) * CFrame.Angles(0, 0, math.pi / 2), WATER, M.Glass)
end

function builders.Rocket(m)
	local white = rgb(245, 245, 250)
	post(m, 9, 3.4, CFrame.new(0, 1.5, 0), white)
	cone(m, 3.6, 3.4, CFrame.new(0, 10.5, 0), rgb(230, 40, 60), nil, 6)
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2
		wedge(
			m,
			Vector3.new(0.4, 3, 2.4),
			CFrame.new(math.cos(a) * 2.2, 2.7, math.sin(a) * 2.2) * CFrame.Angles(0, -a + math.pi / 2, 0),
			rgb(230, 40, 60)
		)
	end
	rod(m, 0.3, 1.6, CFrame.new(0, 7.5, -1.62) * CFrame.Angles(0, math.pi / 2, 0), rgb(120, 200, 255), M.Glass)
	rod(m, 0.25, 2, CFrame.new(0, 7.5, -1.58) * CFrame.Angles(0, math.pi / 2, 0), rgb(255, 200, 60), M.Foil)
	post(m, 1.2, 2.2, CFrame.new(0, 0.3, 0), DARK)
	-- Flames.
	cone(m, 1.6, 2, CFrame.new(0, -1.3, 0) * CFrame.Angles(math.pi, 0, 0), rgb(255, 150, 30), M.Neon, 3)
	-- Launch pad.
	block(m, Vector3.new(7, 0.4, 7), CFrame.new(0, 0.2, 0), rgb(120, 120, 135))
	for i, color in Bricks.RAINBOW do
		block(m, Vector3.new(0.4, 0.42, 1), CFrame.new(-3 + i * 0.86, 0.22, -3.4), color, M.Neon)
	end
end

function YardModel.build(itemId: string): Model
	local item = Items.byId[itemId]
	local model = Instance.new("Model")
	model.Name = itemId
	model:SetAttribute("Item", itemId)
	local builder = item and builders[item.model]
	if builder then
		builder(model)
	end
	-- Stand it on its base. Roblox puts a new model's pivot in the middle of its parts, which
	-- would sink it halfway into whatever it's put on.
	model.WorldPivot = CFrame.identity
	return model
end

return YardModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">ZoneLayout</string>
          <string name="Source"><![CDATA[-- Where the zones are. They run in a line west from the end of the town street: zone 1
-- starts at START_X and is LENGTH studs long; each zone after it is GROWTH studs longer
-- than the last, so the deeper zones are longer runs. All are WIDTH wide (centred on z = 0).
-- Each zone has a pile of egg pedestals in a ring near its far end, round the guardian's
-- home. Shared so the server builds them and the client knows which zone you're in.

local Items = require(script.Parent.Items)

local ZoneLayout = {}

ZoneLayout.START_X = -230 -- the east edge of zone 1 (the town street ends just before it)
ZoneLayout.LENGTH = 130 -- zone 1's length
ZoneLayout.GROWTH = 25 -- how much longer each zone is than the one before
ZoneLayout.WIDTH = 140
ZoneLayout.RING = 20 -- how far round the guardian's home its patrol keeps closest
ZoneLayout.HOME_BACK = 32 -- how far before a zone's back wall the guardian's home is

-- How long zone `index` is.
function ZoneLayout.length(index: number): number
	return ZoneLayout.LENGTH + (index - 1) * ZoneLayout.GROWTH
end

-- How far into zone `index` (from its entrance) the guardian's home and the pile are.
function ZoneLayout.homeU(index: number): number
	return ZoneLayout.length(index) - ZoneLayout.HOME_BACK
end

-- A zone's east (entrance) and west (back) x.
function ZoneLayout.edges(index: number): (number, number)
	local east = ZoneLayout.START_X
	for i = 1, index - 1 do
		east -= ZoneLayout.length(i)
	end
	return east, east - ZoneLayout.length(index)
end

-- The west end of the last zone (the end of the map).
function ZoneLayout.westEnd(): number
	local _, west = ZoneLayout.edges(#Items.ZONES)
	return west
end

-- A point in a zone from (u = studs in from the entrance, v = z).
function ZoneLayout.point(index: number, u: number, v: number): Vector3
	local east = ZoneLayout.edges(index)
	return Vector3.new(east - u, 0, v)
end

function ZoneLayout.center(index: number): Vector3
	return ZoneLayout.point(index, ZoneLayout.length(index) / 2, 0)
end

function ZoneLayout.guardianHome(index: number): Vector3
	return ZoneLayout.point(index, ZoneLayout.homeU(index), 0)
end

-- How many eggs lie about zone `index` at once (more in the bigger zones).
function ZoneLayout.eggCount(index: number): number
	return 8 + index
end

-- Which zone a position is in (nil in town).
function ZoneLayout.zoneAt(position: Vector3): number?
	if math.abs(position.Z) > ZoneLayout.WIDTH / 2 + 2 then
		return nil
	end
	for index = 1, #Items.ZONES do
		local east, west = ZoneLayout.edges(index)
		if position.X <= east and position.X > west then
			return index
		end
	end
	return nil
end

-- True if a position is inside zone `index` (plus `margin` studs all round).
function ZoneLayout.inside(index: number, position: Vector3, margin: number?): boolean
	local east, west = ZoneLayout.edges(index)
	local m = margin or 0
	return position.X <= east + m and position.X >= west - m and math.abs(position.Z) <= ZoneLayout.WIDTH / 2 + m
end

return ZoneLayout
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="30">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="31">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">ActionService</string>
          <string name="Source"><![CDATA[-- Everything a player can ask the server to do. Every argument from the client is
-- untrusted, so each handler re-checks ownership, money and limits itself.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Items = require(ReplicatedStorage.Shared.Items)
local LifeUtil = require(ReplicatedStorage.Shared.LifeUtil)
local Parts = require(ReplicatedStorage.Shared.Parts)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)
local NestService = require(script.Parent.NestService)
local PlotService = require(script.Parent.PlotService)
local StealService = require(script.Parent.StealService)

local ActionService = {}

local notifyRemote = Remotes.get("Notify")
local stateRemote = Remotes.get("State")
local lastAction = {} -- [Player] = os.clock()

local function notify(player: Player, message: string, kind: string?)
	notifyRemote:FireClient(player, message, kind)
end

-- What the client is allowed to see of its own save.
local function snapshot(data)
	return {
		money = data.money,
		speed = data.speed,
		treadmill = data.treadmill,
		parts = data.parts,
		house = data.house,
		pen = data.pen,
		yard = data.yard,
		garden = data.garden,
		nests = data.nests,
		discovered = data.discovered,
		crates = data.crates,
		lastSpin = data.lastSpin,
	}
end
ActionService.snapshot = snapshot

local function ownedItem(data, uid: any)
	if typeof(uid) ~= "string" then
		return nil
	end
	return data.parts[uid]
end

local handlers = {}

-- Puts an item from the backpack out: a house part onto its slot, a pet into the yard, a
-- yard item or plant onto `spot` ("1".."6"; the first free one if not given). Whatever was
-- there goes to the backpack.
function handlers.Place(player: Player, data, uid: any, spot: any)
	local record = ownedItem(data, uid)
	local item = record and Items.byId[record.id]
	if not item or LifeUtil.placed(data)[uid] then
		return
	end
	if item.kind == "House" then
		data.house[item.slot] = uid
	elseif item.kind == "Pet" then
		local pets = LifeUtil.pets(data)
		if #pets >= Items.PET_SLOTS then
			-- Swap out the worst pet.
			table.sort(pets, function(a, b)
				return LifeUtil.itemIncome(data.parts[a]) < LifeUtil.itemIncome(data.parts[b])
			end)
			data.pen[pets[1]] = nil
		end
		data.pen[uid] = true
	else
		local where = if item.kind == "Yard" then data.yard else data.garden
		local count = if item.kind == "Yard" then Items.YARD_SPOTS else Items.GARDEN_BEDS
		local key = typeof(spot) == "string" and tonumber(spot) and spot or nil
		if key and (tonumber(key) < 1 or tonumber(key) > count or key ~= tostring(tonumber(key))) then
			key = nil
		end
		if not key then
			for n = 1, count do
				if not where[tostring(n)] then
					key = tostring(n)
					break
				end
			end
		end
		if not key then
			return notify(player, "All your spots are full! Pick one to swap.", "error")
		end
		where[key] = uid
	end
	notify(player, "✨ " .. LifeUtil.displayName(record) .. " is out!", "success")
end

-- Takes an item that's out back into the backpack.
function handlers.TakeOff(player: Player, data, uid: any)
	local record = ownedItem(data, uid)
	if not record or not LifeUtil.placed(data)[uid] then
		return
	end
	if LifeUtil.backpackCount(data) >= GamePasses.backpackSize(player) then
		return notify(player, "Your backpack is full!", "error")
	end
	LifeUtil.takeOff(data, uid)
end

-- Takes a part off the house by slot (the slot goes back to Basic).
function handlers.Uninstall(player: Player, data, slotId: any)
	if typeof(slotId) ~= "string" or not Parts.slotById[slotId] then
		return
	end
	local _, uid = LifeUtil.installedRecord(data, slotId)
	if uid then
		handlers.TakeOff(player, data, uid)
	end
end

local function sell(data, uid: string): number
	local record = data.parts[uid]
	if not record or LifeUtil.placed(data)[uid] then
		return 0
	end
	local price = LifeUtil.sellPrice(record)
	data.parts[uid] = nil
	data.money += price
	return price
end

-- Sells one item from the backpack.
function handlers.Sell(player: Player, data, uid: any)
	if typeof(uid) ~= "string" then
		return
	end
	local name = data.parts[uid] and LifeUtil.displayName(data.parts[uid])
	local price = sell(data, uid)
	if price > 0 then
		notify(player, "Sold " .. name .. " for " .. Format.money(price) .. "!", "money")
	end
end

-- Sells everything in the backpack.
function handlers.SellBackpack(player: Player, data)
	local total, count = 0, 0
	for _, uid in LifeUtil.backpack(data) do
		local price = sell(data, uid)
		if price > 0 then
			total += price
			count += 1
		end
	end
	if count > 0 then
		notify(player, "Sold " .. count .. " items for " .. Format.money(total) .. "!", "money")
	end
end

-- Puts out the best of everything (best items first, so each spot ends up with the best).
function handlers.PlaceBest(player: Player, data)
	local changed = 0
	for _, uid in LifeUtil.backpack(data) do
		if LifeUtil.placeIfBetter(data, uid) ~= "backpack" then
			changed += 1
		end
	end
	if changed > 0 then
		notify(
			player,
			"✨ Put out " .. changed .. " better item" .. (if changed == 1 then "" else "s") .. "!",
			"success"
		)
	else
		notify(player, "Your best items are already out!", "info")
	end
end
handlers.InstallBest = handlers.PlaceBest

-- Hatches the egg in a nest (from the UI; the nest's prompt does the same).
function handlers.Hatch(player: Player, _data, n: any)
	if typeof(n) ~= "number" or n ~= n // 1 or n < 1 or n > PlotService.NEST_MAX then
		return
	end
	local problem = NestService.hatch(player, n)
	if problem then
		notify(player, problem, "error")
	end
end

-- Upgrades the treadmill one level.
function handlers.UpgradeTreadmill(player: Player, data)
	if data.treadmill >= Config.TREADMILL_MAX then
		return notify(player, "Your treadmill is maxed out!", "error")
	end
	local cost = Config.treadmillCost(data.treadmill)
	if data.money < cost then
		return notify(player, "You need " .. Format.money(cost) .. " to upgrade your treadmill.", "error")
	end
	data.money -= cost
	data.treadmill += 1
	notify(player, "⚡ Treadmill upgraded to level " .. data.treadmill .. "!", "success")
end

-- Teleports the player home (not while carrying an egg: that would skip the run).
local lastHome = {}
function handlers.GoHome(player: Player, _data)
	if StealService.isCarrying(player) then
		return notify(player, "No teleporting with an egg! Run it home!", "error")
	end
	if lastHome[player] and os.clock() - lastHome[player] < 3 then
		return
	end
	lastHome[player] = os.clock()
	PlotService.sendHome(player)
end

local quiet = { GoHome = true, Hatch = true } -- actions that don't change saved data, so skip the refresh

-- Lets other services add actions (they get the same rate limit and refresh).
-- Pass isQuiet = true for actions that never change the player's data.
function ActionService.register(name: string, handler, isQuiet: boolean?)
	handlers[name] = handler
	quiet[name] = isQuiet == true
end

function ActionService.init()
	Remotes.get("GetState").OnServerInvoke = function(player)
		local data = DataService.waitFor(player)
		return data and snapshot(data)
	end

	DataService.onChanged(function(player, data)
		stateRemote:FireClient(player, snapshot(data))
	end)

	Remotes.get("Action").OnServerEvent:Connect(function(player, action, ...)
		local handler = typeof(action) == "string" and handlers[action]
		local data = DataService.get(player)
		if not handler or not data then
			return
		end
		local now = os.clock()
		if lastAction[player] and now - lastAction[player] < 0.15 then
			return
		end
		lastAction[player] = now

		local ok, err = pcall(handler, player, data, ...)
		if not ok then
			warn("Action", action, "failed for", player.Name, err)
		end
		if not quiet[action] then
			DataService.changed(player)
		end
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
		lastHome[player] = nil
	end)
end

return ActionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">AdminService</string>
          <string name="Source"><![CDATA[-- The admin panel's server side. Only admins (Config.ADMIN_NAMES / ADMIN_USER_IDS, or
-- anyone in Studio) get the IsAdmin attribute, and every command checks again here, so a
-- hacked client can't use it.
--
-- Commands (Admin remote, returns ok, message):
--   "event"    { id, minutes, everywhere }  start an event now (big, weather or Lucky Hour)
--   "stop"     { everywhere }               end whatever is running
--   "spawn"    { zone, part?, mutation? }    fill a zone's pile now (or put one part there)
--   "announce" { text, everywhere }          a message on everyone's screen
--   "money"    { amount }                    give yourself coins (for testing)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Events = require(ReplicatedStorage.Shared.Events)
local Luck = require(ReplicatedStorage.Shared.Luck)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Items = require(ReplicatedStorage.Shared.Items)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)
local EventService = require(script.Parent.EventService)
local ZoneService = require(script.Parent.ZoneService)

local AdminService = {}

function AdminService.isAdmin(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	return table.find(Config.ADMIN_NAMES, player.Name) ~= nil or table.find(Config.ADMIN_USER_IDS, player.UserId) ~= nil
end

-- Filters announcement text the way Roblox requires for text everyone sees.
local function filter(player: Player, text: string): string?
	local ok, result = pcall(function()
		return TextService:FilterStringAsync(text, player.UserId):GetNonChatStringForBroadcastAsync()
	end)
	if ok then
		return result
	end
	return if RunService:IsStudio() then text else nil
end

local commands = {}

function commands.event(_player: Player, args)
	local id = args.id
	if not (Events.BIG[id] or Events.WEATHER[id] or Luck.EVENTS[id]) then
		return false, "Unknown event"
	end
	local minutes = math.clamp(tonumber(args.minutes) or 15, 1, 180)
	local ends = Workspace:GetServerTimeNow() + minutes * 60
	EventService.send({ type = "event", id = id, ends = ends }, args.everywhere == true)
	return true, "Started for " .. minutes .. " min" .. (if args.everywhere then " in every server" else " here")
end

function commands.stop(_player: Player, args)
	-- Keep it ended until whatever's running now would have finished.
	local ends = math.max(
		ReplicatedStorage:GetAttribute("EventEnds") or 0,
		ReplicatedStorage:GetAttribute("WeatherEnds") or 0,
		Workspace:GetServerTimeNow() + 5
	)
	EventService.send({ type = "end", ends = ends }, args.everywhere == true)
	return true, "Events ended" .. (if args.everywhere then " in every server" else " here")
end

function commands.spawn(_player: Player, args)
	local zone = tonumber(args.zone)
	if not zone or not Items.ZONES[zone] then
		return false, "Unknown zone"
	end
	local rarity = args.rarity
	if rarity ~= nil and not Rarities.info[rarity] then
		return false, "Unknown rarity"
	end
	local mutation = args.mutation
	local mutations = if mutation and Mutations.byId[mutation] then { mutation } else nil
	ZoneService.spawnNow(zone, rarity, mutations)
	return true, "Spawned in " .. Items.ZONES[zone].name .. "!"
end

function commands.announce(player: Player, args)
	local text = type(args.text) == "string" and string.sub(args.text, 1, 120) or ""
	if text == "" then
		return false, "Type a message first"
	end
	local filtered = filter(player, text)
	if not filtered then
		return false, "Couldn't check that message, try again"
	end
	EventService.send({ type = "announce", text = filtered }, args.everywhere == true)
	return true, "Sent"
end

function commands.money(player: Player, args)
	local data = DataService.get(player)
	if not data then
		return false, "Your data isn't loaded yet"
	end
	local amount = math.clamp(tonumber(args.amount) or 0, 0, 1e12)
	data.money += amount
	DataService.changed(player)
	return true, "Added coins"
end

function AdminService.init()
	local remote = Remotes.get("Admin")
	remote.OnServerInvoke = function(player: Player, command: any, args: any)
		if not AdminService.isAdmin(player) then
			return false, "Not allowed"
		end
		local handler = type(command) == "string" and commands[command]
		if not handler then
			return false, "Unknown command"
		end
		local ok, result, message = pcall(handler, player, type(args) == "table" and args or {})
		if not ok then
			warn("[AdminService] " .. tostring(result))
			return false, "Something went wrong"
		end
		return result, message
	end
	local function mark(player: Player)
		player:SetAttribute("IsAdmin", AdminService.isAdmin(player) or nil)
	end
	Players.PlayerAdded:Connect(mark)
	for _, player in Players:GetPlayers() do
		mark(player)
	end
end

return AdminService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Loads and saves each player's data with a session lock, so the same player in two
-- servers at once (e.g. a fast rejoin) can't duplicate or lose house parts.
--
-- In Studio without "Enable Studio Access to API Services", saving is skipped and a
-- fresh save is used so the game is still testable.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Items = require(ReplicatedStorage.Shared.Items)
local Parts = require(ReplicatedStorage.Shared.Parts)

local STORE_NAME = "StealALife_Players_v1"

local DataService = {}

local profiles = {} -- [Player] = data
local noSave = {} -- [Player] = true when running without DataStores
local loadedCallbacks = {}
local changedCallbacks = {}

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local function defaultData()
	return {
		version = 1,
		money = Config.START_MONEY,
		speed = 0, -- trained on the treadmill; decides how fast you run
		treadmill = 1, -- treadmill level
		parts = {}, -- [uid] = { id = itemId, mutations? }: everything owned (see LifeUtil)
		house = {}, -- [slotId] = uid of the part installed there (none = Basic)
		pen = {}, -- [uid] = true for pets out in the yard
		yard = {}, -- ["1".."6"] = uid of the yard item on that spot
		garden = {}, -- ["1".."6"] = uid of the plant in that bed
		nests = {}, -- ["1".."5"] = { zone, rarity, endsAt, mutations? }: eggs growing
		nextUid = 1,
		discovered = {}, -- [itemId] = true for every item this player has owned
		crates = {}, -- [crateId] = how many unopened Mystery Boxes (won on the wheel)
		receipts = {}, -- recent Robux purchase IDs, so a purchase is never granted twice
		lastSpin = 0, -- os.time() of the last Lucky Wheel spin
		lastSeen = os.time(),
		firstJoin = os.time(), -- when they first played (starts the Starter Pack countdown)
		starterBought = false,
	}
end

local function reconcile(data)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		end
	end
	data.rebirths = nil -- rebirths were taken out of the game
	if Config.TEST_MONEY and data.money < Config.TEST_MONEY then
		data.money = Config.TEST_MONEY
	end
	-- Items that no longer exist are dropped, and places pointing at missing items emptied.
	for uid, record in data.parts do
		if not Items.byId[record.id] or Parts.isBasic(record.id) then
			data.parts[uid] = nil
		else
			record.mutations = Mutations.pack(record.mutations)
			record.size = nil -- the old size tiers, replaced by weights
			local function valid(n)
				return type(n) == "number" and n > 0 and n < math.huge
			end
			if not valid(record.weight) or not valid(record.baseWeight) then
				record.weight, record.baseWeight = nil, nil
			end
		end
	end
	for slotId, uid in data.house do
		local record = data.parts[uid]
		if not Parts.slotById[slotId] or not record or Items.byId[record.id].slot ~= slotId then
			data.house[slotId] = nil
		end
	end
	for uid in data.pen do
		local record = data.parts[uid]
		if not record or Items.byId[record.id].kind ~= "Pet" then
			data.pen[uid] = nil
		end
	end
	for kind, where in { Yard = data.yard, Plant = data.garden } do
		for spot, uid in where do
			local record = data.parts[uid]
			if not record or Items.byId[record.id].kind ~= kind then
				where[spot] = nil
			end
		end
	end
	return data
end

-- A fresh uid for a new item.
function DataService.newUid(data): string
	local uid = "p" .. data.nextUid
	data.nextUid += 1
	return uid
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

-- Returns data, or nil + reason. reason is "locked" when another server holds the save.
local function tryLoad(player: Player)
	local locked = false
	local ok, result = pcall(function()
		return store:UpdateAsync(keyFor(player), function(old)
			locked = false
			old = old or defaultData()
			local lock = old.lock
			if lock and lock.job ~= game.JobId and os.time() - lock.time < Config.SESSION_LOCK_TIMEOUT then
				locked = true
				return nil
			end
			old.lock = { job = game.JobId, time = os.time() }
			return old
		end)
	end)
	if not ok then
		return nil, result
	end
	if locked then
		return nil, "locked"
	end
	return result, nil
end

local function load(player: Player)
	if not store then
		return nil, "DataStores unavailable"
	end
	local reason
	for attempt = 1, 6 do
		local data
		data, reason = tryLoad(player)
		if data then
			return reconcile(data)
		end
		if not player.Parent then
			return nil, "left"
		end
		if RunService:IsStudio() and reason ~= "locked" then
			return nil, reason -- don't make testers wait through retries
		end
		task.wait(if reason == "locked" then 10 else 2 * attempt)
	end
	return nil, reason
end

-- Saves the player's data. Returns true once it's safely stored (or if this is a
-- temporary Studio save that's never stored).
function DataService.save(player: Player, release: boolean?): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	if noSave[player] then
		return true
	end
	data.lastSeen = os.time()
	data.lock = if release then nil else { job = game.JobId, time = os.time() }
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function(old)
				if old and old.lock and old.lock.job ~= game.JobId then
					return nil -- another server took over; never overwrite its save
				end
				return data
			end)
		end)
		if ok then
			return true
		end
		warn("Save failed for", player.Name, err)
		task.wait(attempt)
	end
	return false
end

function DataService.get(player: Player)
	return profiles[player]
end

-- Yields until the player's data is loaded; returns nil if they leave first.
function DataService.waitFor(player: Player)
	while player.Parent and not profiles[player] do
		task.wait(0.1)
	end
	return profiles[player]
end

function DataService.all()
	return profiles
end

function DataService.onLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

function DataService.onChanged(callback)
	table.insert(changedCallbacks, callback)
end

-- Call after changing a player's data so their house and UI refresh.
function DataService.changed(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	for _, callback in changedCallbacks do
		task.spawn(callback, player, data)
	end
end

local function onPlayerAdded(player: Player)
	local data, reason = load(player)
	if not player.Parent then
		return
	end
	if not data then
		if RunService:IsStudio() then
			warn("Using a temporary save (not saved). Reason:", reason)
			data = reconcile(defaultData())
			noSave[player] = true
		elseif reason == "locked" then
			player:Kick("Your house is still saving from your last server. Please rejoin in a minute!")
			return
		else
			player:Kick("Couldn't load your house right now. Please rejoin!")
			return
		end
	end
	profiles[player] = data
	for _, callback in loadedCallbacks do
		task.spawn(callback, player, data)
	end
	DataService.changed(player)
end

local function onPlayerRemoving(player: Player)
	if profiles[player] then
		DataService.save(player, true)
	end
	profiles[player] = nil
	noSave[player] = nil
end

function DataService.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">Decor</string>
          <string name="Source"><![CDATA[-- Reusable scenery pieces built from parts: trees, bushes, flowers, lamp posts, picket
-- fences and signboards. Every builder takes a parent and a CFrame on the ground.

local CollectionService = game:GetService("CollectionService")

local Decor = {}

-- Tags let SeasonalService recolour scenery for events (e.g. orange leaves at Halloween).
Decor.TAGS = { leaves = "TreeLeaves", bulb = "LampBulb", lawn = "Lawn" }

-- Remembers a part's normal colour so a seasonal theme can be undone.
function Decor.tag(instance: BasePart, tag: string)
	instance:SetAttribute("BaseColor", instance.Color)
	CollectionService:AddTag(instance, tag)
end

local function part(props, className: string?): BasePart
	local p = Instance.new(className or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		p[key] = value
	end
	return p
end
Decor.part = part

local LEAF_COLORS = {
	Color3.fromRGB(70, 160, 70),
	Color3.fromRGB(90, 180, 80),
	Color3.fromRGB(60, 140, 75),
}

-- A checkerboard floor of studded tiles in two shades (the classic Roblox baseplate look):
-- `center` is the middle of its top face, tiles are `tile` studs square.
function Decor.checkerFloor(
	parent: Instance,
	center: CFrame,
	sizeX: number,
	sizeZ: number,
	tile: number,
	colorA: Color3,
	colorB: Color3,
	name: string?
)
	local folder = Instance.new("Folder")
	folder.Name = name or "Floor"
	folder.Parent = parent
	local countX, countZ = math.max(1, math.round(sizeX / tile)), math.max(1, math.round(sizeZ / tile))
	local w, d = sizeX / countX, sizeZ / countZ
	for i = 0, countX - 1 do
		for k = 0, countZ - 1 do
			part({
				Name = "Tile",
				Size = Vector3.new(w, 1, d),
				CFrame = center * CFrame.new(-sizeX / 2 + (i + 0.5) * w, -0.5, -sizeZ / 2 + (k + 0.5) * d),
				Color = if (i + k) % 2 == 0 then colorA else colorB,
				Parent = folder,
			})
		end
	end
	return folder
end

-- A LEGO-style tree: a square brick trunk and stacked layers of leaf bricks, each smaller
-- than the one below, with studs on every layer. scale 1 is about 14 studs tall.
function Decor.tree(parent: Instance, ground: CFrame, scale: number?, seed: number?)
	local s = scale or 1
	local rng = Random.new(seed or 1)
	local turn = ground * CFrame.Angles(0, rng:NextNumber() * math.pi / 2, 0)
	part({
		Name = "Trunk",
		Size = Vector3.new(2 * s, 7 * s, 2 * s),
		CFrame = turn * CFrame.new(0, 3.5 * s, 0),
		Color = Color3.fromRGB(120, 85, 55),
		Material = Enum.Material.Wood,
		Parent = parent,
	})
	local color = LEAF_COLORS[rng:NextInteger(1, #LEAF_COLORS)]
	local layers = { { 9, 2.2 }, { 7, 2 }, { 5, 1.8 }, { 3, 1.6 } }
	local y = 6 * s
	for i, layer in layers do
		local width, height = layer[1] * s, layer[2] * s
		Decor.tag(
			part({
				Name = "Leaves",
				Size = Vector3.new(width, height, width),
				CFrame = turn
					* CFrame.new(0, y + height / 2, 0)
					* CFrame.Angles(0, if i % 2 == 0 then math.rad(45) else 0, 0),
				Color = color:Lerp(Color3.fromRGB(150, 220, 110), (i - 1) * 0.08),
				Material = Enum.Material.Grass,
				CanCollide = false,
				Parent = parent,
			}),
			Decor.TAGS.leaves
		)
		y += height
	end
end

function Decor.bush(parent: Instance, ground: CFrame, scale: number?, seed: number?)
	local s = scale or 1
	local rng = Random.new(seed or 2)
	for _ = 1, 3 do
		local size = (2.2 + rng:NextNumber() * 1.2) * s
		part({
			Name = "Bush",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size,
			CFrame = ground
				* CFrame.new((rng:NextNumber() - 0.5) * 2.5 * s, size * 0.35, (rng:NextNumber() - 0.5) * 1.5 * s),
			Color = LEAF_COLORS[rng:NextInteger(1, #LEAF_COLORS)],
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local FLOWER_COLORS = {
	Color3.fromRGB(255, 110, 150),
	Color3.fromRGB(255, 220, 80),
	Color3.fromRGB(170, 120, 255),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(255, 150, 60),
}

-- A rectangular flower bed (width along X, depth along Z).
function Decor.flowerBed(parent: Instance, ground: CFrame, width: number, depth: number, seed: number?)
	local rng = Random.new(seed or 3)
	part({
		Name = "FlowerBed",
		Size = Vector3.new(width, 0.4, depth),
		CFrame = ground * CFrame.new(0, 0.2, 0),
		Color = Color3.fromRGB(110, 75, 50),
		Material = Enum.Material.Ground,
		CanCollide = false,
		Parent = parent,
	})
	local count = math.floor(width * depth / 2.5)
	for _ = 1, count do
		local x = (rng:NextNumber() - 0.5) * (width - 0.8)
		local z = (rng:NextNumber() - 0.5) * (depth - 0.8)
		part({
			Name = "Stem",
			Size = Vector3.new(0.15, 0.8, 0.15),
			CFrame = ground * CFrame.new(x, 0.8, z),
			Color = Color3.fromRGB(70, 150, 60),
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
		part({
			Name = "Flower",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.55,
			CFrame = ground * CFrame.new(x, 1.25, z),
			Color = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)],
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
	end
end

-- A lamp post with a warm light that glows at night and adds sparkle by day.
function Decor.lamp(parent: Instance, ground: CFrame, color: Color3?)
	part({
		Name = "LampPost",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(8, 0.5, 0.5),
		CFrame = ground * CFrame.new(0, 4, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(45, 45, 55),
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Name = "LampBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 1.4, 1.4),
		CFrame = ground * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(45, 45, 55),
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	local bulb = part({
		Name = "Bulb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.3,
		CFrame = ground * CFrame.new(0, 8.4, 0),
		Color = color or Color3.fromRGB(255, 225, 160),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	local light = Instance.new("PointLight")
	light.Color = color or Color3.fromRGB(255, 210, 150)
	light.Range = 18
	light.Brightness = 1.2
	light.Shadows = false
	light.Parent = bulb
	Decor.tag(bulb, Decor.TAGS.bulb)
end

-- A glowing jack-o'-lantern. scale 1 is about 3 studs wide; its face looks along -Z.
function Decor.pumpkin(parent: Instance, ground: CFrame, scale: number?)
	local s = scale or 1
	local orange = Color3.fromRGB(235, 125, 30)
	local center = ground * CFrame.new(0, 1.2 * s, 0)
	-- Three overlapping balls make the ribbed shape.
	local body
	for _, dx in { -0.55, 0, 0.55 } do
		local ball = part({
			Name = "Pumpkin",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (if dx == 0 then 2.5 else 2.2) * s,
			CFrame = center * CFrame.new(dx * s, 0, 0),
			Color = if dx == 0 then orange else orange:Lerp(Color3.new(0, 0, 0), 0.08),
			Parent = parent,
		})
		if dx == 0 then
			body = ball
		end
	end
	part({
		Name = "Stem",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7 * s, 0.35 * s, 0.35 * s),
		CFrame = center * CFrame.new(0, 1.3 * s, 0) * CFrame.Angles(0, 0, math.pi / 2 + 0.2),
		Color = Color3.fromRGB(90, 110, 40),
		CanCollide = false,
		Parent = parent,
	})
	-- Glowing face: two triangle eyes and a grin.
	local glow = Color3.fromRGB(255, 200, 70)
	for _, dx in { -0.45, 0.45 } do
		part({
			Name = "Eye",
			Size = Vector3.new(0.12, 0.45 * s, 0.5 * s),
			CFrame = center * CFrame.new(dx * s, 0.3 * s, -1.18 * s) * CFrame.Angles(0, math.pi / 2, 0),
			Color = glow,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = parent,
		}, "WedgePart")
	end
	part({
		Name = "Grin",
		Size = Vector3.new(1.1 * s, 0.25 * s, 0.12),
		CFrame = center * CFrame.new(0, -0.35 * s, -1.2 * s),
		Color = glow,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 50)
	light.Range = 10 * s
	light.Brightness = 1.5
	light.Shadows = false
	light.Parent = body
end

-- A hay bale with twine bands, lying along X.
function Decor.hayBale(parent: Instance, ground: CFrame)
	part({
		Name = "HayBale",
		Size = Vector3.new(4, 2.4, 2.6),
		CFrame = ground * CFrame.new(0, 1.2, 0),
		Color = Color3.fromRGB(225, 190, 95),
		Material = Enum.Material.Sand,
		Parent = parent,
	})
	for _, dx in { -1, 1 } do
		part({
			Name = "Twine",
			Size = Vector3.new(0.25, 2.5, 2.7),
			CFrame = ground * CFrame.new(dx, 1.2, 0),
			Color = Color3.fromRGB(140, 100, 55),
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local FALL_LEAVES = {
	Color3.fromRGB(230, 120, 40),
	Color3.fromRGB(200, 70, 40),
	Color3.fromRGB(235, 180, 50),
	Color3.fromRGB(170, 100, 50),
}
Decor.FALL_LEAVES = FALL_LEAVES

-- A low pile of fallen leaves: overlapping flat discs in autumn colours.
function Decor.leafPile(parent: Instance, ground: CFrame, seed: number?)
	local rng = Random.new(seed or 9)
	for i = 1, 6 do
		local size = 1.6 + rng:NextNumber() * 1.6
		part({
			Name = "LeafPile",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.35, size, size),
			CFrame = ground
				* CFrame.new((rng:NextNumber() - 0.5) * 3, 0.1 + i * 0.07, (rng:NextNumber() - 0.5) * 3)
				* CFrame.Angles(0, 0, math.pi / 2),
			Color = FALL_LEAVES[rng:NextInteger(1, #FALL_LEAVES)],
			Material = Enum.Material.Grass,
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
	end
end

-- A white picket fence from a to b (both on the ground). Pickets every `spacing` studs.
function Decor.picketFence(parent: Instance, a: Vector3, b: Vector3, height: number, color: Color3?)
	local white = color or Color3.fromRGB(245, 242, 235)
	local length = (b - a).Magnitude
	if length < 0.5 then
		return
	end
	local along = CFrame.lookAt(a, b) -- -Z points from a to b
	for _, y in { height * 0.35, height * 0.75 } do
		part({
			Name = "Rail",
			Size = Vector3.new(0.3, 0.35, length),
			CFrame = along * CFrame.new(0, y, -length / 2),
			Color = white,
			Material = Enum.Material.WoodPlanks,
			Parent = parent,
		})
	end
	local spacing = 1.6
	local count = math.max(1, math.floor(length / spacing))
	for i = 0, count do
		local z = -math.min(length, i * length / count)
		part({
			Name = "Picket",
			Size = Vector3.new(0.25, height, 0.7),
			CFrame = along * CFrame.new(0, height / 2, z),
			Color = white,
			Material = Enum.Material.WoodPlanks,
			Parent = parent,
		})
		-- A small block turned 45 degrees gives each picket a pointed top.
		local tip = part({
			Name = "PicketTip",
			Size = Vector3.new(0.25, 0.5, 0.5),
			CFrame = along * CFrame.new(0, height, z) * CFrame.Angles(math.rad(45), 0, 0),
			Color = white,
			Material = Enum.Material.WoodPlanks,
			Parent = parent,
		})
		tip.CanCollide = false
	end
end

-- A wooden signboard with text on both faces. Returns the front TextLabel (and back).
function Decor.signboard(parent: Instance, cframe: CFrame, size: Vector2, text: string, accent: Color3)
	local board = part({
		Name = "Signboard",
		Size = Vector3.new(size.X, size.Y, 0.5),
		CFrame = cframe,
		Color = Color3.fromRGB(140, 95, 60),
		Material = Enum.Material.WoodPlanks,
		Parent = parent,
	})
	part({
		Name = "SignTrim",
		Size = Vector3.new(size.X + 0.6, size.Y + 0.6, 0.35),
		CFrame = cframe,
		Color = accent,
		Parent = parent,
	})
	local labels = {}
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 0.3
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.Text = text
		label.TextColor3 = Color3.fromRGB(255, 250, 235)
		label.TextStrokeTransparency = 0.4
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0.04, 0)
		padding.PaddingRight = UDim.new(0.04, 0)
		padding.PaddingTop = UDim.new(0.12, 0)
		padding.PaddingBottom = UDim.new(0.12, 0)
		padding.Parent = label
		label.Parent = gui
		gui.Parent = board
		table.insert(labels, label)
	end
	return labels
end

return Decor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">DiscoveryService</string>
          <string name="Source"><![CDATA[-- The Catalog: the first player in the whole game to get each rare item (Legendary and up:
-- house parts, pets, yard items and plants) has their name saved forever. Claims go through UpdateAsync so two servers can't
-- both win, and MessagingService tells every other server right away.

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Items = require(ReplicatedStorage.Shared.Items)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local STORE_NAME = "StealALife_Discoveries_v1"
local TOPIC = "PartDiscovered"

-- Only parts this rare or rarer can be claimed.
local MIN_RANK = Rarities.rank.Legendary

local function claimable(partId: string): boolean
	local part = Items.byId[partId]
	return part ~= nil and Rarities.rank[part.rarity] >= MIN_RANK
end

local DiscoveryService = {}

local cache = {} -- [partId] = { name, userId, time }
local claiming = {}
local store = nil
pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local discoveryUpdate = Remotes.get("DiscoveryUpdate")
local notify = Remotes.get("Notify")

-- DataStore keys can be at most 50 characters; longer ids are hashed to fit.
local function storeKey(partId: string): string
	if #partId <= 50 then
		return partId
	end
	local hash = 5381
	for i = 1, #partId do
		hash = (hash * 33 + string.byte(partId, i)) % 4294967296
	end
	return string.format("H%08x%d", hash, #partId)
end

local function announce(partId: string, discovery)
	local isNew = cache[partId] == nil
	cache[partId] = discovery
	discoveryUpdate:FireAllClients(partId, discovery)
	if isNew then
		notify:FireAllClients(
			string.format("%s found the first %s ever!", discovery.name, Items.byId[partId].name),
			"discovery"
		)
	end
end

local function loadAll()
	if not store then
		return
	end
	for _, part in Items.list do
		if claimable(part.id) and not cache[part.id] then
			local ok, value = pcall(store.GetAsync, store, part.id)
			if ok and value then
				cache[part.id] = value
			end
		end
	end
end

-- Call whenever a player gets a part.
function DiscoveryService.claim(player: Player, partId: string)
	if not claimable(partId) or cache[partId] or claiming[partId] then
		return
	end
	claiming[partId] = true

	local mine = { name = player.DisplayName, userId = player.UserId, time = os.time() }
	local winner = mine
	if store then
		local ok, result = pcall(function()
			local existing = nil
			store:UpdateAsync(storeKey(partId), function(old)
				existing = old
				if old then
					return nil
				end
				return mine
			end)
			return existing
		end)
		if ok then
			winner = result or mine
		elseif not RunService:IsStudio() then
			warn("Discovery claim failed:", result)
			claiming[partId] = nil
			return
		end
	end

	announce(partId, winner)
	if winner == mine then
		pcall(MessagingService.PublishAsync, MessagingService, TOPIC, { part = partId, discovery = mine })
	end
	claiming[partId] = nil
end

-- True once someone, anywhere, has found this part.
function DiscoveryService.isDiscovered(partId: string): boolean
	return cache[partId] ~= nil
end

function DiscoveryService.init()
	Remotes.get("GetDiscoveries").OnServerInvoke = function()
		return cache
	end

	-- In the background: SubscribeAsync can hang for a long time in Studio, and nothing
	-- else should wait on it.
	task.spawn(pcall, function()
		MessagingService:SubscribeAsync(TOPIC, function(message)
			local data = message.Data
			if typeof(data) == "table" and typeof(data.part) == "string" and claimable(data.part) then
				announce(data.part, data.discovery)
			end
		end)
	end)

	task.spawn(function()
		while true do
			loadAll()
			task.wait(300)
		end
	end)

	-- Re-check parts a player already owns, in case an earlier claim failed.
	local DataService = require(script.Parent.DataService)
	DataService.onLoaded(function(player, data)
		for partId in data.discovered do
			DiscoveryService.claim(player, partId)
		end
	end)
end

return DiscoveryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[-- Pays every player once a second for the parts on their house, plus offline earnings
-- when they come back. Money also shows on the leaderboard so players can show off.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local LifeUtil = require(ReplicatedStorage.Shared.LifeUtil)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)

local EconomyService = {}

-- Income including game passes.
local function incomeFor(player: Player, data): number
	return LifeUtil.totalIncome(data) * GamePasses.coinMultiplier(player)
end

local function publish(player: Player, data, income: number)
	player:SetAttribute("Money", data.money)
	player:SetAttribute("Income", income)
	local stats = player:FindFirstChild("leaderstats")
	local money = stats and stats:FindFirstChild("Money")
	if money then
		money.Value = math.floor(data.money)
	end
	local speed = stats and stats:FindFirstChild("Speed")
	if speed then
		speed.Value = math.floor(data.speed)
	end
end

local function onLoaded(player: Player, data)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local money = Instance.new("NumberValue")
	money.Name = "Money"
	money.Parent = stats
	local speed = Instance.new("NumberValue")
	speed.Name = "Speed"
	speed.Parent = stats
	stats.Parent = player

	local income = incomeFor(player, data)
	local away = math.clamp(os.time() - (data.lastSeen or os.time()), 0, Config.OFFLINE_MAX_SECONDS)
	local earned = math.floor(away * income * Config.OFFLINE_RATE)
	if earned > 0 then
		data.money += earned
		Remotes.get("Notify")
			:FireClient(player, "While you were away your house earned " .. Format.money(earned) .. "!", "money")
	end
	publish(player, data, income)
end

function EconomyService.init()
	DataService.onLoaded(onLoaded)
	DataService.onChanged(function(player, data)
		publish(player, data, incomeFor(player, data))
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			for player, data in DataService.all() do
				local income = incomeFor(player, data)
				data.money += income
				publish(player, data, income)
			end
		end
	end)
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Environment</string>
          <string name="Source"><![CDATA[-- Lighting, sky, terrain and the town: the street between the two rows of homes, the
-- spawn, the title sign and the edges of the map.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Lego = require(ReplicatedStorage.Shared.Lego)
local ZoneLayout = require(ReplicatedStorage.Shared.ZoneLayout)

local Decor = require(script.Parent.Decor)

local Environment = {}

local function effect(className: string, props)
	local existing = Lighting:FindFirstChildOfClass(className)
	local instance = existing or Instance.new(className)
	for key, value in props do
		instance[key] = value
	end
	instance.Parent = Lighting
	return instance
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(70, 70, 90)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 160)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	Lighting.GeographicLatitude = 35

	effect("Sky", { SunAngularSize = 14, MoonAngularSize = 9, StarCount = 3000 })
	effect("Atmosphere", {
		Density = 0.12, -- clear air, so far-off colours stay bright
		Offset = 0.15,
		Color = Color3.fromRGB(200, 215, 240),
		Decay = Color3.fromRGB(110, 130, 170),
		Glare = 0.25,
		Haze = 0.2,
	})
	effect("BloomEffect", { Intensity = 0.6, Size = 26, Threshold = 1.6 })
	effect("SunRaysEffect", { Intensity = 0.06, Spread = 0.7 })
	effect("ColorCorrectionEffect", {
		Brightness = 0.02,
		Contrast = 0.08,
		Saturation = 0.28,
		TintColor = Color3.fromRGB(255, 250, 242),
	})

	local clouds = Workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.6
	clouds.Color = Color3.fromRGB(255, 255, 255)
	clouds.Parent = Workspace.Terrain
end

local function setupTerrain()
	local terrain = Workspace.Terrain
	-- Clear all terrain near or above ground level over the whole map. The town, the yards
	-- and the zones have their own brick floors at y = 0; terrain is stored in 4-stud voxels,
	-- so even grass meant to stop at y = 0 can bulge up through them and bury the yards.
	-- Done in small chunks: one huge fill can fail outright.
	local west = ZoneLayout.westEnd() - 100
	local CHUNK = 256
	local function fill(x0: number, x1: number, z0: number, z1: number, y0: number, y1: number, material)
		for x = x0, x1 - 1, CHUNK do
			for z = z0, z1 - 1, CHUNK do
				local sx, sz = math.min(CHUNK, x1 - x), math.min(CHUNK, z1 - z)
				local ok, err = pcall(function()
					terrain:FillBlock(
						CFrame.new(x + sx / 2, (y0 + y1) / 2, z + sz / 2),
						Vector3.new(sx, y1 - y0, sz),
						material
					)
				end)
				if not ok then
					warn("[Environment] terrain fill failed: " .. tostring(err))
				end
			end
		end
	end
	fill(west, 512, -512, 512, -12, 256, Enum.Material.Air)
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(95, 175, 80))
	terrain:SetMaterialColor(Enum.Material.Pavement, Color3.fromRGB(196, 190, 180))
	-- No tall grass blades: they hide the feet of anything standing on the grass.
	pcall(function()
		terrain.Decoration = false
	end)
end

local OUTLINE = Color3.fromRGB(20, 22, 48)

local STREET_EAST = 232
local STREET_WEST = ZoneLayout.START_X
local TOWN_HALF = 134 -- how far north and south the town goes (past the back of the homes)

local function outlinedBillboard(parent: Instance, text: string, color: Color3, size: UDim2, maxDistance: number)
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.Text = text
	label.TextColor3 = color
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = OUTLINE
	stroke.Thickness = 5
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	gui.Parent = parent
	return label
end

local function buildScenery()
	local folder = Instance.new("Folder")
	folder.Name = "Scenery"
	folder.Parent = Workspace

	-- A big checkerboard baseplate under the whole town, studs and all.
	Decor.checkerFloor(
		folder,
		CFrame.new((STREET_EAST + STREET_WEST) / 2, 0.02, 0),
		STREET_EAST - STREET_WEST + 16,
		TOWN_HALF * 2 + 4,
		12,
		Color3.fromRGB(64, 196, 70),
		Color3.fromRGB(52, 176, 60),
		"Baseplate"
	)

	-- The street: a road with a dashed line, sidewalks with curbs, lamps.
	local length = STREET_EAST - STREET_WEST
	local centerX = (STREET_EAST + STREET_WEST) / 2
	Decor.part({
		Name = "Road",
		Size = Vector3.new(length, 0.3, 20),
		CFrame = CFrame.new(centerX, 0.15, 0),
		Color = Color3.fromRGB(70, 72, 82),
		Material = Enum.Material.Asphalt,
		Parent = folder,
	})
	for x = STREET_WEST + 6, STREET_EAST - 6, 12 do
		Decor.part({
			Name = "RoadLine",
			Size = Vector3.new(6, 0.32, 0.8),
			CFrame = CFrame.new(x, 0.16, 0),
			Color = Color3.fromRGB(255, 215, 70),
			CanCollide = false,
			Parent = folder,
		})
	end
	for _, side in { -1, 1 } do
		Decor.part({
			Name = "Sidewalk",
			Size = Vector3.new(length, 0.5, 8),
			CFrame = CFrame.new(centerX, 0.25, side * 14),
			Color = Color3.fromRGB(205, 200, 192),
			Material = Enum.Material.Pavement,
			Parent = folder,
		})
		Decor.part({
			Name = "Curb",
			Size = Vector3.new(length, 0.6, 0.8),
			CFrame = CFrame.new(centerX, 0.3, side * 10.2),
			Color = Color3.fromRGB(150, 145, 140),
			Material = Enum.Material.Concrete,
			Parent = folder,
		})
		for x = -208, 208, 52 do
			Decor.lamp(folder, CFrame.new(x, 0.5, side * 17.5))
		end
		-- Trees on the verge between the homes.
		for x = -104, 104, 104 do
			Decor.tree(folder, CFrame.new(x, 0, side * 26), 1.2, math.abs(x) + side)
		end
	end

	-- The spawn at the east end, with flower beds.
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(STREET_EAST - 22, 0.5, 0)
	spawn.Color = Color3.fromRGB(255, 220, 120)
	spawn.Material = Enum.Material.Marble
	spawn.TopSurface = Enum.SurfaceType.Smooth
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
	spawn.Parent = folder
	Decor.flowerBed(folder, CFrame.new(STREET_EAST - 22, 0, -12), 10, 3, 4)
	Decor.flowerBed(folder, CFrame.new(STREET_EAST - 22, 0, 12), 10, 3, 5)

	-- The title, high over the street.
	local title = Decor.part({
		Name = "TitleSign",
		Size = Vector3.one,
		CFrame = CFrame.new(0, 58, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = folder,
	})
	outlinedBillboard(title, "STEAL A LIFE", Color3.fromRGB(255, 225, 80), UDim2.fromScale(44, 9), 500)

	-- A signpost at the west end of the street pointing to the zones.
	local signpost = CFrame.new(STREET_WEST + 10, 0, -14)
	Decor.part({
		Name = "SignPost",
		Size = Vector3.new(1, 12, 1),
		CFrame = signpost * CFrame.new(0, 6, 0),
		Color = Color3.fromRGB(120, 80, 50),
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	local board = Decor.part({
		Name = "SignBoard",
		Size = Vector3.new(1, 3.4, 12),
		CFrame = signpost * CFrame.new(0, 10, 4),
		Color = Color3.fromRGB(255, 230, 150),
		Material = Enum.Material.WoodPlanks,
		Parent = folder,
	})
	outlinedBillboard(board, "🥚 EGG ZONES ➜", Color3.fromRGB(255, 120, 80), UDim2.fromScale(12, 3), 160)

	-- Edges of the map: hedges along the back of the homes, invisible walls all round the
	-- town (the zones have their own cliffs).
	for _, side in { -1, 1 } do
		for x = STREET_WEST, STREET_EAST, 9 do
			Decor.bush(folder, CFrame.new(x, 0, side * (TOWN_HALF - 2)), 1.5, x + side)
		end
	end
	local walls = {
		{ Vector3.new(length + 10, 60, 2), Vector3.new(centerX, 30, TOWN_HALF) },
		{ Vector3.new(length + 10, 60, 2), Vector3.new(centerX, 30, -TOWN_HALF) },
		{ Vector3.new(2, 60, TOWN_HALF * 2), Vector3.new(STREET_EAST, 30, 0) },
	}
	-- West edge of town, either side of the way into the zones.
	local gapHalf = ZoneLayout.WIDTH / 2 + 6
	local westLength = TOWN_HALF - gapHalf
	for _, side in { -1, 1 } do
		table.insert(
			walls,
			{ Vector3.new(2, 60, westLength), Vector3.new(STREET_WEST, 30, side * (gapHalf + westLength / 2)) }
		)
	end
	for _, wall in walls do
		Decor.part({
			Name = "MapEdge",
			Size = wall[1],
			CFrame = CFrame.new(wall[2]),
			Transparency = 1,
			CanQuery = false,
			Parent = folder,
		})
	end
end

function Environment.init()
	-- Everything built from here on gets the LEGO look (Environment starts first).
	Lego.watch(Workspace)
	setupLighting()
	setupTerrain()
	buildScenery()
end

return Environment
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[-- Runs the scheduled events (see shared/Events.luau) and the ones the admin starts.
--
-- Every second it works out what should be running and publishes it as ReplicatedStorage
-- attributes (Event/EventEnds, Weather/WeatherEnds, NextEvent/NextEventAt,
-- NextWeather/NextWeatherAt), announcing each start and end. While weather runs, parts on
-- houses can catch its mutation.
--
-- Admin events reach every server at once through MessagingService, and are also saved in
-- a DataStore so servers that start up later still join in.

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Events = require(ReplicatedStorage.Shared.Events)
local LifeUtil = require(ReplicatedStorage.Shared.LifeUtil)
local Luck = require(ReplicatedStorage.Shared.Luck)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)

local EventService = {}

local TOPIC = "StealALifeAdmin"
local STORE_KEY = "AdminEvents"

local notifyRemote = Remotes.get("Notify")
local rng = Random.new()
local store -- the DataStore, if this server can use one

-- What the admin has started: { big = { id, ends }, weather = { id, ends } }.
local overrides = { big = nil, weather = nil }

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function announce(message: string)
	for _, player in Players:GetPlayers() do
		notifyRemote:FireClient(player, message, "discovery")
	end
end

-- Applies an admin message (from this server or another one).
local function apply(message)
	if type(message) ~= "table" then
		return
	end
	if message.type == "event" then
		local kind = if Events.BIG[message.id]
			then "big"
			elseif Events.WEATHER[message.id] then "weather"
			elseif Luck.EVENTS[message.id] then "lucky"
			else nil
		if kind == "lucky" then
			ReplicatedStorage:SetAttribute("LuckyEvent", message.id)
			ReplicatedStorage:SetAttribute("LuckyEventEnds", message.ends)
			local event = Luck.EVENTS[message.id]
			announce(event.icon .. " " .. event.name .. "! " .. event.description)
		elseif kind then
			overrides[kind] = { id = message.id, ends = message.ends }
		end
	elseif message.type == "end" then
		-- End everything the admin started, and anything scheduled running right now.
		overrides.big = { id = nil, ends = message.ends or now() + 60 }
		overrides.weather = { id = nil, ends = message.ends or now() + 60 }
		ReplicatedStorage:SetAttribute("LuckyEvent", nil)
	elseif message.type == "announce" and type(message.text) == "string" then
		announce("📣 " .. message.text)
	end
end

-- Sends an admin message to this server and, if `everywhere`, every other server too.
function EventService.send(message, everywhere: boolean)
	apply(message)
	if not everywhere then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:PublishAsync(TOPIC, message)
		end)
		if not ok then
			warn("[EventService] Couldn't reach other servers: " .. tostring(err))
		end
		if store and message.type ~= "announce" then
			pcall(function()
				store:SetAsync(STORE_KEY, message)
			end)
		end
	end)
end

-- What's running (or nil): an admin override beats the timetable while it lasts.
local function pick(kind: string, scheduled)
	local override = overrides[kind]
	if override and now() < override.ends then
		if override.id then
			return { id = override.id, ends = override.ends }
		end
		return nil -- the admin ended it
	end
	return scheduled
end

-- Weather mutations: every item that's out (house, pets, yard, garden) has a chance to catch it.
local function weatherTick(weather)
	for _, player in Players:GetPlayers() do
		local data = DataService.get(player)
		if data then
			local changed = false
			for uid in LifeUtil.placed(data) do
				local record = data.parts[uid]
				local mutations = record and Mutations.normalize(record.mutations)
				if record and not table.find(mutations, weather.mutation) and rng:NextNumber() < weather.chance then
					table.insert(mutations, weather.mutation)
					record.mutations = Mutations.pack(mutations)
					changed = true
					notifyRemote:FireClient(
						player,
						weather.icon
							.. " Your "
							.. LifeUtil.displayName(record)
							.. " caught the "
							.. weather.name
							.. "!",
						"discovery"
					)
				end
			end
			if changed then
				DataService.changed(player)
			end
		end
	end
end

function EventService.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("StealALifeEvents")
	end)
	store = ok and result or nil

	-- Listening to other servers can take a while (or fail in Studio): never wait for it.
	task.spawn(function()
		local subscribed, err = pcall(function()
			MessagingService:SubscribeAsync(TOPIC, function(packet)
				apply(packet.Data)
			end)
		end)
		if not subscribed then
			warn("[EventService] Not listening to other servers: " .. tostring(err))
		end
	end)

	-- Pick up an admin event another server started before this one existed.
	task.spawn(function()
		if store then
			local loaded, message = pcall(function()
				return store:GetAsync(STORE_KEY)
			end)
			if loaded and type(message) == "table" and (message.ends or 0) > now() then
				apply(message)
			end
		end
	end)

	local running = { big = nil, weather = nil }
	local nextTick = 0
	task.spawn(function()
		while true do
			local t = now()
			local unix = os.time()
			local offset = t - unix -- server time vs. the UTC clock the timetable uses
			local scheduledBig = Events.scheduledAt(unix)
			local scheduledWeather = Events.scheduledWeatherAt(unix)
			local big = pick("big", scheduledBig and { id = scheduledBig.id, ends = scheduledBig.ends + offset })
			local weather = pick(
				"weather",
				scheduledWeather and { id = scheduledWeather.id, ends = scheduledWeather.ends + offset }
			)

			for kind, state in { big = big, weather = weather } do
				local before = running[kind]
				local id = state and state.id
				local list = if kind == "big" then Events.BIG else Events.WEATHER
				if id ~= (before and before.id) then
					if before and before.id then
						announce(list[before.id].name .. " is over!")
					end
					if id then
						local event = list[id]
						announce(event.icon .. " " .. string.upper(event.name) .. "! " .. event.description)
					end
				end
				running[kind] = state
			end
			ReplicatedStorage:SetAttribute("Event", big and big.id)
			ReplicatedStorage:SetAttribute("EventEnds", big and big.ends or 0)
			ReplicatedStorage:SetAttribute("Weather", weather and weather.id)
			ReplicatedStorage:SetAttribute("WeatherEnds", weather and weather.ends or 0)

			-- What's coming next, for the countdowns.
			local upcoming = Events.upcoming(unix)
			local nextBig
			for _, slot in upcoming do
				if slot.starts > unix then
					nextBig = slot
					break
				end
			end
			ReplicatedStorage:SetAttribute("NextEvent", nextBig and nextBig.id)
			ReplicatedStorage:SetAttribute("NextEventAt", nextBig and nextBig.starts + offset or 0)
			local nextWeather = Events.nextWeather(unix)
			if nextWeather and nextWeather.starts <= unix then
				nextWeather = Events.nextWeather(nextWeather.ends + 1)
			end
			ReplicatedStorage:SetAttribute("NextWeather", nextWeather and nextWeather.id)
			ReplicatedStorage:SetAttribute("NextWeatherAt", nextWeather and nextWeather.starts + offset or 0)

			if weather and Events.WEATHER[weather.id] and t >= nextTick then
				nextTick = t + Events.WEATHER_TICK
				weatherTick(Events.WEATHER[weather.id])
			end
			task.wait(1)
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">HalloweenDecor</string>
          <string name="Source"><![CDATA[-- Halloween props: ghosts, bats, cobwebs, tombstones, dead trees, a witch's cauldron,
-- witch hats, string lights and creeping fog.
--
-- Ghosts and bats are tagged; each client flies them around (see client/Ambient) using
-- the attributes set here, so they move smoothly without network traffic.

local CollectionService = game:GetService("CollectionService")

local Decor = require(script.Parent.Decor)

local part = Decor.part

local HalloweenDecor = {}

HalloweenDecor.GHOST_TAG = "SpookyGhost"
HalloweenDecor.BAT_TAG = "SpookyBat"

-- Shared flight settings read by the client: circle `center` at `radius`, `height` up.
local function flightPath(model: Model, center: Vector3, radius: number, height: number, speed: number, phase: number)
	model:SetAttribute("Center", center)
	model:SetAttribute("Radius", radius)
	model:SetAttribute("Height", height)
	model:SetAttribute("Speed", speed)
	model:SetAttribute("Phase", phase)
end

function HalloweenDecor.ghost(
	parent: Instance,
	center: Vector3,
	radius: number,
	height: number,
	speed: number,
	phase: number
)
	local model = Instance.new("Model")
	model.Name = "Ghost"
	local white = Color3.fromRGB(240, 245, 255)
	local origin = CFrame.new(center + Vector3.new(radius, height, 0))
	local head = part({
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 3.2,
		CFrame = origin,
		Color = white,
		Transparency = 0.15,
		CanCollide = false,
		CastShadow = false,
		Parent = model,
	})
	part({
		Name = "Body",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.6, 3.1, 3.1),
		CFrame = origin * CFrame.new(0, -1.3, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = white,
		Transparency = 0.15,
		CanCollide = false,
		CastShadow = false,
		Parent = model,
	})
	-- Wavy hem.
	for i = 0, 5 do
		local angle = i / 6 * math.pi * 2
		part({
			Name = "Hem",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 1.2,
			CFrame = origin * CFrame.new(math.cos(angle) * 1.2, -2.7, math.sin(angle) * 1.2),
			Color = white,
			Transparency = 0.15,
			CanCollide = false,
			CastShadow = false,
			Parent = model,
		})
	end
	for _, x in { -1.6, 1.6 } do
		part({
			Name = "Arm",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1, 1, 1),
			CFrame = origin * CFrame.new(x, -0.9, -0.3),
			Color = white,
			Transparency = 0.15,
			CanCollide = false,
			CastShadow = false,
			Parent = model,
		})
	end
	for _, x in { -0.55, 0.55 } do
		part({
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.6,
			CFrame = origin * CFrame.new(x, 0.3, -1.4),
			Color = Color3.fromRGB(20, 20, 30),
			CanCollide = false,
			Parent = model,
		})
	end
	part({
		Name = "Mouth",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.7, 0.7, 0.7),
		CFrame = origin * CFrame.new(0, -0.5, -1.4),
		Color = Color3.fromRGB(20, 20, 30),
		CanCollide = false,
		Parent = model,
	})
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(190, 220, 255)
	glow.Range = 12
	glow.Brightness = 0.8
	glow.Parent = head
	model.PrimaryPart = head
	flightPath(model, center, radius, height, speed, phase)
	model.Parent = parent
	CollectionService:AddTag(model, HalloweenDecor.GHOST_TAG)
	return model
end

function HalloweenDecor.bat(
	parent: Instance,
	center: Vector3,
	radius: number,
	height: number,
	speed: number,
	phase: number
)
	local model = Instance.new("Model")
	model.Name = "Bat"
	local black = Color3.fromRGB(28, 22, 36)
	local origin = CFrame.new(center + Vector3.new(radius, height, 0))
	local body = part({
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.1, 1.1, 1.1),
		CFrame = origin,
		Color = black,
		CanCollide = false,
		Parent = model,
	})
	part({
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.75,
		CFrame = origin * CFrame.new(0, 0.35, -0.55),
		Color = black,
		CanCollide = false,
		Parent = model,
	})
	for _, x in { -0.18, 0.18 } do
		part({
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.16,
			CFrame = origin * CFrame.new(x, 0.42, -0.88),
			Color = Color3.fromRGB(255, 60, 40),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = model,
		})
	end
	for _, side in { -1, 1 } do
		part({
			Name = if side < 0 then "WingL" else "WingR",
			Size = Vector3.new(2.2, 0.1, 1.3),
			CFrame = origin * CFrame.new(side * 1.5, 0, 0),
			Color = Color3.fromRGB(45, 30, 55),
			CanCollide = false,
			Parent = model,
		})
	end
	model.PrimaryPart = body
	flightPath(model, center, radius, height, speed, phase)
	model.Parent = parent
	CollectionService:AddTag(model, HalloweenDecor.BAT_TAG)
	return model
end

-- A cobweb in a corner. `corner` sits in the corner with -X/-Y pointing into the opening,
-- so place it rotated to suit each corner.
function HalloweenDecor.cobweb(parent: Instance, corner: CFrame, size: number)
	local white = Color3.fromRGB(235, 235, 240)
	local strand = function(a: Vector3, b: Vector3)
		local length = (b - a).Magnitude
		part({
			Name = "Web",
			Size = Vector3.new(0.07, 0.07, length),
			CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -length / 2),
			Color = white,
			Transparency = 0.3,
			CanCollide = false,
			CastShadow = false,
			Parent = parent,
		})
	end
	local spokes = {}
	for i = 0, 4 do
		local angle = math.rad(180 + i * 22.5)
		local tip = corner * CFrame.new(math.cos(angle) * size * -1, math.sin(angle) * size, 0)
		spokes[i] = tip.Position
		strand(corner.Position, tip.Position)
	end
	for _, ring in { 0.35, 0.65, 0.95 } do
		for i = 0, 3 do
			local a = corner.Position:Lerp(spokes[i], ring)
			local b = corner.Position:Lerp(spokes[i + 1], ring)
			strand(a, b)
		end
	end
end

function HalloweenDecor.tombstone(parent: Instance, ground: CFrame, seed: number)
	local rng = Random.new(seed)
	local stone = Color3.fromRGB(130, 130, 140):Lerp(Color3.fromRGB(95, 100, 105), rng:NextNumber())
	local lean = ground * CFrame.Angles(math.rad(rng:NextNumber(-8, 8)), 0, math.rad(rng:NextNumber(-10, 10)))
	local slab = part({
		Name = "Tombstone",
		Size = Vector3.new(3, 3.4, 0.8),
		CFrame = lean * CFrame.new(0, 1.7, 0),
		Color = stone,
		Material = Enum.Material.Slate,
		Parent = parent,
	})
	part({
		Name = "TombstoneTop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 3, 3),
		CFrame = lean * CFrame.new(0, 3.4, 0) * CFrame.Angles(0, math.pi / 2, 0),
		Color = stone,
		Material = Enum.Material.Slate,
		Parent = parent,
	})
	part({
		Name = "Dirt",
		Size = Vector3.new(2.6, 0.4, 4),
		CFrame = ground * CFrame.new(0, 0.2, -2.6),
		Color = Color3.fromRGB(85, 60, 45),
		Material = Enum.Material.Ground,
		CanCollide = false,
		Parent = parent,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 0.6)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.Fondamento
	label.Text = "R.I.P."
	label.TextColor3 = Color3.fromRGB(60, 60, 70)
	label.Parent = gui
	gui.Parent = slab
end

-- A bare, twisted tree.
function HalloweenDecor.deadTree(parent: Instance, ground: CFrame, scale: number, seed: number)
	local rng = Random.new(seed)
	local bark = Color3.fromRGB(60, 45, 40)
	local function branch(from: CFrame, length: number, thickness: number, depth: number)
		local tip = from * CFrame.new(0, length, 0)
		part({
			Name = "Branch",
			Size = Vector3.new(thickness, length, thickness),
			CFrame = from * CFrame.new(0, length / 2, 0),
			Color = bark,
			Material = Enum.Material.Wood,
			Parent = parent,
		})
		if depth > 0 then
			for _ = 1, 2 do
				local turn = CFrame.Angles(math.rad(rng:NextNumber(-55, 55)), math.rad(rng:NextNumber(0, 360)), 0)
				branch(tip * turn, length * 0.65, thickness * 0.6, depth - 1)
			end
		end
	end
	branch(ground, 7 * scale, 1.3 * scale, 3)
end

function HalloweenDecor.cauldron(parent: Instance, ground: CFrame)
	local iron = Color3.fromRGB(35, 35, 40)
	part({
		Name = "Cauldron",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 6,
		CFrame = ground * CFrame.new(0, 3, 0),
		Color = iron,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Name = "Rim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 5.4, 5.4),
		CFrame = ground * CFrame.new(0, 5.5, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = iron,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	local brew = part({
		Name = "Brew",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 4.8, 4.8),
		CFrame = ground * CFrame.new(0, 5.65, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(110, 255, 90),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	for i = 0, 2 do
		local angle = i / 3 * math.pi * 2
		part({
			Name = "Leg",
			Size = Vector3.new(0.6, 1.6, 0.6),
			CFrame = ground * CFrame.new(math.cos(angle) * 2, 0.8, math.sin(angle) * 2),
			Color = iron,
			Material = Enum.Material.Metal,
			Parent = parent,
		})
	end
	-- Firewood and flames underneath.
	for i = 0, 3 do
		part({
			Name = "Log",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(4, 0.7, 0.7),
			CFrame = ground * CFrame.new(0, 0.35, 0) * CFrame.Angles(0, i * math.pi / 4, 0),
			Color = Color3.fromRGB(100, 65, 40),
			Material = Enum.Material.Wood,
			Parent = parent,
		})
	end
	local embers = part({
		Name = "Embers",
		Size = Vector3.new(1, 1, 1),
		CFrame = ground * CFrame.new(0, 0.7, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = parent,
	})
	local fire = Instance.new("Fire")
	fire.Size = 4
	fire.Heat = 4
	fire.Parent = embers

	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(120, 255, 110)
	smoke.Opacity = 0.18
	smoke.RiseVelocity = 3
	smoke.Size = 2.5
	smoke.Parent = brew
	local bubbles = Instance.new("Sparkles")
	bubbles.SparkleColor = Color3.fromRGB(150, 255, 120)
	bubbles.Parent = brew
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(110, 255, 90)
	light.Range = 22
	light.Brightness = 2
	light.Parent = brew
end

-- A pointy witch hat; ground is the bottom of the brim.
function HalloweenDecor.witchHat(parent: Instance, ground: CFrame, scale: number, color: Color3)
	local s = scale
	part({
		Name = "Brim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.35 * s, 7 * s, 7 * s),
		CFrame = ground * CFrame.new(0, 0.18 * s, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Parent = parent,
	})
	part({
		Name = "Band",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6 * s, 4.7 * s, 4.7 * s),
		CFrame = ground * CFrame.new(0, 0.6 * s, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(255, 150, 40),
		Parent = parent,
	})
	-- Stacked, shrinking, slightly bent tiers make the cone.
	local tier = ground * CFrame.new(0, 0.9 * s, 0)
	for i, d in { 4.5, 3.6, 2.7, 1.8, 1 } do
		local h = 1.3 * s
		part({
			Name = "Cone",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(h, d * s, d * s),
			CFrame = tier * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
			Color = color,
			Parent = parent,
		})
		tier = tier * CFrame.new(0, h * 0.9, 0) * CFrame.Angles(0, 0, math.rad(if i >= 3 then 9 else 2))
	end
end

-- A strand of glowing bulbs from a to b, sagging in the middle.
function HalloweenDecor.stringLights(parent: Instance, a: Vector3, b: Vector3, count: number, sag: number)
	local colors = { Color3.fromRGB(255, 140, 30), Color3.fromRGB(170, 80, 255) }
	local previous = a
	for i = 0, count do
		local t = i / count
		local point = a:Lerp(b, t) - Vector3.new(0, math.sin(t * math.pi) * sag, 0)
		if i > 0 then
			local length = (point - previous).Magnitude
			part({
				Name = "Wire",
				Size = Vector3.new(0.06, 0.06, length),
				CFrame = CFrame.lookAt(previous, point) * CFrame.new(0, 0, -length / 2),
				Color = Color3.fromRGB(20, 20, 20),
				CanCollide = false,
				CastShadow = false,
				Parent = parent,
			})
		end
		if i > 0 and i < count then
			part({
				Name = "Bulb",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 0.45,
				CFrame = CFrame.new(point - Vector3.new(0, 0.25, 0)),
				Color = colors[i % 2 + 1],
				Material = Enum.Material.Neon,
				CanCollide = false,
				CastShadow = false,
				Parent = parent,
			})
		end
		previous = point
	end
end

-- Low, slow-drifting ground fog.
function HalloweenDecor.fog(parent: Instance, position: Vector3)
	local holder = part({
		Name = "Fog",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(position),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = parent,
	})
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(185, 175, 210)
	smoke.Opacity = 0.07
	smoke.RiseVelocity = 0.2
	smoke.Size = 12
	smoke.Parent = holder
end

return HalloweenDecor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">LuckService</string>
          <string name="Source"><![CDATA[-- Mystery Boxes, the daily Lucky Wheel and Lucky Hour events (rules and odds in
-- shared/Luck.luau). All rolls happen here; the client only shows the result (the
-- LuckResult remote) with a reveal animation.
--
-- Mystery Boxes are Developer Products. ProcessReceipt grants a crate only once per
-- purchase (receipts are remembered in the player's save) and only tells Roblox the
-- purchase went through after the save succeeds, so nobody pays without getting it.

local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local BoxModel = require(ReplicatedStorage.Shared.BoxModel)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Items = require(ReplicatedStorage.Shared.Items)
local LifeUtil = require(ReplicatedStorage.Shared.LifeUtil)
local Luck = require(ReplicatedStorage.Shared.Luck)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local ActionService = require(script.Parent.ActionService)
local DataService = require(script.Parent.DataService)
local NestService = require(script.Parent.NestService)

local LuckService = {}

local rng = Random.new()
local notifyRemote = Remotes.get("Notify")
local resultRemote = Remotes.get("LuckResult")
local RECEIPTS_KEPT = 50 -- how many recent purchase IDs each save remembers

local function notify(player: Player, message: string, kind: string?)
	notifyRemote:FireClient(player, message, kind)
end

local function announce(message: string)
	for _, player in Players:GetPlayers() do
		notify(player, message, "discovery")
	end
end

-- Picks a key from a { [key] = weight } table.
local function rollWeighted(weights: { [string]: number }): string
	local keys = {}
	local total = 0
	for key, weight in weights do
		table.insert(keys, key)
		total += weight
	end
	table.sort(keys)
	local roll = rng:NextNumber() * total
	for _, key in keys do
		roll -= weights[key]
		if roll <= 0 then
			return key
		end
	end
	return keys[#keys]
end

-- A random item of this rarity, of any kind.
local function pickItem(rarity: string): string
	local kind = Items.KIND_ORDER[rng:NextInteger(1, #Items.KIND_ORDER)]
	return NestService.rollItem(kind, rarity)
end

local function rollMutations(boost: number): { string }?
	for _, mutation in Mutations.list do
		if rng:NextNumber() < mutation.chance * boost then
			return { mutation.id }
		end
	end
	return nil
end

local function hasRoom(player: Player, data): boolean
	return LifeUtil.backpackCount(data) < GamePasses.backpackSize(player)
end

local function openCrate(player: Player, data, crate)
	NestService.reward(
		player,
		data,
		pickItem(rollWeighted(Luck.crateOdds(crate))),
		rollMutations(crate.mutation),
		{ kind = "crate", crate = crate.id },
		Items.rollWeightFactor(rng, crate.mutation),
		1
	)
end

-- Whether paid random items are allowed for this player (some countries ban them).
local function cratesAllowed(player: Player): boolean
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	if not ok then
		return RunService:IsStudio() -- can't check: only allow while testing in Studio
	end
	return not info.ArePaidRandomItemsRestricted
end

-- The player asked to buy a crate: check, then show Roblox's purchase prompt.
local function buyCrate(player: Player, data, crateId: any)
	local crate = typeof(crateId) == "string" and Luck.crateById[crateId]
	if not crate then
		return
	end
	if player:GetAttribute("CratesRestricted") then
		return notify(player, "Mystery Boxes aren't available where you live.", "error")
	end
	if not hasRoom(player, data) then
		return notify(player, "Your backpack is full! Sell some items first.", "error")
	end
	if crate.productId == 0 then
		if RunService:IsStudio() and Luck.STUDIO_FREE_CRATES then
			notify(player, "Studio test: opening a " .. crate.name .. " for free.", "success")
			return openCrate(player, data, crate)
		end
		return notify(player, "Mystery Boxes are coming soon!", "error")
	end
	MarketplaceService:PromptProductPurchase(player, crate.productId)
end

-- Opens a crate the player already owns (won on the wheel, or bought while full).
local function openOwnedCrate(player: Player, data, crateId: any)
	local crate = typeof(crateId) == "string" and Luck.crateById[crateId]
	if not crate or (data.crates[crate.id] or 0) < 1 then
		return
	end
	if not hasRoom(player, data) then
		return notify(player, "Your backpack is full! Sell some items first.", "error")
	end
	data.crates[crate.id] -= 1
	openCrate(player, data, crate)
end

-- Shows the Starter Pack countdown on the player (StarterEnds; nil once bought).
local function markStarter(player: Player, data)
	local ends = (data.firstJoin or os.time()) + Luck.STARTER.hours * 3600
	local offerOpen = not data.starterBought and os.time() < ends
	-- Server time, so the client's countdown lines up with GetServerTimeNow.
	local offset = Workspace:GetServerTimeNow() - os.time()
	player:SetAttribute("StarterEnds", if offerOpen then ends + offset else nil)
end

local function buyStarter(player: Player, data)
	if player:GetAttribute("CratesRestricted") then
		return notify(player, "The Starter Pack isn't available where you live.", "error")
	end
	if data.starterBought or not player:GetAttribute("StarterEnds") then
		return notify(player, "The Starter Pack offer is over.", "error")
	end
	if Luck.STARTER.passId == 0 then
		return notify(player, "The Starter Pack is coming soon!", "error")
	end
	MarketplaceService:PromptGamePassPurchase(player, Luck.STARTER.passId)
end

local function buyBundle(player: Player, _data, bundleId: any)
	local bundle = typeof(bundleId) == "string" and Luck.bundleById[bundleId]
	if not bundle then
		return
	end
	if player:GetAttribute("CratesRestricted") then
		return notify(player, "Mystery Boxes aren't available where you live.", "error")
	end
	if bundle.productId == 0 then
		return notify(player, "This bundle is coming soon!", "error")
	end
	MarketplaceService:PromptProductPurchase(player, bundle.productId)
end

-- Gives the Starter Pack's contents, once ever (the boxes wait in the Luck tab).
local function grantStarter(player: Player, data)
	if data.starterBought then
		return
	end
	local starter = Luck.STARTER
	data.money += starter.coins
	for crateId, count in starter.crates do
		data.crates[crateId] = (data.crates[crateId] or 0) + count
	end
	data.starterBought = true
	markStarter(player, data)
	notify(player, "🎁 Starter Pack unlocked! Your Mystery Boxes are waiting in the 🍀 Luck tab.", "discovery")
	DataService.changed(player)
	task.spawn(DataService.save, player)
end

-- Owns the Starter Pack pass (bought here or on the website) but hasn't had it yet: give it.
local function checkStarterPass(player: Player, data)
	if data.starterBought or Luck.STARTER.passId == 0 then
		return
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Luck.STARTER.passId)
	end)
	if ok and owns then
		grantStarter(player, data)
	end
end

-- Gives what a bundle contains (boxes are saved to open from Luck).
local function grantPack(player: Player, data, productId: number): boolean
	local bundle = Luck.bundleByProduct[productId]
	if bundle then
		data.crates[bundle.crate] = (data.crates[bundle.crate] or 0) + bundle.count
		notify(player, "📦 " .. bundle.name .. " added! Open them from the 🍀 Luck tab.", "discovery")
		return true
	end
	return false
end

local function isOurs(productId: number): boolean
	return Luck.crateByProduct[productId] ~= nil or Luck.bundleByProduct[productId] ~= nil
end

local function processReceipt(receipt)
	local crate = Luck.crateByProduct[receipt.ProductId]
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and DataService.get(player)
	if not isOurs(receipt.ProductId) or not data then
		-- Not ours, or the player isn't here: Roblox will try again later.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	data.receipts = data.receipts or {}
	if not table.find(data.receipts, receipt.PurchaseId) then
		if not crate then
			grantPack(player, data, receipt.ProductId)
		elseif hasRoom(player, data) then
			openCrate(player, data, crate)
		else
			data.crates[crate.id] = (data.crates[crate.id] or 0) + 1
			notify(
				player,
				"Your backpack is full, so your " .. crate.name .. " was saved. Open it from the 🍀 Luck tab!",
				"success"
			)
		end
		table.insert(data.receipts, receipt.PurchaseId)
		while #data.receipts > RECEIPTS_KEPT do
			table.remove(data.receipts, 1)
		end
		DataService.changed(player)
	end
	if not DataService.save(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function spinCooldown(player: Player): number
	return if GamePasses.has(player, "VIP") then Luck.VIP_SPIN_COOLDOWN else Luck.SPIN_COOLDOWN
end

local function coinPrize(data, minutes: number): number
	return math.max(Luck.MIN_COIN_PRIZE, math.floor(LifeUtil.totalIncome(data) * 60 * minutes))
end

local function spin(player: Player, data)
	local now = os.time()
	if now - (data.lastSpin or 0) < spinCooldown(player) then
		return notify(player, "Your next free spin isn't ready yet!", "error")
	end
	data.lastSpin = now

	local weights = {}
	for i, slice in Luck.WHEEL do
		weights[tostring(i)] = slice.weight
	end
	local index = tonumber(rollWeighted(weights)) :: number
	local slice = Luck.WHEEL[index]
	local reveal = { kind = "wheel", slice = index }

	if slice.golden or slice.rainbow then
		-- An egg from the best zone the player's Speed reaches, hatched on the spot.
		local zone = Items.zoneFor(data.speed)
		local itemId = NestService.rollItem(Items.ZONES[zone].kind, Items.rollRarity(zone, rng))
		reveal.egg = zone
		return NestService.reward(
			player,
			data,
			itemId,
			{ if slice.rainbow then "Rainbow" else "Golden" },
			reveal,
			Items.eggBaseWeight(zone) * Items.rollWeightFactor(rng),
			Items.eggBaseWeight(zone)
		)
	end
	if slice.crate then
		data.crates[slice.crate] = (data.crates[slice.crate] or 0) + 1
		reveal.crate = slice.crate
		if slice.crate == "LegendaryMonster" then
			announce(player.DisplayName .. " hit the JACKPOT on the Lucky Wheel!")
		end
	else
		-- Coins (also the fallback for a part prize when the backpack is full).
		local amount = coinPrize(data, slice.minutes or 10)
		data.money += amount
		reveal.coins = amount
	end
	resultRemote:FireClient(player, reveal)
end

-- Runs Lucky Hour events forever: a random one every so often, announced to everyone.
local function runEvents()
	task.wait(Luck.FIRST_EVENT_AFTER)
	local ids = {}
	for id in Luck.EVENTS do
		table.insert(ids, id)
	end
	table.sort(ids)
	while true do
		local id = ids[rng:NextInteger(1, #ids)]
		local event = Luck.EVENTS[id]
		ReplicatedStorage:SetAttribute("LuckyEvent", id)
		ReplicatedStorage:SetAttribute("LuckyEventEnds", Workspace:GetServerTimeNow() + Luck.EVENT_DURATION)
		announce(event.icon .. " " .. event.name .. "! " .. event.description)
		task.wait(Luck.EVENT_DURATION)
		ReplicatedStorage:SetAttribute("LuckyEvent", nil)
		announce(event.name .. " is over. Another one will come soon!")
		task.wait(rng:NextInteger(Luck.EVENT_GAP[1], Luck.EVENT_GAP[2]))
	end
end

-- Marks players who can't buy crates so their client hides the buy buttons.
local function checkPolicy(player: Player)
	player:SetAttribute("CratesRestricted", not cratesAllowed(player))
end

-- The Mystery Box stand by the spawn: the three boxes on glowing pedestals, each with its
-- odds floating above it (like the egg stands in pet games). Hold E to open one.
local STAND_X = 190
local OUTLINE = Color3.fromRGB(20, 22, 48)

local function outlinedLabel(parent: Instance, text: string, color: Color3, top: number, height: number, font)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0, top)
	label.Size = UDim2.fromScale(1, height)
	label.TextScaled = true
	label.Font = font
	label.Text = text
	label.TextColor3 = color
	label.Parent = parent
	local stroke = Instance.new("UIStroke")
	stroke.Color = OUTLINE
	stroke.Thickness = 2.5
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	return label
end

local function buildBoxStand()
	local folder = Instance.new("Folder")
	folder.Name = "BoxStand"
	folder.Parent = Workspace
	for i, crate in Luck.CRATES do
		local z = (i - 2) * 13
		local base = CFrame.lookAt(Vector3.new(STAND_X, 0, z), Vector3.new(STAND_X + 10, 0, z)) -- faces the spawn
		local pedestal = Instance.new("Part")
		pedestal.Name = "EggPedestal"
		pedestal.Anchored = true
		pedestal.Shape = Enum.PartType.Cylinder
		pedestal.Size = Vector3.new(1.2, 7, 7)
		pedestal.CFrame = base * CFrame.new(0, 0.6, 0) * CFrame.Angles(0, 0, math.rad(90))
		pedestal.Color = Color3.fromRGB(45, 35, 65)
		pedestal.Material = Enum.Material.Slate
		pedestal.Parent = folder
		local rim = pedestal:Clone()
		rim.Name = "EggRim"
		rim.Size = Vector3.new(0.3, 7.6, 7.6)
		rim.CFrame = base * CFrame.new(0, 0.85, 0) * CFrame.Angles(0, 0, math.rad(90))
		rim.Color = crate.color
		rim.Material = Enum.Material.Neon
		rim.Parent = folder

		local egg, height = BoxModel.build(crate.id)
		local rest = base * CFrame.new(0, 1.2, 0)
		egg:PivotTo(rest)
		egg:SetAttribute("Rest", rest) -- clients spin and bob it around here
		CollectionService:AddTag(egg, "DisplayEgg")
		egg.Parent = folder

		-- The odds float above the egg.
		local odds = Luck.oddsList(crate)
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(230, 46 + #odds * 20)
		gui.StudsOffsetWorldSpace = Vector3.new(0, height + 3.2, 0)
		gui.MaxDistance = 80
		gui.LightInfluence = 0
		local total = 46 + #odds * 20
		outlinedLabel(gui, string.upper(crate.name), crate.color, 0, 26 / total, Enum.Font.LuckiestGuy)
		outlinedLabel(
			gui,
			"R$ " .. crate.robux,
			Color3.fromRGB(110, 240, 120),
			26 / total,
			20 / total,
			Enum.Font.LuckiestGuy
		)
		for k, entry in odds do
			local percent = if entry.percent < 1
				then string.format("%.1f", entry.percent)
				else string.format("%.0f", entry.percent)
			outlinedLabel(
				gui,
				entry.rarity .. " item  " .. percent .. "%",
				Rarities.info[entry.rarity].color,
				(46 + (k - 1) * 20) / total,
				19 / total,
				Enum.Font.FredokaOne
			)
		end
		gui.Parent = egg.PrimaryPart

		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "EggPrompt"
		prompt.ActionText = "Open (R$ " .. crate.robux .. ")"
		prompt.ObjectText = crate.name
		prompt.HoldDuration = 0.3
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("EggId", crate.id)
		prompt.Parent = egg.PrimaryPart
	end

	-- A big sign over the stand.
	local signPart = Instance.new("Part")
	signPart.Name = "EggSign"
	signPart.Anchored = true
	signPart.Transparency = 1
	signPart.CanCollide = false
	signPart.Size = Vector3.one
	signPart.CFrame = CFrame.new(STAND_X, 17, 0)
	signPart.Parent = folder
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(26, 5)
	gui.MaxDistance = 300
	gui.LightInfluence = 0
	local label =
		outlinedLabel(gui, "📦 MYSTERY BOXES 📦", Color3.fromRGB(255, 160, 40), 0, 1, Enum.Font.LuckiestGuy)
	label:FindFirstChildOfClass("UIStroke").Thickness = 4
	gui.Parent = signPart
end

function LuckService.init()
	buildBoxStand()
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		local eggId = prompt.Name == "EggPrompt" and prompt:GetAttribute("EggId")
		local data = DataService.get(player)
		if eggId and data then
			buyCrate(player, data, eggId)
			DataService.changed(player)
		end
	end)
	ActionService.register("BuyCrate", buyCrate)
	ActionService.register("OpenCrate", openOwnedCrate)
	ActionService.register("SpinWheel", spin)
	ActionService.register("BuyStarter", buyStarter)
	ActionService.register("BuyBundle", buyBundle)
	DataService.onLoaded(function(player, data)
		markStarter(player, data)
		checkStarterPass(player, data)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local data = DataService.get(player)
		if purchased and data and passId == Luck.STARTER.passId then
			grantStarter(player, data)
		end
	end)
	-- The offer ends while they're playing: take the countdown down.
	task.spawn(function()
		while true do
			task.wait(30)
			for _, player in Players:GetPlayers() do
				local data = DataService.get(player)
				if data and player:GetAttribute("StarterEnds") then
					markStarter(player, data)
				end
			end
		end
	end)
	MarketplaceService.ProcessReceipt = processReceipt
	LuckService.processReceipt = processReceipt -- also called directly by tests
	Players.PlayerAdded:Connect(checkPolicy)
	for _, player in Players:GetPlayers() do
		task.spawn(checkPolicy, player)
	end
	task.spawn(runEvents)
end

return LuckService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="42">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point. Order matters: remotes and the map exist before players load.
-- Each service starts on its own, so if one breaks the rest of the game still loads and
-- the Output window says exactly which one failed and why.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Server = script.Parent

-- Shown on players' screens if the game doesn't finish loading (see client Main), so
-- problems are visible without digging through Output.
local problems = {}
local function setStatus(text: string)
	local lines = table.clone(problems)
	table.insert(lines, text)
	ReplicatedStorage:SetAttribute("ServerStartup", table.concat(lines, "\n"))
end

local STARTUP_WAIT = 10 -- seconds to wait for each service before moving on

local SERVICES = {
	"Environment",
	"PlotService",
	"DiscoveryService",
	"EconomyService",
	"ActionService",
	"ZoneService",
	"StealService",
	"SpeedService",
	"NestService",
	"PassService",
	"LuckService",
	"EventService",
	"AdminService",
	"SeasonalService", -- after the map and homes exist
	"DataService",
}

for _, name in SERVICES do
	-- Startup shouldn't wait on anything. Each service starts in its own thread; if one is
	-- still starting after STARTUP_WAIT seconds, say which and carry on, so a stuck service
	-- can never stop players' data loading.
	local done = false
	setStatus("Starting " .. name .. "...")
	task.spawn(function()
		local ok, err = xpcall(function()
			require(Server[name]).init()
		end, debug.traceback)
		done = true
		if not ok then
			warn("[Steal a Life] " .. name .. " failed to start:\n" .. tostring(err))
			table.insert(problems, name .. " failed: " .. tostring(err))
		end
	end)
	local started = os.clock()
	while not done and os.clock() - started < STARTUP_WAIT do
		task.wait()
	end
	if not done then
		warn("[Steal a Life] " .. name .. " is slow to start (still going after " .. STARTUP_WAIT .. "s); carrying on")
	end
end
setStatus("Server started")
print("[Steal a Life] Server started, build " .. require(ReplicatedStorage.Shared.Config).BUILD)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">NestService</string>
          <string name="Source"><![CDATA[-- Eggs growing at home, and hatching them.
--
-- An egg brought home goes into the first free nest (Items.NESTS, two more with the Extra
-- Nests pass) and grows for Items.HATCH_SECONDS of its rarity (half with Fast Hatching).
-- It keeps growing while the player is offline (the end time is saved as os.time()). Once
-- it's ready the owner holds Hatch on its nest: out comes a random item of the egg's kind
-- and rarity (Items.pool), keeping the egg's mutations, which goes straight out on the
-- house, into the pen, onto a yard spot or into a garden bed if it's an upgrade
-- (LifeUtil.placeIfBetter), or into the backpack.
--
-- Also hands out items from the Lucky Wheel and Mystery Boxes (NestService.reward).

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Items = require(ReplicatedStorage.Shared.Items)
local LifeUtil = require(ReplicatedStorage.Shared.LifeUtil)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)
local DiscoveryService = require(script.Parent.DiscoveryService)
local PlotService = require(script.Parent.PlotService)

local NestService = {}

local rng = Random.new()
local notifyRemote = Remotes.get("Notify")
local resultRemote = Remotes.get("LuckResult")

local function notify(player: Player, message: string, kind: string?)
	if player.Parent then
		notifyRemote:FireClient(player, message, kind)
	end
end

-- The first free nest the player can use ("1".."5"), or nil if they're all full.
function NestService.freeNest(player: Player, data): string?
	data.nests = data.nests or {}
	for n = 1, LifeUtil.nestCount(GamePasses.extraNests(player)) do
		if not data.nests[tostring(n)] then
			return tostring(n)
		end
	end
	return nil
end

-- Puts an egg ({ egg = zone, rarity, mutations, weight, baseWeight }) into a free nest,
-- where it grows a random amount (Items.rollGrowth) in random spurts until it hatches.
-- Returns the nest, or nil if there was no room.
function NestService.addEgg(player: Player, record): string?
	local data = DataService.get(player)
	local nest = data and NestService.freeNest(player, data)
	if not nest then
		return nil
	end
	local seconds = math.ceil(Items.HATCH_SECONDS[record.rarity] * GamePasses.hatchMultiplier(player))
	data.nests[nest] = {
		zone = record.egg,
		rarity = record.rarity,
		mutations = Mutations.pack(record.mutations),
		item = record.item,
		weight = record.weight or Items.eggBaseWeight(record.egg),
		baseWeight = record.baseWeight or Items.eggBaseWeight(record.egg),
		growth = Items.rollGrowth(rng),
		seed = rng:NextInteger(1, 1e6),
		startAt = os.time(),
		endsAt = os.time() + seconds,
	}
	DataService.changed(player)
	task.spawn(DataService.save, player)
	return nest
end

-- A random item of a kind and rarity (falling back to the next rarity down if there are
-- none of that rarity).
function NestService.rollItem(kind: string, rarity: string): string
	return Items.rollItem(kind, rarity, rng)
end

-- Adds an item to a player's save and puts it out if it beats what's there. Whatever it
-- replaces goes in the backpack; if the backpack is then over full, the worst extra item is
-- sold. Returns where it went ("house", "pen", "yard", "garden" or "backpack") and the money
-- made selling, if any.
function NestService.give(player: Player, data, record): (string, number)
	local uid = DataService.newUid(data)
	data.parts[uid] = {
		id = record.id,
		mutations = Mutations.pack(record.mutations),
		weight = record.weight,
		baseWeight = record.baseWeight,
	}
	data.discovered[record.id] = true
	task.spawn(DiscoveryService.claim, player, record.id)
	local where = LifeUtil.placeIfBetter(data, uid)
	local sold = 0
	local backpack = LifeUtil.backpack(data)
	while #backpack > GamePasses.backpackSize(player) do
		local worst = table.remove(backpack)
		sold += LifeUtil.sellPrice(data.parts[worst])
		data.parts[worst] = nil
	end
	data.money += sold
	return where, sold
end

-- Gives an item and shows the reveal on the player's screen. reveal = { kind, ... } (what
-- it came from: "egg", "wheel", "crate"); weight / baseWeight = its weight and the normal
-- weight it's measured against (kg).
function NestService.reward(
	player: Player,
	data,
	itemId: string,
	mutations,
	reveal,
	weight: number?,
	baseWeight: number?
)
	local record = { id = itemId, mutations = Mutations.pack(mutations), weight = weight, baseWeight = baseWeight }
	reveal.isNew = not data.discovered[itemId]
	local where, sold = NestService.give(player, data, record)
	reveal.where = where
	reveal.part = record
	reveal.rarity = Items.byId[itemId].rarity
	resultRemote:FireClient(player, reveal)
	if sold > 0 then
		notify(
			player,
			"🎒 Your backpack is full, so the worst item was sold for " .. Format.money(sold) .. ".",
			"money"
		)
	end
	if Rarities.rank[reveal.rarity] >= Rarities.rank.Mystic or Items.weightFactor(record) >= 10 then
		for _, other in Players:GetPlayers() do
			notify(
				other,
				"🐣 "
					.. player.DisplayName
					.. " got a "
					.. (if weight then Format.weight(weight) .. " " else "")
					.. reveal.rarity
					.. " "
					.. LifeUtil.displayName(record)
					.. "!",
				"discovery"
			)
		end
	end
	DataService.changed(player)
	task.spawn(DataService.save, player)
end

-- Hatches the egg in nest n if it's ready. Returns an error message or nil.
function NestService.hatch(player: Player, n: number): string?
	local data = DataService.get(player)
	local key = tostring(n)
	local egg = data and data.nests and data.nests[key]
	if not egg then
		return "That nest is empty."
	end
	if os.time() < egg.endsAt then
		return "It isn't ready yet! " .. Format.time(egg.endsAt - os.time()) .. " to go."
	end
	data.nests[key] = nil
	local zone = Items.ZONES[egg.zone] or Items.ZONES[1]
	-- Eggs from the zones know what's inside (their design shows it); older ones roll now.
	local itemId = if egg.item and Items.byId[egg.item] then egg.item else NestService.rollItem(zone.kind, egg.rarity)
	-- It hatches at its full grown weight.
	local weight = (egg.weight or Items.eggBaseWeight(egg.zone)) * (egg.growth or 1)
	local base = egg.baseWeight or Items.eggBaseWeight(egg.zone)
	NestService.reward(
		player,
		data,
		itemId,
		egg.mutations,
		{ kind = "egg", egg = egg.zone, nest = n, eggFactor = weight / base },
		weight,
		base
	)
	return nil
end

function NestService.init()
	-- So clients can count down nest timers (Items.now).
	ReplicatedStorage:SetAttribute("OsTimeOffset", os.time() - game:GetService("Workspace"):GetServerTimeNow())
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt.Name ~= "HatchPrompt" then
			return
		end
		local plot = PlotService.getPlot(player)
		if not plot or plot.index ~= prompt:GetAttribute("PlotIndex") then
			return notify(player, "That's not your nest!", "error")
		end
		local problem = NestService.hatch(player, prompt:GetAttribute("Nest"))
		if problem then
			notify(player, problem, "error")
		end
	end)
end

return NestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">PassService</string>
          <string name="Source"><![CDATA[-- Checks which game passes each player owns and marks them with "Pass_<key>" attributes.
-- Purchases made in-game take effect right away.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)

local PassService = {}

-- Refreshes income, the house sign and the UI so a pass's perk shows immediately.
local function refresh(player: Player)
	if DataService.get(player) then
		DataService.changed(player)
	end
end

local function grant(player: Player, key: string)
	player:SetAttribute("Pass_" .. key, true)
	refresh(player)
end

local function checkOwnership(player: Player)
	player:SetAttribute("PassesChecked", false)
	for _, key in GamePasses.order do
		local pass = GamePasses.list[key]
		if RunService:IsStudio() and GamePasses.STUDIO_GRANT_ALL then
			grant(player, key)
		elseif pass.id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.id)
			if ok and owns then
				grant(player, key)
			elseif not ok then
				warn("Couldn't check pass", key, "for", player.Name, owns)
			end
		end
	end
	player:SetAttribute("PassesChecked", true)
	refresh(player)
end

function PassService.init()
	Players.PlayerAdded:Connect(checkOwnership)
	for _, player in Players:GetPlayers() do
		task.spawn(checkOwnership, player)
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for _, key in GamePasses.order do
			local pass = GamePasses.list[key]
			if pass.id == passId then
				grant(player, key)
				Remotes.get("Notify"):FireClient(player, "Thanks! " .. pass.name .. " is now active.", "discovery")
			end
		end
	end)
end

return PassService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[-- Builds the town and gives every player a home: a big fenced yard with their house (see
-- shared/HouseModel, made of the house parts in their save), a treadmill, a row of nests
-- for the eggs they bring home, garden beds for their plants, spots for their yard items
-- and a lawn their pets roam round.
--
-- Homes sit in two rows facing the street, four a side. Everything shown comes from the
-- save (LifeUtil): render() rebuilds whatever changed. Pets are drawn by each client (PetFX)
-- from the plot's "Pets" attribute, so they can wander smoothly.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local EggModel = require(ReplicatedStorage.Shared.EggModel)
local HouseModel = require(ReplicatedStorage.Shared.HouseModel)
local ItemModel = require(ReplicatedStorage.Shared.ItemModel)
local Items = require(ReplicatedStorage.Shared.Items)
local LifeUtil = require(ReplicatedStorage.Shared.LifeUtil)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Parts = require(ReplicatedStorage.Shared.Parts)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)
local Decor = require(script.Parent.Decor)

local PLOT_SIZE = 96
local ROW_SPACING = 104 -- between home centres along the street
local ROW_DISTANCE = 80 -- from the middle of the street to each home's centre
local GATE_HALF = HouseModel.GATE_HALF
local FENCE_Z = HouseModel.FENCE_Z
-- In plot space (origin at the yard's centre, the gate at -Z).
local TREADMILL_SPOT = CFrame.new(22, 0, -16)
local NEST_MAX = Items.NESTS + 2 -- with the Extra Nests pass
local NEST_SPOTS = {} -- a row along the front fence, right of the gate
for n = 1, NEST_MAX do
	NEST_SPOTS[n] = Vector3.new(14 + (n - 1) * 6.5, 0, FENCE_Z + 8.5)
end
local BED_SPOTS = {} -- two rows of three, left of the gate
for n = 1, Items.GARDEN_BEDS do
	BED_SPOTS[n] = Vector3.new(-21 - ((n - 1) % 3) * 10, 0, FENCE_Z + 8.5 + ((n - 1) // 3) * 10)
end
local YARD_SPOTS = {
	Vector3.new(38, 0, -16),
	Vector3.new(-37, 0, 14),
	Vector3.new(37, 0, 14),
	Vector3.new(-30, 0, 36),
	Vector3.new(0, 0, 37),
	Vector3.new(30, 0, 36),
}
-- Where pets wander: the front lawn.
local PET_AREA = { min = Vector3.new(-14, 0, FENCE_Z + 12), max = Vector3.new(14, 0, -3) }

local PlotService = {}
PlotService.PLOT_SIZE = PLOT_SIZE
PlotService.ROW_DISTANCE = ROW_DISTANCE
PlotService.NEST_MAX = NEST_MAX
PlotService.PET_AREA = PET_AREA

local plots = {}
local plotOf = {} -- [Player] = plot

local OUTLINE = Color3.fromRGB(20, 22, 48)

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		p[key] = value
	end
	return p
end

local function billboard(parent: Instance, size: UDim2, offset: Vector3, maxDistance: number): (BillboardGui, TextLabel)
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffset = offset
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = OUTLINE
	stroke.Thickness = 3
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	gui.Parent = parent
	return gui, label
end

-- Each home gets its own accent colour for its gate and sign.
local ACCENTS = {
	Color3.fromRGB(255, 110, 170),
	Color3.fromRGB(90, 200, 255),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(150, 110, 255),
	Color3.fromRGB(90, 220, 130),
	Color3.fromRGB(255, 140, 70),
	Color3.fromRGB(80, 230, 220),
	Color3.fromRGB(255, 90, 90),
}

--------------------------------------------------------------------------------
-- Building a home
--------------------------------------------------------------------------------

-- The gate: two chunky posts with a beam and the owner's sign.
local function buildGate(plot, folder: Instance)
	local origin = plot.origin
	local accent = plot.accent
	local postHeight = 12
	for _, side in { -1, 1 } do
		local spot = origin * CFrame.new(side * (GATE_HALF + 1), 0, FENCE_Z)
		part({
			Name = "GatePost",
			Size = Vector3.new(2.4, postHeight, 2.4),
			CFrame = spot * CFrame.new(0, postHeight / 2, 0),
			Color = Color3.fromRGB(250, 248, 240),
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
		part({
			Name = "GatePostCap",
			Size = Vector3.new(3, 1, 3),
			CFrame = spot * CFrame.new(0, postHeight + 0.5, 0),
			Color = accent,
			Parent = folder,
		})
		local ball = part({
			Name = "GatePostBall",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 2,
			CFrame = spot * CFrame.new(0, postHeight + 2, 0),
			Color = accent,
			Material = Enum.Material.Neon,
			Parent = folder,
		})
		ball.CanCollide = false
	end
	-- The beam with the name board.
	part({
		Name = "GateBeam",
		Size = Vector3.new(GATE_HALF * 2 + 4.8, 1.6, 1.6),
		CFrame = origin * CFrame.new(0, postHeight - 1, FENCE_Z),
		Color = accent,
		Parent = folder,
	})
	local board = part({
		Name = "NameBoard",
		Size = Vector3.new(GATE_HALF * 2 - 1, 3.6, 0.6),
		CFrame = origin * CFrame.new(0, postHeight + 1.6, FENCE_Z),
		Color = Color3.fromRGB(255, 250, 235),
		Parent = folder,
	})
	-- A dark frame round the board (four bars, so nothing overlaps the board's faces).
	local boardW, boardH = GATE_HALF * 2 - 1, 3.6
	for _, bar in
		{
			{ Vector3.new(boardW + 0.8, 0.4, 0.8), Vector3.new(0, boardH / 2 + 0.2, 0) },
			{ Vector3.new(boardW + 0.8, 0.4, 0.8), Vector3.new(0, -boardH / 2 - 0.2, 0) },
			{ Vector3.new(0.4, boardH, 0.8), Vector3.new(boardW / 2 + 0.2, 0, 0) },
			{ Vector3.new(0.4, boardH, 0.8), Vector3.new(-boardW / 2 - 0.2, 0, 0) },
		}
	do
		part({
			Name = "SignFrame",
			Size = bar[1],
			CFrame = origin * CFrame.new(0, postHeight + 1.6, FENCE_Z) * CFrame.new(bar[2]),
			Color = OUTLINE,
			Parent = folder,
		})
	end
	-- The owner's name on both sides: the street side and the yard side.
	plot.signLabels = {}
	for _, faceId in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local sign = Instance.new("SurfaceGui")
		sign.Face = faceId
		sign.CanvasSize = Vector2.new(600, 140)
		sign.LightInfluence = 0
		sign.Parent = board
		local name = Instance.new("TextLabel")
		name.BackgroundTransparency = 1
		name.Size = UDim2.fromScale(0.94, 0.9)
		name.Position = UDim2.fromScale(0.03, 0.05)
		name.TextScaled = true
		name.Font = Enum.Font.LuckiestGuy
		name.TextColor3 = accent
		name.Text = "EMPTY HOME"
		name.Parent = sign
		local stroke = Instance.new("UIStroke")
		stroke.Color = OUTLINE
		stroke.Thickness = 5
		stroke.Parent = name
		table.insert(plot.signLabels, name)
	end

	-- Floating text over the gate: what the home earns.
	local gateGui = part({
		Name = "GateText",
		Size = Vector3.one,
		CFrame = origin * CFrame.new(0, postHeight + 7, FENCE_Z),
		Transparency = 1,
		CanCollide = false,
		Parent = folder,
	})
	local _, income = billboard(gateGui, UDim2.fromScale(14, 2.4), Vector3.new(0, 1, 0), 160)
	income.TextColor3 = Color3.fromRGB(110, 235, 140)
	income.Font = Enum.Font.LuckiestGuy
	plot.incomeLabel = income
end

-- The treadmill: run on the belt to train Speed (SpeedService). The belt pushes you back so
-- you stay on it while you run.
local function buildTreadmill(plot, folder: Instance)
	local spot = plot.origin * TREADMILL_SPOT
	local model = Instance.new("Model")
	model.Name = "Treadmill"
	model.Parent = folder
	local frameColor = Color3.fromRGB(60, 62, 75)
	part({
		Name = "Frame",
		Size = Vector3.new(7, 1, 14),
		CFrame = spot * CFrame.new(0, 0.5, 0),
		Color = frameColor,
		Material = Enum.Material.Metal,
		Parent = model,
	})
	local belt = part({
		Name = "Belt",
		Size = Vector3.new(5.6, 0.3, 12),
		CFrame = spot * CFrame.new(0, 1.12, 0.6),
		Color = Color3.fromRGB(30, 30, 36),
		Material = Enum.Material.Rubber,
		Parent = model,
	})
	-- Pushes anyone standing on it back toward the house (they run toward the street).
	belt.AssemblyLinearVelocity = spot:VectorToWorldSpace(Vector3.new(0, 0, 9))
	for _, x in { -3.2, 3.2 } do
		part({
			Name = "Rail",
			Size = Vector3.new(0.6, 0.6, 13),
			CFrame = spot * CFrame.new(x, 1.3, 0.3),
			Color = plot.accent,
			Parent = model,
		})
		-- Handle posts at the front.
		part({
			Name = "HandlePost",
			Size = Vector3.new(0.5, 4.6, 0.5),
			CFrame = spot * CFrame.new(x, 3.3, -5.6),
			Color = frameColor,
			Material = Enum.Material.Metal,
			Parent = model,
		})
	end
	part({
		Name = "Handlebar",
		Size = Vector3.new(6.9, 0.5, 0.5),
		CFrame = spot * CFrame.new(0, 4.6, -5.6),
		Color = plot.accent,
		Parent = model,
	})
	-- The console with a screen showing what you're earning.
	local console = part({
		Name = "Console",
		Size = Vector3.new(5, 2.4, 0.8),
		CFrame = spot * CFrame.new(0, 6.2, -6) * CFrame.Angles(math.rad(20), 0, 0),
		Color = frameColor,
		Material = Enum.Material.Metal,
		Parent = model,
	})
	local screen = part({
		Name = "Screen",
		Size = Vector3.new(4.4, 1.9, 0.2),
		CFrame = console.CFrame * CFrame.new(0, 0, 0.42),
		Color = Color3.fromRGB(20, 30, 50),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.CanvasSize = Vector2.new(300, 130)
	gui.LightInfluence = 0
	gui.Parent = screen
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.TextColor3 = Color3.fromRGB(110, 235, 255)
	label.Text = "TREADMILL"
	label.Parent = gui
	plot.treadmillLabel = label
	-- A sign over it so new players know what it's for.
	local signPart = part({
		Name = "TreadmillSign",
		Size = Vector3.one,
		CFrame = spot * CFrame.new(0, 9, -2),
		Transparency = 1,
		CanCollide = false,
		Parent = model,
	})
	local _, sign = billboard(signPart, UDim2.fromScale(6.5, 1.4), Vector3.zero, 60)
	sign.Font = Enum.Font.LuckiestGuy
	sign.Text = "⚡ TRAIN SPEED"
	sign.TextColor3 = Color3.fromRGB(255, 225, 80)
	plot.treadmill = { belt = belt, spot = spot }
end

-- The yard: lawn, a stone path from the gate to the porch.
local function buildYard(plot, folder: Instance)
	local origin = plot.origin
	-- A lighter green checkerboard lawn, a little raised off the town baseplate.
	Decor.checkerFloor(
		folder,
		origin * CFrame.new(0, 0.4, 0),
		PLOT_SIZE,
		PLOT_SIZE,
		12,
		Color3.fromRGB(125, 222, 95),
		Color3.fromRGB(105, 205, 82),
		"Lawn"
	)
	local from, to = FENCE_Z + 1, HouseModel.HOUSE_Z - 6
	local count = math.floor((to - from) / 3)
	for i = 0, count do
		part({
			Name = "PathStone",
			Size = Vector3.new(5 + (i % 2) * 0.8, 0.3, 2.4),
			CFrame = origin
				* CFrame.new((i % 2 - 0.5) * 0.6, 0.45, from + i * 3)
				* CFrame.Angles(0, math.rad((i % 3 - 1) * 4), 0),
			Color = Color3.fromRGB(215, 210, 200),
			Material = Enum.Material.Slate,
			CanCollide = false,
			Parent = folder,
		})
	end
end

-- The nests: a straw nest on a little stand for each egg, with floating text showing what's
-- in it and how long it has left, and a Hatch prompt once it's ready (NestService).
local function buildNests(plot, folder: Instance)
	local model = Instance.new("Model")
	model.Name = "Nests"
	model.Parent = folder
	plot.nests = {}
	for n, spot in NEST_SPOTS do
		local cf = plot.origin * CFrame.new(spot)
		local base = part({
			Name = "NestStand",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.4, 5, 5),
			CFrame = cf * CFrame.new(0, 1.1, 0) * CFrame.Angles(0, 0, math.pi / 2),
			Color = plot.accent:Lerp(Color3.new(1, 1, 1), 0.35),
			Parent = model,
		})
		-- A ring of straw bricks.
		for k = 0, 9 do
			local a = k / 10 * math.pi * 2
			part({
				Name = "Straw",
				Size = Vector3.new(1.5, 0.8, 0.9),
				CFrame = cf
					* CFrame.new(math.cos(a) * 1.9, 2.1 + (k % 2) * 0.15, math.sin(a) * 1.9)
					* CFrame.Angles(0, -a + math.pi / 2, math.rad((k % 3 - 1) * 8)),
				Color = if k % 2 == 0 then Color3.fromRGB(230, 185, 90) else Color3.fromRGB(205, 155, 70),
				CanCollide = false,
				Parent = model,
			})
		end
		part({
			Name = "Straw",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 3.6, 3.6),
			CFrame = cf * CFrame.new(0, 1.9, 0) * CFrame.Angles(0, 0, math.pi / 2),
			Color = Color3.fromRGB(190, 140, 65),
			CanCollide = false,
			Parent = model,
		})
		-- Narrower than the gap between nests, so neighbouring labels never overlap.
		local gui, title = billboard(base, UDim2.fromScale(5, 2), Vector3.new(0, 5.8, 0), 55)
		title.Size = UDim2.fromScale(1, 0.5)
		title.Font = Enum.Font.LuckiestGuy
		local timer = title:Clone()
		timer.Position = UDim2.fromScale(0, 0.5)
		timer.Font = Enum.Font.FredokaOne
		timer.Parent = gui
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "HatchPrompt"
		prompt.ActionText = "Hatch"
		prompt.ObjectText = "Egg"
		prompt.HoldDuration = 0.5
		prompt.MaxActivationDistance = 9
		prompt.RequiresLineOfSight = false
		prompt.Enabled = false
		prompt:SetAttribute("PlotIndex", plot.index)
		prompt:SetAttribute("Nest", n)
		prompt.Parent = base
		plot.nests[n] = {
			spot = cf * CFrame.new(0, 2.05, 0),
			title = title,
			timer = timer,
			prompt = prompt,
			egg = nil,
			key = nil,
		}
	end
end

-- Garden beds (soil in a plank rim) and yard spots (paving squares) where plants and yard
-- items go.
local function buildBeds(plot, folder: Instance)
	local model = Instance.new("Model")
	model.Name = "Garden"
	model.Parent = folder
	plot.beds = {}
	for n, spot in BED_SPOTS do
		local cf = plot.origin * CFrame.new(spot)
		part({
			Name = "Soil",
			Size = Vector3.new(7, 0.8, 7),
			CFrame = cf * CFrame.new(0, 0.6, 0),
			Color = Color3.fromRGB(120, 80, 50),
			Parent = model,
		})
		for k = 0, 3 do
			part({
				Name = "BedRim",
				Size = Vector3.new(8.2, 1.2, 0.6),
				CFrame = cf * CFrame.Angles(0, k * math.pi / 2, 0) * CFrame.new(0, 0.8, 3.8),
				Color = Color3.fromRGB(200, 140, 80),
				Parent = model,
			})
		end
		plot.beds[n] = { spot = cf * CFrame.new(0, 1, 0), model = nil, key = nil }
	end
	plot.spots = {}
	for n, spot in YARD_SPOTS do
		local cf = plot.origin * CFrame.new(spot)
		part({
			Name = "Pad",
			Size = Vector3.new(12, 0.3, 12),
			CFrame = cf * CFrame.new(0, 0.55, 0),
			Color = Color3.fromRGB(235, 230, 220),
			Parent = model,
		})
		for k = 0, 3 do
			part({
				Name = "PadRim",
				Size = Vector3.new(12.6, 0.5, 0.6),
				CFrame = cf * CFrame.Angles(0, k * math.pi / 2, 0) * CFrame.new(0, 0.6, 6),
				Color = plot.accent,
				Parent = model,
			})
		end
		-- Items at the back face the house; the rest face the street.
		local facing = if spot.Z > 30 then CFrame.Angles(0, math.pi, 0) else CFrame.identity
		plot.spots[n] = { spot = cf * CFrame.new(0, 0.7, 0) * facing, model = nil, key = nil }
	end
end

local function buildPlot(index: number)
	-- Homes 1-4 sit north of the street, 5-8 south, in rows along it.
	local perSide = Config.PLOT_COUNT // 2
	local rowSide = if index <= perSide then -1 else 1
	local rowX = ((index - 1) % perSide - (perSide - 1) / 2) * ROW_SPACING
	local center = Vector3.new(rowX, 0, rowSide * ROW_DISTANCE)
	-- Local -Z (the plot's front, with the gate) faces the street.
	local origin = CFrame.lookAt(center, Vector3.new(rowX, 0, 0))

	local folder = Instance.new("Model")
	folder.Name = "Plot" .. index
	folder:SetAttribute("Origin", origin)
	folder:SetAttribute("Size", PLOT_SIZE)
	folder:SetAttribute("PetMin", PET_AREA.min)
	folder:SetAttribute("PetMax", PET_AREA.max)
	folder.Parent = Workspace:WaitForChild("Plots")

	local plot = {
		index = index,
		origin = origin,
		accent = ACCENTS[(index - 1) % #ACCENTS + 1],
		spawn = origin * CFrame.new(0, 3, FENCE_Z + 7) * CFrame.Angles(0, math.pi, 0),
		folder = folder,
		owner = nil,
	}
	buildYard(plot, folder)
	buildGate(plot, folder)
	buildTreadmill(plot, folder)
	buildNests(plot, folder)
	buildBeds(plot, folder)

	local house = Instance.new("Model")
	house.Name = "House"
	house.Parent = folder
	plot.house = house
	local items = Instance.new("Model")
	items.Name = "Items"
	items.Parent = folder
	plot.items = items

	plots[index] = plot
	return plot
end

-- Rebuilds any house slot whose part changed.
local function updateHouse(plot, layout)
	for _, slot in Parts.SLOTS do
		local partId = layout[slot.id] or Parts.basic(slot.id)
		local current = plot.house:FindFirstChild(slot.id)
		if not current or current:GetAttribute("Part") ~= partId then
			if current then
				current:Destroy()
			end
			local model = HouseModel.slot(slot.id, partId)
			model:PivotTo(plot.origin * model:GetPivot())
			model.Parent = plot.house
		end
	end
end

-- Puts the right item model on a bed or yard spot (record = nil for none).
local function updateSpot(plot, spot, record)
	local key = record
		and (
			record.id
			.. ":"
			.. table.concat(Mutations.normalize(record.mutations), ",")
			.. ":"
			.. tostring(record.weight)
		)
	if spot.key == key then
		return
	end
	spot.key = key
	if spot.model then
		spot.model:Destroy()
		spot.model = nil
	end
	if record then
		local model = ItemModel.build(record)
		model:PivotTo(spot.spot)
		model.Parent = plot.items
		spot.model = model
	end
end

-- What a nest shows: "locked", "empty" or its egg.
local function nestState(data, player: Player, n: number)
	if n > LifeUtil.nestCount(GamePasses.extraNests(player)) then
		return "locked", nil
	end
	local egg = data.nests and data.nests[tostring(n)]
	if not egg then
		return "empty", nil
	end
	return "egg", egg
end

-- The floating text over each nest (counts down every half second).
local function updateNestLabels(plot)
	local player = plot.owner
	local data = player and DataService.get(player)
	local now = os.time()
	for n, nest in plot.nests do
		local state, egg = "unowned", nil
		if data then
			state, egg = nestState(data, player, n)
		end
		nest.prompt.Enabled = false
		if state == "unowned" then
			nest.title.Text = ""
			nest.timer.Text = ""
		elseif state == "locked" then
			nest.title.Text = "🔒 LOCKED"
			nest.title.TextColor3 = Color3.fromRGB(190, 190, 205)
			nest.timer.Text = "Extra Nests"
			nest.timer.TextColor3 = Color3.fromRGB(190, 190, 205)
		elseif state == "empty" then
			nest.title.Text = "EMPTY"
			nest.title.TextColor3 = Color3.new(1, 1, 1)
			nest.timer.Text = "Steal an egg!"
			nest.timer.TextColor3 = Color3.fromRGB(255, 215, 60)
		else
			nest.title.Text = string.upper(egg.rarity)
			nest.title.TextColor3 = Rarities.info[egg.rarity].color
			-- The egg grows while it waits: the weight climbs and the egg gets bigger.
			local weight = Items.eggWeightAt(egg, now)
			local scale = Items.weightScale(weight / (egg.baseWeight or weight))
			if nest.egg and nest.eggScale and math.abs(scale / nest.eggScale - 1) > 0.01 then
				Items.scaleModel(nest.egg, scale / nest.eggScale)
				nest.egg:PivotTo(nest.spot)
				nest.eggScale = scale
			end
			local left = egg.endsAt - now
			if left > 0 then
				nest.timer.Text = "⚖ " .. Format.weight(weight) .. " · " .. Format.time(left)
				nest.timer.TextColor3 = Color3.new(1, 1, 1)
			else
				nest.timer.Text = "🐣 " .. Format.weight(weight) .. " READY!"
				nest.timer.TextColor3 = Color3.fromRGB(110, 235, 140)
				nest.prompt.ObjectText = Items.itemEggName(egg.zone, egg.item)
				nest.prompt.Enabled = true
			end
		end
	end
end

local function updateNests(plot, data, player: Player?)
	for n, nest in plot.nests do
		local state, egg = "unowned", nil
		if data and player then
			state, egg = nestState(data, player, n)
		end
		local key = if egg then egg.zone .. ":" .. egg.rarity .. ":" .. egg.endsAt else state
		if nest.key ~= key then
			nest.key = key
			if nest.egg then
				nest.egg:Destroy()
				nest.egg = nil
			end
			if egg then
				local model = EggModel.build(egg.zone, egg.item)
				local weight = Items.eggWeightAt(egg, os.time())
				local scale = Items.weightScale(weight / (egg.baseWeight or weight))
				Items.scaleModel(model, scale)
				ItemModel.addMutationEffect(model, egg.mutations)
				model:PivotTo(nest.spot)
				model.Parent = plot.items
				nest.egg = model
				nest.eggScale = scale
			end
		end
	end
	updateNestLabels(plot)
end

-- The pets out in the yard, for the clients to draw, with their mutation, weight (kg) and
-- how big to draw them: "Pet_Oinkle:Golden:4.21:1.62,Pet_Woofles::0.88:0.93".
local function petList(data): string
	local list = {}
	for _, uid in LifeUtil.pets(data) do
		local record = data.parts[uid]
		table.insert(
			list,
			string.format(
				"%s:%s:%s:%.3f",
				record.id,
				Mutations.top(record.mutations) or "",
				if record.weight then string.format("%.2f", record.weight) else "",
				Items.weightScale(Items.weightFactor(record))
			)
		)
	end
	return table.concat(list, ",")
end

function PlotService.render(player: Player)
	local plot = plotOf[player]
	local data = DataService.get(player)
	if not plot or not data then
		return
	end
	updateHouse(plot, LifeUtil.layout(data))
	for n, bed in plot.beds do
		local uid = data.garden and data.garden[tostring(n)]
		updateSpot(plot, bed, uid and data.parts[uid])
	end
	for n, spot in plot.spots do
		local uid = data.yard and data.yard[tostring(n)]
		updateSpot(plot, spot, uid and data.parts[uid])
	end
	updateNests(plot, data, player)
	plot.folder:SetAttribute("Pets", petList(data))
	for _, label in plot.signLabels do
		label.Text = string.upper(player.DisplayName) .. "'S LIFE"
	end
	local income = LifeUtil.totalIncome(data) * GamePasses.coinMultiplier(player)
	plot.incomeLabel.Text = Format.money(income) .. "/s"
	local gain = Config.treadmillGain(data.treadmill) * GamePasses.speedMultiplier(player)
	plot.treadmillLabel.Text = "LV " .. data.treadmill .. "  +" .. Format.number(gain) .. " ⚡/s"
end

local function clearPlot(plot)
	plot.owner = nil
	updateHouse(plot, {})
	for _, spot in plot.beds do
		updateSpot(plot, spot, nil)
	end
	for _, spot in plot.spots do
		updateSpot(plot, spot, nil)
	end
	updateNests(plot, nil, nil)
	plot.folder:SetAttribute("Pets", "")
	for _, label in plot.signLabels do
		label.Text = "EMPTY HOME"
	end
	plot.incomeLabel.Text = ""
	plot.treadmillLabel.Text = "TREADMILL"
end

function PlotService.sendHome(player: Player)
	local plot = plotOf[player]
	local character = player.Character
	if plot and character then
		character:PivotTo(plot.spawn)
	end
end

local function onPlayerAdded(player: Player)
	for _, plot in plots do
		if not plot.owner then
			plot.owner = player
			plotOf[player] = plot
			player:SetAttribute("Plot", plot.index)
			player.CharacterAdded:Connect(function()
				task.wait(0.1)
				PlotService.sendHome(player)
			end)
			PlotService.sendHome(player)
			PlotService.render(player)
			return
		end
	end
	Remotes.get("Notify"):FireClient(player, "This server is full! Try another server.", "error")
end

-- Every home's origin (gate faces -Z), for scenery that decorates all homes.
function PlotService.origins(): { CFrame }
	local list = {}
	for _, plot in plots do
		table.insert(list, plot.origin)
	end
	return list
end

function PlotService.getPlot(player: Player)
	return plotOf[player]
end

function PlotService.plotByIndex(index: number)
	return plots[index]
end

-- The home whose yard this position is in (nil if none).
function PlotService.plotAt(position: Vector3)
	for _, plot in plots do
		if PlotService.isInside(plot, position) then
			return plot
		end
	end
	return nil
end

-- True if a world position is inside a home's yard.
function PlotService.isInside(plot, position: Vector3): boolean
	local localPos = plot.origin:PointToObjectSpace(position)
	local limit = PLOT_SIZE / 2 - 0.5
	return math.abs(localPos.X) < limit and math.abs(localPos.Z) < limit
end

-- True if a position is standing on the home's treadmill belt.
function PlotService.onTreadmill(plot, position: Vector3): boolean
	local localPos = plot.treadmill.belt.CFrame:PointToObjectSpace(position)
	return math.abs(localPos.X) < 3 and math.abs(localPos.Z) < 6.2 and localPos.Y > -1 and localPos.Y < 6
end

-- Where a slot's part is on the home (for effects).
function PlotService.slotPosition(plot, slotId: string): Vector3
	return (plot.origin * CFrame.new(HouseModel.ANCHORS[slotId])).Position
end

-- Where nest n is (world space, for effects).
function PlotService.nestPosition(plot, n: number): Vector3
	return plot.nests[n].spot.Position
end

-- Looks straight down at a few spots in every yard for anything covering the lawn (a
-- place's own terrain or parts). Terrain is cleared; anything else is reported in Output
-- and on the ReplicatedStorage attribute GroundProblems, so it can be tracked down.
local GROUND_SPOTS = {
	Vector3.new(22, 0, -16),
	Vector3.new(0, 0, -30),
	Vector3.new(-30, 0, -30),
	Vector3.new(30, 0, -38),
	Vector3.new(38, 0, -16),
}
local function checkGround()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = {}
	for _, plot in plots do
		table.insert(exclude, plot.folder)
	end
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(exclude, player.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	local problems = {}
	for _, plot in plots do
		for _, spot in GROUND_SPOTS do
			local from = plot.origin:PointToWorldSpace(spot + Vector3.new(0, 80, 0))
			local hit = Workspace:Raycast(from, Vector3.new(0, -100, 0), params)
			if hit and hit.Position.Y > 0.5 then
				if hit.Instance:IsA("Terrain") then
					pcall(function()
						Workspace.Terrain:FillBlock(
							plot.origin * CFrame.new(0, 30, 0),
							Vector3.new(PLOT_SIZE + 8, 84, PLOT_SIZE + 8),
							Enum.Material.Air
						)
					end)
					table.insert(problems, "terrain over yard " .. plot.index .. " (cleared)")
				else
					table.insert(
						problems,
						string.format(
							"%s over yard %d at y=%.1f",
							hit.Instance:GetFullName(),
							plot.index,
							hit.Position.Y
						)
					)
				end
				break
			end
		end
	end
	if #problems > 0 then
		warn("[PlotService] Something covers the yards: " .. table.concat(problems, "; "))
	end
	ReplicatedStorage:SetAttribute("GroundProblems", if #problems > 0 then table.concat(problems, "; ") else nil)
end

function PlotService.init()
	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = Workspace
	for i = 1, Config.PLOT_COUNT do
		clearPlot(buildPlot(i))
	end
	-- Once the rest of the map is built.
	for _, delay in { 5, 20 } do
		task.delay(delay, function()
			local ok, err = pcall(checkGround)
			if not ok then
				warn("[PlotService] ground check failed: " .. tostring(err))
			end
		end)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local plot = plotOf[player]
		if plot then
			clearPlot(plot)
		end
		plotOf[player] = nil
	end)

	DataService.onChanged(function(player)
		PlotService.render(player)
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, plot in plots do
				if plot.owner then
					local ok, err = pcall(updateNestLabels, plot)
					if not ok then
						warn("[PlotService] " .. tostring(err))
					end
				end
			end
		end
	end)
end

return PlotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">SeasonalService</string>
          <string name="Source"><![CDATA[-- Seasonal themes: while an event is running, the map dresses up for it (recoloured
-- trees, props, lighting) and goes back to normal when the event ends. Checked every two
-- minutes, so themes switch on and off without restarting servers.
--
-- To add a theme for another event, add an entry to THEMES keyed by its Seasons id.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local HouseModel = require(ReplicatedStorage.Shared.HouseModel)
local Seasons = require(ReplicatedStorage.Shared.Seasons)

local Decor = require(script.Parent.Decor)
local HalloweenDecor = require(script.Parent.HalloweenDecor)
local PlotService = require(script.Parent.PlotService)

local SeasonalService = {}

local current = nil -- id of the theme on show, or nil
local folder = nil -- props added by the current theme
local defaults = {} -- lighting/terrain values to restore

-- Pick a colour from a palette based on a part's position, so it's stable but varied.
local function pick(palette, part: BasePart)
	local p = part.Position
	local index = math.floor(math.abs(p.X * 7 + p.Y * 13 + p.Z * 3)) % #palette + 1
	return palette[index]
end

local function facingSquare(position: Vector3): CFrame
	return CFrame.lookAt(position, Vector3.new(position.X, position.Y, 0))
end

local THEMES = {}

THEMES.Halloween = {
	leaves = Decor.FALL_LEAVES,
	grass = Color3.fromRGB(150, 165, 75),
	lawn = Color3.fromRGB(150, 170, 80),
	bulb = Color3.fromRGB(255, 140, 40),
	-- Spooky twilight: sun on the horizon, purple haze, extra glow on lights and pumpkins.
	lighting = {
		Lighting = {
			ClockTime = 18.1,
			Brightness = 1.8,
			Ambient = Color3.fromRGB(80, 60, 100),
			OutdoorAmbient = Color3.fromRGB(135, 110, 160),
		},
		Atmosphere = {
			Density = 0.36,
			Color = Color3.fromRGB(190, 130, 190),
			Decay = Color3.fromRGB(70, 35, 90),
			Haze = 2.2,
			Glare = 0.4,
		},
		ColorCorrectionEffect = {
			TintColor = Color3.fromRGB(255, 228, 240),
			Saturation = 0.25,
			Contrast = 0.12,
		},
		BloomEffect = { Intensity = 0.9 },
	},
	build = function(props: Folder)
		local gateHalf, fenceZ = HouseModel.GATE_HALF, HouseModel.FENCE_Z
		-- Every home: jack-o'-lanterns flanking the gate and either side of the path, cobwebs
		-- on the gate posts, and a pile of leaves behind the house. (Spots kept clear of the
		-- nests, beds, yard spots and treadmill: see PlotService.)
		for i, origin in PlotService.origins() do
			for _, side in { -1, 1 } do
				Decor.pumpkin(props, origin * CFrame.new(side * (gateHalf + 4), 0.4, fenceZ - 2.5), 1)
				Decor.pumpkin(props, origin * CFrame.new(side * 6, 0.4, fenceZ + 5) * CFrame.Angles(0, math.pi, 0), 0.8)
				Decor.leafPile(props, origin * CFrame.new(side * 16, 0.4, 28), i * 10 + side)
				HalloweenDecor.cobweb(
					props,
					origin
						* CFrame.new(side * gateHalf, 10.2, fenceZ - 0.8)
						* CFrame.Angles(0, if side > 0 then math.pi else 0, 0),
					3
				)
			end
		end
		-- Pumpkins along both sidewalks, facing the road.
		for x = -182, 182, 52 do
			for _, z in { -14, 14 } do
				Decor.pumpkin(props, facingSquare(Vector3.new(x, 0.5, z)), 0.9)
			end
		end
		-- Hay bales topped with pumpkins by the spawn and the Mystery Box stand.
		for _, spot in
			{
				Vector3.new(176, 0, -24),
				Vector3.new(176, 0, 24),
				Vector3.new(212, 0, -24),
				Vector3.new(212, 0, 24),
			}
		do
			local ground = facingSquare(spot)
			Decor.hayBale(props, ground)
			Decor.pumpkin(props, ground * CFrame.new(0, 2.4, 0), 0.8)
		end
		-- Jack-o'-lanterns flanking the Mystery Box stand.
		for _, z in { -21, 21 } do
			Decor.pumpkin(props, CFrame.new(190, 0, z) * CFrame.Angles(0, math.pi / 2, 0), 1.4)
		end
		-- Leaf piles along the hedges at the back of the town.
		for x = -190, 170, 38 do
			for _, z in { -129, 129 } do
				Decor.leafPile(props, CFrame.new(x, 0, z), x + z)
			end
		end

		-- String lights between the street lamps on both sidewalks, and low fog on the road.
		for x = -208, 156, 52 do
			for _, z in { -17.5, 17.5 } do
				HalloweenDecor.stringLights(props, Vector3.new(x, 7.6, z), Vector3.new(x + 52, 7.6, z), 18, 3)
			end
		end
		for x = -180, 160, 40 do
			HalloweenDecor.fog(props, Vector3.new(x, 0.5, 0))
		end

		-- A little graveyard by the way into the zones (in the strip between the last home and
		-- the zones' wall), with dead trees and a cauldron.
		for row = 0, 2 do
			for col = 0, 2 do
				local ground = CFrame.new(-225 + col * 6, 0, 34 + row * 8) * CFrame.Angles(0, -math.pi / 2, 0)
				HalloweenDecor.tombstone(props, ground, row * 10 + col)
			end
		end
		HalloweenDecor.deadTree(props, CFrame.new(-218, 0, -26), 1.2, 3)
		HalloweenDecor.deadTree(props, CFrame.new(-218, 0, 26), 1.1, 4)
		HalloweenDecor.deadTree(props, CFrame.new(220, 0, -26), 1.2, 1)
		HalloweenDecor.cauldron(props, CFrame.new(-216, 0, 64))

		-- Ghosts drifting over the street; bats circling the title and the spawn.
		for i, x in { -105, -35, 35, 105 } do
			HalloweenDecor.ghost(props, Vector3.new(x, 0, 0), 16, 14, if i % 2 == 0 then 0.18 else -0.18, i)
		end
		HalloweenDecor.ghost(props, Vector3.new(-216, 0, 46), 14, 9, 0.3, 1)
		for i = 1, 4 do
			HalloweenDecor.bat(props, Vector3.new(170, 0, 0), 10 + i * 2, 14 + i, -0.7, i * 1.5)
		end
		for i = 1, 6 do
			HalloweenDecor.bat(props, Vector3.zero, 22 + i * 3, 30 + i, 0.5, i * 1.6)
		end
	end,
}

local function recolour(tag: string, palette)
	for _, part in CollectionService:GetTagged(tag) do
		if palette == nil then
			part.Color = part:GetAttribute("BaseColor") or part.Color
		elseif typeof(palette) == "Color3" then
			part.Color = palette
		else
			part.Color = pick(palette, part)
		end
	end
end

local function setLamps(color: Color3?)
	for _, bulb in CollectionService:GetTagged(Decor.TAGS.bulb) do
		bulb.Color = color or bulb:GetAttribute("BaseColor") or bulb.Color
		local light = bulb:FindFirstChildOfClass("PointLight")
		if light then
			light.Color = color or bulb.Color
		end
	end
end

local function captureDefaults()
	defaults = { grass = Workspace.Terrain:GetMaterialColor(Enum.Material.Grass) }
end

-- Applies a theme's lighting ({ ClassName = { Property = value } }, where "Lighting" is the
-- Lighting service itself) and remembers the old values so clearTheme can put them back.
local saved = {}
local function applyLighting(settings)
	for className, props in settings or {} do
		local target = if className == "Lighting" then Lighting else Lighting:FindFirstChildOfClass(className)
		if target then
			saved[target] = saved[target] or {}
			for key, value in props do
				if saved[target][key] == nil then
					saved[target][key] = target[key]
				end
				target[key] = value
			end
		end
	end
end

local function restoreLighting()
	for target, props in saved do
		for key, value in props do
			target[key] = value
		end
	end
	table.clear(saved)
end

local function clearTheme()
	if folder then
		folder:Destroy()
		folder = nil
	end
	recolour(Decor.TAGS.leaves, nil)
	recolour(Decor.TAGS.lawn, nil)
	setLamps(nil)
	restoreLighting()
	Workspace.Terrain:SetMaterialColor(Enum.Material.Grass, defaults.grass)
	current = nil
end

local function applyTheme(id: string)
	local theme = THEMES[id]
	folder = Instance.new("Folder")
	folder.Name = "Seasonal_" .. id
	folder.Parent = Workspace
	theme.build(folder)
	recolour(Decor.TAGS.leaves, theme.leaves)
	recolour(Decor.TAGS.lawn, theme.lawn)
	setLamps(theme.bulb)
	applyLighting(theme.lighting)
	Workspace.Terrain:SetMaterialColor(Enum.Material.Grass, theme.grass)
	current = id
end

local function update()
	local wanted = nil
	for _, id in Seasons.active() do
		if THEMES[id] then
			wanted = id
			break
		end
	end
	if wanted == current then
		return
	end
	if current then
		clearTheme()
	end
	if wanted then
		applyTheme(wanted)
	end
end

function SeasonalService.init()
	captureDefaults()
	update()
	task.spawn(function()
		while true do
			task.wait(120)
			update()
		end
	end)
end

return SeasonalService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">SpeedService</string>
          <string name="Source"><![CDATA[-- Speed: trained on your treadmill, it decides how fast you run (Items.walkSpeed), which
-- decides which zones' guardians you can outrun.
--
-- Step onto your own treadmill and you run on it by yourself (client TreadmillRun) and your
-- Speed goes up every second by the treadmill's gain (Config.treadmillGain), times pass
-- bonuses. The belt runs as fast as you do, so you stay on it. Carrying an egg
-- slows you a little (GamePasses.carrySlowdown).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Items = require(ReplicatedStorage.Shared.Items)

local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local StealService = require(script.Parent.StealService)

local SpeedService = {}

local TICK = 0.2

-- Speed a second this player gets from running on their treadmill.
function SpeedService.gain(player: Player, data): number
	return Config.treadmillGain(data.treadmill) * GamePasses.speedMultiplier(player)
end

local function update(player: Player, data)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	local plot = PlotService.getPlot(player)
	local training = false
	if plot and PlotService.onTreadmill(plot, root.Position) then
		training = true
		data.speed += SpeedService.gain(player, data) * TICK
	end
	player:SetAttribute("Training", training)
	player:SetAttribute("Speed", math.floor(data.speed))

	local walk = Items.walkSpeed(data.speed)
	if StealService.isCarrying(player) then
		walk *= GamePasses.carrySlowdown(player)
	end
	if math.abs(humanoid.WalkSpeed - walk) > 0.05 then
		humanoid.WalkSpeed = walk
	end
	-- The belt runs as fast as its owner, pushing back toward the house.
	if plot then
		local belt = plot.treadmill.belt
		belt.AssemblyLinearVelocity = belt.CFrame:VectorToWorldSpace(Vector3.new(0, 0, Items.walkSpeed(data.speed)))
	end
end

function SpeedService.init()
	task.spawn(function()
		while true do
			task.wait(TICK)
			for _, player in Players:GetPlayers() do
				local data = DataService.get(player)
				if data then
					local ok, err = pcall(update, player, data)
					if not ok then
						warn("[SpeedService] " .. tostring(err))
					end
				end
			end
		end
	end)
end

return SpeedService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">StealService</string>
          <string name="Source"><![CDATA[-- Carrying eggs home from the zones.
--
-- Hold the Grab prompt on an egg in a zone (you need a free nest at home). The egg rides
-- over your head and you run a little slower (GamePasses.carrySlowdown) until you get it
-- inside your own yard, where it goes into a free nest to grow (NestService). If the zone's
-- guardian catches you, or you die or leave, you drop it and it's gone (the zone grows a new
-- one).
--
-- Also gives players items (StealService.give), from hatching eggs, the Lucky Wheel and
-- Mystery Boxes.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EggModel = require(ReplicatedStorage.Shared.EggModel)
local Format = require(ReplicatedStorage.Shared.Format)
local ItemModel = require(ReplicatedStorage.Shared.ItemModel)
local Items = require(ReplicatedStorage.Shared.Items)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)
local NestService = require(script.Parent.NestService)
local PlotService = require(script.Parent.PlotService)
local ZoneService = require(script.Parent.ZoneService)

local StealService = {}

local notifyRemote = Remotes.get("Notify")
-- [carrier Player] = { record = { egg, rarity, mutations }, name, zone, pedestal, model, shoulders }
local carries = {}

local function notify(player: Player, message: string, kind: string?)
	if player.Parent then
		notifyRemote:FireClient(player, message, kind)
	end
end

local function rootPart(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- How far the arms swing up to hold an egg over the head (R15 characters).
local HOLD_ANGLE = math.rad(165)

-- Puts the egg over the carrier's head. Returns false if the carrier has no character.
local function pickUp(carrier: Player, carry): boolean
	local character = carrier.Character
	local root = rootPart(carrier)
	if not character or not root then
		return false
	end
	local model = EggModel.build(carry.record.egg, carry.record.item)
	Items.scaleModel(model, Items.weightScale(Items.weightFactor(carry.record)))
	ItemModel.addMutationEffect(model, carry.record.mutations)
	model:PivotTo(root.CFrame * CFrame.new(0, 3.2, 0))
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = descendant
			weld.Parent = descendant
		end
	end

	-- Arms up to hold it. Changing the shoulder joints' C0 (not Transform) keeps the pose
	-- under the walk animation, and putDown puts them back.
	carry.shoulders = {}
	for _, name in { "RightUpperArm.RightShoulder", "LeftUpperArm.LeftShoulder" } do
		local armName, jointName = string.match(name, "^(.-)%.(.*)$")
		local arm = character:FindFirstChild(armName)
		local joint = arm and arm:FindFirstChild(jointName)
		if joint and joint:IsA("Motor6D") then
			table.insert(carry.shoulders, { joint = joint, c0 = joint.C0 })
			joint.C0 = joint.C0 * CFrame.Angles(HOLD_ANGLE, 0, 0)
		end
	end

	model.Name = "CarriedPart"
	model.Parent = character
	carry.model = model
	carries[carrier] = carry
	carrier:SetAttribute(
		"Carrying",
		Format.weight(carry.record.weight or 1) .. " " .. carry.record.rarity .. " " .. carry.name
	)
	return true
end

-- Takes the egg off the carrier.
local function putDown(carrier: Player, carry)
	carries[carrier] = nil
	carrier:SetAttribute("Carrying", nil)
	if carry.model then
		carry.model:Destroy()
		carry.model = nil
	end
	for _, shoulder in carry.shoulders or {} do
		if shoulder.joint.Parent then
			shoulder.joint.C0 = shoulder.c0
		end
	end
	carry.shoulders = nil
end

-- The carrier dropped it: it's gone and its pedestal grows a new one.
local function drop(carrier: Player, carry, message: string?)
	putDown(carrier, carry)
	ZoneService.release(carry.zone, carry.pedestal)
	if message then
		notify(carrier, message, "error")
	end
end

-- Adds an item to a player's save (see NestService.give).
StealService.give = NestService.give

local function deliver(carrier: Player, carry)
	putDown(carrier, carry)
	ZoneService.release(carry.zone, carry.pedestal)
	local nest = NestService.addEgg(carrier, carry.record)
	if nest then
		notify(carrier, "🥚 " .. carry.name .. " is in nest " .. nest .. "! Wait for it to hatch.", "success")
	else
		notify(carrier, "Your nests are full, so the egg rolled away!", "error")
	end
end

-- Checks a player could carry an egg home right now. Returns an error message or nil.
local function cannotCarry(player: Player): string?
	if carries[player] then
		return "You can only carry one egg at a time!"
	end
	local data = DataService.get(player)
	if not data or not PlotService.getPlot(player) or not rootPart(player) then
		return ""
	end
	if not NestService.freeNest(player, data) then
		return "Your nests are full! Hatch your eggs first."
	end
	return nil
end

local function grab(prompt: ProximityPrompt, player: Player)
	local zone, pedestal = prompt:GetAttribute("Zone"), prompt:GetAttribute("Pedestal")
	local problem = cannotCarry(player)
	if problem then
		return if problem ~= "" then notify(player, problem, "error") else nil
	end
	local record = ZoneService.take(zone, pedestal)
	if not record then
		return
	end
	local carry = {
		record = record,
		name = ZoneService.eggName(record),
		zone = zone,
		pedestal = pedestal,
	}
	if not pickUp(player, carry) then
		return ZoneService.release(zone, pedestal)
	end
	notify(
		player,
		"You grabbed a "
			.. record.rarity
			.. " "
			.. carry.name
			.. "! Run home before "
			.. Items.ZONES[zone].title
			.. " catches you!",
		"success"
	)
	ZoneService.alert(zone, player)
end

function StealService.isCarrying(player: Player): boolean
	return carries[player] ~= nil
end

-- What a player is carrying (the egg's record), if anything.
function StealService.carrying(player: Player)
	local carry = carries[player]
	return carry and carry.record
end

-- Makes the player drop whatever they're carrying. Returns true if they were carrying.
function StealService.drop(player: Player, message: string?): boolean
	local carry = carries[player]
	if not carry then
		return false
	end
	drop(player, carry, message)
	return true
end

local function checkCarries()
	for carrier, carry in carries do
		local root = rootPart(carrier)
		if not root or not carry.model or not carry.model.Parent then
			drop(carrier, carry, "You dropped the " .. carry.name .. "!")
			continue
		end
		local home = PlotService.getPlot(carrier)
		if home and PlotService.isInside(home, root.Position) then
			deliver(carrier, carry)
		end
	end
end

function StealService.init()
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt.Name == "GrabPrompt" then
			grab(prompt, player)
		end
	end)
	ZoneService.setCarrierHooks({
		carrying = StealService.carrying,
		drop = StealService.drop,
	})

	Players.PlayerRemoving:Connect(function(player)
		local carry = carries[player]
		if carry then
			drop(player, carry)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.1)
			-- One bad tick must never stop deliveries for the rest of the server.
			local ok, err = pcall(checkCarries)
			if not ok then
				warn("[StealService] " .. tostring(err))
			end
		end
	end)
end

return StealService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">ZoneDecor</string>
          <string name="Source"><![CDATA[-- The scenery of each zone: its ground, the cliffs along its sides, the entrance arch with
-- its name and speed requirement, a path to the pile, and themed props (junk piles, pine
-- trees, cacti, lollipops, lava pools, crystals...).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Items = require(ReplicatedStorage.Shared.Items)
local ZoneLayout = require(ReplicatedStorage.Shared.ZoneLayout)

local ZoneDecor = {}

local M = Enum.Material
local OUTLINE = Color3.fromRGB(20, 22, 48)

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function block(parent, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, collide: boolean?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = collide == true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.Parent = parent
	return p
end

local function ball(parent, size: Vector3 | number, cframe: CFrame, color: Color3, material: Enum.Material?)
	local vector = if typeof(size) == "number" then Vector3.one * size else size
	local p = block(parent, vector, cframe, color, material)
	if vector.X == vector.Y and vector.Y == vector.Z then
		p.Shape = Enum.PartType.Ball
	else
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	return p
end

local function post(parent, height: number, diameter: number, cframe: CFrame, color: Color3, material: Enum.Material?)
	local p = block(
		parent,
		Vector3.new(height, diameter, diameter),
		cframe * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
		color,
		material
	)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function cone(parent, height: number, diameter: number, cframe: CFrame, color: Color3, material, steps: number?)
	local n = steps or 5
	for i = 0, n - 1 do
		post(
			parent,
			height / n + 0.02,
			diameter * (1 - i / n),
			cframe * CFrame.new(0, i * height / n, 0),
			color,
			material
		)
	end
end

local RAINBOW =
	{ rgb(255, 70, 90), rgb(255, 150, 40), rgb(255, 225, 50), rgb(80, 220, 100), rgb(60, 170, 255), rgb(150, 90, 255) }

--------------------------------------------------------------------------------
-- Props, one set per zone. Each takes (parent, ground CFrame, rng, size).
--------------------------------------------------------------------------------

local props = {}

props[1] = function(parent, cf, rng, s) -- Junkyard: tyre stacks, crates, an old car, barrels
	local kind = rng:NextInteger(1, 4)
	if kind == 1 then
		for i = 0, rng:NextInteger(2, 4) do
			local tyre = block(
				parent,
				Vector3.new(1.2 * s, 3 * s, 3 * s),
				cf * CFrame.new(0, (0.6 + i * 1.15) * s, 0) * CFrame.Angles(0, rng:NextNumber() * 3, math.pi / 2),
				rgb(40, 40, 45)
			)
			tyre.Shape = Enum.PartType.Cylinder
		end
	elseif kind == 2 then
		for i = 0, 2 do
			block(
				parent,
				Vector3.one * 3 * s,
				cf * CFrame.new((i - 1) * 3.2 * s, 1.5 * s, 0) * CFrame.Angles(0, rng:NextNumber() * 0.4, 0),
				rgb(180, 130, 80),
				M.WoodPlanks,
				true
			)
		end
		block(
			parent,
			Vector3.one * 3 * s,
			cf * CFrame.new(0, 4.5 * s, 0) * CFrame.Angles(0, 0.3, 0),
			rgb(160, 115, 70),
			M.WoodPlanks,
			true
		)
	elseif kind == 3 then
		local color = ({ rgb(90, 160, 200), rgb(200, 90, 80), rgb(220, 190, 80) })[rng:NextInteger(1, 3)]
		block(
			parent,
			Vector3.new(9 * s, 2.4 * s, 4.4 * s),
			cf * CFrame.new(0, 1.8 * s, 0) * CFrame.Angles(0, 0, math.rad(4)),
			color,
			M.CorrodedMetal,
			true
		)
		block(
			parent,
			Vector3.new(5 * s, 2 * s, 4 * s),
			cf * CFrame.new(-0.5 * s, 3.8 * s, 0) * CFrame.Angles(0, 0, math.rad(4)),
			color,
			M.CorrodedMetal,
			true
		)
		block(
			parent,
			Vector3.new(0.2, 1.4 * s, 3.6 * s),
			cf * CFrame.new(2.1 * s, 3.8 * s, 0),
			rgb(160, 200, 220),
			M.Glass
		)
		for _, x in { -3, 3 } do
			for _, z in { -2.3, 2.3 } do
				local wheel = block(
					parent,
					Vector3.new(0.8 * s, 2 * s, 2 * s),
					cf * CFrame.new(x * s, 0.9 * s, z * s) * CFrame.Angles(0, math.pi / 2, math.pi / 2),
					rgb(35, 35, 40)
				)
				wheel.Shape = Enum.PartType.Cylinder
			end
		end
	else
		for i = 0, 2 do
			post(
				parent,
				3.2 * s,
				2.2 * s,
				cf * CFrame.new((i - 1) * 2.4 * s, 0, (i % 2) * s),
				({ rgb(60, 130, 170), rgb(200, 80, 60), rgb(80, 150, 90) })[i + 1],
				M.CorrodedMetal
			)
		end
	end
end

props[2] = function(parent, cf, rng, s) -- Pine Woods: pines, logs, mushrooms
	local kind = rng:NextInteger(1, 5)
	if kind <= 3 then
		local h = (9 + rng:NextNumber() * 6) * s
		post(parent, h * 0.25, 1.4 * s, cf, rgb(110, 70, 40), M.Wood)
		cone(
			parent,
			h,
			h * 0.55,
			cf * CFrame.new(0, h * 0.2, 0),
			rgb(45, 125, 65):Lerp(rgb(30, 95, 55), rng:NextNumber()),
			nil,
			5
		)
	elseif kind == 4 then
		local log = block(
			parent,
			Vector3.new(8 * s, 2 * s, 2 * s),
			cf * CFrame.new(0, 1 * s, 0) * CFrame.Angles(0, rng:NextNumber() * 3, 0),
			rgb(130, 85, 45),
			M.Wood,
			true
		)
		log.Shape = Enum.PartType.Cylinder
	else
		for i = 0, 2 do
			local spot = cf * CFrame.new((i - 1) * 2 * s, 0, (i % 2) * 1.5 * s)
			post(parent, (1 + i * 0.4) * s, 0.6 * s, spot, rgb(250, 240, 220))
			ball(
				parent,
				Vector3.new(2 * s, 1.1 * s, 2 * s),
				spot * CFrame.new(0, (1 + i * 0.4) * s, 0),
				rgb(225, 50, 50)
			)
		end
	end
end

props[3] = function(parent, cf, rng, s) -- Rocky Quarry: boulders and a minecart
	if rng:NextNumber() < 0.75 then
		for i = 0, rng:NextInteger(1, 3) do
			local size = (2.5 + rng:NextNumber() * 3) * s
			ball(
				parent,
				Vector3.new(size * 1.3, size, size),
				cf * CFrame.new(i * 2.5 * s, size * 0.35, (i % 2) * 2 * s),
				rgb(150, 145, 140):Lerp(rgb(110, 105, 100), rng:NextNumber()),
				M.Slate
			)
		end
	else
		block(parent, Vector3.new(4 * s, 2.4 * s, 3 * s), cf * CFrame.new(0, 2 * s, 0), rgb(110, 90, 70), M.Metal, true)
		ball(
			parent,
			Vector3.new(3.4 * s, 1.4 * s, 2.6 * s),
			cf * CFrame.new(0, 3.3 * s, 0),
			rgb(160, 150, 140),
			M.Slate
		)
		for _, x in { -1.4, 1.4 } do
			local wheel = block(
				parent,
				Vector3.new(3.4 * s, 1.2 * s, 1.2 * s),
				cf * CFrame.new(x * s, 0.6 * s, 0),
				rgb(50, 50, 55),
				M.Metal
			)
			wheel.Shape = Enum.PartType.Cylinder
			wheel.CFrame = cf * CFrame.new(x * s, 0.6 * s, 0) * CFrame.Angles(0, math.pi / 2, 0)
		end
	end
end

props[4] = function(parent, cf, rng, s) -- Sunny Desert: cacti, palms, a small pyramid
	local kind = rng:NextInteger(1, 4)
	local green = rgb(70, 170, 80)
	if kind <= 2 then
		local h = (5 + rng:NextNumber() * 4) * s
		post(parent, h, 1.6 * s, cf, green)
		ball(parent, 1.6 * s, cf * CFrame.new(0, h, 0), green)
		for _, side in { -1, 1 } do
			local arm = cf * CFrame.new(side * 1.3 * s, h * (0.35 + rng:NextNumber() * 0.2), 0)
			block(parent, Vector3.new(1.3 * s, 1 * s, 1 * s), arm, green)
			post(parent, 2 * s, 1 * s, arm * CFrame.new(side * 0.5 * s, 0, 0), green)
		end
		ball(parent, 0.8 * s, cf * CFrame.new(0, h + 0.7 * s, 0), rgb(255, 110, 160))
	elseif kind == 3 then
		local h = 10 * s
		for i = 0, 5 do
			local p = block(
				parent,
				Vector3.new(1.3 * s, h / 6 + 0.1, 1.3 * s),
				cf * CFrame.new(i * 0.25 * s, (i + 0.5) * h / 6, 0) * CFrame.Angles(0, 0, math.rad(-4)),
				rgb(160, 115, 70),
				M.Wood
			)
			p.Shape = Enum.PartType.Block
		end
		for k = 0, 5 do
			local a = math.rad(k * 60)
			local leaf = cf * CFrame.new(1.5 * s, h, 0) * CFrame.Angles(0, a, math.rad(-25)) * CFrame.new(2.2 * s, 0, 0)
			ball(parent, Vector3.new(5 * s, 0.5 * s, 1.6 * s), leaf, rgb(80, 180, 80))
		end
	else
		for i = 0, 3 do
			local w = (8 - i * 2) * s
			block(
				parent,
				Vector3.new(w, 2 * s, w),
				cf * CFrame.new(0, (i + 0.5) * 2 * s, 0),
				rgb(235, 200, 130),
				M.Sandstone,
				true
			)
		end
	end
end

props[5] = function(parent, cf, rng, s) -- Frosty Peaks: snowy pines, snowmen, ice spikes
	local kind = rng:NextInteger(1, 4)
	if kind <= 2 then
		local h = (9 + rng:NextNumber() * 5) * s
		post(parent, h * 0.2, 1.3 * s, cf, rgb(100, 70, 50), M.Wood)
		cone(parent, h, h * 0.5, cf * CFrame.new(0, h * 0.15, 0), rgb(50, 120, 90), nil, 4)
		cone(parent, h * 0.6, h * 0.3, cf * CFrame.new(0, h * 0.62, 0), rgb(250, 252, 255), M.Snow, 3)
	elseif kind == 3 then
		ball(parent, 3.4 * s, cf * CFrame.new(0, 1.6 * s, 0), rgb(255, 255, 255), M.Snow)
		ball(parent, 2.5 * s, cf * CFrame.new(0, 4 * s, 0), rgb(255, 255, 255), M.Snow)
		ball(parent, 1.8 * s, cf * CFrame.new(0, 5.8 * s, 0), rgb(255, 255, 255), M.Snow)
		block(parent, Vector3.new(0.3 * s, 0.3 * s, 1 * s), cf * CFrame.new(0, 5.8 * s, -1.2 * s), rgb(255, 140, 40))
		post(parent, 1 * s, 1.5 * s, cf * CFrame.new(0, 6.5 * s, 0), rgb(40, 40, 50))
	else
		for i = 0, 3 do
			local h = (4 + rng:NextNumber() * 4) * s
			block(
				parent,
				Vector3.new(1.4 * s, h, 1.4 * s),
				cf
					* CFrame.new((i - 1.5) * 1.6 * s, h * 0.45, (i % 2) * s)
					* CFrame.Angles(0, math.rad(45), math.rad((i - 1.5) * 12)),
				rgb(140, 220, 255),
				M.Ice
			)
		end
	end
end

props[6] = function(parent, cf, rng, s) -- Candy Land: lollipops, gumdrops, candy canes, cupcakes
	local kind = rng:NextInteger(1, 4)
	if kind == 1 then
		local h = (6 + rng:NextNumber() * 4) * s
		post(parent, h, 0.6 * s, cf, rgb(255, 255, 255))
		local pop = block(
			parent,
			Vector3.new(0.8 * s, 5 * s, 5 * s),
			cf * CFrame.new(0, h + 2 * s, 0) * CFrame.Angles(0, rng:NextNumber() * 3, 0),
			RAINBOW[rng:NextInteger(1, 6)]
		)
		pop.Shape = Enum.PartType.Cylinder
		pop.CFrame = cf * CFrame.new(0, h + 2 * s, 0) * CFrame.Angles(0, rng:NextNumber() * 3, 0)
	elseif kind == 2 then
		for i = 0, 2 do
			ball(
				parent,
				Vector3.new(3 * s, 2.6 * s, 3 * s),
				cf * CFrame.new((i - 1) * 3 * s, 1 * s, (i % 2) * 2 * s),
				RAINBOW[rng:NextInteger(1, 6)],
				M.Glass
			)
		end
	elseif kind == 3 then
		local h = 8 * s
		post(parent, h, 1 * s, cf, rgb(255, 255, 255))
		for i = 0, 4 do
			post(parent, h * 0.08, 1.05 * s, cf * CFrame.new(0, h * (0.1 + i * 0.2), 0), rgb(230, 40, 60))
		end
		block(parent, Vector3.new(2.6 * s, 1 * s, 1 * s), cf * CFrame.new(1 * s, h, 0), rgb(230, 40, 60))
	else
		post(parent, 2.4 * s, 4 * s, cf, rgb(255, 210, 120))
		ball(parent, Vector3.new(4.4 * s, 3 * s, 4.4 * s), cf * CFrame.new(0, 2.8 * s, 0), rgb(255, 170, 210))
		ball(parent, 1 * s, cf * CFrame.new(0, 4.4 * s, 0), rgb(230, 30, 50))
	end
end

props[7] = function(parent, cf, rng, s) -- Lava Volcano: lava pools and glowing rocks
	if rng:NextNumber() < 0.5 then
		local size = (5 + rng:NextNumber() * 5) * s
		local pool = block(
			parent,
			Vector3.new(0.3, size, size * 1.3),
			cf * CFrame.new(0, 0.12, 0) * CFrame.Angles(0, 0, math.pi / 2),
			rgb(255, 110, 20),
			M.Neon
		)
		pool.Shape = Enum.PartType.Cylinder
		local rim = block(
			parent,
			Vector3.new(0.25, size + 1.4, size * 1.3 + 1.4),
			cf * CFrame.new(0, 0.08, 0) * CFrame.Angles(0, 0, math.pi / 2),
			rgb(40, 30, 35),
			M.Basalt
		)
		rim.Shape = Enum.PartType.Cylinder
	else
		for i = 0, 2 do
			local size = (2.5 + rng:NextNumber() * 2.5) * s
			ball(
				parent,
				Vector3.new(size * 1.2, size, size),
				cf * CFrame.new(i * 2.4 * s, size * 0.35, (i % 2) * 2 * s),
				rgb(50, 38, 45),
				M.Basalt
			)
			ball(
				parent,
				size * 0.35,
				cf * CFrame.new(i * 2.4 * s, size * 0.7, (i % 2) * 2 * s - size * 0.4),
				rgb(255, 100, 20),
				M.Neon
			)
		end
	end
end

props[8] = function(parent, cf, rng, s) -- Royal Kingdom: topiaries, statues, banners
	local kind = rng:NextInteger(1, 3)
	if kind == 1 then
		block(parent, Vector3.new(3 * s, 1.6 * s, 3 * s), cf * CFrame.new(0, 0.8 * s, 0), rgb(240, 235, 225), M.Marble)
		post(parent, 1.8 * s, 0.6 * s, cf * CFrame.new(0, 1.6 * s, 0), rgb(120, 80, 50))
		ball(parent, 3.2 * s, cf * CFrame.new(0, 4.6 * s, 0), rgb(60, 160, 70))
		ball(parent, 2.2 * s, cf * CFrame.new(0, 6.8 * s, 0), rgb(60, 160, 70))
	elseif kind == 2 then
		block(
			parent,
			Vector3.new(3.4 * s, 2 * s, 3.4 * s),
			cf * CFrame.new(0, 1 * s, 0),
			rgb(240, 235, 225),
			M.Marble,
			true
		)
		post(parent, 4 * s, 1.6 * s, cf * CFrame.new(0, 2 * s, 0), rgb(255, 200, 60), M.Foil)
		ball(parent, 2 * s, cf * CFrame.new(0, 7 * s, 0), rgb(255, 200, 60), M.Foil)
	else
		post(parent, 10 * s, 0.4 * s, cf, rgb(255, 200, 60), M.Foil)
		block(parent, Vector3.new(0.2, 4 * s, 2.6 * s), cf * CFrame.new(0, 7.5 * s, 1.3 * s), rgb(220, 40, 60))
		block(
			parent,
			Vector3.new(0.22, 1 * s, 2.6 * s),
			cf * CFrame.new(0, 8.6 * s, 1.3 * s),
			rgb(255, 200, 60),
			M.Foil
		)
	end
end

props[9] = function(parent, cf, rng, s) -- Crystal Caves: crystal clusters
	local colors = { rgb(160, 110, 255), rgb(110, 240, 255), rgb(255, 120, 230) }
	local color = colors[rng:NextInteger(1, 3)]
	for i = 0, rng:NextInteger(3, 5) do
		local h = (3 + rng:NextNumber() * 7) * s
		local tilt = (rng:NextNumber() - 0.5) * 50
		local spot = cf
			* CFrame.new((rng:NextNumber() - 0.5) * 4 * s, 0, (rng:NextNumber() - 0.5) * 4 * s)
			* CFrame.Angles(math.rad(tilt * 0.6), rng:NextNumber() * 3, math.rad(tilt))
		block(
			parent,
			Vector3.new(1.2 * s, h, 1.2 * s),
			spot * CFrame.new(0, h / 2, 0),
			color,
			if i % 2 == 0 then M.Neon else M.Glass
		)
	end
end

props[10] = function(parent, cf, rng, s) -- Sky Islands: cloud puffs, golden pillars, rainbows
	local kind = rng:NextInteger(1, 3)
	if kind == 1 then
		for i = 0, 3 do
			ball(
				parent,
				(3 + rng:NextNumber() * 3) * s,
				cf * CFrame.new((i - 1.5) * 2.6 * s, (1 + rng:NextNumber()) * s, rng:NextNumber() * 2 * s),
				rgb(255, 255, 255)
			)
		end
	elseif kind == 2 then
		post(parent, 12 * s, 2 * s, cf, rgb(250, 248, 240), M.Marble)
		post(parent, 0.6 * s, 2.8 * s, cf * CFrame.new(0, 12 * s, 0), rgb(255, 210, 80), M.Foil)
		post(parent, 0.6 * s, 2.8 * s, cf, rgb(255, 210, 80), M.Foil)
	else
		for i, color in RAINBOW do
			local r = (9 - i * 0.8) * s
			for k = 0, 10 do
				local a = math.rad(k * 18)
				ball(parent, 1.2 * s, cf * CFrame.new(math.cos(a) * r, math.sin(a) * r, 0), color, M.Neon)
			end
		end
	end
end

props[11] = function(parent, cf, rng, s) -- Backyard Garden: hedges, flower patches, watering cans
	local kind = rng:NextInteger(1, 4)
	if kind <= 2 then
		local length = rng:NextInteger(2, 4) * 3 * s
		block(
			parent,
			Vector3.new(length, 3 * s, 2.4 * s),
			cf * CFrame.new(0, 1.5 * s, 0),
			rgb(50, 150, 60),
			M.Grass,
			true
		)
		for i = 0, math.floor(length / (2 * s)) do
			ball(
				parent,
				0.7 * s,
				cf * CFrame.new(-length / 2 + i * 2 * s + s, 3.1 * s, -1.2 * s),
				RAINBOW[rng:NextInteger(1, 6)]
			)
		end
	elseif kind == 3 then
		for i = 0, 5 do
			local spot = cf * CFrame.new((i % 3 - 1) * 1.6 * s, 0, (i // 3 - 0.5) * 1.6 * s)
			post(parent, 1.6 * s, 0.25 * s, spot, rgb(70, 165, 70))
			ball(parent, 0.9 * s, spot * CFrame.new(0, 1.8 * s, 0), RAINBOW[rng:NextInteger(1, 6)])
		end
	else
		block(parent, Vector3.new(2.2 * s, 2 * s, 1.6 * s), cf * CFrame.new(0, 1 * s, 0), rgb(80, 160, 230))
		block(
			parent,
			Vector3.new(0.4 * s, 0.4 * s, 2.4 * s),
			cf * CFrame.new(0, 1.6 * s, -1.6 * s) * CFrame.Angles(math.rad(-30), 0, 0),
			rgb(80, 160, 230)
		)
		block(parent, Vector3.new(0.4 * s, 1.4 * s, 0.4 * s), cf * CFrame.new(0, 2.6 * s, 0.4 * s), rgb(60, 130, 200))
	end
end

props[12] = function(parent, cf, rng, s) -- Toy Town: giant toy bricks, beach balls, rubber ducks
	local kind = rng:NextInteger(1, 4)
	if kind <= 2 then
		for i = 0, rng:NextInteger(1, 3) do
			local size = Vector3.new(rng:NextInteger(2, 4) * 2, 2.4, 4) * s
			block(
				parent,
				size,
				cf * CFrame.new((i % 2) * 2 * s, (i + 0.5) * 2.4 * s, 0) * CFrame.Angles(0, i * 0.5, 0),
				RAINBOW[rng:NextInteger(1, 6)],
				nil,
				true
			)
		end
	elseif kind == 3 then
		local r = (2 + rng:NextNumber() * 1.5) * s
		for i, color in { rgb(255, 70, 90), rgb(255, 255, 255), rgb(60, 140, 255), rgb(255, 220, 60) } do
			ball(
				parent,
				Vector3.new(r * 2, r * 2, r * (0.5 + i * 0.12)),
				cf * CFrame.new(0, r, 0) * CFrame.Angles(0, i * math.pi / 4, 0),
				color
			)
		end
	else
		ball(parent, Vector3.new(4 * s, 3 * s, 5 * s), cf * CFrame.new(0, 1.5 * s, 0), rgb(255, 220, 40))
		ball(parent, 2.6 * s, cf * CFrame.new(0, 3.6 * s, -1.6 * s), rgb(255, 220, 40))
		block(parent, Vector3.new(1.2 * s, 0.5 * s, 1.2 * s), cf * CFrame.new(0, 3.5 * s, -3 * s), rgb(255, 140, 30))
	end
end

-- Which look (theme and props, below) each zone uses, in zone order.
local LOOK = { 11, 1, 2, 12, 4, 6, 5, 8, 9, 10 }

-- Ground, cliffs and colours for each zone.
local THEMES = {
	{ -- Junkyard
		ground = rgb(214, 170, 112),
		groundMat = M.Ground,
		wall = rgb(190, 110, 60),
		trim = rgb(120, 200, 80),
		cliff = rgb(150, 120, 90),
		cliffMat = M.Slate,
		path = rgb(150, 115, 80),
		accent = rgb(255, 160, 50),
	},
	{ -- Pine Woods
		ground = rgb(64, 196, 70),
		groundMat = M.Grass,
		wall = rgb(40, 120, 70),
		trim = rgb(110, 225, 90),
		cliff = rgb(90, 120, 90),
		cliffMat = M.Rock,
		path = rgb(160, 115, 70),
		accent = rgb(120, 220, 90),
	},
	{ -- Rocky Quarry
		ground = rgb(170, 175, 185),
		groundMat = M.Slate,
		wall = rgb(95, 110, 150),
		trim = rgb(80, 190, 90),
		cliff = rgb(140, 140, 150),
		cliffMat = M.Rock,
		path = rgb(200, 190, 170),
		accent = rgb(160, 175, 230),
	},
	{ -- Sunny Desert
		ground = rgb(245, 205, 115),
		groundMat = M.Sand,
		wall = rgb(230, 140, 60),
		trim = rgb(255, 225, 140),
		cliff = rgb(220, 170, 100),
		cliffMat = M.Sandstone,
		path = rgb(225, 180, 110),
		accent = rgb(60, 210, 220),
	},
	{ -- Frosty Peaks
		ground = rgb(225, 240, 255),
		groundMat = M.Snow,
		wall = rgb(90, 160, 240),
		trim = rgb(250, 252, 255),
		cliff = rgb(190, 220, 245),
		cliffMat = M.Ice,
		path = rgb(190, 220, 245),
		accent = rgb(110, 210, 255),
	},
	{ -- Candy Land
		ground = rgb(255, 185, 220),
		groundMat = M.SmoothPlastic,
		wall = rgb(255, 100, 170),
		trim = rgb(255, 255, 255),
		cliff = rgb(255, 140, 195),
		cliffMat = M.SmoothPlastic,
		path = rgb(255, 255, 255),
		accent = rgb(255, 80, 150),
	},
	{ -- Lava Volcano
		ground = rgb(80, 60, 75),
		groundMat = M.Basalt,
		wall = rgb(50, 35, 50),
		trim = rgb(255, 110, 30),
		cliff = rgb(45, 35, 42),
		cliffMat = M.Basalt,
		path = rgb(110, 80, 80),
		accent = rgb(255, 110, 30),
	},
	{ -- Royal Kingdom
		ground = rgb(80, 200, 90),
		groundMat = M.Grass,
		wall = rgb(235, 230, 220),
		trim = rgb(255, 200, 60),
		cliff = rgb(225, 220, 210),
		cliffMat = M.Marble,
		path = rgb(220, 40, 60),
		accent = rgb(255, 200, 60),
	},
	{ -- Crystal Caves
		ground = rgb(85, 60, 130),
		groundMat = M.Slate,
		wall = rgb(110, 70, 210),
		trim = rgb(130, 240, 255),
		cliff = rgb(85, 62, 125),
		cliffMat = M.Rock,
		path = rgb(130, 95, 190),
		accent = rgb(140, 240, 255),
	},
	{ -- Sky Islands
		ground = rgb(245, 250, 255),
		groundMat = M.SmoothPlastic,
		wall = rgb(130, 190, 255),
		trim = rgb(255, 215, 90),
		cliff = rgb(235, 242, 255),
		cliffMat = M.SmoothPlastic,
		path = rgb(255, 225, 120),
		accent = rgb(255, 210, 80),
	},
	{ -- Backyard Garden
		ground = rgb(90, 210, 90),
		groundMat = M.Grass,
		wall = rgb(250, 245, 235),
		trim = rgb(255, 120, 160),
		cliff = rgb(230, 225, 215),
		cliffMat = M.WoodPlanks,
		path = rgb(200, 160, 110),
		accent = rgb(255, 120, 170),
	},
	{ -- Toy Town
		ground = rgb(120, 200, 255),
		groundMat = M.SmoothPlastic,
		wall = rgb(255, 210, 50),
		trim = rgb(255, 80, 90),
		cliff = rgb(255, 200, 60),
		cliffMat = M.SmoothPlastic,
		path = rgb(255, 255, 255),
		accent = rgb(255, 90, 90),
	},
}

-- The theme for zone `index`.
function ZoneDecor.theme(index: number)
	return THEMES[LOOK[index]]
end

-- The arch over a zone's entrance: its name and the Speed you need.
local function buildArch(parent, index: number, theme)
	local zone = Items.ZONES[index]
	local east = ZoneLayout.edges(index)
	local width = 26
	local height = 18
	for _, side in { -1, 1 } do
		local spot = CFrame.new(east, 0, side * (width / 2 + 2))
		block(
			parent,
			Vector3.new(4, height, 4),
			spot * CFrame.new(0, height / 2, 0),
			theme.cliff:Lerp(rgb(255, 255, 255), 0.15),
			theme.cliffMat,
			true
		)
		block(parent, Vector3.new(5, 1.2, 5), spot * CFrame.new(0, height + 0.6, 0), theme.accent)
		ball(parent, 2.6, spot * CFrame.new(0, height + 2.4, 0), theme.accent, M.Neon)
	end
	local beam =
		block(parent, Vector3.new(3, 6, width + 8), CFrame.new(east, height - 1, 0), rgb(255, 250, 235), nil, true)
	block(parent, Vector3.new(2.6, 6.8, width + 8.8), CFrame.new(east + 0.3, height - 1, 0), OUTLINE)
	-- Text on the town side of the beam (facing +X, toward players arriving).
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Right
	gui.CanvasSize = Vector2.new(700, 160)
	gui.LightInfluence = 0
	gui.Parent = beam
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.fromScale(1, 0.58)
	name.TextScaled = true
	name.Font = Enum.Font.LuckiestGuy
	name.Text = string.upper(zone.name)
	name.TextColor3 = theme.accent
	name.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = OUTLINE
	stroke.Thickness = 5
	stroke.Parent = name
	local speed = name:Clone()
	speed.Position = UDim2.fromScale(0, 0.58)
	speed.Size = UDim2.fromScale(1, 0.42)
	local kind = Items.KINDS[zone.kind]
	speed.Text = (if zone.speed > 0 then "⚡ " .. ZoneDecor.formatSpeed(zone.speed) else "⚡ ANY")
		.. "  ·  "
		.. kind.icon
		.. " "
		.. string.upper(kind.egg)
		.. " EGGS"
	speed.TextColor3 = rgb(255, 225, 80)
	speed.Parent = gui
end

function ZoneDecor.formatSpeed(n: number): string
	if n >= 1e6 then
		return (string.format("%.1f", n / 1e6):gsub("%.0$", "")) .. "M"
	elseif n >= 1e3 then
		return (string.format("%.1f", n / 1e3):gsub("%.0$", "")) .. "K"
	end
	return tostring(math.floor(n))
end

ZoneDecor.propSpots = {} -- [zone index] = { Vector3 } where the props stand

function ZoneDecor.build(parent: Instance, index: number)
	local theme = ZoneDecor.theme(index)
	local east, west = ZoneLayout.edges(index)
	local length, width = ZoneLayout.length(index), ZoneLayout.WIDTH
	local homeU = ZoneLayout.homeU(index)
	local centerX = (east + west) / 2
	local folder = Instance.new("Folder")
	folder.Name = "Zone" .. index .. "_" .. Items.ZONES[index].name
	folder.Parent = parent

	-- A checkerboard floor in two shades of the zone's colour, and the path to the pile.
	local tile = 13
	local countX, countZ = math.round(length / tile), math.round(width / tile)
	for i = 0, countX - 1 do
		for k = 0, countZ - 1 do
			local w, d = length / countX, width / countZ
			local floor = block(
				folder,
				Vector3.new(w, 2, d),
				CFrame.new(east - (i + 0.5) * w, -0.98, -width / 2 + (k + 0.5) * d),
				if (i + k) % 2 == 0 then theme.ground else theme.ground:Lerp(Color3.new(0, 0, 0), 0.12),
				theme.groundMat,
				true
			)
			floor.Name = "Tile"
		end
	end
	local path = block(
		folder,
		Vector3.new(homeU - 12, 0.2, 10),
		CFrame.new(east - (homeU - 12) / 2, 0.12, 0),
		theme.path,
		if index == 8 then M.Fabric else theme.groundMat
	)
	path.Name = "PathStone"
	-- Tall flat walls along both sides (and behind the last zone), so nobody wanders off the
	-- map, with a strip of the floor colour along the top like grass on a cliff.
	local wallHeight = 30
	for _, side in { -1, 1 } do
		local z = side * (width / 2 + 3)
		block(
			folder,
			Vector3.new(length, wallHeight, 6),
			CFrame.new(centerX, wallHeight / 2, z),
			theme.wall,
			theme.cliffMat,
			true
		)
		block(
			folder,
			Vector3.new(length, 1.6, 6.4),
			CFrame.new(centerX, wallHeight + 0.8, z),
			theme.trim,
			theme.cliffMat
		)
		-- An invisible wall on top, far up, so nobody (flung by a guardian, or jumping off
		-- something tall) can ever get over the side.
		local barrier =
			block(folder, Vector3.new(length, 200, 6), CFrame.new(centerX, wallHeight + 100, z), theme.wall, nil, true)
		barrier.Name = "ZoneBarrier"
		barrier.Transparency = 1
		barrier.CanQuery = false
		if index == 8 then
			-- Castle battlements on the walls of the Royal Kingdom.
			for i = 0, 15 do
				block(
					folder,
					Vector3.new(3, 3, 6.2),
					CFrame.new(east - (i + 0.5) * length / 16, wallHeight + 3, z),
					theme.cliff,
					theme.cliffMat
				)
			end
		end
	end
	if index == #Items.ZONES then
		block(folder, Vector3.new(6, 32, width + 12), CFrame.new(west - 3, 16, 0), theme.wall, theme.cliffMat, true)
	end
	buildArch(folder, index, theme)

	-- Themed props, kept off the path and out of the pile (more in bigger zones). Their spots
	-- are kept (ZoneDecor.propSpots) so eggs don't land inside them.
	local spots = {}
	ZoneDecor.propSpots[index] = spots
	local rng = Random.new(index * 7919)
	local placed = 0
	local tries = 0
	local count = math.floor(22 * (length * width) / (130 * 110))
	while placed < count and tries < count * 9 do
		tries += 1
		local u = rng:NextNumber(8, length - 6)
		local v = rng:NextNumber(-width / 2 + 7, width / 2 - 7)
		local nearPile = (Vector2.new(u, v) - Vector2.new(homeU, 0)).Magnitude < ZoneLayout.RING * 1.6
		if math.abs(v) > 10 and not nearPile then
			placed += 1
			local cf = CFrame.new(east - u, 0, v) * CFrame.Angles(0, rng:NextNumber() * math.pi * 2, 0)
			table.insert(spots, Vector3.new(east - u, 0, v))
			props[LOOK[index]](folder, cf, rng, 0.9 + rng:NextNumber() * 0.5)
		end
	end
	return folder
end

return ZoneDecor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">ZoneService</string>
          <string name="Source"><![CDATA[-- The zones: eggs to steal, each zone guarded by a giant Freek.
--
-- Eggs lie scattered on the ground all over each zone (ZoneLayout.eggCount at a time; when
-- one is taken a new one turns up somewhere else a few seconds later). Each is one of the
-- zone's eggs (Items.ZONES: what kind of thing hatches from it and the odds of each rarity):
-- what's inside is decided when it appears, and the egg is designed around it (EggModel).
-- Rarer eggs lie deeper in, nearer the guardian. Each shows its rarity, what's inside, its
-- weight and hatch time, sometimes with a mutation the hatched item keeps. Hold Grab on one
-- and run! The zone's guardian chases anyone carrying
-- an egg inside its zone. It runs at Items.guardianSpeed: a bit slower than a player who has
-- the zone's Speed, so if you trained enough you get away, and if you didn't it catches you,
-- flings you toward town and you drop the egg.
--
-- Guardians live on the server as plain data (position, heading, who they're chasing) and
-- are published as attributes on ReplicatedStorage.Guardians, so every client builds and
-- animates its own copy smoothly (client GuardianFX).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Events = require(ReplicatedStorage.Shared.Events)
local Format = require(ReplicatedStorage.Shared.Format)
local EggModel = require(ReplicatedStorage.Shared.EggModel)
local Items = require(ReplicatedStorage.Shared.Items)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ZoneLayout = require(ReplicatedStorage.Shared.ZoneLayout)

local ZoneDecor = require(script.Parent.ZoneDecor)

local ZoneService = {}

local RESPAWN_MIN, RESPAWN_MAX = 6, 12 -- seconds before an empty pedestal grows a new egg
local CATCH_RADIUS = 7
local LEASH = 14 -- how far past its zone's edge a guardian keeps chasing
local PUBLISH_INTERVAL = 0.1

local notifyRemote = Remotes.get("Notify")
local knockbackRemote = Remotes.get("Knockback")
local rng = Random.new()

local zones = {} -- [index] = { pedestals = { { spot, part, model, ring, label, respawnAt, taken } }, guardian }
local hooks = {
	carrying = function(_player)
		return nil
	end,
	drop = function(_player, _message)
		return false
	end,
}
-- Mutations an egg can grow with (the item that hatches keeps them).
local MUTATION_FACTOR = 0.6

--------------------------------------------------------------------------------
-- Pedestals
--------------------------------------------------------------------------------

local OUTLINE = Color3.fromRGB(20, 22, 48)

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		p[key] = value
	end
	return p
end

local function textLine(parent: Instance, font: Enum.Font, y: number, h: number)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0, y)
	label.Size = UDim2.fromScale(1, h)
	label.TextScaled = true
	label.Font = font
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = parent
	local stroke = Instance.new("UIStroke")
	stroke.Color = OUTLINE
	stroke.Thickness = 3
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	return label
end

-- An egg spot: where one egg lies on the ground (it moves to a new random place each time a
-- new egg turns up), with a glowing ring round it in the egg's rarity colour and floating
-- text. `base` is an invisible part at the spot that holds the Grab prompt and the text.
local function buildPedestal(parent: Instance, index: number, n: number)
	local base = part({
		Name = "EggSpot" .. n,
		Size = Vector3.new(4, 1, 4),
		CFrame = CFrame.new(ZoneLayout.guardianHome(index)),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = parent,
	})
	local ring = part({
		Name = "EggRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.12, 5, 5),
		CFrame = base.CFrame * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(200, 200, 200),
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
		CanQuery = false,
		Parent = parent,
	})
	-- Floating text: rarity, what's inside, weight and hatch time.
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(8, 3.2)
	gui.StudsOffset = Vector3.new(0, 6, 0)
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Parent = base
	local rarity = textLine(gui, Enum.Font.LuckiestGuy, 0, 0.32)
	local name = textLine(gui, Enum.Font.FredokaOne, 0.32, 0.36)
	local income = textLine(gui, Enum.Font.FredokaOne, 0.68, 0.32)
	income.TextColor3 = Color3.fromRGB(255, 215, 60)
	return {
		spot = base.CFrame,
		base = base,
		ring = ring,
		labels = { rarity = rarity, name = name, income = income, gui = gui },
		record = nil,
		model = nil,
		respawnAt = 0,
		taken = false,
	}
end

-- A random place on the ground in zone `index` for a new egg: rarer eggs lie deeper in, near
-- the guardian; nowhere inside the scenery or right on top of another egg.
local function pickSpot(index: number, rarity: string, others): CFrame
	local length, width = ZoneLayout.length(index), ZoneLayout.WIDTH
	local homeU = ZoneLayout.homeU(index)
	local depth = ((Rarities.rank[rarity] or 1) - 1) / (#Rarities.order - 1) -- 0 common .. 1 secret
	local nearest = 22 + depth * (homeU - 40) -- how close to the entrance it may lie
	local props = ZoneDecor.propSpots[index] or {}
	local best, bestRoom = nil, -1
	for _ = 1, 30 do
		local u = rng:NextNumber(nearest, length - 8)
		local v = rng:NextNumber(-width / 2 + 8, width / 2 - 8)
		local point = ZoneLayout.point(index, u, v)
		local room = math.huge
		for _, prop in props do
			room = math.min(room, (prop - point).Magnitude - 6)
		end
		for _, other in others do
			if other.record and other.spot then
				room = math.min(room, (other.spot.Position - point).Magnitude - 7)
			end
		end
		if room > 0 then
			return CFrame.new(point)
		elseif room > bestRoom then
			best, bestRoom = point, room
		end
	end
	return CFrame.new(best or ZoneLayout.point(index, length - 12, 0))
end

-- Picks the egg that turns up next in this zone, and what's inside it:
-- { egg = zone, rarity, item, mutations, weight, baseWeight } (weights in kg, see Items).
local function rollEgg(index: number)
	local rarity = Items.rollRarity(index, rng, Events.boost("rareBoost"))
	local mutations = {}
	for _, mutation in Mutations.list do
		if rng:NextNumber() < mutation.chance * MUTATION_FACTOR * Events.boost("mutationBoost") then
			table.insert(mutations, mutation.id)
			break
		end
	end
	-- Weather events give every new egg a good chance of their mutation.
	local weather = Events.weather()
	if weather and rng:NextNumber() < 0.25 then
		mutations = { weather.mutation }
	end
	return {
		egg = index,
		rarity = rarity,
		item = Items.rollItem(Items.ZONES[index].kind, rarity, rng),
		mutations = Mutations.pack(mutations),
		weight = Items.eggBaseWeight(index) * Items.rollWeightFactor(rng, Events.boost("rareBoost")),
		baseWeight = Items.eggBaseWeight(index),
	}
end

-- "Golden Woofles Egg"
function ZoneService.eggName(record): string
	local top = Mutations.top(record.mutations)
	local name = Items.itemEggName(record.egg, record.item)
	return if top then top .. " " .. name else name
end

local function showEgg(index: number, pedestal, record)
	if pedestal.model then
		pedestal.model:Destroy()
	end
	pedestal.record = record
	pedestal.taken = false
	local zone = Items.ZONES[index]
	local kind = Items.KINDS[zone.kind]
	local color = Rarities.info[record.rarity].color
	-- A new place on the ground for it.
	pedestal.spot = pickSpot(index, record.rarity, zones[index].pedestals)
	pedestal.base.CFrame = pedestal.spot * CFrame.new(0, 0.5, 0)
	pedestal.ring.CFrame = pedestal.spot * CFrame.new(0, 0.07, 0) * CFrame.Angles(0, 0, math.pi / 2)
	pedestal.ring.Transparency = 0.35
	local model, height = EggModel.build(index, record.item)
	local factor = Items.weightFactor(record)
	local scale = Items.weightScale(factor)
	Items.scaleModel(model, scale)
	model:PivotTo(pedestal.spot * CFrame.Angles(0, math.rad(180 + (rng:NextNumber() - 0.5) * 40), 0))
	-- The ring fits round the egg and the floating text clears its top, however big it is.
	pedestal.ring.Size = Vector3.new(0.12, 3.6 * scale + 1.6, 3.6 * scale + 1.6)
	pedestal.labels.gui.StudsOffset = Vector3.new(0, 2.5 + height * scale, 0)
	local top = Mutations.top(record.mutations)
	if top and model.PrimaryPart then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Mutations.byId[top].color
		sparkles.Parent = model.PrimaryPart
	end
	model.Parent = pedestal.base.Parent
	pedestal.model = model
	pedestal.ring.Color = color
	pedestal.labels.rarity.Text = string.upper(record.rarity)
	pedestal.labels.rarity.TextColor3 = color
	pedestal.labels.name.Text = kind.icon .. " " .. ZoneService.eggName(record)
	pedestal.labels.name.TextColor3 = Items.weightColor(factor)
	pedestal.labels.income.Text = "⚖ "
		.. Format.weight(record.weight)
		.. " · ⏱ "
		.. Format.time(Items.HATCH_SECONDS[record.rarity])
	pedestal.labels.gui.Enabled = true

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GrabPrompt"
	prompt.ActionText = "Grab"
	prompt.ObjectText = record.rarity .. " " .. ZoneService.eggName(record)
	prompt.HoldDuration = Config.GRAB_HOLD_SECONDS
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Zone", index)
	prompt:SetAttribute("Pedestal", table.find(zones[index].pedestals, pedestal))
	prompt.Parent = pedestal.base

	if Rarities.rank[record.rarity] >= Rarities.rank.Ultra or top == "Rainbow" or factor >= 10 then
		for _, player in Players:GetPlayers() do
			notifyRemote:FireClient(
				player,
				"🥚 A "
					.. Format.weight(record.weight)
					.. " "
					.. string.upper(record.rarity)
					.. " "
					.. ZoneService.eggName(record)
					.. " just appeared in "
					.. zone.name
					.. "!",
				"discovery"
			)
		end
	end
end

local function clearPedestal(pedestal)
	if pedestal.model then
		pedestal.model:Destroy()
		pedestal.model = nil
	end
	local prompt = pedestal.base:FindFirstChild("GrabPrompt")
	if prompt then
		-- Destroyed a moment later: other PromptTriggered handlers may still be looking at it.
		prompt.Enabled = false
		prompt.Name = "OldGrabPrompt"
		task.defer(prompt.Destroy, prompt)
	end
	pedestal.record = nil
	pedestal.ring.Transparency = 1
	pedestal.labels.gui.Enabled = false
end

-- Takes the egg off a pedestal for someone to carry. Returns its record, or nil if there's
-- nothing there.
function ZoneService.take(index: number, n: number)
	local zone = zones[index]
	local pedestal = zone and zone.pedestals[n]
	if not pedestal or not pedestal.record or pedestal.taken then
		return nil
	end
	local record = pedestal.record
	clearPedestal(pedestal)
	pedestal.taken = true
	return record
end

-- The carried egg was delivered or dropped: the pedestal can grow a new one.
function ZoneService.release(index: number?, n: number?)
	local zone = index and zones[index]
	local pedestal = zone and n and zone.pedestals[n]
	if pedestal then
		pedestal.taken = false
		pedestal.respawnAt = os.clock() + rng:NextNumber(RESPAWN_MIN, RESPAWN_MAX) / Events.boost("respawnBoost")
	end
end

-- Fills every empty pedestal of zone `index` right away (admin). With a rarity, only one
-- egg of that rarity.
function ZoneService.spawnNow(index: number, rarity: string?, mutations: { string }?)
	local zone = zones[index]
	if not zone then
		return
	end
	for _, pedestal in zone.pedestals do
		if not pedestal.taken then
			local record = rollEgg(index)
			if rarity then
				record.rarity = rarity
				record.mutations = Mutations.pack(mutations)
			end
			showEgg(index, pedestal, record)
			if rarity then
				return
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Guardians
--------------------------------------------------------------------------------

local guardianFolder

local function rootPart(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function newGuardian(index: number)
	local home = ZoneLayout.guardianHome(index)
	local zone = Items.ZONES[index]
	local data = Instance.new("Configuration")
	data.Name = "Guardian" .. index
	data:SetAttribute("Zone", index)
	data:SetAttribute("Species", zone.guardian)
	data:SetAttribute("Title", zone.title)
	data.Parent = guardianFolder
	return {
		index = index,
		position = home,
		home = home,
		yaw = -math.pi / 2, -- facing the entrance (+X)
		target = nil,
		cooldown = 0,
		wanderAt = 0,
		wanderTo = home,
		speed = Items.guardianSpeed(index),
		data = data,
		moving = false,
	}
end

-- Sends a guardian after a player right away (they just grabbed an egg).
function ZoneService.alert(index: number, player: Player)
	local zone = zones[index]
	if zone and zone.guardian.cooldown <= os.clock() then
		zone.guardian.target = player
	end
end

local function flatten(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function catch(guardian, player: Player, root: BasePart)
	local zone = Items.ZONES[guardian.index]
	guardian.target = nil
	guardian.cooldown = os.clock() + 2.5
	hooks.drop(player, zone.title .. " caught you! You dropped the egg.")
	-- Fling them back toward town, along the zone and a little toward its middle, in a low
	-- arc (well under the side walls, which also have invisible barriers above them).
	local toMiddle = math.clamp(-root.Position.Z / (ZoneLayout.WIDTH / 2), -1, 1) * 0.3
	local direction = Vector3.new(1, 0, toMiddle).Unit
	knockbackRemote:FireClient(player, direction + Vector3.new(0, 0.25, 0), 80, 0.35)
end

local function stepGuardian(guardian, dt: number)
	local now = os.clock()
	local target = guardian.target
	local targetRoot = target and rootPart(target)
	-- Give up on anyone who got away, isn't carrying anything, or left.
	if
		target
		and (
			not targetRoot
			or not hooks.carrying(target)
			or not ZoneLayout.inside(guardian.index, targetRoot.Position, LEASH)
			or not target.Parent
		)
	then
		guardian.target = nil
		target, targetRoot = nil, nil
	end
	-- Look for thieves in the zone.
	if not target and guardian.cooldown <= now then
		local best, bestDistance = nil, math.huge
		for _, player in Players:GetPlayers() do
			local root = rootPart(player)
			if root and hooks.carrying(player) and ZoneLayout.inside(guardian.index, root.Position) then
				local distance = (flatten(root.Position) - guardian.position).Magnitude
				if distance < bestDistance then
					best, bestDistance = player, distance
				end
			end
		end
		if best then
			guardian.target = best
			target, targetRoot = best, rootPart(best)
		end
	end

	local goal, speed
	if target and targetRoot then
		goal = flatten(targetRoot.Position)
		speed = guardian.speed * Events.boost("guardianSpeed")
	else
		-- Patrol: mostly round its home at the back, now and then out across the zone.
		if now >= guardian.wanderAt then
			guardian.wanderAt = now + rng:NextNumber(3, 6)
			if rng:NextNumber() < 0.6 then
				local a = rng:NextNumber() * math.pi * 2
				guardian.wanderTo = guardian.home
					+ Vector3.new(math.cos(a), 0, math.sin(a)) * rng:NextNumber(0, ZoneLayout.RING)
			else
				guardian.wanderTo = ZoneLayout.point(
					guardian.index,
					rng:NextNumber(30, ZoneLayout.length(guardian.index) - 10),
					rng:NextNumber(-ZoneLayout.WIDTH / 2 + 12, ZoneLayout.WIDTH / 2 - 12)
				)
			end
		end
		goal = guardian.wanderTo
		speed = guardian.speed * 0.45
	end
	local offset = goal - guardian.position
	local distance = offset.Magnitude
	guardian.moving = distance > 0.5
	if guardian.moving then
		local step = math.min(distance, speed * dt)
		guardian.position += offset.Unit * step
		guardian.yaw = math.atan2(-offset.X, -offset.Z)
	end
	if target and targetRoot and (flatten(targetRoot.Position) - guardian.position).Magnitude < CATCH_RADIUS then
		catch(guardian, target, targetRoot)
	end
end

local function publish(guardian)
	local data = guardian.data
	data:SetAttribute("X", math.floor(guardian.position.X * 10) / 10)
	data:SetAttribute("Z", math.floor(guardian.position.Z * 10) / 10)
	data:SetAttribute("Yaw", math.floor(guardian.yaw * 100) / 100)
	data:SetAttribute("Moving", guardian.moving)
	data:SetAttribute("Chasing", guardian.target ~= nil)
	data:SetAttribute("Speed", guardian.speed)
end

-- StealService tells us how to check and end carries (it requires this module).
function ZoneService.setCarrierHooks(newHooks)
	hooks = newHooks
end

function ZoneService.init()
	local map = Instance.new("Folder")
	map.Name = "Zones"
	map.Parent = Workspace
	guardianFolder = Instance.new("Folder")
	guardianFolder.Name = "Guardians"
	guardianFolder.Parent = ReplicatedStorage

	for index = 1, #Items.ZONES do
		local folder = ZoneDecor.build(map, index)
		local pile = Instance.new("Folder")
		pile.Name = "Eggs"
		pile.Parent = folder
		local zone = { pedestals = {}, guardian = newGuardian(index) }
		zones[index] = zone
		for n = 1, ZoneLayout.eggCount(index) do
			zone.pedestals[n] = buildPedestal(pile, index, n)
		end
		for _, pedestal in zone.pedestals do
			showEgg(index, pedestal, rollEgg(index))
		end
		publish(zone.guardian)
	end

	-- Every frame (task.wait() resumes on Heartbeat). Guarded so one bad step can't stop
	-- the guardians for the rest of the server.
	task.spawn(function()
		while true do
			local dt = task.wait()
			for _, zone in zones do
				local ok, err = pcall(stepGuardian, zone.guardian, math.min(dt, 0.1))
				if not ok then
					warn("[ZoneService] " .. tostring(err))
				end
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(PUBLISH_INTERVAL)
			for _, zone in zones do
				publish(zone.guardian)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for index, zone in zones do
				for _, pedestal in zone.pedestals do
					if not pedestal.record and not pedestal.taken and now >= pedestal.respawnAt then
						showEgg(index, pedestal, rollEgg(index))
					end
				end
			end
		end
	end)
end

return ZoneService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="51">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="52">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="53">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">AdminPanel</string>
            <string name="Source"><![CDATA[-- The admin panel (only for admins: the server sets IsAdmin and checks every command).
-- Start or end events in this server or all of them, fill a zone's pile with any part,
-- announce something to everyone, see the coming timetable, and get test coins.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Events = require(ReplicatedStorage.Shared.Events)
local Items = require(ReplicatedStorage.Shared.Items)
local Luck = require(ReplicatedStorage.Shared.Luck)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UI = require(script.Parent.UI)

local AdminPanel = {}

local player = Players.LocalPlayer
local colors = UI.colors

-- Every event the panel can start, in the order its buttons appear.
local EVENT_BUTTONS = {
	{ id = "GuardianNap", def = Events.BIG.GuardianNap },
	{ id = "BloodMoon", def = Events.WEATHER.BloodMoon },
	{ id = "GoldRush", def = Events.WEATHER.GoldRush },
	{ id = "RainbowRain", def = Events.WEATHER.RainbowRain },
	{ id = "Rainbow", def = Luck.EVENTS.Rainbow },
	{ id = "LuckySkies", def = Luck.EVENTS.LuckySkies },
	{ id = "RapidFire", def = Luck.EVENTS.RapidFire },
	{ id = "CrateLuck", def = Luck.EVENTS.CrateLuck },
}
local DURATIONS = { 5, 15, 30, 60 }

local function heading(text: string, parent: Instance, order: number)
	return UI.label(text, {
		Size = UDim2.new(1, 0, 0, 24),
		FontFace = UI.fonts.heavy,
		TextColor3 = colors.gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function row(parent: Instance, order: number, height: number)
	return UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

function AdminPanel.start(screen: ScreenGui)
	local remote = Remotes.get("Admin")
	local window
	local status

	local function run(command: string, args)
		status.Text = "..."
		status.TextColor3 = colors.text
		task.spawn(function()
			local ok, result, message = pcall(function()
				return remote:InvokeServer(command, args)
			end)
			if not ok then
				status.Text = "Couldn't reach the server"
				status.TextColor3 = colors.red
				return
			end
			status.Text = tostring(message or (if result then "Done" else "Failed"))
			status.TextColor3 = if result then colors.money else Color3.fromRGB(255, 140, 140)
		end)
	end

	-- The window, in the game's style: blue panel, gold title ribbon, round red X.
	window = UI.glass({
		Name = "AdminPanel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(600, 520),
		Visible = false,
		ZIndex = 20,
		Parent = screen,
	}, { UI.corner(22) })
	local fit = UI.new("UIScale", { Parent = window })
	local function refit()
		local camera = Workspace.CurrentCamera
		if camera then
			fit.Scale = math.clamp(math.min(camera.ViewportSize.X / 640, camera.ViewportSize.Y / 600), 0.5, 1)
		end
	end
	refit()
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refit)
	local ribbon = UI.glass({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 2),
		Size = UDim2.fromOffset(280, 48),
		BackgroundColor3 = Color3.fromRGB(255, 190, 40),
		ZIndex = 21,
		Parent = window,
	}, { UI.corner(24) })
	UI.label("ADMIN PANEL", {
		Size = UDim2.new(1, -20, 1, -8),
		Position = UDim2.fromOffset(10, 4),
		FontFace = UI.fonts.heavy,
		ZIndex = 22,
		Parent = ribbon,
	})
	local close = UI.button("X", colors.red, function()
		window.Visible = false
	end, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(44, 44),
		ZIndex = 22,
		Parent = window,
	})
	close:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)

	local body = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(16, 34),
		Size = UDim2.new(1, -32, 1, -78),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ZIndex = 21,
		Parent = window,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		UI.new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 6) }),
	})
	status = UI.label("Pick an event, or spawn some eggs!", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.new(1, -32, 0, 26),
		ZIndex = 22,
		Parent = window,
	})

	-- Everywhere or just this server, used by events and announcements.
	local everywhere = true

	-- Events --------------------------------------------------------------------
	heading("⚡ START AN EVENT", body, 1)
	local chosenEvent = EVENT_BUTTONS[1].id
	local eventButtons = {}
	local grid = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 82),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = body,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.new(0.25, -6, 0, 38),
			CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local function paintEvents()
		for id, button in eventButtons do
			local entry
			for _, e in EVENT_BUTTONS do
				if e.id == id then
					entry = e
				end
			end
			local picked = id == chosenEvent
			button.BackgroundColor3 = if picked then entry.def.color else colors.card
			button:FindFirstChildOfClass("UIStroke").Color = if picked then Color3.new(1, 1, 1) else UI.OUTLINE
		end
	end
	for i, entry in EVENT_BUTTONS do
		eventButtons[entry.id] = UI.button(entry.def.icon .. " " .. entry.def.name, colors.card, function()
			chosenEvent = entry.id
			paintEvents()
		end, { LayoutOrder = i, ZIndex = 22, Parent = grid })
	end
	paintEvents()

	local minutes = 15
	local timeRow = row(body, 3, 36)
	UI.label("Length:", {
		Size = UDim2.fromOffset(70, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 22,
		Parent = timeRow,
	})
	local timeButtons = {}
	local function paintTimes()
		for value, button in timeButtons do
			button.BackgroundColor3 = if value == minutes then colors.orange else colors.card
		end
	end
	for i, value in DURATIONS do
		timeButtons[value] = UI.button(value .. " min", colors.card, function()
			minutes = value
			paintTimes()
		end, { Size = UDim2.fromOffset(78, 32), LayoutOrder = i, ZIndex = 22, Parent = timeRow })
	end
	paintTimes()
	local whereButton
	whereButton = UI.button("ALL SERVERS", colors.purple, function()
		everywhere = not everywhere
		whereButton.Text = if everywhere then "ALL SERVERS" else "THIS SERVER"
		whereButton.BackgroundColor3 = if everywhere then colors.purple else colors.blue
	end, { Size = UDim2.fromOffset(150, 32), LayoutOrder = 10, ZIndex = 22, Parent = timeRow })

	local goRow = row(body, 4, 44)
	UI.button("▶ START", colors.green, function()
		run("event", { id = chosenEvent, minutes = minutes, everywhere = everywhere })
	end, { Size = UDim2.new(0.5, -3, 0, 40), LayoutOrder = 1, ZIndex = 22, Parent = goRow })
	UI.button("■ END EVENTS", colors.red, function()
		run("stop", { everywhere = everywhere })
	end, { Size = UDim2.new(0.5, -3, 0, 40), LayoutOrder = 2, ZIndex = 22, Parent = goRow })

	-- Spawn eggs -----------------------------------------------------------------
	heading("🥚 SPAWN EGGS IN A ZONE (THIS SERVER)", body, 5)
	local zoneIds = {}
	for index in Items.ZONES do
		table.insert(zoneIds, index)
	end
	local styleIds = { "" }
	for _, rarity in Rarities.order do
		table.insert(styleIds, rarity)
	end
	local zoneIndex, styleIndex = 1, 1
	local mutationIds = { "" }
	for _, mutation in Mutations.list do
		table.insert(mutationIds, mutation.id)
	end
	local mutationIndex = 1
	local cannonRow = row(body, 6, 44)
	local function cycler(values, getIndex, setIndex, describe, order, width)
		local label
		local function show()
			label.Text = describe(values[getIndex()])
		end
		UI.button("<", colors.blue, function()
			setIndex((getIndex() - 2) % #values + 1)
			show()
		end, { Size = UDim2.fromOffset(34, 36), LayoutOrder = order, ZIndex = 22, Parent = cannonRow })
		label = UI.label("", {
			Size = UDim2.fromOffset(width, 36),
			BackgroundTransparency = 0,
			BackgroundColor3 = colors.card,
			LayoutOrder = order + 1,
			ZIndex = 22,
			Parent = cannonRow,
		})
		UI.corner(10).Parent = label
		UI.stroke(nil, 2.5).Parent = label
		UI.button(">", colors.blue, function()
			setIndex(getIndex() % #values + 1)
			show()
		end, { Size = UDim2.fromOffset(34, 36), LayoutOrder = order + 2, ZIndex = 22, Parent = cannonRow })
		show()
	end
	cycler(zoneIds, function()
		return zoneIndex
	end, function(v)
		zoneIndex = v
	end, function(index)
		return Items.ZONES[index].name
	end, 1, 120)
	cycler(styleIds, function()
		return styleIndex
	end, function(v)
		styleIndex = v
	end, function(id)
		return if id == "" then "Fill all" else id
	end, 4, 90)
	cycler(mutationIds, function()
		return mutationIndex
	end, function(v)
		mutationIndex = v
	end, function(id)
		return if id == "" then "No mutation" else id
	end, 7, 90)
	UI.button("GO!", colors.orange, function()
		local mutation = mutationIds[mutationIndex]
		local rarity = styleIds[styleIndex]
		run("spawn", {
			zone = zoneIds[zoneIndex],
			rarity = if rarity == "" then nil else rarity,
			mutation = if mutation == "" then nil else mutation,
		})
	end, { Size = UDim2.fromOffset(64, 40), LayoutOrder = 10, ZIndex = 22, Parent = cannonRow })

	-- Announce ------------------------------------------------------------------
	heading("📣 ANNOUNCE (USES THE SERVER BUTTON ABOVE)", body, 7)
	local announceRow = row(body, 8, 44)
	local box = UI.new("TextBox", {
		Size = UDim2.new(1, -110, 0, 38),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		FontFace = UI.fonts.bold,
		PlaceholderText = "Guardian Nap in 5 minutes!",
		PlaceholderColor3 = Color3.fromRGB(140, 150, 180),
		Text = "",
		TextColor3 = UI.OUTLINE,
		TextSize = 18,
		ClearTextOnFocus = false,
		LayoutOrder = 1,
		ZIndex = 22,
		Parent = announceRow,
	}, { UI.corner(10), UI.stroke(nil, 2.5), UI.new("UIPadding", { PaddingLeft = UDim.new(0, 10) }) })
	UI.button("SEND", colors.green, function()
		run("announce", { text = box.Text, everywhere = everywhere })
		box.Text = ""
	end, { Size = UDim2.fromOffset(100, 40), LayoutOrder = 2, ZIndex = 22, Parent = announceRow })

	-- Timetable and test coins --------------------------------------------------
	heading("🗓️ COMING UP (YOUR LOCAL TIME)", body, 9)
	local schedule = UI.label("", {
		Size = UDim2.new(1, 0, 0, 66),
		TextScaled = false,
		TextSize = 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 10,
		ZIndex = 22,
		Parent = body,
	})
	local function refreshSchedule()
		local lines = {}
		local t = os.time()
		for i, slot in Events.upcoming(t) do
			if i > 3 then
				break
			end
			local def = Events.BIG[slot.id]
			local when = os.date("%a %I:%M %p", slot.starts)
			table.insert(
				lines,
				def.icon .. " " .. def.name .. " · " .. when .. if slot.starts <= t then "  (LIVE)" else ""
			)
		end
		local weather = Events.nextWeather(t)
		if weather then
			local def = Events.WEATHER[weather.id]
			table.insert(lines, def.icon .. " " .. def.name .. " · " .. os.date("%I:%M %p", weather.starts))
		end
		schedule.Text = table.concat(lines, "\n")
	end

	local coinRow = row(body, 11, 44)
	for i, amount in { 1e6, 1e9 } do
		UI.button("+" .. (if amount >= 1e9 then "1B" else "1M") .. " COINS", colors.gold, function()
			run("money", { amount = amount })
		end, { Size = UDim2.fromOffset(150, 38), LayoutOrder = i, ZIndex = 22, Parent = coinRow })
	end

	-- The ADMIN button that opens it, only shown to admins.
	local toggle = UI.button("🛠️ ADMIN", colors.red, function()
		window.Visible = not window.Visible
		if window.Visible then
			refreshSchedule()
		end
	end, {
		Name = "AdminButton",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(120, 38),
		Visible = false,
		ZIndex = 10,
		Parent = screen,
	})
	local function update()
		toggle.Visible = player:GetAttribute("IsAdmin") == true
		if not toggle.Visible then
			window.Visible = false
		end
	end
	player:GetAttributeChangedSignal("IsAdmin"):Connect(update)
	update()
	return window
end

return AdminPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Ambient</string>
            <string name="Source"><![CDATA[-- Flies event creatures (ghosts and bats placed by the server's seasonal themes) along their
-- circles, locally on each client so they move smoothly. Only nearby creatures animate.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Ambient = {}

local GHOST_TAG = "SpookyGhost"
local BAT_TAG = "SpookyBat"
local RANGE = 260

-- Position on the creature's circle at time t, facing the way it's flying.
local function pathCFrame(model: Model, t: number, bob: number): CFrame?
	local center = model:GetAttribute("Center")
	if typeof(center) ~= "Vector3" then
		return nil
	end
	local radius = model:GetAttribute("Radius") or 10
	local height = model:GetAttribute("Height") or 10
	local speed = model:GetAttribute("Speed") or 0.3
	local angle = t * speed + (model:GetAttribute("Phase") or 0)
	local position = center + Vector3.new(math.cos(angle) * radius, height + bob, math.sin(angle) * radius)
	-- Direction of travel is the tangent of the circle.
	local ahead = Vector3.new(-math.sin(angle), 0, math.cos(angle)) * math.sign(speed)
	return CFrame.lookAt(position, position + ahead)
end

function Ambient.start()
	RunService.RenderStepped:Connect(function()
		local camera = Workspace.CurrentCamera
		local eye = if camera then camera.CFrame.Position else Vector3.zero
		local t = os.clock()

		for _, ghost in CollectionService:GetTagged(GHOST_TAG) do
			local phase = ghost:GetAttribute("Phase") or 0
			local where = pathCFrame(ghost, t, math.sin(t * 1.4 + phase) * 1.5)
			if where and (where.Position - eye).Magnitude < RANGE then
				-- Gentle side-to-side wobble while drifting.
				ghost:PivotTo(where * CFrame.Angles(0, 0, math.sin(t * 2 + phase) * math.rad(8)))
			end
		end

		for _, bat in CollectionService:GetTagged(BAT_TAG) do
			local phase = bat:GetAttribute("Phase") or 0
			local where = pathCFrame(bat, t, math.sin(t * 3 + phase) * 0.8)
			local body = bat.PrimaryPart
			if where and body and (where.Position - eye).Magnitude < RANGE then
				bat:PivotTo(where)
				local flap = math.sin(t * 18 + phase) * math.rad(40)
				local left, right = bat:FindFirstChild("WingL"), bat:FindFirstChild("WingR")
				if left and right then
					left.CFrame = body.CFrame
						* CFrame.new(-0.45, 0, 0)
						* CFrame.Angles(0, 0, -flap)
						* CFrame.new(-1.1, 0, 0)
					right.CFrame = body.CFrame
						* CFrame.new(0.45, 0, 0)
						* CFrame.Angles(0, 0, flap)
						* CFrame.new(1.1, 0, 0)
				end
			end
		end
	end)
end

return Ambient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">EventFX</string>
            <string name="Source"><![CDATA[-- What big events and weather look like (see Events.luau), on each player's own screen:
-- a colour tint over everything, falling rain or sparkles around the camera, and lightning
-- flashes during a Monster Storm.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Events = require(ReplicatedStorage.Shared.Events)

local EventFX = {}

local LOOKS = {
	-- Guardian Nap: a dreamy purple dusk with soft sparkles drifting down.
	GuardianNap = {
		tint = Color3.fromRGB(210, 195, 255),
		brightness = -0.04,
		rain = Color3.fromRGB(205, 185, 255),
	},
	BloodMoon = { tint = Color3.fromRGB(255, 165, 170), brightness = -0.04, rain = Color3.fromRGB(255, 80, 90) },
	GoldRush = { tint = Color3.fromRGB(255, 238, 180), brightness = 0.03, rain = Color3.fromRGB(255, 215, 80) },
	RainbowRain = { tint = Color3.fromRGB(255, 225, 255), brightness = 0.02, rain = "rainbow" },
}

function EventFX.start()
	local tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "EventTint"
	tint.Parent = Lighting

	-- A big invisible sheet over the camera that rain (or sparkles) falls from.
	local sky = Instance.new("Part")
	sky.Name = "EventSky"
	sky.Anchored = true
	sky.CanCollide = false
	sky.CanQuery = false
	sky.CanTouch = false
	sky.Transparency = 1
	sky.Size = Vector3.new(120, 1, 120)
	local rain = Instance.new("ParticleEmitter")
	rain.Rate = 0
	rain.Lifetime = NumberRange.new(1.6, 2.2)
	rain.Speed = NumberRange.new(30, 40)
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.Size = NumberSequence.new(0.35)
	rain.LightEmission = 0.6
	rain.Parent = sky
	sky.Parent = Workspace

	local nextFlash = 0
	task.spawn(function()
		while true do
			local big, _, bigId = Events.current()
			local weather, _, weatherId = Events.weather()
			-- A big event's look wins over the weather's.
			local look = (big and LOOKS[bigId]) or (weather and LOOKS[weatherId])
			local camera = Workspace.CurrentCamera
			if camera then
				sky.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 40, 0))
			end
			local target = if look then look.tint else Color3.new(1, 1, 1)
			local brightness = if look then look.brightness else 0
			if look and look.rain == "rainbow" then
				target = Color3.fromHSV((os.clock() * 0.1) % 1, 0.12, 1)
			end
			tint.TintColor = tint.TintColor:Lerp(target, 0.05)
			if look and look.lightning and os.clock() >= nextFlash then
				nextFlash = os.clock() + 3 + math.random() * 5
				tint.Brightness = 0.45 -- the flash, which fades below
			end
			tint.Brightness += (brightness - tint.Brightness) * 0.12
			if look then
				rain.Rate = if look.lightning then 300 else 120
				if look.rain == "rainbow" then
					rain.Color = ColorSequence.new(Color3.fromHSV((os.clock() * 0.3) % 1, 0.6, 1))
				else
					rain.Color = ColorSequence.new(look.rain)
				end
			else
				rain.Rate = 0
			end
			task.wait(1 / 30)
		end
	end)
end

return EventFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">GuardianFX</string>
            <string name="Source"><![CDATA[-- The zone guardians, drawn on this client: a giant Freek per zone that walks after its
-- target. The server keeps each guardian as plain data on ReplicatedStorage.Guardians
-- (X, Z, Yaw, Moving, Chasing, Speed); this builds the model once, glides it toward the
-- latest position every frame (so it moves smoothly between the server's updates) and
-- animates it walking or idling with FreekAnimator. A name tag shows over its head, red
-- and angry while it's chasing someone.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local FreekAnimator = require(ReplicatedStorage.Shared.FreekAnimator)
local FreekModel = require(ReplicatedStorage.Shared.FreekModel)
local Lego = require(ReplicatedStorage.Shared.Lego)

local GuardianFX = {}

local SCALE = 3.4
local OUTLINE = Color3.fromRGB(20, 22, 48)

-- Builds a Freek scaled up round its pivot.
local function giant(species: string): (Model, number)
	local model, height = FreekModel.build(species)
	local pivot = model:GetPivot()
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			local rel = pivot:ToObjectSpace(p.CFrame)
			p.Size *= SCALE
			p.CFrame = pivot * (rel.Rotation + rel.Position * SCALE)
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
		end
	end
	Lego.apply(model)
	return model, height * SCALE
end

local function nameTag(parent: BasePart, title: string, height: number)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(12, 2.4)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height - (parent.Position.Y - 0) + 2, 0)
	gui.MaxDistance = 160
	gui.LightInfluence = 0
	gui.Parent = parent
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.Text = string.upper(title)
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = OUTLINE
	stroke.Thickness = 3
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	return label
end

local guardians = {} -- [Configuration] = { model, rig, position, yaw, label }

local function add(data: Instance)
	if guardians[data] or not data:IsA("Configuration") then
		return
	end
	local species = data:GetAttribute("Species")
	if typeof(species) ~= "string" then
		return
	end
	local model, height = giant(species)
	local position = Vector3.new(data:GetAttribute("X") or 0, 0, data:GetAttribute("Z") or 0)
	local yaw = data:GetAttribute("Yaw") or 0
	local home = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
	model:PivotTo(home)
	model.Name = "Guardian_" .. species
	model.Parent = Workspace
	local anchor = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	local label = anchor and nameTag(anchor, data:GetAttribute("Title") or species, height)
	guardians[data] = {
		model = model,
		rig = FreekAnimator.rig(model, (data:GetAttribute("Zone") or 1) * 17, home),
		position = position,
		yaw = yaw,
		label = label,
	}
end

local function step(dt: number)
	local t = os.clock()
	for data, g in guardians do
		if not data.Parent then
			g.model:Destroy()
			guardians[data] = nil
			continue
		end
		local target = Vector3.new(data:GetAttribute("X") or 0, 0, data:GetAttribute("Z") or 0)
		local speed = (data:GetAttribute("Speed") or 16) * 1.25
		local offset = target - g.position
		local distance = offset.Magnitude
		if distance > 30 then
			g.position = target -- too far behind (e.g. just streamed in): jump there
		elseif distance > 0.01 then
			g.position += offset.Unit * math.min(distance, speed * dt)
		end
		-- Turn smoothly toward the server's heading.
		local goalYaw = data:GetAttribute("Yaw") or g.yaw
		local diff = (goalYaw - g.yaw + math.pi) % (2 * math.pi) - math.pi
		g.yaw += diff * math.min(1, dt * 10)
		local ground = CFrame.new(g.position) * CFrame.Angles(0, g.yaw, 0)
		local walking = data:GetAttribute("Moving") == true
		if g.rig then
			FreekAnimator.pose(g.rig, ground, t * (if data:GetAttribute("Chasing") then 1.6 else 1), walking)
		else
			g.model:PivotTo(ground)
		end
		if g.label then
			local chasing = data:GetAttribute("Chasing") == true
			g.label.TextColor3 = if chasing then Color3.fromRGB(255, 80, 80) else Color3.new(1, 1, 1)
			local title = string.upper(data:GetAttribute("Title") or "")
			g.label.Text = if chasing then "😡 " .. title else title
		end
	end
end

function GuardianFX.start()
	local folder = ReplicatedStorage:WaitForChild("Guardians", 30)
	if not folder then
		return
	end
	for _, data in folder:GetChildren() do
		task.spawn(add, data)
	end
	folder.ChildAdded:Connect(add)
	RunService.RenderStepped:Connect(step)
end

return GuardianFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- The always-on-screen parts of the UI: money, Speed, event chip, menu buttons, leaderboard,
-- the zone banner, the carrying banner and pop-up notifications. Windows (Shop, My Life,
-- Bag, ...) live in Main.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Events = require(ReplicatedStorage.Shared.Events)
local Format = require(ReplicatedStorage.Shared.Format)
local GamePasses = require(ReplicatedStorage.Shared.GamePasses)
local Luck = require(ReplicatedStorage.Shared.Luck)
local Items = require(ReplicatedStorage.Shared.Items)
local Seasons = require(ReplicatedStorage.Shared.Seasons)
local ZoneLayout = require(ReplicatedStorage.Shared.ZoneLayout)
local ItemPictures = require(script.Parent.ItemPictures)
local UI = require(script.Parent.UI)

local colors = UI.colors
local player = Players.LocalPlayer

local Hud = {}

local function text(value: string, size: number, props)
	local label = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = UI.fonts.bold,
		Text = value,
		TextSize = size,
		TextColor3 = colors.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, { UI.textStroke(if size >= 22 then 2.5 else 1.8) })
	for key, v in props or {} do
		label[key] = v
	end
	return label
end

-- Scales a frame down on short screens (phones) so it never runs off the edge.
local function fitHeight(frame: GuiObject, designHeight: number, reserved: number)
	local scale = UI.new("UIScale", { Parent = frame })
	local function update()
		local camera = Workspace.CurrentCamera
		local available = camera.ViewportSize.Y - reserved
		scale.Scale = math.clamp(available / designHeight, 0.55, 1)
	end
	update()
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
end

local function hoverGrow(button: GuiButton)
	local scale = UI.new("UIScale", { Parent = button })
	local info = TweenInfo.new(0.12, Enum.EasingStyle.Quad)
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, info, { Scale = 1.06 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, info, { Scale = 1 }):Play()
	end)
end

--------------------------------------------------------------------------------
-- Money
--------------------------------------------------------------------------------

function Hud.money(screen: ScreenGui)
	local pill = UI.glass({
		Name = "Money",
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(250, 62),
		BackgroundColor3 = Color3.fromRGB(40, 165, 75),
		Parent = screen,
	}, { UI.corner(20) })

	UI.new("Frame", {
		Name = "Coin",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = colors.gold,
		Parent = pill,
	}, {
		UI.corner(20),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 226, 120), Color3.fromRGB(235, 150, 30)),
			Rotation = 90,
		}),
		UI.stroke(nil, 3),
		text("$", 24, {
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			FontFace = UI.fonts.heavy,
			TextColor3 = Color3.fromRGB(120, 70, 10),
		}),
	})

	local amount = text("$0", 30, {
		Position = UDim2.fromOffset(60, 4),
		Size = UDim2.new(1, -116, 0, 32),
		FontFace = UI.fonts.heavy,
		TextColor3 = colors.money,
		Parent = pill,
	})
	local income = text("+$0/s", 15, {
		Position = UDim2.fromOffset(60, 35),
		Size = UDim2.new(1, -116, 0, 18),
		TextColor3 = Color3.fromRGB(255, 240, 150),
		Parent = pill,
	})
	-- The number glides to its new value instead of jumping.
	local shown = player:GetAttribute("Money") or 0
	RunService.RenderStepped:Connect(function(dt)
		local target = player:GetAttribute("Money") or 0
		shown += (target - shown) * math.min(1, dt * 8)
		if math.abs(target - shown) < 1 then
			shown = target
		end
		amount.Text = Format.money(shown)
	end)
	local function updateIncome()
		income.Text = "+" .. Format.money(player:GetAttribute("Income") or 0) .. "/s"
	end
	player:GetAttributeChangedSignal("Income"):Connect(updateIncome)
	updateIncome()
end

--------------------------------------------------------------------------------
-- Speed
--------------------------------------------------------------------------------

-- A blue pill next to the money: your Speed (trained on the treadmill) and how fast you
-- run. While you're training it glows and shows +speed a second.
function Hud.speed(screen: ScreenGui)
	local pill = UI.glass({
		Name = "Speed",
		Position = UDim2.fromOffset(270, 12),
		Size = UDim2.fromOffset(200, 62),
		BackgroundColor3 = Color3.fromRGB(50, 130, 245),
		Parent = screen,
	}, { UI.corner(20) })
	text("⚡", 32, {
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.fromOffset(40, 62),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = pill,
	})
	local amount = text("0", 28, {
		Position = UDim2.fromOffset(52, 4),
		Size = UDim2.new(1, -60, 0, 32),
		FontFace = UI.fonts.heavy,
		TextColor3 = Color3.fromRGB(150, 230, 255),
		Parent = pill,
	})
	local run = text("🏃 16", 15, {
		Position = UDim2.fromOffset(52, 35),
		Size = UDim2.new(1, -60, 0, 18),
		TextColor3 = Color3.fromRGB(230, 240, 255),
		Parent = pill,
	})
	local ring = pill:FindFirstChildOfClass("UIStroke")
	local shown = 0
	local last, lastTime = nil, os.clock()
	local gain = 0
	RunService.RenderStepped:Connect(function(dt)
		local target = player:GetAttribute("Speed") or 0
		if last and target > last then
			gain = (target - last) / math.max(os.clock() - lastTime, 0.05)
		end
		if target ~= last then
			last, lastTime = target, os.clock()
		end
		shown += (target - shown) * math.min(1, dt * 8)
		if math.abs(target - shown) < 1 then
			shown = target
		end
		amount.Text = Format.number(shown)
		local training = player:GetAttribute("Training") == true
		if training then
			run.Text = "+" .. Format.number(gain) .. " ⚡/s  TRAINING!"
			run.TextColor3 = Color3.fromRGB(255, 235, 110)
			ring.Color = Color3.fromRGB(255, 230, 90):Lerp(UI.OUTLINE, (math.sin(os.clock() * 8) + 1) / 2)
		else
			run.Text = "🏃 Run speed " .. string.format("%.0f", Items.walkSpeed(target))
			run.TextColor3 = Color3.fromRGB(230, 240, 255)
			ring.Color = UI.OUTLINE
		end
	end)
end

--------------------------------------------------------------------------------
-- Zone banner
--------------------------------------------------------------------------------

-- Walking into a zone shows its name and the Speed it needs: green if you have it, a red
-- warning if its guardian will catch you.
function Hud.zoneBanner(screen: ScreenGui)
	local banner = UI.glass({
		Name = "ZoneBanner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.26),
		Size = UDim2.fromOffset(460, 96),
		Visible = false,
		Parent = screen,
	}, { UI.corner(22) })
	local name = text("", 40, {
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.new(1, 0, 0, 46),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = UI.fonts.heavy,
		Parent = banner,
	})
	local need = text("", 19, {
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = banner,
	})
	local scale = UI.new("UIScale", { Parent = banner })
	local current = nil
	local showId = 0
	task.spawn(function()
		while true do
			task.wait(0.2)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local zone = root and ZoneLayout.zoneAt(root.Position)
			if zone ~= current then
				current = zone
				if zone then
					local info = Items.ZONES[zone]
					local speed = player:GetAttribute("Speed") or 0
					local fast = speed >= info.speed
					local kind = Items.KINDS[info.kind]
					name.Text = kind.icon .. " " .. string.upper(info.name)
					name.TextColor3 = info.eggColor:Lerp(Color3.new(1, 1, 1), 0.3)
					if fast then
						need.Text = "⚡ You're fast enough! Grab an egg and run!"
						need.TextColor3 = colors.money
						banner.BackgroundColor3 = Color3.fromRGB(50, 150, 90)
					else
						need.Text = "⚠️ Needs ⚡"
							.. Format.number(info.speed)
							.. " Speed! "
							.. info.title
							.. " will catch you!"
						need.TextColor3 = Color3.fromRGB(255, 230, 230)
						banner.BackgroundColor3 = colors.red
					end
					showId += 1
					local id = showId
					banner.Visible = true
					scale.Scale = 0.4
					TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
					task.delay(3.5, function()
						if showId == id then
							banner.Visible = false
						end
					end)
				end
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Carrying
--------------------------------------------------------------------------------

-- While you carry an egg: a pulsing banner telling you to run home, and a glowing beam
-- from you to your gate so you never get lost.
function Hud.carrying(screen: ScreenGui)
	local banner = UI.glass({
		Name = "Carrying",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -160),
		Size = UDim2.fromOffset(0, 50),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Color3.fromRGB(255, 150, 40),
		Visible = false,
		Parent = screen,
	}, {
		UI.corner(25),
		UI.new("UIPadding", { PaddingLeft = UDim.new(0, 20), PaddingRight = UDim.new(0, 20) }),
	})
	local label = text("", 22, {
		Size = UDim2.fromOffset(0, 50),
		AutomaticSize = Enum.AutomaticSize.X,
		FontFace = UI.fonts.heavy,
		Parent = banner,
	})
	local beam, from, target
	local function clear()
		for _, thing in { beam, from, target } do
			if thing then
				thing:Destroy()
			end
		end
		beam, from, target = nil, nil, nil
	end
	local function update()
		local carrying = player:GetAttribute("Carrying")
		banner.Visible = typeof(carrying) == "string"
		clear()
		if typeof(carrying) ~= "string" then
			return
		end
		label.Text = "🥚  " .. string.upper(carrying) .. " · RUN HOME!"
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local plotIndex = player:GetAttribute("Plot")
		local plot = plotIndex
			and Workspace:FindFirstChild("Plots")
			and Workspace.Plots:FindFirstChild("Plot" .. plotIndex)
		local origin = plot and plot:GetAttribute("Origin")
		if root and typeof(origin) == "CFrame" then
			target = Instance.new("Part")
			target.Anchored = true
			target.CanCollide = false
			target.CanQuery = false
			target.Transparency = 1
			target.Size = Vector3.one
			target.CFrame = origin * CFrame.new(0, 3, -40)
			target.Parent = Workspace
			local a1 = Instance.new("Attachment")
			a1.Parent = target
			from = Instance.new("Attachment")
			from.Position = Vector3.new(0, -2, 0)
			from.Parent = root
			beam = Instance.new("Beam")
			beam.Attachment0 = from
			beam.Attachment1 = a1
			beam.Width0 = 0.8
			beam.Width1 = 0.8
			beam.FaceCamera = true
			beam.LightEmission = 1
			beam.Color = ColorSequence.new(Color3.fromRGB(110, 255, 140))
			beam.Transparency = NumberSequence.new(0.2)
			beam.Parent = target
		end
	end
	player:GetAttributeChangedSignal("Carrying"):Connect(update)
	update()
	-- Pulse.
	RunService.RenderStepped:Connect(function()
		if banner.Visible then
			banner.BackgroundColor3 = Color3.fromRGB(255, 150, 40):Lerp(colors.red, (math.sin(os.clock() * 6) + 1) / 2)
		end
	end)
end

--------------------------------------------------------------------------------
-- Event chip
--------------------------------------------------------------------------------

function Hud.eventChip(screen: ScreenGui)
	local chip = UI.glass({
		Name = "Event",
		Position = UDim2.fromOffset(12, 80),
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		Visible = false,
		Parent = screen,
	}, {
		UI.corner(14),
		UI.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 12) }),
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 7),
		}),
	})
	local dot = UI.new("Frame", { Size = UDim2.fromOffset(9, 9), Parent = chip }, { UI.corner(5) })
	local label = text("", 14, { Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, Parent = chip })

	local function update()
		local active = Seasons.active()
		local season = active[1] and Seasons.list[active[1]]
		chip.Visible = season ~= nil
		if season then
			dot.BackgroundColor3 = season.color
			label.Text = season.name .. " Event · Live"
			label.TextColor3 = season.color:Lerp(Color3.new(1, 1, 1), 0.35)
		end
	end
	update()
	task.spawn(function()
		while true do
			task.wait(60)
			update()
		end
	end)
end

-- Shows the Lucky Hour event that's running (see Luck.luau) with a countdown.
function Hud.luckChip(screen: ScreenGui)
	local chip = UI.glass({
		Name = "LuckyEvent",
		Position = UDim2.fromOffset(12, 114),
		Size = UDim2.fromOffset(0, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		Visible = false,
		Parent = screen,
	}, {
		UI.corner(15),
		UI.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 12) }),
	})
	local stroke = UI.stroke(Color3.new(1, 1, 1), 2)
	stroke.Parent = chip
	local label = text("", 15, {
		Size = UDim2.fromOffset(0, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		FontFace = UI.fonts.heavy,
		Parent = chip,
	})
	task.spawn(function()
		while true do
			local event, ends = Luck.current()
			chip.Visible = event ~= nil
			if event then
				local left = ends - Workspace:GetServerTimeNow()
				label.Text = event.icon .. "  " .. event.name .. " · " .. Format.time(left)
				label.TextColor3 = event.color:Lerp(Color3.new(1, 1, 1), 0.3)
				-- Pulse the outline so it catches the eye.
				stroke.Color = event.color
				stroke.Transparency = (math.sin(os.clock() * 4) + 1) * 0.3
			end
			task.wait(0.1)
		end
	end)
end

--------------------------------------------------------------------------------
-- Big events and weather (see Events.luau)
--------------------------------------------------------------------------------

-- "2d 4h", "3h 12m", "12:05": how long until something, short.
local function countdown(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local d, h, m, s = seconds // 86400, (seconds % 86400) // 3600, (seconds % 3600) // 60, seconds % 60
	if d > 0 then
		return string.format("%dd %dh", d, h)
	elseif h > 0 then
		return string.format("%dh %dm", h, m)
	end
	return string.format("%d:%02d", m, s)
end

-- A banner at the top of the screen: the big event when it's live (big, glowing, with time
-- left) or a countdown to the next one, and under it the weather or when it's next due.
function Hud.eventBanner(screen: ScreenGui)
	local holder = UI.new("Frame", {
		Name = "EventBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		UI.new("UIListLayout", {
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 5),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local function pill(order: number, height: number)
		local frame = UI.glass({
			Size = UDim2.fromOffset(0, height),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = order,
			Parent = holder,
		}, {
			UI.corner(height / 2),
			UI.new("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) }),
			UI.new("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
			}),
		})
		local label = text("", height * 0.55, {
			Size = UDim2.fromOffset(0, height),
			AutomaticSize = Enum.AutomaticSize.X,
			FontFace = UI.fonts.heavy,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = frame,
		})
		return frame, label, frame:FindFirstChildOfClass("UIStroke")
	end
	local eventPill, eventLabel, eventStroke = pill(1, 40)
	local weatherPill, weatherLabel = pill(2, 28)
	local eventScale = UI.new("UIScale", { Parent = eventPill })

	task.spawn(function()
		while true do
			local t = Workspace:GetServerTimeNow()
			local big, ends = Events.current()
			if big then
				-- Live: the event's colour, pulsing, with time left.
				local pulse = (math.sin(os.clock() * 5) + 1) / 2
				eventPill.BackgroundColor3 = big.color:Lerp(Color3.fromRGB(60, 20, 110), 0.35 + pulse * 0.2)
				eventLabel.Text = big.icon .. "  " .. string.upper(big.name) .. " LIVE · " .. countdown(ends - t)
				eventLabel.TextColor3 = Color3.new(1, 1, 1)
				if eventStroke then
					eventStroke.Color = big.color:Lerp(Color3.new(1, 1, 1), pulse * 0.6)
				end
				eventScale.Scale = 1 + pulse * 0.04
			else
				local id = ReplicatedStorage:GetAttribute("NextEvent")
				local at = ReplicatedStorage:GetAttribute("NextEventAt") or 0
				local nextEvent = id and Events.BIG[id]
				eventPill.Visible = nextEvent ~= nil
				if nextEvent then
					eventPill.BackgroundColor3 = colors.panel
					eventLabel.Text = nextEvent.icon .. "  " .. nextEvent.name .. " in " .. countdown(at - t)
					eventLabel.TextColor3 = nextEvent.color:Lerp(Color3.new(1, 1, 1), 0.55)
					if eventStroke then
						eventStroke.Color = UI.OUTLINE
					end
					eventScale.Scale = 0.85
				end
			end
			if big then
				eventPill.Visible = true
			end

			local weather, weatherEnds = Events.weather()
			if weather then
				weatherPill.BackgroundColor3 = weather.color:Lerp(Color3.new(0, 0, 0), 0.25)
				weatherLabel.Text = weather.icon .. "  " .. weather.name .. " · " .. countdown(weatherEnds - t)
				weatherLabel.TextColor3 = Color3.new(1, 1, 1)
				weatherPill.Visible = true
			else
				local id = ReplicatedStorage:GetAttribute("NextWeather")
				local at = ReplicatedStorage:GetAttribute("NextWeatherAt") or 0
				local nextWeather = id and Events.WEATHER[id]
				weatherPill.Visible = nextWeather ~= nil
				if nextWeather then
					weatherPill.BackgroundColor3 = colors.panel
					weatherLabel.Text = nextWeather.icon .. "  " .. nextWeather.name .. " in " .. countdown(at - t)
					weatherLabel.TextColor3 = nextWeather.color:Lerp(Color3.new(1, 1, 1), 0.5)
				end
			end
			task.wait(0.1)
		end
	end)
end

-- The Starter Pack offer button with its countdown (only during a player's first hours,
-- until they buy it). Tapping it opens the Store.
function Hud.starterOffer(screen: ScreenGui, onOpen: () -> ())
	local button = UI.button("", colors.green, onOpen, {
		Name = "StarterOffer",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, -70),
		Size = UDim2.fromOffset(170, 74),
		Visible = false,
		ZIndex = 10,
		Parent = screen,
	})
	button:FindFirstChildOfClass("UIPadding"):Destroy()
	local gradient = button:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Color = ColorSequence.new(Color3.fromRGB(80, 230, 120), Color3.fromRGB(30, 170, 150))
	end
	text("🎁 STARTER PACK", 18, {
		Position = UDim2.fromOffset(0, 8),
		Size = UDim2.new(1, 0, 0, 24),
		FontFace = UI.fonts.heavy,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 11,
		Parent = button,
	})
	local timer = text("", 22, {
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 28),
		FontFace = UI.fonts.heavy,
		TextColor3 = colors.gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 11,
		Parent = button,
	})
	UI.tag(button, "LIMITED", colors.red).Size = UDim2.fromOffset(84, 24)
	local scale = UI.new("UIScale", { Parent = button })
	task.spawn(function()
		while true do
			local ends = player:GetAttribute("StarterEnds")
			local left = if ends then ends - Workspace:GetServerTimeNow() else 0
			button.Visible = left > 0 and not player:GetAttribute("CratesRestricted")
			if button.Visible then
				local h, m, sec = left // 3600, (left % 3600) // 60, math.floor(left % 60)
				timer.Text = string.format("⏰ %d:%02d:%02d", h, m, sec)
				scale.Scale = 1 + (math.sin(os.clock() * 4) + 1) * 0.02
			end
			task.wait(0.1)
		end
	end)
end

--------------------------------------------------------------------------------
-- Menu buttons
--------------------------------------------------------------------------------

-- The side buttons, like the big simulators': a two-column grid of chunky 3D buttons (a
-- bright face on a darker base, so they look pressable), each with a glossy shine, a big
-- wobbling emoji, its name across the bottom edge and a red alert badge when something is
-- waiting there.
--
-- entries = { { name, icon, color } }. Returns setActive(name or nil) and
-- setBadge(name, text or nil, color?).
function Hud.menu(screen: ScreenGui, entries, onSelect: (string) -> ())
	local TILE = 72
	local DEPTH = 5 -- how far the base shows under the face
	local GAP_X, GAP_Y = 12, 16
	local COLUMNS = 2
	local rows = math.ceil(#entries / COLUMNS)
	local width = COLUMNS * TILE + (COLUMNS - 1) * GAP_X + 16
	local height = rows * (TILE + DEPTH) + (rows - 1) * GAP_Y + 24
	-- Starts below the money pill and event chip, and shrinks to fit on short screens.
	local rail = UI.new("Frame", {
		Name = "Menu",
		Position = UDim2.fromOffset(6, 112),
		Size = UDim2.fromOffset(width, height),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		UI.new("UIPadding", {
			PaddingTop = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 8),
		}),
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(TILE, TILE + DEPTH),
			CellPadding = UDim2.fromOffset(GAP_X, GAP_Y),
			FillDirection = Enum.FillDirection.Horizontal,
			FillDirectionMaxCells = COLUMNS,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	fitHeight(rail, height, 112 + 24)

	local tiles = {}
	local icons = {}
	local pressInfo = TweenInfo.new(0.08, Enum.EasingStyle.Quad)
	for i, entry in entries do
		local name, icon, color = entry[1], entry[2], entry[3]
		local holder = UI.new("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			LayoutOrder = i,
			Parent = rail,
		})
		-- The darker base underneath.
		UI.new("Frame", {
			Name = "Base",
			Position = UDim2.fromOffset(0, DEPTH),
			Size = UDim2.fromOffset(TILE, TILE),
			BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.45),
			Parent = holder,
		}, { UI.corner(20), UI.stroke(nil, 3.5) })

		local face = UI.new("TextButton", {
			Name = "Face",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = color,
			Size = UDim2.fromOffset(TILE, TILE),
			ZIndex = 2,
			Parent = holder,
		}, {
			UI.corner(20),
			UI.new("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
					ColorSequenceKeypoint.new(0.55, Color3.fromRGB(235, 235, 235)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(175, 175, 185)),
				}),
				Rotation = 90,
			}),
		})
		local ring = UI.stroke(nil, 3.5)
		ring.Parent = face
		-- Glossy shine across the top.
		UI.new("Frame", {
			Name = "Shine",
			Position = UDim2.fromOffset(7, 5),
			Size = UDim2.new(1, -14, 0.38, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.55,
			ZIndex = 2,
			Parent = face,
		}, {
			UI.corner(14),
			UI.new("UIGradient", {
				Transparency = NumberSequence.new(0, 1),
				Rotation = 90,
			}),
		})
		-- The big picture: a 3D model if there is one, otherwise the emoji.
		local pictureKey = "Menu" .. name
		local picture, sway
		if ItemPictures.has(pictureKey) then
			picture, sway = ItemPictures.icon(pictureKey)
		else
			picture = text(icon, 40, { TextXAlignment = Enum.TextXAlignment.Center })
		end
		picture.Name = "Icon"
		picture.AnchorPoint = Vector2.new(0.5, 0.5)
		picture.Position = UDim2.new(0.5, 0, 0.44, 0)
		picture.Size = UDim2.fromOffset(TILE - 6, TILE - 14)
		picture.ZIndex = 3
		picture.Parent = face
		local iconScale = UI.new("UIScale", { Parent = picture })
		table.insert(icons, { picture = picture, sway = sway, phase = i * 0.9 })
		-- The name, straddling the bottom edge.
		local caption = text(string.upper(name), 17, {
			Name = "Caption",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 1, -6),
			Size = UDim2.new(1, 12, 0, 20),
			TextXAlignment = Enum.TextXAlignment.Center,
			FontFace = UI.fonts.heavy,
			ZIndex = 4,
			Parent = face,
		})
		caption:FindFirstChildOfClass("UIStroke").Thickness = 2.6

		-- The alert badge in the top-right corner (hidden until setBadge).
		local badge = UI.new("TextLabel", {
			Name = "Badge",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -6, 0, 4),
			Size = UDim2.fromOffset(0, 26),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = colors.red,
			FontFace = UI.fonts.heavy,
			Text = "!",
			TextSize = 18,
			TextColor3 = colors.text,
			Visible = false,
			ZIndex = 6,
			Parent = face,
		}, {
			UI.corner(13),
			UI.stroke(nil, 3),
			UI.textStroke(2),
			UI.new("UIPadding", {
				PaddingLeft = UDim.new(0, 8),
				PaddingRight = UDim.new(0, 8),
				PaddingTop = UDim.new(0, 3),
			}),
		})
		local badgeScale = UI.new("UIScale", { Parent = badge })

		-- Pressing pushes the face down onto its base.
		local function press(down: boolean)
			TweenService:Create(face, pressInfo, {
				Position = UDim2.fromOffset(0, if down then DEPTH - 1 else 0),
			}):Play()
		end
		face.MouseButton1Down:Connect(function()
			press(true)
		end)
		face.MouseButton1Up:Connect(function()
			press(false)
		end)
		face.MouseLeave:Connect(function()
			press(false)
		end)
		hoverGrow(face)
		face.Activated:Connect(function()
			onSelect(name)
		end)
		tiles[name] = { ring = ring, badge = badge, badgeScale = badgeScale, icon = iconScale }
	end

	-- Pictures sway gently in a wave; badges throb so they catch the eye.
	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for _, entry in icons do
			if entry.sway then
				entry.sway(t * 1.4 + entry.phase)
			else
				entry.picture.Rotation = math.sin(t * 1.8 + entry.phase) * 6
			end
		end
		local throb = 1 + math.max(0, math.sin(t * 5)) * 0.15
		for _, tile in tiles do
			if tile.badge.Visible then
				tile.badgeScale.Scale = throb
			end
		end
	end)

	local function setActive(active: string?)
		for name, tile in tiles do
			local on = name == active
			tile.ring.Color = if on then Color3.new(1, 1, 1) else UI.OUTLINE
			tile.ring.Thickness = if on then 4.5 else 3.5
			tile.icon.Scale = if on then 1.15 else 1
		end
	end

	local function setBadge(name: string, value: string?, color: Color3?)
		local tile = tiles[name]
		if tile then
			tile.badge.Visible = value ~= nil
			tile.badge.Text = value or ""
			tile.badge.BackgroundColor3 = color or colors.red
		end
	end

	return setActive, setBadge
end

--------------------------------------------------------------------------------
-- Leaderboard (replaces Roblox's default player list)
--------------------------------------------------------------------------------

function Hud.leaderboard(screen: ScreenGui)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
	end)

	local WIDTH = 276
	local ROW = 42
	-- Top three get medal colours; everyone else a bright blue bar.
	local PLACES = {
		{ color = Color3.fromRGB(255, 200, 45), medal = Color3.fromRGB(230, 145, 20) },
		{ color = Color3.fromRGB(195, 210, 235), medal = Color3.fromRGB(130, 145, 175) },
		{ color = Color3.fromRGB(240, 145, 80), medal = Color3.fromRGB(180, 90, 40) },
	}
	local OTHER = { color = Color3.fromRGB(85, 140, 250), medal = UI.colors.ink }

	local board = UI.new("Frame", {
		Name = "Leaderboard",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 22),
		Size = UDim2.fromOffset(WIDTH, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = colors.sheet,
		Parent = screen,
	}, {
		UI.corner(16),
		UI.stroke(nil, 3.5),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(215, 205, 240)),
			Rotation = 90,
		}),
		UI.new("UIPadding", {
			PaddingTop = UDim.new(0, 26),
			PaddingBottom = UDim.new(0, 8),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
	})

	-- The slanted purple-to-pink title tab over the top-left corner (click to fold).
	local tab = UI.new("TextButton", {
		Name = "TitleTab",
		Text = "",
		AutoButtonColor = false,
		Position = UDim2.fromOffset(-14, -44),
		Size = UDim2.fromOffset(172, 34),
		Rotation = -3,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
		Parent = board,
	}, {
		UI.corner(10),
		UI.stroke(nil, 3),
		UI.new("UIGradient", { Color = ColorSequence.new(colors.fusion, colors.fusion2) }),
		text("🏆 LEADERBOARD", 19, {
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			FontFace = UI.fonts.heavy,
			ZIndex = 4,
		}),
	})
	hoverGrow(tab)
	-- How many players are in the server, top right.
	local count = UI.new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0, -13),
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = colors.ink,
		FontFace = UI.fonts.heavy,
		Text = "",
		TextSize = 14,
		TextColor3 = colors.text,
		ZIndex = 3,
		Parent = board,
	}, {
		UI.corner(11),
		UI.stroke(nil, 2.5),
		UI.new("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
			PaddingTop = UDim.new(0, 2),
		}),
	})

	local list = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = board,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local onFold
	tab.Activated:Connect(function()
		list.Visible = not list.Visible
		if onFold then
			onFold()
		end
	end)

	local rows = {}
	local thumbnails = {}

	local function chip(parent: Instance, order: number, color: Color3)
		return UI.new("TextLabel", {
			Size = UDim2.fromOffset(0, 16),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = color,
			FontFace = UI.fonts.heavy,
			TextSize = 11,
			TextColor3 = colors.text,
			LayoutOrder = order,
			Visible = false,
			Parent = parent,
		}, {
			UI.corner(8),
			UI.stroke(nil, 2),
			UI.textStroke(1.4),
			UI.new("UIPadding", {
				PaddingLeft = UDim.new(0, 5),
				PaddingRight = UDim.new(0, 5),
				PaddingTop = UDim.new(0, 2),
			}),
		})
	end

	local function makeRow(other: Player)
		local isMe = other == player
		local frame = UI.new("Frame", {
			Size = UDim2.new(1, 0, 0, ROW),
			BackgroundColor3 = OTHER.color,
			Parent = list,
		}, {
			UI.corner(12),
			UI.new("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(240, 240, 240)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(185, 185, 195)),
				}),
				Rotation = 90,
			}),
		})
		local ring = UI.stroke(nil, 2.5)
		ring.Parent = frame
		-- Glossy shine across the top.
		UI.new("Frame", {
			Position = UDim2.fromOffset(6, 3),
			Size = UDim2.new(1, -12, 0.36, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.6,
			Parent = frame,
		}, {
			UI.corner(8),
			UI.new("UIGradient", { Transparency = NumberSequence.new(0, 1), Rotation = 90 }),
		})

		-- Rank medal.
		local medal = UI.new("TextLabel", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 6, 0.5, 0),
			Size = UDim2.fromOffset(26, 26),
			BackgroundColor3 = OTHER.medal,
			FontFace = UI.fonts.heavy,
			Text = "1",
			TextSize = 15,
			TextColor3 = colors.text,
			ZIndex = 2,
			Parent = frame,
		}, {
			UI.corner(13),
			UI.stroke(nil, 2.5),
			UI.textStroke(1.6),
			UI.new("UIPadding", { PaddingTop = UDim.new(0, 2) }),
		})

		-- Avatar in a white ring, with a crown for first place.
		local avatarRing = UI.new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 37, 0.5, 0),
			Size = UDim2.fromOffset(34, 34),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 2,
			Parent = frame,
		}, { UI.corner(18), UI.stroke(nil, 2.5) })
		local avatar = UI.new("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = colors.card,
			ZIndex = 3,
			Parent = avatarRing,
		}, { UI.corner(15) })
		local crown = text("👑", 18, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0, -2),
			Size = UDim2.fromOffset(24, 20),
			TextXAlignment = Enum.TextXAlignment.Center,
			Rotation = -15,
			Visible = false,
			ZIndex = 4,
			Parent = avatarRing,
		})
		task.spawn(function()
			if not thumbnails[other.UserId] then
				local ok, image = pcall(function()
					return Players:GetUserThumbnailAsync(
						other.UserId,
						Enum.ThumbnailType.HeadShot,
						Enum.ThumbnailSize.Size48x48
					)
				end)
				thumbnails[other.UserId] = if ok then image else ""
			end
			avatar.Image = thumbnails[other.UserId]
		end)

		-- Name, with little chips (VIP, you) underneath.
		local name = text(other.DisplayName, 15, {
			Position = UDim2.fromOffset(78, 3),
			Size = UDim2.new(1, -168, 0, 18),
			ZIndex = 2,
			Parent = frame,
		})
		local chips = UI.new("Frame", {
			Position = UDim2.fromOffset(78, 22),
			Size = UDim2.new(1, -168, 0, 16),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = frame,
		}, {
			UI.new("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		local you = chip(chips, 0, colors.green)
		you.Text = "YOU"
		you.Visible = isMe
		local vip = chip(chips, 2, Color3.fromRGB(240, 170, 20))
		vip.Text = "👑 VIP"

		-- Money in a black pill on the right.
		local money = UI.new("TextLabel", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -7, 0.5, 0),
			Size = UDim2.fromOffset(0, 26),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = colors.ink,
			FontFace = UI.fonts.heavy,
			Text = "$0",
			TextSize = 16,
			TextColor3 = colors.money,
			ZIndex = 2,
			Parent = frame,
		}, {
			UI.corner(13),
			UI.stroke(nil, 2.5),
			UI.new("UIPadding", {
				PaddingLeft = UDim.new(0, 9),
				PaddingRight = UDim.new(0, 9),
				PaddingTop = UDim.new(0, 3),
			}),
		})

		rows[other] = {
			frame = frame,
			ring = ring,
			medal = medal,
			crown = crown,
			name = name,
			chips = chips,
			vip = vip,
			money = money,
			isMe = isMe,
		}
	end

	local function stat(other: Player, key: string): number
		local stats = other:FindFirstChild("leaderstats")
		local value = stats and stats:FindFirstChild(key)
		return if value then value.Value else 0
	end

	local function refresh()
		local everyone = Players:GetPlayers()
		for _, other in everyone do
			if not rows[other] then
				makeRow(other)
			end
		end
		for other, row in rows do
			if not other.Parent then
				row.frame:Destroy()
				rows[other] = nil
			end
		end
		table.sort(everyone, function(a, b)
			return stat(a, "Money") > stat(b, "Money")
		end)
		for i, other in everyone do
			local row = rows[other]
			local place = PLACES[i] or OTHER
			row.frame.LayoutOrder = i
			row.frame.BackgroundColor3 = place.color
			-- Your own row glows white.
			row.ring.Color = if row.isMe then Color3.new(1, 1, 1) else UI.OUTLINE
			row.ring.Thickness = if row.isMe then 3.5 else 2.5
			row.medal.Text = tostring(i)
			row.medal.BackgroundColor3 = place.medal
			row.crown.Visible = i == 1
			row.money.Text = Format.money(stat(other, "Money"))
			local isVip = GamePasses.has(other, "VIP")
			row.vip.Visible = isVip
			row.name.TextColor3 = if isVip then Color3.fromRGB(255, 235, 120) else colors.text
			-- No chips: centre the name in the row.
			local anyChip = row.isMe or isVip
			row.name.Position = UDim2.fromOffset(78, if anyChip then 3 else 12)
		end
		count.Text = "👥 " .. #everyone .. "/" .. Config.PLOT_COUNT
	end

	-- The buttons on the right (Starter Pack, Admin) stack up just under the board, however
	-- tall it is.
	local STACK = { "StarterOffer", "AdminButton" }
	local function stackBelow()
		local shown = 0
		for _ in rows do
			shown += 1
		end
		local height = 26 + 8 + (if list.Visible then shown * ROW + math.max(shown - 1, 0) * 6 else 0)
		local y = board.Position.Y.Offset + height + 16
		for _, name in STACK do
			local button = screen:FindFirstChild(name)
			if button and button:IsA("GuiObject") then
				button.AnchorPoint = Vector2.new(1, 0)
				button.Position = UDim2.new(1, -12, 0, y)
				if button.Visible then
					y += button.Size.Y.Offset + 12
				end
			end
		end
	end

	onFold = stackBelow
	refresh()
	stackBelow()
	Players.PlayerAdded:Connect(refresh)
	Players.PlayerRemoving:Connect(function()
		task.defer(refresh)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			refresh()
			stackBelow()
		end
	end)
end

--------------------------------------------------------------------------------
-- VIP chat tag
--------------------------------------------------------------------------------

function Hud.vipChatTag()
	local TextChatService = game:GetService("TextChatService")
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local sender = source and Players:GetPlayerByUserId(source.UserId)
		if sender and GamePasses.has(sender, "VIP") then
			properties.PrefixText = '<font color="#FFC83C">[VIP]</font> ' .. message.PrefixText
		end
		return properties
	end
end

--------------------------------------------------------------------------------
-- Notifications
--------------------------------------------------------------------------------

local TOAST_COLORS = {
	error = colors.red,
	success = colors.green,
	money = Color3.fromRGB(40, 165, 75),
	discovery = Color3.fromRGB(255, 160, 30),
}

-- Returns toast(message, kind?).
function Hud.toasts(screen: ScreenGui)
	local holder = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 92), -- under the event banner
		Size = UDim2.new(0.5, 0, 0, 220),
		Parent = screen,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	return function(message: string, kind: string?)
		local accent = TOAST_COLORS[kind or ""] or colors.blue
		local big = kind == "discovery"
		local frame = UI.glass({
			Size = UDim2.fromOffset(0, if big then 48 else 38),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = accent,
			Parent = holder,
		}, {
			UI.corner(20),
			UI.new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 16) }),
			UI.new("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 10),
			}),
		})
		local label = text(message, if big then 22 else 17, {
			Size = UDim2.fromOffset(0, 28),
			AutomaticSize = Enum.AutomaticSize.X,
			FontFace = if big then UI.fonts.heavy else UI.fonts.bold,
			TextColor3 = colors.text,
			Parent = frame,
		})
		label.TextTruncate = Enum.TextTruncate.None

		task.delay(if big then 7 else 3.5, function()
			local info = TweenInfo.new(0.35)
			TweenService:Create(frame, info, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, info, { TextTransparency = 1 }):Play()
			task.wait(0.35)
			frame:Destroy()
		end)
	end
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">ItemPictures</string>
            <string name="Source"><![CDATA[-- 3D pictures for shop items (the treadmill, game passes), items, eggs and the side menu,
-- built from parts like everything else in the game and shown in ViewportFrames.
-- ItemPictures.view(key, height) returns a ViewportFrame; keys are "Treadmill" or a game
-- pass key from GamePasses.luau. ItemPictures.part(itemId) pictures any item (house part,
-- pet, yard item, plant), ItemPictures.egg(zone) a zone's egg and ItemPictures.icon(key) a
-- menu icon.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EggModel = require(ReplicatedStorage.Shared.EggModel)
local HouseModel = require(ReplicatedStorage.Shared.HouseModel)
local ItemModel = require(ReplicatedStorage.Shared.ItemModel)
local Lego = require(ReplicatedStorage.Shared.Lego)

local ItemPictures = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local GOLD = rgb(255, 200, 55)

local function part(model: Model, props)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "ClassName" then
			p[key] = value
		end
	end
	p.Parent = model
	return p
end

-- A ball, or a squashed ball (a sphere mesh) when the size isn't the same every way.
local function ball(model, position: Vector3, size: Vector3 | number, color: Color3, material: Enum.Material?)
	local vector = if typeof(size) == "number" then Vector3.one * size else size
	local round = vector.X == vector.Y and vector.Y == vector.Z
	local p = part(model, {
		Shape = if round then Enum.PartType.Ball else Enum.PartType.Block,
		Size = vector,
		CFrame = CFrame.new(position),
		Color = color,
		Material = material,
	})
	if not round then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	return p
end

local function cylinder(model, cframe: CFrame, height: number, diameter: number, color: Color3, material)
	return part(model, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = cframe * CFrame.Angles(0, 0, math.pi / 2), -- upright
		Color = color,
		Material = material,
	})
end

local function plus(model, position: Vector3, size: number)
	local green = rgb(80, 220, 100)
	part(model, { Size = Vector3.new(size, size * 0.32, size * 0.32), CFrame = CFrame.new(position), Color = green })
	part(model, { Size = Vector3.new(size * 0.32, size, size * 0.32), CFrame = CFrame.new(position), Color = green })
end

local BUILDERS = {}

-- A chunky orange backpack.
local function backpack(model, plusSign: boolean)
	local orange = rgb(255, 140, 50)
	ball(model, Vector3.new(0, 2.4, 0), Vector3.new(3.6, 4.4, 2.4), orange)
	ball(model, Vector3.new(0, 1.6, -1.05), Vector3.new(2.6, 2, 1), rgb(255, 175, 80))
	part(model, { Size = Vector3.new(2.4, 0.25, 0.3), CFrame = CFrame.new(0, 2.5, -1.25), Color = rgb(90, 60, 40) })
	ball(model, Vector3.new(0, 2.5, -1.4), 0.35, GOLD, Enum.Material.Foil)
	for _, x in { -1.1, 1.1 } do
		part(model, {
			Size = Vector3.new(0.45, 3.6, 0.3),
			CFrame = CFrame.new(x, 2.5, 1.25) * CFrame.Angles(0, 0, math.rad(x * 4)),
			Color = rgb(90, 60, 40),
		})
	end
	cylinder(model, CFrame.new(0, 4.6, 0) * CFrame.Angles(math.pi / 2, 0, 0), 0.4, 1.2, rgb(90, 60, 40))
	if plusSign then
		plus(model, Vector3.new(2.4, 4.2, -0.6), 1.6)
	end
end

function BUILDERS.ExtraSlot1(model)
	backpack(model, true)
end
BUILDERS.ExtraSlot2 = BUILDERS.ExtraSlot1
BUILDERS.ExtraSlot3 = BUILDERS.ExtraSlot1

-- The treadmill (Shop): a belt, rails and a glowing console.
function BUILDERS.Treadmill(model)
	local frame = rgb(60, 62, 75)
	part(
		model,
		{ Size = Vector3.new(3, 0.6, 6), CFrame = CFrame.new(0, 0.3, 0), Color = frame, Material = Enum.Material.Metal }
	)
	part(model, { Size = Vector3.new(2.4, 0.2, 5.2), CFrame = CFrame.new(0, 0.7, 0.3), Color = rgb(30, 30, 36) })
	for _, x in { -1.4, 1.4 } do
		part(model, { Size = Vector3.new(0.3, 0.3, 5.6), CFrame = CFrame.new(x, 0.8, 0.2), Color = rgb(90, 200, 255) })
		part(model, { Size = Vector3.new(0.25, 2.6, 0.25), CFrame = CFrame.new(x, 1.9, -2.6), Color = frame })
	end
	part(model, { Size = Vector3.new(3, 0.3, 0.3), CFrame = CFrame.new(0, 3.1, -2.6), Color = rgb(90, 200, 255) })
	part(model, {
		Size = Vector3.new(2.2, 1.1, 0.3),
		CFrame = CFrame.new(0, 3.8, -2.8) * CFrame.Angles(math.rad(20), 0, 0),
		Color = rgb(90, 220, 255),
		Material = Enum.Material.Neon,
	})
	-- A lightning bolt over it.
	local yellow = rgb(255, 220, 40)
	for _, bit in { { 1.9, 5, -30 }, { 1.6, 3.9, 35 }, { 2, 2.8, -30 } } do
		part(model, {
			Size = Vector3.new(0.6, 1.4, 0.4),
			CFrame = CFrame.new(bit[1], bit[2], -0.6) * CFrame.Angles(0, 0, math.rad(bit[3])),
			Color = yellow,
			Material = Enum.Material.Neon,
		})
	end
end

-- 2x Coins: a pile of gold coins and a green cash stack.
function BUILDERS.DoubleCoins(model)
	for i = 0, 2 do
		part(model, {
			Size = Vector3.new(3.4, 0.6, 1.8),
			CFrame = CFrame.new(0.4, 0.3 + i * 0.62, 0.6) * CFrame.Angles(0, math.rad(i * 7), 0),
			Color = rgb(90, 200, 90),
		})
		part(model, {
			Size = Vector3.new(0.6, 0.66, 1.86),
			CFrame = CFrame.new(0.4, 0.3 + i * 0.62, 0.6) * CFrame.Angles(0, math.rad(i * 7), 0),
			Color = rgb(255, 240, 200),
		})
	end
	for i, spot in
		{
			Vector3.new(-1.4, 0.2, -0.6),
			Vector3.new(-1.4, 0.55, -0.6),
			Vector3.new(-1.4, 0.9, -0.6),
			Vector3.new(-0.3, 0.2, -1.2),
		}
	do
		cylinder(model, CFrame.new(spot) * CFrame.Angles(0, i, 0), 0.32, 1.7, GOLD, Enum.Material.Foil)
	end
	-- One big coin standing up in front.
	part(model, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 2.4, 2.4),
		CFrame = CFrame.new(-0.6, 1.6, -1.6) * CFrame.Angles(0, math.rad(80), 0),
		Color = GOLD,
		Material = Enum.Material.Foil,
	})
end

-- Fast Fusing: a pink potion with a lightning bolt.
-- Copies an egg's parts into a picture model at a spot.
local function addEgg(model, zoneIndex: number, cframe: CFrame)
	local egg = EggModel.build(zoneIndex)
	egg:PivotTo(cframe)
	for _, p in egg:GetDescendants() do
		if p:IsA("BasePart") then
			p.Parent = model
		end
	end
	egg:Destroy()
end

-- A chunky zig-zag lightning bolt.
local function bolt(model, offset: Vector3, size: number)
	local yellow = rgb(255, 220, 40)
	for _, bit in { { 0.3, 1.2, -30 }, { 0, 0, 35 }, { 0.4, -1.2, -30 } } do
		part(model, {
			Size = Vector3.new(0.7, 1.6, 0.5) * size,
			CFrame = CFrame.new(offset + Vector3.new(bit[1], bit[2], 0) * size) * CFrame.Angles(0, 0, math.rad(bit[3])),
			Color = yellow,
			Material = Enum.Material.Neon,
		})
	end
end

-- Fast Hatching: a fancy egg with a lightning bolt.
function BUILDERS.FastBreeding(model)
	addEgg(model, 6, CFrame.new(0, 0, 0))
	bolt(model, Vector3.new(2.3, 2.4, -0.6), 1)
end

-- 2x Speed: a big lightning bolt with a running shoe.
function BUILDERS.LongerLock(model)
	bolt(model, Vector3.new(0, 2.6, 0), 1.6)
	part(model, { Size = Vector3.new(1.6, 1, 3), CFrame = CFrame.new(-1.8, 0.5, 0), Color = rgb(255, 80, 80) })
	part(model, { Size = Vector3.new(1.7, 0.35, 3.2), CFrame = CFrame.new(-1.8, 0.1, 0), Color = rgb(255, 255, 255) })
	part(model, { Size = Vector3.new(1.6, 1, 1.2), CFrame = CFrame.new(-1.8, 1.4, 0.9), Color = rgb(255, 80, 80) })
end

-- VIP: a gold crown with gems.
function BUILDERS.VIP(model)
	cylinder(model, CFrame.new(0, 0.8, 0), 1.6, 3.6, GOLD, Enum.Material.Foil)
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		local spot = Vector3.new(math.sin(a) * 1.5, 2.2, -math.cos(a) * 1.5)
		part(model, {
			Size = Vector3.new(0.9, 1.6, 0.9),
			CFrame = CFrame.new(spot) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, math.rad(45)),
			Color = GOLD,
			Material = Enum.Material.Foil,
		})
		ball(model, spot + Vector3.new(0, 1.1, 0), 0.55, GOLD, Enum.Material.Foil)
	end
	for k, color in { rgb(255, 50, 80), rgb(80, 160, 255), rgb(90, 220, 110) } do
		local a = (k - 2) * 0.7
		ball(model, Vector3.new(math.sin(a) * 1.8, 0.8, -math.cos(a) * 1.8), 0.7, color, Enum.Material.Neon)
	end
end

-- Extra Nests: a straw nest with two eggs in it.
function BUILDERS.ExtraPen(model)
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		part(model, {
			Size = Vector3.new(1.6, 0.9, 1),
			CFrame = CFrame.new(math.cos(a) * 2.1, 0.5 + (k % 2) * 0.15, math.sin(a) * 2.1)
				* CFrame.Angles(0, -a + math.pi / 2, 0),
			Color = if k % 2 == 0 then rgb(230, 185, 90) else rgb(205, 155, 70),
		})
	end
	cylinder(model, CFrame.new(0, 0.2, 0), 0.4, 4, rgb(190, 140, 65))
	addEgg(model, 3, CFrame.new(-0.8, 0.3, 0.2) * CFrame.Angles(0, 0, math.rad(12)))
	addEgg(model, 8, CFrame.new(0.9, 0.3, -0.2) * CFrame.Angles(0, 0, math.rad(-10)))
	plus(model, Vector3.new(2.6, 3.6, -0.6), 1.6)
end

--------------------------------------------------------------------------------
-- Menu icons: the pictures on the side buttons (keys "Menu" .. tab name). They're built
-- flat-on, facing the camera (-Z), and shown by ItemPictures.icon.
--------------------------------------------------------------------------------

-- An isosceles triangle slab from two wedges: base centred on `base`, `across` along the
-- base, `toward` pointing at the tip.
local function triangle(model, base: Vector3, across: Vector3, toward: Vector3, width, height, depth, color, material)
	for _, side in { 1, -1 } do
		local u = across * side
		part(model, {
			ClassName = "WedgePart",
			Size = Vector3.new(depth, height, width / 2),
			CFrame = CFrame.fromMatrix(base + toward * (height / 2) + u * (width / 4), u:Cross(toward), toward, -u),
			Color = color,
			Material = material,
		})
	end
end

-- A little four-point sparkle.
local function sparkle(model, position: Vector3, size: number)
	local white = rgb(255, 255, 235)
	for _, angle in { 0, 90 } do
		part(model, {
			Size = Vector3.new(size * 0.22, size, size * 0.1),
			CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(angle)),
			Color = white,
			Material = Enum.Material.Neon,
		})
	end
end

-- Shop: a red shopping cart full of goodies.
BUILDERS.MenuShop = function(model)
	local red, white, dark = rgb(240, 70, 85), rgb(255, 245, 245), rgb(55, 55, 70)
	local w, d, h = 3.8, 2.4, 2
	local y0 = 1.3
	part(model, { Size = Vector3.new(w - 0.6, 0.25, d), CFrame = CFrame.new(0, y0, 0), Color = red })
	for _, z in { -d / 2, d / 2 } do
		-- Front and back walls.
		part(model, { Size = Vector3.new(w, h, 0.2), CFrame = CFrame.new(0, y0 + h / 2, z), Color = red })
		-- White grille stripes.
		for k = 1, 2 do
			part(model, {
				Size = Vector3.new(w - 0.4, 0.14, 0.24),
				CFrame = CFrame.new(0, y0 + h * k / 3, z),
				Color = white,
			})
		end
	end
	for _, x in { -w / 2 + 0.15, w / 2 - 0.15 } do
		part(model, { Size = Vector3.new(0.2, h, d), CFrame = CFrame.new(x, y0 + h / 2, 0), Color = red })
	end
	-- The rim and the push handle.
	part(model, { Size = Vector3.new(w + 0.1, 0.25, 0.3), CFrame = CFrame.new(0, y0 + h, -d / 2), Color = white })
	part(model, { Size = Vector3.new(w + 0.1, 0.25, 0.3), CFrame = CFrame.new(0, y0 + h, d / 2), Color = white })
	part(model, {
		Size = Vector3.new(0.25, 1.4, 0.25),
		CFrame = CFrame.new(w / 2 + 0.2, y0 + h + 0.4, -d / 2) * CFrame.Angles(0, 0, math.rad(-30)),
		Color = dark,
	})
	part(model, {
		Size = Vector3.new(0.25, 1.4, 0.25),
		CFrame = CFrame.new(w / 2 + 0.2, y0 + h + 0.4, d / 2) * CFrame.Angles(0, 0, math.rad(-30)),
		Color = dark,
	})
	part(model, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(d + 0.6, 0.45, 0.45),
		CFrame = CFrame.new(w / 2 + 0.55, y0 + h + 1, 0) * CFrame.Angles(0, math.pi / 2, 0),
		Color = rgb(255, 200, 60),
	})
	-- Legs and wheels.
	part(model, { Size = Vector3.new(w - 0.8, 0.2, 0.2), CFrame = CFrame.new(0, 0.55, -d / 2 + 0.2), Color = dark })
	part(model, { Size = Vector3.new(w - 0.8, 0.2, 0.2), CFrame = CFrame.new(0, 0.55, d / 2 - 0.2), Color = dark })
	for _, x in { -w / 2 + 0.6, w / 2 - 0.6 } do
		for _, z in { -d / 2 + 0.2, d / 2 - 0.2 } do
			part(
				model,
				{ Size = Vector3.new(0.2, y0 - 0.5, 0.2), CFrame = CFrame.new(x, (y0 + 0.5) / 2, z), Color = dark }
			)
			part(model, {
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.35, 0.8, 0.8),
				CFrame = CFrame.new(x, 0.4, z) * CFrame.Angles(0, math.pi / 2, 0),
				Color = rgb(35, 35, 45),
			})
			part(model, {
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.4, 0.35, 0.35),
				CFrame = CFrame.new(x, 0.4, z) * CFrame.Angles(0, math.pi / 2, 0),
				Color = rgb(200, 200, 210),
			})
		end
	end
	-- Goodies poking out of the top.
	part(model, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.35, 1.8, 1.8),
		CFrame = CFrame.new(-0.7, y0 + h + 0.3, 0.2) * CFrame.Angles(0, math.rad(80), math.rad(10)),
		Color = GOLD,
		Material = Enum.Material.Foil,
	})
	ball(model, Vector3.new(0.6, y0 + h, 0.3), 1.5, rgb(90, 210, 255))
	part(model, {
		Size = Vector3.new(1.3, 1.3, 1.3),
		CFrame = CFrame.new(1.2, y0 + h - 0.1, -0.1) * CFrame.Angles(0, math.rad(20), math.rad(-12)),
		Color = rgb(170, 100, 255),
	})
	part(model, {
		Size = Vector3.new(0.3, 1.36, 1.36),
		CFrame = CFrame.new(1.2, y0 + h - 0.1, -0.1) * CFrame.Angles(0, math.rad(20), math.rad(-12)),
		Color = rgb(255, 220, 60),
	})
end

-- Luck: a shiny four-leaf clover.
BUILDERS.MenuLuck = function(model)
	local green, light, dark = rgb(30, 165, 65), rgb(120, 235, 120), rgb(15, 105, 45)
	local center = Vector3.new(0, 2.6, 0)
	-- The stem, curling down to the right.
	part(model, {
		Size = Vector3.new(0.35, 1.8, 0.35),
		CFrame = CFrame.new(center + Vector3.new(0.35, -1.5, 0.15)) * CFrame.Angles(0, 0, math.rad(-18)),
		Color = dark,
	})
	part(model, {
		Size = Vector3.new(0.35, 1.0, 0.35),
		CFrame = CFrame.new(center + Vector3.new(0.85, -2.6, 0.15)) * CFrame.Angles(0, 0, math.rad(-40)),
		Color = dark,
	})
	for k = 0, 3 do
		local a = math.rad(45 + k * 90)
		local out = Vector3.new(math.sin(a), math.cos(a), 0)
		local side = Vector3.new(math.cos(a), -math.sin(a), 0)
		-- A heart: two round lobes and a diamond point toward the middle.
		for _, s in { -1, 1 } do
			ball(model, center + out * 1.45 + side * s * 0.5, Vector3.new(1.45, 1.45, 0.6), green)
			ball(
				model,
				center + out * 1.6 + side * s * 0.5 + Vector3.new(0, 0, -0.22),
				Vector3.new(0.6, 0.6, 0.2),
				light
			)
		end
		part(model, {
			Size = Vector3.new(1.15, 1.15, 0.55),
			CFrame = CFrame.new(center + out * 0.75) * CFrame.Angles(0, 0, -a + math.rad(45)),
			Color = green,
		})
		-- A darker vein down the middle of the leaf.
		part(model, {
			Size = Vector3.new(0.14, 1.3, 0.1),
			CFrame = CFrame.new(center + out * 1.05 + Vector3.new(0, 0, -0.3)) * CFrame.Angles(0, 0, -a),
			Color = dark,
		})
	end
	ball(model, center + Vector3.new(0, 0, -0.1), Vector3.new(0.7, 0.7, 0.5), dark)
	sparkle(model, center + Vector3.new(-2, 2, -0.6), 0.9)
	sparkle(model, center + Vector3.new(2.2, -1.2, -0.6), 0.6)
end

-- Book: the Catalog, open, with a ribbon.
BUILDERS.MenuBook = function(model)
	local cover, pages, lines = rgb(225, 45, 80), rgb(255, 250, 235), rgb(190, 180, 170)
	local center = Vector3.new(0, 2, 0)
	for _, s in { -1, 1 } do
		local hinge = CFrame.new(center) * CFrame.Angles(math.rad(-25), 0, 0) * CFrame.Angles(0, math.rad(-s * 24), 0)
		part(model, {
			Size = Vector3.new(2.45, 3.25, 0.35),
			CFrame = hinge * CFrame.new(s * 1.2, 0, 0.3),
			Color = cover,
		})
		part(model, {
			Size = Vector3.new(2.1, 2.85, 0.3),
			CFrame = hinge * CFrame.new(s * 1.07, 0.02, 0),
			Color = pages,
		})
		for k = 0, 3 do
			part(model, {
				Size = Vector3.new(if k == 0 then 1 else 1.5, 0.12, 0.05),
				CFrame = hinge * CFrame.new(s * 1.07, 0.9 - k * 0.45, -0.17),
				Color = lines,
			})
		end
	end
	-- A little face on the left page and a ribbon hanging out.
	ball(model, center + Vector3.new(-1.05, 0.2, -0.45), Vector3.new(0.9, 0.9, 0.3), rgb(255, 160, 190))
	ball(model, center + Vector3.new(-1.25, 0.3, -0.62), Vector3.new(0.22, 0.22, 0.1), rgb(30, 30, 40))
	ball(model, center + Vector3.new(-0.85, 0.3, -0.62), Vector3.new(0.22, 0.22, 0.1), rgb(30, 30, 40))
	part(model, {
		Size = Vector3.new(0.35, 1.4, 0.06),
		CFrame = CFrame.new(center + Vector3.new(0.15, -1.9, -0.1)) * CFrame.Angles(0, 0, math.rad(8)),
		Color = rgb(235, 60, 80),
	})
	sparkle(model, center + Vector3.new(2.2, 1.9, -0.4), 0.8)
end

-- House: a little house made of real house parts.
BUILDERS.MenuHouse = function(model)
	local function add(partId: string, offset: CFrame)
		local item = HouseModel.item(partId)
		item:PivotTo(offset)
		for _, p in item:GetDescendants() do
			if p:IsA("BasePart") then
				p.Parent = model
			end
		end
		item:Destroy()
	end
	add("Candy_Walls", CFrame.new(0, 0, 0))
	add("Royal_Roof", CFrame.new(0, 4.8, 0))
	add("Basic_Door", CFrame.new(0, 0.4, -2.3) * CFrame.new(0, 0, 0))
end

-- My Life: the little house with a sunflower and a pet beside it.
BUILDERS.MenuLife = function(model)
	BUILDERS.MenuHouse(model)
	for _, entry in
		{ { "Plant_Sunflower", CFrame.new(3.6, 0, -0.4), 0.45 }, { "Pet_Oinkle", CFrame.new(-3.4, 0, -1.2), 0.9 } }
	do
		local item = ItemModel.buildNormal(entry[1])
		local pivot = item:GetPivot()
		for _, p in item:GetDescendants() do
			if p:IsA("BasePart") then
				local rel = pivot:ToObjectSpace(p.CFrame)
				p.Size *= entry[3]
				p.CFrame = entry[2] * (rel.Rotation + rel.Position * entry[3])
				p.Parent = model
			end
		end
		item:Destroy()
	end
end

-- Bag: the backpack.
BUILDERS.MenuBag = function(model)
	backpack(model, false)
end

-- Catalog: the book.
BUILDERS.MenuCatalog = function(model)
	BUILDERS.MenuBook(model)
end

-- Home: a fancy front door (it takes you home).
BUILDERS.MenuHome = function(model)
	local item = HouseModel.item("Royal_Door")
	for _, p in item:GetDescendants() do
		if p:IsA("BasePart") then
			p.Parent = model
		end
	end
	item:Destroy()
	sparkle(model, Vector3.new(2, 4.6, -0.8), 0.9)
end

-- Store: a cut diamond, built facet by facet.
BUILDERS.MenuStore = function(model)
	local girdle = Vector3.new(0, 2.6, 0)
	local radius, depth, top, tableRadius = 2.2, 2.4, 0.85, 1.35
	local up = Vector3.yAxis
	local function around(angle: number, r: number, y: number): Vector3
		local a = math.rad(angle)
		return girdle + Vector3.new(math.sin(a) * r, y, math.cos(a) * r)
	end
	local function facet(p1: Vector3, p2: Vector3, apex: Vector3, color: Color3)
		local base = (p1 + p2) / 2
		local toward = apex - base
		triangle(model, base, (p2 - p1).Unit, toward.Unit, (p2 - p1).Magnitude, toward.Magnitude, 0.15, color)
	end
	local tip = girdle - up * depth
	for k = 0, 7 do
		local a = k * 45
		local p1, p2 = around(a, radius, 0), around(a + 45, radius, 0)
		local light = k % 2 == 0
		-- The point underneath, the crown's slopes, and the little gaps between them.
		facet(p1, p2, tip, if light then rgb(110, 225, 255) else rgb(40, 170, 245))
		local q = around(a + 22.5, tableRadius, top)
		facet(p1, p2, q, if light then rgb(180, 242, 255) else rgb(95, 205, 255))
		facet(q, around(a + 67.5, tableRadius, top), p2, if light then rgb(140, 230, 255) else rgb(200, 248, 255))
	end
	part(model, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, tableRadius * 2.05, tableRadius * 2.05),
		CFrame = CFrame.new(girdle + up * top) * CFrame.Angles(0, 0, math.pi / 2),
		Color = rgb(225, 252, 255),
	})
	sparkle(model, girdle + Vector3.new(-1.3, 1.6, -1.8), 1)
	sparkle(model, girdle + Vector3.new(1.9, -1.2, -1.6), 0.7)
end

-- The box round everything you can see (counting stretched sphere meshes).
local function visibleBounds(model: Model): (Vector3, Vector3)
	local lo, hi
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p.Transparency < 1 then
			local size = p.Size
			local mesh = p:FindFirstChildOfClass("SpecialMesh")
			if mesh then
				size *= mesh.Scale
			end
			for _, x in { -0.5, 0.5 } do
				for _, y in { -0.5, 0.5 } do
					for _, z in { -0.5, 0.5 } do
						local point = p.CFrame:PointToWorldSpace(size * Vector3.new(x, y, z))
						lo = if lo then lo:Min(point) else point
						hi = if hi then hi:Max(point) else point
					end
				end
			end
		end
	end
	return lo or Vector3.zero, hi or Vector3.zero
end

-- A square icon (the side menu's pictures): framed to fill the square, seen almost
-- head-on. Returns the ViewportFrame and sway(t), which turns the picture gently from side
-- to side over time.
function ItemPictures.icon(key: string): (ViewportFrame, (number) -> ())
	local frame = Instance.new("ViewportFrame")
	frame.BackgroundTransparency = 1
	frame.Ambient = Color3.fromRGB(200, 200, 205)
	frame.LightColor = Color3.fromRGB(255, 250, 240)
	frame.LightDirection = Vector3.new(-0.8, -1.2, 1)

	local model = Instance.new("Model")
	BUILDERS[key](model)
	Lego.apply(model)
	model.Parent = frame

	local lo, hi = visibleBounds(model)
	local center = (lo + hi) / 2
	local extent = hi - lo
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	local fit = math.max(extent.X, extent.Y, extent.Z * 0.7) / 2 * 1.05
	local distance = fit / math.tan(math.rad(15)) + extent.Z / 2
	local direction = Vector3.new(0.3, 0.22, -1).Unit
	local function sway(t: number)
		local turn = CFrame.Angles(0, math.sin(t) * math.rad(14), 0)
		camera.CFrame = CFrame.lookAt(center + turn:VectorToWorldSpace(direction) * distance, center)
	end
	sway(0)
	camera.Parent = frame
	frame.CurrentCamera = camera
	return frame, sway
end

-- Frames a model in a ViewportFrame, seen a little from above and the side.
local function framed(model: Model, height: number?, silhouette: boolean?): ViewportFrame
	local frame = Instance.new("ViewportFrame")
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.new(1, 0, 0, height or 100)
	frame.Ambient = Color3.fromRGB(195, 195, 200)
	frame.LightColor = Color3.fromRGB(255, 250, 240)
	frame.LightDirection = Vector3.new(-1, -1.4, 1)
	frame.ImageColor3 = if silhouette then Color3.new(0, 0, 0) else Color3.new(1, 1, 1)
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	Lego.apply(model)
	model.Parent = frame
	local lo, hi = visibleBounds(model)
	local center = (lo + hi) / 2
	local extent = hi - lo
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	local fit = math.max(extent.Y, math.max(extent.X, extent.Z) * 0.8 / 1.6) / 2 * 1.12
	local distance = fit / math.tan(math.rad(15)) + extent.Z / 2
	camera.CFrame = CFrame.lookAt(center + Vector3.new(0.45, 0.4, -1).Unit * distance, center)
	camera.Parent = frame
	frame.CurrentCamera = camera
	return frame
end

-- Any item (house part, pet, yard item, plant). silhouette = true draws it solid black
-- ("???" in the Catalog).
function ItemPictures.part(itemId: string, height: number?, silhouette: boolean?, mutations): ViewportFrame
	return framed(ItemModel.buildNormal(itemId, mutations), height, silhouette)
end

-- A zone's egg (designed around the item inside, if given).
function ItemPictures.egg(zoneIndex: number, height: number?, itemId: string?): ViewportFrame
	return framed((EggModel.build(zoneIndex, itemId)), height)
end

function ItemPictures.has(key: string): boolean
	return BUILDERS[key] ~= nil
end

-- A ViewportFrame showing the item, framed to fit, seen a little from above and the side.
function ItemPictures.view(key: string, height: number?): ViewportFrame
	local frame = Instance.new("ViewportFrame")
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.new(1, 0, 0, height or 90)
	frame.Ambient = Color3.fromRGB(190, 190, 190)
	frame.LightColor = Color3.fromRGB(255, 250, 240)
	frame.LightDirection = Vector3.new(-1, -1.4, 1)

	local model = Instance.new("Model")
	if BUILDERS[key] then
		BUILDERS[key](model)
	end
	Lego.apply(model)
	model.Parent = frame

	local lo, hi = visibleBounds(model)
	local center = (lo + hi) / 2
	local extent = hi - lo
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	-- The picture strip is about twice as wide as it is tall, so wide items can use the
	-- width (the field of view is vertical).
	local aspect = 2
	local wide = math.max(extent.X, extent.Z) * 0.85
	local fit = math.max(extent.Y, wide / aspect) / 2 * 1.08
	local distance = fit / math.tan(math.rad(15)) + extent.Z / 2
	local direction = Vector3.new(0.45, 0.4, -1).Unit
	camera.CFrame = CFrame.lookAt(center + direction * distance, center)
	camera.Parent = frame
	frame.CurrentCamera = camera
	return frame
end

return ItemPictures
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">LuckyWheel</string>
            <string name="Source"><![CDATA[-- The Lucky Wheel, drawn like the prize wheels in the big simulators: bright pie slices
-- (each with a big icon, its prize and its chance) inside a chunky gold rim ringed with
-- blinking bulbs, a red pointer at the top, and a hub in the middle that can be the SPIN
-- button. LuckyWheel.build returns the wheel and spinTo(slice, onDone), which spins it
-- round a few times and stops with that slice under the pointer.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Luck = require(ReplicatedStorage.Shared.Luck)
local UI = require(script.Parent.UI)

local LuckyWheel = {}

-- Slice colours go round the wheel in a rainbow, so neighbours always differ.
local SLICE_COLORS = {
	Color3.fromRGB(255, 90, 160),
	Color3.fromRGB(70, 160, 255),
	Color3.fromRGB(255, 205, 50),
	Color3.fromRGB(80, 210, 110),
	Color3.fromRGB(165, 100, 250),
	Color3.fromRGB(255, 140, 50),
	Color3.fromRGB(40, 205, 200),
	Color3.fromRGB(105, 80, 255),
}
local ICONS = {
	Coins = "💰",
	["Big Coins"] = "💵",
	["Golden Egg"] = "⭐",
	["Mystery Box"] = "📦",
	["Huge Coins"] = "🤑",
	["Rainbow Egg"] = "🌈",
	["Mega Box"] = "🎁",
	JACKPOT = "👑",
}

-- Short names that fit on a slice.
local SHORT = {
	Coins = "COINS",
	["Big Coins"] = "BIG $",
	["Golden Egg"] = "GOLDEN",
	["Mystery Box"] = "BOX",
	["Huge Coins"] = "HUGE $",
	["Rainbow Egg"] = "RAINBOW",
	["Mega Box"] = "MEGA BOX",
	JACKPOT = "JACKPOT",
}

local function circle(props, children)
	local frame = UI.new("Frame", props, children)
	UI.corner(999).Parent = frame
	return frame
end

-- size: the wheel's width in pixels. opts.hubText: text on the hub (e.g. "SPIN!"),
-- opts.onHub: makes the hub a button. opts.zIndex: base ZIndex.
function LuckyWheel.build(parent: Instance, size: number, opts)
	opts = opts or {}
	local z = opts.zIndex or 1
	local count = #Luck.WHEEL
	local sliceAngle = 360 / count

	local frame = UI.new("Frame", {
		Name = "LuckyWheel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	})

	-- The gold rim with its outline.
	circle({
		Name = "Rim",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 200, 60),
		ZIndex = z,
		Parent = frame,
	}, {
		UI.stroke(nil, 4),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 240, 160), Color3.fromRGB(230, 140, 20)),
			Rotation = 90,
		}),
	})

	-- Bulbs round the rim.
	local bulbs = {}
	local bulbCount = 16
	for k = 1, bulbCount do
		local a = math.rad((k - 1) / bulbCount * 360)
		local bulb = circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(a) * size * 0.465, 0.5, -math.cos(a) * size * 0.465),
			Size = UDim2.fromOffset(size * 0.04, size * 0.04),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = z + 1,
			Parent = frame,
		}, { UI.stroke(nil, 1.5) })
		table.insert(bulbs, bulb)
	end

	-- The spinning part: the slices and their labels.
	local radius = size * 0.42
	local spinner = UI.new("Frame", {
		Name = "Spinner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(radius * 2, radius * 2),
		BackgroundTransparency = 1,
		ZIndex = z + 1,
		Parent = frame,
	})
	circle({
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UI.OUTLINE,
		ZIndex = z + 1,
		Parent = spinner,
	})
	-- Each slice is filled with thin wedges fanned out from the middle. Roblox turns a frame
	-- about its own centre, so each wedge is a full-diameter strip centred on the wheel
	-- (turning about the wheel's centre) with only its top half coloured.
	local wedges = 10
	local step = sliceAngle / wedges
	local wedgeWidth = radius * math.rad(step) * 1.3
	local function strip(rotation: number, width: number, zIndex: number)
		return UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(width, radius * 2 - 6),
			Rotation = rotation,
			BackgroundTransparency = 1,
			ZIndex = zIndex,
			Parent = spinner,
		})
	end
	-- A point `distance` out from the middle along `angle` (degrees clockwise from the top).
	local function at(angle: number, distance: number): UDim2
		local a = math.rad(angle)
		return UDim2.new(0.5, math.sin(a) * distance, 0.5, -math.cos(a) * distance)
	end
	for i, slice in Luck.WHEEL do
		local color = SLICE_COLORS[(i - 1) % #SLICE_COLORS + 1]
		for k = 0, wedges - 1 do
			UI.new("Frame", {
				Size = UDim2.fromScale(1, 0.5),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				ZIndex = z + 2,
				Parent = strip((i - 1) * sliceAngle + (k + 0.5) * step, wedgeWidth, z + 2),
			}, {
				-- Lighter toward the rim.
				UI.new("UIGradient", {
					Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 205)),
					Rotation = 90,
				}),
			})
		end
		-- A dark line between slices.
		UI.new("Frame", {
			Size = UDim2.fromScale(1, 0.5),
			BackgroundColor3 = UI.OUTLINE,
			BorderSizePixel = 0,
			ZIndex = z + 3,
			Parent = strip((i - 1) * sliceAngle, 3, z + 3),
		})

		local middle = (i - 0.5) * sliceAngle
		-- The big icon out by the rim, standing up toward it.
		UI.label(ICONS[slice.label] or "🎁", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = at(middle, radius * 0.82),
			Size = UDim2.fromOffset(radius * 0.27, radius * 0.27),
			Rotation = middle,
			ZIndex = z + 5,
			Parent = spinner,
		})
		-- The prize and its chance, reading outward from the hub.
		local text = UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = at(middle, radius * 0.5),
			Size = UDim2.fromOffset(radius * 0.4, radius * 0.27),
			Rotation = middle - 90,
			BackgroundTransparency = 1,
			ZIndex = z + 4,
			Parent = spinner,
		})
		UI.label(SHORT[slice.label] or string.upper(slice.label), {
			Size = UDim2.fromScale(1, 0.6),
			FontFace = UI.fonts.heavy,
			ZIndex = z + 5,
			Parent = text,
		})
		UI.label(string.format("%.0f%%", Luck.wheelPercent(i)), {
			Position = UDim2.fromScale(0, 0.6),
			Size = UDim2.fromScale(1, 0.4),
			TextColor3 = Color3.fromRGB(255, 250, 200),
			ZIndex = z + 5,
			Parent = text,
		})
	end

	-- The hub in the middle (the SPIN button in the Luck window).
	local hub = UI.new(if opts.onHub then "TextButton" else "TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size * 0.21, size * 0.21),
		BackgroundColor3 = Color3.new(1, 1, 1),
		FontFace = UI.fonts.heavy,
		Text = opts.hubText or "🎡",
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = z + 6,
		Parent = frame,
	}, {
		UI.corner(999),
		UI.stroke(nil, 4),
		UI.textStroke(2.5),
		UI.new("UIGradient", {
			Color = ColorSequence.new(UI.colors.fusion, UI.colors.fusion2),
			Rotation = 45,
		}),
		UI.new("UIPadding", {
			PaddingLeft = UDim.new(0.14, 0),
			PaddingRight = UDim.new(0.14, 0),
			PaddingTop = UDim.new(0.22, 0),
			PaddingBottom = UDim.new(0.22, 0),
		}),
	})
	if opts.onHub then
		(hub :: TextButton).AutoButtonColor = false
		(hub :: TextButton).Activated:Connect(opts.onHub)
	end

	-- The pointer at the top: a red tip with a gold cap.
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, size * 0.06),
		Size = UDim2.fromOffset(size * 0.09, size * 0.09),
		Rotation = 45,
		BackgroundColor3 = UI.colors.red,
		ZIndex = z + 7,
		Parent = frame,
	}, { UI.corner(4), UI.stroke(nil, 3) })
	circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, size * 0.015),
		Size = UDim2.fromOffset(size * 0.07, size * 0.07),
		BackgroundColor3 = Color3.fromRGB(255, 205, 60),
		ZIndex = z + 8,
		Parent = frame,
	}, { UI.stroke(nil, 3) })

	-- Bulbs blink in turn (faster while spinning).
	local spinning = false
	task.spawn(function()
		local tick = 0
		while frame.Parent do
			tick += 1
			for k, bulb in bulbs do
				local on = (k + tick) % 2 == 0
				bulb.BackgroundColor3 = if on then Color3.fromRGB(255, 250, 200) else Color3.fromRGB(255, 120, 60)
			end
			task.wait(if spinning then 0.08 else 0.45)
		end
	end)

	local wheel = { frame = frame, hub = hub }
	-- Spins round several times and stops with `slice` under the pointer.
	function wheel.spinTo(slice: number, onDone: (() -> ())?)
		spinning = true
		local target = -((slice - 0.5) * sliceAngle) - 360 * 6 + (math.random() - 0.5) * sliceAngle * 0.6
		local tween = TweenService:Create(
			spinner,
			TweenInfo.new(4.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{ Rotation = target }
		)
		tween:Play()
		tween.Completed:Connect(function()
			spinning = false
			if onDone then
				onDone()
			end
		end)
	end
	return wheel
end

return LuckyWheel
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="61">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- The player's screen: money and Speed, the side menu, and the Shop / Luck / My Life / Bag /
-- Catalog / Store windows. The server is the source of truth; this only shows
-- state and sends requests.

local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

print("[Steal a Life] Client starting")

-- If the game hasn't loaded after a few seconds, show what the server is stuck on.
local clientReady = false
task.delay(8, function()
	if clientReady then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "LoadingProblem"
	gui.DisplayOrder = 100
	gui.ResetOnSpawn = false
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.8, 0, 0.6, 0)
	label.Position = UDim2.fromScale(0.1, 0.2)
	label.BackgroundColor3 = Color3.fromRGB(40, 0, 0)
	label.BackgroundTransparency = 0.15
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextWrapped = true
	label.TextSize = 16
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Font = Enum.Font.Code
	label.Parent = gui
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	while not clientReady do
		label.Text = "The game didn't finish loading. Send this to the developer:\n\nServer: "
			.. tostring(ReplicatedStorage:GetAttribute("ServerStartup") or "no status (server script never ran)")
		task.wait(1)
	end
	gui:Destroy()
end)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local EggModel = require(Shared.EggModel)
local Format = require(Shared.Format)
local GamePasses = require(Shared.GamePasses)
local LifeUtil = require(Shared.LifeUtil)
local Luck = require(Shared.Luck)
local Mutations = require(Shared.Mutations)
local Items = require(Shared.Items)
local Parts = require(Shared.Parts)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)
local AdminPanel = require(script.Parent.AdminPanel)
local Ambient = require(script.Parent.Ambient)
local EventFX = require(script.Parent.EventFX)
local GuardianFX = require(script.Parent.GuardianFX)
local Hud = require(script.Parent.Hud)
local ItemPictures = require(script.Parent.ItemPictures)
local LuckyWheel = require(script.Parent.LuckyWheel)
local PackReveal = require(script.Parent.PackReveal)
local PetFX = require(script.Parent.PetFX)
local TreadmillRun = require(script.Parent.TreadmillRun)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local colors = UI.colors

local actionRemote = Remotes.get("Action")
local function send(action: string, ...)
	actionRemote:FireServer(action, ...)
end

local state = nil
local discoveries = {}

--------------------------------------------------------------------------------
-- Screen layout
--------------------------------------------------------------------------------

local screen = UI.new("ScreenGui", {
	Name = "StealALifeUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

Hud.money(screen)
Hud.speed(screen)
Hud.eventChip(screen)
Hud.luckChip(screen)
Hud.eventBanner(screen)
AdminPanel.start(screen)
EventFX.start()
Hud.leaderboard(screen)
Hud.vipChatTag()
Hud.zoneBanner(screen)
Hud.carrying(screen)
local toast = Hud.toasts(screen)

-- Which build is running (and anything the server found covering the yards), small in
-- the bottom-left corner.
do
	local label = UI.label("", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 8, 1, -4),
		Size = UDim2.new(0.6, 0, 0, 18),
		TextScaled = false,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(220, 225, 255),
		Parent = screen,
	})
	local function update()
		local problems = ReplicatedStorage:GetAttribute("GroundProblems")
		label.Text = "build " .. Config.BUILD .. (if problems then "  ·  ⚠ " .. problems else "")
	end
	ReplicatedStorage:GetAttributeChangedSignal("GroundProblems"):Connect(update)
	update()
end

-- Windows: a light body under a header bar in the window's own colour, with a slanted
-- title tab in the game's purple-to-pink sticking out over the top-left corner and a red
-- square X (the clean simulator style of Pet Simulator and PLS DONATE).
local window = UI.new("Frame", {
	Name = "Window",
	Visible = false,
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.53, 0.53),
	Size = UDim2.fromScale(0.66, 0.74),
	BackgroundColor3 = colors.sheet,
	ZIndex = 5, -- above the leaderboard and other HUD pieces
	Parent = screen,
}, {
	UI.corner(22),
	UI.stroke(nil, 4),
	UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(220, 215, 235)),
		Rotation = 90,
	}),
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(860, 600) }),
})
local header = UI.new("Frame", {
	Name = "Header",
	Size = UDim2.new(1, 0, 0, 58),
	BackgroundColor3 = colors.green,
	ZIndex = 5,
	Parent = window,
}, {
	UI.corner(20),
	UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 200)),
		Rotation = 90,
	}),
})
-- Square off the header's bottom corners, with a dark line under it.
local headerFill = UI.new("Frame", {
	Position = UDim2.new(0, 0, 1, -20),
	Size = UDim2.new(1, 0, 0, 20),
	BackgroundColor3 = colors.green,
	BorderSizePixel = 0,
	ZIndex = 5,
	Parent = header,
}, {
	UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(215, 215, 222), Color3.fromRGB(190, 190, 200)),
		Rotation = 90,
	}),
})
UI.new("Frame", {
	Position = UDim2.new(0, 0, 1, 0),
	Size = UDim2.new(1, 0, 0, 4),
	BackgroundColor3 = UI.OUTLINE,
	BorderSizePixel = 0,
	ZIndex = 5,
	Parent = header,
})
local titleRibbon = UI.new("Frame", {
	Name = "TitleTab",
	Position = UDim2.fromOffset(18, -22),
	Size = UDim2.fromOffset(0, 58),
	AutomaticSize = Enum.AutomaticSize.X,
	Rotation = -4,
	BackgroundColor3 = Color3.new(1, 1, 1),
	ZIndex = 6,
	Parent = window,
}, {
	UI.corner(14),
	UI.stroke(nil, 4),
	UI.new("UIGradient", {
		Color = ColorSequence.new(colors.fusion, colors.fusion2),
		Rotation = 0,
	}),
	UI.new("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 22) }),
	UI.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	}),
})
local windowTitle = UI.new("TextLabel", {
	Size = UDim2.fromOffset(0, 46),
	AutomaticSize = Enum.AutomaticSize.X,
	BackgroundTransparency = 1,
	FontFace = UI.fonts.heavy,
	TextSize = 36,
	TextColor3 = Color3.new(1, 1, 1),
	ZIndex = 7,
	Parent = titleRibbon,
}, { UI.textStroke(3) })
local function paintHeader(color: Color3)
	header.BackgroundColor3 = color
	headerFill.BackgroundColor3 = color
end
local body = UI.new("ScrollingFrame", {
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Position = UDim2.fromOffset(14, 70),
	Size = UDim2.new(1, -28, 1, -82),
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollBarThickness = 8,
	Parent = window,
}, {
	UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	UI.new("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 8),
	}),
})

--------------------------------------------------------------------------------
-- Windows
--------------------------------------------------------------------------------

local currentWindow = nil
local renderers = {}
local liveTimers = {} -- { { label, egg } } counting down (and weighing) on the Nests tab

local function clearBody()
	table.clear(liveTimers)
	for _, child in body:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

local function render()
	if not currentWindow or not state then
		return
	end
	clearBody()
	renderers[currentWindow]()
end

local setActiveTab = function(_name: string?) end
local TAB_ICONS = {}
local TAB_COLORS = {}

local function open(name: string)
	if currentWindow == name then
		currentWindow = nil
		window.Visible = false
		setActiveTab(nil)
		return
	end
	currentWindow = name
	setActiveTab(name)
	windowTitle.Text = (TAB_ICONS[name] or "") .. " " .. (if name == "Life" then "MY LIFE" else string.upper(name))
	paintHeader(TAB_COLORS[name] or colors.blue)
	window.Visible = true
	body.CanvasPosition = Vector2.zero
	render()
end

UI.button("X", colors.red, function()
	open(currentWindow)
end, {
	AnchorPoint = Vector2.new(1, 0.5),
	Size = UDim2.fromOffset(50, 50),
	Position = UDim2.new(1, 12, 0, 6),
	ZIndex = 7,
	Parent = window,
})

-- A line of text over the cards: short ones are bold section titles, long ones are hints.
local function heading(text: string, order: number, color: Color3?)
	local title = #text <= 28
	return UI.label(text, {
		Size = UDim2.new(1, 0, 0, if title then 32 else 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = if title then UI.fonts.heavy else UI.fonts.bold,
		TextColor3 = color or (if title then Color3.new(1, 1, 1) else colors.muted),
		LayoutOrder = order,
		Parent = body,
	})
end

-- A row of buttons across the window.
local function buttonRow(order: number, buttons: { GuiButton })
	local row = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 48),
		LayoutOrder = order,
		Parent = body,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i, button in buttons do
		button.Size = UDim2.fromOffset(220, 46)
		button.LayoutOrder = i
		button.Parent = row
	end
	return row
end

-- Button that needs a second tap within 3 seconds.
local function confirmButton(text: string, color: Color3, onConfirm: () -> ())
	local armed = false
	local button
	button = UI.button(text, color, function()
		if armed then
			onConfirm()
			return
		end
		armed = true
		button.Text = "Tap again!"
		task.delay(3, function()
			if button.Parent then
				armed = false
				button.Text = text
			end
		end)
	end)
	return button
end

-- An item's name, coloured by its mutation (or rarity).
local function partColor(record): Color3
	local top = Mutations.top(record.mutations)
	if top then
		return Mutations.byId[top].color
	end
	return Items.color(record.id)
end

-- A wide glossy banner card (treadmill, Starter Pack, box bundles, VIP): returns the frame.
local function banner(order: number, colorA: Color3, colorB: Color3, height: number)
	local frame = UI.new("Frame", {
		Size = UDim2.new(1, -8, 0, height),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = order,
		Parent = body,
	}, {
		UI.corner(18),
		UI.stroke(nil, 4),
		UI.new("UIGradient", { Color = ColorSequence.new(colorA, colorB), Rotation = 15 }),
	})
	UI.new("Frame", {
		Position = UDim2.fromOffset(6, 5),
		Size = UDim2.new(1, -12, 0.4, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.8,
		Parent = frame,
	}, { UI.corner(14) })
	return frame
end

local function bannerText(parent: Instance, title: string, lines: string, x: number, color: Color3)
	local titleLabel = UI.label(title, {
		Position = UDim2.fromOffset(x, 12),
		Size = UDim2.new(1, -x - 230, 0, 44),
		FontFace = UI.fonts.heavy,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
	titleLabel.UIStroke.Thickness = 3
	return UI.label(lines, {
		Position = UDim2.fromOffset(x + 2, 58),
		Size = UDim2.new(1, -x - 232, 0, 70),
		TextScaled = false,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = parent,
	})
end

local function bannerButton(parent: Instance, button: GuiButton)
	button.AnchorPoint = Vector2.new(1, 0.5)
	button.Position = UDim2.new(1, -20, 0.5, 6)
	button.Size = UDim2.fromOffset(190, 54)
	button.Parent = parent
	return button
end

-- A row of Mystery Box pictures inside a banner.
local function boxRow(parent: Instance, crateId: string, count: number, x: number, size: number)
	for k = 1, count do
		local view = UI.boxViewport(crateId, size)
		view.Position = UDim2.fromOffset(x + (k - 1) * size * 0.62, 18)
		view.Size = UDim2.fromOffset(size, size)
		view.ZIndex = 3
		view.Parent = parent
	end
end

--------------------------------------------------------------------------------
-- Shop: the treadmill and the zones
--------------------------------------------------------------------------------

local function speedGain(level: number): number
	return Config.treadmillGain(level) * GamePasses.speedMultiplier(player)
end

-- "Common 70% · Uncommon 25% · Rare 5%"
local function percentText(percent: number): string
	return if percent < 1 then string.format("%.1f%%", percent) else string.format("%.0f%%", percent)
end

function renderers.Shop()
	-- The treadmill, big across the top.
	local level = state.treadmill or 1
	local frame = banner(1, Color3.fromRGB(70, 160, 255), Color3.fromRGB(120, 90, 255), 150)
	local picture = ItemPictures.view("Treadmill", 140)
	picture.Position = UDim2.fromOffset(10, 5)
	picture.Size = UDim2.fromOffset(150, 140)
	picture.Parent = frame
	local maxed = level >= Config.TREADMILL_MAX
	bannerText(
		frame,
		"TREADMILL  LV " .. level,
		"Run on the treadmill in your yard to train ⚡ Speed.\nNow: +"
			.. Format.number(speedGain(level))
			.. " ⚡/s"
			.. (
				if maxed
					then "  (max level!)"
					else "   ➜   Next: +" .. Format.number(speedGain(level + 1)) .. " ⚡/s"
			),
		170,
		Color3.fromRGB(150, 230, 255)
	)
	local cost = Config.treadmillCost(level)
	bannerButton(
		frame,
		if maxed
			then UI.button("MAXED!", colors.gray, function() end)
			else UI.pricePill("UPGRADE " .. Format.money(cost), function()
				send("UpgradeTreadmill")
			end)
	)

	-- The zones, their eggs and the Speed each one needs.
	local speed = player:GetAttribute("Speed") or state.speed or 0
	heading("Zones", 2)
	heading("Grab an egg and outrun the guardian! Train ⚡ Speed to reach the deeper zones.", 3)
	local grid = UI.grid(210, 300)
	grid.LayoutOrder = 4
	grid.Parent = body
	for i, zone in Items.ZONES do
		local kind = Items.KINDS[zone.kind]
		local ready = speed >= zone.speed
		local odds = Items.oddsList(i)
		local best = odds[#odds]
		local card = UI.card({
			egg = i,
			pictureHeight = 100,
			accent = zone.eggColor,
			border = if ready then colors.money else nil,
			lines = {
				{ zone.name, nil, 24 },
				{
					"⚡ " .. (if zone.speed > 0 then Format.number(zone.speed) else "Any") .. " Speed",
					Color3.fromRGB(150, 230, 255),
					20,
				},
				{ kind.icon .. " " .. Items.eggName(i) .. "s", colors.text, 18 },
				{
					"Up to " .. best.rarity .. " (" .. percentText(best.percent) .. ")",
					Rarities.info[best.rarity].color:Lerp(Color3.new(1, 1, 1), 0.3),
					17,
				},
				{
					if ready
						then "✅ You're fast enough!"
						else "🔒 Need " .. Format.number(zone.speed - speed) .. " more",
					if ready then colors.money else Color3.fromRGB(255, 200, 200),
					18,
				},
			},
		})
		card.LayoutOrder = i
		card.Parent = grid
	end
end

--------------------------------------------------------------------------------
-- My Life: the nests, the house, the pets, the yard and the garden
--------------------------------------------------------------------------------

local lifeTab = "Nests"
local LIFE_TABS = {
	{ "Nests", "🥚", Color3.fromRGB(255, 190, 60) },
	{ "House", "🏠", Items.KINDS.House.color },
	{ "Pets", "🐾", Items.KINDS.Pet.color },
	{ "Yard", "🛝", Items.KINDS.Yard.color },
	{ "Garden", "🌷", Items.KINDS.Plant.color },
}
local function tabRow(order: number, tabs, current: string, onPick: (string) -> ())
	local row = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
		Parent = body,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(132, 40),
			CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i, tab in tabs do
		local button = UI.button(tab[2] .. " " .. tab[1], if tab[1] == current then tab[3] else colors.gray, function()
			onPick(tab[1])
		end)
		button.LayoutOrder = i
		button.Parent = row
	end
end

-- A card for an item that's out, with a TAKE OFF button.
local function placedCard(uid: string, title: string)
	local record = state.parts[uid]
	local info = Items.byId[record.id]
	return UI.card({
		part = record.id,
		mutations = record.mutations,
		pictureHeight = 110,
		lines = {
			{ title, nil, 22 },
			{ LifeUtil.displayName(record), partColor(record):Lerp(Color3.new(1, 1, 1), 0.2), 20 },
			{ LifeUtil.weightText(record), Items.weightColor(Items.weightFactor(record)), 18 },
			{ Format.money(LifeUtil.itemIncome(record)) .. "/s", colors.money, 20 },
		},
		buttons = {
			UI.button("TAKE OFF", colors.blue, function()
				send("TakeOff", uid)
			end, { Size = UDim2.new(1, 0, 0, 36) }),
		},
		tag = { info.rarity:upper(), Items.color(record.id) },
	})
end

-- An empty spot: hatch more eggs!
local function emptyCard(title: string, hint: string)
	return UI.card({
		accent = Color3.fromRGB(150, 150, 170),
		lines = { { title, nil, 22 }, { hint, colors.muted, 36 } },
		buttons = {
			UI.button("Find eggs!", colors.gray, function()
				open("Shop")
			end, { Size = UDim2.new(1, 0, 0, 36) }),
		},
	})
end

local function nestCards(grid: Instance)
	local count = LifeUtil.nestCount(GamePasses.extraNests(player))
	local now = Items.now()
	for n = 1, Items.NESTS + 2 do
		local egg = state.nests and state.nests[tostring(n)]
		local card
		if n > count then
			card = UI.card({
				picture = "ExtraPen",
				pictureHeight = 100,
				accent = Color3.fromRGB(150, 150, 170),
				lines = { { "Nest " .. n, nil, 22 }, { "🔒 Extra Nests pass", colors.muted, 20 } },
				buttons = {
					UI.button("STORE", colors.pink, function()
						open("Store")
					end, { Size = UDim2.new(1, 0, 0, 36) }),
				},
			})
		elseif not egg then
			card = emptyCard("Nest " .. n, "Empty! Grab an egg in a zone and run it home.")
		else
			local ready = egg.endsAt <= now
			local zone = Items.ZONES[egg.zone]
			local weight = Items.eggWeightAt(egg, now)
			local timer = {
				if ready
					then "🐣 READY! · " .. Format.weight(weight)
					else "⏱ " .. Format.time(egg.endsAt - now) .. " · " .. Format.weight(weight),
				if ready then colors.money else colors.text,
				20,
			}
			card = UI.card({
				egg = egg.zone,
				eggItem = egg.item,
				pictureHeight = 100,
				accent = Rarities.info[egg.rarity].color,
				border = if ready then colors.money else nil,
				lines = {
					{ "Nest " .. n, nil, 22 },
					{
						Items.KINDS[zone.kind].icon .. " " .. Items.itemEggName(egg.zone, egg.item),
						Items.weightColor(weight / (egg.baseWeight or weight)),
						19,
					},
					timer,
				},
				buttons = {
					UI.button("HATCH!", if ready then colors.green else colors.gray, function()
						send("Hatch", n)
					end, { Size = UDim2.new(1, 0, 0, 36) }),
				},
				tag = { egg.rarity:upper(), Rarities.info[egg.rarity].color },
			})
			if not ready then
				-- The third text line is the timer: count it down without re-rendering.
				for _, label in card:GetDescendants() do
					if label:IsA("TextLabel") and string.sub(label.Text, 1, 3) == "⏱" then
						table.insert(liveTimers, { label = label, egg = egg })
					end
				end
			end
		end
		card.LayoutOrder = n
		card.Parent = grid
	end
end

function renderers.Life()
	local income = LifeUtil.totalIncome(state) * GamePasses.coinMultiplier(player)
	heading("Your life earns " .. Format.money(income) .. "/s", 1, colors.money)
	tabRow(2, LIFE_TABS, lifeTab, function(name)
		lifeTab = name
		render()
	end)
	buttonRow(3, {
		UI.button("⬆ PUT OUT BEST", colors.green, function()
			send("PlaceBest")
		end),
	})
	local grid = UI.grid(200, 280)
	grid.LayoutOrder = 4
	grid.Parent = body
	if lifeTab == "Nests" then
		heading("Eggs grow in your nests. Rarer eggs take longer!", 5)
		nestCards(grid)
	elseif lifeTab == "House" then
		for i, slot in Parts.SLOTS do
			local record, uid = LifeUtil.installedRecord(state, slot.id)
			local card
			if record then
				card = placedCard(uid, slot.icon .. " " .. slot.name)
			else
				local basic = { id = Parts.basic(slot.id) }
				card = UI.card({
					part = basic.id,
					pictureHeight = 110,
					accent = Color3.fromRGB(150, 150, 170),
					lines = {
						{ slot.icon .. " " .. slot.name, nil, 22 },
						{ "Basic", colors.muted, 20 },
						{ Format.money(LifeUtil.itemIncome(basic)) .. "/s", colors.money, 20 },
					},
					buttons = {
						UI.button("Hatch a better one!", colors.gray, function()
							open("Shop")
						end, { Size = UDim2.new(1, 0, 0, 36) }),
					},
				})
			end
			card.LayoutOrder = i
			card.Parent = grid
		end
	elseif lifeTab == "Pets" then
		local pets = LifeUtil.pets(state)
		for n = 1, Items.PET_SLOTS do
			local card = if pets[n]
				then placedCard(pets[n], "🐾 Pet " .. n)
				else emptyCard("🐾 Pet " .. n, "Hatch Wilds Eggs to get pets that roam your yard!")
			card.LayoutOrder = n
			card.Parent = grid
		end
	else
		local where = if lifeTab == "Yard" then state.yard else state.garden
		local count = if lifeTab == "Yard" then Items.YARD_SPOTS else Items.GARDEN_BEDS
		local icon = if lifeTab == "Yard" then "🛝 Spot " else "🌷 Bed "
		for n = 1, count do
			local uid = where and where[tostring(n)]
			local card = if uid and state.parts[uid]
				then placedCard(uid, icon .. n)
				else emptyCard(
					icon .. n,
					if lifeTab == "Yard"
						then "Hatch Yard Sale Eggs for swings, pools and more!"
						else "Hatch Garden Eggs for flowers and trees!"
				)
			card.LayoutOrder = n
			card.Parent = grid
		end
	end
end

--------------------------------------------------------------------------------
-- Bag: items that aren't out
--------------------------------------------------------------------------------

function renderers.Bag()
	local list = LifeUtil.backpack(state)
	heading("🎒 Backpack  " .. #list .. " / " .. GamePasses.backpackSize(player), 1)
	if #list == 0 then
		heading("Empty! Hatched items that aren't better than yours go here.", 2)
		return
	end
	local total = 0
	for _, uid in list do
		total += LifeUtil.sellPrice(state.parts[uid])
	end
	buttonRow(2, {
		UI.button("⬆ PUT OUT BEST", colors.green, function()
			send("PlaceBest")
		end),
		confirmButton("SELL ALL " .. Format.money(total), colors.red, function()
			send("SellBackpack")
		end),
	})
	local grid = UI.grid(200, 300)
	grid.LayoutOrder = 3
	grid.Parent = body
	for i, uid in list do
		local record = state.parts[uid]
		local info = Items.byId[record.id]
		local upgrade = LifeUtil.isUpgrade(state, uid)
		local kind = Items.KINDS[info.kind]
		local card = UI.card({
			part = record.id,
			mutations = record.mutations,
			pictureHeight = 110,
			border = if upgrade then colors.money else nil,
			lines = {
				{ LifeUtil.displayName(record), nil, 22 },
				{
					kind.icon .. " " .. (info.slot or kind.name) .. " · " .. info.rarity .. (if record.weight
						then " · " .. Format.weight(record.weight)
						else ""),
					partColor(record):Lerp(Color3.new(1, 1, 1), 0.2),
					18,
				},
				{ Format.money(LifeUtil.itemIncome(record)) .. "/s", colors.money, 20 },
				{
					if upgrade then "▲ Upgrade!" else "▼ Yours are better",
					if upgrade then colors.money else Color3.fromRGB(255, 200, 200),
					18,
				},
			},
			buttons = {
				UI.button("PUT OUT", colors.green, function()
					send("Place", uid)
				end, { Size = UDim2.new(1, 0, 0, 34) }),
				confirmButton("SELL " .. Format.money(LifeUtil.sellPrice(record)), colors.red, function()
					send("Sell", uid)
				end),
			},
			tag = if upgrade then { "UP!", colors.green } else nil,
		})
		card.LayoutOrder = i
		card.Parent = grid
	end
end

--------------------------------------------------------------------------------
-- Catalog: every item, kind by kind (house parts style by style)
--------------------------------------------------------------------------------

local catalogKind = "House"
local catalogStyle = "Scrap" -- which house style the Catalog is showing
local CATALOG_TABS = {
	{ "House", "🏠", Items.KINDS.House.color },
	{ "Pet", "🐾", Items.KINDS.Pet.color },
	{ "Yard", "🛝", Items.KINDS.Yard.color },
	{ "Plant", "🌷", Items.KINDS.Plant.color },
}

local function catalogCard(id: string, title: string)
	local info = Items.byId[id]
	local owned = state.discovered[id] == true
	local first = discoveries[id]
	local lines = {
		{ if owned then title else "???", nil, 20 },
		{ info.rarity, Rarities.info[info.rarity].color:Lerp(Color3.new(1, 1, 1), 0.3), 16 },
		{ Format.money(info.income) .. "/s", colors.money, 18 },
	}
	if first then
		table.insert(lines, { "1st: " .. first.name, colors.gold, 16 })
	end
	return UI.card({
		part = id,
		pictureHeight = 90,
		silhouette = not owned,
		accent = if owned then nil else Color3.fromRGB(90, 90, 110),
		lines = lines,
	})
end

function renderers.Catalog()
	local found, total = 0, 0
	for _, item in Items.list do
		if not item.basic then
			total += 1
			if state.discovered[item.id] then
				found += 1
			end
		end
	end
	heading("Found " .. found .. " / " .. total .. " items", 1)
	tabRow(2, CATALOG_TABS, catalogKind, function(name)
		catalogKind = name
		render()
	end)
	if catalogKind == "House" then
		-- Style tabs.
		local tabs = UI.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 3,
			Parent = body,
		}, {
			UI.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(118, 36),
				CellPadding = UDim2.fromOffset(6, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for i, style in Parts.STYLES do
			if style.id ~= "Basic" then
				local color = Rarities.info[style.rarity].color
				local button = UI.button(style.name, if style.id == catalogStyle then color else colors.gray, function()
					catalogStyle = style.id
					render()
				end)
				button.LayoutOrder = i
				button.Parent = tabs
			end
		end
		local style = Parts.styleById[catalogStyle]
		heading(style.name .. " · " .. style.rarity, 4, Rarities.info[style.rarity].color)
		local grid = UI.grid(150, 220)
		grid.LayoutOrder = 5
		grid.Parent = body
		for i, slot in Parts.SLOTS do
			local card = catalogCard(style.id .. "_" .. slot.id, slot.name)
			card.LayoutOrder = i
			card.Parent = grid
		end
		return
	end
	local grid = UI.grid(150, 220)
	grid.LayoutOrder = 5
	grid.Parent = body
	local order = 0
	for _, item in Items.list do
		if item.kind == catalogKind then
			order += 1
			local card = catalogCard(item.id, item.name)
			card.LayoutOrder = order
			card.Parent = grid
		end
	end
end

--------------------------------------------------------------------------------
-- Store
--------------------------------------------------------------------------------

-- What each pass gives, shown as a badge on its card.
local PASS_BADGES = {
	DoubleCoins = "x2",
	FastBreeding = "x2",
	LongerLock = "x2",
	ExtraPen = "+2",
	ExtraSlot1 = "+20",
	ExtraSlot2 = "+20",
	ExtraSlot3 = "+20",
}

-- The price pill (or Owned / Coming soon) for a game pass.
local function passButton(key: string, size: UDim2)
	local pass = GamePasses.list[key]
	local owned = GamePasses.has(player, key)
	local function buy()
		if not owned and pass.id ~= 0 then
			MarketplaceService:PromptGamePassPurchase(player, pass.id)
		end
	end
	if owned then
		return UI.button("OWNED ✓", colors.green, buy, { Size = size })
	elseif pass.id == 0 then
		return UI.button("Coming soon", colors.gray, buy, { Size = size })
	end
	return UI.pricePill("R$ " .. pass.price, buy, { Size = size })
end

-- The Starter Pack banner, with its countdown (only while the offer is open).
local function starterBanner(order: number)
	local ends = player:GetAttribute("StarterEnds")
	if not ends or ends <= Workspace:GetServerTimeNow() or player:GetAttribute("CratesRestricted") then
		return
	end
	local starter = Luck.STARTER
	local frame = banner(order, Color3.fromRGB(70, 225, 120), Color3.fromRGB(30, 160, 200), 150)
	local eggs = 0
	for crateId, count in starter.crates do
		boxRow(frame, crateId, count, 10 + eggs * 70, 110)
		eggs += count
	end
	local x = 10 + eggs * 70 + 60
	local eggWord = {}
	for crateId, count in starter.crates do
		table.insert(eggWord, count .. " " .. Luck.crateById[crateId].name .. if count > 1 then "s" else "")
	end
	local info = bannerText(
		frame,
		"STARTER PACK",
		"💰 " .. Format.money(starter.coins) .. " coins\n📦 " .. table.concat(eggWord, " + ") .. "\n⏰ ",
		x,
		colors.gold
	)
	local pill = UI.pricePill(if starter.passId ~= 0 then "R$ " .. starter.robux else "Coming soon", function()
		send("BuyStarter")
	end)
	bannerButton(frame, pill)
	UI.tag(frame, "LIMITED", colors.red).Position = UDim2.new(1, -16, 0, 8)
	-- Count down live while the window is open.
	local base = info.Text
	task.spawn(function()
		while info.Parent do
			local left = math.max(0, ends - Workspace:GetServerTimeNow())
			info.Text = base
				.. string.format("Only %d:%02d:%02d left!", left // 3600, (left % 3600) // 60, math.floor(left % 60))
			task.wait(1)
		end
	end)
end

-- A Mystery Box bundle banner.
local function bundleBanner(order: number, bundle)
	local crate = Luck.crateById[bundle.crate]
	local frame = banner(order, crate.color, Color3.fromRGB(255, 100, 60), 150)
	boxRow(frame, crate.id, 4, 10, 110)
	local restricted = player:GetAttribute("CratesRestricted")
	bannerText(
		frame,
		string.upper(bundle.name),
		"Save "
			.. Luck.bundleSaving(bundle)
			.. "% on "
			.. crate.name
			.. "es!\nThey wait in the Luck tab to open whenever you like.",
		350,
		Color3.new(1, 1, 1)
	)
	local button
	if restricted then
		button = UI.button("Not available in your region", colors.gray, function() end)
	elseif bundle.productId ~= 0 then
		button = UI.pricePill("R$ " .. bundle.robux, function()
			send("BuyBundle", bundle.id)
		end)
	else
		button = UI.button("Coming soon", colors.gray, function() end)
	end
	bannerButton(frame, button)
	UI.tag(frame, "-" .. Luck.bundleSaving(bundle) .. "%", colors.red).Position = UDim2.new(1, -16, 0, 8)
end

function renderers.Store()
	starterBanner(0)
	-- VIP, big and rainbow across the top (like the VIP banners in PLS DONATE).
	local vipBanner = UI.new("Frame", {
		Size = UDim2.new(1, -8, 0, 150),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = 1,
		Parent = body,
	}, {
		UI.corner(18),
		UI.stroke(nil, 4),
		UI.new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 120)),
				ColorSequenceKeypoint.new(0.3, Color3.fromRGB(255, 170, 40)),
				ColorSequenceKeypoint.new(0.6, Color3.fromRGB(190, 90, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 160, 255)),
			}),
			Rotation = 15,
		}),
	})
	UI.new("Frame", {
		Position = UDim2.fromOffset(6, 5),
		Size = UDim2.new(1, -12, 0.4, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.8,
		Parent = vipBanner,
	}, { UI.corner(14) })
	local crown = ItemPictures.view("VIP", 140)
	crown.Position = UDim2.fromOffset(10, 5)
	crown.Size = UDim2.fromOffset(150, 140)
	crown.Parent = vipBanner
	UI.label("VIP", {
		Position = UDim2.fromOffset(170, 14),
		Size = UDim2.new(1, -400, 0, 48),
		FontFace = UI.fonts.heavy,
		TextColor3 = colors.gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = vipBanner,
	}).UIStroke.Thickness =
		3
	UI.label(
		"👑 Gold VIP badge on the leaderboard and in chat\n💰 +10% coins forever\n🎡 Spin the Lucky Wheel more often",
		{
			Position = UDim2.fromOffset(172, 64),
			Size = UDim2.new(1, -400, 0, 72),
			TextScaled = false,
			TextSize = 17,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = vipBanner,
		}
	)
	local vipButton = passButton("VIP", UDim2.fromOffset(200, 52))
	vipButton.AnchorPoint = Vector2.new(1, 0.5)
	vipButton.Position = UDim2.new(1, -20, 0.5, 8)
	vipButton.Parent = vipBanner
	UI.tag(vipBanner, if GamePasses.has(player, "VIP") then "YOURS!" else "BEST!", colors.red).Position =
		UDim2.new(1, -16, 0, 8)

	-- The other passes as bright cards.
	local grid = UI.grid(220, 270)
	grid.LayoutOrder = 2
	grid.Parent = body
	local i = 0
	for _, key in GamePasses.order do
		if key ~= "VIP" then
			i += 1
			local pass = GamePasses.list[key]
			local owned = GamePasses.has(player, key)
			local card = UI.card({
				accent = pass.color,
				border = if owned then colors.money else nil,
				picture = key,
				lines = {
					{ pass.name, nil, 24 },
					{ pass.description, colors.text, 40 },
				},
				buttons = { passButton(key, UDim2.new(1, 0, 0, 40)) },
				tag = PASS_BADGES[key] and { PASS_BADGES[key], UI.OUTLINE },
			})
			card.LayoutOrder = i
			card.Parent = grid
		end
	end

	-- Mystery Box bundles.
	for k, bundle in Luck.BUNDLES do
		bundleBanner(10 + k, bundle)
	end
end

-- Refresh the Store as soon as a purchase goes through.
player.AttributeChanged:Connect(function(name)
	if string.sub(name, 1, 5) == "Pass_" and currentWindow == "Store" then
		render()
	end
end)

--------------------------------------------------------------------------------
-- Luck: the reveal overlay (boxes and the wheel) and the Luck window
--------------------------------------------------------------------------------

local revealing = false

-- A full-screen dimmed overlay with a box in the middle; returns overlay, box, close().
local function overlay()
	local shade = UI.new("TextButton", {
		Name = "Reveal",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		ZIndex = 50,
		Parent = screen,
	})
	local box = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(360, 420),
		BackgroundTransparency = 1,
		ZIndex = 51,
		Parent = shade,
	})
	return shade, box
end

-- The prize card: the part, its name and rarity, and a button to close.
local function prizeCard(box: Frame, title: string, part, color: Color3, subtitle: string, close: () -> ())
	local card = UI.glass({
		Size = UDim2.fromScale(1, 1),
		ZIndex = 52,
		Parent = box,
	}, {
		UI.corner(18),
		UI.stroke(color, 3),
		UI.new("UIPadding", {
			PaddingTop = UDim.new(0, 14),
			PaddingBottom = UDim.new(0, 14),
			PaddingLeft = UDim.new(0, 14),
			PaddingRight = UDim.new(0, 14),
		}),
		UI.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
		}),
	})
	local lines = { { title, colors.gold, 26 } }
	local order = 0
	local function add(child)
		order += 1
		child.LayoutOrder = order
		child.ZIndex = 53
		child.Parent = card
	end
	for _, line in lines do
		add(UI.label(line[1], { TextColor3 = line[2], Size = UDim2.new(1, 0, 0, line[3]) }))
	end
	if part then
		local view = ItemPictures.part(part.id, 200, false, part.mutations)
		view.Size = UDim2.new(1, 0, 0, 200)
		add(view)
		add(UI.label(LifeUtil.displayName(part), { TextColor3 = color, Size = UDim2.new(1, 0, 0, 30) }))
	end
	add(UI.label(subtitle, { TextColor3 = colors.muted, Size = UDim2.new(1, 0, 0, 40), TextWrapped = true }))
	add(UI.button("Awesome!", colors.green, close, { Size = UDim2.new(1, 0, 0, 44) }))
	-- Pop in.
	local scale = UI.new("UIScale", { Scale = 0.3, Parent = card })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()
end

-- Where a new item went, in words.
local WHERE_TEXT = {
	house = "It's on your house!",
	pen = "It's roaming your yard!",
	yard = "It's in your yard!",
	garden = "It's in your garden!",
	backpack = "It's in your backpack.",
}

local function partPrize(box: Frame, part, rarity: string, isNew: boolean, where: string?, close)
	local color = Rarities.info[rarity].color
	local subtitle = rarity
		.. (if isNew then "  ·  NEW!" else "")
		.. "\n"
		.. (WHERE_TEXT[where] or WHERE_TEXT.backpack)
	prizeCard(box, if isNew then "NEW ITEM!" else "You got...", part, color, subtitle, close)
end

-- The Lucky Wheel spins and lands on the prize the server rolled.
local function revealWheel(result, done)
	local shade, box = overlay()
	local function close()
		shade:Destroy()
		done()
	end
	box.Size = UDim2.fromOffset(420, 460)
	local wheel = LuckyWheel.build(box, 400, { hubText = "🎡", zIndex = 52 })
	wheel.spinTo(result.slice, function()
		task.wait(0.7)
		wheel.frame:Destroy()
		box.Size = UDim2.fromOffset(360, 420)
		local slice = Luck.WHEEL[result.slice]
		if result.part then
			partPrize(box, result.part, result.rarity, result.isNew, result.where, close)
		elseif result.crate then
			prizeCard(
				box,
				if slice.crate == "LegendaryMonster" then "JACKPOT!" else "You won!",
				nil,
				slice.color,
				"A " .. Luck.crateById[result.crate].name .. "!\nOpen it from the 🍀 Luck tab.",
				close
			)
		else
			prizeCard(box, "You won!", nil, colors.money, "+" .. Format.money(result.coins or 0) .. " coins!", close)
		end
	end)
end

-- Reveals queue up so two never overlap.
local revealQueue = {}
local function nextReveal()
	if revealing or #revealQueue == 0 then
		return
	end
	revealing = true
	local result = table.remove(revealQueue, 1)
	local function done()
		revealing = false
		nextReveal()
	end
	if result.kind == "wheel" then
		revealWheel(result, done)
		return
	end
	-- Boxes open with the full card-pack reveal.
	if currentWindow then
		open(currentWindow)
	end
	PackReveal.play(result, done)
end
Remotes.get("LuckResult").OnClientEvent:Connect(function(result)
	table.insert(revealQueue, result)
	nextReveal()
end)

local function spinCooldown(): number
	return if GamePasses.has(player, "VIP") then Luck.VIP_SPIN_COOLDOWN else Luck.SPIN_COOLDOWN
end

function renderers.Luck()
	-- The Lucky Wheel: a big purple-to-pink card with the wheel and a SPIN button.
	local left = (state.lastSpin or 0) + spinCooldown() - Workspace:GetServerTimeNow()
	local ready = left <= 0
	local function spin()
		if ready then
			send("SpinWheel")
		end
	end
	local wheelCard = UI.new("Frame", {
		Size = UDim2.new(1, -8, 0, 300),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = 1,
		Parent = body,
	}, {
		UI.corner(18),
		UI.stroke(nil, 4),
		UI.new("UIGradient", {
			Color = ColorSequence.new(colors.fusion, colors.fusion2),
			Rotation = 20,
		}),
	})
	UI.new("Frame", {
		Position = UDim2.fromOffset(6, 5),
		Size = UDim2.new(1, -12, 0.35, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.82,
		Parent = wheelCard,
	}, { UI.corner(14) })
	local wheelHolder = UI.new("Frame", {
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.fromOffset(280, 280),
		BackgroundTransparency = 1,
		Parent = wheelCard,
	})
	LuckyWheel.build(wheelHolder, 280, { hubText = if ready then "SPIN!" else "⏳", onHub = spin })
	UI.label("LUCKY WHEEL", {
		Position = UDim2.fromOffset(310, 22),
		Size = UDim2.new(1, -330, 0, 52),
		FontFace = UI.fonts.heavy,
		TextColor3 = colors.gold,
		Parent = wheelCard,
	}).UIStroke.Thickness =
		3
	UI.label(if ready then "Your free spin is ready!" else "Free spin every day!", {
		Position = UDim2.fromOffset(310, 80),
		Size = UDim2.new(1, -330, 0, 30),
		Parent = wheelCard,
	})
	UI.label("Win coins, Golden and Rainbow parts, Mystery Boxes and the JACKPOT!", {
		Position = UDim2.fromOffset(310, 114),
		Size = UDim2.new(1, -330, 0, 48),
		TextScaled = false,
		TextSize = 17,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(255, 235, 255),
		Parent = wheelCard,
	})
	local spinButton = UI.button(
		if ready then "SPIN!" else "Next spin in " .. Format.time(left),
		if ready then colors.green else colors.gray,
		spin,
		{
			Position = UDim2.fromOffset(330, 190),
			Size = UDim2.new(1, -370, 0, 64),
			Parent = wheelCard,
		}
	)
	if ready then
		UI.tag(spinButton, "FREE", colors.red)
	end

	-- Mystery Boxes (Robux): every chance is shown before buying.
	UI.label("📦 MYSTERY BOXES · a random item of any kind, odds below", {
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = UI.fonts.heavy,
		LayoutOrder = 2,
		Parent = body,
	})
	local restricted = player:GetAttribute("CratesRestricted")
	local grid = UI.grid(250, 480)
	grid.LayoutOrder = 3
	grid.Parent = body
	for i, crate in Luck.CRATES do
		local odds = Luck.oddsList(crate)
		local lines = { { crate.name, nil, 24 } }
		for _, entry in odds do
			table.insert(lines, {
				entry.rarity .. "  " .. percentText(entry.percent),
				Rarities.info[entry.rarity].color:Lerp(Color3.new(1, 1, 1), 0.35),
				18,
			})
		end
		local buy = function()
			if not restricted then
				send("BuyCrate", crate.id)
			end
		end
		local button
		if restricted then
			button = UI.button("Not available in your region", colors.gray, buy, { Size = UDim2.new(1, 0, 0, 40) })
		elseif crate.productId ~= 0 or (RunService:IsStudio() and Luck.STUDIO_FREE_CRATES) then
			button = UI.pricePill(
				"R$ " .. crate.robux .. (if crate.productId == 0 then " (free in Studio)" else ""),
				buy,
				{ Size = UDim2.new(1, 0, 0, 40) }
			)
		else
			button = UI.button("Coming soon", colors.gray, buy, { Size = UDim2.new(1, 0, 0, 40) })
		end
		local buttons = { button }
		local owned = state.crates and state.crates[crate.id] or 0
		if owned > 0 then
			table.insert(
				buttons,
				UI.button("OPEN YOURS (" .. owned .. ")", colors.green, function()
					send("OpenCrate", crate.id)
				end, { Size = UDim2.new(1, 0, 0, 38) })
			)
		end
		local card = UI.card({
			box = crate.id,
			accent = crate.color,
			lines = lines,
			buttons = buttons,
			tag = if i == #Luck.CRATES then { "BEST", colors.red } else nil,
		})
		card.LayoutOrder = i
		card.Parent = grid
	end
	for k, bundle in Luck.BUNDLES do
		bundleBanner(10 + k, bundle)
	end
end

local MENU = {
	{ "Shop", "🛒", colors.green },
	{ "Luck", "🍀", Color3.fromRGB(160, 215, 45) },
	{ "Life", "🏡", colors.blue },
	{ "Bag", "🎒", colors.orange },
	{ "Catalog", "📖", colors.pink },
	{ "Store", "💎", Color3.fromRGB(40, 180, 160) },
	{ "Home", "🚪", colors.purple },
}
for _, entry in MENU do
	TAB_ICONS[entry[1]] = entry[2]
	TAB_COLORS[entry[1]] = entry[3]
end
local setBadge
setActiveTab, setBadge = Hud.menu(screen, MENU, function(name: string)
	if name == "Home" then
		-- Not a window: takes you back to your house.
		send("GoHome")
		return
	end
	open(name)
end)

-- Alert badges on the side buttons: a free spin or unopened boxes, upgrades waiting in the
-- backpack, eggs ready to hatch, a treadmill upgrade you can afford.
task.spawn(function()
	while true do
		if state then
			local now = Workspace:GetServerTimeNow()
			local boxes = 0
			for _, count in state.crates or {} do
				boxes += count
			end
			local spinReady = (state.lastSpin or 0) + spinCooldown() <= now
			setBadge("Luck", if spinReady then "SPIN!" elseif boxes > 0 then tostring(boxes) else nil)
			local upgrades = 0
			for _, uid in LifeUtil.backpack(state) do
				if LifeUtil.isUpgrade(state, uid) then
					upgrades += 1
				end
			end
			setBadge("Bag", if upgrades > 0 then "UP!" else nil, colors.green)
			local ready = 0
			local eggNow = Items.now()
			for _, egg in state.nests or {} do
				if egg.endsAt <= eggNow then
					ready += 1
				end
			end
			setBadge("Life", if ready > 0 then "🐣" .. ready else nil, colors.green)
			-- Nest timers in the open window.
			for _, timer in liveTimers do
				if timer.label.Parent then
					local left = timer.egg.endsAt - eggNow
					local weight = Format.weight(Items.eggWeightAt(timer.egg, eggNow))
					timer.label.Text = if left > 0
						then "⏱ " .. Format.time(left) .. " · " .. weight
						else "🐣 READY! · " .. weight
				end
			end
			local level = state.treadmill or 1
			local canUpgrade = level < Config.TREADMILL_MAX and (state.money or 0) >= Config.treadmillCost(level)
			setBadge("Shop", if canUpgrade then "⚡" else nil, colors.blue)
		end
		task.wait(0.5)
	end
end)
Hud.starterOffer(screen, function()
	if currentWindow ~= "Store" then
		open("Store")
	end
end)

--------------------------------------------------------------------------------
-- Live updates
--------------------------------------------------------------------------------

player:GetAttributeChangedSignal("Money"):Connect(function()
	if state then
		state.money = player:GetAttribute("Money") or state.money
	end
end)

Remotes.get("Notify").OnClientEvent:Connect(toast)

Remotes.get("State").OnClientEvent:Connect(function(newState)
	state = newState
	render()
end)

Remotes.get("DiscoveryUpdate").OnClientEvent:Connect(function(partId, discovery)
	discoveries[partId] = discovery
	if currentWindow == "Catalog" then
		render()
	end
end)

-- Only the owner sees the Hatch prompts on their own nests.
local function hideOtherPrompt(instance: Instance)
	if instance:IsA("ProximityPrompt") and instance.Name == "HatchPrompt" then
		local mine = instance:GetAttribute("PlotIndex") == player:GetAttribute("Plot")
		instance:SetAttribute("Mine", mine)
		if not mine then
			instance.Enabled = false
		end
		if not instance:GetAttribute("Hooked") then
			instance:SetAttribute("Hooked", true)
			instance:GetPropertyChangedSignal("Enabled"):Connect(function()
				if instance.Enabled and instance:GetAttribute("PlotIndex") ~= player:GetAttribute("Plot") then
					instance.Enabled = false
				end
			end)
		end
	end
end
for _, descendant in Workspace:GetDescendants() do
	hideOtherPrompt(descendant)
end
Workspace.DescendantAdded:Connect(hideOtherPrompt)
player:GetAttributeChangedSignal("Plot"):Connect(function()
	for _, descendant in Workspace:GetDescendants() do
		hideOtherPrompt(descendant)
	end
end)

-- Getting hit: pushed away and knocked over for a moment.
Remotes.get("Knockback").OnClientEvent:Connect(function(direction: Vector3, strength: number, seconds: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		return
	end
	humanoid.PlatformStand = true
	root.AssemblyLinearVelocity = direction * strength + Vector3.new(0, strength * 0.5, 0)
	task.delay(seconds, function()
		if humanoid.Parent then
			humanoid.PlatformStand = false
		end
	end)
end)

GuardianFX.start()
PetFX.start()
TreadmillRun.start()
Ambient.start()

-- The Mystery Boxes on the stand turn slowly and bob up and down.
RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for i, box in CollectionService:GetTagged("DisplayEgg") do
		local rest = box:GetAttribute("Rest")
		if box:IsA("Model") and box.PrimaryPart and typeof(rest) == "CFrame" then
			local phase = i * 1.7
			box:PivotTo(
				rest * CFrame.new(0, 0.35 + math.sin(t * 2 + phase) * 0.35, 0) * CFrame.Angles(0, t * 0.8 + phase, 0)
			)
		end
	end
end)

-- Secret eggs flash and glow: their aura and light cycle through every colour and pulse.
RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for i, egg in CollectionService:GetTagged(EggModel.SECRET_TAG) do
		local glow = egg:FindFirstChild("SecretGlow")
		local shell = egg:FindFirstChild("Shell")
		local light = shell and shell:FindFirstChild("SecretLight")
		local color = Color3.fromHSV((t * 0.5 + i * 0.13) % 1, 0.75, 1)
		local flash = (math.sin(t * 9 + i) + 1) / 2 -- 0..1, a few flashes a second
		if glow and glow:IsA("BasePart") then
			glow.Color = color
			glow.Transparency = 0.25 + 0.5 * (1 - flash)
		end
		if light and light:IsA("PointLight") then
			light.Color = color
			light.Brightness = 1.5 + 4 * flash
		end
	end
end)

task.spawn(function()
	discoveries = Remotes.get("GetDiscoveries"):InvokeServer() or {}
	render()
end)
print("[Steal a Life] Client UI built, loading your data...")
state = Remotes.get("GetState"):InvokeServer()
print("[Steal a Life] Client ready")
clientReady = true
render()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">PackReveal</string>
            <string name="Source"><![CDATA[-- Hatching an egg (or opening a Mystery Box), done like a card-pack reveal in the big
-- sports games, in 3D. The camera cuts to a dark arena (built on this client only, high
-- above the map): the egg or box drops onto a glowing pedestal under sweeping spotlights,
-- shakes, and bursts into a face-down card. Then the clues slam onto the screen one at a
-- time (first what KIND of thing it is, or which SLOT of the house for a house part, then
-- its RARITY, with every light in the arena turning that colour) before the card flips over
-- in 3D and the item pops out in front of it with its name. The rarer the item, the longer
-- the suspense and the wilder the lights.
-- Tapping the screen speeds it up.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local BoxModel = require(ReplicatedStorage.Shared.BoxModel)
local EggModel = require(ReplicatedStorage.Shared.EggModel)
local Format = require(ReplicatedStorage.Shared.Format)
local ItemModel = require(ReplicatedStorage.Shared.ItemModel)
local Items = require(ReplicatedStorage.Shared.Items)
local LifeUtil = require(ReplicatedStorage.Shared.LifeUtil)
local Lego = require(ReplicatedStorage.Shared.Lego)
local Luck = require(ReplicatedStorage.Shared.Luck)
local Parts = require(ReplicatedStorage.Shared.Parts)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local UI = require(script.Parent.UI)

local PackReveal = {}

local STAGE = CFrame.new(0, 3000, 0) -- far above the map, out of everyone's way
local CARD_SIZE = Vector3.new(6, 8.4, 0.35)
local CARD_HOME = Vector3.new(0, 7.2, 0) -- where the card floats, above the pedestal
local PEDESTAL_TOP = 1.6
local DARK = Color3.fromRGB(14, 12, 28)
local GOLD = Color3.fromRGB(255, 205, 70)

local RARITY_WORDS = {
	Common = "COMMON",
	Uncommon = "UNCOMMON",
	Rare = "RARE!",
	Legendary = "LEGENDARY!",
	Mystic = "MYSTIC!!",
	Ultra = "ULTRA!!!",
	Secret = "SECRET!!!",
}

local function easeOut(a: number): number
	return 1 - (1 - a) ^ 3
end

local function easeInOut(a: number): number
	return a * a * (3 - 2 * a)
end

local function rainbow(t: number, offset: number?): Color3
	return Color3.fromHSV((t * 0.5 + (offset or 0)) % 1, 0.75, 1)
end

local function at(x: number, y: number, z: number): CFrame
	return STAGE * CFrame.new(x, y, z)
end

local function newPart(parent: Instance, props)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "ClassName" then
			p[key] = value
		end
	end
	p.Parent = parent
	return p
end

-- Text on one face of a part.
local function faceText(
	part: BasePart,
	face: Enum.NormalId,
	text: string,
	color: Color3,
	position: UDim2,
	size: UDim2,
	heavy: boolean?
)
	local gui = part:FindFirstChild("Face" .. face.Name)
	if not gui then
		gui = Instance.new("SurfaceGui")
		gui.Name = "Face" .. face.Name
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 50
		gui.LightInfluence = 0
		gui.Parent = part
	end
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = position
	label.Size = size
	label.TextScaled = true
	label.Font = if heavy then Enum.Font.LuckiestGuy else Enum.Font.FredokaOne
	label.Text = text
	label.TextColor3 = color
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = UI.OUTLINE
	stroke.Thickness = 4
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	return label
end

-- The back of the card: a monster card that feels alive. Dark chrome with scanlines, a
-- silver-and-gold frame with curved horns out of the top corners, violet energy cracks
-- flickering out from a big glowing dragon eye that looks around and blinks, a ring of
-- runes turning round it, a chrome nameplate, and a holographic glint sweeping across.
-- Built round the card's centre (the back faces -Z). Returns animate(t), which moves the
-- living parts; call it every frame after the card is placed.
local function buildCardBack(card: Model, body: BasePart): (number) -> ()
	local half = Vector2.new(CARD_SIZE.X / 2, CARD_SIZE.Y / 2)
	local z0 = -CARD_SIZE.Z / 2
	local eye = Vector2.new(0, 0.55)
	local violet = Color3.fromRGB(175, 90, 255)
	local cyan = Color3.fromRGB(90, 235, 255)
	local chrome = Color3.fromRGB(200, 205, 220)
	local random = Random.new(7)
	local function flat(
		name: string,
		size: Vector3,
		x: number,
		y: number,
		z: number,
		color: Color3,
		material,
		angle: number?
	)
		return newPart(card, {
			Name = name,
			Size = size,
			CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, 0, angle or 0),
			Color = color,
			Material = material or Enum.Material.SmoothPlastic,
		})
	end
	local function ellipsoid(name: string, size: Vector3, x: number, y: number, z: number, color: Color3, material)
		local part = flat(name, size, x, y, z, color, material)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
		return part
	end
	local function disc(name: string, diameter: number, depth: number, z: number, color: Color3, material)
		return newPart(card, {
			Name = name,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(depth, diameter, diameter),
			CFrame = CFrame.new(eye.X, eye.Y, z) * CFrame.Angles(0, math.pi / 2, 0),
			Color = color,
			Material = material or Enum.Material.SmoothPlastic,
		})
	end

	-- Dark chrome with faint scanlines.
	body.Color = Color3.fromRGB(16, 12, 30)
	body.Material = Enum.Material.Metal
	for k = 0, 15 do
		flat(
			"Scanline",
			Vector3.new(CARD_SIZE.X - 1, 0.07, 0.02),
			0,
			-half.Y + 0.6 + k * 0.48,
			z0 - 0.01,
			Color3.fromRGB(34, 24, 62)
		)
	end

	-- Energy cracks: jagged violet lines from the eye out towards the edges.
	local cracks = {}
	for k = 0, 7 do
		local angle = k / 8 * math.pi * 2 + 0.3
		local point = eye + Vector2.new(math.cos(angle), math.sin(angle)) * 2.3
		for _ = 1, 3 do
			local turn = angle + random:NextNumber(-0.6, 0.6)
			local step = random:NextNumber(0.6, 1.1)
			local nextPoint = point + Vector2.new(math.cos(turn), math.sin(turn)) * step
			if math.abs(nextPoint.X) > half.X - 0.7 or math.abs(nextPoint.Y) > half.Y - 0.7 then
				break
			end
			local mid = (point + nextPoint) / 2
			local dir = nextPoint - point
			table.insert(
				cracks,
				flat(
					"Crack",
					Vector3.new(dir.Magnitude + 0.12, 0.15, 0.03),
					mid.X,
					mid.Y,
					z0 - 0.03,
					violet,
					Enum.Material.Neon,
					math.atan2(dir.Y, dir.X)
				)
			)
			point = nextPoint
		end
	end

	-- Frame: chrome bevel with a thin gold line inside it.
	for _, inset in { { 0.32, 0.22, chrome, Enum.Material.Foil, 0.08 }, { 0.6, 0.08, GOLD, Enum.Material.Neon, 0.06 } } do
		local d, w = inset[1], inset[2]
		for _, bar in
			{
				{ Vector3.new(CARD_SIZE.X - d * 2, w, inset[5]), Vector3.new(0, half.Y - d, 0) },
				{ Vector3.new(CARD_SIZE.X - d * 2, w, inset[5]), Vector3.new(0, -half.Y + d, 0) },
				{ Vector3.new(w, CARD_SIZE.Y - d * 2, inset[5]), Vector3.new(half.X - d, 0, 0) },
				{ Vector3.new(w, CARD_SIZE.Y - d * 2, inset[5]), Vector3.new(-half.X + d, 0, 0) },
			}
		do
			flat("Frame", bar[1], bar[2].X, bar[2].Y, z0 - 0.05, inset[3], inset[4])
		end
	end
	-- Horns curling up and out of the top corners: thick dark purple at the root, tapering
	-- to a glowing gold tip. Each is a chain of tapered cylinders with balls at the joints.
	for _, side in { -1, 1 } do
		local points = {}
		for k = 0, 8 do
			local f = k / 8
			local angle = math.rad(25 + 70 * f) -- sweeps from out-and-up to straight up
			table.insert(
				points,
				Vector2.new(
					side * (half.X - 0.55 + math.cos(angle) * 1.6 * f),
					half.Y - 0.35 + math.sin(angle) * 2.1 * f
				)
			)
		end
		for k = 1, #points - 1 do
			local f = (k - 1) / (#points - 1)
			local a0, a1 = points[k], points[k + 1]
			local width = 0.95 - 0.8 * f
			local color = Color3.fromRGB(55, 22, 90):Lerp(Color3.fromRGB(170, 100, 230), f)
			local dir = a1 - a0
			newPart(card, {
				Name = "Horn",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(dir.Magnitude + width * 0.3, width, width),
				CFrame = CFrame.new((a0.X + a1.X) / 2, (a0.Y + a1.Y) / 2, z0 + 0.05)
					* CFrame.Angles(0, 0, math.atan2(dir.Y, dir.X)),
				Color = color,
			})
			newPart(card, {
				Name = "Horn",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * width,
				CFrame = CFrame.new(a0.X, a0.Y, z0 + 0.05),
				Color = color,
			})
		end
		local tip = points[#points]
		newPart(card, {
			Name = "HornTip",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.3,
			CFrame = CFrame.new(tip.X, tip.Y, z0 + 0.05),
			Color = GOLD,
			Material = Enum.Material.Neon,
		})
	end

	-- The eye: a glowing socket, an amber eyeball, a green iris with a slit pupil, and lids.
	disc("SocketGlow", 4.3, 0.06, z0 - 0.04, violet, Enum.Material.Neon).Transparency = 0.35
	disc("SocketRing", 3.9, 0.2, z0 - 0.12, chrome, Enum.Material.Foil)
	disc("Socket", 3.5, 0.24, z0 - 0.16, Color3.fromRGB(10, 6, 20))
	local eyeball = ellipsoid(
		"Eyeball",
		Vector3.new(3.0, 2.1, 0.9),
		eye.X,
		eye.Y,
		z0 - 0.3,
		Color3.fromRGB(255, 160, 40),
		Enum.Material.Neon
	)
	local iris = ellipsoid("Iris", Vector3.new(1.55, 1.55, 0.35), eye.X, eye.Y, z0 - 0.82, Color3.fromRGB(110, 240, 90))
	local irisRing =
		ellipsoid("IrisRing", Vector3.new(1.75, 1.75, 0.3), eye.X, eye.Y, z0 - 0.8, Color3.fromRGB(30, 90, 30))
	local pupil = flat("Pupil", Vector3.new(0.3, 1.3, 0.1), eye.X, eye.Y, z0 - 1.0, Color3.fromRGB(8, 6, 14))
	local glint = newPart(card, {
		Name = "Glint",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.3,
		CFrame = CFrame.new(eye.X - 0.35, eye.Y + 0.4, z0 - 1.05),
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.Neon,
	})
	-- An angry brow over the eye.
	for _, side in { -1, 1 } do
		flat(
			"Brow",
			Vector3.new(1.7, 0.32, 0.25),
			eye.X + side * 0.85,
			eye.Y + 1.45,
			z0 - 0.35,
			Color3.fromRGB(60, 24, 100),
			nil,
			math.rad(side * -14)
		)
	end

	-- Runes circling the eye.
	local runes = {}
	for k = 1, 12 do
		table.insert(
			runes,
			newPart(card, {
				Name = "Rune",
				Size = if k % 3 == 0 then Vector3.new(0.34, 0.34, 0.05) else Vector3.new(0.12, 0.34, 0.05),
				Color = cyan,
				Material = Enum.Material.Neon,
			})
		)
	end

	-- Title and nameplate.
	local title = flat("BackTitle", Vector3.new(4.2, 0.5, 0.02), 0, half.Y - 1.05, z0 - 0.05, Color3.new(), nil)
	title.Transparency = 1
	faceText(title, Enum.NormalId.Front, "✦ FREEK CARD ✦", cyan, UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), true)
	local plate = flat("Nameplate", Vector3.new(4.6, 1, 0.16), 0, -half.Y + 1.3, z0 - 0.1, chrome, Enum.Material.Foil)
	flat("NameplateInset", Vector3.new(4.3, 0.75, 0.04), 0, -half.Y + 1.3, z0 - 0.19, Color3.fromRGB(24, 14, 44))
	local plateText = flat("NameplateText", Vector3.new(4.2, 0.7, 0.02), 0, -half.Y + 1.3, z0 - 0.22, Color3.new(), nil)
	plateText.Transparency = 1
	faceText(
		plateText,
		Enum.NormalId.Front,
		"STEAL A HOME",
		GOLD,
		UDim2.fromScale(0.03, 0.05),
		UDim2.fromScale(0.94, 0.9),
		true
	)
	for _, side in { -1, 1 } do
		newPart(card, {
			Name = "PlateBolt",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.22,
			CFrame = CFrame.new(side * 2.1, plate.Position.Y, z0 - 0.2),
			Color = violet,
			Material = Enum.Material.Neon,
		})
	end

	-- The holographic glint.
	local shine = newPart(card, {
		Name = "Shine",
		Size = Vector3.new(0.3, CARD_SIZE.Y - 1.4, 0.02),
		CFrame = CFrame.new(0, 0, z0 - 1.2),
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.Neon,
		Transparency = 1,
		CastShadow = false,
	})

	local flicker = Random.new()
	return function(t: number)
		local base = body.CFrame
		local function put(part: BasePart, x: number, y: number, z: number, angle: number?)
			part.CFrame = base * CFrame.new(x, y, z) * CFrame.Angles(0, 0, angle or 0)
		end
		-- The eye looks around, darting now and then.
		local look = Vector2.new(math.sin(t * 0.8) * 0.45 + math.sin(t * 3.1) * 0.08, math.sin(t * 1.3) * 0.2)
		-- A blink every few seconds: the eye squints shut and opens again.
		local phase = (t % 3.4) / 0.28
		local open = 1 - (if phase < 1 then math.sin(phase * math.pi) else 0) * 0.92
		eyeball.Size = Vector3.new(3.0, 2.1 * open, 0.9)
		iris.Size = Vector3.new(1.55, 1.55 * open, 0.35)
		irisRing.Size = Vector3.new(1.75, 1.75 * open, 0.3)
		pupil.Size = Vector3.new(0.3, 1.3 * open, 0.1)
		glint.Transparency = if open < 0.5 then 1 else 0
		local lookY = look.Y * open
		put(eyeball, eye.X, eye.Y, z0 - 0.3)
		put(irisRing, eye.X + look.X, eye.Y + lookY, z0 - 0.62)
		put(iris, eye.X + look.X, eye.Y + lookY, z0 - 0.66)
		put(pupil, eye.X + look.X, eye.Y + lookY, z0 - 0.84)
		put(glint, eye.X + look.X - 0.35, eye.Y + lookY + 0.4, z0 - 0.9)
		-- The runes turn round the eye.
		for k, rune in runes do
			local angle = k / #runes * math.pi * 2 + t * 0.6
			put(rune, eye.X + math.cos(angle) * 2.3, eye.Y + math.sin(angle) * 2.3, z0 - 0.09, angle)
		end
		-- The cracks crackle.
		for _, crack in cracks do
			crack.Transparency = if flicker:NextNumber() < 0.15 then 0.6 else 0
		end
		-- The glint sweeps across every couple of seconds.
		local x = ((t * 0.9) % 2.2 - 1.1) * CARD_SIZE.X
		local inside = math.abs(x) < half.X - 1.6
		put(shine, x, 0, z0 - 1.2, math.rad(20))
		shine.Transparency = if inside then 0.78 + 0.2 * (math.abs(x) / (half.X - 1.6)) ^ 2 else 1
	end
end

-- Hides the rest of the HUD while the reveal plays; returns a function that brings it back.
local function hideHud(playerGui: Instance, keep: Instance): () -> ()
	local hidden = {}
	for _, gui in playerGui:GetChildren() do
		if gui:IsA("ScreenGui") and gui ~= keep and gui.Enabled then
			gui.Enabled = false
			table.insert(hidden, gui)
		end
	end
	return function()
		for _, gui in hidden do
			gui.Enabled = true
		end
	end
end

-- result = { kind = "egg"|"crate"|"wheel", egg? (zone index), crate?, rarity, isNew,
--            where = "house"|"pen"|"yard"|"garden"|"backpack", part = { id, mutations } }
function PackReveal.play(result, done: () -> ())
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local partInfo = Items.byId[result.part.id]
	local rarity = result.rarity
	local tier = Rarities.rank[rarity] or 1
	local rarityColor = Rarities.info[rarity] and Rarities.info[rarity].color or Color3.new(1, 1, 1)
	-- The first clue is what kind of thing it is (for a house part, which slot it's for).
	local series
	if partInfo.kind == "House" then
		local slot = Parts.slotById[partInfo.slot]
		series = { clue = "SLOT", icon = slot.icon, name = slot.name, color = UI.cardColor(slot.name) }
	else
		local kind = Items.KINDS[partInfo.kind]
		series = { clue = "KIND", icon = kind.icon, name = kind.name, color = kind.color }
	end
	local random = Random.new()

	----------------------------------------------------------------------------
	-- The arena
	----------------------------------------------------------------------------
	local stage = Instance.new("Folder")
	stage.Name = "PackStage"
	stage.Parent = Workspace

	-- A dark room so nothing else shows: floor, walls and ceiling.
	newPart(stage, {
		Name = "Floor",
		Size = Vector3.new(110, 1, 110),
		CFrame = at(0, -0.5, 0),
		Color = Color3.fromRGB(22, 20, 40),
		Reflectance = 0.15,
	})
	for _, wall in
		{
			{ Vector3.new(110, 60, 1), Vector3.new(0, 30, 55) },
			{ Vector3.new(110, 60, 1), Vector3.new(0, 30, -55) },
			{ Vector3.new(1, 60, 110), Vector3.new(55, 30, 0) },
			{ Vector3.new(1, 60, 110), Vector3.new(-55, 30, 0) },
			{ Vector3.new(110, 1, 110), Vector3.new(0, 60, 0) },
		}
	do
		newPart(stage, { Name = "Wall", Size = wall[1], CFrame = at(wall[2].X, wall[2].Y, wall[2].Z), Color = DARK })
	end

	-- Everything that changes colour with the clues.
	local lit = {} -- { part = BasePart, offset = number }
	local function litPart(props, offset: number?)
		local p = newPart(stage, props)
		table.insert(lit, { part = p, offset = offset or 0 })
		return p
	end

	-- Rings of light on the floor.
	for r, radius in { 9, 15, 22 } do
		local count = 20 + r * 8
		for k = 1, count do
			local angle = k / count * math.pi * 2
			local p0 = Vector3.new(math.cos(angle) * radius, 0.05, math.sin(angle) * radius)
			local p1 = Vector3.new(
				math.cos(angle + math.pi * 2 / count) * radius,
				0.05,
				math.sin(angle + math.pi * 2 / count) * radius
			)
			litPart({
				Name = "FloorRing",
				Size = Vector3.new(0.45, 0.1, (p1 - p0).Magnitude * 0.7),
				CFrame = STAGE * CFrame.lookAt((p0 + p1) / 2, p1),
				Material = Enum.Material.Neon,
				Transparency = 0.15 * r,
			}, k / count)
		end
	end

	-- The pedestal.
	newPart(stage, {
		Name = "Pedestal",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(PEDESTAL_TOP, 8, 8),
		CFrame = at(0, PEDESTAL_TOP / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(40, 38, 60),
		Material = Enum.Material.Metal,
	})
	local rim = litPart({
		Name = "PedestalRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.25, 8.5, 8.5),
		CFrame = at(0, PEDESTAL_TOP - 0.1, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Material = Enum.Material.Neon,
	})
	local light = Instance.new("PointLight")
	light.Range = 34
	light.Brightness = 2
	light.Shadows = false
	light.Parent = rim

	-- Stage spotlights: lamps on a ring above the stage, each throwing a soft cone of light
	-- (a bright core inside a wide glow, fading towards the floor) that sweeps round the
	-- pedestal, with a real spotlight and a glowing pool where it lands.
	local RIG_HEIGHT, RIG_RADIUS = 30, 19
	newPart(stage, {
		Name = "LightRig",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, RIG_RADIUS * 2 + 2, RIG_RADIUS * 2 + 2),
		CFrame = at(0, RIG_HEIGHT + 1.2, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(30, 30, 40),
		Material = Enum.Material.Metal,
		Transparency = 0,
	})
	local function coneBeam(a0: Attachment, a1: Attachment, width0: number, width1: number, near: number, far: number)
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = width0
		beam.Width1 = width1
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Segments = 12
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, near),
			NumberSequenceKeypoint.new(0.7, (near + far) / 2 + 0.05),
			NumberSequenceKeypoint.new(1, far),
		})
		beam.Parent = a0.Parent
		return beam
	end
	local beams = {}
	for k = 1, 8 do
		local angle = k / 8 * math.pi * 2
		local lampAt = Vector3.new(math.cos(angle) * RIG_RADIUS, RIG_HEIGHT, math.sin(angle) * RIG_RADIUS)
		newPart(stage, {
			Name = "Lamp",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(2.2, 1.8, 1.8),
			CFrame = at(lampAt.X, lampAt.Y, lampAt.Z),
			Color = Color3.fromRGB(35, 35, 45),
			Material = Enum.Material.Metal,
		})
		local lens = litPart({
			Name = "LampLens",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 1.3,
			CFrame = at(lampAt.X, lampAt.Y - 0.9, lampAt.Z),
			Material = Enum.Material.Neon,
		}, k / 8)
		local pool = litPart({
			Name = "LightPool",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, 5, 5),
			Material = Enum.Material.Neon,
			Transparency = 0.8,
			CastShadow = false,
		}, k / 8)
		local from = Instance.new("Attachment")
		from.Parent = lens
		local to = Instance.new("Attachment")
		to.Parent = pool
		local core = coneBeam(from, to, 0.8, 3.2, 0.45, 0.85)
		local halo = coneBeam(from, to, 2.2, 9, 0.82, 0.97)
		local spot = Instance.new("SpotLight")
		spot.Angle = 30
		spot.Range = 45
		spot.Brightness = 3
		spot.Shadows = false
		spot.Face = Enum.NormalId.Front
		spot.Parent = lens
		table.insert(
			beams,
			{ lens = lens, pool = pool, spot = spot, core = core, halo = halo, top = lampAt, angle = angle }
		)
	end

	----------------------------------------------------------------------------
	-- The 2D overlay: clue words, flashes, the name and the button
	----------------------------------------------------------------------------
	local gui = UI.new("ScreenGui", {
		Name = "PackReveal",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 50,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	local showHud = hideHud(playerGui, gui)
	local overlay = UI.new("TextButton", {
		Name = "Overlay",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})
	local speed = 1
	overlay.Activated:Connect(function()
		speed = 4 -- tap to hurry it along
	end)

	local function flash(color: Color3, duration: number)
		local frame = UI.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = color,
			BackgroundTransparency = 0,
			ZIndex = 40,
			Parent = gui,
		})
		task.spawn(function()
			local began = os.clock()
			while os.clock() - began < duration do
				frame.BackgroundTransparency = (os.clock() - began) / duration
				task.wait()
			end
			frame:Destroy()
		end)
	end

	local captionLabel = UI.label("", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.09),
		Size = UDim2.fromOffset(500, 34),
		FontFace = UI.fonts.heavy,
		TextColor3 = Color3.fromRGB(230, 230, 255),
		TextTransparency = 1,
		ZIndex = 20,
		Parent = overlay,
	})
	captionLabel:FindFirstChildOfClass("UIStroke").Transparency = 1
	local clueLabel = UI.label("", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.18),
		Size = UDim2.fromOffset(900, 100),
		FontFace = UI.fonts.heavy,
		TextTransparency = 1,
		ZIndex = 20,
		Parent = overlay,
	})
	local clueStroke = clueLabel:FindFirstChildOfClass("UIStroke")
	clueStroke.Thickness = 5
	clueStroke.Transparency = 1
	local clueScale = UI.new("UIScale", { Parent = clueLabel })
	local clueGradient = UI.new("UIGradient", { Enabled = false, Parent = clueLabel })

	----------------------------------------------------------------------------
	-- Animation state, updated every frame
	----------------------------------------------------------------------------
	local camera = Workspace.CurrentCamera
	local oldCameraType = camera.CameraType
	camera.CameraType = Enum.CameraType.Scriptable
	local oldFov = camera.FieldOfView
	camera.FieldOfView = 55
	local controls: any = nil
	pcall(function()
		local module = require(player.PlayerScripts:WaitForChild("PlayerModule", 1) :: any)
		controls = module:GetControls()
		controls:Disable()
	end)

	local state = {
		color = Color3.fromRGB(200, 200, 230),
		brightness = 0.4, -- 0..1, how strongly the arena lights glow
		sweep = 0.3, -- how fast the beams sweep (radians per second)
		rainbow = false,
		shake = 0,
		camFrom = at(0, 16, -46),
		camTo = at(0, 16, -46),
		camBlend = 1,
		lookAt = at(0, 4, 0).Position,
	}
	local function moveCamera(position: Vector3, look: Vector3)
		state.camFrom = camera.CFrame
		state.camTo = CFrame.lookAt((STAGE * CFrame.new(position)).Position, (STAGE * CFrame.new(look)).Position)
		state.camBlend = 0
	end

	local clock = os.clock()
	local sweepAngle = 0
	local camTime = 0.8
	local function tick(dt: number)
		local now = os.clock()
		sweepAngle += state.sweep * dt
		for i, beam in beams do
			-- Each lamp swings its beam round the pedestal.
			local swing = beam.angle + sweepAngle + math.sin(sweepAngle * 2 + i) * 0.4
			local target = Vector3.new(math.cos(swing) * 8, 0.05, math.sin(swing) * 8)
			beam.lens.CFrame = STAGE * CFrame.lookAt(beam.top - Vector3.new(0, 0.9, 0), target)
			beam.pool.CFrame = STAGE * CFrame.new(target) * CFrame.Angles(0, 0, math.pi / 2)
			local color = if state.rainbow then rainbow(now, i / #beams) else state.color
			beam.core.Color = ColorSequence.new(color)
			beam.halo.Color = ColorSequence.new(color)
			beam.spot.Color = color
			beam.spot.Brightness = 1 + 4 * state.brightness
			beam.core.Brightness = 0.6 + 1.4 * state.brightness
			beam.halo.Brightness = beam.core.Brightness
			beam.pool.Transparency = 0.95 - 0.07 * state.brightness
		end
		for _, entry in lit do
			entry.part.Color = if state.rainbow then rainbow(now, entry.offset) else state.color
		end
		light.Color = if state.rainbow then rainbow(now) else state.color
		light.Brightness = 1 + 4 * state.brightness
		-- Camera: glide towards its target, then shake on impacts.
		state.camBlend = math.min(state.camBlend + dt / camTime, 1)
		local cf = state.camFrom:Lerp(state.camTo, easeInOut(state.camBlend))
		if state.shake > 0.01 then
			cf *= CFrame.new(random:NextNumber(-1, 1) * state.shake, random:NextNumber(-1, 1) * state.shake, 0)
			state.shake *= math.exp(-dt * 7)
		end
		camera.CFrame = cf
	end

	-- Runs fn(alpha, t) every frame for `duration` seconds (shorter when sped up).
	local function animate(duration: number, fn: ((number, number) -> ())?)
		local elapsed = 0
		while true do
			local now = os.clock()
			local dt = math.min(now - clock, 0.1)
			clock = now
			elapsed += dt * speed
			local alpha = math.min(elapsed / duration, 1)
			if fn then
				fn(alpha, elapsed)
			end
			tick(dt * speed)
			if alpha >= 1 then
				break
			end
			task.wait()
		end
	end

	-- Bits that fly out and fall: egg shell, sparks, confetti.
	local function burst(center: Vector3, count: number, colors: { Color3 }, confetti: boolean?)
		local bits = {}
		for k = 1, count do
			local direction = random:NextUnitVector() * Vector3.new(1, 0.6, 1) + Vector3.new(0, 0.6, 0)
			local bit = newPart(stage, {
				ClassName = if confetti then "Part" else "WedgePart",
				Name = "Bit",
				Size = if confetti then Vector3.new(0.4, 0.06, 0.25) else Vector3.new(0.15, 0.6, 0.6),
				CFrame = STAGE
					* CFrame.new(center + direction)
					* CFrame.Angles(random:NextNumber(0, 6), random:NextNumber(0, 6), 0),
				Color = colors[k % #colors + 1],
				Material = if confetti then Enum.Material.Neon else Enum.Material.SmoothPlastic,
			})
			table.insert(bits, { part = bit, velocity = direction.Unit * random:NextNumber(10, 22) })
		end
		task.spawn(function()
			local began, last = os.clock(), os.clock()
			while os.clock() - began < 2 do
				local now = os.clock()
				local dt = now - last
				last = now
				for _, b in bits do
					b.velocity -= Vector3.new(0, (if confetti then 14 else 35) * dt, 0)
					b.part.CFrame = (b.part.CFrame + b.velocity * dt) * CFrame.Angles(6 * dt, 4 * dt, 0)
					b.part.Transparency = ((now - began) / 2) ^ 2
				end
				task.wait()
			end
			for _, b in bits do
				b.part:Destroy()
			end
		end)
	end

	local function slam(caption: string, text: string, color: Color3)
		captionLabel.Text = caption
		clueLabel.Text = text
		clueLabel.TextColor3 = color
		captionLabel.TextTransparency = 0
		captionLabel:FindFirstChildOfClass("UIStroke").Transparency = 0
		animate(0.2, function(a)
			clueScale.Scale = 2.6 - 1.6 * easeOut(a)
			clueLabel.TextTransparency = 1 - a
			clueStroke.Transparency = 1 - a
		end)
		state.shake = 0.5 + tier * 0.06
	end

	local function hideClue()
		animate(0.15, function(a)
			clueLabel.TextTransparency = a
			clueStroke.Transparency = a
			captionLabel.TextTransparency = a
			captionLabel:FindFirstChildOfClass("UIStroke").Transparency = a
		end)
		clueGradient.Enabled = false
	end

	----------------------------------------------------------------------------
	-- 1. Into the arena: the camera swoops in and the egg drops onto the pedestal.
	----------------------------------------------------------------------------
	camera.CFrame = state.camFrom
	flash(Color3.new(0, 0, 0), 0.5)
	moveCamera(Vector3.new(0, 7, -24), Vector3.new(0, 4, 0))
	local egg = if result.egg then EggModel.build(result.egg, result.part.id) else BoxModel.build(result.crate)
	if result.egg then
		Items.scaleModel(egg, 1.6 * math.clamp(Items.weightScale(result.eggFactor or 1), 0.7, 1.8))
	end
	Lego.apply(egg)
	egg.Parent = stage
	local eggRest = at(0, PEDESTAL_TOP, 0) * CFrame.Angles(0, math.pi, 0)
	animate(0.8, function(a)
		state.brightness = 0.25 + 0.2 * a
		local drop = if a < 0.75 then 22 * (1 - (a / 0.75) ^ 2) else math.sin((a - 0.75) / 0.25 * math.pi) * 0.8
		egg:PivotTo(eggRest + Vector3.new(0, drop, 0))
	end)
	state.shake = 0.6

	----------------------------------------------------------------------------
	-- 2. The egg shakes harder and harder while the camera creeps in.
	----------------------------------------------------------------------------
	camTime = 1 + tier * 0.15
	moveCamera(Vector3.new(0, 5, -14), Vector3.new(0, 3.2, 0))
	animate(1 + tier * 0.15, function(a, t)
		local wobble = math.sin(t * (14 + a * 24)) * math.rad(4 + 18 * a * a)
		egg:PivotTo(eggRest * CFrame.Angles(0, 0, wobble) + Vector3.new(0, math.abs(math.sin(t * 9)) * 0.3 * a, 0))
		state.brightness = 0.45 + 0.4 * a
		state.sweep = 0.3 + 2.5 * a
	end)

	----------------------------------------------------------------------------
	-- 3. Burst! A face-down card spins up out of the light.
	----------------------------------------------------------------------------
	flash(Color3.new(1, 1, 1), 0.45)
	burst(Vector3.new(0, PEDESTAL_TOP + 2, 0), 18, {
		if result.egg and Items.ZONES[result.egg]
			then Items.ZONES[result.egg].eggColor
			else (Luck.crateById[result.crate] and Luck.crateById[result.crate].color) or GOLD,
		Color3.new(1, 1, 1),
	})
	egg:Destroy()
	state.shake = 1
	state.sweep = 0.6

	local card = Instance.new("Model")
	card.Name = "Card"
	card.Parent = stage
	local body = newPart(card, {
		Name = "CardBody",
		Size = CARD_SIZE,
		CFrame = CFrame.new(),
		Color = Color3.fromRGB(34, 16, 72),
	})
	card.PrimaryPart = body
	local rimParts = {}
	for _, bar in
		{
			{ Vector3.new(CARD_SIZE.X + 0.3, 0.3, 0.5), Vector3.new(0, CARD_SIZE.Y / 2, 0) },
			{ Vector3.new(CARD_SIZE.X + 0.3, 0.3, 0.5), Vector3.new(0, -CARD_SIZE.Y / 2, 0) },
			{ Vector3.new(0.3, CARD_SIZE.Y + 0.3, 0.5), Vector3.new(CARD_SIZE.X / 2, 0, 0) },
			{ Vector3.new(0.3, CARD_SIZE.Y + 0.3, 0.5), Vector3.new(-CARD_SIZE.X / 2, 0, 0) },
		}
	do
		table.insert(
			rimParts,
			newPart(card, {
				Name = "CardRim",
				Size = bar[1],
				CFrame = CFrame.new(bar[2]),
				Color = GOLD,
				Material = Enum.Material.Neon,
			})
		)
	end
	-- The back (facing the camera to start with): see buildCardBack.
	local animateBack = buildCardBack(card, body)
	-- The front starts blank (the card spins round as it appears, so nothing on it may give
	-- the pull away); paintFront() puts the rarity colours and words on just before the flip.
	local face = newPart(card, {
		Name = "CardFace",
		Size = Vector3.new(CARD_SIZE.X - 0.3, CARD_SIZE.Y - 0.3, 0.1),
		CFrame = CFrame.new(0, 0, CARD_SIZE.Z / 2 + 0.05),
		Color = Color3.fromRGB(16, 12, 30),
		Material = Enum.Material.Metal,
	})
	local function paintFront()
		face.Color = rarityColor:Lerp(Color3.new(0, 0, 0), 0.15)
		face.Material = Enum.Material.SmoothPlastic
		faceText(
			face,
			Enum.NormalId.Back,
			series.icon .. " " .. string.upper(series.name),
			series.color:Lerp(Color3.new(1, 1, 1), 0.4),
			UDim2.fromScale(0.06, 0.05),
			UDim2.fromScale(0.88, 0.09),
			true
		)
		faceText(
			face,
			Enum.NormalId.Back,
			string.upper(rarity),
			Color3.new(1, 1, 1),
			UDim2.fromScale(0.05, 0.4),
			UDim2.fromScale(0.9, 0.2),
			true
		)
		faceText(
			face,
			Enum.NormalId.Back,
			"★ ★ ★",
			GOLD,
			UDim2.fromScale(0.2, 0.66),
			UDim2.fromScale(0.6, 0.1),
			true
		)
	end

	local cardSpin = 0 -- extra turn on top of the float
	local cardRise = 0
	local function placeCard(t: number, extra: CFrame?)
		local float = math.sin(t * 2.2) * 0.25
		card:PivotTo(
			STAGE
				* CFrame.new(CARD_HOME + Vector3.new(0, float + cardRise, 0))
				* CFrame.Angles(0, cardSpin + math.sin(t * 0.9) * 0.12, 0)
				* (extra or CFrame.new())
		)
		animateBack(t)
	end
	moveCamera(Vector3.new(0, 7.5, -20), CARD_HOME)
	camTime = 0.6
	animate(0.6, function(a, t)
		local e = easeOut(a)
		cardSpin = (1 - e) * math.pi * 4
		cardRise = -5 * (1 - e)
		placeCard(t)
	end)
	cardSpin = 0
	cardRise = 0

	local function setRim(color: Color3)
		for _, p in rimParts do
			p.Color = color
		end
	end

	----------------------------------------------------------------------------
	-- 4. Clue one: the slot. The arena lights turn its colour.
	----------------------------------------------------------------------------
	state.color = series.color
	state.brightness = 0.7
	slam(series.clue, series.icon .. " " .. string.upper(series.name), series.color)
	setRim(series.color)
	camTime = 2
	moveCamera(Vector3.new(-5, 8, -18), CARD_HOME)
	animate(1.3 + tier * 0.1, function(_, t)
		placeCard(t)
	end)
	hideClue()

	----------------------------------------------------------------------------
	-- 5. Clue two: the rarity, climbing the ladder. COMMON slams in, then UNCOMMON,
	-- RARE... one rung at a time, each lighting the next pip on the meter and turning the
	-- whole arena its colour, with the pauses getting longer and the beams faster as it
	-- climbs. Before a big final rung the arena blacks out and the card's edge pulses like a
	-- heartbeat; then the real rarity lands with everything it's got.
	----------------------------------------------------------------------------
	local rungs = math.max(tier, 1)
	local shown = math.max(math.min(#Rarities.order, math.max(tier, 6)), 1) -- Common..Ultra (Secret if pulled)
	local meter = UI.new("Frame", {
		Name = "RarityMeter",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.92),
		Size = UDim2.fromOffset(shown * 126, 40),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = overlay,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local pips = {}
	for k = 1, shown do
		local name = Rarities.order[k]
		local pip = UI.new("Frame", {
			Name = name,
			Size = UDim2.fromOffset(118, 34),
			BackgroundColor3 = Color3.fromRGB(30, 30, 52),
			BackgroundTransparency = 0.25,
			LayoutOrder = k,
			ZIndex = 20,
			Parent = meter,
		}, { UI.corner(17) })
		local stroke = UI.stroke(nil, 2.5)
		stroke.Parent = pip
		local label = UI.label(string.upper(name), {
			Size = UDim2.fromScale(1, 1),
			FontFace = UI.fonts.heavy,
			TextColor3 = Color3.fromRGB(120, 120, 150),
			ZIndex = 21,
			Parent = pip,
		})
		label.Size = UDim2.new(1, -10, 1, -8)
		label.Position = UDim2.fromOffset(5, 4)
		local scale = UI.new("UIScale", { Parent = pip })
		pips[k] = { frame = pip, stroke = stroke, label = label, scale = scale }
	end
	animate(0.25, function(a, t)
		placeCard(t)
		meter.Position = UDim2.new(0.5, 0, 0.92, 60 * (1 - easeOut(a)))
	end)

	local function lightPip(k: number, current: boolean)
		local pip = pips[k]
		if not pip then
			return
		end
		local color = Rarities.info[Rarities.order[k]].color
		pip.frame.BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.25)
		pip.frame.BackgroundTransparency = 0
		pip.label.TextColor3 = Color3.new(1, 1, 1)
		pip.stroke.Color = if current then Color3.new(1, 1, 1) else UI.OUTLINE
		pip.stroke.Thickness = if current then 3.5 else 2.5
		pip.scale.Scale = if current then 1.15 else 1
	end

	-- Camera stations for the climb: each rung pushes in a little closer.
	local function climbCamera(k: number)
		local f = (k - 1) / math.max(rungs - 1, 1)
		camTime = 0.35
		moveCamera(Vector3.new(math.sin(k * 1.7) * 3, 7.5 - f * 0.8, -19 + f * 5), CARD_HOME)
	end

	-- Fake-outs: on the way up, the card sometimes settles as if this is it and starts to
	-- turn over... then jolts back ("WAIT...!") and the climb carries on. Legendary and
	-- better always get one (Ultra and Secret two); Uncommon and Rare get one half the time.
	local fakeRungs = {}
	local fakeRandom = Random.new()
	if rungs >= 2 and (tier >= 4 or fakeRandom:NextNumber() < 0.5) then
		fakeRungs[fakeRandom:NextInteger(math.max(1, rungs - 2), rungs - 1)] = true
	end
	if tier >= 6 then
		fakeRungs[fakeRandom:NextInteger(1, math.max(1, rungs - 3))] = true
	end
	local function fakeOut(k: number)
		-- It all goes calm, like the climb is over...
		state.sweep = 0.25
		camTime = 0.9
		moveCamera(Vector3.new(0, 7.3, -14), CARD_HOME)
		animate(0.45, function(_, t)
			placeCard(t)
			pips[k].scale.Scale = 1.15
		end)
		-- ...the card starts to turn over...
		animate(0.65, function(a, t)
			cardSpin = math.pi * 0.42 * easeInOut(a)
			placeCard(t)
		end)
		-- ...then jolts back, and the climb is on again.
		flash(Color3.new(1, 1, 1), 0.3)
		state.shake = 1.3
		captionLabel.Text = ""
		clueLabel.Text = "WAIT...!"
		clueLabel.TextColor3 = Color3.new(1, 1, 1)
		animate(0.22, function(a, t)
			cardSpin = math.pi * 0.42 * (1 - easeOut(a))
			placeCard(t)
			clueScale.Scale = 2.4 - 1.4 * easeOut(a)
			clueLabel.TextTransparency = 1 - a
			clueStroke.Transparency = 1 - a
		end)
		cardSpin = 0
		state.sweep = 2.5
		animate(0.55, function(_, t)
			placeCard(t)
		end)
		animate(0.1, function(a, t)
			placeCard(t)
			clueLabel.TextTransparency = a
			clueStroke.Transparency = a
		end)
	end

	for k = 1, rungs do
		local name = Rarities.order[k]
		local color = Rarities.info[name].color
		local final = k == rungs
		if final and tier >= 3 then
			-- Blackout and heartbeat before the big one.
			hideClue()
			state.color = Color3.fromRGB(60, 50, 90)
			state.sweep = 0.2
			camTime = 1.1
			moveCamera(Vector3.new(0, 7.2, -12.5), CARD_HOME)
			animate(0.5 + tier * 0.12, function(a, t)
				placeCard(t)
				state.brightness = 0.9 * (1 - a) + 0.08
				local beat = math.max(math.sin(t * 9), 0) ^ 6
				setRim(Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(40, 30, 60), 1 - beat))
				if beat > 0.95 then
					state.shake = math.max(state.shake, 0.25)
				end
			end)
		end
		lightPip(k, true)
		if pips[k - 1] then
			lightPip(k - 1, false)
		end
		state.color = color
		setRim(color)
		if not final then
			-- A quick rung: the word punches in, the arena turns its colour, then on.
			clueLabel.Text = string.upper(name)
			clueLabel.TextColor3 = color
			captionLabel.Text = "RARITY"
			captionLabel.TextTransparency = 0
			captionLabel:FindFirstChildOfClass("UIStroke").Transparency = 0
			state.brightness = 0.55 + 0.1 * k
			state.sweep = 0.6 + k * 0.5
			climbCamera(k)
			animate(0.14, function(a, t)
				placeCard(t)
				clueScale.Scale = 1.8 - 0.8 * easeOut(a)
				clueLabel.TextTransparency = 1 - a
				clueStroke.Transparency = 1 - a
			end)
			flash(color:Lerp(Color3.new(1, 1, 1), 0.6), 0.15)
			state.shake = 0.3 + k * 0.06
			-- Each rung holds a little longer than the last: the suspense builds.
			animate(0.3 + k * 0.14, function(a, t)
				placeCard(t)
				pips[k].scale.Scale = 1.15 + math.sin(a * math.pi) * 0.08
			end)
			if fakeRungs[k] then
				fakeOut(k)
			else
				animate(0.1, function(a, t)
					placeCard(t)
					clueLabel.TextTransparency = a * 0.7
				end)
			end
		else
			-- The real rarity lands.
			state.brightness = 1
			state.sweep = 1 + tier * 0.4
			state.rainbow = tier >= 6
			if tier >= 3 then
				flash(color:Lerp(Color3.new(1, 1, 1), 0.5), 0.4)
			end
			if state.rainbow then
				local keys = {}
				for c = 0, 6 do
					table.insert(keys, ColorSequenceKeypoint.new(c / 6, Color3.fromHSV(c / 6, 0.75, 1)))
				end
				clueGradient.Color = ColorSequence.new(keys)
				clueGradient.Enabled = true
			end
			slam(
				"RARITY",
				RARITY_WORDS[rarity] or string.upper(rarity),
				if state.rainbow then Color3.new(1, 1, 1) else color
			)
			state.shake = 0.8 + tier * 0.1
			if tier >= 4 then
				local colors = {}
				for c = 1, 6 do
					table.insert(colors, Color3.fromHSV(c / 6, 0.7, 1))
				end
				burst(CARD_HOME + Vector3.new(0, 4, 0), 30 + tier * 8, colors, true)
			end
		end
	end

	local nextStrike = 0.3
	camTime = 1.5 + tier * 0.25
	moveCamera(Vector3.new(5, 6.5, -17), CARD_HOME)
	animate(1.2 + tier * 0.25, function(_, t)
		placeCard(t)
		pips[rungs].scale.Scale = 1.15 + math.sin(t * 6) * 0.06
		if state.rainbow then
			setRim(rainbow(os.clock()))
			clueGradient.Offset = Vector2.new(math.sin(t * 2) * 0.5, 0)
			for k = 1, rungs do
				pips[k].frame.BackgroundColor3 = rainbow(os.clock(), k / rungs)
			end
		end
		if tier >= 5 and t >= nextStrike then
			nextStrike += 0.55
			flash(Color3.fromRGB(220, 200, 255), 0.18)
			state.shake = 0.7
		end
	end)
	hideClue()
	meter:Destroy()

	paintFront()

	----------------------------------------------------------------------------
	-- 6. The flip: the card turns over in 3D, then the part pops out in front of it.
	----------------------------------------------------------------------------
	camTime = 0.5
	moveCamera(Vector3.new(0, 7.5, -16), CARD_HOME)
	animate(0.55, function(a, t)
		cardSpin = math.pi * easeInOut(a)
		placeCard(t)
	end)
	cardSpin = math.pi
	flash(Color3.new(1, 1, 1), 0.35)
	state.shake = 0.8
	burst(CARD_HOME, 24, { rarityColor, Color3.new(1, 1, 1) })
	animate(0.5, function(_, t)
		placeCard(t)
	end)

	-- The card lifts up and back; the part pops out onto the pedestal.
	local freek = ItemModel.buildNormal(result.part.id, result.part.mutations)
	Lego.apply(freek)
	-- Everything fits about the same space in front of the card, a bit bigger or smaller
	-- for big and small sizes.
	local _, size = freek:GetBoundingBox()
	local room = 6.5 * math.clamp(Items.weightScale(Items.weightFactor(result.part)), 0.7, 1.8)
	Items.scaleModel(freek, math.clamp(room / math.max(size.X, size.Y, size.Z, 0.1), 0.3, 2))
	for _, p in freek:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
		end
	end
	freek.Parent = stage
	local freekRest = at(0, PEDESTAL_TOP, -0.5)
	camTime = 0.9
	moveCamera(Vector3.new(0, 5.5, -15), Vector3.new(0, 6.2, 1))
	animate(0.6, function(a, t)
		local e = easeOut(a)
		cardRise = 5 * e
		card:PivotTo(
			STAGE
				* CFrame.new(CARD_HOME + Vector3.new(0, cardRise, 6 * e))
				* CFrame.Angles(0, math.pi + math.sin(t * 0.9) * 0.12, 0)
		)
		local hop = math.sin(a * math.pi) * 3
		freek:PivotTo(freekRest * CFrame.new(0, hop - 2 * (1 - e), 0) * CFrame.Angles(0, (1 - e) * math.pi * 2, 0))
	end)
	flash(rarityColor:Lerp(Color3.new(1, 1, 1), 0.6), 0.3)
	burst(Vector3.new(0, PEDESTAL_TOP + 1, -0.5), 20, { rarityColor, GOLD })
	state.shake = 0.6

	-- 7. The name slams in, with NEW! if it's new to them.
	local nameLabel = UI.label(string.upper(LifeUtil.displayName(result.part)), {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.86),
		Size = UDim2.fromOffset(800, 70),
		FontFace = UI.fonts.heavy,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 20,
		Parent = overlay,
	})
	nameLabel:FindFirstChildOfClass("UIStroke").Thickness = 4
	local nameScale = UI.new("UIScale", { Parent = nameLabel })
	animate(0.2, function(a)
		nameScale.Scale = 2.2 - 1.2 * easeOut(a)
	end)
	local sizeWord = if result.part.weight then Format.weight(result.part.weight):upper() .. "  ·  " else ""
	UI.label(sizeWord .. string.upper(rarity) .. "  ·  " .. string.upper(series.name), {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.86, -50),
		Size = UDim2.fromOffset(500, 28),
		FontFace = UI.fonts.heavy,
		TextColor3 = rarityColor,
		ZIndex = 20,
		Parent = overlay,
	})
	if result.isNew then
		local stamp = UI.label("NEW!", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.64, 0.36),
			Size = UDim2.fromOffset(120, 50),
			FontFace = UI.fonts.heavy,
			TextColor3 = Color3.new(1, 1, 1),
			BackgroundColor3 = UI.colors.red,
			BackgroundTransparency = 0,
			Rotation = 12,
			ZIndex = 22,
			Parent = overlay,
		})
		UI.corner(12).Parent = stamp
		UI.stroke(nil, 3).Parent = stamp
		local stampScale = UI.new("UIScale", { Parent = stamp })
		animate(0.18, function(a)
			stampScale.Scale = 2 - easeOut(a)
		end)
	end
	local WHERE_TEXT = {
		house = "It's on your house!",
		pen = "It's roaming your yard!",
		yard = "It's in your yard!",
		garden = "It's in your garden!",
	}
	UI.label(WHERE_TEXT[result.where] or "It's in your backpack!", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.86, 48),
		Size = UDim2.fromOffset(400, 26),
		TextColor3 = Color3.fromRGB(220, 232, 255),
		ZIndex = 20,
		Parent = overlay,
	})

	-- 8. Show it off until they tap Awesome!
	local closed = false
	UI.button("AWESOME!", UI.colors.green, function()
		closed = true
	end, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -60, 1, -50),
		Size = UDim2.fromOffset(220, 60),
		ZIndex = 25,
		Parent = overlay,
	})
	speed = 1
	camTime = 6
	moveCamera(Vector3.new(-4, 5.5, -14.5), Vector3.new(0, 6.2, 1))
	local showTime = 0
	freek:PivotTo(freekRest)
	while not closed do
		animate(0.2, function(_, t)
			local time = showTime + t
			card:PivotTo(
				STAGE
					* CFrame.new(CARD_HOME + Vector3.new(0, 5 + math.sin(time * 2.2) * 0.25, 6))
					* CFrame.Angles(0, math.pi + math.sin(time * 0.9) * 0.12, 0)
			)
			-- It turns slowly on the pedestal to show off.
			freek:PivotTo(freekRest * CFrame.new(0, math.sin(time * 2) * 0.25, 0) * CFrame.Angles(0, time * 0.7, 0))
			if state.rainbow then
				setRim(rainbow(os.clock()))
			end
		end)
		showTime += 0.2
	end

	-- Back to the game.
	stage:Destroy()
	gui:Destroy()
	showHud()
	camera.CameraType = if oldCameraType == Enum.CameraType.Scriptable then Enum.CameraType.Custom else oldCameraType
	camera.FieldOfView = oldFov
	if controls then
		controls:Enable()
	end
	done()
end

return PackReveal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">PetFX</string>
            <string name="Source"><![CDATA[-- Pets roaming their owner's front lawn, drawn on this client. The server lists each
-- home's pets on its plot (attribute "Pets" = "Pet_Oinkle:Golden:4.21:1.62,..." with each
-- pet's mutation, weight in kg and how big to draw it); this
-- builds a Freek for each and wanders it round the lawn (plot attributes PetMin / PetMax,
-- in plot space), animated with FreekAnimator: walk somewhere, stop, look about, walk on.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local FreekAnimator = require(ReplicatedStorage.Shared.FreekAnimator)
local ItemModel = require(ReplicatedStorage.Shared.ItemModel)
local Items = require(ReplicatedStorage.Shared.Items)
local Lego = require(ReplicatedStorage.Shared.Lego)

local PetFX = {}

local SCALE = 1.5
local WALK_SPEED = 6
local GROUND_Y = 0.4 -- the lawn's top
local OUTLINE = Color3.fromRGB(20, 22, 48)

local rng = Random.new()
local homes = {} -- [plot Model] = { key, pets = { { model, rig, position, goal, yaw, restUntil } } }

local function nameTag(model: Model, text: string, color: Color3, height: number)
	local anchor = model.PrimaryPart
	if not anchor then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(5, 1.1)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height + 1.2, 0)
	gui.MaxDistance = 60
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextColor3 = color
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = OUTLINE
	stroke.Thickness = 2.5
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
end

-- A Freek, scaled up round its feet (more for heavier pets).
local function build(itemId: string, mutation: string?, weightScale: number): (Model, number)
	local model = ItemModel.buildNormal(itemId, if mutation ~= "" then mutation else nil)
	local scale = SCALE * weightScale
	local pivot = model:GetPivot()
	local top = 0
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			local rel = pivot:ToObjectSpace(p.CFrame)
			p.Size *= scale
			p.CFrame = pivot * (rel.Rotation + rel.Position * scale)
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			top = math.max(top, rel.Position.Y * scale + p.Size.Y / 2)
		end
	end
	Lego.apply(model)
	return model, top
end

local function randomSpot(plot: Model): Vector3
	local origin = plot:GetAttribute("Origin")
	local lo, hi = plot:GetAttribute("PetMin"), plot:GetAttribute("PetMax")
	if typeof(origin) ~= "CFrame" or typeof(lo) ~= "Vector3" or typeof(hi) ~= "Vector3" then
		return Vector3.zero
	end
	local x = rng:NextNumber(lo.X, hi.X)
	local z = rng:NextNumber(lo.Z, hi.Z)
	local world = origin:PointToWorldSpace(Vector3.new(x, 0, z))
	return Vector3.new(world.X, GROUND_Y, world.Z)
end

local function clear(home)
	for _, pet in home.pets do
		pet.model:Destroy()
	end
	table.clear(home.pets)
end

local function refresh(plot: Model)
	local list = plot:GetAttribute("Pets")
	local home = homes[plot]
	if not home then
		home = { key = nil, pets = {} }
		homes[plot] = home
	end
	if home.key == list then
		return
	end
	home.key = list
	clear(home)
	if typeof(list) ~= "string" or list == "" then
		return
	end
	for i, entry in string.split(list, ",") do
		local parts = string.split(entry, ":")
		local itemId, mutation = parts[1], parts[2] or ""
		local weight, weightScale = tonumber(parts[3] or ""), tonumber(parts[4] or "") or 1
		local info = itemId and Items.byId[itemId]
		if info and info.kind == "Pet" then
			local model, height = build(itemId, mutation, weightScale)
			local position = randomSpot(plot)
			local yaw = rng:NextNumber(0, math.pi * 2)
			local ground = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
			model:PivotTo(ground)
			model.Name = "Pet_" .. info.species
			model.Parent = plot
			local title = (if mutation ~= "" then mutation .. " " else "")
				.. info.name
				.. (if weight then " · " .. Format.weight(weight) else "")
			nameTag(model, title, Items.color(itemId), height)
			table.insert(home.pets, {
				model = model,
				rig = FreekAnimator.rig(model, i * 13 + #list, ground),
				position = position,
				goal = position,
				yaw = yaw,
				restUntil = os.clock() + rng:NextNumber(0, 3),
			})
		end
	end
end

local function step(dt: number)
	local t = os.clock()
	for plot, home in homes do
		if not plot.Parent then
			clear(home)
			homes[plot] = nil
			continue
		end
		for _, pet in home.pets do
			local offset = pet.goal - pet.position
			local distance = offset.Magnitude
			local walking = distance > 0.3 and t >= pet.restUntil
			if walking then
				pet.position += offset.Unit * math.min(distance, WALK_SPEED * dt)
				local goalYaw = math.atan2(-offset.X, -offset.Z)
				local diff = (goalYaw - pet.yaw + math.pi) % (2 * math.pi) - math.pi
				pet.yaw += diff * math.min(1, dt * 8)
			elseif t >= pet.restUntil then
				-- Arrived: rest a moment, then pick somewhere new.
				pet.restUntil = t + rng:NextNumber(1.5, 5)
				pet.goal = randomSpot(plot)
			end
			local ground = CFrame.new(pet.position) * CFrame.Angles(0, pet.yaw, 0)
			if pet.rig then
				FreekAnimator.pose(pet.rig, ground, t, walking)
			else
				pet.model:PivotTo(ground)
			end
		end
	end
end

local function watch(plot: Instance)
	if not plot:IsA("Model") then
		return
	end
	plot:GetAttributeChangedSignal("Pets"):Connect(function()
		refresh(plot)
	end)
	refresh(plot)
end

function PetFX.start()
	local plots = Workspace:WaitForChild("Plots", 30)
	if not plots then
		return
	end
	for _, plot in plots:GetChildren() do
		watch(plot)
	end
	plots.ChildAdded:Connect(watch)
	RunService.RenderStepped:Connect(step)
end

return PetFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">TreadmillRun</string>
            <string name="Source"><![CDATA[-- Running on your treadmill by yourself: while you stand on your own treadmill's belt and
-- aren't steering, your character runs forward (the belt pushes back just as fast, so you
-- stay on it and train ⚡ Speed). Press any direction to take over and walk off.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local TreadmillRun = {}

local player = Players.LocalPlayer

-- The player's own treadmill belt, if their home has loaded.
local function myBelt(): BasePart?
	local index = player:GetAttribute("Plot")
	local plots = Workspace:FindFirstChild("Plots")
	local plot = index and plots and plots:FindFirstChild("Plot" .. index)
	local treadmill = plot and plot:FindFirstChild("Treadmill")
	local belt = treadmill and treadmill:FindFirstChild("Belt")
	return if belt and belt:IsA("BasePart") then belt else nil
end

-- Same area as the server's PlotService.onTreadmill.
local function onBelt(belt: BasePart, position: Vector3): boolean
	local localPos = belt.CFrame:PointToObjectSpace(position)
	return math.abs(localPos.X) < 3 and math.abs(localPos.Z) < 6.2 and localPos.Y > -1 and localPos.Y < 6
end

function TreadmillRun.start()
	-- The player's own steering, from Roblox's control scripts (nil if they're replaced).
	local controls = nil
	task.spawn(function()
		local ok, playerModule = pcall(function()
			return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10))
		end)
		if ok and playerModule then
			controls = playerModule:GetControls()
		end
	end)
	-- Runs after Roblox's own movement each frame, so it wins while the player isn't steering.
	RunService:BindToRenderStep("TreadmillRun", Enum.RenderPriority.Character.Value + 1, function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local belt = myBelt()
		if not humanoid or not root or not belt or humanoid.Health <= 0 then
			return
		end
		if not onBelt(belt, root.Position) then
			return
		end
		local steering = controls and controls:GetMoveVector().Magnitude > 0.1
		if not steering then
			-- Face the front of the treadmill and run.
			humanoid:Move(belt.CFrame.LookVector, false)
		end
	end)
end

return TreadmillRun
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- Small helpers for building the UI in code (so there's nothing to set up in Studio).
-- Style: the clean cartoon look of the big Roblox simulators (Pet Simulator, PLS DONATE,
-- Grow a Garden) in Steal a Life colours: light windows with a coloured header and a
-- slanted title tab, bright glossy gradient cards with a big 3D picture, black price
-- pills, chunky shaded buttons that squish when pressed, Luckiest Guy titles, Fredoka One
-- text, and every bit of text outlined in dark navy.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BoxModel = require(ReplicatedStorage.Shared.BoxModel)
local Lego = require(ReplicatedStorage.Shared.Lego)
local Items = require(ReplicatedStorage.Shared.Items)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local ItemPictures = require(script.Parent.ItemPictures)

local UI = {}

UI.fonts = {
	regular = Font.fromEnum(Enum.Font.FredokaOne),
	bold = Font.fromEnum(Enum.Font.FredokaOne),
	heavy = Font.fromEnum(Enum.Font.LuckiestGuy),
}

-- The dark outline around panels, buttons and text.
UI.OUTLINE = Color3.fromRGB(20, 22, 48)

UI.colors = {
	panel = Color3.fromRGB(62, 128, 245), -- windows and HUD panels
	card = Color3.fromRGB(110, 170, 255),
	text = Color3.fromRGB(255, 255, 255),
	muted = Color3.fromRGB(220, 232, 255),
	green = Color3.fromRGB(60, 200, 110),
	blue = Color3.fromRGB(70, 140, 255),
	pink = Color3.fromRGB(255, 95, 170),
	orange = Color3.fromRGB(255, 160, 50),
	red = Color3.fromRGB(235, 70, 80),
	gray = Color3.fromRGB(95, 90, 115),
	money = Color3.fromRGB(110, 235, 140),
	gold = Color3.fromRGB(255, 200, 60),
	purple = Color3.fromRGB(160, 110, 240),
	sheet = Color3.fromRGB(236, 230, 255), -- window bodies
	ink = Color3.fromRGB(28, 26, 48), -- price pills
	fusion = Color3.fromRGB(170, 80, 255), -- the game's own purple-to-pink
	fusion2 = Color3.fromRGB(255, 80, 190),
}

-- Bright card colours, picked by name so a card keeps its colour between refreshes.
local CARD_COLORS = {
	Color3.fromRGB(255, 95, 170),
	Color3.fromRGB(70, 200, 110),
	Color3.fromRGB(70, 150, 255),
	Color3.fromRGB(255, 160, 50),
	Color3.fromRGB(165, 95, 245),
	Color3.fromRGB(40, 195, 190),
	Color3.fromRGB(240, 80, 80),
	Color3.fromRGB(250, 200, 50),
}
function UI.cardColor(name: string): Color3
	local sum = 0
	for i = 1, #name do
		sum += string.byte(name, i) * i
	end
	return CARD_COLORS[sum % #CARD_COLORS + 1]
end

UI.GLASS_TRANSPARENCY = 0

-- UI.new("Frame", { Size = ... }, { children... })
function UI.new(className: string, props, children)
	local instance = Instance.new(className)
	for key, value in props or {} do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function UI.corner(radius: number?)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

-- An outline around a frame; defaults to the thick dark cartoon outline.
function UI.stroke(color: Color3?, thickness: number?, transparency: number?)
	return UI.new("UIStroke", {
		Color = color or UI.OUTLINE,
		Thickness = thickness or 3,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

-- An outline around text (the chunky cartoon text look).
function UI.textStroke(thickness: number?)
	return UI.new("UIStroke", {
		Color = UI.OUTLINE,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

-- Shading from light at the top to darker at the bottom. It multiplies whatever colour the
-- frame is, so it works on any button or panel. (color/lighten are kept for old callers.)
function UI.gradient(_color: Color3?, lighten: number?)
	local top = 1
	local bottom = 0.78 - (lighten or 0) * 0.3
	return UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(top, top, top), Color3.new(bottom, bottom, bottom)),
		Rotation = 90,
	})
end

-- A bright cartoon panel with a thick outline (the name is from the old glass style).
function UI.glass(props, children)
	local frame = UI.new("Frame", {
		BackgroundColor3 = UI.colors.panel,
		BackgroundTransparency = UI.GLASS_TRANSPARENCY,
	}, { UI.corner(16), UI.stroke(nil, 3.5), UI.gradient() })
	for key, value in props or {} do
		if key ~= "Parent" then
			frame[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = frame
	end
	if props and props.Parent then
		frame.Parent = props.Parent
	end
	return frame
end

function UI.label(text: string, props)
	local label = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = UI.fonts.bold,
		Text = text,
		TextColor3 = UI.colors.text,
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 24),
	}, { UI.textStroke(1.6) })
	for key, value in props or {} do
		label[key] = value
	end
	return label
end

-- A chunky cartoon button: bright shaded fill, thick dark outline, outlined text, and a
-- squish when pressed.
function UI.button(text: string, color: Color3, onClick: () -> (), props)
	local scale = UI.new("UIScale")
	local button = UI.new("TextButton", {
		BackgroundColor3 = color,
		FontFace = UI.fonts.heavy,
		Text = text,
		TextColor3 = UI.colors.text,
		TextStrokeColor3 = UI.OUTLINE,
		TextStrokeTransparency = 0,
		TextScaled = true,
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, 30),
	}, {
		UI.corner(12),
		UI.gradient(),
		UI.stroke(nil, 3),
		scale,
		UI.new("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
			PaddingTop = UDim.new(0, 5),
			PaddingBottom = UDim.new(0, 5),
		}),
	})
	for key, value in props or {} do
		button[key] = value
	end
	button.MouseButton1Down:Connect(function()
		scale.Scale = 0.92
	end)
	button.MouseButton1Up:Connect(function()
		scale.Scale = 1
	end)
	button.MouseLeave:Connect(function()
		scale.Scale = 1
	end)
	button.Activated:Connect(onClick)
	return button
end

-- A little 3D picture of a Mystery Box.
function UI.boxViewport(crateId: string, size: number?)
	local frame = UI.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, size or 100),
		Ambient = Color3.fromRGB(190, 185, 200),
		LightColor = Color3.fromRGB(255, 245, 230),
		LightDirection = Vector3.new(-1, -1, 1),
	})
	local model, height = BoxModel.build(crateId)
	Lego.apply(model)
	model:PivotTo(CFrame.new())
	model.Parent = frame
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	local distance = height * 2
	camera.CFrame =
		CFrame.lookAt(Vector3.new(distance * 0.35, height * 0.8, -distance), Vector3.new(0, height * 0.42, 0))
	camera.Parent = frame
	frame.CurrentCamera = camera
	return frame
end

-- A card for grids: picture, lines of text, and buttons.
-- opts = { species, mutations?, silhouette?, lines = { {text, color?} }, buttons = { button instances } }
-- A black price pill (like PLS DONATE): coin or Robux icon and the price in white.
function UI.pricePill(text: string, onClick: () -> (), props)
	local pill = UI.button(text, UI.colors.ink, onClick, props)
	pill.TextColor3 = Color3.new(1, 1, 1)
	local corner = pill:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = UDim.new(1, 0)
	end
	local shade = pill:FindFirstChildOfClass("UIGradient")
	if shade then
		shade:Destroy() -- flat and glossy black
	end
	return pill
end

-- A little slanted tag on a card's corner: "NEW", "BEST", "x2"...
function UI.tag(parent: GuiObject, text: string, color: Color3?)
	local tag = UI.new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 6, 0, -8),
		Size = UDim2.fromOffset(64, 26),
		Rotation = 10,
		BackgroundColor3 = color or UI.colors.red,
		FontFace = UI.fonts.heavy,
		Text = text,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = (parent.ZIndex or 1) + 5,
		Parent = parent,
	}, {
		UI.corner(8),
		UI.stroke(nil, 2.5),
		UI.textStroke(1.6),
		UI.new("UIPadding", {
			PaddingLeft = UDim.new(0, 4),
			PaddingRight = UDim.new(0, 4),
			PaddingTop = UDim.new(0, 3),
			PaddingBottom = UDim.new(0, 3),
		}),
	})
	return tag
end

-- A bright glossy card (like Pet Simulator's shop): a gradient in the card's colour with a
-- shine across the top, the title in white, a big picture on a glowing disc, then text
-- lines and buttons. opts: accent (colour), border (a highlight outline, e.g. owned),
-- picture (an ItemPictures key) / part (any item id, + mutations, silhouette) / egg (a zone
-- index, + eggItem for what's inside) / box, lines = { { text,
-- colour?, height? } }, buttons, tag = { text, colour? }, onClick.
function UI.card(opts)
	local title = opts.lines and opts.lines[1] and opts.lines[1][1] or ""
	local accent = opts.accent
	if not accent and opts.part then
		local part = Items.byId[opts.part]
		local rarity = part and part.rarity
		if rarity and rarity ~= "Common" then
			accent = Rarities.info[rarity].color
		end
	end
	accent = accent or (if opts.part then Color3.fromRGB(110, 165, 255) else UI.cardColor(title))
	if opts.background then
		accent = opts.background
	end

	-- Clickable cards are buttons; buttons inside them still get their own clicks.
	local card = UI.new(if opts.onClick then "TextButton" else "Frame", {
		BackgroundColor3 = accent,
	}, {
		UI.corner(16),
		if opts.border then UI.stroke(opts.border, 4.5) else UI.stroke(nil, 3.5),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(165, 165, 175)),
			Rotation = 90,
		}),
	})
	-- The glossy shine across the top.
	UI.new("Frame", {
		Name = "Shine",
		Position = UDim2.fromOffset(5, 4),
		Size = UDim2.new(1, -10, 0.38, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.8,
		Parent = card,
	}, { UI.corner(12) })
	local content = UI.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = card,
	}, {
		UI.new("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
			PaddingTop = UDim.new(0, 6),
			PaddingBottom = UDim.new(0, 8),
		}),
		UI.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 3),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})

	if opts.onClick then
		card.Text = ""
		card.AutoButtonColor = false
	end

	local order = 0
	local function add(child)
		order += 1
		child.LayoutOrder = order
		child.Parent = content
	end

	-- The title on top, big and white.
	local lines = opts.lines or {}
	if lines[1] then
		add(UI.label(lines[1][1], {
			FontFace = UI.fonts.heavy,
			TextColor3 = Color3.new(1, 1, 1),
			Size = UDim2.new(1, 0, 0, math.max(lines[1][3] or 22, 22)),
		}))
	end

	-- The picture, on a soft glowing disc.
	local picture
	if opts.picture then
		picture = ItemPictures.view(opts.picture, opts.pictureHeight)
	elseif opts.box then
		picture = UI.boxViewport(opts.box)
	elseif opts.part then
		picture = ItemPictures.part(opts.part, opts.pictureHeight, opts.silhouette, opts.mutations)
	elseif opts.egg then
		picture = ItemPictures.egg(opts.egg, opts.pictureHeight, opts.eggItem)
	end
	if picture then
		local holder = UI.new("Frame", {
			BackgroundTransparency = 1,
			Size = picture.Size,
		})
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.52),
			Size = UDim2.fromScale(0.62, 0.95),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.72,
			Parent = holder,
		}, { UI.corner(999), UI.new("UIAspectRatioConstraint", { AspectRatio = 1 }) })
		picture.Size = UDim2.fromScale(1, 1)
		picture.Parent = holder
		add(holder)
	end

	for i = 2, #lines do
		local line = lines[i]
		add(UI.label(line[1], {
			TextColor3 = line[2] or UI.colors.text,
			Size = UDim2.new(1, 0, 0, line[3] or 18),
		}))
	end
	for _, button in opts.buttons or {} do
		add(button)
	end
	if opts.tag then
		UI.tag(card, opts.tag[1], opts.tag[2])
	end

	if opts.onClick then
		card.Activated:Connect(opts.onClick)
	end

	return card
end

-- A grid that grows to fit its cards.
function UI.grid(cellWidth: number, cellHeight: number)
	return UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(cellWidth, cellHeight),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>