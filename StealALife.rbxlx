				add({ shape = "Ellipsoid", size = { 0.8, 0.75, 0.8 }, pos = { side * 0.55, 2.3, -2.4 }, color = green })
			end
			-- Black shades with a shine, sitting on the eye bumps.
			for _, side in { -1, 1 } do
				add({
					shape = "Ellipsoid",
					size = { 0.85, 0.6, 0.18 },
					pos = { side * 0.5, 2.35, -2.85 },
					color = rgb(18, 18, 26),
					detail = true,
				})
				add({
					shape = "Ellipsoid",
					size = { 0.18, 0.5, 0.05 },
					pos = { side * 0.5 - 0.15, 2.38, -2.95 },
					rot = { 0, 0, -30 },
					color = rgb(255, 255, 255),
					transparency = 0.35,
					detail = true,
				})
			end
			add({
				shape = "Block",
				size = { 0.3, 0.1, 0.1 },
				pos = { 0, 2.45, -2.85 },
				color = rgb(18, 18, 26),
				detail = true,
			})
			-- Gold chain.
			for k = 0, 13 do
				local a = k / 14 * math.pi * 2
				add({
					shape = "Ball",
					size = 0.26,
					pos = { math.cos(a) * 1.15, 1.3 + math.sin(a) * 0.12, -1.45 + math.sin(a) * 0.55 },
					color = rgb(255, 200, 50),
					material = "Foil",
					detail = true,
				})
			end
			-- Long tapering tail.
			local swish = { hinge = { 0, 1.1, 2.8 }, axis = "Y", amount = 0.5 }
			for k, seg in
				{ { 1.9, 1.1, 1.9, 3.5 }, { 1.4, 0.85, 1.9, 4.9 }, { 0.95, 0.6, 1.8, 6.2 }, { 0.55, 0.4, 1.5, 7.3 } }
			do
				add({
					shape = "Ellipsoid",
					size = { seg[1], seg[2], seg[3] },
					pos = { 0, 1.15 - k * 0.1, seg[4] },
					color = green,
					swing = swish,
				})
				add({
					shape = "Ellipsoid",
					size = { 0.35, 0.3, 0.45 },
					pos = { 0, 1.15 - k * 0.1 + seg[2] / 2, seg[4] },
					color = dark,
					swing = swish,
				})
			end
			return { parts = list }
		end)(),
	},
	{
		id = "Stompy",
		signature = "horn",
		walk = "stomp",
		name = "Stompy",
		rarity = "Mystic",
