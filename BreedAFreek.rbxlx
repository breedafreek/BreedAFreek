      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Tuning knobs for the whole game. Change numbers here, not in the services.

local Config = {
	START_MONEY = 50,
	START_SLOTS = 4, -- yard slots a new player gets
	MAX_SLOTS = 12, -- most yard slots anyone can own
	MAX_FREEKS = 50, -- yard + backpack combined

	SLOT_BASE_PRICE = 250,
	SLOT_PRICE_GROWTH = 2.2, -- each extra slot costs this much more than the last

	SELL_MULTIPLIER = 20, -- a Freek sells for (money per second * this)

	OFFLINE_RATE = 0.5, -- earn 50% of normal income while offline
	OFFLINE_MAX_SECONDS = 8 * 60 * 60, -- capped at 8 hours

	AUTOSAVE_INTERVAL = 60,
	SESSION_LOCK_TIMEOUT = 150, -- seconds before another server may take over a player's save

	PLOT_COUNT = 6, -- set the place's Max Players to this in Game Settings

	GATE_LOCK_SECONDS = 180, -- how long the gate stays locked each time the owner locks it
	STEAL_HOLD_SECONDS = 1.5, -- how long a thief holds the prompt to pick up a Freek
	CATCH_DISTANCE = 6, -- the owner catches a thief by getting this close
}

function Config.slotPrice(currentSlots: number): number
	return math.floor(Config.SLOT_BASE_PRICE * Config.SLOT_PRICE_GROWTH ^ (currentSlots - Config.START_SLOTS))
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx" }

function Format.money(n: number): string
	n = math.floor(n)
	if n < 1000 then
		return "$" .. n
	end
	local i = 1
	local value = n
	while value >= 1000 and i < #SUFFIXES do
		value /= 1000
		i += 1
	end
	local text = string.format("%.1f", value):gsub("%.0$", "")
	return "$" .. text .. SUFFIXES[i]
end

function Format.time(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %dm", h, m)
	elseif m > 0 then
		return string.format("%dm %ds", m, s)
	end
	return string.format("%ds", s)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">FreekModel</string>
          <string name="Source"><![CDATA[-- Builds the 3D model for a Freek out of plain parts.
-- The model's pivot sits at its feet and its face points along -Z (the model's front),
-- so model:PivotTo(groundCFrame) stands it on the ground facing groundCFrame.LookVector.
--
-- A Freek's look is either:
--   * a part list (look.parts, look.effects), for designed Freeks; see buildFromParts, or
--   * the simple generator (look.shape/size/eyes/antennae), for placeholders.
-- A Model in ReplicatedStorage.FreekModels named after the species id overrides both.
--
-- Part list format, in studs, with y = 0 at the ground and the face toward -Z:
--   { shape = "Ball" | "Block" | "Cylinder" | "Wedge", size = { x, y, z } (or one number),
--     pos = { x, y, z }, rot = { x, y, z } (degrees, optional), color = Color3,
--     material = "Neon" etc. (optional), transparency = 0-1 (optional),
--     detail = true (optional: keeps its color when mutated, e.g. eyes) }
-- The first part is the main body. Effects:
--   { type = "Sparkles" | "Fire" | "Smoke" | "Glow", part = index (default 1), color = Color3,
--     size = number (optional) }

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Freeks = require(script.Parent.Freeks)

local FreekModel = {}

FreekModel.RAINBOW_TAG = "RainbowFreek"

local function newPart(props): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		part[key] = value
	end
	return part
end

local function ball(size: number, color: Color3, position: Vector3): Part
	return newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * size,
		Color = color,
		CFrame = CFrame.new(position),
	})
end

local EYE_LAYOUTS = {
	[1] = { size = 0.42, xs = { 0 } },
	[2] = { size = 0.28, xs = { -0.2, 0.2 } },
	[3] = { size = 0.22, xs = { -0.27, 0, 0.27 } },
}

local SHAPES = {
	Ball = Enum.PartType.Ball,
	Block = Enum.PartType.Block,
	Cylinder = Enum.PartType.Cylinder,
}

local function vector(value): Vector3
	if type(value) == "number" then
		return Vector3.one * value
	end
	return Vector3.new(value[1], value[2], value[3])
end

local function addEffect(part: BasePart, effect)
	local kind = effect.type
	local color = effect.color or Color3.fromRGB(255, 230, 120)
	local instance
	if kind == "Sparkles" then
		instance = Instance.new("Sparkles")
		instance.SparkleColor = color
	elseif kind == "Fire" then
		instance = Instance.new("Fire")
		instance.Color = color
		instance.SecondaryColor = effect.color2 or Color3.fromRGB(255, 220, 80)
		instance.Size = effect.size or 5
		instance.Heat = effect.heat or 9
	elseif kind == "Smoke" then
		instance = Instance.new("Smoke")
		instance.Color = color
		instance.Size = effect.size or 2
		instance.Opacity = 0.3
		instance.RiseVelocity = 2
	elseif kind == "Glow" then
		instance = Instance.new("PointLight")
		instance.Color = color
		instance.Range = effect.size or 10
		instance.Brightness = 2
	else
		warn("Unknown Freek effect " .. tostring(kind))
		return
	end
	instance.Parent = part
end

local function buildFromParts(species, mutationId: string?): (Model, number)
	local look = species.look
	local model = Instance.new("Model")
	model.Name = species.name

	local parts = {}
	local top = 0
	for i, spec in look.parts do
		local shape = spec.shape or "Block"
		local size = vector(spec.size)
		local rot = spec.rot or { 0, 0, 0 }
		local cframe = CFrame.new(vector(spec.pos))
			* CFrame.Angles(math.rad(rot[1]), math.rad(rot[2]), math.rad(rot[3]))
		local part
		if shape == "Wedge" then
			part = Instance.new("WedgePart")
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.Material = Enum.Material.SmoothPlastic
		else
			part = newPart({ Shape = SHAPES[shape] or Enum.PartType.Block })
		end
		part.Name = spec.name or (if i == 1 then "Body" else "Part" .. i)
		part.Size = size
		part.CFrame = cframe
		part.Color = spec.color or Color3.new(1, 1, 1)
		if spec.material then
			part.Material = Enum.Material[spec.material]
		end
		part.Transparency = spec.transparency or 0

		if not spec.detail then
			if mutationId == "Golden" then
				part.Color = Color3.fromRGB(255, 196, 40):Lerp(part.Color, 0.15)
				part.Material = Enum.Material.Foil
			elseif mutationId == "Shadow" then
				part.Color = Color3.fromRGB(35, 25, 50):Lerp(part.Color, 0.1)
			elseif mutationId == "Rainbow" then
				part.Material = Enum.Material.Neon
				CollectionService:AddTag(part, FreekModel.RAINBOW_TAG)
			end
		end

		part.Parent = model
		parts[i] = part
		top = math.max(top, spec.pos[2] + size.Y / 2)
	end

	local body = parts[1]
	body.PivotOffset = body.CFrame:Inverse()
	model.PrimaryPart = body

	for _, effect in look.effects or {} do
		addEffect(parts[effect.part or 1], effect)
	end
	if mutationId == "Golden" or mutationId == "Rainbow" then
		addEffect(body, {
			type = "Sparkles",
			color = if mutationId == "Golden" then Color3.fromRGB(255, 220, 80) else Color3.new(1, 1, 1),
		})
	elseif mutationId == "Shadow" then
		addEffect(body, { type = "Smoke", color = Color3.fromRGB(60, 30, 90), size = 1.5 })
	end

	return model, top
end

-- Returns the model and roughly how tall it is (for placing name tags).
function FreekModel.build(speciesId: string, mutationId: string?): (Model, number)
	local species = Freeks.byId[speciesId] or Freeks.list[1]
	local look = species.look
	local s = look.size or 3

	local custom = ReplicatedStorage:FindFirstChild("FreekModels")
	custom = custom and custom:FindFirstChild(species.id)
	if custom and custom:IsA("Model") then
		local model = custom:Clone()
		local _, extents = model:GetBoundingBox()
		return model, extents.Y
	end

	if look.parts then
		return buildFromParts(species, mutationId)
	end

	local bodyColor = look.color
	local bodyMaterial = Enum.Material.SmoothPlastic
	local pupilColor = Color3.new(0, 0, 0)
	local pupilMaterial = Enum.Material.SmoothPlastic
	if mutationId == "Golden" then
		bodyColor = Color3.fromRGB(255, 196, 40)
		bodyMaterial = Enum.Material.Foil
	elseif mutationId == "Shadow" then
		bodyColor = Color3.fromRGB(35, 25, 50)
		pupilColor = Color3.fromRGB(180, 70, 255)
		pupilMaterial = Enum.Material.Neon
	elseif mutationId == "Rainbow" then
		bodyMaterial = Enum.Material.Neon
	end

	local model = Instance.new("Model")
	model.Name = species.name

	local isBall = look.shape ~= "Block"
	local bodyY = s * 0.6
	local body = newPart({
		Name = "Body",
		Shape = if isBall then Enum.PartType.Ball else Enum.PartType.Block,
		Size = Vector3.one * s,
		Color = bodyColor,
		Material = bodyMaterial,
		CFrame = CFrame.new(0, bodyY, 0),
	})
	body.PivotOffset = CFrame.new(0, -bodyY, 0)
	body.Parent = model
	model.PrimaryPart = body

	if mutationId == "Rainbow" then
		CollectionService:AddTag(body, FreekModel.RAINBOW_TAG)
	end
	if mutationId == "Golden" or mutationId == "Rainbow" then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = if mutationId == "Golden"
			then Color3.fromRGB(255, 220, 80)
			else Color3.fromRGB(255, 255, 255)
		sparkles.Parent = body
	end

	-- Where the front surface of the body is at a given offset (in multiples of s) from its center.
	local function frontZ(x: number, y: number): number
		if isBall then
			return -math.sqrt(math.max(0.25 - x * x - y * y, 0.04)) * s
		end
		return -0.5 * s
	end

	-- Feet
	for _, x in { -0.25, 0.25 } do
		local foot = ball(s * 0.3, bodyColor:Lerp(Color3.new(0, 0, 0), 0.25), Vector3.new(x * s, s * 0.15, -0.05 * s))
		foot.Material = bodyMaterial
		foot.Parent = model
	end

	-- Eyes
	local layout = EYE_LAYOUTS[math.clamp(look.eyes or 2, 1, 3)]
	local eyeY = 0.12
	for _, x in layout.xs do
		local z = frontZ(x, eyeY) + 0.04 * s
		local white = ball(s * layout.size, Color3.new(1, 1, 1), Vector3.new(x * s, bodyY + eyeY * s, z))
		white.Parent = model
		local pupil =
			ball(s * layout.size * 0.5, pupilColor, Vector3.new(x * s, bodyY + eyeY * s, z - s * layout.size * 0.36))
		pupil.Material = pupilMaterial
		pupil.Parent = model
	end

	-- Mouth
	local mouthY = -0.17
	local mouth = newPart({
		Size = Vector3.new(0.3 * s, 0.06 * s, 0.06 * s),
		Color = Color3.fromRGB(60, 20, 30),
		CFrame = CFrame.new(0, bodyY + mouthY * s, frontZ(0, mouthY) + 0.01 * s),
	})
	mouth.Parent = model

	-- Antennae
	local count = math.clamp(look.antennae or 0, 0, 3)
	for i = 1, count do
		local x = if count == 1 then 0 else (i - (count + 1) / 2) * 0.25
		local topY = bodyY + (if isBall then 0.45 else 0.5) * s
		local stalk = newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4 * s, 0.06 * s, 0.06 * s),
			Color = bodyColor:Lerp(Color3.new(0, 0, 0), 0.35),
			CFrame = CFrame.new(x * s, topY + 0.2 * s, 0) * CFrame.Angles(0, 0, math.pi / 2),
		})
		stalk.Parent = model
		local tip = ball(0.15 * s, Color3.fromRGB(255, 240, 120), Vector3.new(x * s, topY + 0.42 * s, 0))
		tip.Material = Enum.Material.Neon
		tip.Parent = model
	end

	return model, s * 1.6
end

return FreekModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">FreekUtil</string>
          <string name="Source"><![CDATA[-- Helpers shared by server and client for reading a saved Freek record:
--   { species = "Blobby", mutation = "Golden"?, slot = 3?, breeding = true? }

local Config = require(script.Parent.Config)
local Freeks = require(script.Parent.Freeks)
local Mutations = require(script.Parent.Mutations)
local Rarities = require(script.Parent.Rarities)
local Seasons = require(script.Parent.Seasons)

local FreekUtil = {}

function FreekUtil.species(freek)
	return Freeks.byId[freek.species]
end

function FreekUtil.income(freek): number
	local species = Freeks.byId[freek.species]
	if not species then
		return 0
	end
	return species.income * Mutations.mult(freek.mutation)
end

function FreekUtil.sellValue(freek): number
	return math.floor(FreekUtil.income(freek) * Config.SELL_MULTIPLIER)
end

function FreekUtil.displayName(freek): string
	local species = Freeks.byId[freek.species]
	local name = if species then species.name else "???"
	return if freek.mutation then freek.mutation .. " " .. name else name
end

-- "Rare" or, for Seasonal Freeks, "Rare · Halloween".
function FreekUtil.rarityText(speciesId: string): string
	local species = Freeks.byId[speciesId]
	local season = species.season and Seasons.list[species.season]
	return if season then species.rarity .. " · " .. season.name else species.rarity
end

function FreekUtil.yardIncome(data): number
	local total = 0
	for _, freek in data.freeks do
		if freek.slot then
			total += FreekUtil.income(freek)
		end
	end
	return total
end

-- First empty yard slot, or nil if the yard is full.
function FreekUtil.freeSlot(data): number?
	local used = {}
	for _, freek in data.freeks do
		if freek.slot then
			used[freek.slot] = true
		end
	end
	for i = 1, data.slots do
		if not used[i] then
			return i
		end
	end
	return nil
end

function FreekUtil.count(data): number
	local n = 0
	for _ in data.freeks do
		n += 1
	end
	return n
end

function FreekUtil.breedTime(a, b): number
	local rankA = Rarities.rank[Freeks.byId[a.species].rarity]
	local rankB = Rarities.rank[Freeks.byId[b.species].rarity]
	local rarity = Rarities.order[math.max(rankA, rankB)]
	return Rarities.info[rarity].breedTime
end

return FreekUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Freeks</string>
          <string name="Source"><![CDATA[-- Every Freek species in the game. These are PLACEHOLDERS until the real list arrives.
--
-- id       unique key saved in player data; never rename one after release
-- income   money per second while in the yard
-- price    set only for Freeks sold in the shop (starter Freeks)
-- season   optional Seasonal tag (a key in Seasons.luau): only obtainable during that season
-- look     how the placeholder model is built: shape "Ball" or "Block", size in studs,
--          eyes 1-3, antennae 0-3
--
-- How new species are bred lives in ServerScriptService (Recipes) so players can't read it.

local Freeks = {}

Freeks.list = {
	-- Starter Freeks (shop)
	{
		id = "Oinkle",
		name = "Oinkle",
		rarity = "Common",
		income = 1,
		price = 50,
		look = {
			parts = {
				-- Body
				{ shape = "Ball", size = 3.4, pos = { 0, 2.1, 0 }, color = Color3.fromRGB(255, 170, 190) },
				-- Legs
				{
					shape = "Cylinder",
					size = { 1, 0.75, 0.75 },
					pos = { -0.8, 0.5, -0.75 },
					rot = { 0, 0, 90 },
					color = Color3.fromRGB(240, 145, 170),
				},
				{
					shape = "Cylinder",
					size = { 1, 0.75, 0.75 },
					pos = { 0.8, 0.5, -0.75 },
					rot = { 0, 0, 90 },
					color = Color3.fromRGB(240, 145, 170),
				},
				{
					shape = "Cylinder",
					size = { 1, 0.75, 0.75 },
					pos = { -0.8, 0.5, 0.75 },
					rot = { 0, 0, 90 },
					color = Color3.fromRGB(240, 145, 170),
				},
				{
					shape = "Cylinder",
					size = { 1, 0.75, 0.75 },
					pos = { 0.8, 0.5, 0.75 },
					rot = { 0, 0, 90 },
					color = Color3.fromRGB(240, 145, 170),
				},
				-- Snout and nostrils
				{
					shape = "Cylinder",
					size = { 0.55, 1.15, 1.15 },
					pos = { 0, 1.95, -1.72 },
					rot = { 0, 90, 0 },
					color = Color3.fromRGB(255, 135, 160),
				},
				{
					shape = "Ball",
					size = 0.24,
					pos = { -0.22, 1.95, -2.0 },
					color = Color3.fromRGB(110, 40, 60),
					detail = true,
				},
				{
					shape = "Ball",
					size = 0.24,
					pos = { 0.22, 1.95, -2.0 },
					color = Color3.fromRGB(110, 40, 60),
					detail = true,
				},
				-- Eyes
				{
					shape = "Ball",
					size = 0.62,
					pos = { -0.6, 2.75, -1.42 },
					color = Color3.new(1, 1, 1),
					detail = true,
				},
				{
					shape = "Ball",
					size = 0.32,
					pos = { -0.6, 2.75, -1.68 },
					color = Color3.new(0, 0, 0),
					detail = true,
				},
				{ shape = "Ball", size = 0.62, pos = { 0.6, 2.75, -1.42 }, color = Color3.new(1, 1, 1), detail = true },
				{ shape = "Ball", size = 0.32, pos = { 0.6, 2.75, -1.68 }, color = Color3.new(0, 0, 0), detail = true },
				-- Rosy cheeks
				{
					shape = "Ball",
					size = 0.5,
					pos = { -1.0, 2.0, -1.22 },
					color = Color3.fromRGB(255, 110, 140),
					detail = true,
				},
				{
					shape = "Ball",
					size = 0.5,
					pos = { 1.0, 2.0, -1.22 },
					color = Color3.fromRGB(255, 110, 140),
					detail = true,
				},
				-- Smile
				{
					shape = "Block",
					size = { 0.55, 0.1, 0.1 },
					pos = { 0, 1.18, -1.45 },
					color = Color3.fromRGB(110, 40, 60),
					detail = true,
				},
				-- Floppy ears
				{
					shape = "Wedge",
					size = { 0.2, 1.1, 1 },
					pos = { -0.85, 3.55, -0.4 },
					rot = { -15, 90, 20 },
					color = Color3.fromRGB(240, 140, 165),
				},
				{
					shape = "Wedge",
					size = { 0.2, 1.1, 1 },
					pos = { 0.85, 3.55, -0.4 },
					rot = { -15, -90, -20 },
					color = Color3.fromRGB(240, 140, 165),
				},
				-- Curly tail
				{ shape = "Ball", size = 0.3, pos = { 0, 2.25, 1.75 }, color = Color3.fromRGB(240, 145, 170) },
				{ shape = "Ball", size = 0.3, pos = { 0.18, 2.42, 1.88 }, color = Color3.fromRGB(240, 145, 170) },
				{ shape = "Ball", size = 0.3, pos = { 0.05, 2.62, 1.96 }, color = Color3.fromRGB(240, 145, 170) },
				{ shape = "Ball", size = 0.3, pos = { -0.14, 2.5, 2.02 }, color = Color3.fromRGB(240, 145, 170) },
			},
		},
	},
	{
		id = "Blobby",
		name = "Blobby",
		rarity = "Common",
		income = 1,
		price = 50,
		look = { color = Color3.fromRGB(120, 200, 255), shape = "Ball", size = 3, eyes = 2, antennae = 0 },
	},
	{
		id = "Snorp",
		name = "Snorp",
		rarity = "Common",
		income = 2,
		price = 120,
		look = { color = Color3.fromRGB(255, 140, 180), shape = "Ball", size = 3.2, eyes = 1, antennae = 1 },
	},
	{
		id = "Wigglet",
		name = "Wigglet",
		rarity = "Common",
		income = 3,
		price = 250,
		look = { color = Color3.fromRGB(140, 230, 110), shape = "Block", size = 2.8, eyes = 2, antennae = 2 },
	},
	{
		id = "Grumbo",
		name = "Grumbo",
		rarity = "Common",
		income = 5,
		price = 500,
		look = { color = Color3.fromRGB(170, 120, 80), shape = "Block", size = 3.4, eyes = 3, antennae = 0 },
	},

	-- Bred only
	{
		id = "Snoblob",
		name = "Snoblob",
		rarity = "Uncommon",
		income = 12,
		look = { color = Color3.fromRGB(190, 150, 255), shape = "Ball", size = 3.6, eyes = 2, antennae = 1 },
	},
	{
		id = "Wigglump",
		name = "Wigglump",
		rarity = "Uncommon",
		income = 18,
		look = { color = Color3.fromRGB(230, 220, 90), shape = "Block", size = 3.6, eyes = 3, antennae = 2 },
	},
	{
		id = "Blobwig",
		name = "Blobwig",
		rarity = "Uncommon",
		income = 15,
		look = { color = Color3.fromRGB(90, 220, 200), shape = "Ball", size = 3.4, eyes = 3, antennae = 2 },
	},
	{
		id = "Grumsnorp",
		name = "Grumsnorp",
		rarity = "Uncommon",
		income = 22,
		look = { color = Color3.fromRGB(255, 120, 70), shape = "Block", size = 3.8, eyes = 1, antennae = 1 },
	},

	{
		id = "Chonkler",
		name = "Chonkler",
		rarity = "Rare",
		income = 60,
		look = { color = Color3.fromRGB(255, 90, 90), shape = "Ball", size = 4.6, eyes = 2, antennae = 0 },
	},
	{
		id = "Zorpdorp",
		name = "Zorpdorp",
		rarity = "Rare",
		income = 75,
		look = { color = Color3.fromRGB(60, 120, 255), shape = "Block", size = 4.2, eyes = 3, antennae = 3 },
	},

	{
		id = "EyeballEarl",
		name = "Eyeball Earl",
		rarity = "Legendary",
		income = 250,
		look = { color = Color3.fromRGB(245, 245, 245), shape = "Ball", size = 5, eyes = 1, antennae = 2 },
	},

	{
		id = "KingGoob",
		name = "King Goob",
		rarity = "Mystic",
		income = 1000,
		look = { color = Color3.fromRGB(120, 255, 120), shape = "Ball", size = 6, eyes = 2, antennae = 3 },
	},

	{
		id = "CosmicSnorp",
		name = "Cosmic Snorp",
		rarity = "Ultra",
		income = 4000,
		look = { color = Color3.fromRGB(40, 20, 90), shape = "Ball", size = 6.5, eyes = 3, antennae = 1 },
	},

	-- Seasonal
	{
		id = "PumpkinBlob",
		name = "Pumpkin Blob",
		rarity = "Rare",
		season = "Halloween",
		income = 90,
		look = { color = Color3.fromRGB(255, 130, 20), shape = "Ball", size = 4.2, eyes = 2, antennae = 1 },
	},

	{
		id = "TheFreek",
		name = "The Freek",
		rarity = "Secret",
		income = 15000,
		look = { color = Color3.fromRGB(15, 15, 15), shape = "Block", size = 7, eyes = 3, antennae = 3 },
	},
}

Freeks.byId = {}
for i, species in Freeks.list do
	species.order = i
	Freeks.byId[species.id] = species
end

return Freeks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Mutations</string>
          <string name="Source"><![CDATA[-- Mutations a bred Freek can roll. Rarest first: breeding checks them in this order.
-- chance is per breed; it is multiplied by INHERIT_BOOST when a parent has that mutation.

local Mutations = {}

Mutations.INHERIT_BOOST = 4

Mutations.list = {
	{ id = "Rainbow", mult = 10, chance = 0.01, color = Color3.fromRGB(255, 120, 255) },
	{ id = "Golden", mult = 3, chance = 0.04, color = Color3.fromRGB(255, 200, 50) },
	{ id = "Shadow", mult = 2, chance = 0.07, color = Color3.fromRGB(160, 90, 255) },
}

Mutations.byId = {}
for _, mutation in Mutations.list do
	Mutations.byId[mutation.id] = mutation
end

function Mutations.mult(id: string?): number
	local mutation = id and Mutations.byId[id]
	return if mutation then mutation.mult else 1
end

return Mutations
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Rarities</string>
          <string name="Source"><![CDATA[-- Rarity tiers, lowest to highest. breedTime is in seconds. carrySpeed is how fast a thief
-- walks while carrying a Freek of this rarity (normal walking speed is 16).
-- "Seasonal" isn't a tier: it's a tag a Freek of any rarity can have (see Seasons).

local Rarities = {}

Rarities.order = { "Common", "Uncommon", "Rare", "Legendary", "Mystic", "Ultra", "Secret" }

Rarities.info = {
	Common = { color = Color3.fromRGB(200, 200, 200), breedTime = 30, carrySpeed = 15 },
	Uncommon = { color = Color3.fromRGB(90, 220, 90), breedTime = 60, carrySpeed = 14 },
	Rare = { color = Color3.fromRGB(70, 150, 255), breedTime = 120, carrySpeed = 12.5 },
	Legendary = { color = Color3.fromRGB(255, 180, 40), breedTime = 300, carrySpeed = 11 },
	Mystic = { color = Color3.fromRGB(190, 90, 255), breedTime = 600, carrySpeed = 9.5 },
	Ultra = { color = Color3.fromRGB(255, 60, 100), breedTime = 1200, carrySpeed = 8 },
	Secret = { color = Color3.fromRGB(255, 255, 255), breedTime = 2400, carrySpeed = 6.5 },
}

Rarities.rank = {}
for i, name in Rarities.order do
	Rarities.rank[name] = i
end

return Rarities
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- One place that names every remote. The server creates them; clients wait for them.
--
-- Action          client -> server   (actionName, ...args)
-- State           server -> client   (snapshot of the player's own data)
-- Notify          server -> client   (message, kind?)
-- DiscoveryUpdate server -> client   (speciesId, discovery)
-- Trade           server -> client   ("Request" | "State" | "Closed", payload)
-- GetState        client -> server   returns snapshot once data has loaded
-- GetDiscoveries  client -> server   returns { [speciesId] = discovery }

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local KINDS = {
	Action = "RemoteEvent",
	State = "RemoteEvent",
	Notify = "RemoteEvent",
	DiscoveryUpdate = "RemoteEvent",
	Trade = "RemoteEvent",
	GetState = "RemoteFunction",
	GetDiscoveries = "RemoteFunction",
}

local Remotes = {}

function Remotes.get(name: string): any
	local className = KINDS[name]
	assert(className, "Unknown remote " .. name)

	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = ReplicatedStorage
		end
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new(className)
			remote.Name = name
			remote.Parent = folder
		end
		return remote
	end

	return ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Seasons</string>
          <string name="Source"><![CDATA[-- Limited events for Seasonal Freeks. A Freek with `season = "Halloween"` can only be bred
-- (or bought, if it has a price) while that event is running. Once owned it's kept forever
-- and still earns, trades and breeds year-round.
--
-- Each event's `window(year)` returns its first and last day (inclusive, UTC) as day
-- numbers (days since 1970-01-01). Windows may run past New Year.

local Seasons = {}

-- Days since 1970-01-01 for a calendar date (proleptic Gregorian).
local function dayNumber(year: number, month: number, day: number): number
	if month <= 2 then
		year -= 1
	end
	local era = year // 400
	local yearOfEra = year - era * 400
	local monthIndex = (month + 9) % 12
	local dayOfYear = (153 * monthIndex + 2) // 5 + day - 1
	local dayOfEra = yearOfEra * 365 + yearOfEra // 4 - yearOfEra // 100 + dayOfYear
	return era * 146097 + dayOfEra - 719468
end

local function weekday(days: number): number
	return (days + 4) % 7 -- 0 = Sunday; 1970-01-01 was a Thursday
end

local function easter(year: number): (number, number)
	local a = year % 19
	local b = year // 100
	local c = year % 100
	local d = b // 4
	local e = b % 4
	local f = (b + 8) // 25
	local g = (b - f + 1) // 3
	local h = (19 * a + b - d - g + 15) % 30
	local i = c // 4
	local k = c % 4
	local l = (32 + 2 * e + 2 * i - h - k) % 7
	local m = (a + 11 * h + 22 * l) // 451
	local month = (h + l - 7 * m + 114) // 31
	local day = (h + l - 7 * m + 114) % 31 + 1
	return month, day
end

local function fixed(fromMonth: number, fromDay: number, toMonth: number, toDay: number)
	return function(year: number)
		local first = dayNumber(year, fromMonth, fromDay)
		local toYear = if toMonth < fromMonth then year + 1 else year
		return first, dayNumber(toYear, toMonth, toDay)
	end
end

Seasons.list = {
	Halloween = {
		name = "Halloween",
		color = Color3.fromRGB(255, 130, 20),
		window = fixed(10, 1, 10, 31),
	},
	Thanksgiving = {
		name = "Thanksgiving",
		color = Color3.fromRGB(200, 120, 50),
		-- Nov 1 through the Sunday after Thanksgiving (4th Thursday of November).
		window = function(year)
			local nov1 = dayNumber(year, 11, 1)
			local firstThursday = nov1 + (4 - weekday(nov1)) % 7
			return nov1, firstThursday + 21 + 3
		end,
	},
	Christmas = {
		name = "Christmas",
		color = Color3.fromRGB(230, 50, 60),
		window = fixed(12, 1, 12, 26),
	},
	NewYears = {
		name = "New Years",
		color = Color3.fromRGB(255, 215, 90),
		window = fixed(12, 27, 1, 7),
	},
	Easter = {
		name = "Easter",
		color = Color3.fromRGB(255, 170, 220),
		-- Two weeks before Easter Sunday through Easter Monday.
		window = function(year)
			local month, day = easter(year)
			local sunday = dayNumber(year, month, day)
			return sunday - 14, sunday + 1
		end,
	},
	America = {
		name = "America",
		color = Color3.fromRGB(70, 120, 255),
		-- The week around July 4th.
		window = fixed(6, 28, 7, 7),
	},
}

function Seasons.isActive(seasonId: string?, now: number?): boolean
	local season = seasonId and Seasons.list[seasonId]
	if not season then
		return false
	end
	local today = (now or os.time()) // 86400
	local year = os.date("!*t", now or os.time()).year
	-- Check last year's window too, for events that run past New Year.
	for _, y in { year - 1, year } do
		local first, last = season.window(y)
		if today >= first and today <= last then
			return true
		end
	end
	return false
end

-- True if this species can be obtained right now (always true for non-seasonal Freeks).
function Seasons.available(species, now: number?): boolean
	return species.season == nil or Seasons.isActive(species.season, now)
end

-- The events running right now, e.g. { "Halloween" }.
function Seasons.active(now: number?): { string }
	local list = {}
	for id in Seasons.list do
		if Seasons.isActive(id, now) then
			table.insert(list, id)
		end
	end
	table.sort(list)
	return list
end

return Seasons
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="12">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="13">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">ActionService</string>
          <string name="Source"><![CDATA[-- Everything a player can ask the server to do. Every argument from the client is
-- untrusted, so each handler re-checks ownership, money and limits itself.

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Freeks = require(ReplicatedStorage.Shared.Freeks)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Seasons = require(ReplicatedStorage.Shared.Seasons)

local Carried = require(script.Parent.Carried)
local DataService = require(script.Parent.DataService)
local DiscoveryService = require(script.Parent.DiscoveryService)
local Recipes = require(script.Parent.Recipes)

local ActionService = {}

local notifyRemote = Remotes.get("Notify")
local stateRemote = Remotes.get("State")
local rng = Random.new()
local lastAction = {} -- [Player] = os.clock()

local function notify(player: Player, message: string, kind: string?)
	notifyRemote:FireClient(player, message, kind)
end

-- What the client is allowed to see of its own save.
local function snapshot(data)
	return {
		money = data.money,
		slots = data.slots,
		freeks = data.freeks,
		breeding = data.breeding,
		discovered = data.discovered,
	}
end

-- Adds a Freek, puts it in the yard if there's room, and records the discovery.
local function giveFreek(player: Player, data, species: string, mutation: string?)
	local uid = HttpService:GenerateGUID(false)
	data.freeks[uid] = { species = species, mutation = mutation, slot = FreekUtil.freeSlot(data) }
	local isNew = not data.discovered[species]
	data.discovered[species] = true
	task.spawn(DiscoveryService.claim, player, species)
	return uid, isNew
end

local function ownedFreek(data, uid: any)
	if typeof(uid) ~= "string" then
		return nil
	end
	return data.freeks[uid]
end

local handlers = {}

function handlers.BuyFreek(player: Player, data, speciesId: any)
	local species = typeof(speciesId) == "string" and Freeks.byId[speciesId]
	if not species or not species.price then
		return
	end
	if not Seasons.available(species) then
		return notify(player, species.name .. " is out of season!", "error")
	end
	if FreekUtil.count(data) >= Config.MAX_FREEKS then
		return notify(player, "You have too many Freeks! Sell some first.", "error")
	end
	if data.money < species.price then
		return notify(player, "Not enough money!", "error")
	end
	data.money -= species.price
	giveFreek(player, data, species.id, nil)
	notify(player, "You got a " .. species.name .. "!", "success")
end

function handlers.BuySlot(player: Player, data)
	if data.slots >= Config.MAX_SLOTS then
		return notify(player, "Your yard is as big as it gets!", "error")
	end
	local price = Config.slotPrice(data.slots)
	if data.money < price then
		return notify(player, "Not enough money! A new slot costs " .. Format.money(price), "error")
	end
	data.money -= price
	data.slots += 1
	notify(player, "Your yard grew! You now have " .. data.slots .. " slots.", "success")
end

function handlers.Place(player: Player, data, uid: any)
	local freek = ownedFreek(data, uid)
	if not freek or freek.breeding or freek.slot or Carried.is(player, uid) then
		return
	end
	local slot = FreekUtil.freeSlot(data)
	if not slot then
		return notify(player, "Your yard is full! Buy more slots or remove a Freek.", "error")
	end
	freek.slot = slot
end

function handlers.Unplace(_player: Player, data, uid: any)
	local freek = ownedFreek(data, uid)
	if freek then
		freek.slot = nil
	end
end

function handlers.Sell(player: Player, data, uid: any)
	local freek = ownedFreek(data, uid)
	if not freek or freek.breeding then
		return
	end
	if Carried.is(player, uid) then
		return notify(player, "Someone is stealing that Freek! Catch them!", "error")
	end
	local value = FreekUtil.sellValue(freek)
	data.freeks[uid] = nil
	data.money += value
	notify(player, "Sold " .. FreekUtil.displayName(freek) .. " for " .. Format.money(value), "money")
end

function handlers.StartBreed(player: Player, data, uidA: any, uidB: any)
	if data.breeding then
		return notify(player, "Your pen is already busy!", "error")
	end
	local a, b = ownedFreek(data, uidA), ownedFreek(data, uidB)
	if not a or not b or uidA == uidB or a.breeding or b.breeding then
		return
	end
	if Carried.is(player, uidA) or Carried.is(player, uidB) then
		return notify(player, "Someone is stealing that Freek! Catch them!", "error")
	end
	if FreekUtil.count(data) >= Config.MAX_FREEKS then
		return notify(player, "No room for a baby! Sell a Freek first.", "error")
	end
	a.slot, b.slot = nil, nil
	a.breeding, b.breeding = true, true
	local duration = FreekUtil.breedTime(a, b)
	data.breeding = { a = uidA, b = uidB, endsAt = os.time() + duration }
	notify(player, "Breeding started! Back in " .. Format.time(duration) .. ".", "success")
end

function handlers.ClaimBreed(player: Player, data)
	local breeding = data.breeding
	if not breeding or os.time() < breeding.endsAt then
		return
	end
	local a, b = data.freeks[breeding.a], data.freeks[breeding.b]
	data.breeding = nil
	if not a or not b then
		return
	end
	a.breeding, b.breeding = nil, nil

	local species, mutation = Recipes.roll(a, b, rng)
	-- Parents go back into the yard first so they keep earning.
	a.slot = FreekUtil.freeSlot(data)
	b.slot = FreekUtil.freeSlot(data)
	local _, isNew = giveFreek(player, data, species, mutation)

	local name = FreekUtil.displayName({ species = species, mutation = mutation })
	if isNew then
		notify(player, "NEW FREEK! You bred a " .. name .. "!", "discovery")
	else
		notify(player, "You bred a " .. name .. "!", "success")
	end
end

-- Lets other services add actions (they get the same rate limit and refresh).
function ActionService.register(name: string, handler)
	handlers[name] = handler
end

function ActionService.init()
	Remotes.get("GetState").OnServerInvoke = function(player)
		local data = DataService.waitFor(player)
		return data and snapshot(data)
	end

	DataService.onChanged(function(player, data)
		stateRemote:FireClient(player, snapshot(data))
	end)

	Remotes.get("Action").OnServerEvent:Connect(function(player, action, ...)
		local handler = typeof(action) == "string" and handlers[action]
		local data = DataService.get(player)
		if not handler or not data then
			return
		end
		local now = os.clock()
		if lastAction[player] and now - lastAction[player] < 0.15 then
			return
		end
		lastAction[player] = now

		local ok, err = pcall(handler, player, data, ...)
		if not ok then
			warn("Action", action, "failed for", player.Name, err)
		end
		DataService.changed(player)
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
	end)
end

return ActionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Carried</string>
          <string name="Source"><![CDATA[-- Which Freeks are being carried off by a thief right now. Kept in memory only: if the
-- server stops mid-steal, the owner simply keeps the Freek.

local Carried = {}

local byOwner = {} -- [owner Player] = { [uid] = thief Player }

function Carried.is(owner: Player, uid: string): boolean
	local list = byOwner[owner]
	return list ~= nil and list[uid] ~= nil
end

function Carried.set(owner: Player, uid: string, thief: Player?)
	local list = byOwner[owner]
	if thief then
		if not list then
			list = {}
			byOwner[owner] = list
		end
		list[uid] = thief
	elseif list then
		list[uid] = nil
		if next(list) == nil then
			byOwner[owner] = nil
		end
	end
end

return Carried
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Loads and saves each player's data with a session lock, so the same player in two
-- servers at once (e.g. a fast rejoin) can't duplicate or lose Freeks.
--
-- In Studio without "Enable Studio Access to API Services", saving is skipped and a
-- fresh save is used so the game is still testable.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local STORE_NAME = "BreedAFreek_Players_v1"

local DataService = {}

local profiles = {} -- [Player] = data
local noSave = {} -- [Player] = true when running without DataStores
local loadedCallbacks = {}
local changedCallbacks = {}

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local function defaultData()
	return {
		version = 1,
		money = Config.START_MONEY,
		slots = Config.START_SLOTS,
		freeks = {}, -- [uid] = { species, mutation?, slot?, breeding? }
		breeding = nil, -- { a = uid, b = uid, endsAt = unix seconds }
		discovered = {}, -- [speciesId] = true for every species this player has owned
		lastSeen = os.time(),
	}
end

local function reconcile(data)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		end
	end
	return data
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

-- Returns data, or nil + reason. reason is "locked" when another server holds the save.
local function tryLoad(player: Player)
	local locked = false
	local ok, result = pcall(function()
		return store:UpdateAsync(keyFor(player), function(old)
			locked = false
			old = old or defaultData()
			local lock = old.lock
			if lock and lock.job ~= game.JobId and os.time() - lock.time < Config.SESSION_LOCK_TIMEOUT then
				locked = true
				return nil
			end
			old.lock = { job = game.JobId, time = os.time() }
			return old
		end)
	end)
	if not ok then
		return nil, result
	end
	if locked then
		return nil, "locked"
	end
	return result, nil
end

local function load(player: Player)
	if not store then
		return nil, "DataStores unavailable"
	end
	local reason
	for attempt = 1, 6 do
		local data
		data, reason = tryLoad(player)
		if data then
			return reconcile(data)
		end
		if not player.Parent then
			return nil, "left"
		end
		if RunService:IsStudio() and reason ~= "locked" then
			return nil, reason -- don't make testers wait through retries
		end
		task.wait(if reason == "locked" then 10 else 2 * attempt)
	end
	return nil, reason
end

function DataService.save(player: Player, release: boolean?)
	local data = profiles[player]
	if not data or noSave[player] then
		return
	end
	data.lastSeen = os.time()
	data.lock = if release then nil else { job = game.JobId, time = os.time() }
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function(old)
				if old and old.lock and old.lock.job ~= game.JobId then
					return nil -- another server took over; never overwrite its save
				end
				return data
			end)
		end)
		if ok then
			return
		end
		warn("Save failed for", player.Name, err)
		task.wait(attempt)
	end
end

function DataService.get(player: Player)
	return profiles[player]
end

-- Yields until the player's data is loaded; returns nil if they leave first.
function DataService.waitFor(player: Player)
	while player.Parent and not profiles[player] do
		task.wait(0.1)
	end
	return profiles[player]
end

function DataService.all()
	return profiles
end

function DataService.onLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

function DataService.onChanged(callback)
	table.insert(changedCallbacks, callback)
end

-- Call after changing a player's data so their yard and UI refresh.
function DataService.changed(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	for _, callback in changedCallbacks do
		task.spawn(callback, player, data)
	end
end

local function onPlayerAdded(player: Player)
	local data, reason = load(player)
	if not player.Parent then
		return
	end
	if not data then
		if RunService:IsStudio() then
			warn("Using a temporary save (not saved). Reason:", reason)
			data = defaultData()
			noSave[player] = true
		elseif reason == "locked" then
			player:Kick("Your Freeks are still saving from your last server. Please rejoin in a minute!")
			return
		else
			player:Kick("Couldn't load your Freeks right now. Please rejoin!")
			return
		end
	end
	profiles[player] = data
	for _, callback in loadedCallbacks do
		task.spawn(callback, player, data)
	end
	DataService.changed(player)
end

local function onPlayerRemoving(player: Player)
	if profiles[player] then
		DataService.save(player, true)
	end
	profiles[player] = nil
	noSave[player] = nil
end

function DataService.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">DiscoveryService</string>
          <string name="Source"><![CDATA[-- The Discovery Book: the first player in the whole game to get each species has their
-- name saved forever. Claims go through UpdateAsync so two servers can't both win, and
-- MessagingService tells every other server right away.

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Freeks = require(ReplicatedStorage.Shared.Freeks)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local STORE_NAME = "BreedAFreek_Discoveries_v1"
local TOPIC = "FreekDiscovered"

local DiscoveryService = {}

local cache = {} -- [speciesId] = { name, userId, time }
local claiming = {}
local store = nil
pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local discoveryUpdate = Remotes.get("DiscoveryUpdate")
local notify = Remotes.get("Notify")

local function announce(speciesId: string, discovery)
	local isNew = cache[speciesId] == nil
	cache[speciesId] = discovery
	discoveryUpdate:FireAllClients(speciesId, discovery)
	if isNew then
		local species = Freeks.byId[speciesId]
		notify:FireAllClients(
			string.format("%s discovered %s for the first time ever!", discovery.name, species.name),
			"discovery"
		)
	end
end

local function loadAll()
	if not store then
		return
	end
	for _, species in Freeks.list do
		if not species.price and not cache[species.id] then
			local ok, value = pcall(store.GetAsync, store, species.id)
			if ok and value then
				cache[species.id] = value
			end
		end
	end
end

-- Call whenever a player gets a species. Shop (starter) Freeks aren't claimable.
function DiscoveryService.claim(player: Player, speciesId: string)
	local species = Freeks.byId[speciesId]
	if not species or species.price or cache[speciesId] or claiming[speciesId] then
		return
	end
	claiming[speciesId] = true

	local mine = { name = player.DisplayName, userId = player.UserId, time = os.time() }
	local winner = mine
	if store then
		local ok, result = pcall(function()
			local existing = nil
			store:UpdateAsync(speciesId, function(old)
				existing = old
				if old then
					return nil
				end
				return mine
			end)
			return existing
		end)
		if ok then
			winner = result or mine
		elseif not RunService:IsStudio() then
			warn("Discovery claim failed:", result)
			claiming[speciesId] = nil
			return
		end
	end

	announce(speciesId, winner)
	if winner == mine then
		pcall(MessagingService.PublishAsync, MessagingService, TOPIC, { species = speciesId, discovery = mine })
	end
	claiming[speciesId] = nil
end

function DiscoveryService.init()
	Remotes.get("GetDiscoveries").OnServerInvoke = function()
		return cache
	end

	pcall(function()
		MessagingService:SubscribeAsync(TOPIC, function(message)
			local data = message.Data
			if typeof(data) == "table" and Freeks.byId[data.species] then
				announce(data.species, data.discovery)
			end
		end)
	end)

	task.spawn(function()
		while true do
			loadAll()
			task.wait(300)
		end
	end)

	-- Re-check species a player already owns, in case an earlier claim failed.
	local DataService = require(script.Parent.DataService)
	DataService.onLoaded(function(player, data)
		for speciesId in data.discovered do
			DiscoveryService.claim(player, speciesId)
		end
	end)
end

return DiscoveryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[-- Pays every player once a second for the Freeks in their yard, plus offline earnings
-- when they come back. Money also shows on the leaderboard so players can show off.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)

local EconomyService = {}

local function publish(player: Player, data, income: number)
	player:SetAttribute("Money", data.money)
	player:SetAttribute("Income", income)
	local stats = player:FindFirstChild("leaderstats")
	local money = stats and stats:FindFirstChild("Money")
	if money then
		money.Value = math.floor(data.money)
	end
end

local function onLoaded(player: Player, data)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local money = Instance.new("NumberValue")
	money.Name = "Money"
	money.Parent = stats
	stats.Parent = player

	local income = FreekUtil.yardIncome(data)
	local away = math.clamp(os.time() - (data.lastSeen or os.time()), 0, Config.OFFLINE_MAX_SECONDS)
	local earned = math.floor(away * income * Config.OFFLINE_RATE)
	if earned > 0 then
		data.money += earned
		Remotes.get("Notify")
			:FireClient(player, "While you were away your Freeks earned " .. Format.money(earned) .. "!", "money")
	end
	publish(player, data, income)
end

function EconomyService.init()
	DataService.onLoaded(onLoaded)
	DataService.onChanged(function(player, data)
		publish(player, data, FreekUtil.yardIncome(data))
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			for player, data in DataService.all() do
				local income = FreekUtil.yardIncome(data)
				data.money += income
				publish(player, data, income)
			end
		end
	end)
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="19">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point. Order matters: remotes and the map exist before players load.

local Lighting = game:GetService("Lighting")

Lighting.ClockTime = 14
Lighting.Brightness = 2.5
Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 160)

local Server = script.Parent
require(Server.PlotService).init()
require(Server.DiscoveryService).init()
require(Server.EconomyService).init()
require(Server.ActionService).init()
require(Server.TradeService).init()
require(Server.StealService).init()
require(Server.DataService).init()
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[-- Builds the map and gives every player a fenced yard. Other players can walk in to look
-- (or steal, see StealService) only while the gate is open. The owner locks the gate for
-- GATE_LOCK_SECONDS at a time and can always walk through their own gate.
-- The whole yard is rebuilt whenever its owner's data changes.

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local FreekModel = require(ReplicatedStorage.Shared.FreekModel)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Mutations = require(ReplicatedStorage.Shared.Mutations)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)

local PLOT_SIZE = 64
local RING_RADIUS = 100
local PAD_COLUMNS = 4
local FENCE_HEIGHT = 5 -- what you see
local WALL_HEIGHT = 16 -- invisible wall above the fence so nobody can jump it
local GATE_WIDTH = 14

local PlotService = {}

local plots = {}
local plotOf = {} -- [Player] = plot

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		p[key] = value
	end
	return p
end

local function billboard(parent: Instance, size: UDim2, offset: Vector3, maxDistance: number): (BillboardGui, TextLabel)
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffset = offset
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	gui.Parent = parent
	return gui, label
end

local function buildMap()
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = Workspace

	part({
		Name = "Ground",
		Size = Vector3.new(400, 2, 400),
		CFrame = CFrame.new(0, -1, 0),
		Color = Color3.fromRGB(100, 190, 90),
		Material = Enum.Material.Grass,
		Parent = map,
	})

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.5, 0)
	spawn.Color = Color3.fromRGB(255, 220, 120)
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = map

	local post = part({
		Name = "TitleSign",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(0, 14, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = map,
	})
	local _, title = billboard(post, UDim2.fromScale(40, 8), Vector3.zero, 400)
	title.Text = "BREED A FREEK"
	title.TextColor3 = Color3.fromRGB(255, 230, 90)
end

local function buildPlot(index: number)
	local angle = (index - 1) / Config.PLOT_COUNT * math.pi * 2
	local center = Vector3.new(math.cos(angle) * RING_RADIUS, 0, math.sin(angle) * RING_RADIUS)
	-- Local -Z (the plot's front) faces the middle of the map.
	local origin = CFrame.lookAt(center, Vector3.zero)

	local folder = Instance.new("Model")
	folder.Name = "Plot" .. index
	folder.Parent = Workspace:WaitForChild("Plots")

	part({
		Name = "Base",
		Size = Vector3.new(PLOT_SIZE, 1, PLOT_SIZE),
		CFrame = origin * CFrame.new(0, 0.5, 0),
		Color = Color3.fromRGB(150, 110, 70),
		Material = Enum.Material.Ground,
		Parent = folder,
	})

	local pads = {}
	for i = 1, Config.MAX_SLOTS do
		local column = (i - 1) % PAD_COLUMNS
		local row = (i - 1) // PAD_COLUMNS
		local pad = part({
			Name = "Pad" .. i,
			Size = Vector3.new(9, 0.5, 9),
			CFrame = origin * CFrame.new((column - (PAD_COLUMNS - 1) / 2) * 13, 1.25, 4 + row * 10),
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
		local lockGui, lockLabel = billboard(pad, UDim2.fromScale(4, 2), Vector3.new(0, 1.5, 0), 60)
		lockLabel.Text = "LOCKED"
		lockLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
		pads[i] = { part = pad, lock = lockGui }
	end

	local pen = part({
		Name = "BreedingPen",
		Size = Vector3.new(22, 0.5, 10),
		CFrame = origin * CFrame.new(0, 1.25, -14),
		Color = Color3.fromRGB(255, 150, 200),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	local _, penLabel = billboard(pen, UDim2.fromScale(14, 2.5), Vector3.new(0, 9, 0), 80)

	-- Fence: visible pickets plus a tall invisible wall, with a gate gap at the front.
	local fenceColor = Color3.fromRGB(235, 225, 205)
	local half = PLOT_SIZE / 2 - 0.5
	local frontSide = (PLOT_SIZE - GATE_WIDTH) / 2
	local sides = {
		{ length = PLOT_SIZE, x = 0, z = half, alongX = true },
		{ length = PLOT_SIZE, x = -half, z = 0, alongX = false },
		{ length = PLOT_SIZE, x = half, z = 0, alongX = false },
		{ length = frontSide, x = -(GATE_WIDTH / 2 + frontSide / 2), z = -half, alongX = true },
		{ length = frontSide, x = GATE_WIDTH / 2 + frontSide / 2, z = -half, alongX = true },
	}
	for _, side in sides do
		local size = if side.alongX then Vector3.new(side.length, 1, 1) else Vector3.new(1, 1, side.length)
		part({
			Name = "Fence",
			Size = size * Vector3.new(1, FENCE_HEIGHT, 1),
			CFrame = origin * CFrame.new(side.x, 1 + FENCE_HEIGHT / 2, side.z),
			Color = fenceColor,
			Material = Enum.Material.WoodPlanks,
			Parent = folder,
		})
		part({
			Name = "Wall",
			Size = size * Vector3.new(1, WALL_HEIGHT, 1),
			CFrame = origin * CFrame.new(side.x, 1 + WALL_HEIGHT / 2, side.z),
			Transparency = 1,
			Parent = folder,
		})
	end
	for _, x in { -1, 1 } do
		part({
			Name = "GatePost",
			Size = Vector3.new(1.6, 8, 1.6),
			CFrame = origin * CFrame.new(x * (GATE_WIDTH / 2 + 0.3), 5, -half),
			Color = Color3.fromRGB(120, 85, 55),
			Material = Enum.Material.Wood,
			Parent = folder,
		})
	end
	-- The visible force field is fence height; an invisible part above it stops jumping over.
	local gateHeight = FENCE_HEIGHT + 2
	local gate = part({
		Name = "Gate",
		Size = Vector3.new(GATE_WIDTH, gateHeight, 1),
		CFrame = origin * CFrame.new(0, 1 + gateHeight / 2, -half),
		Color = Color3.fromRGB(255, 60, 60),
		Material = Enum.Material.ForceField,
		CollisionGroup = "Gate" .. index,
		Parent = folder,
	})
	local gateTop = part({
		Name = "GateTop",
		Size = Vector3.new(GATE_WIDTH, WALL_HEIGHT - gateHeight, 1),
		CFrame = origin * CFrame.new(0, 1 + gateHeight + (WALL_HEIGHT - gateHeight) / 2, -half),
		Transparency = 1,
		CollisionGroup = "Gate" .. index,
		Parent = folder,
	})
	local gateGuiPart = part({
		Name = "GateSign",
		Size = Vector3.new(1, 1, 1),
		CFrame = origin * CFrame.new(0, 10, -half),
		Transparency = 1,
		CanCollide = false,
		Parent = folder,
	})
	local _, gateLabel = billboard(gateGuiPart, UDim2.fromScale(12, 2.5), Vector3.zero, 120)

	local signPost = part({
		Name = "Sign",
		Size = Vector3.new(1, 1, 1),
		CFrame = origin * CFrame.new(0, 16, PLOT_SIZE / 2 - 2),
		Transparency = 1,
		CanCollide = false,
		Parent = folder,
	})
	local _, signLabel = billboard(signPost, UDim2.fromScale(30, 5), Vector3.zero, 250)

	local freekFolder = Instance.new("Folder")
	freekFolder.Name = "Freeks"
	freekFolder.Parent = folder

	local plot = {
		index = index,
		origin = origin,
		spawn = origin * CFrame.new(0, 4, -(PLOT_SIZE / 2 - 4)) * CFrame.Angles(0, math.pi, 0),
		pads = pads,
		pen = pen,
		penLabel = penLabel,
		sign = signLabel,
		freeks = freekFolder,
		gate = gate,
		gateTop = gateTop,
		gateLabel = gateLabel,
		lockedUntil = math.huge,
		owner = nil,
	}
	plots[index] = plot
	return plot
end

-- steal = { uid, ownerUserId } for Freeks on pads, so other players get a Steal prompt.
local function placeFreek(plot, freek, ground: CFrame, steal)
	local model, height = FreekModel.build(freek.species, freek.mutation)
	model:PivotTo(ground)
	model.Parent = plot.freeks

	local species = FreekUtil.species(freek)
	local anchor = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not anchor then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(170, 46)
	gui.MaxDistance = 70
	gui.LightInfluence = 0

	local name = Instance.new("TextLabel")
	name.Size = UDim2.fromScale(1, 0.6)
	name.BackgroundTransparency = 1
	name.TextScaled = true
	name.Font = Enum.Font.FredokaOne
	name.Text = FreekUtil.displayName(freek)
	name.TextColor3 = if freek.mutation
		then Mutations.byId[freek.mutation].color
		else Rarities.info[species.rarity].color
	name.TextStrokeTransparency = 0.2
	name.Parent = gui

	local income = name:Clone()
	income.Size = UDim2.fromScale(1, 0.4)
	income.Position = UDim2.fromScale(0, 0.6)
	income.Text = Format.money(FreekUtil.income(freek)) .. "/s"
	income.TextColor3 = Color3.fromRGB(140, 255, 140)
	income.Parent = gui

	-- The tag hangs off the body, so measure the offset from the body's center, not the feet.
	gui.StudsOffsetWorldSpace = Vector3.new(0, height - (anchor.Position.Y - ground.Position.Y) + 1, 0)
	gui.Parent = anchor

	if steal then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "StealPrompt"
		prompt.ActionText = "Steal"
		prompt.ObjectText = FreekUtil.displayName(freek)
		prompt.HoldDuration = Config.STEAL_HOLD_SECONDS
		prompt.MaxActivationDistance = 9
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("Uid", steal.uid)
		prompt:SetAttribute("OwnerUserId", steal.ownerUserId)
		prompt.Parent = anchor
	end
end

local function updatePenLabel(plot, data)
	local breeding = data and data.breeding
	if not breeding then
		plot.penLabel.Text = "Breeding Pen"
		return
	end
	local left = breeding.endsAt - os.time()
	plot.penLabel.Text = if left > 0 then "Breeding... " .. Format.time(left) else "Baby ready!"
end

function PlotService.render(player: Player)
	local plot = plotOf[player]
	local data = DataService.get(player)
	if not plot or not data then
		return
	end

	plot.freeks:ClearAllChildren()
	plot.sign.Text = player.DisplayName .. "'s Yard"

	for i, pad in plot.pads do
		local unlocked = i <= data.slots
		pad.part.Color = if unlocked then Color3.fromRGB(235, 225, 200) else Color3.fromRGB(90, 90, 90)
		pad.part.Transparency = if unlocked then 0 else 0.5
		pad.lock.Enabled = not unlocked
	end

	for uid, freek in data.freeks do
		local pad = freek.slot and plot.pads[freek.slot]
		if pad then
			placeFreek(plot, freek, pad.part.CFrame * CFrame.new(0, 0.25, 0), {
				uid = uid,
				ownerUserId = player.UserId,
			})
		end
	end

	if data.breeding then
		local penTop = plot.pen.CFrame * CFrame.new(0, 0.25, 0)
		local a = data.freeks[data.breeding.a]
		local b = data.freeks[data.breeding.b]
		if a then
			placeFreek(plot, a, penTop * CFrame.new(-5.5, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0))
		end
		if b then
			placeFreek(plot, b, penTop * CFrame.new(5.5, 0, 0) * CFrame.Angles(0, math.pi / 2, 0))
		end
	end
	updatePenLabel(plot, data)
end

local function setGateLock(plot, lockedUntil: number)
	plot.lockedUntil = lockedUntil
	if plot.owner then
		plot.owner:SetAttribute("GateLockedUntil", lockedUntil)
	end
end

local function updateGate(plot)
	local left = plot.lockedUntil - Workspace:GetServerTimeNow()
	local locked = left > 0
	plot.gate.CanCollide = locked
	plot.gateTop.CanCollide = locked
	plot.gate.Transparency = if locked then 0.4 else 1
	if not plot.owner then
		plot.gateLabel.Text = ""
	elseif locked then
		plot.gateLabel.Text = "LOCKED " .. Format.time(left)
		plot.gateLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
	else
		plot.gateLabel.Text = "GATE OPEN"
		plot.gateLabel.TextColor3 = Color3.fromRGB(120, 255, 120)
	end
end

-- Lets the owner's character pass through their own locked gate.
local function setCollisionGroup(character: Model, group: string)
	local function apply(descendant)
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = group
		end
	end
	for _, descendant in character:GetDescendants() do
		apply(descendant)
	end
	character.DescendantAdded:Connect(apply)
end

local function clearPlot(plot)
	setGateLock(plot, math.huge) -- empty yards stay shut
	plot.owner = nil
	plot.freeks:ClearAllChildren()
	plot.sign.Text = "Empty Yard"
	plot.penLabel.Text = ""
	for _, pad in plot.pads do
		pad.part.Color = Color3.fromRGB(90, 90, 90)
		pad.part.Transparency = 0.5
		pad.lock.Enabled = false
	end
	updateGate(plot)
end

local function sendHome(player: Player)
	local plot = plotOf[player]
	local character = player.Character
	if plot and character then
		character:PivotTo(plot.spawn)
	end
end

local function onPlayerAdded(player: Player)
	for _, plot in plots do
		if not plot.owner then
			plot.owner = player
			plotOf[player] = plot
			player:SetAttribute("Plot", plot.index)
			-- New arrivals get one free lock so they aren't robbed while loading in.
			setGateLock(plot, Workspace:GetServerTimeNow() + Config.GATE_LOCK_SECONDS)
			player.CharacterAdded:Connect(function(character)
				setCollisionGroup(character, "Owner" .. plot.index)
				task.wait(0.1)
				sendHome(player)
			end)
			if player.Character then
				setCollisionGroup(player.Character, "Owner" .. plot.index)
			end
			sendHome(player)
			PlotService.render(player)
			return
		end
	end
	Remotes.get("Notify"):FireClient(player, "This server is full of yards! Try another server.", "error")
end

function PlotService.getPlot(player: Player)
	return plotOf[player]
end

-- True if a world position is inside a plot's fence.
function PlotService.isInside(plot, position: Vector3): boolean
	local localPos = plot.origin:PointToObjectSpace(position)
	local limit = PLOT_SIZE / 2 - 1
	return math.abs(localPos.X) < limit and math.abs(localPos.Z) < limit
end

function PlotService.isGateLocked(plot): boolean
	return Workspace:GetServerTimeNow() < plot.lockedUntil
end

-- Returns an error message, or nil if the gate was locked.
function PlotService.lockGate(player: Player): string?
	local plot = plotOf[player]
	if not plot then
		return "You don't have a yard."
	end
	if PlotService.isGateLocked(plot) then
		return "Your gate is already locked."
	end
	setGateLock(plot, Workspace:GetServerTimeNow() + Config.GATE_LOCK_SECONDS)
	updateGate(plot)
	return nil
end

function PlotService.init()
	for i = 1, Config.PLOT_COUNT do
		PhysicsService:RegisterCollisionGroup("Gate" .. i)
		PhysicsService:RegisterCollisionGroup("Owner" .. i)
		PhysicsService:CollisionGroupSetCollidable("Gate" .. i, "Owner" .. i, false)
	end
	buildMap()
	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = Workspace
	for i = 1, Config.PLOT_COUNT do
		clearPlot(buildPlot(i))
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local plot = plotOf[player]
		if plot then
			clearPlot(plot)
		end
		plotOf[player] = nil
	end)

	DataService.onChanged(function(player)
		PlotService.render(player)
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, plot in plots do
				updateGate(plot)
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			for player, plot in plotOf do
				local data = DataService.get(player)
				if data and data.breeding then
					updatePenLabel(plot, data)
				end
			end
		end
	end)
end

return PlotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Recipes</string>
          <string name="Source"><![CDATA[-- Secret breeding recipes. Server-only so players can't read them out of the game.
-- Order of a and b doesn't matter. chance is how often the pair produces the result;
-- otherwise the baby is a copy of one of the parents' species. A recipe for a Seasonal
-- Freek only works while its season is running.

local Shared = game:GetService("ReplicatedStorage").Shared
local Freeks = require(Shared.Freeks)
local Mutations = require(Shared.Mutations)
local Seasons = require(Shared.Seasons)

local RECIPES = {
	{ a = "Blobby", b = "Snorp", result = "Snoblob", chance = 0.5 },
	{ a = "Wigglet", b = "Grumbo", result = "Wigglump", chance = 0.5 },
	{ a = "Blobby", b = "Wigglet", result = "Blobwig", chance = 0.5 },
	{ a = "Grumbo", b = "Snorp", result = "Grumsnorp", chance = 0.5 },

	{ a = "Snoblob", b = "Wigglump", result = "Chonkler", chance = 0.35 },
	{ a = "Blobwig", b = "Grumsnorp", result = "Zorpdorp", chance = 0.35 },

	{ a = "Chonkler", b = "Zorpdorp", result = "EyeballEarl", chance = 0.25 },
	{ a = "EyeballEarl", b = "Chonkler", result = "KingGoob", chance = 0.15 },
	{ a = "KingGoob", b = "Zorpdorp", result = "CosmicSnorp", chance = 0.1 },
	{ a = "CosmicSnorp", b = "KingGoob", result = "TheFreek", chance = 0.05 },

	-- Seasonal
	{ a = "Blobby", b = "Grumbo", result = "PumpkinBlob", chance = 0.4 },
}

local function pairKey(a: string, b: string): string
	return if a < b then a .. "|" .. b else b .. "|" .. a
end

local byPair = {}
for _, recipe in RECIPES do
	byPair[pairKey(recipe.a, recipe.b)] = recipe
end

local Recipes = {}

-- Returns the baby's species and mutation (or nil) for two parent records.
function Recipes.roll(parentA, parentB, rng: Random): (string, string?)
	local species
	local recipe = byPair[pairKey(parentA.species, parentB.species)]
	if recipe and Seasons.available(Freeks.byId[recipe.result]) and rng:NextNumber() < recipe.chance then
		species = recipe.result
	else
		species = if rng:NextNumber() < 0.5 then parentA.species else parentB.species
	end

	local mutation = nil
	for _, m in Mutations.list do
		local chance = m.chance
		if parentA.mutation == m.id or parentB.mutation == m.id then
			chance *= Mutations.INHERIT_BOOST
		end
		if rng:NextNumber() < chance then
			mutation = m.id
			break
		end
	end

	return species, mutation
end

return Recipes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">StealService</string>
          <string name="Source"><![CDATA[-- Stealing Freeks from other players' yards.
--
-- While a yard's gate is open, anyone else can walk in and hold the Steal prompt on a Freek
-- standing on a pad. The Freek floats over the thief's head and they walk slower: barely
-- for a Common, a lot for a Secret (see carrySpeed in Rarities). If the
-- owner gets within CATCH_DISTANCE before the thief is back inside their own fence, or the
-- thief dies or leaves, the Freek goes home. If the thief makes it home, it's theirs.
--
-- The Freek stays in the owner's save until the moment it's delivered, so a crash mid-steal
-- can never lose or duplicate it.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local FreekModel = require(ReplicatedStorage.Shared.FreekModel)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Rarities = require(ReplicatedStorage.Shared.Rarities)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local ActionService = require(script.Parent.ActionService)
local Carried = require(script.Parent.Carried)
local DataService = require(script.Parent.DataService)
local DiscoveryService = require(script.Parent.DiscoveryService)
local PlotService = require(script.Parent.PlotService)

local StealService = {}

local notifyRemote = Remotes.get("Notify")
local carries = {} -- [thief Player] = { owner, uid, slot, name, model, normalSpeed }

local function notify(player: Player, message: string, kind: string?)
	if player.Parent then
		notifyRemote:FireClient(player, message, kind)
	end
end

local function rootPart(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function attachToHead(player: Player, freek): (Model?, number?)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not head or not humanoid then
		return nil, nil
	end
	local model = FreekModel.build(freek.species, freek.mutation)
	pcall(function()
		model:ScaleTo(0.6)
	end)
	model:PivotTo(head.CFrame * CFrame.new(0, 1, 0))
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = head
			weld.Part1 = descendant
			weld.Parent = descendant
		end
	end
	model.Name = "CarriedFreek"
	model.Parent = character

	local normalSpeed = humanoid.WalkSpeed
	-- Rarer Freeks are heavier: the thief slows down more.
	local rarity = FreekUtil.species(freek).rarity
	humanoid.WalkSpeed = math.min(normalSpeed, Rarities.info[rarity].carrySpeed)
	return model, normalSpeed
end

local function cleanup(thief: Player, carry)
	carries[thief] = nil
	Carried.set(carry.owner, carry.uid, nil)
	if carry.model then
		carry.model:Destroy()
	end
	local character = thief.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and carry.normalSpeed then
		humanoid.WalkSpeed = carry.normalSpeed
	end
end

-- The Freek goes back to its owner's yard (or backpack, if its pad was filled meanwhile).
local function sendBack(thief: Player, carry, ownerMessage: string?, thiefMessage: string?)
	cleanup(thief, carry)
	local ownerData = DataService.get(carry.owner)
	local freek = ownerData and ownerData.freeks[carry.uid]
	if freek and not freek.slot then
		local taken = false
		for _, other in ownerData.freeks do
			if other.slot == carry.slot then
				taken = true
			end
		end
		freek.slot = if taken or carry.slot > ownerData.slots then FreekUtil.freeSlot(ownerData) else carry.slot
		DataService.changed(carry.owner)
	end
	if ownerMessage then
		notify(carry.owner, ownerMessage, "success")
	end
	if thiefMessage then
		notify(thief, thiefMessage, "error")
	end
end

local function deliver(thief: Player, carry)
	local ownerData = DataService.get(carry.owner)
	local thiefData = DataService.get(thief)
	local freek = ownerData and ownerData.freeks[carry.uid]
	if not freek or not thiefData then
		return sendBack(thief, carry)
	end
	if FreekUtil.count(thiefData) >= Config.MAX_FREEKS then
		return sendBack(thief, carry, nil, "You have too many Freeks! It ran back home.")
	end

	cleanup(thief, carry)
	ownerData.freeks[carry.uid] = nil
	thiefData.freeks[carry.uid] = {
		species = freek.species,
		mutation = freek.mutation,
		slot = FreekUtil.freeSlot(thiefData),
	}
	thiefData.discovered[freek.species] = true
	task.spawn(DiscoveryService.claim, thief, freek.species)

	for _, player in { carry.owner, thief } do
		DataService.changed(player)
		task.spawn(DataService.save, player)
	end
	notify(carry.owner, thief.DisplayName .. " stole your " .. carry.name .. "! Lock your gate!", "error")
	notify(thief, "You stole " .. carry.name .. "!", "success")
end

local function onPromptTriggered(prompt: ProximityPrompt, thief: Player)
	if prompt.Name ~= "StealPrompt" then
		return
	end
	local uid = prompt:GetAttribute("Uid")
	local owner = Players:GetPlayerByUserId(prompt:GetAttribute("OwnerUserId") or 0)
	if not owner or owner == thief or typeof(uid) ~= "string" then
		return
	end
	if carries[thief] then
		return notify(thief, "You can only carry one Freek at a time!", "error")
	end

	local ownerData, thiefData = DataService.get(owner), DataService.get(thief)
	local ownerPlot, thiefPlot = PlotService.getPlot(owner), PlotService.getPlot(thief)
	local freek = ownerData and ownerData.freeks[uid]
	local root = rootPart(thief)
	if not freek or not freek.slot or freek.breeding or Carried.is(owner, uid) then
		return
	end
	if not thiefData or not ownerPlot or not thiefPlot or not root then
		return
	end
	if PlotService.isGateLocked(ownerPlot) or not PlotService.isInside(ownerPlot, root.Position) then
		return
	end
	if FreekUtil.count(thiefData) >= Config.MAX_FREEKS then
		return notify(thief, "You have too many Freeks to steal another!", "error")
	end

	local model, normalSpeed = attachToHead(thief, freek)
	if not model then
		return
	end
	local name = FreekUtil.displayName(freek)
	carries[thief] = {
		owner = owner,
		uid = uid,
		slot = freek.slot,
		name = name,
		model = model,
		normalSpeed = normalSpeed,
	}
	Carried.set(owner, uid, thief)
	freek.slot = nil
	DataService.changed(owner)

	notify(
		thief,
		"You grabbed " .. name .. "! Get back to your yard before " .. owner.DisplayName .. " catches you!",
		"success"
	)
	notify(owner, thief.DisplayName .. " is stealing your " .. name .. "! Catch them!", "error")
end

local function checkCarries()
	for thief, carry in carries do
		local root = rootPart(thief)
		if not root or not carry.model.Parent then
			sendBack(
				thief,
				carry,
				"Your " .. carry.name .. " escaped and ran home!",
				"You dropped " .. carry.name .. "!"
			)
			continue
		end
		local ownerRoot = rootPart(carry.owner)
		if ownerRoot and (ownerRoot.Position - root.Position).Magnitude <= Config.CATCH_DISTANCE then
			sendBack(
				thief,
				carry,
				"You caught " .. thief.DisplayName .. "! " .. carry.name .. " is back home.",
				carry.owner.DisplayName .. " caught you!"
			)
			continue
		end
		local home = PlotService.getPlot(thief)
		if home and PlotService.isInside(home, root.Position) then
			deliver(thief, carry)
		end
	end
end

function StealService.init()
	ProximityPromptService.PromptTriggered:Connect(onPromptTriggered)

	ActionService.register("LockGate", function(player: Player)
		local problem = PlotService.lockGate(player)
		if problem then
			notify(player, problem, "error")
		else
			notify(player, "Gate locked for " .. Config.GATE_LOCK_SECONDS .. " seconds!", "success")
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local carry = carries[player]
		if carry then
			sendBack(player, carry, "The thief left! Your " .. carry.name .. " is back home.")
		end
		for thief, other in carries do
			if other.owner == player then
				cleanup(thief, other)
				notify(thief, other.name .. "'s owner left, so it vanished!", "error")
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.1)
			checkCarries()
		end
	end)
end

return StealService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">TradeService</string>
          <string name="Source"><![CDATA[-- Player-to-player Freek trades within one server.
--
-- Flow: request -> accept -> both sides add Freeks -> both press Ready -> 3 second
-- countdown -> swap. Any change to either offer clears both Ready buttons and stops the
-- countdown, so nobody can swap something out at the last second. Ownership is checked
-- again at the moment of the swap, and both players are saved right after.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local FreekUtil = require(ReplicatedStorage.Shared.FreekUtil)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local ActionService = require(script.Parent.ActionService)
local Carried = require(script.Parent.Carried)
local DataService = require(script.Parent.DataService)

local MAX_OFFER = 8
local REQUEST_SECONDS = 30
local COUNTDOWN_SECONDS = 3

local TradeService = {}

local tradeRemote = Remotes.get("Trade")
local notifyRemote = Remotes.get("Notify")

local trades = {} -- [Player] = trade (both players point at the same table)
local requests = {} -- [target Player] = { from = Player, expires = os.clock() }

local function notify(player: Player, message: string, kind: string?)
	notifyRemote:FireClient(player, message, kind)
end

local function otherSide(trade, player: Player): Player
	return if trade.a == player then trade.b else trade.a
end

local function offerView(player: Player, uids)
	local data = DataService.get(player)
	local list = {}
	for _, uid in uids do
		local freek = data and data.freeks[uid]
		if freek then
			table.insert(list, { uid = uid, species = freek.species, mutation = freek.mutation })
		end
	end
	return list
end

local function push(trade)
	for _, player in { trade.a, trade.b } do
		local other = otherSide(trade, player)
		tradeRemote:FireClient(player, "State", {
			partner = other.DisplayName,
			mine = offerView(player, trade.offers[player]),
			theirs = offerView(other, trade.offers[other]),
			myReady = trade.ready[player] == true,
			theirReady = trade.ready[other] == true,
			countdownEndsAt = trade.countdownEndsAt,
		})
	end
end

local function close(trade, reason: string)
	for _, player in { trade.a, trade.b } do
		if trades[player] == trade then
			trades[player] = nil
		end
		tradeRemote:FireClient(player, "Closed", reason)
	end
	trade.closed = true
end

local function unready(trade)
	trade.ready = {}
	trade.countdownEndsAt = nil
	trade.token += 1
end

-- Checks a side's offer is still theirs and tradeable. Returns nil if fine, else why not.
local function offerProblem(player: Player, uids): string?
	local data = DataService.get(player)
	if not data then
		return player.DisplayName .. " isn't loaded"
	end
	for _, uid in uids do
		local freek = data.freeks[uid]
		if not freek then
			return player.DisplayName .. " no longer has one of their Freeks"
		elseif freek.breeding then
			return player.DisplayName .. " put an offered Freek in the breeding pen"
		elseif Carried.is(player, uid) then
			return "one of " .. player.DisplayName .. "'s Freeks is being stolen"
		end
	end
	return nil
end

local function execute(trade)
	local a, b = trade.a, trade.b
	local offerA, offerB = trade.offers[a], trade.offers[b]
	if #offerA == 0 and #offerB == 0 then
		return close(trade, "Trade cancelled: nothing was offered.")
	end
	local problem = offerProblem(a, offerA) or offerProblem(b, offerB)
	if problem then
		return close(trade, "Trade cancelled: " .. problem .. ".")
	end

	local dataA, dataB = DataService.get(a), DataService.get(b)
	if FreekUtil.count(dataA) - #offerA + #offerB > Config.MAX_FREEKS then
		return close(trade, "Trade cancelled: " .. a.DisplayName .. " has too many Freeks.")
	end
	if FreekUtil.count(dataB) - #offerB + #offerA > Config.MAX_FREEKS then
		return close(trade, "Trade cancelled: " .. b.DisplayName .. " has too many Freeks.")
	end

	-- Take everything out first, then hand it over, so neither side can end up with both.
	local fromA, fromB = {}, {}
	for _, uid in offerA do
		fromA[uid] = dataA.freeks[uid]
		dataA.freeks[uid] = nil
	end
	for _, uid in offerB do
		fromB[uid] = dataB.freeks[uid]
		dataB.freeks[uid] = nil
	end
	local function receive(data, freeks)
		for uid, freek in freeks do
			freek.slot = nil
			freek.breeding = nil
			data.freeks[uid] = freek
			data.discovered[freek.species] = true
		end
	end
	receive(dataA, fromB)
	receive(dataB, fromA)

	close(trade, "Trade complete! New Freeks are in your backpack.")
	for _, player in { a, b } do
		DataService.changed(player)
		task.spawn(DataService.save, player)
	end
end

local function startTrade(a: Player, b: Player)
	local trade = {
		a = a,
		b = b,
		offers = { [a] = {}, [b] = {} },
		ready = {},
		countdownEndsAt = nil,
		token = 0,
	}
	trades[a] = trade
	trades[b] = trade
	push(trade)
end

function TradeService.init()
	ActionService.register("TradeRequest", function(player: Player, _data, targetUserId: any)
		local target = typeof(targetUserId) == "number" and Players:GetPlayerByUserId(targetUserId)
		if not target or target == player or not DataService.get(target) then
			return
		end
		if trades[player] then
			return notify(player, "Finish your current trade first!", "error")
		end
		if trades[target] then
			return notify(player, target.DisplayName .. " is already trading.", "error")
		end
		local pending = requests[target]
		if pending and pending.from == player and os.clock() < pending.expires then
			return notify(player, "Request already sent!", "error")
		end
		requests[target] = { from = player, expires = os.clock() + REQUEST_SECONDS }
		tradeRemote:FireClient(target, "Request", { name = player.DisplayName, userId = player.UserId })
		notify(player, "Trade request sent to " .. target.DisplayName .. ".", "success")
	end)

	ActionService.register("TradeRespond", function(player: Player, _data, fromUserId: any, accept: any)
		local request = requests[player]
		if not request or request.from.UserId ~= fromUserId then
			return
		end
		requests[player] = nil
		local from = request.from
		if os.clock() > request.expires or not from.Parent then
			return notify(player, "That trade request expired.", "error")
		end
		if accept ~= true then
			return notify(from, player.DisplayName .. " declined your trade.", "error")
		end
		if trades[player] or trades[from] then
			return notify(player, "One of you is already trading.", "error")
		end
		startTrade(from, player)
	end)

	ActionService.register("TradeOffer", function(player: Player, data, uid: any, add: any)
		local trade = trades[player]
		if not trade or typeof(uid) ~= "string" then
			return
		end
		local offer = trade.offers[player]
		local index = table.find(offer, uid)
		if add == true then
			local freek = data.freeks[uid]
			if index or not freek or freek.breeding or Carried.is(player, uid) then
				return
			end
			if #offer >= MAX_OFFER then
				return notify(player, "You can offer up to " .. MAX_OFFER .. " Freeks.", "error")
			end
			table.insert(offer, uid)
		elseif index then
			table.remove(offer, index)
		else
			return
		end
		unready(trade)
		push(trade)
	end)

	ActionService.register("TradeReady", function(player: Player, _data, ready: any)
		local trade = trades[player]
		if not trade then
			return
		end
		if ready == true then
			trade.ready[player] = true
		else
			unready(trade)
		end

		if trade.ready[trade.a] and trade.ready[trade.b] and not trade.countdownEndsAt then
			trade.countdownEndsAt = Workspace:GetServerTimeNow() + COUNTDOWN_SECONDS
			local token = trade.token
			task.delay(COUNTDOWN_SECONDS, function()
				if not trade.closed and trade.token == token then
					execute(trade)
				end
			end)
		end
		push(trade)
	end)

	ActionService.register("TradeCancel", function(player: Player)
		local trade = trades[player]
		if trade then
			close(trade, player.DisplayName .. " cancelled the trade.")
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local trade = trades[player]
		if trade then
			close(trade, player.DisplayName .. " left the game.")
		end
		requests[player] = nil
		for target, request in requests do
			if request.from == player then
				requests[target] = nil
			end
		end
	end)
end

return TradeService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="24">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="25">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="26">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="27">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- The player's screen: money display, menu buttons, and the Shop / Freeks / Breed / Book
-- windows. The server is the source of truth; this only shows state and sends requests.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local FreekModel = require(Shared.FreekModel)
local FreekUtil = require(Shared.FreekUtil)
local Freeks = require(Shared.Freeks)
local Mutations = require(Shared.Mutations)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)
local Seasons = require(Shared.Seasons)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local colors = UI.colors

local actionRemote = Remotes.get("Action")
local function send(action: string, ...)
	actionRemote:FireServer(action, ...)
end

local state = nil
local discoveries = {}

