	Size = UDim2.new(1, 0, 0.62, 0),
	TextColor3 = colors.money,
	TextXAlignment = Enum.TextXAlignment.Left,
})
local incomeLabel = UI.label("+$0/s", {
	Size = UDim2.new(1, 0, 0.38, 0),
	Position = UDim2.fromScale(0, 0.62),
	TextColor3 = colors.muted,
	TextXAlignment = Enum.TextXAlignment.Left,
})
